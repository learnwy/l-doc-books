title":"会话管理","url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/scalability-patterns/session-management"}]},{"seq":6,"slug":"observability-patterns","title":"可观测性模式","docCount":4,"url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/observability-patterns","docs":[{"seq":1,"slug":"structured-logging","title":"结构化日志","url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/observability-patterns/structured-logging"},{"seq":2,"slug":"distributed-tracing-implementation","title":"分布式追踪实现","url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/observability-patterns/distributed-tracing-implementation"},{"seq":3,"slug":"health-check-patterns","title":"健康检查模式","url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/observability-patterns/health-check-patterns"},{"seq":4,"slug":"graceful-shutdown","title":"优雅关闭","url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/observability-patterns/graceful-shutdown"}]}]}