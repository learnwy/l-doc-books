tals/fund-and-portfolio/asset-allocation-strategies"}]},{"seq":4,"slug":"investment-risk-management","title":"投资风险管理","docCount":3,"url":"/l-doc-books/h/economics-finance/investment-fundamentals/investment-risk-management","docs":[{"seq":1,"slug":"risk-measurement-and-metrics","title":"风险度量与指标","url":"/l-doc-books/h/economics-finance/investment-fundamentals/investment-risk-management/risk-measurement-and-metrics"},{"seq":2,"slug":"hedging-and-derivatives","title":"对冲与衍生品","url":"/l-doc-books/h/economics-finance/investment-fundamentals/investment-risk-management/hedging-and-derivatives"},{"seq":3,"slug":"behavioral-biases-in-investing","title":"投资中的行为偏差","url":"/l-doc-books/h/economics-finance/investment-fundamentals/investment-risk-management/behavioral-biases-in-investing"}]}]}