nomics-finance/monetary-policy-central-banking/contemporary-challenges/cbdc-digital-currency"},{"seq":3,"slug":"global-coordination-policy-exit","title":"全球协调与非常规政策退出","url":"/l-doc-books/h/economics-finance/monetary-policy-central-banking/contemporary-challenges/global-coordination-policy-exit"}]}]}