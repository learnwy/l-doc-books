,"url":"/h/game-development/unity-development/unity-performance/physics-optimization"}]},{"seq":5,"slug":"unity-publishing","title":"Unity 发布与部署","docCount":4,"url":"/h/game-development/unity-development/unity-publishing","docs":[{"seq":1,"slug":"build-pipeline","title":"构建管线","url":"/h/game-development/unity-development/unity-publishing/build-pipeline"},{"seq":2,"slug":"multi-platform","title":"多平台发布","url":"/h/game-development/unity-development/unity-publishing/multi-platform"},{"seq":3,"slug":"addressables","title":"Addressables 资源管理","url":"/h/game-development/unity-development/unity-publishing/addressables"},{"seq":4,"slug":"cicd-automation","title":"CI/CD 自动化","url":"/h/game-development/unity-development/unity-publishing/cicd-automation"}]}]}