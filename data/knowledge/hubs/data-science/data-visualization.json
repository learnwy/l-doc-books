ks/h/data-science/data-visualization/viz-tools/viz-programming-paradigms"}]},{"seq":4,"slug":"dashboard-design","title":"仪表板设计","docCount":5,"url":"/l-doc-books/h/data-science/data-visualization/dashboard-design","docs":[{"seq":1,"slug":"dashboard-principles","title":"仪表板设计原则","url":"/l-doc-books/h/data-science/data-visualization/dashboard-design/dashboard-principles"},{"seq":2,"slug":"interactive-visualization","title":"交互式可视化设计","url":"/l-doc-books/h/data-science/data-visualization/dashboard-design/interactive-visualization"},{"seq":3,"slug":"data-storytelling","title":"数据叙事与报告","url":"/l-doc-books/h/data-science/data-visualization/dashboard-design/data-storytelling"},{"seq":4,"slug":"interactive-viz","title":"交互式可视化","url":"/l-doc-books/h/data-science/data-visualization/dashboard-design/interactive-viz"},{"seq":5,"slug":"storytelling-with-data","title":"数据叙事","url":"/l-doc-books/h/data-science/data-visualization/dashboard-design/storytelling-with-data"}]}]}