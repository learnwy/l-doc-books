":"digital-twin","title":"数字孪生与 Sim-to-Real","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/simulation-tools/digital-twin"}]},{"seq":5,"slug":"robot-simulation","title":"机器人仿真","docCount":6,"url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation","docs":[{"seq":1,"slug":"gazebo-environment","title":"Gazebo 仿真环境","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/gazebo-environment"},{"seq":2,"slug":"isaac-sim","title":"NVIDIA Isaac Sim 机器人仿真","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/isaac-sim"},{"seq":3,"slug":"digital-twin","title":"数字孪生技术","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/digital-twin"},{"seq":4,"slug":"gazebo-fundamentals","title":"Gazebo 仿真基础","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/gazebo-fundamentals"},{"seq":5,"slug":"urdf-modeling","title":"URDF 与机器人建模","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/urdf-modeling"},{"seq":6,"slug":"ros2-control","title":"ros2_control 框架","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/ros2-control"}]}]}