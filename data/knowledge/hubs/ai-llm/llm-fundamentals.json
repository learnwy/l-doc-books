"model-quantization","title":"模型量化","url":"/l-doc-books/h/ai-llm/llm-fundamentals/deployment-and-inference/model-quantization"},{"seq":2,"slug":"inference-optimization","title":"推理优化","url":"/l-doc-books/h/ai-llm/llm-fundamentals/deployment-and-inference/inference-optimization"},{"seq":3,"slug":"serving-frameworks","title":"服务框架","url":"/l-doc-books/h/ai-llm/llm-fundamentals/deployment-and-inference/serving-frameworks"},{"seq":4,"slug":"edge-deployment","title":"端侧部署","url":"/l-doc-books/h/ai-llm/llm-fundamentals/deployment-and-inference/edge-deployment"}]},{"seq":7,"slug":"evaluation-and-safety","title":"评估与安全","docCount":4,"url":"/l-doc-books/h/ai-llm/llm-fundamentals/evaluation-and-safety","docs":[{"seq":1,"slug":"benchmark-and-evaluation","title":"基准测试与评估","url":"/l-doc-books/h/ai-llm/llm-fundamentals/evaluation-and-safety/benchmark-and-evaluation"},{"seq":2,"slug":"hallucination-mitigation","title":"幻觉缓解","url":"/l-doc-books/h/ai-llm/llm-fundamentals/evaluation-and-safety/hallucination-mitigation"},{"seq":3,"slug":"safety-and-guardrails","title":"安全与护栏","url":"/l-doc-books/h/ai-llm/llm-fundamentals/evaluation-and-safety/safety-and-guardrails"},{"seq":4,"slug":"cost-optimization","title":"成本优化","url":"/l-doc-books/h/ai-llm/llm-fundamentals/evaluation-and-safety/cost-optimization"}]}]}