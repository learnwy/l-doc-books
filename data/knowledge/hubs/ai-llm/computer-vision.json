ion-recognition","title":"动作识别","url":"/h/ai-llm/computer-vision/video-and-3d/action-recognition"},{"seq":3,"slug":"depth-estimation","title":"深度估计","url":"/h/ai-llm/computer-vision/video-and-3d/depth-estimation"},{"seq":4,"slug":"point-cloud-processing","title":"点云处理","url":"/h/ai-llm/computer-vision/video-and-3d/point-cloud-processing"}]},{"seq":6,"slug":"cv-applications","title":"视觉应用","docCount":4,"url":"/h/ai-llm/computer-vision/cv-applications","docs":[{"seq":1,"slug":"face-recognition","title":"人脸识别","url":"/h/ai-llm/computer-vision/cv-applications/face-recognition"},{"seq":2,"slug":"ocr-document","title":"OCR 与文档处理","url":"/h/ai-llm/computer-vision/cv-applications/ocr-document"},{"seq":3,"slug":"medical-imaging","title":"医学影像分析","url":"/h/ai-llm/computer-vision/cv-applications/medical-imaging"},{"seq":4,"slug":"autonomous-perception","title":"自动驾驶感知","url":"/h/ai-llm/computer-vision/cv-applications/autonomous-perception"}]}]}