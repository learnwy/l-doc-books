-agent-development/frameworks/custom-framework-design"}]},{"seq":5,"slug":"context-and-memory","title":"上下文与记忆","docCount":4,"url":"/h/ai-llm/ai-agent-development/context-and-memory","docs":[{"seq":1,"slug":"context-window-management","title":"上下文窗口管理","url":"/h/ai-llm/ai-agent-development/context-and-memory/context-window-management"},{"seq":2,"slug":"long-term-memory","title":"长期记忆","url":"/h/ai-llm/ai-agent-development/context-and-memory/long-term-memory"},{"seq":3,"slug":"knowledge-graphs","title":"知识图谱","url":"/h/ai-llm/ai-agent-development/context-and-memory/knowledge-graphs"},{"seq":4,"slug":"conversation-state","title":"对话状态管理","url":"/h/ai-llm/ai-agent-development/context-and-memory/conversation-state"}]},{"seq":6,"slug":"evaluation-and-production","title":"评估与生产","docCount":4,"url":"/h/ai-llm/ai-agent-development/evaluation-and-production","docs":[{"seq":1,"slug":"agent-evaluation","title":"Agent 评估","url":"/h/ai-llm/ai-agent-development/evaluation-and-production/agent-evaluation"},{"seq":2,"slug":"observability-and-tracing","title":"可观测性与追踪","url":"/h/ai-llm/ai-agent-development/evaluation-and-production/observability-and-tracing"},{"seq":3,"slug":"production-deployment","title":"生产部署","url":"/h/ai-llm/ai-agent-development/evaluation-and-production/production-deployment"},{"seq":4,"slug":"cost-and-latency","title":"成本与延迟优化","url":"/h/ai-llm/ai-agent-development/evaluation-and-production/cost-and-latency"}]}]}