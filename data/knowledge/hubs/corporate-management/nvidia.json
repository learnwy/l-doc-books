st"},{"seq":3,"slug":"product-manager","title":"NVIDIA 产品经理职业路径","url":"/l-doc-books/h/corporate-management/nvidia/role-career-paths/product-manager"},{"seq":4,"slug":"solutions-architect","title":"NVIDIA 解决方案架构师职业路径","url":"/l-doc-books/h/corporate-management/nvidia/role-career-paths/solutions-architect"}]},{"seq":7,"slug":"ai-transformation","title":"AI 转型与战略","docCount":3,"url":"/l-doc-books/h/corporate-management/nvidia/ai-transformation","docs":[{"seq":1,"slug":"ai-products","title":"NVIDIA AI 产品全景","url":"/l-doc-books/h/corporate-management/nvidia/ai-transformation/ai-products"},{"seq":2,"slug":"ai-strategy","title":"NVIDIA AI 战略解读","url":"/l-doc-books/h/corporate-management/nvidia/ai-transformation/ai-strategy"},{"seq":3,"slug":"ai-impact-on-roles","title":"AI 对岗位影响与员工 AI 实践","url":"/l-doc-books/h/corporate-management/nvidia/ai-transformation/ai-impact-on-roles"}]}]}