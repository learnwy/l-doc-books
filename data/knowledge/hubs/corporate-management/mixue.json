-paths/supply-chain-manufacturing"},{"seq":4,"slug":"franchisee-support","title":"蜜雪冰城加盟支持与培训路径","url":"/h/corporate-management/mixue/role-career-paths/franchisee-support"},{"seq":5,"slug":"marketing-brand","title":"蜜雪冰城市场与品牌路径","url":"/h/corporate-management/mixue/role-career-paths/marketing-brand"}]},{"seq":7,"slug":"ai-transformation","title":"AI时代的蜜雪冰城","docCount":4,"url":"/h/corporate-management/mixue/ai-transformation","docs":[{"seq":1,"slug":"ai-supply-chain","title":"蜜雪冰城AI供应链优化","url":"/h/corporate-management/mixue/ai-transformation/ai-supply-chain"},{"seq":2,"slug":"ai-store-digitalization","title":"蜜雪冰城AI门店数字化","url":"/h/corporate-management/mixue/ai-transformation/ai-store-digitalization"},{"seq":3,"slug":"ai-workforce-impact","title":"AI对蜜雪冰城岗位的冲击","url":"/h/corporate-management/mixue/ai-transformation/ai-workforce-impact"},{"seq":4,"slug":"ai-practice-guide","title":"蜜雪冰城员工AI实践指南","url":"/h/corporate-management/mixue/ai-transformation/ai-practice-guide"}]}]}