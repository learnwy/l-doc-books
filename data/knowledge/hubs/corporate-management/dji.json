hardware-engineer"},{"seq":4,"slug":"product-manager","title":"大疆产品经理职业成长路线","url":"/h/corporate-management/dji/role-career-paths/product-manager"},{"seq":5,"slug":"algorithm-researcher","title":"大疆算法研究员职业成长路线","url":"/h/corporate-management/dji/role-career-paths/algorithm-researcher"},{"seq":6,"slug":"operations-and-supply-chain","title":"大疆运营与供应链职业成长路线","url":"/h/corporate-management/dji/role-career-paths/operations-and-supply-chain"}]},{"seq":7,"slug":"ai-transformation","title":"AI 变革","docCount":4,"url":"/h/corporate-management/dji/ai-transformation","docs":[{"seq":1,"slug":"ai-products-and-technology","title":"大疆 AI 产品与技术矩阵：从无人机视觉到智能驾驶的全景解析","url":"/h/corporate-management/dji/ai-transformation/ai-products-and-technology"},{"seq":2,"slug":"ai-strategy-and-roadmap","title":"大疆 AI 战略与路线图：技术驱动的多元化扩张","url":"/h/corporate-management/dji/ai-transformation/ai-strategy-and-roadmap"},{"seq":3,"slug":"ai-impact-on-roles","title":"AI 对大疆岗位的冲击与机遇：谁会被替代，谁将被增强","url":"/h/corporate-management/dji/ai-transformation/ai-impact-on-roles"},{"seq":4,"slug":"employee-ai-practice","title":"大疆员工 AI 实践指南：用 AI 工具构建个人竞争力","url":"/h/corporate-management/dji/ai-transformation/employee-ai-practice"}]}]}