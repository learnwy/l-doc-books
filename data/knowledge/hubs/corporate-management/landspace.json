ring","title":"AI智能制造","url":"/l-doc-books/h/corporate-management/landspace/ai-transformation/ai-manufacturing"},{"seq":3,"slug":"ai-workforce-impact","title":"AI对蓝箭航天岗位的冲击","url":"/l-doc-books/h/corporate-management/landspace/ai-transformation/ai-workforce-impact"},{"seq":4,"slug":"ai-practice-guide","title":"工程师AI实践指南","url":"/l-doc-books/h/corporate-management/landspace/ai-transformation/ai-practice-guide"}]}]}