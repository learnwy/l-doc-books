ng/role-career-paths/engineering-levels"},{"seq":3,"slug":"product-manager","title":"三星产品管理职业路径","url":"/l-doc-books/h/corporate-management/samsung/role-career-paths/product-manager"},{"seq":4,"slug":"hardware-engineer","title":"三星硬件工程师职业路径","url":"/l-doc-books/h/corporate-management/samsung/role-career-paths/hardware-engineer"},{"seq":5,"slug":"operations-and-manufacturing","title":"三星运营与制造管理职业路径","url":"/l-doc-books/h/corporate-management/samsung/role-career-paths/operations-and-manufacturing"}]},{"seq":7,"slug":"ai-transformation","title":"AI 变革与战略","docCount":3,"url":"/l-doc-books/h/corporate-management/samsung/ai-transformation","docs":[{"seq":1,"slug":"ai-products-and-technology","title":"三星 AI 产品与技术矩阵","url":"/l-doc-books/h/corporate-management/samsung/ai-transformation/ai-products-and-technology"},{"seq":2,"slug":"ai-strategy-and-impact","title":"三星 AI 战略与岗位影响","url":"/l-doc-books/h/corporate-management/samsung/ai-transformation/ai-strategy-and-impact"},{"seq":3,"slug":"employee-ai-practice","title":"三星员工 AI 实践指南","url":"/l-doc-books/h/corporate-management/samsung/ai-transformation/employee-ai-practice"}]}]}