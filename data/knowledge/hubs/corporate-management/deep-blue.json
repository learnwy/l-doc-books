ent/deep-blue/role-career-paths/engineering"},{"seq":2,"slug":"propulsion-systems","title":"推进系统职业路径：液氧煤油发动机与推力矢量控制","url":"/h/corporate-management/deep-blue/role-career-paths/propulsion-systems"},{"seq":3,"slug":"gnc-avionics","title":"GNC 与航电职业路径：制导导航控制与垂直着陆算法","url":"/h/corporate-management/deep-blue/role-career-paths/gnc-avionics"},{"seq":4,"slug":"test-flight-ops","title":"测试与飞行运营职业路径：从地面试车到发射场指挥","url":"/h/corporate-management/deep-blue/role-career-paths/test-flight-ops"},{"seq":5,"slug":"business-strategy","title":"商务战略职业路径：融资、客户开发与政府关系","url":"/h/corporate-management/deep-blue/role-career-paths/business-strategy"}]},{"seq":7,"slug":"ai-transformation","title":"AI 变革与深蓝航天","docCount":4,"url":"/h/corporate-management/deep-blue/ai-transformation","docs":[{"seq":1,"slug":"ai-landing-algorithms","title":"AI 在垂直着陆制导中的应用","url":"/h/corporate-management/deep-blue/ai-transformation/ai-landing-algorithms"},{"seq":2,"slug":"ai-design-simulation","title":"AI 驱动的火箭设计与仿真","url":"/h/corporate-management/deep-blue/ai-transformation/ai-design-simulation"},{"seq":3,"slug":"ai-workforce-impact","title":"AI 对深蓝航天岗位的冲击与重塑","url":"/h/corporate-management/deep-blue/ai-transformation/ai-workforce-impact"},{"seq":4,"slug":"ai-practice-guide","title":"航天工程师 AI 实践指南","url":"/h/corporate-management/deep-blue/ai-transformation/ai-practice-guide"}]}]}