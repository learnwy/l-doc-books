ths/marketing-and-growth"},{"seq":5,"slug":"operations","title":"SHEIN 运营路线","url":"/h/corporate-management/shein/role-career-paths/operations"}]},{"seq":7,"slug":"ai-transformation","title":"AI 时代的组织变革与个人机遇","docCount":4,"url":"/h/corporate-management/shein/ai-transformation","docs":[{"seq":1,"slug":"ai-design-and-trend","title":"SHEIN AI 设计与趋势预测体系","url":"/h/corporate-management/shein/ai-transformation/ai-design-and-trend"},{"seq":2,"slug":"ai-supply-chain","title":"SHEIN AI 供应链优化体系","url":"/h/corporate-management/shein/ai-transformation/ai-supply-chain"},{"seq":3,"slug":"ai-marketing-personalization","title":"SHEIN AI 营销与个性化推荐体系","url":"/h/corporate-management/shein/ai-transformation/ai-marketing-personalization"},{"seq":4,"slug":"ai-career-opportunities","title":"SHEIN AI 时代的跨境电商科技职业机遇","url":"/h/corporate-management/shein/ai-transformation/ai-career-opportunities"}]}]}