","title":"AI转型与技术战略","docCount":2,"url":"/l-doc-books/h/corporate-management/meituan/ai-transformation","docs":[{"seq":1,"slug":"ai-applications-landscape","title":"美团AI应用全景 — 从智能调度到自动配送与大模型","url":"/l-doc-books/h/corporate-management/meituan/ai-transformation/ai-applications-landscape"},{"seq":2,"slug":"ai-strategy-employee-practice","title":"美团AI战略框架与员工AI实践","url":"/l-doc-books/h/corporate-management/meituan/ai-transformation/ai-strategy-employee-practice"}]}]}