q":6,"slug":"pivot-and-unpivot","title":"行列转换与 PIVOT","url":"/l-doc-books/h/languages/sql-language/analytical-sql/pivot-and-unpivot"},{"seq":7,"slug":"time-series-sql","title":"时间序列 SQL","url":"/l-doc-books/h/languages/sql-language/analytical-sql/time-series-sql"},{"seq":8,"slug":"data-warehouse-sql","title":"数据仓库 SQL","url":"/l-doc-books/h/languages/sql-language/analytical-sql/data-warehouse-sql"}]}]}