ptimization"},{"seq":4,"slug":"engine-differences","title":"引擎差异","url":"/l-doc-books/h/languages/regex-text-processing/regex-engines/engine-differences"}]},{"seq":4,"slug":"text-processing-tools","title":"文本处理工具","docCount":4,"url":"/l-doc-books/h/languages/regex-text-processing/text-processing-tools","docs":[{"seq":1,"slug":"sed-and-awk","title":"sed 与 awk","url":"/l-doc-books/h/languages/regex-text-processing/text-processing-tools/sed-and-awk"},{"seq":2,"slug":"grep-and-ripgrep","title":"grep 与 ripgrep","url":"/l-doc-books/h/languages/regex-text-processing/text-processing-tools/grep-and-ripgrep"},{"seq":3,"slug":"jq-and-structured-data","title":"jq 与结构化数据","url":"/l-doc-books/h/languages/regex-text-processing/text-processing-tools/jq-and-structured-data"},{"seq":4,"slug":"text-encoding","title":"文本编码","url":"/l-doc-books/h/languages/regex-text-processing/text-processing-tools/text-encoding"}]},{"seq":5,"slug":"practical-patterns","title":"实战模式","docCount":4,"url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns","docs":[{"seq":1,"slug":"validation-patterns","title":"验证模式","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/validation-patterns"},{"seq":2,"slug":"extraction-and-transformation","title":"提取与转换","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/extraction-and-transformation"},{"seq":3,"slug":"log-parsing","title":"日志解析","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/log-parsing"},{"seq":4,"slug":"refactoring-with-regex","title":"正则重构","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/refactoring-with-regex"}]}]}