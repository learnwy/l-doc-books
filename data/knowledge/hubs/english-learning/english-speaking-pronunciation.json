-building","title":"流利度训练","docCount":4,"url":"/h/english-learning/english-speaking-pronunciation/fluency-building","docs":[{"seq":1,"slug":"shadowing-technique","title":"跟读法","url":"/h/english-learning/english-speaking-pronunciation/fluency-building/shadowing-technique"},{"seq":2,"slug":"chunk-based-speaking","title":"语块输出法","url":"/h/english-learning/english-speaking-pronunciation/fluency-building/chunk-based-speaking"},{"seq":3,"slug":"filler-management","title":"填充词管理","url":"/h/english-learning/english-speaking-pronunciation/fluency-building/filler-management"},{"seq":4,"slug":"self-correction-strategies","title":"自我纠正策略","url":"/h/english-learning/english-speaking-pronunciation/fluency-building/self-correction-strategies"}]},{"seq":5,"slug":"tech-speaking-scenarios","title":"技术场景口语","docCount":4,"url":"/h/english-learning/english-speaking-pronunciation/tech-speaking-scenarios","docs":[{"seq":1,"slug":"standup-and-demo","title":"站会与技术演示","url":"/h/english-learning/english-speaking-pronunciation/tech-speaking-scenarios/standup-and-demo"},{"seq":2,"slug":"code-review-discussion","title":"代码评审讨论","url":"/h/english-learning/english-speaking-pronunciation/tech-speaking-scenarios/code-review-discussion"},{"seq":3,"slug":"interview-speaking","title":"面试口语","url":"/h/english-learning/english-speaking-pronunciation/tech-speaking-scenarios/interview-speaking"},{"seq":4,"slug":"cross-team-communication","title":"跨团队沟通","url":"/h/english-learning/english-speaking-pronunciation/tech-speaking-scenarios/cross-team-communication"}]},{"seq":6,"slug":"accent-and-variety","title":"口音与多样性","docCount":4,"url":"/h/english-learning/english-speaking-pronunciation/accent-and-variety","docs":[{"seq":1,"slug":"american-vs-british","title":"美式与英式英语","url":"/h/english-learning/english-speaking-pronunciation/accent-and-variety/american-vs-british"},{"seq":2,"slug":"world-english-accents","title":"世界英语口音","url":"/h/english-learning/english-speaking-pronunciation/accent-and-variety/world-english-accents"},{"seq":3,"slug":"non-native-communication","title":"非母语者沟通策略","url":"/h/english-learning/english-speaking-pronunciation/accent-and-variety/non-native-communication"},{"seq":4,"slug":"accent-reduction-strategies","title":"口音改善策略","url":"/h/english-learning/english-speaking-pronunciation/accent-and-variety/accent-reduction-strategies"}]}]}