chniques"},{"seq":2,"slug":"accent-recognition-drills","title":"口音识别训练","url":"/l-doc-books/h/english-learning/english-listening-media/accent-and-speed-training/accent-recognition-drills"},{"seq":3,"slug":"dictation-practice","title":"听写练习","url":"/l-doc-books/h/english-learning/english-listening-media/accent-and-speed-training/dictation-practice"},{"seq":4,"slug":"real-world-audio","title":"真实场景音频","url":"/l-doc-books/h/english-learning/english-listening-media/accent-and-speed-training/real-world-audio"}]}]}