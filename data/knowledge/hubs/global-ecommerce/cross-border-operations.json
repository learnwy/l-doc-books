-domain","title":"社群与私域","docCount":4,"url":"/l-doc-books/h/global-ecommerce/cross-border-operations/community-and-private-domain","docs":[{"seq":1,"slug":"private-domain-community","title":"跨境电商私域运营与全球社群构建","url":"/l-doc-books/h/global-ecommerce/cross-border-operations/community-and-private-domain/private-domain-community"},{"seq":2,"slug":"social-commerce-content","title":"社交电商全球营销与内容创新","url":"/l-doc-books/h/global-ecommerce/cross-border-operations/community-and-private-domain/social-commerce-content"},{"seq":3,"slug":"cross-border-livestream","title":"跨境直播电商与内容带货","url":"/l-doc-books/h/global-ecommerce/cross-border-operations/community-and-private-domain/cross-border-livestream"},{"seq":4,"slug":"global-influencer-ecosystem","title":"全球网红生态与 KOL 合作","url":"/l-doc-books/h/global-ecommerce/cross-border-operations/community-and-private-domain/global-influencer-ecosystem"}]}]}