ug":"behavioral-roots","title":"环境危机的行为根源","url":"/l-doc-books/h/psychology/environmental-psychology/sustainability-and-applications/behavioral-roots"},{"seq":2,"slug":"attitude-behavior-gap","title":"知行不一的鸿沟","url":"/l-doc-books/h/psychology/environmental-psychology/sustainability-and-applications/attitude-behavior-gap"},{"seq":3,"slug":"promoting-proenvironmental","title":"促进亲环境行为","url":"/l-doc-books/h/psychology/environmental-psychology/sustainability-and-applications/promoting-proenvironmental"},{"seq":4,"slug":"applications-and-significance","title":"环境心理学的应用与意义","url":"/l-doc-books/h/psychology/environmental-psychology/sustainability-and-applications/applications-and-significance"}]}]}