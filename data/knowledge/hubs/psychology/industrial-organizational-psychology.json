/industrial-organizational-psychology/consumer-psychology/brand-psychology"},{"seq":3,"slug":"advertising-persuasion","title":"广告与说服心理学","url":"/l-doc-books/h/psychology/industrial-organizational-psychology/consumer-psychology/advertising-persuasion"},{"seq":4,"slug":"digital-consumer-behavior","title":"数字消费行为","url":"/l-doc-books/h/psychology/industrial-organizational-psychology/consumer-psychology/digital-consumer-behavior"}]},{"seq":4,"slug":"human-factors","title":"人因工程心理学","docCount":4,"url":"/l-doc-books/h/psychology/industrial-organizational-psychology/human-factors","docs":[{"seq":1,"slug":"human-computer-interaction","title":"人机交互","url":"/l-doc-books/h/psychology/industrial-organizational-psychology/human-factors/human-computer-interaction"},{"seq":2,"slug":"usability-engineering","title":"可用性工程","url":"/l-doc-books/h/psychology/industrial-organizational-psychology/human-factors/usability-engineering"},{"seq":3,"slug":"cognitive-ergonomics","title":"认知工效学","url":"/l-doc-books/h/psychology/industrial-organizational-psychology/human-factors/cognitive-ergonomics"},{"seq":4,"slug":"error-prevention","title":"差错预防","url":"/l-doc-books/h/psychology/industrial-organizational-psychology/human-factors/error-prevention"}]}]}