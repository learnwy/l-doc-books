title":"城市空间与社会分析","url":"/l-doc-books/h/sociology/social-institutions/urban-rural-sociology/urban-spatial-analysis"},{"seq":2,"slug":"rural-community-transformation","title":"乡村社区与社会转型","url":"/l-doc-books/h/sociology/social-institutions/urban-rural-sociology/rural-community-transformation"},{"seq":3,"slug":"gentrification-displacement","title":"士绅化与社会置换","url":"/l-doc-books/h/sociology/social-institutions/urban-rural-sociology/gentrification-displacement"},{"seq":4,"slug":"urban-governance-planning","title":"城市治理与规划社会学","url":"/l-doc-books/h/sociology/social-institutions/urban-rural-sociology/urban-governance-planning"}]}]}