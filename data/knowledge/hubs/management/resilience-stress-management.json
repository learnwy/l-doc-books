ience-stress-management/resilience-building/bounce-back-strategies"}]},{"seq":4,"slug":"anti-fragility","title":"反脆弱修炼","docCount":4,"url":"/l-doc-books/h/management/resilience-stress-management/anti-fragility","docs":[{"seq":1,"slug":"antifragile-principles","title":"反脆弱原理","url":"/l-doc-books/h/management/resilience-stress-management/anti-fragility/antifragile-principles"},{"seq":2,"slug":"stress-inoculation","title":"压力接种","url":"/l-doc-books/h/management/resilience-stress-management/anti-fragility/stress-inoculation"},{"seq":3,"slug":"failure-portfolio","title":"失败档案","url":"/l-doc-books/h/management/resilience-stress-management/anti-fragility/failure-portfolio"},{"seq":4,"slug":"chaos-engineering-life","title":"人生混沌工程","url":"/l-doc-books/h/management/resilience-stress-management/anti-fragility/chaos-engineering-life"}]},{"seq":5,"slug":"coping-strategies","title":"应对策略","docCount":4,"url":"/l-doc-books/h/management/resilience-stress-management/coping-strategies","docs":[{"seq":1,"slug":"cognitive-reframing","title":"认知重构","url":"/l-doc-books/h/management/resilience-stress-management/coping-strategies/cognitive-reframing"},{"seq":2,"slug":"mindfulness-practice","title":"正念练习","url":"/l-doc-books/h/management/resilience-stress-management/coping-strategies/mindfulness-practice"},{"seq":3,"slug":"social-support","title":"社会支持","url":"/l-doc-books/h/management/resilience-stress-management/coping-strategies/social-support"},{"seq":4,"slug":"boundary-setting","title":"边界设定","url":"/l-doc-books/h/management/resilience-stress-management/coping-strategies/boundary-setting"}]},{"seq":6,"slug":"recovery-renewal","title":"恢复与重建","docCount":4,"url":"/l-doc-books/h/management/resilience-stress-management/recovery-renewal","docs":[{"seq":1,"slug":"recovery-cycles","title":"恢复周期","url":"/l-doc-books/h/management/resilience-stress-management/recovery-renewal/recovery-cycles"},{"seq":2,"slug":"sabbatical-planning","title":"休整规划","url":"/l-doc-books/h/management/resilience-stress-management/recovery-renewal/sabbatical-planning"},{"seq":3,"slug":"career-crisis","title":"职业危机","url":"/l-doc-books/h/management/resilience-stress-management/recovery-renewal/career-crisis"},{"seq":4,"slug":"psychological-capital","title":"心理资本","url":"/l-doc-books/h/management/resilience-stress-management/recovery-renewal/psychological-capital"}]}]}