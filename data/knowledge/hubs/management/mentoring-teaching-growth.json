nagement/mentoring-teaching-growth/knowledge-community-building/internal-wiki-leadership"},{"seq":3,"slug":"knowledge-sharing-culture","title":"知识分享文化","url":"/l-doc-books/h/management/mentoring-teaching-growth/knowledge-community-building/knowledge-sharing-culture"},{"seq":4,"slug":"open-knowledge-movement","title":"开放知识运动","url":"/l-doc-books/h/management/mentoring-teaching-growth/knowledge-community-building/open-knowledge-movement"}]}]}