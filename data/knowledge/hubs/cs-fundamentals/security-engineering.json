-books/h/cs-fundamentals/security-engineering/security-architecture/logging-and-ids"},{"seq":4,"slug":"compliance-and-privacy","title":"合规与隐私保护","url":"/l-doc-books/h/cs-fundamentals/security-engineering/security-architecture/compliance-and-privacy"}]},{"seq":5,"slug":"supply-chain-security","title":"供应链与运行时安全","docCount":4,"url":"/l-doc-books/h/cs-fundamentals/security-engineering/supply-chain-security","docs":[{"seq":1,"slug":"dependency-security","title":"依赖安全与 SCA","url":"/l-doc-books/h/cs-fundamentals/security-engineering/supply-chain-security/dependency-security"},{"seq":2,"slug":"container-security","title":"容器安全与镜像扫描","url":"/l-doc-books/h/cs-fundamentals/security-engineering/supply-chain-security/container-security"},{"seq":3,"slug":"sast-and-dast","title":"SAST 与 DAST 工具","url":"/l-doc-books/h/cs-fundamentals/security-engineering/supply-chain-security/sast-and-dast"},{"seq":4,"slug":"zero-trust","title":"零信任安全模型","url":"/l-doc-books/h/cs-fundamentals/security-engineering/supply-chain-security/zero-trust"}]}]}