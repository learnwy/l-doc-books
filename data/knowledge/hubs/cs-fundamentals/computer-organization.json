ganization/advanced-architecture","docs":[{"seq":1,"slug":"superscalar","title":"超标量与乱序执行","url":"/l-doc-books/h/cs-fundamentals/computer-organization/advanced-architecture/superscalar"},{"seq":2,"slug":"multicore","title":"多核处理器架构","url":"/l-doc-books/h/cs-fundamentals/computer-organization/advanced-architecture/multicore"},{"seq":3,"slug":"gpu-architecture","title":"GPU 架构基础","url":"/l-doc-books/h/cs-fundamentals/computer-organization/advanced-architecture/gpu-architecture"}]}]}