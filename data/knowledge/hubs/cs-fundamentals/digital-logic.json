eq":2,"slug":"bus-and-io","title":"总线与 I/O 接口","url":"/l-doc-books/h/cs-fundamentals/digital-logic/modern-digital/bus-and-io"},{"seq":3,"slug":"low-power-design","title":"低功耗设计","url":"/l-doc-books/h/cs-fundamentals/digital-logic/modern-digital/low-power-design"}]}]}