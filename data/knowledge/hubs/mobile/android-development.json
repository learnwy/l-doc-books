build-and-release/proguard-and-r8"},{"seq":4,"slug":"play-store-release","title":"Play Store 发布","url":"/h/mobile/android-development/build-and-release/play-store-release"}]},{"seq":7,"slug":"testing","title":"测试","docCount":4,"url":"/h/mobile/android-development/testing","docs":[{"seq":1,"slug":"unit-testing","title":"单元测试","url":"/h/mobile/android-development/testing/unit-testing"},{"seq":2,"slug":"ui-testing-compose","title":"Compose UI 测试","url":"/h/mobile/android-development/testing/ui-testing-compose"},{"seq":3,"slug":"espresso","title":"Espresso UI 测试框架","url":"/h/mobile/android-development/testing/espresso"},{"seq":4,"slug":"screenshot-testing","title":"截图测试","url":"/h/mobile/android-development/testing/screenshot-testing"}]}]}