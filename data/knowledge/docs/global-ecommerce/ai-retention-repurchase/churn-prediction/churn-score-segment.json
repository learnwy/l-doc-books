</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.expectedValue </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.reachability </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.expectedValue </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.reachability);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> queue</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InterventionQueueItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> spent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> u</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ranked) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> action</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pickAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(u.segment, u.churnProb);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> actionCost</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(action, u.language);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (spent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cost </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> budget) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    spent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cost;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      userId: u.userId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      rank: queue.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      segment: u.segment,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      action,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      estimatedCost: cost,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      estimatedSaveValue: u.expectedValue </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> u.reachability,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> queue;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>两个实现细节值得注意。<code>continue</code> 而不是 <code>break</code>：预算不足时跳过这一条继续尝试更便宜的动作，而不是直接停止——否则队列会被一个昂贵的头部用户截断。<code>reachability &gt; 0.05</code> 的下限而不是 <code>&gt; 0</code>：可达概率极低的用户即使价值高也几乎必然浪费成本，设一个下限比精算更实用。</p>\n<p>队列产出后应当冻结一段时间（比如 24 小时）再执行。原因是评分可能因为上游数据的迟到而重算，如果队列实时重排，用户可能在一天内被反复进出队列，配合下游的旅程编排（见 <a href=\"../personalized-crm/journey-orchestration\">生命周期营销旅程编排</a>）会造成重复触达。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>分层不是切阈值，而是三件事分开：<strong>模型给排序、分层给沟通语言、预算给截断点</strong>。</li>\n<li>排序键应该是期望挽留价值 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>p</mi><mtext>churn</mtext></msub><mo>⋅</mo><mtext>margin</mtext><mo>⋅</mo><mi>r</mi></mrow><annotation encoding=\"application/x-tex\">p_{\\text{churn}} \\cdot \\text{margin} \\cdot r</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6389em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">p</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">churn</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8623em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">margin</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span></span></span></span></span>，其中可达性与毛利是最常被忽略的两个因子。</li>\n<li>面向运营的分层标签必须描述可理解的用户状态，并且<strong>每一层都要定义「不该做什么」</strong>。</li>\n<li>单调性检查是最便宜的模型健康度指标，应该按周自动运行。</li>\n<li>占比漂移与单用户跳变是两个独立的失效模式，分别对应特征漂移与过度敏感。</li>\n<li>队列构建时用 <code>continue</code> 而非 <code>break</code>，并设可达性下限。</li>\n<li>队列产出后冻结一段时间再执行，避免与下游编排产生重复触达。</li>\n<li>本章第 1 篇定义了这里的概率从哪来，第 3 篇会解释为什么按概率排序可能仍然错——干预价值不等于流失概率。</li>\n</ul>\n","headings":[{"level":1,"text":"流失评分与人群分层","id":"流失评分与人群分层"},{"level":2,"text":"核心概念：概率不是动作，分层才是","id":"核心概念-概率不是动作-分层才是"},{"level":2,"text":"按干预价值重排序","id":"按干预价值重排序"},{"level":3,"text":"分层标签的设计","id":"分层标签的设计"},{"level":2,"text":"分层的验证与稳定性","id":"分层的验证与稳定性"},{"level":2,"text":"从分层到干预队列","id":"从分层到干预队列"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"流失信号与预测模型","url":"/l-doc-books/h/global-ecommerce/ai-retention-repurchase/churn-prediction/churn-signal-model"},"next":{"title":"预测准确度与可干预性","url":"/l-doc-books/h/global-ecommerce/ai-retention-repurchase/churn-prediction/churn-prediction-accuracy"}}