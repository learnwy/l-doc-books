or:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (refundMinor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> merchantTotal) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'refund exceeds merchant share'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> allocs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> allocate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    refundMinor,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    merchantEntries.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e.amountMinor),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> merchantEntries.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    entryId: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ulid</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    txGroupId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`REV:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">refundMinor</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">bizRefId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    accountId: e.accountId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    direction: e.direction </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'DEBIT'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'CREDIT'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'DEBIT'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    amountMinor: allocs[i],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    currency: e.currency,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    bizType: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'REFUND'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    bizRefId: e.bizRefId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    reversesEntryId: e.entryId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  })) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">satisfies</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LedgerEntry</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>refundMinor &gt; merchantTotal</code> 这个校验必须存在且<strong>在写账之前执行</strong>。它防的是「退款金额超过商家实收」这类攻击或 bug——例如用户在商品已被部分退款后再次申请退款，而申请金额校验有漏洞。这是<strong>资损方向的防线</strong>，比任何对账都重要，因为对账发现问题时钱可能已经出账。</p>\n<h2 id=\"退款与余额分区的交互\">退款与余额分区的交互</h2><p>退款不只是账本上的反向分录，它还要<strong>从正确的余额分区里扣</strong>。如果货款已经释放到 <code>AVAILABLE</code>（商家可提现），退款必须从 <code>AVAILABLE</code> 扣，此时可能出现<strong>余额不足</strong>——商家已经提走了。</p>\n<p>这种情况下的处理是资金系统的经典难题，三个选项各有代价：</p>\n<ul>\n<li><strong>允许负余额</strong>：记 <code>AVAILABLE = -5000</code>，从后续交易中自动抵扣。简单，但商家可能关店跑路，坏账落在平台。</li>\n<li><strong>从保证金扣</strong>：优先扣保证金账户（见<a href=\"../fund-safety/freeze-deduction\">违规冻结/划扣/保证金</a>），不足部分转负余额。</li>\n<li><strong>生成催收单</strong>：超过阈值转人工催收，余额保持冻结状态。</li>\n</ul>\n<p>无论选哪种，**必须有一个「退款失败队列」**记录无法自动冲回的退款，并按 SLA 升级。让退款静默失败是最糟糕的选择：用户没收到钱但平台显示已退，最终会变成投诉与监管事件。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>幂等键是业务主键而非请求 ID</strong>；复合键 <code>(orderId, ACTION)</code> 用于同一对象上的多次动作。</li>\n<li><strong>唯一约束是唯一的仲裁者</strong>；<code>idemKey</code> 插入必须先于业务写入，<code>PENDING</code> 状态必须带租约超时，否则一次进程崩溃会永久卡单。</li>\n<li><strong>乱序用状态机 + 暂存事件解决</strong>，不合法迁移进 <code>pending_event</code> 等重放；监控该表深度与最老记录年龄。</li>\n<li><strong>退款永远是反向分录</strong>，<code>reversesEntryId</code> 指向原分录，原分录不可改不可删。</li>\n<li><strong>部分退款必须显式选择冲回策略</strong>（按比例 / 佣金不退 / 全退），取整保证冲回总额不超过原额，且 <code>refund ≤ 商家实收</code> 必须在写账前校验。</li>\n<li><strong>退款要落在正确的余额分区</strong>；已提现导致余额不足时，负余额 / 保证金抵扣 / 催收三条路必须显式选一条，并有退款失败队列与升级 SLA。</li>\n</ul>\n<p>分账、记账、冲分都做完之后，账本上的钱还是不能直接提走——它落在哪个余额桶、什么时候可提，见<a href=\"../escrow-available-balance/pending-available-balance\">在途/可提现/冻结余额</a>；冲分导致的账本与快照不一致如何检出与修复，见<a href=\"../realtime-vs-batch/split-discrepancy\">分账差异检测与修复</a>。</p>\n","headings":[{"level":1,"text":"分账幂等与退款冲分","id":"分账幂等与退款冲分"},{"level":2,"text":"核心概念：幂等键是业务主键，不是请求 ID","id":"核心概念-幂等键是业务主键-不是请求-id"},{"level":2,"text":"乱序与迟到：状态机而非条件判断","id":"乱序与迟到-状态机而非条件判断"},{"level":2,"text":"退款冲分：反向分录，不是删除","id":"退款冲分-反向分录-不是删除"},{"level":2,"text":"退款与余额分区的交互","id":"退款与余额分区的交互"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"实时分账记账与只追加账本","url":"/l-doc-books/h/global-ecommerce/realtime-merchant-settlement/transaction-split/realtime-ledger-entry"},"next":{"title":"在途/可提现/冻结余额","url":"/l-doc-books/h/global-ecommerce/realtime-merchant-settlement/escrow-available-balance/pending-available-balance"}}