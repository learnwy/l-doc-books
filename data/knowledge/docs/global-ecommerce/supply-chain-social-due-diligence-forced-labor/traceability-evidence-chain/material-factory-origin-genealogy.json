iki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> contribution,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">       COUNT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DISTINCT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">node_id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> source_nodes</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> upstream u</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trace_nodes n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">node_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">input_node</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">node_type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'raw'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">origin_region</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IS NOT NULL</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">origin_region</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> contribution </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p><strong><code>depth &lt; 12</code> 这个上限必须存在</strong>：供应链数据里难免出现循环引用（错误的批次关联、或供应商的重复申报），没有深度限制的递归查询会无限展开。这类防御不是过度设计，而是真实数据质量下的必需。</p>\n<h3 id=\"关键物料的向下追溯\">关键物料的向下追溯</h3><p>反方向同样重要：当某个产地或某个设施被列入风险名单，需要立刻知道哪些在库、在途、已售的成品受影响。这是<strong>召回式查询</strong>，也是风险响应速度的决定因素。</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 给定风险设施，找出受影响的成品批次及其当前状态&#10;WITH RECURSIVE downstream AS (&#10;  SELECT node_id, 1 AS depth, 1::NUMERIC AS share FROM trace_nodes WHERE facility_id = :risk_facility&#10;  UNION ALL&#10;  SELECT e.output_node, d.depth + 1, d.share * e.share&#10;  FROM downstream d&#10;  JOIN trace_edges e ON e.input_node = d.node_id&#10;  WHERE d.depth &lt; 12&#10;)&#10;SELECT d.node_id, tn.lot_id, tn.material_code, tn.event_date,&#10;       MAX(d.share) AS max_exposure&#10;FROM downstream d&#10;JOIN trace_nodes tn ON tn.node_id = d.node_id&#10;WHERE tn.node_type = &#39;finished&#39;&#10;GROUP BY d.node_id, tn.lot_id, tn.material_code, tn.event_date&#10;ORDER BY max_exposure DESC;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 给定风险设施，找出受影响的成品批次及其当前状态</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WITH</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> RECURSIVE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> downstream </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node_id, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> depth, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NUMERIC</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> share </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trace_nodes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> facility_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :risk_facility</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  UNION ALL</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">output_node</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color