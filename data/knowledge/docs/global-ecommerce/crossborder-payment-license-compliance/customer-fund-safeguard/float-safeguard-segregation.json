92E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">held_amount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">encumbered</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">         -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SUM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">balance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)                                    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> surplus</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer_fund_liability l</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LEFT JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> safeguarding_asset a</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">entity_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">entity_id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">currency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">  =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">currency</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">as_of_date</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">as_of_date</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">entity_id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">currency</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">as_of_date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p>这个模型里有三个关键决策。<code>safeguarding_coverage</code> 视图按 <strong>entity × currency × date</strong> 三元组分组的，直接体现前面说的三个维度同时足额的要求——任何一组 <code>surplus &lt; 0</code> 就是缺口，不能用其他组覆盖。<code>encumbered</code> 字段用来排除已被质押、冻结或设定其他负担的资产，因为这类资产在机构倒闭时无法用于返还客户。<code>asset_type</code> 上的 <code>account_required</code> 约束保证走账户隔离路径的记录必须有账户引用，避免「声称在存管但查不到账户」的不可核查状态。</p>\n<p><code>surplus</code> 这一列在实务中的用途超出合规本身：持续的正 surplus 意味着机构用超出必要的资产覆盖客户负债，是资金效率的损失；长期接近零的 surplus 意味着没有缓冲，任何对账时点误差都可能导致技术性缺口。因此监控「surplus / total_liability」这个比率的波动，比监控是否违规更早发现问题。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>存管制度要同时解决三件事：<strong>隔离</strong>（不与自有资金混同）、<strong>优先性</strong>（破产时不进清算池）、<strong>足额性</strong>（每日无缺口）；缺一不成立。</li>\n<li>两条实现路径：<strong>账户隔离</strong>与<strong>替代性保障（保险/担保）</strong>。选择依据是资金形态——余额持续增长的储值类业务几乎必须走账户隔离，因为保额增长会追上业务增长。</li>\n<li>跨境多币种业务必须<strong>按币种独立核算足额性</strong>，禁止跨币种折算覆盖，否则引入汇率投机风险。</li>\n<li>足额性在<strong>币种 × 主体 × 营业日</strong>三个维度上同时成立，这是存管对账工作量的真实来源。</li>\n<li>数据模型的关键是把客户资金负债与存管资产建成两侧账本，用 <code>entity × currency × date</code> 分组、<code>encumbered</code> 标记、以及 <code>asset_type</code> 约束把可核查性固化；<code>surplus / total_liability</code> 是比违规告警更早的预警指标。</li>\n<li>只要资金流可能经过平台账户，「不过平台」的路径设计就是比存管更彻底的方案——见 <a href=\"no-pool-fund-two-clearing\">资金池二清红线与不过平台路径</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"备付金/客户资金隔离存管","id":"备付金-客户资金隔离存管"},{"level":2,"text":"核心概念：存管要解决的三件事","id":"核心概念-存管要解决的三件事"},{"level":2,"text":"两种实现路径：账户隔离与替代性保障","id":"两种实现路径-账户隔离与替代性保障"},{"level":3,"text":"路径一：账户隔离（segregation）","id":"路径一-账户隔离-segregation"},{"level":3,"text":"路径二：替代性保障（insurance / guarantee）","id":"路径二-替代性保障-insurance-guarantee"},{"level":3,"text":"选择依据是资金形态而非成本","id":"选择依据是资金形态而非成本"},{"level":2,"text":"面向多币种与跨境业务的存管结构","id":"面向多币种与跨境业务的存管结构"},{"level":3,"text":"为什么不能跨币种折算","id":"为什么不能跨币种折算"},{"level":3,"text":"三个维度必须同时成立","id":"三个维度必须同时成立"},{"level":3,"text":"在途资金的处理","id":"在途资金的处理"},{"level":2,"text":"存管账户的数据模型","id":"存管账户的数据模型"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"平台与持牌方合规责任划分","url":"/l-doc-books/h/global-ecommerce/crossborder-payment-license-compliance/own-license-vs-partner/responsibility-split-contract"},"next":{"title":"资金池二清红线与不过平台路径","url":"/l-doc-books/h/global-ecommerce/crossborder-payment-license-compliance/customer-fund-safeguard/no-pool-fund-two-clearing"}}