l mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:1em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">且</span></span><span class=\"mspace\" style=\"margin-right:1em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">t</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">a</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal mtight\">i</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">v</span><span class=\"mord mathnormal mtight\">e</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\">s</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≥</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.9805em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:1em;\"></span><span class=\"mord\">∀</span><span class=\"mord mathnormal\" style=\"margin-right:0.0572em;\">j</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∈</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.854em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">t</span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal\">i</span><span class=\"mord mathnormal\">p</span></span></span></span></span></div><p>其中 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>j</mi></msub><mo separator=\"true\">,</mo><msub><mi>l</mi><mi>j</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_j, l_j</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9805em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0197em;\">l</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0197em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 是第 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>j</mi></mrow><annotation encoding=\"application/x-tex\">j</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.854em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0572em;\">j</span></span></span></span></span> 个停靠点的时间窗上下界。这一形式与经典的带时间窗车辆路径问题（VRPTW）完全一致：在 OR-Tools 的建模中，容量与时间窗都被表达为<strong>维度（dimension）</strong>，维度跟踪沿路线累积的量，并可为每辆车设置上界与时间窗回调（<a href=\"https://developers.google.com/optimization/routing/vrp\">Google OR-Tools: VRP</a>）。理解这个对应关系很重要——聚合问题不是一个自创的工程问题，它有成熟的求解框架。</p>\n<h3 id=\"插入式启发式\">插入式启发式</h3><p>实时场景不能承受完整的 VRPTW 求解（城市级实例的求解时间以秒到分钟计）。工程上用的是<strong>插入式启发式</strong>：固定已有路线，枚举新订单在路线中的插入位置，取增量成本最小的位置。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"def try_insert(trip, new_order, cost_fn):&#10;    best = None&#10;    for pos in range(len(trip.stops) + 1):&#10;        cand = trip.stops[:pos] + [new_order.pickup, new_order.dropoff_at(pos)] + trip.stops[pos:]&#10;        if not feasible(cand, trip.courier):      # 容量 + 时间窗&#10;            continue&#10;        delta = cost_fn(cand) - cost_fn(trip.stops)&#10;        if delta &lt;= trip.max_detour_minutes and (best is None or delta &lt; best[1]):&#10;            best = (pos, delta)&#10;    return best\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> try_insert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(trip, new_order, cost_fn):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    best </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pos </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(trip.stops) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        cand </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trip.stops[:pos] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [new_order.pickup, new_order.dropoff_at(pos)] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trip.stops[pos:]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> not</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> feasible(cand, trip.courier):      </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 容量 + 时间窗</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            continue</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        delta </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cost_fn(cand) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cost_fn(trip.stops)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> delta </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trip.max_detour_minutes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">and</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (best </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">is</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> or</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> delta </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> best[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            best </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pos, delta)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> best</span></span></code></pre></div><p>两个关键点：<strong>一是 <code>feasible</code> 必须包含容量向量的逐维比较</strong>（上一章定义的 <code>capacity</code> 结构直接喂进来）；<strong>二是 <code>max_detour_minutes</code> 上限</strong>——它防止&quot;为了拼单把原本 12 分钟的订单拖到 25 分钟&quot;。这个上限通常按订单的时效余量动态计算，而不是常数。</p>\n<h2 id=\"组合爆炸与求解尺度\">组合爆炸与求解尺度</h2><p>插入式启发式的复杂度是 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>O</mi><mo stretchy=\"false\">(</mo><mi>n</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">O(n)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">n</span><span class=\"mclose\">)</span></span></span></span></span> 每次插入，看起来便宜。但当系统要回答&quot;这 8 个待派订单应该如何分成若干趟&quot;时，组合数会爆炸。</p>\n<h3 id=\"什么时候需要真正的求解器\">什么时候需要真正的求解器</h3><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>候选规模</th>\n<th>适用方法</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单骑手加单</td>\n<td>已有 1–3 单 + 1 新单</td>\n<td>插入式启发式</td>\n<td>毫秒级，实时可用</td>\n</tr>\n<tr>\n<td>小范围重优化</td>\n<td>≤ 10 个订单、≤ 3 个骑手</td>\n<td>穷举或局部搜索</td>\n<td>百毫秒级，可异步</td>\n</tr>\n<tr>\n<td>波次聚合</td>\n<td>数十至数百单</td>\n<td>VRPTW 求解器（启发式）</td>\n<td>秒级，用于预约单与波次</td>\n</tr>\n<tr>\n<td>全局再平衡</td>\n<td>全城</td>\n<td>不求解，用规则与优先队列</td>\n<td>见第三章的缺口驱动</td>\n</tr>\n</tbody></table>\n<p>这张表说明一个重要判断：<strong>实时聚合不应该追求全局最优</strong>。全局最优需要知道未来会来什么单，而未来的订单是未知的；在未知未来的情况下追求当下的最优，往往因为&quot;留位置给可能的好单&quot;而牺牲了确定性的收益。工程上普遍接受的做法是贪心 + 局部重优化：先贪心插入得到可行解，再在后台做小范围的交换重优化。</p>\n<h3 id=\"交接点-聚合的一种特殊形态\">交接点：聚合的一种特殊形态</h3><p>当两个骑手的路线在中途交叉时，一个包裹可以在交叉点从 A 转给 B，让两人的路线都更顺。这在学术上叫**交接点（handover / relay）**方案，理论收益显著，但引入了两个新风险：交接本身的耗时与出错（包裹转错人）、以及责任划分的模糊（交接后丢失由谁负责？）。</p>\n<p>工程建议是：<strong>交接点只在有物理交接设施（自提点、驿站、柜机）的场景启用</strong>。把交接点选在受监控、有存证的设施里，风险从&quot;人—人交接&quot;降级为&quot;人—设施交接&quot;，可追责性大幅提升。这条规则把聚合与自提点网络耦合起来，后者是 <a href=\"../elastic-capacity-schedule/hybrid-carrier-crowd-mix\">众包与传统承运商混合编排</a> 讨论的多元末端之一。</p>\n<h2 id=\"聚合与派单的顺序问题\">聚合与派单的顺序问题</h2><p>一个容易做错的架构决策是：先聚合再派单，还是先派单再聚合。</p>\n<p><strong>先聚合再派单</strong>：把若干订单打包成一个&quot;任务组&quot;，寻找愿意接整组的司机。优点是司机看到的是一趟完整路线，接受后的履约确定性高；缺点是任务组的时效约束是组内最紧的一个，稍有不匹配就难找到接单者。</p>\n<p><strong>先派单再聚合</strong>：先按单派给司机，再在司机已有单的基础上追加。优点是每单都有归属，不会出现整组无人接；缺点是追加时司机的当前位置已知，但路线已被锁定，优化空间小。</p>\n<p>主流实现是<strong>两者结合</strong>：时效紧的订单按单派，时效宽的订单进波次池做打包；司机已有单时，新单走&quot;先派单再聚合&quot;的追加路径。这个混合策略的切换点是订单的时效余量与池中订单密度，具体阈值需要在 <a href=\"../elastic-capacity-schedule/peak-valley-crowd-supplement\">峰谷弹性运力补充</a> 的供需预测基础上标定。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>聚合的目标是单位时间产出最大化而非多装单，约束是每单不超时；三个冲突目标是利用率、时效、风险控制。</li>\n<li>&quot;顺路&quot;的量化判据是方向夹角与垂直偏移两个阈值（常见 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msup><mn>30</mn><mo>∘</mo></msup></mrow><annotation encoding=\"application/x-tex\">30^\\circ</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6741em;\"></span><span class=\"mord\">3</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6741em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mbin mtight\">∘</span></span></span></span></span></span></span></span></span></span></span></span>–<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msup><mn>45</mn><mo>∘</mo></msup></mrow><annotation encoding=\"application/x-tex\">45^\\circ</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6741em;\"></span><span class=\"mord\">4</span><span class=\"mord\"><span class=\"mord\">5</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6741em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mbin mtight\">∘</span></span></span></span></span></span></span></span></span></span></span></span>、500–1500 米），阈值需按市场路网形态调参。</li>\n<li>容量约束是向量逐维比较，时间窗约束与 VRPTW 模型一致；OR-Tools 用 dimension 同时表达容量与时间窗，不是自创问题。</li>\n<li>实时场景用插入式启发式而非全局求解：枚举插入位置、验证可行性、取增量成本最小，并设 <code>max_detour_minutes</code> 上限防止拖累已有订单。</li>\n<li>实时聚合不应追求全局最优，贪心 + 后台局部重优化是更稳的工程选择；交接点只在有物理交接设施时启用。</li>\n<li>聚合与派单的顺序应按订单时效余量分治：紧单按单派、宽单进波次池打包。</li>\n</ul>\n","headings":[{"level":1,"text":"顺路派送与订单聚合","id":"顺路派送与订单聚合"},{"level":2,"text":"核心概念：聚合在优化什么","id":"核心概念-聚合在优化什么"},{"level":3,"text":"三个相互冲突的目标","id":"三个相互冲突的目标"},{"level":3,"text":"顺路性的判据","id":"顺路性的判据"},{"level":2,"text":"装箱问题：容量与时间窗的双约束","id":"装箱问题-容量与时间窗的双约束"},{"level":3,"text":"两个约束的形式化","id":"两个约束的形式化"},{"level":3,"text":"插入式启发式","id":"插入式启发式"},{"level":2,"text":"组合爆炸与求解尺度","id":"组合爆炸与求解尺度"},{"level":3,"text":"什么时候需要真正的求解器","id":"什么时候需要真正的求解器"},{"level":3,"text":"交接点：聚合的一种特殊形态","id":"交接点-聚合的一种特殊形态"},{"level":2,"text":"聚合与派单的顺序问题","id":"聚合与派单的顺序问题"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"派单/抢单实时匹配","url":"/l-doc-books/h/global-ecommerce/crowdsourced-elastic-lastmile/real-time-dispatch-bid/order-dispatch-grab-match"},"next":{"title":"动态定价与高峰激励","url":"/l-doc-books/h/global-ecommerce/crowdsourced-elastic-lastmile/real-time-dispatch-bid/dynamic-pricing-surge"}}