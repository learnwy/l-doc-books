pan></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">p</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span></div><p>其中 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>v</mi><mi>k</mi></msub><mo separator=\"true\">,</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><annotation encoding=\"application/x-tex\">v_k, q_k</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">v</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0359em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">q</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0359em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 是 A 向 B 交货的清算价与数量，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>u</mi><mi>k</mi></msub><mo separator=\"true\">,</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><annotation encoding=\"application/x-tex\">u_k, p_k</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">p</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 是 B 向 A 交货的清算价与数量。若 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>N</mi><mi>A</mi></msub><mo>&gt;</mo><mi>S</mi></mrow><annotation encoding=\"application/x-tex\">N_A &gt; S</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">A</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&gt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span></span></span></span></span>（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>S</mi></mrow><annotation encoding=\"application/x-tex\">S</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span></span></span></span></span> 为约定的摆动额度 swing credit），超出部分 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>max</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo separator=\"true\">,</mo><msub><mi>N</mi><mi>A</mi></msub><mo>−</mo><mi>S</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\max(0, N_A - S)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\">max</span><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">A</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span><span class=\"mclose\">)</span></span></span></span></span> 必须在结算日以硬通货、货物或第三方债权转让的方式结清。摆动额度把「谁先交货」的信用风险量化成一个双方都接受的天花板，通常按年度双边贸易额的 10%–30% 协商并在协议附件中固定。</p>\n<p><strong>真实运作的参照：亚洲清算联盟（ACU，Asian Clearing Union）</strong>，1974 年成立、总部设在德黑兰，成员含孟加拉国、不丹、印度、伊朗、马尔代夫、缅甸、尼泊尔、巴基斯坦、斯里兰卡等，是当今仍在运作的最典型区域清算机制。ACU 把「双边清算」升级为「多边净额」：成员的应收应付先在联盟层面轧差，只对最终净头寸用 ACU 美元或 ACU 欧元结算，周期为每两个月一次；多边轧差的价值可量化——<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>m</mi></mrow><annotation encoding=\"application/x-tex\">m</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">m</span></span></span></span></span> 个成员两两结算需 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo fence=\"true\">(</mo><mfrac linethickness=\"0px\"><mi>m</mi><mn>2</mn></mfrac><mo fence=\"true\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\binom{m}{2}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.2em;vertical-align:-0.35em;\"></span><span class=\"mord\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">(</span></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.7454em;\"><span style=\"top:-2.355em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">2</span></span></span></span><span style=\"top:-3.144em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">m</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">)</span></span></span></span></span></span></span> 笔付汇，净额后通常只需 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">m-1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6667em;vertical-align:-0.0833em;\"></span><span class=\"mord mathnormal\">m</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1</span></span></span></span></span> 笔以内。</p>\n<h2 id=\"清算汇率-记账价与差额的四种出口\">清算汇率、记账价与差额的四种出口</h2><p>清算账户里有两个价格体系，混淆它们是操作事故的头号来源。<strong>商业价</strong>（contract price）是合同成交价；<strong>清算价</strong>（accounting price）是记入账户、用于轧差和结算的价格。两者可以不同：双边协定里的清算价常以「协定汇率」折算，而该汇率可能长期偏离市场汇率。设市场汇率为 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>m</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_m</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">m</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>、协定清算汇率为 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>c</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_c</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">c</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>，则每单位记账货物对交货方隐含的补贴或损失为：</p>\n<div class=\"math-block\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi mathvariant=\"normal\">Δ</mi><mo>=</mo><mrow><mo fence=\"true\">(</mo><mfrac><msub><mi>e</mi><mi>m</mi></msub><msub><mi>e</mi><mi>c</mi></msub></mfrac><mo>−</mo><mn>1</mn><mo fence=\"true\">)</mo></mrow><mo>×</mo><mi>V</mi></mrow><annotation encoding=\"application/x-tex\">\\Delta = \\left( \\frac{e_m}{e_c} - 1 \\right) \\times V</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord\">Δ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.4em;vertical-align:-0.95em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.1076em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">c</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">m</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.836em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">)</span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">V</span></span></span></span></span></div><p>当 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>c</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_c</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">c</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 被人为高估（本币在协定中偏强），则出口方吃亏、进口方占便宜；反之则相反。这就是为什么清算协定在货币大幅波动时会迅速变成政治问题——它把汇率风险从市场转移到了国家间账本上。</p>\n<p>差额只有四个出口，理解它们等于理解整个 countertrade 的操作空间：<strong>硬通货结清</strong>（最干净，但需外汇，制裁或短缺环境下往往做不到）；<strong>结转下期</strong>（最常见，账上挂着等下期再轧，问题在于余额会累积）；<strong>实物补足</strong>（差额方追加交货，等于把清算账户当长期信用）；<strong>转口/债权转让（switch trading）</strong>（把花不掉的清算债权折价卖给需要该国货物或货币的第三方，折价率视债权国货物可售性，历史上可从个位数到两位数百分比）。</p>\n<p><strong>印度与伊朗的卢比结算</strong>是「封闭用途」的现实样本：在美元结算通道受限后，印度通过 UCO Bank 等指定银行，把部分石油付款以卢比记入伊朗账户的镜像账本，伊朗再用这笔卢比购买印度商品。核心特征与清算账户完全一致——余额只能在对方国家花掉。<strong>俄印贸易</strong>延续同一逻辑：印度储备银行 2022 年 7 月 11 日发布的 A.P. (DIR Series) Circular No. 10 建立了「印度卢比国际贸易结算机制」，允许印度银行在境外银行开立 Special Rupee Vostro Account（SRVA），卢比余额用途被严格限定，导致俄罗斯一度累积大量难以使用的卢比。**斯里兰卡与伊朗的「茶换油」**则是第 3 类（实物补足）的长期案例：以锡兰茶出口抵偿石油进口货款。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph 双边清算账户&#10;        L1[商业价 contract price] --&gt; L3[清算价 accounting price]&#10;        L2[协定汇率 e_c] --&gt; L3&#10;        L3 --&gt; L4[净头寸 N]&#10;    end&#10;    L4 --&gt; R1[硬通货结清]&#10;    L4 --&gt; R2[结转下期]&#10;    L4 --&gt; R3[实物补足]&#10;    L4 --&gt; R4[债权折价转让]\">flowchart LR\n    subgraph 双边清算账户\n        L1[商业价 contract price] --&gt; L3[清算价 accounting price]\n        L2[协定汇率 e_c] --&gt; L3\n        L3 --&gt; L4[净头寸 N]\n    end\n    L4 --&gt; R1[硬通货结清]\n    L4 --&gt; R2[结转下期]\n    L4 --&gt; R3[实物补足]\n    L4 --&gt; R4[债权折价转让]</pre><h2 id=\"结算周期-触发条件与风险控制点\">结算周期、触发条件与风险控制点</h2><p>结算由三个谈判参数驱动，它们也是谈判的全部要害：</p>\n<table>\n<thead>\n<tr>\n<th>参数</th>\n<th>含义</th>\n<th>常见取值取向</th>\n<th>谁最在意</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>结算周期</td>\n<td>多久轧差一次</td>\n<td>每月 / 每两月（ACU 为两月）</td>\n<td>央行（外汇头寸）</td>\n</tr>\n<tr>\n<td>摆动额度 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>S</mi></mrow><annotation encoding=\"application/x-tex\">S</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span></span></span></span></span></td>\n<td>允许的最大挂账</td>\n<td>年贸易额的 10%–30%</td>\n<td>净出口方（信用风险）</td>\n</tr>\n<tr>\n<td>清算价与协定汇率</td>\n<td>记账与折算基础</td>\n<td>协定汇率或一篮子货币</td>\n<td>双方财政部</td>\n</tr>\n</tbody></table>\n<p>触发条件必须写死，否则会退化成账本上的无限展期。除「超出摆动额度」外，还有几个次级触发器：单笔交货超过约定货值比例须事前报备；某方连续两个周期无法用货物补足时，另一方有权要求硬通货结算或暂停交货；清算账户被第三方司法冻结时自动触发争议解决条款。风险控制的核心是<strong>履约能力对冲</strong>与<strong>合规前置</strong>——清算账户天然吸引规避制裁和外汇管制的动机，因此下列动作必须做成硬门：</p>\n<ul>\n<li><strong>制裁筛查</strong>：交易对手、货物、船舶、最终受益人须在每笔交货前过一遍名单（OFAC、EU、UN 等），清算账户不豁免任何一方的合规义务。</li>\n<li><strong>商品合规</strong>：易货常被用来交换难以定价或追踪的商品，需 HS 编码归类、原产地与用途申报，避免把清算账户变成受管制物项的通道。</li>\n<li><strong>会计与税务定性</strong>：非货币性交易在会计上通常按公允价值计量（参考 IFRS 中「以非货币性资产交换」的处理，以及收入准则对非现金对价的计量要求），税务上须分别认定两笔视同销售的进项与销项，否则会被认定为漏税。关税与增值税按「交货」而非「结算」发生，纳税义务在交货那一刻产生。</li>\n</ul>\n<h2 id=\"数字化实现-镜像账本-对账引擎与-cbdc-清算层\">数字化实现：镜像账本、对账引擎与 CBDC 清算层</h2><p>当清算账户从纸质台账搬到系统里，工程问题就变成三条：<strong>账本如何建模、差额如何自动对账、结算指令如何不经过传统代理行</strong>。账本建模的最低要求是「一份交易，两条分录，双向签章」，核心数据结构是一笔不可变的分录记录：</p>\n<div class=\"code-block-wrapper\" data-lang=\"ts\" data-code=\"type ClearingEntry = {&#10;  clearingId: string;&#10;  period: string;&#10;  direction: &#39;DEBIT&#39; | &#39;CREDIT&#39;;&#10;  counterparty: &#39;A_B&#39; | &#39;B_A&#39;;&#10;  accountingPrice: number;&#10;  clearingUnit: &#39;CLEARING_USD&#39; | &#39;CLEARING_EUR&#39; | &#39;LOCAL&#39;;&#10;  qty: number;&#10;  hsCode: string;&#10;  signedAt: string;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>type ClearingEntry = {</span></span>\n<span class=\"line\"><span>  clearingId: string;</span></span>\n<span class=\"line\"><span>  period: string;</span></span>\n<span class=\"line\"><span>  direction: 'DEBIT' | 'CREDIT';</span></span>\n<span class=\"line\"><span>  counterparty: 'A_B' | 'B_A';</span></span>\n<span class=\"line\"><span>  accountingPrice: number;</span></span>\n<span class=\"line\"><span>  clearingUnit: 'CLEARING_USD' | 'CLEARING_EUR' | 'LOCAL';</span></span>\n<span class=\"line\"><span>  qty: number;</span></span>\n<span class=\"line\"><span>  hsCode: string;</span></span>\n<span class=\"line\"><span>  signedAt: string;</span></span>\n<span class=\"line\"><span>};</span></span></code></pre></div><p>不可变 + 双向签章保证两本账可用一条恒等式校验：对任一 <code>clearingId</code>，两侧分录金额相等、方向相反，校验失败则进入人工核销队列。这一层不必用区块链——双边共享的对账服务加数字签名即可；只有当参与方超过两个且彼此不信任时，链式结构才真正带来收益。多边场景的新变量是<strong>结算层的技术主权</strong>：传统上清算余额最终要通过 SWIFT 与代理行完成硬通货结算，制裁风险恰恰集中在这一跳。作为回应，出现了各国自建的报文/支付系统（中国的 CIPS、俄罗斯的 SPFS），以及国际清算银行（BIS）创新中心牵头的多央行数字货币桥 <strong>mBridge</strong>——香港金管局、泰国央行、中国人民银行数字货币研究所、阿联酋央行共同参与，2024 年 6 月进入最小可行产品（MVP）阶段，随后 BIS 于 2024 年底退出、交由参与央行继续运营。区域层面，<strong>本币结算框架</strong>（Local Currency Transaction, LCT）是清算账户的现代软形态：印度尼西亚央行与马来西亚、泰国、日本、中国、新加坡、韩国等先后签署本币结算合作，指定授权银行（ACCD）为企业开立本币账户、直接以两国本币计价结算。</p>\n<p>工程团队的落地检查清单：余额与剩余摆动额度实时可视（余额是「受限资产」，不能当作现金）；镜像账本按 <code>clearingId</code> 自动对账，差额按「金额 + 汇率 + 手续费」三元归因；协定清算汇率与市场汇率偏离超阈值时告警；制裁筛查、HS 归类、用途申报做成不可跳过的系统前置；清算余额的最终出口（硬通货 / 转口 / 货物）配置化。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>直接易货的工程化归宿是<strong>双边清算账户</strong>：货币退为记账单位，只在差额超过阈值时短暂充当支付手段。</li>\n<li>清算账户的本体是<strong>两本镜像账</strong>，恒等式 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>A</mi><mi>B</mi></msub><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo>+</mo><msub><mi>B</mi><mi>A</mi></msub><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo>≡</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">A_B(t) + B_A(t) \\equiv 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">A</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0502em;\">B</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">t</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0502em;\">B</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-left:-0.0502em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">A</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">t</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≡</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span> 是所有对账逻辑的起点。</li>\n<li>结算由三个谈判参数驱动：结算周期、摆动额度 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>S</mi></mrow><annotation encoding=\"application/x-tex\">S</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span></span></span></span></span>、清算价与协定汇率 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>c</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_c</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">c</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>；<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>c</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_c</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">c</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 与市场汇率 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>e</mi><mi>m</mi></msub></mrow><annotation encoding=\"application/x-tex\">e_m</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">m</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 的偏离会形成隐性的国家间转移。</li>\n<li>差额只有四个出口：硬通货结清、结转下期、实物补足、债权折价转让。</li>\n<li>真实参照包括亚洲清算联盟（ACU）的多边净额、印度-伊朗卢比结算与印度储备银行 2022 年的 SRVA 机制、斯里兰卡-伊朗「茶换油」，以及区域性本币结算框架（如印尼 LCT）。</li>\n<li>数字化关键在于镜像账本建模、按 <code>clearingId</code> 的自动对账、以及 CIPS/SPFS/mBridge 等替代结算路径的可切换性；合规（制裁筛查、HS 归类、非货币性交易的会计与税务定性）必须前置为系统硬门。</li>\n</ul>\n","headings":[{"level":1,"text":"直接易货与双边清算账户运作机制","id":"直接易货与双边清算账户运作机制"},{"level":2,"text":"核心概念：为什么易货贸易最终都会长出一个「银行账户」","id":"核心概念-为什么易货贸易最终都会长出一个-银行账户"},{"level":2,"text":"清算账户的记账与净额结算：账本才是本体","id":"清算账户的记账与净额结算-账本才是本体"},{"level":2,"text":"清算汇率、记账价与差额的四种出口","id":"清算汇率-记账价与差额的四种出口"},{"level":2,"text":"结算周期、触发条件与风险控制点","id":"结算周期-触发条件与风险控制点"},{"level":2,"text":"数字化实现：镜像账本、对账引擎与 CBDC 清算层","id":"数字化实现-镜像账本-对账引擎与-cbdc-清算层"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"对等贸易合同框架与对等义务条款结构","url":"/l-doc-books/h/global-ecommerce/countertrade-barter-offset-operations/countertrade-models-classification/reciprocal-contract-obligation-framework"},"next":{"title":"易货商品估值与等价性核验方法","url":"/l-doc-books/h/global-ecommerce/countertrade-barter-offset-operations/barter-clearing-settlement/barter-goods-valuation-verification"}}