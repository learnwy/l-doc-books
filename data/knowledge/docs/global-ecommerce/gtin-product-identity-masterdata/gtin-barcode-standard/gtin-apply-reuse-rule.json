:#F97583\">AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> closed_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> random() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">LIMIT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v_prefix </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RAISE EXCEPTION </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'pool % exhausted'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, p_pool; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">END</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  v_gtin :</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lpad(v_prefix </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p_item_ref, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">13</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  v_gtin :</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v_gtin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gs1_check_digit(v_gtin);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  INSERT INTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> product_identity_gtin(gtin14, indicator, company_prefix, prefix_len,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">         item_ref, brand_owner_gln, allocated_at)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  VALUES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (v_gtin, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">left</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v_gtin,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), v_prefix, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v_prefix), p_item_ref,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          current_setting(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'app.brand_gln'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  RETURN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v_gtin;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">EXCEPTION </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> unique_violation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">THEN</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  RAISE EXCEPTION </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'item_ref % already used under prefix %'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, p_item_ref, v_prefix;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">END</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $$;</span></span></code></pre></div><p>这里的 <code>unique_violation</code> 处理是关键：发号器的正确性不能靠「先查再插」，必须靠主键唯一约束去挡并发。两个运营同时给不同商品发同一个项目引用时，数据库必须让后者失败，而不是两件商品共用一个号。</p>\n<h2 id=\"谁来发号-组织与流程\">谁来发号：组织与流程</h2><h3 id=\"单一发号入口\">单一发号入口</h3><p>前缀自治意味着如果多个团队各自维护 Excel 号段表，冲突只是时间问题。发号必须是<strong>单一服务入口</strong>：调用方提供「用码主体（品牌 GLN）+ 期望用途 + 商品标识」，服务返回一个新号或明确报错。发号服务同时承担三项职责：从正确的池里取号、写入分配记录（谁在何时为何分配了这个号）、以及拒绝不满足条件的请求。</p>\n<h3 id=\"号段预留与冲突避免\">号段预留与冲突避免</h3><p>大型企业通常按用途划分子池：生产采购品、渠道专供品、赠品与样品、测试用号。子池是<strong>管理便利</strong>，不是 GS1 强制要求——GS1 只看到前缀，看不到你怎么分。子池的价值在于限制爆炸半径：测试号池与生产号池分离后，一次误用测试号的发布不会污染真实目录；且子池配额可以按事业部核算，把号段消耗变成可度量的成本。</p>\n<h3 id=\"并购与遗留号的处理\">并购与遗留号的处理</h3><p>并购带来的旧前缀不要在迁移时「顺手换成自己的号」——已流通包装上的条码仍然有效，渠道历史数据仍然指向旧号。正确做法是把旧前缀作为<strong>继承池</strong>纳入统一管理：只读、不再发新号、但持续维护映射关系；同时在对外数据里通过「同一商品多 GTIN」的关系表达新旧号共存（这一关系的治理见 <a href=\"../identifier-governance/one-code-variant-govern\">一变多码/一码多变识别治理</a>）。</p>\n<h2 id=\"与外部的契约\">与外部的契约</h2><h3 id=\"前缀不代表产地\">前缀不代表产地</h3><p><a href=\"https://en.wikipedia.org/wiki/List_of_GS1_country_codes\">GS1 前缀分配表</a>明确提醒：<strong>GS1 前缀不标识商品的原产地</strong>。前缀表明的是「这个号由哪个成员组织分配给谁」，企业可以在任何国家生产。跨境业务里把前缀当前缀国、再把前缀国当清关原产国，是会导致关税归类错误的实质性错误——原产地由货物的实质改变地决定，是另一个字段、另一套规则。</p>\n<h3 id=\"注册与可验证\">注册与可验证</h3><p>渠道与消费者需要能核验「这个号是不是真的属于这个品牌」。GS1 提供的前缀与 GTIN 核验入口（如 Verified by GS1 一类的服务）让品牌把自有 GTIN 与品牌实体关联起来，第三方可查询该号归属。这类注册的价值不是法律强制，而是<strong>渠道信任</strong>：Google Merchant Center 明确要求「只在你确定正确时才提供 GTIN」，并警告「不要猜测、杜撰或复用其他商品的标识符」，缺失或不正确的 GTIN 会导致「可见性受限」与商品被拒（<a href=\"https://support.google.com/merchants/answer/6324461\">规范原文</a>）。注册核验让你在这些自动校验里少踩坑。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>分配权是分层的：GS1 给前缀，企业在前缀内自主发号，唯一性靠自律。</li>\n<li>前缀容量按 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>2</mn><mo>×</mo><msup><mn>10</mn><mrow><mo stretchy=\"false\">(</mo><mn>12</mn><mo>−</mo><mi>L</mi><mo stretchy=\"false\">)</mo></mrow></msup></mrow><annotation encoding=\"application/x-tex\">2 \\times 10^{(12-L)}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">2</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.888em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.888em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mopen mtight\">(</span><span class=\"mord mtight\">12</span><span class=\"mbin mtight\">−</span><span class=\"mord mathnormal mtight\">L</span><span class=\"mclose mtight\">)</span></span></span></span></span></span></span></span></span></span></span></span></span> 量级估算，按<strong>三年峰值 SKU 数的 2 倍</strong>留余量。</li>\n<li>换号判定树的第一问是「消费者视角下是不是另一件商品」；价格、文案、渠道差异都不换号。</li>\n<li>换号 ≠ 退役：换号是新品用新号，退役是旧号永久退出流通。</li>\n<li>GTIN 退役后必须经过冷却期才能回收，且必须以硬约束而非流程纪律实现。</li>\n<li>发号必须走单一服务入口，靠主键唯一约束挡并发冲突，不靠「先查再插」。</li>\n<li>多前缀并存是常态，用池模型管理，不要试图统一或迁移。</li>\n<li>前缀不表示原产地；把前缀当清关原产国是实质性错误。</li>\n</ul>\n","headings":[{"level":1,"text":"GTIN 申请、分配与复用规则","id":"gtin-申请-分配与复用规则"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"前缀的取得与管理","id":"前缀的取得与管理"},{"level":3,"text":"申请与容量估算","id":"申请与容量估算"},{"level":3,"text":"多前缀并存是常态","id":"多前缀并存是常态"},{"level":2,"text":"换号判定树","id":"换号判定树"},{"level":3,"text":"必须换号的变化","id":"必须换号的变化"},{"level":3,"text":"不应换号的变化","id":"不应换号的变化"},{"level":3,"text":"退役与回收窗口","id":"退役与回收窗口"},{"level":2,"text":"谁来发号：组织与流程","id":"谁来发号-组织与流程"},{"level":3,"text":"单一发号入口","id":"单一发号入口"},{"level":3,"text":"号段预留与冲突避免","id":"号段预留与冲突避免"},{"level":3,"text":"并购与遗留号的处理","id":"并购与遗留号的处理"},{"level":2,"text":"与外部的契约","id":"与外部的契约"},{"level":3,"text":"前缀不代表产地","id":"前缀不代表产地"},{"level":3,"text":"注册与可验证","id":"注册与可验证"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"GTIN/UPC/EAN/ISBN 结构与校验位","url":"/l-doc-books/h/global-ecommerce/gtin-product-identity-masterdata/gtin-barcode-standard/gtin-upc-ean-isbn-structure"},"next":{"title":"MPN/品牌与内部 SKU 关系","url":"/l-doc-books/h/global-ecommerce/gtin-product-identity-masterdata/gtin-barcode-standard/mpn-brand-identifier-relation"}}