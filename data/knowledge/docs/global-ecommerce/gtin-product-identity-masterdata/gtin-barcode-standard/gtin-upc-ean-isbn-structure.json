an><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(company_prefix) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prefix_len</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                           AND</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item_ref) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 13</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prefix_len)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 通用校验位计算：从校验位左边一位起向左交替乘 3、1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE OR REPLACE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FUNCTION</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> gs1_check_digit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(body </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">RETURNS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> char</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> LANGUAGE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> sql</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> IMMUTABLE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $$</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(d </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> CASE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> WHEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i % </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ELSE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> END</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) % </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) % </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">char</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">substring</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">reverse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(body) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d, i</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        FROM</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> generate_series</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(body)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i) t;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$$;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 校验：完整 GTIN 的校验位必须等于去掉末位的计算结果</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gtin14, gs1_check_digit(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">left</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(gtin14,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">13</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> right</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(gtin14,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> valid</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> product_identity_gtin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> retired_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><h3 id=\"校验位挡不住什么\">校验位挡不住什么</h3><p>校验位是<strong>打字错误检测器</strong>，不是合法性证明。它能把任意一串数字算出一个「正确」的校验位——包括从未被任何 GS1 成员组织分配过的组合。它保证不了：该前缀是否已被分配、该持有人是否有权用这个前缀、该号是否已被同企业的另一件商品占用、以及该号是否落在受限流通号段里。后三项分别属于结构层与业务层的校验，见 <a href=\"../identifier-governance/invalid-gtin-validate-block\">无效/滥用 GTIN 校验拦截</a>。一个只做校验位的「GTIN 校验服务」在渠道治理上几乎为零价值。</p>\n<h2 id=\"upc-ean-isbn-gtin-的相互转换\">UPC/EAN/ISBN/GTIN 的相互转换</h2><h3 id=\"图书-isbn-就是加前缀的-ean\">图书：ISBN 就是加前缀的 EAN</h3><p><a href=\"https://en.wikipedia.org/wiki/ISBN\">ISBN 标准</a>的演进解释了为什么图书可以用零售条码扫描。10 位 ISBN 于 1970 年作为 ISO 2108 发布，2007 年 1 月 1 日起新分配的 ISBN 一律为 13 位。ISBN-13 的五个部分（GS1 前缀、注册组、出版商、出版物元素、校验位）中，GS1 前缀只能是 <strong>978 或 979</strong>，其结构与 EAN-13 完全一致——所以 ISBN-13 本质上就是一个 GTIN-13。<a href=\"https://en.wikipedia.org/wiki/International_Article_Number\">Wikipedia 的 EAN 条目</a>也确认 EAN「已被整合进更广泛的 GTIN 标准」。</p>\n<p>两个必须记住的转换细节：ISBN-10 → ISBN-13 是「前缀 978 + 重算校验位」，<strong>校验位通常会变</strong>（ISBN-10 用加权 10→2、模 11、校验位可为 X；ISBN-13 用 1/3 交替、模 10）；反向转换只在 978 前缀下可行，979 的书无法还原成 ISBN-10。另外 979-0 段保留给 ISMN 乐谱号，不是图书。</p>\n<h3 id=\"北美-upc-a-是补零的-gtin-13\">北美：UPC-A 是补零的 GTIN-13</h3><p>UPC-A 的 12 位与 GTIN-13 的关系是「左补一个 0」。这也是为什么 UCP 号段的判断要在 13 位形式下做：<code>036000241457</code> 补零成 <code>0036000241457</code> 后，前缀 <code>003</code> 落在 GS1 US 的分配范围内。反过来，任何以 0 开头的 EAN-13 实际上都印成了 UPC-A。</p>\n<h3 id=\"受限号段-不要把-能算出校验位-当成-可以用\">受限号段：不要把「能算出校验位」当成「可以用」</h3><p><a href=\"https://en.wikipedia.org/wiki/List_of_GS1_country_codes\">GS1 国家/成员组织前缀表</a>列出了若干<strong>不得用于零售单品</strong>的号段：<code>020–029</code>（地区内受限流通号）、<code>040–049</code>（企业内部受限流通号）、<code>200–299</code>（地区内受限流通号）、<code>980</code>（退款收据）、<code>981–983</code>（通用货币区优惠券）、<code>990–999</code>（优惠券识别），以及 <code>050–059</code>（GS1 US 保留）。同一份资料还提醒：<strong>GS1 前缀不表示商品原产地</strong>——前缀标识的是编号分配地，不是制造地。把前缀当产地字段用，是跨境商品数据里一个经典且代价高昂的错误。</p>\n<p>Google Merchant Center 的产品数据规范把这条落成了可执行的拒绝清单：不接受受限号段前缀 <code>02、04、2</code>，不接受优惠券号段 <code>05、98、99</code>，并要求校验位必须存在且正确、只接受 8/12/13/14 位数字（<a href=\"https://support.google.com/merchants/answer/6324461\">规范原文</a>）。这正是下一章「校验拦截」要实现的规则的现实版本。</p>\n<h2 id=\"数字之外的载体\">数字之外的载体</h2><p>数字算对了，还要能被机器读到。零售端最常用的是 EAN-13 与 UPC-A 两种一维符号；运输包装用 ITF-14 或 GS1-128；<a href=\"https://en.wikipedia.org/wiki/GS1\">GS1 Sunrise 2027 计划</a>推动零售与医疗把扫码从一维条码迁移到二维码与 GS1 DataMatrix，让一个符号同时承载 GTIN 与批次、序列号、有效期。</p>\n<p>二维码里的 GTIN 通常以 <a href=\"https://ref.gs1.org/standards/digital-link/uri-syntax/\">GS1 Digital Link</a> 的规范 URI 形式出现，形如 <code>https://id.gs1.org/01/09520123456788/10/ABC123</code>，其中 <code>01</code> 是 GTIN 的 AI、<code>10</code> 是批次；规范形式要求 GTIN 补齐 14 位、域名用 <code>id.gs1.org</code>、限定符顺序固定为 22（消费者变体）→ 10（批次）→ 21（序列号）。这意味着「一个码」既是商品身份标识，也是一个可解析的网络地址——数据侧因此必须能同时按「AI 元素串」与「URI」两种形态解析同一个身份。</p>\n<p>Web 端还有一个平行的表示层：schema.org 的 <code>Product</code> 用 <code>gtin</code> 属性承载 <a href=\"https://schema.org/Product\">GTIN</a>，定义为「8、12、13 或 14 位的全数字字符串」，并明确「<strong>不要求也不鼓励对 GTIN 值做左补零</strong>」，同时保留了 <code>gtin8/gtin12/gtin13/gtin14</code> 这四个被 <code>gtin</code> 泛化的旧属性。这条与内部「统一规范化为 14 位」的策略并不矛盾：内部规范化是为了自己可控，对外输出则按接收方的规范来——结构化数据里补零会被判为格式错误。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>GTIN 是编号体系，EAN/UPC/ITF 是载体；体系内部只应存<strong>一种规范形式</strong>，出口处再裁剪。</li>\n<li>校验位算法用「从校验位左边一位起向左交替乘 3、1」表述最不易出错，模 10 后余数为 0 则校验位取 0。</li>\n<li>校验位只证明<strong>没打错</strong>，不证明<strong>被合法分配</strong>——后者的校验在下一章。</li>\n<li>GTIN-14 的指示符位没有全球统一语义，不要把包装层级编码进这一位。</li>\n<li>厂商前缀长度可变，解析必须靠前缀表或显式长度字段，不能硬编码。</li>\n<li>ISBN-13 就是 978/979 前缀的 GTIN-13；UPC-A 就是补零的 GTIN-13；UPC-E 只是表示法。</li>\n<li>受限号段（02x/04x/2xx/05x/98x/99x）不得用于零售单品，平台侧会直接拒绝。</li>\n<li>2D 码时代同一个符号同时承载身份与批次/序列号，解析要同时支持 AI 元素串与 Digital Link URI 两种形态。</li>\n</ul>\n","headings":[{"level":1,"text":"GTIN/UPC/EAN/ISBN 结构与校验位","id":"gtin-upc-ean-isbn-结构与校验位"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"四段结构与位宽","id":"四段结构与位宽"},{"level":3,"text":"指示符位的语义陷阱","id":"指示符位的语义陷阱"},{"level":3,"text":"厂商前缀的可变长度","id":"厂商前缀的可变长度"},{"level":3,"text":"UPC-E 是表示法，不是编号体系","id":"upc-e-是表示法-不是编号体系"},{"level":2,"text":"校验位算法","id":"校验位算法"},{"level":3,"text":"逐步推导","id":"逐步推导"},{"level":3,"text":"校验位挡不住什么","id":"校验位挡不住什么"},{"level":2,"text":"UPC/EAN/ISBN/GTIN 的相互转换","id":"upc-ean-isbn-gtin-的相互转换"},{"level":3,"text":"图书：ISBN 就是加前缀的 EAN","id":"图书-isbn-就是加前缀的-ean"},{"level":3,"text":"北美：UPC-A 是补零的 GTIN-13","id":"北美-upc-a-是补零的-gtin-13"},{"level":3,"text":"受限号段：不要把「能算出校验位」当成「可以用」","id":"受限号段-不要把-能算出校验位-当成-可以用"},{"level":2,"text":"数字之外的载体","id":"数字之外的载体"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"GTIN 申请、分配与复用规则","url":"/l-doc-books/h/global-ecommerce/gtin-product-identity-masterdata/gtin-barcode-standard/gtin-apply-reuse-rule"}}