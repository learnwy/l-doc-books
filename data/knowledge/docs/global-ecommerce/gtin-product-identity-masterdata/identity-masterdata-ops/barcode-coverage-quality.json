/span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> retired_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">numeric</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">             /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nullif</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gtin_required),</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> supplier_id;</span></span></code></pre></div><p>取数逻辑的两个要点：分母用 <code>WHERE gtin_required</code> 过滤（而不是事后排除），分子同时要求 <code>verdict=&#39;PASS&#39;</code> 与 <code>retired_at IS NULL</code>。前者保证「格式正确但结构性滥用」的号不被计为有效，后者保证「退役号仍在售」被正确识别为缺口。</p>\n<h3 id=\"缺口归因查询\">缺口归因查询</h3><div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 缺口归因：把每个缺口分配到具体的修复队列&#10;SELECT CASE&#10;         WHEN l.gtin14 IS NULL                       THEN &#39;never_allocated&#39;&#10;         WHEN v.verdict = &#39;BLOCK&#39; AND v.reason LIKE &#39;format%&#39; THEN &#39;data_error&#39;&#10;         WHEN v.verdict = &#39;BLOCK&#39; AND v.reason LIKE &#39;range%&#39;  THEN &#39;restricted_range&#39;&#10;         WHEN g.retired_at IS NOT NULL               THEN &#39;retired_still_active&#39;&#10;         ELSE &#39;other&#39; END AS gap_type,&#10;       count(*) AS sku_count,&#10;       array_agg(DISTINCT s.supplier_id) AS suppliers&#10;FROM merchant_sku s&#10;LEFT JOIN sku_gtin_link l ON l.sku_id = s.sku_id AND l.link_type=&#39;primary&#39; AND l.valid_to IS NULL&#10;LEFT JOIN product_identity_gtin g ON g.gtin14 = l.gtin14&#10;CROSS JOIN LATERAL (SELECT validate_gtin(coalesce(l.gtin14,&#39;&#39;), coalesce(b.brand_owner_gln,&#39;&#39;)::char(13)) AS * FROM brand_entity b WHERE b.brand_id = s.brand_id) v&#10;WHERE s.status=&#39;active&#39; AND s.gtin_required&#10;GROUP BY 1 ORDER BY 2 DESC;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 缺口归因：把每个缺口分配到具体的修复队列</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> CASE</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">         WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">gtin14</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">                       THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'never_allocated'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">         WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">verdict</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'BLOCK'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">reason</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> LIKE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'format%'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'data_error'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">         WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">verdict</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'BLOCK'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">reason</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> LIKE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'range%'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">  THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'restricted_range'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">         WHEN</span><span style=\"color:#005CC5;--shiki-dark: