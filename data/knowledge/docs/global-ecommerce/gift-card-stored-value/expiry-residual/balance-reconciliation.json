292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      at: asOf,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tx.ledger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      accountId: acc.id,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      direction: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'DEBIT'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      amountMinor: balance,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      currency: acc.currency,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      source: { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'EXPIRY_WRITE_OFF'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, policyRef: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">j</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ruleRef</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:escheat`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      idempotencyKey: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`escheat:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">acc</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">id</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">j</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">jurisdiction</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">asOf</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getUTCFullYear</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">()</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      occurredAt: asOf,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    moved </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { moved };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>一是幂等键按「账户 + 辖区 + 年度」构造</strong>，保证任务重跑不会重复移交。<strong>二是移交前必须重算余额</strong>，不能信任候选列表里的陈旧值——候选列表可能是几小时前生成的。<strong>三是移交记录与流水分离</strong>（<code>escheatRecords</code> 独立表）：流水回答「账怎么动的」，移交记录回答「移交给谁、依据哪条规则、金额多少」，后者是要向政府报送的材料，字段要求与流水不同。</p>\n<p><strong>移交之后余额归零，但负债总额只是从桶 C 移到桶 D</strong>，不是减少。这一点常被误算：如果移交时把负债直接减掉，报表会出现一笔无法解释的「利润」，而实际上商家只是把欠用户的钱转交给了政府。<strong>移交是负债的转移，不是负债的消除</strong>——这是本文最容易被写错的一处。</p>\n<h2 id=\"未确认收入与收入确认边界\">未确认收入与收入确认边界</h2><p>桶 A 与桶 B 都是负债，它们的对立面是<strong>收入</strong>。什么时候从负债转为收入，是一个会计政策决定，不是技术决定，但技术必须支持：</p>\n<table>\n<thead>\n<tr>\n<th>事件</th>\n<th>负债变化</th>\n<th>收入确认</th>\n<th>备注</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>售出礼品卡</td>\n<td>负债增加（实收现金）</td>\n<td>不确认</td>\n<td>见<a href=\"../gift-card-lifecycle/card-issue-purchase\">发行时面值与实付的区分</a></td>\n</tr>\n<tr>\n<td>兑换入账</td>\n<td>负债载体变更，总额不变</td>\n<td>不确认</td>\n<td>卡 → 账户</td>\n</tr>\n<tr>\n<td>用余额支付订单</td>\n<td>负债减少</td>\n<td>确认（等同现金销售）</td>\n<td>商品交付时点确认</td>\n</tr>\n<tr>\n<td>卡过期（辖区允许核销）</td>\n<td>负债减少</td>\n<td>可能确认收入</td>\n<td>部分辖区有特定要求，需法务确认</td>\n</tr>\n<tr>\n<td>休眠收费</td>\n<td>负债减少</td>\n<td>确认为服务收入</td>\n<td>须先满足披露与频率条件</td>\n</tr>\n<tr>\n<td>移交无主财产</td>\n<td>负债转移到桶 D</td>\n<td><strong>不确认收入</strong></td>\n<td>移交不等于收入</td>\n</tr>\n</tbody></table>\n<p><strong>「过期核销」与「移交」在收入确认上完全不同</strong>：前者可能在辖区允许的前提下转为收入，后者绝不确认收入（因为钱要交出去）。把两者混为一谈会在报表上制造虚假利润，也是审计的常见发现点。</p>\n<p><strong>兑换不是收入确认点</strong>。用户把卡兑换成余额，商家还欠他等值商品；只有商品交付时才确认收入。这就是为什么「余额消耗率」比「充值额」更能反映健康状况——充值只是负债增加，消耗才是收入实现。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>储值负债拆成四个桶</strong>（发行未核销 / 已兑换未消费 / 已过期未移交 / 已移交无主财产），四桶之和等于负债总额；兑换只是负债换载体，不改变总额。</li>\n<li><strong>对账是三方对账</strong>（流水聚合 / 物化快照 / 外部资金流），报告必须带 <code>sampleEntryIds</code> 以便差异定位到具体流水。</li>\n<li><strong>对账按币种分列</strong>，报表折算需声明汇率口径，与第 2 章的即时折算严格分离。</li>\n<li><strong>对账只读，绝不自动修账</strong>；修正只能通过带审批的冲正流水。</li>\n<li><strong>移交任务必须幂等</strong>（键 = 账户 + 辖区 + 年度）、<strong>移交前重算余额</strong>、<strong>移交记录与流水分离</strong>。</li>\n<li><strong>移交是负债的转移不是消除</strong>——它把桶 C 移到桶 D；写成负债减少会凭空产生无法解释的利润。</li>\n<li><strong>收入确认边界是会计政策</strong>：兑换入账不确认收入，商品交付才确认；过期核销与移交在收入确认上完全不同，后者绝不确认收入。<strong>余额消耗率比充值额更能反映业务健康</strong>。</li>\n</ul>\n<p>至此，资金的记账与退出路径已经闭环。剩下的问题是这门生意天生吸引的攻击面：见<a href=\"../aml-fraud/aml-stored-value\">反洗钱：充值限额/可疑交易</a>。</p>\n","headings":[{"level":1,"text":"储值负债对账","id":"储值负债对账"},{"level":2,"text":"核心概念：负债的四个桶","id":"核心概念-负债的四个桶"},{"level":2,"text":"对账的三方来源与差异定位","id":"对账的三方来源与差异定位"},{"level":2,"text":"移交任务的职责边界","id":"移交任务的职责边界"},{"level":2,"text":"未确认收入与收入确认边界","id":"未确认收入与收入确认边界"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"残值处理与休眠余额","url":"/l-doc-books/h/global-ecommerce/gift-card-stored-value/expiry-residual/residual-value"},"next":{"title":"反洗钱：充值限额/可疑交易","url":"/l-doc-books/h/global-ecommerce/gift-card-stored-value/aml-fraud/aml-stored-value"}}