ark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.2126</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.7152</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data[i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.0722</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data[i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lum;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(lum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> BACKGROUND_LUM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) nonBackground </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> coverage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nonBackground </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> total;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> meanLum</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> total;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 覆盖率过低 = 模型没渲染出来； luminance 极端 = 全黑或全白</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    status: coverage </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.02</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'model_missing'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> meanLum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 8</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'black_screen'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> meanLum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 247</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'white_screen'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ok'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    coverage: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">coverage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meanLum: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">meanLum.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>这个检查可以放进 CI，对每个新资产跑一遍——<strong>它同时是资产质检的一部分</strong>：一个因为法线错误而渲染成全黑的模型，会在结构校验通过（glTF-Validator 只看数据合法性）之后在这里被抓住。</p>\n<h3 id=\"色彩正确性的比对\">色彩正确性的比对</h3><p>色彩问题比黑屏隐蔽得多：模型能渲染，但颜色不对。这类问题需要<strong>基准图比对</strong>：在固定相机、固定光照下渲染一张基准图并入库，之后每次渲染结果与基准图做感知距离比对。</p>\n<p>这里有一个必须处理的细节：<strong>比对必须容忍色调映射与色彩管理的差异</strong>。同一个模型在不同设备上的输出天然有差异（GPU 精度、色彩空间处理、色调映射实现）。如果基准图是在 A 设备上生成的，B 设备的正常输出可能也会超过阈值。可行做法是用<strong>感知距离指标</strong>（如 CIEDE2000 色差）而不是逐像素差值，并对每个设备族维护独立基准。</p>\n<p>这也解释了为什么 <a href=\"../3d-asset-production-spec/gltf-usdz-material-spec\">容器、材质与精度规格</a> 里推荐 PBR Neutral 色调映射：它给 baseColor 在每个通道 0.08–0.8 区间内一个<strong>可验证的保真保证</strong>，让「颜色对不对」有一个可以写成断言的性质，而不是靠肉眼比对。</p>\n<h2 id=\"能力可用性与机型矩阵\">能力可用性与机型矩阵</h2><h3 id=\"机型矩阵怎么建\">机型矩阵怎么建</h3><p>不需要测所有机型。有效的矩阵是按<strong>流量份额分层采样</strong>，并对每层定义明确的验收标准：</p>\n<table>\n<thead>\n<tr>\n<th>层</th>\n<th>选取依据</th>\n<th>样本量</th>\n<th>验收标准</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>塔尖</td>\n<td>单机型流量份额 top 10</td>\n<td>10 机型 × 2 浏览器</td>\n<td>全部功能可用，零阻断缺陷</td>\n</tr>\n<tr>\n<td>主流</td>\n<td>累计流量 80%</td>\n<td>约 30–50 机型</td>\n<td>AR 可用或至少 3D 查看可用</td>\n</tr>\n<tr>\n<td>长尾</td>\n<td>剩余</td>\n<td>不逐一测</td>\n<td>靠线上监控 + 兜底链路</td>\n</tr>\n<tr>\n<td>极低端</td>\n<td>无 WebGL2 / 内存 ≤ 2GB</td>\n<td>抽 3–5 款</td>\n<td>走预渲染或 2D 图，无崩溃</td>\n</tr>\n</tbody></table>\n<p>关键设计是<strong>长尾不逐一测但要保证不崩</strong>。可行的保证来自 <a href=\"../asset-sku-serving/edge-cloud-render-fallback\">端/云渲染与性能降级</a> 的兜底链：能力探测失败就走预渲染图，预渲染不可用就走 2D 图。只要兜底链本身在所有机型上工作，长尾就不会出现「完全不可用」。</p>\n<h3 id=\"ar-可用性的真实分布\">AR 可用性的真实分布</h3><p>AR 可用性不是一个布尔值，而是一个有多档的分布。ARCore 的设备兼容性文档给出了具体约束：默认情况下设备必须运行 Android 7.0 或更新；AR Optional 应用的 <code>minSdkVersion</code> 需 ≥ 19，AR Required 需 ≥ 24；所有设备至少支持 OpenGL ES 3.0，多数支持 3.2；<strong>截至 2026 年 5 月，超过 88% 的活跃设备支持 Depth API</strong>（<a href=\"https://developers.google.com/ar/devices\">ARCore Devices</a>）。</p>\n<p>iOS 侧，AR Quick Look 需要 iOS/iPadOS 12 或 visionOS 1 及以上（<a href=\"https://developer.apple.com/augmented-reality/quick-look/\">AR Quick Look</a>）。Vision Pro 上的行为不同——Safari 26.0（对应 visionOS 26.0）开始支持 HTML <code>&lt;model&gt;</code> 元素做内联 3D 展示，无需 WebXR 或自定义 JS（<a href=\"https://developer.apple.com/documentation/safari-release-notes/safari-26-release-notes\">Safari 26 Release Notes</a>）。</p>\n<p>WebXR 侧的 hit-test 与 depth-sensing 支持面窄得多：hit-test 在 Chrome/Edge 自 81+，Samsung Internet 的 <code>requestHitTestSource()</code> 自 12.1+，Firefox 与 Safari 桌面版尚无；depth-sensing 的 CPU 接口在 Chrome/Edge 90+，Firefox 与 Safari 无（<a href=\"https://immersive-web.github.io/hit-test/\">WebXR Hit Test</a>、<a href=\"https://immersive-web.github.io/depth-sensing/\">WebXR Depth Sensing</a>）。</p>\n<p>这意味着一个 Web 端 AR 方案如果只押 WebXR，会把 iOS 全部用户排除。<strong>跨平台 AR 必须同时实现 Quick Look 与 Scene Viewer 两条原生跳出路径</strong>，而不是指望 WebXR 统一。</p>\n<table>\n<thead>\n<tr>\n<th>能力</th>\n<th>支持面</th>\n<th>影响的兜底</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>AR Quick Look (USDZ)</td>\n<td>iOS/iPadOS 12+、visionOS 1+</td>\n<td>iOS 侧必需路径</td>\n</tr>\n<tr>\n<td>Scene Viewer (Android)</td>\n<td>ARCore 支持设备 + Play Services for AR</td>\n<td>Android 侧必需路径</td>\n</tr>\n<tr>\n<td>WebXR immersive-ar</td>\n<td>Chrome/Edge 系为主</td>\n<td>站内 AR 增强</td>\n</tr>\n<tr>\n<td>WebXR hit-test</td>\n<td>Chrome/Edge 81+</td>\n<td>站内 AR 的锚定能力</td>\n</tr>\n<tr>\n<td>WebXR depth-sensing</td>\n<td>Chrome/Edge 90+，约 88% 活跃设备（ARCore 口径）</td>\n<td>深度遮挡</td>\n</tr>\n<tr>\n<td><code>&lt;model&gt;</code> 内联 3D</td>\n<td>Safari 26 / visionOS 26</td>\n<td>Vision Pro 内联展示</td>\n</tr>\n</tbody></table>\n<h3 id=\"线上监控埋点\">线上监控埋点</h3><p>埋点是长尾机型的唯一防线。要埋的事件与要回答的问题一一对应：</p>\n<table>\n<thead>\n<tr>\n<th>事件</th>\n<th>字段</th>\n<th>回答的问题</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>viewer_probe</code></td>\n<td>tier, webgl2, maxTextureSize, deviceMemory</td>\n<td>探测分布是否与假设一致</td>\n</tr>\n<tr>\n<td><code>viewer_load_start</code></td>\n<td>assetId, lod, bytes</td>\n<td>加载次数与资源体积分布</td>\n</tr>\n<tr>\n<td><code>viewer_load_result</code></td>\n<td>ok/fail, reason, ms, bytes</td>\n<td>失败率与失败原因（超时/解码/显存）</td>\n</tr>\n<tr>\n<td><code>viewer_first_frame</code></td>\n<td>ms</td>\n<td>首帧时间分布，按机型分层</td>\n</tr>\n<tr>\n<td><code>viewer_fps_sample</code></td>\n<td>fps, lod, window</td>\n<td>帧率分布，识别需要降级的人群</td>\n</tr>\n<tr>\n<td><code>ar_entry_click</code></td>\n<td>mode（webxr/scene-viewer/quick-look）</td>\n<td>用户实际走哪条路径</td>\n</tr>\n<tr>\n<td><code>ar_session_result</code></td>\n<td>ok/fail, reason</td>\n<td>AR 会话成功率，按机型/OS 版本分层</td>\n</tr>\n<tr>\n<td><code>ar_anchor_error</code></td>\n<td>category, error_mm</td>\n<td>锚定误差（家具落地/眼镜对位）</td>\n</tr>\n</tbody></table>\n<p><code>viewer_load_result</code> 的 <code>reason</code> 字段是排查的关键——「加载失败」这一个笼统状态无法区分是网络超时、解码抛异常、还是 WebGL 上下文创建失败。这三者的修复方向完全不同。</p>\n<h2 id=\"锚定准确性的人工验收\">锚定准确性的人工验收</h2><h3 id=\"为什么必须人工\">为什么必须人工</h3><p>家具落地、眼镜对位、彩妆贴合这三类问题，<strong>在截图上很难看出错误，但在真人体验里非常明显</strong>。一张眼镜试戴截图看起来「挺正常」，实际可能鼻托偏了 8 毫米——只有戴过眼镜的人知道那是什么感觉。</p>\n<p>所以锚定准确性需要一套人工验收规程，而不是靠自动化：</p>\n<table>\n<thead>\n<tr>\n<th>品类</th>\n<th>验收方法</th>\n<th>通过标准</th>\n<th>样本</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>家具</td>\n<td>在已知尺寸的空间里摆放，量取渲染位与实际位的偏差</td>\n<td>落地贴合无悬空/无下陷；尺寸误差 ≤ 2%</td>\n<td>3–5 种地面材质</td>\n</tr>\n<tr>\n<td>眼镜</td>\n<td>不同脸型（宽/窄、鼻梁高/低）真人试戴</td>\n<td>镜框无穿模、无浮空；跟随表情无明显滞后</td>\n<td>≥ 8 位不同脸型测试者</td>\n</tr>\n<tr>\n<td>彩妆</td>\n<td>不同肤色真人试色，与实物色号比对</td>\n<td>色相无明显偏离；边缘无生硬</td>\n<td>≥ 5 种肤色</td>\n</tr>\n<tr>\n<td>服装</td>\n<td>不同体型试穿</td>\n<td>无明显穿模、无悬空</td>\n<td>按尺码表分档抽样</td>\n</tr>\n</tbody></table>\n<p>眼镜验收里「不同脸型」这一条尤其重要，因为<strong>面部锚点的误差在不同脸型上的表现不同</strong>：窄脸上合适的偏移在宽脸上可能明显。只用一两个测试者的面部数据验证，会在上线后暴露。</p>\n<h3 id=\"误差的可量化形式\">误差的可量化形式</h3><p>即使最终判定靠人眼，也要把误差量化下来，才能做趋势跟踪：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"# 家具锚定误差记录（每次摆放测量，累积成分布）&#10;anchor_measurement {&#10;  asset_id, device_model, os_version, surface_material, surface_tilt_deg,&#10;  expected_origin_mm: {x, y, z},        # 期望的商品原点位置（实测地面）&#10;  rendered_origin_mm: {x, y, z},        # 渲染结果的原点位置&#10;  error_mm: sqrt(dx^2 + dy^2 + dz^2),&#10;  scale_error_pct: (rendered_size - real_size) / real_size * 100&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span># 家具锚定误差记录（每次摆放测量，累积成分布）</span></span>\n<span class=\"line\"><span>anchor_measurement {</span></span>\n<span class=\"line\"><span>  asset_id, device_model, os_version, surface_material, surface_tilt_deg,</span></span>\n<span class=\"line\"><span>  expected_origin_mm: {x, y, z},        # 期望的商品原点位置（实测地面）</span></span>\n<span class=\"line\"><span>  rendered_origin_mm: {x, y, z},        # 渲染结果的原点位置</span></span>\n<span class=\"line\"><span>  error_mm: sqrt(dx^2 + dy^2 + dz^2),</span></span>\n<span class=\"line\"><span>  scale_error_pct: (rendered_size - real_size) / real_size * 100</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><p>有了这个分布，就能定义<strong>P95 误差</strong>作为验收指标，而不是只看「大部分情况下还行」。P95 才是那批投诉的来源。</p>\n<h2 id=\"发布门与回归\">发布门与回归</h2><p>把上面拼成发布门：新资产或新版本的查看器代码上线前，必须过三道检查。</p>\n<table>\n<thead>\n<tr>\n<th>门</th>\n<th>检查内容</th>\n<th>阻断条件</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>资产门</td>\n<td>结构校验（glTF-Validator）+ 规格校验 + 渲染健康检查</td>\n<td>任一 error 或 <code>model_missing</code>/<code>black_screen</code></td>\n</tr>\n<tr>\n<td>兼容门</td>\n<td>塔尖机型的自动化回归 + 能力探测分布核对</td>\n<td>任一塔尖机型出现阻断缺陷</td>\n</tr>\n<tr>\n<td>体验门</td>\n<td>锚定准确性人工验收 + 帧率实测</td>\n<td>锚定误差 P95 超标或帧率低于下限</td>\n</tr>\n</tbody></table>\n<p>三道的顺序不能颠倒：<strong>资产门必须最先跑</strong>，因为一个结构有问题的资产在所有机型上都会失败，先修资产比先调兼容性价比高得多。这与 <a href=\"../asset-sku-serving/3d-asset-sku-bind-qc\">资产与 SKU 绑定及质检</a> 的状态机是同一套门，只是把「渲染健康检查」补进了资产门——glTF-Validator 只看数据合法性，看不出「数据合法但渲染是黑的」。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>机型兼容的本质是组合爆炸，质量体系必须分层：塔尖机型全功能验收、主流机型覆盖 AR 或 3D 查看、长尾靠线上监控 + 兜底链路保证不崩。</li>\n<li>三类问题方法不同：渲染正确性可自动检测（离屏渲染 + 像素统计），能力可用性可自动降级（能力探测），锚定准确性必须人工验收。</li>\n<li>「黑屏/模型缺失」最容易自动发现也最常见：像素覆盖率过低或亮度极端即可判定，应当把渲染健康检查并进资产门——glTF-Validator 看不出「数据合法但渲染是黑的」。</li>\n<li>色彩正确性比对要用感知距离（如 CIEDE2000）而非逐像素差值，并按设备族维护独立基准；PBR Neutral 的价值在于把「颜色对不对」变成可写断言的性质。</li>\n<li>AR 可用性是分布而非布尔值：Quick Look 需 iOS/iPadOS 12+ 或 visionOS 1+，Scene Viewer 需 ARCore 设备，WebXR hit-test 仅 Chrome/Edge 81+、depth-sensing 仅 Chrome/Edge 90+，因此跨平台 AR 必须同时实现两条原生跳出路径。</li>\n<li>线上埋点的 <code>reason</code> 字段决定排查效率——「加载失败」无法区分网络超时、解码异常与上下文创建失败。</li>\n<li>锚定准确性要按脸型/肤色/地面材质分层人工验收，并把误差量化成 P95 指标做趋势跟踪。</li>\n<li>发布门顺序是资产门 → 兼容门 → 体验门，资产门必须最先跑，因为结构性缺陷在所有机型上都会失败。</li>\n</ul>\n","headings":[{"level":1,"text":"虚拟体验的质量与机型兼容","id":"虚拟体验的质量与机型兼容"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"三类问题不能用同一种方法发现","id":"三类问题不能用同一种方法发现"},{"level":2,"text":"渲染正确性的自动化检测","id":"渲染正确性的自动化检测"},{"level":3,"text":"「黑屏」是最常见的失败，也最容易自动发现","id":"黑屏-是最常见的失败-也最容易自动发现"},{"level":3,"text":"色彩正确性的比对","id":"色彩正确性的比对"},{"level":2,"text":"能力可用性与机型矩阵","id":"能力可用性与机型矩阵"},{"level":3,"text":"机型矩阵怎么建","id":"机型矩阵怎么建"},{"level":3,"text":"AR 可用性的真实分布","id":"ar-可用性的真实分布"},{"level":3,"text":"线上监控埋点","id":"线上监控埋点"},{"level":2,"text":"锚定准确性的人工验收","id":"锚定准确性的人工验收"},{"level":3,"text":"为什么必须人工","id":"为什么必须人工"},{"level":3,"text":"误差的可量化形式","id":"误差的可量化形式"},{"level":2,"text":"发布门与回归","id":"发布门与回归"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"3D/AR 覆盖品类优先级","url":"/l-doc-books/h/global-ecommerce/product-3d-ar-asset-virtualtryon/ar-conversion-ops/ar-asset-coverage-priority"},"next":null}