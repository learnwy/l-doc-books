55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">req</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">∩</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">L</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">sup</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mord\">∣</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9721em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mspace\" style=\"margin-right:1em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">，要求</span><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">an</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1</span></span></span></span></span></div><p>德国市场 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>L</mi><mtext>req</mtext></msub><mo>=</mo><mo stretchy=\"false\">{</mo><mtext>de</mtext><mo stretchy=\"false\">}</mo></mrow><annotation encoding=\"application/x-tex\">L_{\\text{req}} = \\{\\text{de}\\}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">L</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">req</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">{</span><span class=\"mord text\"><span class=\"mord\">de</span></span><span class=\"mclose\">}</span></span></span></span></span>，只提供英语警示语的商品 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>C</mi><mrow><mi>l</mi><mi>a</mi><mi>n</mi><mi>g</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">C_{lang} = 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">an</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span>——它在字段层面「有值」，在合规层面「没有」。作用域 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>S</mi></mrow><annotation encoding=\"application/x-tex\">S</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span></span></span></span></span> 由市场 × 渠道 × 品类 × 商户组合并支持通配；判据 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>p</mi></mrow><annotation encoding=\"application/x-tex\">p</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span></span></span></span></span> 无副作用、可单测；严重度 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>σ</mi></mrow><annotation encoding=\"application/x-tex\">\\sigma</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">σ</span></span></span></span></span> 取 block / warn / info 三值并决定是否阻断出站；证据 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>e</mi></mrow><annotation encoding=\"application/x-tex\">e</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">e</span></span></span></span></span> 需可追溯来源与时间；有效期 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>τ</mi></mrow><annotation encoding=\"application/x-tex\">\\tau</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span></span></span></span></span> 为闭区间，承载过渡期与宽限期。</p>\n<h2 id=\"主要法域的规则基线\">主要法域的规则基线</h2><p>落地时要把每条法规拆成「可判定的判据 + 证据要求」，而不是把法规原文当文档存起来。</p>\n<table>\n<thead>\n<tr>\n<th>法域 / 法规</th>\n<th>核心要求</th>\n<th>内容层落点</th>\n<th>证据形态</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>EU GPSR (EU) 2023/988</td>\n<td>线上报价须显示制造商或欧盟代表名称、商品识别信息（含商品图）、警示与安全信息；非欧盟制造商须指定欧盟经济运营者</td>\n<td>listing 责任人区块 + 警示语字段</td>\n<td>授权书、责任人登记</td>\n</tr>\n<tr>\n<td>EU DSA (EU) 2022/2065 第 30 条</td>\n<td>商户身份/登记信息与合规自我声明须在商品页可见；2025-02-17 起未补齐须暂停</td>\n<td>商户级属性区块</td>\n<td>身份证件、登记号、自我声明</td>\n</tr>\n<tr>\n<td>EU 能源标签 (EU) 2017/1369 + EPREL</td>\n<td>价格旁清晰显示能效标签/等级并链接产品信息表；上市前登记 EPREL</td>\n<td><code>certification</code> 属性（EPREL 注册码）</td>\n<td>EPREL 注册号</td>\n</tr>\n<tr>\n<td>US CPSC eFiling, 16 CFR 1110</td>\n<td>进口受管制商品须向 CBP 电子提交合规证书；生效日 2026-07-08</td>\n<td>报关数据，非 listing 文案</td>\n<td>合规证书数据</td>\n</tr>\n<tr>\n<td>US FTC Made in USA, 16 CFR 323</td>\n<td>原产地声明须真实且可证实；线上材料同受约束</td>\n<td>原产地声明字段</td>\n<td>供应链来源证明</td>\n</tr>\n<tr>\n<td>EU PPWR (EU) 2025/40</td>\n<td>2025-02-11 生效、2026-08-12 起适用</td>\n<td>包装与材料属性</td>\n<td>材料声明</td>\n</tr>\n</tbody></table>\n<h2 id=\"从规则模型到校验门-严重度分级与冲突消解\">从规则模型到校验门：严重度分级与冲突消解</h2><p>规则集要在出站路径上产生<strong>判定</strong>。把它设计成独立的门（gate），位于映射求值之后、序列化之前——阻断由此发生在花掉配额与网络往返之前。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;  A[映射求值产物 IR] --&gt; B{求生效规则集 R*}&#10;  B --&gt; C[逐条求值判据 p]&#10;  C --&gt; D{存在 block 级违规?}&#10;  D --&gt;|是| E[阻断出站&lt;br/&gt;写入违规明细]&#10;  D --&gt;|否| F{存在 warn 级违规?}&#10;  F --&gt;|是| G[放行 + 打标&lt;br/&gt;进人工复核队列]&#10;  F --&gt;|否| H[PASS 出站]&#10;  E --&gt; I[证据台账]&#10;  G --&gt; I&#10;  H --&gt; I\">flowchart TD\n  A[映射求值产物 IR] --&gt; B{求生效规则集 R*}\n  B --&gt; C[逐条求值判据 p]\n  C --&gt; D{存在 block 级违规?}\n  D --&gt;|是| E[阻断出站&lt;br/&gt;写入违规明细]\n  D --&gt;|否| F{存在 warn 级违规?}\n  F --&gt;|是| G[放行 + 打标&lt;br/&gt;进人工复核队列]\n  F --&gt;|否| H[PASS 出站]\n  E --&gt; I[证据台账]\n  G --&gt; I\n  H --&gt; I</pre><p><strong>严重度分级要能解释结局，而不是只标记颜色。</strong> <code>block</code> 表示违反硬性法规或渠道禁令（缺欧盟责任人、GTIN 校验位错误），必须阻断；<code>warn</code> 表示合规但存在风险（警示语语言覆盖不全、字段接近长度上限），放行但进复核；<code>info</code> 只作记录。分级不清晰时，运营会把一切 <code>warn</code> 当噪声忽略。</p>\n<p><strong>冲突消解需要可审计的优先级。</strong> 同一字段被多条规则要求不同值时（两个市场的原产地声明要求相反），顺序应是：法域法规 &gt; 渠道政策 &gt; 内部运营规则，同层以更严者胜；这条顺序必须作为元规则显式存储，而非隐含在求值顺序里，否则一次重构就能悄悄改变合规行为。</p>\n<p><strong>规则要能定位到来源。</strong> 每条规则携带 <code>source_ref</code>、<code>effective_from</code> 与 <code>superseded_by</code>，监管更新时按 <code>source_ref</code> 批量下线受影响规则。PPWR 自 2026 年 8 月 12 日起适用（2025 年 2 月 11 日生效），来源：<a href=\"https://environment.ec.europa.eu/topics/waste-and-recycling/packaging-waste_en\">欧盟包装与包装废弃物法规</a>——「已生效但尚未适用」的规则需要独立的 <code>applies_from</code> 字段，否则要么过早阻断，要么到生效日才发现漏配。</p>\n<h2 id=\"规则的版本演进与证据留存\">规则的版本演进与证据留存</h2><p>规则集本身要有版本与回归机制，做法与映射规则集一致（参考<a href=\"../syndication-model-channel-catalog/channel-catalog-taxonomy-capability\">渠道目录与能力矩阵</a>中渠道能力的版本化思路）：每次变更产生新版本号，配套一份用真实拒审样本构成的固定回归集。</p>\n<p><strong>回归集由「冻结违规样本」构成。</strong> 从历史拒审回执抽取每类违规实例（缺责任人、语言不全、EPREL 未登记、类别误判），记为期望 <code>BLOCK</code> 或 <code>WARN</code> 的固定用例。改版后重跑，任何原本 <code>PASS</code> 的样本变成 <code>BLOCK</code>（误伤）或反之（漏放）都必须解释。</p>\n<p><strong>证据台账是合规的第二条产品线。</strong> 判定只是过程，证据才是审计与抗辩的产出。台账至少记录 <code>item_id</code>、<code>channel</code>、<code>market</code>、<code>rule_id</code>、<code>rule_version</code>、<code>verdict</code>、<code>evaluated_at</code> 与证据引用，留存期要覆盖追诉期——DSA 要求平台在商户关系终止后安全保留相关数据六个月再删除，来源：<a href=\"https://www.eu-digital-services-act.com/Digital_Services_Act_Article_30.html\">DSA Article 30</a>。</p>\n<p><strong>个人信息与合规证据要在建模时分流。</strong> DSA 第 30 条要求平台取得身份证件副本与支付账户，但只要求其中三项对消费者可见；平台自留的敏感字段不应进入内容分发链路。合规引擎只能消费「已判定」的布尔与证据引用，不能把证件影像带进 feed 构建管线。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>合规规则与字段映射规则是<strong>两个模型</strong>：前者失败意味着违法，需要严重度分级与证据留存；后者失败只是字段缺失。</li>\n<li>规则形式化为 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">(</mo><mi>S</mi><mo separator=\"true\">,</mo><mi>p</mi><mo separator=\"true\">,</mo><mi>σ</mi><mo separator=\"true\">,</mo><mi>e</mi><mo separator=\"true\">,</mo><mi>τ</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">(S, p, \\sigma, e, \\tau)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.0576em;\">S</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">σ</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">e</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mclose\">)</span></span></span></span></span> 五元组，作用域匹配与判据求值都是可回放、可单测的纯函数。</li>\n<li>属地、渠道、品类是三个正交作用域；欧盟责任人、商户身份、EPREL 注册号分属三个 owner，合并成一个大字段会耦合三条独立法规的变更。</li>\n<li>语言覆盖度 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>C</mi><mrow><mi>l</mi><mi>a</mi><mi>n</mi><mi>g</mi></mrow></msub></mrow><annotation encoding=\"application/x-tex\">C_{lang}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">an</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 说明「有值」不等于「合规」——合规校验不能退化成非空检查。</li>\n<li>2026 年基线至少覆盖：GPSR、DSA 第 30 条、能源标签与 EPREL、CPSC eFiling（2026-07-08 生效）、FTC Made in USA、PPWR（2026-08-12 适用）。</li>\n<li>规则通过后内容才进入序列化与投递，回执里的拒审原因写回规则描述符形成闭环。</li>\n</ul>\n","headings":[{"level":1,"text":"跨境商品内容合规规则建模","id":"跨境商品内容合规规则建模"},{"level":2,"text":"核心概念：把合规写成规则而不是代码","id":"核心概念-把合规写成规则而不是代码"},{"level":2,"text":"合规规则的三种冲突面：属地、渠道、品类","id":"合规规则的三种冲突面-属地-渠道-品类"},{"level":2,"text":"规则模型：作用域、判据、证据、时效","id":"规则模型-作用域-判据-证据-时效"},{"level":2,"text":"主要法域的规则基线","id":"主要法域的规则基线"},{"level":2,"text":"从规则模型到校验门：严重度分级与冲突消解","id":"从规则模型到校验门-严重度分级与冲突消解"},{"level":2,"text":"规则的版本演进与证据留存","id":"规则的版本演进与证据留存"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"转换异常、分片上传与幂等重试","url":"/l-doc-books/h/global-ecommerce/product-content-syndication-multichannel-feed-ops/feed-build-transform/feed-transform-failure-modes"},"next":{"title":"校验规则引擎与出站 Preflight 质量门","url":"/l-doc-books/h/global-ecommerce/product-content-syndication-multichannel-feed-ops/compliance-validation-quality/validation-rule-engine-preflight"}}