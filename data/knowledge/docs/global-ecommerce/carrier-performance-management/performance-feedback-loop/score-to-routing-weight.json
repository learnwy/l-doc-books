k:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n); row[j::n] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        A_ub.append(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">row); b_ub.append(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">demand[j] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> floor_share)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    A_eq </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [np.eye(n).repeat(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">axis</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)]                </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 需求等式</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    A_eq </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(n):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        row </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.zeros(m </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n); row[j::n] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        A_eq.append(row)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    res </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> linprog(c, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">A_ub</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">np.array(A_ub), </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b_ub</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">np.array(b_ub),</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                  A_eq</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">np.array(A_eq), </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b_eq</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">demand, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">bounds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                  method</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"highs\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> res.x.reshape(m, n), res.status</span></span></code></pre></div><p><code>gamma</code> 是把绩效翻译成成本的强度：<code>$\\gamma = 0$</code> 时完全按成本选路（绩效不影响），<code>$\\gamma = 1$</code> 时成本被分数完全折减（绩效主导）。它是一个需要显式设定的<strong>政策参数</strong>，因为它直接表达了&quot;我们愿意为绩效多付多少钱&quot;。<code>floor_share</code> 是保底货量，保证落后者仍有样本。</p>\n<h2 id=\"探索与利用的平衡\">探索与利用的平衡</h2><p>保底货量是最简单的探索机制，但它只保证&quot;不被饿死&quot;，不保证&quot;有机会翻盘&quot;。真正需要解决的是：一家表现中等但正在改进的承运商，如何获得足以证明改进的货量？</p>\n<p>多臂老虎机框架精确地描述了这个权衡：每一轮选择一个&quot;臂&quot;（承运商），观察随机回报，目标是最小化累积遗憾 <code>$\\rho = T\\mu^* - \\sum_t \\hat r_t$</code>，其中 <code>$\\mu^*$</code> 是最优臂的期望回报（<a href=\"https://en.wikipedia.org/wiki/Multi-armed_bandit\">多臂老虎机</a>）。经典策略有三类，对应不同的探索方式：</p>\n<ul>\n<li><strong><code>$\\epsilon$</code>-贪心</strong>：以 <code>$1-\\epsilon$</code> 概率选当前最优，以 <code>$\\epsilon$</code> 概率随机选。简单但探索是盲目的。</li>\n<li><strong>UCB（置信上界）</strong>：给样本少的臂加一个不确定性奖励，使&quot;信息不足&quot;本身成为被选中的理由。它的直觉与<a href=\"../carrier-kpi-system/transit-sla-achievement\">时效达成与 SLA 指标</a>中的 Wilson 区间下界正好互补——评分用下界（保守），探索用上界（乐观）。</li>\n<li><strong>Thompson 采样</strong>：按每个臂&quot;是最优臂&quot;的后验概率抽样。它的采样频率会自动匹配该臂实际最优的概率。</li>\n</ul>\n<p>跨境选路场景推荐 <strong>UCB</strong>，因为它不依赖先验分布设定，且它的探索量随样本自动衰减——样本累积后置信区间收窄，探索自然减少，不需要人工调 <code>$\\epsilon$</code> 的衰减计划。</p>\n<h3 id=\"探索配额的保护\">探索配额的保护</h3><p>探索配额在实践中经常被业务压力侵蚀：旺季时运营会以&quot;保证时效&quot;为由取消探索货量，而旺季往往正是最需要新承运商分担的时候。因此探索配额应当<strong>作为约束而非目标</strong>写进分配模型（如上面的 <code>floor_share</code>），而不是留给运行时判断。</p>\n<p>同时要防止反向问题：探索配额不宜过大，否则会持续把货量分给已知较差的承运商。合理的量级是让每家承运商在评估窗口内至少获得足以产生可信绩效估计的样本——这与<a href=\"../scorecard-grading/carrier-scorecard-model\">承运商记分卡模型</a>中收缩常数 <code>$n_0$</code>（约 30–50 票）是同一个数量级。</p>\n<h2 id=\"权重更新的节奏与审计\">权重更新的节奏与审计</h2><p>权重不能随分数实时变化。更新节奏应与绩效数据的统计窗口对齐（通常是周或双周），并受<a href=\"../scorecard-grading/carrier-tier-dynamic-share\">分级与份额动态调整</a>中冻结期的约束。每次权重更新都应留下审计记录，包含输入分数、政策参数、求解状态与最终分配，因为它是&quot;为什么这票货走了这家承运商&quot;的最终答案。</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;routing_weight_update&quot;: {&#10;    &quot;effective_from&quot;: &quot;2026-10-07&quot;,&#10;    &quot;policy&quot;: { &quot;map&quot;: &quot;piecewise_linear&quot;, &quot;beta&quot;: 0.18, &quot;gamma&quot;: 0.35, &quot;floor_share&quot;: 0.05, &quot;explore&quot;: &quot;ucb&quot; },&#10;    &quot;solver&quot;: { &quot;method&quot;: &quot;highs&quot;, &quot;status&quot;: 0, &quot;objective&quot;: 184320.77 },&#10;    &quot;allocation&quot;: [&#10;      { &quot;carrier_id&quot;: &quot;C-88213&quot;, &quot;grade&quot;: &quot;A&quot;, &quot;score&quot;: 89.1, &quot;target_share&quot;: 0.34, &quot;capacity_used&quot;: 0.91 },&#10;      {&#10;        &quot;carrier_id&quot;: &quot;C-70412&quot;,&#10;        &quot;grade&quot;: &quot;C&quot;,&#10;        &quot;score&quot;: 61.3,&#10;        &quot;target_share&quot;: 0.06,&#10;        &quot;capacity_used&quot;: 0.22,&#10;        &quot;explore_floor_applied&quot;: true&#10;      }&#10;    ]&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"routing_weight_update\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"effective_from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-07\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"policy\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"map\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"piecewise_linear\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"beta\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.18</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"gamma\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.35</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"floor_share\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"explore\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ucb\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"solver\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"method\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"highs\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"objective\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">184320.77</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"allocation\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"carrier_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"C-88213\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"grade\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"A\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"score\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">89.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"target_share\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.34</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"capacity_used\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.91</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"carrier_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"C-70412\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"grade\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"C\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"score\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">61.3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"target_share\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.06</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"capacity_used\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.22</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"explore_floor_applied\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>solver.status</code> 必须记录并检查——线性规划无可行解时（例如总容量小于总需求），任何&quot;分配结果&quot;都是无效的，必须告警而不是静默下发。<code>explore_floor_applied</code> 标记该承运商的份额是由保底约束决定的而非由分数决定，这在解释&quot;为什么差承运商还有货&quot;时是关键证据。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>按分数排名直接分配货量会失败，因为忽略容量、成本与探索三个约束。</li>\n<li>分数到权重有三种映射：线性（可解释）、softmax（区分度高，与多项 logit 同构）、分段（稳定）。</li>\n<li>softmax 映射可与离散选择模型打通，从而能引入成本、时效等备选项属性。</li>\n<li>容量约束下的分配是运输问题，绩效通过折减成本进入目标函数，<code>$\\gamma$</code> 是政策参数。</li>\n<li>探索用 UCB 而非固定 <code>$\\epsilon$</code>：探索量随样本自动衰减，且与评分端的保守下界互补。</li>\n<li>探索配额必须写成模型约束而非运行时判断，否则会在旺季被业务压力侵蚀。</li>\n<li>探索配额的量级应与记分卡收缩常数 <code>$n_0$</code>（约 30–50 票）对齐，保证能产生可信估计。</li>\n<li>权重更新对齐统计窗口与冻结期，并记录求解状态；无可行解必须告警而非静默下发。</li>\n</ul>\n","headings":[{"level":1,"text":"绩效反馈到选路权重","id":"绩效反馈到选路权重"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"从分数到权重：三种映射","id":"从分数到权重-三种映射"},{"level":3,"text":"线性映射","id":"线性映射"},{"level":3,"text":"指数映射（softmax）","id":"指数映射-softmax"},{"level":3,"text":"分段映射（等级制）","id":"分段映射-等级制"},{"level":2,"text":"容量约束下的分配","id":"容量约束下的分配"},{"level":2,"text":"探索与利用的平衡","id":"探索与利用的平衡"},{"level":3,"text":"探索配额的保护","id":"探索配额的保护"},{"level":2,"text":"权重更新的节奏与审计","id":"权重更新的节奏与审计"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"承运商退出与平稳切换","url":"/l-doc-books/h/global-ecommerce/carrier-performance-management/carrier-onboard-trial/carrier-exit-phaseout"},"next":{"title":"奖惩与服务费联动","url":"/l-doc-books/h/global-ecommerce/carrier-performance-management/performance-feedback-loop/carrier-penalty-incentive"}}