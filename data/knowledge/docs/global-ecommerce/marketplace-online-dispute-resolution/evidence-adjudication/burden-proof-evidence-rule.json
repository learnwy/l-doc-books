#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">submitted_by</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'SELLER'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> seller_weight,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">       sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">weight_score</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">submitted_by</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'BUYER'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> buyer_weight,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">       sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">weight_score</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">submitted_by</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'SELLER'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">         -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">weight_score</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">submitted_by</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'BUYER'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> net_margin</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dispute_evidence e</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">case_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :case_id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">case_id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">evidence_type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p><code>rule_version</code> 字段不可省。证据评分标准会随规则演进（例如新增&quot;高金额必须有签收&quot;的门槛），而申诉复核需要按<strong>当时生效的版本</strong>重算，否则旧案件会被新规则追溯性地改变结果。</p>\n<h2 id=\"举证责任的转移与-证据对冲\">举证责任的转移与&quot;证据对冲&quot;</h2><p>责任转移的触发条件是<strong>主张方达到初步证明标准</strong>。以 INR 为例：卖家提交可核验的签收凭证后，责任转移到买家；买家若主张&quot;签收不是我本人&quot;，则需要提供相反证据（例如同期不在收货地的证明）或指出凭证的瑕疵（地址不匹配、签收人非订收人）。</p>\n<p>当双方都提交了达到门槛的证据时，系统进入<strong>证据对冲</strong>状态。这是裁决中最需要人介入的情形，因为加权的净差往往落在噪声区间内。工程上的处理是设一个<strong>不确定带</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"def adjudicate(delivery_net_margin, amount_minor, type_):&#10;    if abs(delivery_net_margin) &gt; 0.25:&#10;        return &quot;RULE_ENGINE&quot;          # 差值显著，可自动裁决&#10;    if amount_minor &lt; SMALL_CLAIM_LIMIT:&#10;        return &quot;AUTO_WITH_REVIEW&quot;     # 小额，自动出但强制抽检&#10;    return &quot;MANUAL_REVIEW&quot;            # 大额且对冲，必须人工\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> adjudicate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(delivery_net_margin, amount_minor, type_):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(delivery_net_margin) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"RULE_ENGINE\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">          # 差值显著，可自动裁决</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> amount_minor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SMALL_CLAIM_LIMIT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"AUTO_WITH_REVIEW\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">     # 小额，自动出但强制抽检</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"MANUAL_REVIEW\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">            # 大额且对冲，必须人工</span></span></code></pre></div><p>不确定带（这里取 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>±</mo><mn>0.25</mn></mrow><annotation encoding=\"application/x-tex\">\\pm 0.25</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">±</span><span class=\"mord\">0.25</span></span></span></span></span>）的宽度是<strong>策略参数而非真理</strong>，它直接交换&quot;自动裁决比例&quot;与&quot;改判率&quot;。带子越宽，自动化越多，改判越多；带子越窄，人工越多，一致性越难维持。这个权衡与下一节的自动化闸门是同一件事的两面。</p>\n<h2 id=\"与相邻机制的关系\">与相邻机制的关系</h2><p>证据规则的输出是事实认定，它不决定结果——把事实映射成&quot;退款/退货退款/部分补偿/打款卖家&quot;是决定树的职责，见 <a href=\"decision-tree-refund-return-compensate\">退款/退货/补偿/打款决定树</a>。而多大金额、多少把握度下可以不给人工过目，是 <a href=\"auto-smallclaim-manual-review\">小额自动裁决与人工复核</a> 的主题。三者构成&quot;事实 → 结果 → 程序保障&quot;的链。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>举证责任要区分&quot;举证义务&quot;（谁先交）与&quot;说服标准&quot;（要多强），后者默认取优势证据标准。</li>\n<li>初始分配原则是&quot;由最能低成本获取该证据的一方承担&quot;；INR 与 QUALITY 的初始责任在卖家侧，因为买家主张的消极事实无法自证。</li>\n<li>物流轨迹与签收凭证证明力最高，但要求承运商可核验、终态明确、地址匹配；凭证强度应与订单金额成正比（高金额须签收）。</li>\n<li>IM 记录证明&quot;双方说过什么&quot;而非&quot;事实是什么&quot;，只能采信平台内会话；其时间戳可借助 RFC 3161 时间戳令牌做第三方可验证而不泄露内容。</li>\n<li>商品页快照必须由平台在下单时自动留存，SNAD 判定不能依赖买家举证。</li>\n<li>证据评分必须带 <code>rule_version</code>，申诉复核按当时版本重算，否则旧案会被新规则追溯性改判。</li>\n<li>双方证据对冲时设不确定带，带内案件转人工；带宽度是自动裁决率与改判率之间的策略参数。</li>\n</ul>\n","headings":[{"level":1,"text":"举证责任与证据规则","id":"举证责任与证据规则"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"初始举证责任的分配","id":"初始举证责任的分配"},{"level":2,"text":"六类证据的证明力","id":"六类证据的证明力"},{"level":3,"text":"物流轨迹与签收凭证","id":"物流轨迹与签收凭证"},{"level":3,"text":"质检报告与第三方检测","id":"质检报告与第三方检测"},{"level":3,"text":"IM 会话记录","id":"im-会话记录"},{"level":3,"text":"开箱视频与实物照片","id":"开箱视频与实物照片"},{"level":3,"text":"商品页快照","id":"商品页快照"},{"level":2,"text":"证据规则的可实现形式","id":"证据规则的可实现形式"},{"level":2,"text":"举证责任的转移与\"证据对冲\"","id":"举证责任的转移与-证据对冲"},{"level":2,"text":"与相邻机制的关系","id":"与相邻机制的关系"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"争议与正常售后的分流边界","url":"/l-doc-books/h/global-ecommerce/marketplace-online-dispute-resolution/dispute-intake-routing/dispute-vs-aftersales-boundary"},"next":{"title":"小额自动裁决与人工复核","url":"/l-doc-books/h/global-ecommerce/marketplace-online-dispute-resolution/evidence-adjudication/auto-smallclaim-manual-review"}}