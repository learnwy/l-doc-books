:#24292E;--shiki-dark:#E1E4E8\"> factor_to_base, family_code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> f1, fam1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uom_factor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uom_code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p_from;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> factor_to_base, family_code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> f2, fam2</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uom_factor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uom_code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p_to;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fam1 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> OR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fam2 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    RAISE EXCEPTION </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'unknown uom: % -> %'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, p_from, p_to;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  END</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fam1 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fam2 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">THEN</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    RAISE EXCEPTION </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cross-family conversion % (% -> %)'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      p_from, fam1, fam2;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  END</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  RETURN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> f1 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> f2;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">END</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$$ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">LANGUAGE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> plpgsql IMMUTABLE;</span></span></code></pre></div><p><code>factor_kind</code> 与 <code>source_ref</code> 让每一个数值都可追溯：<code>DEFINED</code> 表示由标准定义的精确值（如英寸=0.0254 m）、<code>DERIVED</code> 表示由其他定义派生（如盎司=lbf/16）、<code>MEASURED</code> 表示测量值。对 <code>MEASURED</code> 类因子，<code>source_ref</code> 应指向测量方法或计量报告，并在业务上禁止参与&quot;精确等值&quot;的断言。</p>\n<h3 id=\"跨族换算必须显式拒绝\">跨族换算必须显式拒绝</h3><p>函数在族不匹配时抛异常而不是返回 1 或 NULL，这是刻意的：静默的默认值会让错误一路传播到报关数据。若业务确实需要跨族换算（体积到质量），它必须走<strong>商品级参数</strong>这条单独路径，而不是单位库。</p>\n<h2 id=\"常见错误\">常见错误</h2><ul>\n<li><strong>把因子写成浮点常量</strong>：<code>0.45359237 * 2.2</code> 在 IEEE 754 双精度下得到的不是精确乘积的反向。</li>\n<li><strong>两两配对存因子</strong>：<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>n</mi></mrow><annotation encoding=\"application/x-tex\">n</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">n</span></span></span></span></span> 个单位存 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>n</mi><mo stretchy=\"false\">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mi mathvariant=\"normal\">/</mi><mn>2</mn></mrow><annotation encoding=\"application/x-tex\">n(n-1)/2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">n</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">n</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">1</span><span class=\"mclose\">)</span><span class=\"mord\">/2</span></span></span></span></span> 条，且互为倒数的两条迟早会不一致。</li>\n<li><strong>混用两套因子</strong>：同一对单位在计价模块和库存模块各有一份因子，且值略有不同。</li>\n<li><strong>对计数单位套用因子</strong>：给&quot;个&quot;配一个 1.0 的因子无害，但如果让&quot;箱 → 个&quot;也进入这条链，就把包装层级误当成了计量单位。</li>\n<li><strong>在展示层取整后回写</strong>：把页面上显示的 <code>0.45 kg</code> 写回数据库，覆盖了原始的 <code>0.45359237 kg</code>。</li>\n</ul>\n<h2 id=\"小结\">小结</h2><ul>\n<li>因子分三个来源等级：定义值（精确）、列表/约定值（可精确化但常被截断）、测量值（不可精确，须带误差或有效期）。</li>\n<li>存储用高精度定点数，只存单向因子，反向用倒数计算；禁止用二进制浮点。</li>\n<li>取整只在换算链末端执行一次；数量用 half-even（与 BIPM 及 IEEE 754 默认一致），货币用 half-up，报关按监管规定。</li>\n<li>往返测试（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>→</mo><msub><mi>u</mi><mn>2</mn></msub><mo>→</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><annotation encoding=\"application/x-tex\">u_1 \\to u_2 \\to u_1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>）是验证因子自洽性最有效的一条断言。</li>\n</ul>\n<p>因子解决的是&quot;换成多少&quot;，但<strong>哪些单位在哪个市场合法</strong>是另一层约束，见下一篇 <a href=\"legal-unit-market-label\">各市场法定计量单位</a>。</p>\n","headings":[{"level":1,"text":"公制/英制换算因子与精度","id":"公制-英制换算因子与精度"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"因子的三种来源等级","id":"因子的三种来源等级"},{"level":3,"text":"定义值：法律或标准规定的精确值","id":"定义值-法律或标准规定的精确值"},{"level":3,"text":"约定值：行业惯用的近似","id":"约定值-行业惯用的近似"},{"level":3,"text":"测量值：不可约的近似","id":"测量值-不可约的近似"},{"level":2,"text":"精度：因子位数与运算位数的分离","id":"精度-因子位数与运算位数的分离"},{"level":3,"text":"因子存储位数","id":"因子存储位数"},{"level":3,"text":"取整模式","id":"取整模式"},{"level":2,"text":"双向因子的自洽性","id":"双向因子的自洽性"},{"level":2,"text":"精度在长换算链上的累积","id":"精度在长换算链上的累积"},{"level":2,"text":"因子的落地表","id":"因子的落地表"},{"level":3,"text":"一张表存全部因子","id":"一张表存全部因子"},{"level":3,"text":"跨族换算必须显式拒绝","id":"跨族换算必须显式拒绝"},{"level":2,"text":"常见错误","id":"常见错误"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"基本单位/销售单位与单位族定义","url":"/l-doc-books/h/global-ecommerce/unit-measure-packsize-conversion/uom-masterdata/base-sales-uom-definition"},"next":{"title":"各市场法定计量单位（联182）","url":"/l-doc-books/h/global-ecommerce/unit-measure-packsize-conversion/uom-masterdata/legal-unit-market-label"}}