\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  UNIQUE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uk_shop_key (shop_key),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> idx_entity (entity_id)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> shop_site</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  site_id      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  shop_id      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  market       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">CHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,      </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- DE | FR | ID | US ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  currency     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">CHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tax_mode     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- destination | origin | marketplace_facilitator</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">       VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- not_open | pending_review | open | suspended</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  opened_at    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATETIME</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  UNIQUE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uk_shop_market (shop_id, market)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>几处设计选择需要说明。<strong><code>shop_key</code> 与 <code>shop_id</code> 分开</strong>：<code>shop_id</code> 是内部自增/雪花，<code>shop_key</code> 是对外稳定标识（出现在商品 URL、API 路径、买家的收藏里）。分开的理由是让内部主键可以迁移，而对外标识永不变化——若只用 <code>shop_id</code> 对外，任何一次数据迁移或分库都会打断所有外部链接。<strong><code>entity_id</code> 放在 <code>shop</code> 上是可变更的</strong>，这正是转让能力的实现方式：改一列，其他一切不变。（内部 ID 与对外标识分离、资源名与资源内容分离，是大型 API 设计的通行原则：Google API 设计指南 AIP-122 要求资源把标识暴露在 <code>name</code> 字段，且该资源名「应跨版本持续存在」，其他资源以其名为引用而非内嵌内容：来源 <a href=\"https://google.aip.dev/122）**`reg_no_norm`\">https://google.aip.dev/122）**`reg_no_norm`</a> 加唯一索引**（<code>reg_country</code> + 规范化注册号），这是主体去重的数据库级防线，与 <a href=\"merchant-onboarding-flow\">入驻流程、状态与审核工单</a> 中的主体指纹是同一个判断的两个执行点——入口查询用来给出友好提示，唯一索引用来兜住并发与绕过。</p>\n<p>注意 <code>tax_mode</code> 里出现了一个跨境特有的取值 <code>marketplace_facilitator</code>：在欧盟与英国等市场，平台被认定为视同供应商，需要代卖家收取并申报 VAT，此时税负不在卖家侧。这个「视为供应商」（deemed supplier）规则自 2021-07-01 起适用于在线市场促成的欧盟内及进口 B2C 货物远程销售，平台在特定情形下被税务上视为自己接收并供应了货物（来源：欧盟 VAT 一站式服务官方说明，<a href=\"https://vat-one-stop-shop.ec.europa.eu/index_en）。这个字段的存在再次说明站点必须独立——同一店铺在德国的\">https://vat-one-stop-shop.ec.europa.eu/index_en）。这个字段的存在再次说明站点必须独立——同一店铺在德国的</a> <code>tax_mode</code> 与在印尼的完全不同，它决定了第四章账单上「税」这一行由谁承担、由谁申报。</p>\n<h2 id=\"主体-店铺-站点的生命周期与状态传播\">主体、店铺、站点的生命周期与状态传播</h2><p>三层各有状态，而状态之间存在<strong>传播关系</strong>，且传播必须是有向的、受控的：</p>\n<table>\n<thead>\n<tr>\n<th>事件</th>\n<th>主体状态</th>\n<th>店铺状态</th>\n<th>站点状态</th>\n<th>传播规则</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>入驻通过</td>\n<td>active</td>\n<td>active</td>\n<td>not_open（待开店）</td>\n<td>主体先活，站点按市场逐个开通</td>\n</tr>\n<tr>\n<td>资质到期</td>\n<td>active</td>\n<td>active</td>\n<td>suspended（限类目）</td>\n<td>只影响依赖该资质的站点与类目</td>\n</tr>\n<tr>\n<td>主体被制裁</td>\n<td>suspended</td>\n<td>paused</td>\n<td>suspended</td>\n<td>自上而下全停，资金冻结</td>\n</tr>\n<tr>\n<td>单站点违规</td>\n<td>active</td>\n<td>active</td>\n<td>suspended</td>\n<td>不波及兄弟站点（市场隔离）</td>\n</tr>\n<tr>\n<td>店铺转让</td>\n<td>两个主体均 active</td>\n<td>active（换 owner）</td>\n<td>open（不变）</td>\n<td>平台需重签合同、重验新主体资质</td>\n</tr>\n<tr>\n<td>主体关闭</td>\n<td>closed</td>\n<td>closed</td>\n<td>closed</td>\n<td>需先结清所有站点的未结资金</td>\n</tr>\n</tbody></table>\n<p>这张表里最值得注意的是<strong>第四行与第五行的对比</strong>：站点级违规不传播到兄弟站点，而主体级问题向下全传播。这个不对称是刻意的，它是「市场隔离」这条业务原则的工程表达——平台希望卖家在一个市场犯错不要连带毁掉他在其他市场的生意（这既是公平也是商业理性），但主体层面被制裁或失去资格时，平台不能继续与它做生意。传播规则的实现方式是把「状态判定」做成一个函数而不是把状态字段散落在各处：<code>effective_status(site) = f(entity.status, shop.status, site.status, qualifications)</code>，任何一处读取都通过它。这避免了「主体被封了但某个站点忘了置位」这类不一致。</p>\n<h2 id=\"转让与合并-最容易被忽略的一组操作\">转让与合并：最容易被忽略的一组操作</h2><p><strong>店铺转让</strong>的语义是：<code>shop.entity_id</code> 从 A 改为 B。连带要做的是——A 的未结资金继续按原主体结算（历史账不迁移），B 从变更时刻起承担后续结算；B 必须通过针对该市场与类目的资质核验（否则拒绝转让）；店铺的 API 凭证与子账号权限需要复核（原主体的子账号不应自动继承）。最后一条特别重要：转让是一个<strong>权限边界变更</strong>，它必须触发 <a href=\"../permissions-subaccount/rbac-merchant\">商家侧角色权限模型</a> 里的成员重新验证，否则会出现「员工离职了但他仍拿着转让前授予的令牌」。</p>\n<p><strong>主体合并</strong>发生在平台发现两个主体实际是同一家（入驻时漏去重、或卖家后期提供了证明）。合并的语义比转让复杂得多，因为它要处理「两个主体各自的店铺、各自的银行账户、各自的账单历史」。稳妥的实践是<strong>不物理合并</strong>，而是建立一个 <code>entity_merge</code> 关联表并指定一个 <code>primary_entity_id</code>，让风控与报表按主主体聚合，而结算仍按历史主体分别完成。物理合并会破坏历史账单的可回溯性，而账单一旦开出就不应该被回溯修改——这是 <a href=\"../settlement-billing/merchant-billing\">商家账单、对账与发票</a> 的前提。若确实需要统一结算（例如卖家要求把两个账户的钱打到一个地方），正确做法是改 <code>bank_account</code> 的归属或增加收款人，而不是合并主体。</p>\n<h2 id=\"与平台账号-登录身份的分离\">与平台账号、登录身份的分离</h2><p>有一个容易混淆的第四层：<strong>登录账号</strong>。卖家用一个邮箱登录 Seller Center，这个账号可能绑定到多个主体（一个会计为三家公司做账），一个主体也可能有多个登录账号（老板、财务、运营各一个）。因此正确的结构是：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    U[登录账号 user] --&gt;|N:N 成员关系| E[法人主体 entity]&#10;    U --&gt;|N:N 成员关系| S[店铺 shop]&#10;    E --&gt;|1:N| S&#10;    S --&gt;|1:N| T[站点 site]&#10;    R[角色 role] --&gt; M[成员关系 membership]&#10;    M --&gt;|作用于| E&#10;    M --&gt;|作用于| S\">graph TD\n    U[登录账号 user] --&gt;|N:N 成员关系| E[法人主体 entity]\n    U --&gt;|N:N 成员关系| S[店铺 shop]\n    E --&gt;|1:N| S\n    S --&gt;|1:N| T[站点 site]\n    R[角色 role] --&gt; M[成员关系 membership]\n    M --&gt;|作用于| E\n    M --&gt;|作用于| S</pre><p>登录账号与主体是 N:N 的<strong>成员关系（membership）</strong>，而角色挂在成员关系上而不是账号上——同一个账号在 A 主体是 owner、在 B 主体只是 viewer。这个设计直接决定了第三章权限模型的形态，在那里会展开；本文只需要指出：<strong>如果登录账号被当作主体，那么「一个会计管三家店」就无法表达，且审计日志无法区分「是这家公司的谁做的」</strong>。审计的主体必须是登录账号，而权限的载体必须是成员关系。</p>\n<h2 id=\"小结\">小结</h2><p>账户模型是商家域的地基，它的错误会以账单错乱、串权、无法转让的形式在几个月后暴露。</p>\n<ul>\n<li>三层实体各有锚点：主体锚定<strong>结算与合规</strong>、店铺锚定<strong>品牌与评价</strong>、站点锚定<strong>本地化与履约</strong>。</li>\n<li>关系是 <code>主体 1—N 店铺 1—N 站点</code>，结算挂主体、税务与币种挂站点。</li>\n<li><strong>不能合并</strong>的三个反例：一主体多店、一站点的税务口径、主体转让。</li>\n<li>状态传播是<strong>有向且不对称</strong>的：主体级问题向下全传播，站点级问题不波及兄弟站点；判定走统一函数。</li>\n<li><strong>转让</strong>改 <code>entity_id</code> 一列；<strong>合并</strong>不做物理合并，用关联表保历史账单可回溯。</li>\n<li>登录账号是<strong>第四层</strong>，与主体是 N:N 成员关系，角色挂在成员关系上。</li>\n</ul>\n<p>本文产出的实体与边界被三处消费：流程与验证见 <a href=\"merchant-onboarding-flow\">入驻流程、状态与审核工单</a> 与 <a href=\"kyc-qualification\">商家 KYC/资质与分市场合规</a>；店铺层的展示配置建立在 <code>shop</code> 与 <code>shop_site</code> 之上，见 <a href=\"../shop-catalog-manage/shop-profile-i18n\">店铺信息多语言与装修</a>；成员关系与角色的落地见 <a href=\"../permissions-subaccount/rbac-merchant\">商家侧角色权限模型</a>。</p>\n","headings":[{"level":1,"text":"主体/店铺/站点账户模型","id":"主体-店铺-站点账户模型"},{"level":2,"text":"核心概念：三层实体与它们的关系基数","id":"核心概念-三层实体与它们的关系基数"},{"level":2,"text":"为什么不能合并：三个反例","id":"为什么不能合并-三个反例"},{"level":2,"text":"账户表的落地结构","id":"账户表的落地结构"},{"level":2,"text":"主体、店铺、站点的生命周期与状态传播","id":"主体-店铺-站点的生命周期与状态传播"},{"level":2,"text":"转让与合并：最容易被忽略的一组操作","id":"转让与合并-最容易被忽略的一组操作"},{"level":2,"text":"与平台账号、登录身份的分离","id":"与平台账号-登录身份的分离"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"商家 KYC/资质与分市场合规","url":"/l-doc-books/h/global-ecommerce/merchant-seller-platform/onboarding-kyc/kyc-qualification"},"next":{"title":"店铺信息多语言与装修","url":"/l-doc-books/h/global-ecommerce/merchant-seller-platform/shop-catalog-manage/shop-profile-i18n"}}