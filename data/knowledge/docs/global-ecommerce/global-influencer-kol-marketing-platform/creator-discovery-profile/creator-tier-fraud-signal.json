-shiki-dark:#E1E4E8\"> creator_metric_snapshot</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> source </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'official'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> snapshot_date </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'60 days'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  SELECT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    AVG</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(df)    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">OVER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">PARTITION</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> creator_id) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mu_df,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    STDDEV_SAMP(df) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">OVER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">PARTITION</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> creator_id) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sd_df</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> creator_id, snapshot_date, df, dv,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">       ROUND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mu_df) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> NULLIF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sd_df, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_score</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sd_df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mu_df) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> NULLIF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sd_df, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      -- 粉丝阶跃</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dv </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> OR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dv </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)                   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 播放量未同步上升</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><h3 id=\"粉丝-关注比与账号年龄\">粉丝/关注比与账号年龄</h3><p>两个简单但有效的结构信号。<strong>粉丝关注比</strong> <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>f</mi><mrow><mi>r</mi><mi>a</mi><mi>t</mi><mi>i</mi><mi>o</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>f</mi><mi>o</mi><mi>l</mi><mi>l</mi><mi>o</mi><mi>w</mi><mi>e</mi><mi>r</mi><mi>s</mi></mrow><mrow><mi>f</mi><mi>o</mi><mi>l</mi><mi>l</mi><mi>o</mi><mi>w</mi><mi>i</mi><mi>n</mi><mi>g</mi></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">f_{ratio} = \\frac{followers}{following}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.1076em;\">f</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.1076em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal mtight\">a</span><span class=\"mord mathnormal mtight\">t</span><span class=\"mord mathnormal mtight\">i</span><span class=\"mord mathnormal mtight\">o</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.4133em;vertical-align:-0.4811em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9322em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span><span class=\"mord mathnormal mtight\">o</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">o</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0269em;\">w</span><span class=\"mord mathnormal mtight\">in</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.4461em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span><span class=\"mord mathnormal mtight\">o</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">o</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0269em;\">w</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">er</span><span class=\"mord mathnormal mtight\">s</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4811em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span>：正常达人通常关注数远小于粉丝数（比值大）；批量注册的互粉账号常表现为关注数同样庞大（比值接近 1 或更小）。<strong>账号年龄与粉丝量的比值</strong>：一个注册两个月就有 50 万粉的账号，若无爆款内容支撑，显著可疑。</p>\n<p>这两个信号不适合单独定论——一个专注做「互关社群」的账号天然比值低但可能真实运营。它们应当作为特征进入评分模型而非独立规则。</p>\n<h3 id=\"评论质量与协同行为\">评论质量与协同行为</h3><p>评论区的检测有两个维度。<strong>重复度</strong>：若大量评论文本高度相似（同一句「好用！」重复出现），是水军的典型特征。用编辑距离或文本哈希的聚类比例即可量化。<strong>评论者质量</strong>：抽查评论账号，若其自身内容为空、关注数为 0、注册时间集中，则评论是刷的。</p>\n<p>更高级的手法来自学术研究。一项发表于 IEEE TDSC 的工作提出「数字 DNA」方法：把账号的行为生命周期编码为字符序列，再计算账号之间的序列相似度，从而识别出<strong>协同行动的水军群组</strong>——它们共享行为指纹，而真实用户不共享（见 <a href=\"https://arxiv.org/abs/1703.04482\">Social Fingerprinting 论文摘要</a>，该工作发表于 IEEE Transactions on Dependable and Secure Computing 15(4), 2018）。这项研究针对的是能绕过传统检测器的「类人」机器人，其价值在于从单体特征转向群体行为模式。</p>\n<h2 id=\"风险评分与处置\">风险评分与处置</h2><h3 id=\"从信号到分数\">从信号到分数</h3><p>把多个弱信号合成一个 0–100 的风险分。相加式（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>r</mi><mi>i</mi><mi>s</mi><mi>k</mi><mo>=</mo><mo>∑</mo><msub><mi>w</mi><mi>i</mi></msub><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding=\"application/x-tex\">risk = \\sum w_i s_i</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal\">i</span><span class=\"mord mathnormal\">s</span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop op-symbol small-op\" style=\"position:relative;top:0em;\">∑</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0269em;\">w</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0269em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord\"><span class=\"mord mathnormal\">s</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>）简单但会让多个中等信号累积成高分；取最大值式（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>r</mi><mi>i</mi><mi>s</mi><mi>k</mi><mo>=</mo><msub><mrow><mi>max</mi><mo>⁡</mo></mrow><mi>i</mi></msub><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding=\"application/x-tex\">risk = \\max_i s_i</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal\">i</span><span class=\"mord mathnormal\">s</span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mop\"><span class=\"mop\">max</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">s</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>）保守但会漏掉「每个信号都略可疑」的账号。实务上常用加权和加一个「硬触发」通道：某些信号（如发现明确的水军群组关联）直接置为高风险，不参与加权。</p>\n<p>分数必须<strong>可解释</strong>：每条触发信号都要落库，包含信号名、取值、阈值、贡献分、规则版本。这既是为了申诉，也是为了在第 4 章复盘中验证规则是否有效。</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;creator_id&quot;: 88421,&#10;  &quot;risk_score&quot;: 72,&#10;  &quot;risk_band&quot;: &quot;medium&quot;,&#10;  &quot;evaluated_at&quot;: &quot;2026-09-27T08:15:00Z&quot;,&#10;  &quot;rule_version&quot;: &quot;risk-rules-v4&quot;,&#10;  &quot;signals&quot;: [&#10;    { &quot;name&quot;: &quot;follower_jump_zscore&quot;, &quot;value&quot;: 5.4, &quot;threshold&quot;: 4.0, &quot;contribution&quot;: 25 },&#10;    { &quot;name&quot;: &quot;views_not_synced&quot;, &quot;value&quot;: true, &quot;contribution&quot;: 15 },&#10;    { &quot;name&quot;: &quot;comment_dup_ratio&quot;, &quot;value&quot;: 0.41, &quot;threshold&quot;: 0.35, &quot;contribution&quot;: 20 },&#10;    { &quot;name&quot;: &quot;fan_follow_ratio&quot;, &quot;value&quot;: 1.8, &quot;threshold&quot;: 3.0, &quot;contribution&quot;: 12 }&#10;  ],&#10;  &quot;hard_triggers&quot;: [],&#10;  &quot;action&quot;: &quot;manual_review&quot;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"creator_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">88421</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"risk_score\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">72</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"risk_band\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"medium\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"evaluated_at\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-27T08:15:00Z\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"rule_version\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"risk-rules-v4\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"signals\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"follower_jump_zscore\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"value\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5.4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"threshold\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"contribution\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"views_not_synced\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"value\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"contribution\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">15</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"comment_dup_ratio\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"value\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.41</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"threshold\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.35</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"contribution\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"fan_follow_ratio\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"value\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"threshold\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"contribution\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"hard_triggers\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"action\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"manual_review\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"分档处置\">分档处置</h3><table>\n<thead>\n<tr>\n<th>风险档</th>\n<th>分数区间</th>\n<th>默认动作</th>\n<th>复核要求</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>低</td>\n<td>0 – 39</td>\n<td>直接进入邀约队列</td>\n<td>无需人工</td>\n</tr>\n<tr>\n<td>中</td>\n<td>40 – 69</td>\n<td>人工复核后决定</td>\n<td>需查看信号明细</td>\n</tr>\n<tr>\n<td>高</td>\n<td>70 – 100</td>\n<td>拒绝并加入观察名单</td>\n<td>需双人确认解除</td>\n</tr>\n</tbody></table>\n<p>「高」档不应直接永久黑名单——误判确实存在，例如一次真实的病毒传播被误认为买粉。可行做法是加入<strong>带过期的观察名单</strong>，到期后自动重算，同时保留全部判定记录。</p>\n<h3 id=\"与结算的联动\">与结算的联动</h3><p>风险分不是一次性的准入检查，它应当在整个合作周期里持续复算。若达人在合作期间出现刷量，第 4 章的结算需要据此判断——是否按效果付费的佣金部分应被暂缓或调整。这要求结算服务能查询到「结算周期内的风险分」。本篇产出的风险分与信号明细表，是 <a href=\"../campaign-performance-settle/creator-fee-commission-settle\">坑位费/佣金结算</a> 中「异常扣减」依据的数据源。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>分层与风险评分是两件不同的事：前者中性分类、匹配预算，后者负面信号、决定去留。</li>\n<li>不要合成单一总分——运营需要能解释「为什么拒绝这个人」。</li>\n<li>互动率随量级递减，必须按平台+层级做百分位标准化，不能用全局阈值。</li>\n<li>动态行为信号（涨粉阶跃）可靠性最高，前提是自采时间序列快照。</li>\n<li>阶跃检测必须叠加「播放量未同步上升」的条件，否则会把爆款误判为买粉。</li>\n<li>协同水军需要群体行为建模（如行为序列相似度），单体特征不足以识别。</li>\n<li>风险分要可解释、落库、带规则版本，并支持带过期的观察名单而非永久拉黑。</li>\n</ul>\n<p>本章到此结束：数据接入（第 1 篇）提供原料，画像契合度（第 2 篇）给出去向，本篇给出可信度。三者的合成结果——一份带契合度与风险标记的候选名单——交给 <a href=\"../outreach-brief-contract/recruit-outreach-workflow\">招募建联工作流</a> 开始真正的接触。</p>\n","headings":[{"level":1,"text":"达人分层与水军/刷量信号","id":"达人分层与水军-刷量信号"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"达人分层的维度与阈值","id":"达人分层的维度与阈值"},{"level":3,"text":"为什么单看粉丝数不够","id":"为什么单看粉丝数不够"},{"level":3,"text":"互动率必须按平台基线标准化","id":"互动率必须按平台基线标准化"},{"level":2,"text":"刷量信号的检测方法","id":"刷量信号的检测方法"},{"level":3,"text":"信号分类与可观测性","id":"信号分类与可观测性"},{"level":3,"text":"涨粉曲线的阶梯检测","id":"涨粉曲线的阶梯检测"},{"level":3,"text":"粉丝/关注比与账号年龄","id":"粉丝-关注比与账号年龄"},{"level":3,"text":"评论质量与协同行为","id":"评论质量与协同行为"},{"level":2,"text":"风险评分与处置","id":"风险评分与处置"},{"level":3,"text":"从信号到分数","id":"从信号到分数"},{"level":3,"text":"分档处置","id":"分档处置"},{"level":3,"text":"与结算的联动","id":"与结算的联动"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"受众画像与品牌契合度","url":"/l-doc-books/h/global-ecommerce/global-influencer-kol-marketing-platform/creator-discovery-profile/audience-creator-fit"},"next":{"title":"招募建联工作流","url":"/l-doc-books/h/global-ecommerce/global-influencer-kol-marketing-platform/outreach-brief-contract/recruit-outreach-workflow"}}