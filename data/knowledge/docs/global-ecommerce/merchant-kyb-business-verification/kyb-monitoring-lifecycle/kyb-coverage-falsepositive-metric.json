lor:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'30 days'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  GROUP  BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">case_ref</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">created_at</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">decided_at</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  PERCENTILE_CONT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WITHIN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> GROUP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> auto_sec)   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p50_auto,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  PERCENTILE_CONT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">90</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WITHIN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> GROUP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> auto_sec)   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p90_auto,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  PERCENTILE_CONT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">90</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WITHIN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> GROUP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> doc_round_sec) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p90_docs,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  PERCENTILE_CONT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">90</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WITHIN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> GROUP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> manual_sec) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p90_manual,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  PERCENTILE_CONT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">99</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WITHIN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> GROUP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (auto_sec </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> doc_round_sec </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> manual_sec))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                                                            AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p99_total</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> staged;</span></span></code></pre></div><h3 id=\"时效与风险档的交叉\">时效与风险档的交叉</h3><p>时效目标不能是一个全局数字，必须<strong>按风险档分设</strong>。高风险商家走增强尽调（EDD）意味着更长的核验周期，这是设计意图而不是缺陷；用统一的时效目标考核，会迫使团队在高风险档上压缩必要的核验，或者把高风险商家错误地降档以达标。后者是这类指标最危险的副作用——<strong>指标会改变它所测量的行为</strong>。</p>\n<h2 id=\"三者的联合判读\">三者的联合判读</h2><h3 id=\"失衡模式与处置\">失衡模式与处置</h3><p>三个指标必须联合看，因为单看任何一个都会被合法地优化：</p>\n<table>\n<thead>\n<tr>\n<th>失衡模式</th>\n<th>表现</th>\n<th>根因</th>\n<th>处置方向</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>阈值过严</td>\n<td>覆盖率↑ 误拒↑ 时效↑</td>\n<td>判定规则失去区分度</td>\n<td>拆细风险档，补自动核验通道</td>\n</tr>\n<tr>\n<td>控制虚设</td>\n<td>误拒↓ 覆盖率↓</td>\n<td>阈值过松或核验被绕过</td>\n<td>收紧阈值，检查是否被降级路径绕过</td>\n</tr>\n<tr>\n<td>容量不足</td>\n<td>覆盖率↑ 时效↑ 误拒持平</td>\n<td>人工/外部依赖积压</td>\n<td>扩容量、优化外部调用、减少补件轮次</td>\n</tr>\n<tr>\n<td>模型失效</td>\n<td>高风险档误拒占比高</td>\n<td>风险分无区分度</td>\n<td>重估特征与权重</td>\n</tr>\n<tr>\n<td>健康</td>\n<td>三者稳定且分档合理</td>\n<td>—</td>\n<td>维持并小幅迭代</td>\n</tr>\n</tbody></table>\n<h3 id=\"指标必须配基线\">指标必须配基线</h3><p>任何指标脱离基线都无法判读。&quot;误拒率 8%&quot;是好是坏，取决于基线是多少、变化趋势如何。因此每个指标应当有<strong>滚动基线</strong>（如过去 90 天的分位数），并对<strong>偏移量</strong>告警而不是对绝对值告警。这与此前各篇的一贯原则一致：<strong>判定必须相对一个被钉住的参照</strong>（<code>mapping_version</code>、<code>engine_version</code>、<code>list_versions</code>、<code>score_model</code>），指标也同样需要一个参照。</p>\n<h3 id=\"度量的边界\">度量的边界</h3><p>需要明确本篇不度量的东西，以免被误当作遗漏：<strong>KYB 系统的最终效果是&quot;减少了多少欺诈损失&quot;</strong>，而这个数字无法由本 hub 的度量直接给出——它需要与平台治理侧的欺诈损失数据、与商家经营信用侧的经营表现数据联合分析。本 hub 负责度量<strong>系统自身的过程质量</strong>（覆盖、误拒、时效），把过程质量与结果损失关联起来，是跨系统的分析工作。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>覆盖率、误拒率、时效三者存在<strong>结构性对抗</strong>，任何单指标优化都会恶化另一个；本篇的核心是三者的<strong>联合判读</strong>而非指标清单。</li>\n<li>覆盖率的分母口径必须固定并文档化；<strong>UBO 穿透率必须单独度量</strong>，否则穿透能力的退化会被总覆盖率掩盖；覆盖率必须基于完整核验记录而非抽样（长尾缺失有聚集性，随机抽样检出效率低）。</li>\n<li><strong>误拒率与漏放率必须分开统计</strong>，且误拒要拆成<strong>规则误拒、数据源误拒、流程误拒</strong>三类，因为修复动作完全不同；按风险档分别统计误拒占比可检出&quot;模型无区分度&quot;这一全局平均掩盖的失效。</li>\n<li>时效必须看 <strong>P50/P90/P99 分位数</strong>，且<strong>分段度量</strong>（自动核验 / 补件往返 / 人工排队 / 人工处理）；时效目标必须<strong>按风险档分设</strong>，否则会迫使团队压低必要的核验强度。</li>\n<li>每个指标必须配<strong>滚动基线</strong>并对偏移告警，而非对绝对值告警；本 hub 度量的是系统<strong>过程质量</strong>，与欺诈损失这类<strong>结果指标</strong>的关联分析属于跨系统工作。误拒与漏放的标注数据来自 <a href=\"../ubo-controller-due-diligence/ubo-sanctions-aml-interface\">UBO 与制裁/AML 筛查接口</a> 的筛查凭证与 <a href=\"../business-account-qualification/kyb-risk-tier-approval\">KYB 风险分级与入驻审批</a> 的结构化理由码；覆盖率的长尾缺口检测依赖 <a href=\"ongoing-monitoring-change-rescreen\">工商变更/存续状态持续监控</a> 的订阅健康度指标。</li>\n</ul>\n","headings":[{"level":1,"text":"KYB 覆盖率/误拒/时效度量","id":"kyb-覆盖率-误拒-时效度量"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"覆盖率：分子分母的口径陷阱","id":"覆盖率-分子分母的口径陷阱"},{"level":3,"text":"覆盖率的定义问题","id":"覆盖率的定义问题"},{"level":3,"text":"覆盖率不能靠抽样声称","id":"覆盖率不能靠抽样声称"},{"level":2,"text":"误拒：两个方向的成本不对称","id":"误拒-两个方向的成本不对称"},{"level":3,"text":"误拒与漏放必须分开统计","id":"误拒与漏放必须分开统计"},{"level":3,"text":"误拒的三个来源","id":"误拒的三个来源"},{"level":3,"text":"一个可用的分层判读方法","id":"一个可用的分层判读方法"},{"level":2,"text":"时效：分位数而非均值","id":"时效-分位数而非均值"},{"level":3,"text":"为什么必须看分位数","id":"为什么必须看分位数"},{"level":3,"text":"时效的分段度量","id":"时效的分段度量"},{"level":3,"text":"时效与风险档的交叉","id":"时效与风险档的交叉"},{"level":2,"text":"三者的联合判读","id":"三者的联合判读"},{"level":3,"text":"失衡模式与处置","id":"失衡模式与处置"},{"level":3,"text":"指标必须配基线","id":"指标必须配基线"},{"level":3,"text":"度量的边界","id":"度量的边界"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"商家异常/停业/吊销联动（联047/110）","url":"/l-doc-books/h/global-ecommerce/merchant-kyb-business-verification/kyb-monitoring-lifecycle/merchant-status-dormancy-revocation"},"next":null}