style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">        TEXT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'created'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  due_at       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMPTZ</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  payload      JSONB,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  created_at   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMPTZ</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> UNIQUE INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> document_request (case_ref, requirement_id, round_no);</span></span></code></pre></div><h3 id=\"补件内容的结构化\">补件内容的结构化</h3><p>补件的每一项都应当绑定一个 <code>requirement_id</code> 与一份<strong>证据 schema</strong>，而不是一段自由文本要求。自由文本要求的问题是商家提交什么、审核员看什么、系统如何自动核验三者无法对齐。把要求结构化之后，&quot;收到材料后能否自动核验&quot;就成了一个可判定问题——能自动核验的走自动，不能的才进人工。</p>\n<h2 id=\"审批决策的可解释性与留痕\">审批决策的可解释性与留痕</h2><h3 id=\"决策档案\">决策档案</h3><p>审批结论必须附带完整依据，且<strong>不可变</strong>。监管问询、商家申诉、内部复盘三类场景都需要能回答&quot;当时为什么这么判&quot;：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;case_ref&quot;: &quot;kyb:lei:5493000IBP32UQZ0KL24&quot;,&#10;  &quot;decision&quot;: &quot;approved_with_conditions&quot;,&#10;  &quot;decided_at&quot;: &quot;2026-09-28T00:00:00Z&quot;,&#10;  &quot;decided_by&quot;: &quot;auto:kyb_engine_v3&quot;,&#10;  &quot;score_model&quot;: &quot;kyb_risk_v3&quot;,&#10;  &quot;risk_score&quot;: 0.27,&#10;  &quot;risk_band&quot;: &quot;low&quot;,&#10;  &quot;hard_blocks&quot;: [],&#10;  &quot;conditions&quot;: [{ &quot;type&quot;: &quot;monitor_extra&quot;, &quot;detail&quot;: &quot;类目扩张需重新核验经营范围&quot; }],&#10;  &quot;evidence_digest&quot;: {&#10;    &quot;screening_evidence_ids&quot;: [1, 2, 3],&#10;    &quot;ubo_resolution_ids&quot;: [91],&#10;    &quot;credential_ids&quot;: [55, 56],&#10;    &quot;account_verification_id&quot;: 12&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"case_ref\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kyb:lei:5493000IBP32UQZ0KL24\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"decision\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"approved_with_conditions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"decided_at\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-28T00:00:00Z\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"decided_by\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"auto:kyb_engine_v3\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"score_model\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kyb_risk_v3\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"risk_score\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.27</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"risk_band\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"low\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"hard_blocks\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"conditions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [{ </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"type\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"monitor_extra\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"detail\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"类目扩张需重新核验经营范围\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"evidence_digest\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"screening_evidence_ids\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"ubo_resolution_ids\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">91</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"credential_ids\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">55</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">56</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"account_verification_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>evidence_digest</code> 存放的是<strong>引用而不是副本</strong>。这一点很重要：把证据原文复制进决策档案会造成同一事实的多份副本，当证据本身被更正时，副本不会同步，档案之间互相矛盾。引用 + 各证据表的不可变设计（见 <a href=\"../ubo-controller-due-diligence/ubo-sanctions-aml-interface\">UBO 与制裁/AML 筛查接口</a> 的 <code>screening_evidence</code>）共同保证&quot;当时的依据&quot;可精确重建。</p>\n<h3 id=\"人工决策的强制理由\">人工决策的强制理由</h3><p>人工复核推翻自动结论时（无论放松还是收紧），必须填写结构化理由码，而不是自由文本。理由码是可统计的：某个理由码频繁出现，说明对应维度的自动判定规则需要调整。这是自动模型持续改进的唯一可靠输入。</p>\n<table>\n<thead>\n<tr>\n<th>理由码</th>\n<th>含义</th>\n<th>自动规则改进方向</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>FP_NAME_MATCH</code></td>\n<td>制裁疑似为同名误报</td>\n<td>提升匹配区分度阈值</td>\n</tr>\n<tr>\n<td><code>FP_ADDRESS_FORMAT</code></td>\n<td>地址不一致实为格式差异</td>\n<td>完善地址归一化</td>\n</tr>\n<tr>\n<td><code>FN_SCOPE_SEMANTIC</code></td>\n<td>经营范围为语义覆盖但规则未识别</td>\n<td>扩充行业映射同义词</td>\n</tr>\n<tr>\n<td><code>TP_NOMINEE_PATTERN</code></td>\n<td>挂名模式被自动规则漏掉</td>\n<td>新增特征或调权重</td>\n</tr>\n</tbody></table>\n<p><code>FP_</code>/<code>FN_</code>/<code>TP_</code> 前缀让漏放与误拒可以被分开统计——这两个方向的成本不对称，混在一个&quot;人工改判率&quot;里会掩盖问题所在方向。</p>\n<h3 id=\"与处置和监控的衔接\">与处置和监控的衔接</h3><p>审批通过不是终点。通过的案例必须注册到 <a href=\"../kyb-monitoring-lifecycle/ongoing-monitoring-change-rescreen\">工商变更/存续状态持续监控</a> 的订阅集合里，附带的 <code>conditions</code>（如&quot;类目扩张需重新核验&quot;）也要转化为可执行的监控规则。附带条件的审批如果不注册监控，条件就是一句空话——这正是审批与监控必须在同一处收口的原因。</p>\n<p>被拒绝的案例同样要留档：拒绝原因、命中的否决项、以及<strong>是否上报</strong>（涉及制裁的案例有独立的报告义务，属于制裁筛查与反洗钱监控侧的职责）。拒绝档案也是识别&quot;同一团伙反复尝试入驻&quot;的输入——同一批 UBO 或同一批地址在不同主体下反复出现，是值得单独建模的模式。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>审批收口的第一原则是<strong>否决项与加权项分离</strong>：制裁确认命中、主体不存在、资质吊销、账户无合法归属、强制资质缺失、筛查未完成都是不可交易的硬否决，不因其他维度优秀而减轻。</li>\n<li>&quot;筛查未完成&quot;必须等价于&quot;不能批准&quot;，否则攻击者只需让某环节长期 pending 即可绕过筛查。</li>\n<li>加权模型必须<strong>版本化</strong>（<code>score_model</code>），档位边界（低/中/高）应按误拒成本与漏放成本的实测比值确定并迭代，而非一次性设定。</li>\n<li>补件是带<strong>超时与轮次上限</strong>（<code>MAX_ROUNDS</code>）的状态机，以 <code>(case_ref, requirement_id, round)</code> 为幂等键，同轮内最后一次提交生效；补件要求应绑定 <code>requirement_id</code> 与证据 schema 以支持自动核验。</li>\n<li>决策档案<strong>不可变</strong>且以 <code>evidence_digest</code> <strong>引用</strong>而非复制证据；人工改判必须填结构化理由码（<code>FP_</code>/<code>FN_</code>/<code>TP_</code> 前缀可分离漏放与误拒）。</li>\n<li>审批通过必须注册到 <a href=\"../kyb-monitoring-lifecycle/ongoing-monitoring-change-rescreen\">持续监控</a>，附带条件要转为可执行监控规则；拒绝档案是识别重复入驻团伙的输入。</li>\n</ul>\n","headings":[{"level":1,"text":"KYB 风险分级与入驻审批/补件","id":"kyb-风险分级与入驻审批-补件"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"否决项与加权项的分离","id":"否决项与加权项的分离"},{"level":3,"text":"什么是硬否决项","id":"什么是硬否决项"},{"level":3,"text":"加权项的构成","id":"加权项的构成"},{"level":3,"text":"为什么分档而不是二值","id":"为什么分档而不是二值"},{"level":2,"text":"补件流程的状态机","id":"补件流程的状态机"},{"level":3,"text":"状态与迁移","id":"状态与迁移"},{"level":3,"text":"幂等与并发","id":"幂等与并发"},{"level":3,"text":"补件内容的结构化","id":"补件内容的结构化"},{"level":2,"text":"审批决策的可解释性与留痕","id":"审批决策的可解释性与留痕"},{"level":3,"text":"决策档案","id":"决策档案"},{"level":3,"text":"人工决策的强制理由","id":"人工决策的强制理由"},{"level":3,"text":"与处置和监控的衔接","id":"与处置和监控的衔接"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"行业资质与前置经营许可（联109）","url":"/l-doc-books/h/global-ecommerce/merchant-kyb-business-verification/business-account-qualification/industry-license-precondition"},"next":{"title":"工商变更/存续状态持续监控与重审","url":"/l-doc-books/h/global-ecommerce/merchant-kyb-business-verification/kyb-monitoring-lifecycle/ongoing-monitoring-change-rescreen"}}