hiki-dark:#E1E4E8\">) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"weight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"strong_edges\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"weak_edge_summary_weight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ANCHOR_BOOST</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    size_penalty </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1.0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(c[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"member_stores\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.0</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    density_factor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(c[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"internal_density\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> size_penalty </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> density_factor)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> emit_candidates</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(clusters, min_weight</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, min_stores</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    out </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> clusters:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(c.member_stores) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> min_stores:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            continue</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> score_cluster(c)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> min_weight:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            c[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"cluster_score\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            out.append(c)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sorted</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(out, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=lambda</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">x[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"cluster_score\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span></code></pre></div><p><code>evidence_path</code> 字段是工程上容易被忽略但治理上极其重要的一项：它给出从一家店到另一家店的最短可解释路径（店铺 → 支付账户 → 店铺）。申诉环节需要这条路径来让卖家理解系统看到了什么，也让复核人员快速验证判定是否有误。没有它，处置决定就无法向卖家解释，<a href=\"../linkage-evidence-adjudication/seller-appeal-evidence-process\">申诉与复议</a> 也就无从开展。</p>\n<h2 id=\"规模-时效与增量重算\">规模、时效与增量重算</h2><h3 id=\"分片与增量重算\">分片与增量重算</h3><p>真实平台的关联图规模可观：数十万到数百万店铺节点，加上设备、账户等中间节点，边数可达千万级。全量 Louvain 在这种规模上通常需要分钟级，无法承受每有新信号就全量重跑。</p>\n<p>工程上的做法是<strong>分片 + 增量</strong>：先按地理或类目分片（逃逸通常发生在相近的履约区域内，跨洲关联较少），在分片内做社区发现，只在跨片出现强边时做合并。新信号到来时，只重算受影响的簇——识别新边连接的两个节点各自所属的簇，只对这两个簇（及其邻域）重跑局部聚类。这个机制的具体触发与调度在<a href=\"../linkage-lifecycle-integration/ongoing-linkage-monitoring-rerun\">持续关联监控与新证据重算</a> 展开。</p>\n<h3 id=\"簇标识的稳定性\">簇标识的稳定性</h3><p>增量重算必须处理<strong>簇的稳定性</strong>问题：局部重跑可能把一个大簇切成两半，若每次信号更新都导致簇结构剧烈变动，处置与申诉的历史就会失去连续性。解法是给簇引入稳定标识——用簇内强边锚点（如 UBO 哈希）或簇内店铺集合的指纹作为簇 ID，并在簇结构变化超过阈值时显式记录一次「簇演化」事件而非改名。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>关联图谱是异构图，把设备/账户/IP 作为显式中间节点而非直接投影，能保留更强的间接连通证据。</li>\n<li>边权重用对数似然比，使多条独立边可线性相加；须做中间节点度数惩罚与簇级提升两层校准。</li>\n<li>Louvain 等模块度方法可用，但需先剪高度数节点、切出强边锚定簇，再加最小规模与密度约束，否则巨型连通分量会破坏聚类。</li>\n<li>候选对象应携带簇分数、强边清单、最短证据路径与动机假设，证据路径是申诉可解释性的前提。</li>\n<li>规模化依赖分片与增量重算；增量须保证簇标识的稳定，用簇演化事件而非改名来体现结构变化。</li>\n<li>簇级评分决定候选进入第 3 章的优先级，但绝不直接决定处置。</li>\n</ul>\n<p>相关阅读：强信号来源见<a href=\"ubo-company-legal-link\">主体/公司/法人/UBO 强关联</a>，弱信号与基线频率见<a href=\"device-ip-payout-weak-link\">设备/IP/收款/联系方式弱关联</a>。</p>\n","headings":[{"level":1,"text":"经营画像相似与关联图谱社区发现","id":"经营画像相似与关联图谱社区发现"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"从信号到图：节点与边的建模","id":"从信号到图-节点与边的建模"},{"level":3,"text":"节点类型设计","id":"节点类型设计"},{"level":3,"text":"二分图投影与路径保留","id":"二分图投影与路径保留"},{"level":2,"text":"边权重的校准：从似然比到图权重","id":"边权重的校准-从似然比到图权重"},{"level":3,"text":"度数惩罚与簇级提升","id":"度数惩罚与簇级提升"},{"level":2,"text":"社区发现算法的选择","id":"社区发现算法的选择"},{"level":3,"text":"模块度的解析度限制","id":"模块度的解析度限制"},{"level":3,"text":"显式的剪枝与约束","id":"显式的剪枝与约束"},{"level":2,"text":"簇级评分与候选生成","id":"簇级评分与候选生成"},{"level":2,"text":"规模、时效与增量重算","id":"规模-时效与增量重算"},{"level":3,"text":"分片与增量重算","id":"分片与增量重算"},{"level":3,"text":"簇标识的稳定性","id":"簇标识的稳定性"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"设备/IP/收款/联系方式弱关联","url":"/l-doc-books/h/global-ecommerce/seller-multistore-account-linkage-governance/linkage-signal-graph/device-ip-payout-weak-link"},"next":{"title":"关联证据强度分级与误判控制","url":"/l-doc-books/h/global-ecommerce/seller-multistore-account-linkage-governance/linkage-evidence-adjudication/linkage-confidence-evidence-tier"}}