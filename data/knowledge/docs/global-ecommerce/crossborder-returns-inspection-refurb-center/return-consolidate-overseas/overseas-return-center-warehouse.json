an style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sealed_at         </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMPTZ</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  created_at        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMPTZ</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">  NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  CONSTRAINT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chk_positive </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">CHECK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (total_pieces </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> return_consolidation_item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  batch_id          </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> REFERENCES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> return_consolidation_batch(batch_id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  rma_id            </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sscc              </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 所在物流单元（AI 00）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  serial_no         </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),                  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 单品序列号（AI 21）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  declared_grade    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">CHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),                       </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 初检预判等级，见 3.1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (batch_id, rma_id)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p><code>initial_grade</code> 这一列是刻意加的：初检的预判等级不参与最终定价，但它是 1.2 回运决策的输入，也是与到岸后实际分级的<strong>偏差分析</strong>的基础——如果初检总把 C 级预判成 A 级，说明初检标准或培训出了问题，这个偏差本身就是一个可监控的质量指标。</p>\n<h2 id=\"与相邻篇的衔接\">与相邻篇的衔接</h2><p>中心仓的终点有两个，分别对应后续不同的篇章。进入「回运候选池」的货，其命运由 <a href=\"../return-consolidate-overseas/dispose-local-vs-return\">1.2 就地处置 vs 回运决策</a> 的决策函数重新裁决，并最终由 <a href=\"../return-consolidate-overseas/return-batch-consolidate\">1.3 退货批量集拼与回运</a> 拼批出运；进入「就地处置队列」的货，则在目的国本地完成 <a href=\"../inspect-grade-refurbish/central-inspection-grade\">3.1 集中质检与分级标准</a> 与 <a href=\"../inspect-grade-refurbish/grade-downgrade-channel\">3.3 分级降级与渠道分流</a>，或直接落入 <a href=\"../resale-destroy-link/defect-destroy-secondary\">4.2 残次销毁/二手转售处置</a> 的销毁或二手转售路径。中心仓本身不做最终决策，它做的是<strong>把一件无归属的退货，变成一个带有完整事实记录的、可被决策的对象</strong>。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>海外退货中心仓的存在理由是经济性的：它把跨境逆向成本从单件费率推向批量费率，是回运决策成立的前提。</li>\n<li>三种运营形态（平台自营、第三方服务商、卖家自建）共享同一组最小动作，系统应把它们抽象成可插拔的收货端点与统一的事件契约。</li>\n<li>收货的核心是身份三重绑定：RMA（业务身份）、订单行（价格身份）、GTIN + 序列号/批次（实物身份）。缺了序列号就无法证明「退回的实物就是卖出的那一件」。</li>\n<li>「未认领率」是集货节点最重要的运营质量指标：身份丢失的退货既不能合规回运，也不能合规销毁。</li>\n<li>集拼批次的单件成本随批量下降，但固定操作成本 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>F</mi></mrow><annotation encoding=\"application/x-tex\">F</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">F</span></span></span></span></span> 决定了存在一个最小经济批量；批次与集装单元（SSCC）的对应关系必须落库以支撑跨境段的多次交接。</li>\n<li>初检的预判等级不参与定价，但它是回运决策的输入与质量偏差监控的基线。</li>\n</ul>\n","headings":[{"level":1,"text":"海外退货中心仓与集货","id":"海外退货中心仓与集货"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"中心仓的三种运营形态","id":"中心仓的三种运营形态"},{"level":3,"text":"收货时系统必须捕获的事实","id":"收货时系统必须捕获的事实"},{"level":3,"text":"最小事实集","id":"最小事实集"},{"level":3,"text":"到仓收货的状态机","id":"到仓收货的状态机"},{"level":2,"text":"集货批量与成本曲线","id":"集货批量与成本曲线"},{"level":3,"text":"集装单元的标识","id":"集装单元的标识"},{"level":2,"text":"与相邻篇的衔接","id":"与相邻篇的衔接"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"就地处置 vs 回运决策","url":"/l-doc-books/h/global-ecommerce/crossborder-returns-inspection-refurb-center/return-consolidate-overseas/dispose-local-vs-return"}}