        bigserial PRIMARY KEY,&#10;  supplier_id       bigint      NOT NULL,&#10;  version_id        bigint      NOT NULL,&#10;  prev_version_id   bigint      NOT NULL,&#10;  reason_code       text        NOT NULL,   -- customer_upside / quality_hold / logistics_disruption&#10;  impact_qty_delta  numeric(14,3) NOT NULL,&#10;  requested_by      text        NOT NULL,&#10;  acked_by_supplier boolean     NOT NULL DEFAULT false,&#10;  acked_at          timestamptz,&#10;  created_at        timestamptz NOT NULL DEFAULT now()&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 冻结期例外必须留痕，便于按季度复盘</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forecast_freeze_exception</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  id                </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigserial</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  supplier_id       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  version_id        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  prev_version_id   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  reason_code       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">        NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- customer_upside / quality_hold / logistics_disruption</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  impact_qty_delta  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">numeric</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  requested_by      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">        NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  acked_by_supplier </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">boolean</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">     NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> false,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  acked_at          </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">timestamptz</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  created_at        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">timestamptz</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>冻结窗的作用不是把预测做准，而是让供应商敢下料——它把平台的不确定性成本从供应商身上收回来。</li>\n<li>时间轴切成冻结窗、弹性窗、自由窗三段，对应不同的修改权限与义务；两处分界线（需求时间栅栏、计划时间栅栏）必须建模为数据。</li>\n<li>发布出去的预测版本必须不可变，准确率度量与争议回溯都依赖版本号；条件请求（ETag + <code>If-Match</code>，必要时 428）是防止并发覆盖的正确工具。</li>\n<li>冻结窗允许例外修改，但必须走正式流程并留痕；例外频率是预测质量的诊断指标。</li>\n<li>按窗口切片推送（冻结窗仅推例外、弹性窗全量、自由窗低频）能让供应商看到的是「需要行动的行」，而不是一整张表。</li>\n</ul>\n<p>延伸：时间规则确定之后，就可以在弹性窗的预测之上叠加库存与在途算出补货建议，见<a href=\"../replenish-recommend-collab/replenish-suggestion-generate\">补货建议与下单量推荐</a>；预测发布之后的偏差如何在变成缺货前被双方同时发现，见<a href=\"../collab-dashboard-visibility/collab-exception-alert\">预测偏差/缺货风险预警</a>。</p>\n","headings":[{"level":1,"text":"预测共享时间窗与冻结","id":"预测共享时间窗与冻结"},{"level":2,"text":"核心概念：三个时间窗口","id":"核心概念-三个时间窗口"},{"level":3,"text":"冻结窗：锁定承诺的锚","id":"冻结窗-锁定承诺的锚"},{"level":3,"text":"弹性窗：允许协商的区间","id":"弹性窗-允许协商的区间"},{"level":3,"text":"自由窗：仅供产能规划","id":"自由窗-仅供产能规划"},{"level":3,"text":"每段窗口长度怎么定","id":"每段窗口长度怎么定"},{"level":2,"text":"版本与不可变性","id":"版本与不可变性"},{"level":3,"text":"冻结不等于禁止修改","id":"冻结不等于禁止修改"},{"level":3,"text":"版本服务端的两个保护","id":"版本服务端的两个保护"},{"level":2,"text":"发布节奏与切片","id":"发布节奏与切片"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"预测口径与置信度共享","url":"/l-doc-books/h/global-ecommerce/supplier-demand-forecast-collaboration/forecast-supplier-decompose/forecast-confidence-share"},"next":{"title":"补货建议与下单量推荐","url":"/l-doc-books/h/global-ecommerce/supplier-demand-forecast-collaboration/replenish-recommend-collab/replenish-suggestion-generate"}}