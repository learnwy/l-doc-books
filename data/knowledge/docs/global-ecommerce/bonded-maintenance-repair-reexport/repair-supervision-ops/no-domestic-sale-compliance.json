C5;--shiki-dark:#79B8FF\"> d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">serial_no</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">serial_no</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> EXISTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> byproduct_disposal bd</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> repair_byproduct bp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">bp_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bd</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">bp_id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">serial_no</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">serial_no</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bd</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">route</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'DESTROY'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'REEXPORT'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span></code></pre></div><p>这条查询定义了<strong>放行的唯一合法出口集合</strong>：有复出境申报、有合法内销记录、或有销毁/复出处置凭证。三者皆无的货物不得越过出区卡口。这是把红线从制度变成技术约束的最小实现。</p>\n<h2 id=\"序列号级追踪的实现要点\">序列号级追踪的实现要点</h2><h3 id=\"为什么必须是序列号\">为什么必须是序列号</h3><p>按批次或按型号追踪都不够。一批进境十台同型号设备，其中三台被卖给境内客户，批次管理只能告诉你&quot;这批有 30% 没出境&quot;，却指不出是哪三台、也无法在卡口拦住它们。<strong>序列号是唯一能把监管对象实例化的标识</strong>，也是第 3 章核销对账的匹配键。因此序列号的采集必须在进境申报时完成，并在整条链路上保持为必填。</p>\n<h3 id=\"状态机与转移白名单\">状态机与转移白名单</h3><p>序列号的状态转移要显式建模，且只允许白名单内的转移。</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"ENTRY_DECLARED ──booked──▶ IN_LEDGER(待维修)&#10;IN_LEDGER ──open_wo──▶ IN_REPAIR&#10;IN_REPAIR ──complete──▶ FIXED ──reexport──▶ SHIPPED ✅&#10;IN_REPAIR ──unrepairable──▶ UNREPAIRABLE ──destroy──▶ DESTROYED ✅&#10;FIXED ──domestic_cleared──▶ SOLD_DOMESTIC ✅(需 domestic_sale_record)&#10;FIXED ──handover_to_domestic_customer──▶ ✖ 拒绝：无合法依据&#10;IN_LEDGER ──disassemble──▶ ✖ 拒绝：禁止借维修拆解报废\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>ENTRY_DECLARED ──booked──▶ IN_LEDGER(待维修)</span></span>\n<span class=\"line\"><span>IN_LEDGER ──open_wo──▶ IN_REPAIR</span></span>\n<span class=\"line\"><span>IN_REPAIR ──complete──▶ FIXED ──reexport──▶ SHIPPED ✅</span></span>\n<span class=\"line\"><span>IN_REPAIR ──unrepairable──▶ UNREPAIRABLE ──destroy──▶ DESTROYED ✅</span></span>\n<span class=\"line\"><span>FIXED ──domestic_cleared──▶ SOLD_DOMESTIC ✅(需 domestic_sale_record)</span></span>\n<span class=\"line\"><span>FIXED ──handover_to_domestic_customer──▶ ✖ 拒绝：无合法依据</span></span>\n<span class=\"line\"><span>IN_LEDGER ──disassemble──▶ ✖ 拒绝：禁止借维修拆解报废</span></span></code></pre></div><p>状态机里有两条边被显式标为拒绝：直接交付境内客户、以及拆解。把拒绝写成状态机的一部分，而不是写成一段业务逻辑判断，好处是<strong>不可能被绕过</strong>——任何状态转移都要过状态机，没有旁路。</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;transition_guard&quot;: {&#10;    &quot;from&quot;: &quot;FIXED&quot;,&#10;    &quot;to&quot;: &quot;SOLD_DOMESTIC&quot;,&#10;    &quot;requires&quot;: [&quot;domestic_sale_record.sale_id&quot;],&#10;    &quot;deny_reason&quot;: &quot;MISSING_DOMESTIC_CLEARANCE&quot;,&#10;    &quot;audit&quot;: {&#10;      &quot;record_actor&quot;: true,&#10;      &quot;record_evidence&quot;: true,&#10;      &quot;alert_on_attempt&quot;: true&#10;    }&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"transition_guard\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"FIXED\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SOLD_DOMESTIC\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"requires\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"domestic_sale_record.sale_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"deny_reason\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"MISSING_DOMESTIC_CLEARANCE\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"audit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"record_actor\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"record_evidence\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"alert_on_attempt\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>alert_on_attempt</code> 是一个常被省略但很有价值的字段。一次被拒绝的转移尝试本身就是风险信号——它说明有人在系统里试图走违规路径。把这类尝试记录下来并告警，比仅返回一个错误码更能发现潜在的内部风险。</p>\n<h2 id=\"在区时长与逾期滞留\">在区时长与逾期滞留</h2><h3 id=\"逾期的定义\">逾期的定义</h3><p>&quot;Moved 但没出境&quot;有两种状态：还在核销周期内（正常在制或在库）、以及超过核销周期仍未处置（逾期）。前者的时长监控是运营信号，后者才是合规问题。核销周期原则最长 1 年，大型装备可按合同有效期确定，因此逾期阈值不是固定值而应取自账册配置。</p>\n<h3 id=\"分层预警\">分层预警</h3><div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;aging_policy&quot;: {&#10;    &quot;book_id&quot;: &quot;LB-2026-0017&quot;,&#10;    &quot;cycle_end&quot;: &quot;2027-03-31&quot;,&#10;    &quot;thresholds&quot;: [&#10;      { &quot;ratio&quot;: 0.6, &quot;action&quot;: &quot;OPERATIONAL_REVIEW&quot;, &quot;note&quot;: &quot;在区货物超过周期 60%，检查工单积压&quot; },&#10;      { &quot;ratio&quot;: 0.85, &quot;action&quot;: &quot;MANAGER_ESCALATION&quot;, &quot;note&quot;: &quot;临近核销，逐台确认处置计划&quot; },&#10;      { &quot;ratio&quot;: 1.0, &quot;action&quot;: &quot;COMPLIANCE_ALERT&quot;, &quot;note&quot;: &quot;逾期未处置，须立即制定处置方案&quot; }&#10;    ],&#10;    &quot;excluded_from_aging&quot;: [&quot;SHIPPED&quot;, &quot;DESTROYED&quot;, &quot;SOLD_DOMESTIC&quot;]&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"aging_policy\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"book_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"LB-2026-0017\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"cycle_end\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2027-03-31\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"thresholds\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"ratio\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"action\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"OPERATIONAL_REVIEW\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"note\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"在区货物超过周期 60%，检查工单积压\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"ratio\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.85</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"action\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"MANAGER_ESCALATION\"</span><span style=\"color:#2429