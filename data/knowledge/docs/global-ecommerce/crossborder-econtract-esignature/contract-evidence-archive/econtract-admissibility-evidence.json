ki-dark:#9ECBFF\">\"CN=Example QTSP CA\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"serial\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"0x4a91...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"trust_list_service\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"granted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"svc_type\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"CA/QC\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"status_starting_time\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2024-03-01T00:00:00Z\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"chain_valid\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"revocation\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"kind\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"OCSP\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"result\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"GOOD\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"this_update\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-28T09:00:00Z\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"next_update\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-29T09:00:00Z\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"result\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"VALID\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"validation_notes\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"revocation data covers signing_time\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"timestamp_chain\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"level\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SIGNATURE\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"tsa\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tsa.example.org\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"gen_time\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-28T10:14:05Z\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"accuracy_ms\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"ordering\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"level\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ARCHIVE\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"tsa\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tsa.example.org\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"gen_time\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-28T10:20:01Z\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"anchor\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"batch_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"anc_2026_09_28_10\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"root_hash\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sha256:4b7e...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"audit_path_len\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">18</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"overall\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"VALID\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>三处细节值得强调。<strong>第一，<code>trust_list_service</code> 必须记录状态起始时间</strong>——验证时点必须落在该状态区间内，只写 <code>granted</code> 而不写时间会让验证失去时点语义（这一要求的原理见 <a href=\"../econtract-legal-framework/eidas-qualified-signature-level\">eIDAS 合格/高级电子签名等级</a>）。<strong>第二，吊销数据必须与 <code>signing_time</code> 比对并显式给出覆盖结论</strong>，而不是仅列出 <code>GOOD</code>。<strong>第三，<code>overall</code> 取 <code>VALID</code> 要求所有子项均为有效；任何一项为 <code>INDETERMINATE</code>，整体就不能是 <code>VALID</code>。</strong></p>\n<h3 id=\"认证声明\">认证声明</h3><p>认证声明是把技术报告转成法律语言的一页纸。它应当包含：作出声明的人及其资格、所依据的记录、记录生成系统的描述、验证所用的方法、以及可核验的标识（哈希值与时间戳）。声明应当避免两类问题：过度概括（&quot;该记录真实无误&quot;）与过度技术化（直接粘贴 JSON）。</p>\n<p>一份可用的声明结构是：陈述&quot;我是系统 X 的负责人，该系统执行流程 Y&quot;→ 说明&quot;记录 R 由该系统于流程 Y 中生成，其内容哈希为 H&quot;→ 说明&quot;哈希 H 已由 TSA Z 于时刻 T 加盖时间戳，验证方式为按 RFC 3161 校验令牌签名与消息摘要&quot;→ 给出&quot;随附的验签报告可通过如下步骤独立复现&quot;。每一步都可被对方独立验证，因而声明的力量来自可验证性而非声明的语气。</p>\n<h2 id=\"产出举证包的工程能力\">产出举证包的工程能力</h2><h3 id=\"一键导出背后的依赖\">一键导出背后的依赖</h3><p>&quot;一键导出举证包&quot;这个功能看似只是打包，实际上它是对全系统的一次完整性压力测试。要能跑通，以下条件必须同时满足：</p>\n<ul>\n<li>合同正文与快照内容仍在内容寻址存储中且未被清理（依赖封存机制）；</li>\n<li>长期验证数据在签署时已完整收集（依赖 <a href=\"esign-lifecycle-archive-retrieval\">签署-生效-归档生命周期与检索</a> 中的当场收集）；</li>\n<li>历史渲染器版本仍可运行，以完成快照还原（依赖渲染器版本的长期可运行性）；</li>\n<li>锚定证明可按批次取回且审计路径完整（依赖锚定层的独立存储）；</li>\n<li>授权链的历史快照可查（依赖 <code>frozen_valid_to</code> 等冻结字段）；</li>\n<li>信任列表的历史状态可获取（依赖 LOTL 与各国 TSL 的历史数据）。</li>\n</ul>\n<p>这六项里任何一项缺失，导出的包就不完整。因此<strong>应当定期运行一次端到端导出演练</strong>，随机抽取若干年前的合同，验证能否产出完整包。这个演练的价值在于它能在争议发生前发现缺陷，而不是在举证截止日期前才发现。</p>\n<h3 id=\"导出性能\">导出性能</h3><p>举证包导出通常有明确的时间要求（诉讼举证期限），但归档对象多在冷层。因此导出流程应当是异步的：先返回一个任务 ID 与预计完成时间，后台完成解冻与组装，再提供下载。对于紧急情形，应能先产出<strong>仅含哈希与时间戳证明的简版包</strong>（这部分始终在锚定层，秒级可取），完整包随后补充。这个两级交付设计在实务中很有价值：简版包已经足以在初期交涉中证明&quot;该合同已签署且内容未被改动&quot;。</p>\n<h2 id=\"交付前的自检清单\">交付前的自检清单</h2><p>把本文的要点收敛成一份可执行的清单，用于每次导出前核对，也用于新系统的设计评审：</p>\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"> 合同正文哈希可复算，且与快照哈希、锚定叶子哈希一致</li>\n<li><input disabled=\"\" type=\"checkbox\"> 条款快照能用当时的渲染器还原，且还原结果与存档正文一致</li>\n<li><input disabled=\"\" type=\"checkbox\"> 每份签名都有覆盖签署时点的吊销数据，且 <code>validation_notes</code> 明确说明覆盖关系</li>\n<li><input disabled=\"\" type=\"checkbox\"> 证书状态检查包含信任列表服务记录的状态起始时间</li>\n<li><input disabled=\"\" type=\"checkbox\"> 时间戳令牌的签名已验证，且签名证书带 <code>id-kp-timeStamping</code> 用途</li>\n<li><input disabled=\"\" type=\"checkbox\"> 哈希树的审计路径可完整取回，重算根与已签名树头一致</li>\n<li><input disabled=\"\" type=\"checkbox\"> 主体状态为签署时点的快照值，而非当前值</li>\n<li><input disabled=\"\" type=\"checkbox\"> 授权链快照含 <code>frozen_valid_to</code> 与 <code>frozen_scope</code>，且逐级有效期取交</li>\n<li><input disabled=\"\" type=\"checkbox\"> 同意记录含 <code>user_initiated_change</code> 与客户端证据，无默认勾选留下的空证据记录</li>\n<li><input disabled=\"\" type=\"checkbox\"> 行为日志未包含超出必要范围的用户数据</li>\n<li><input disabled=\"\" type=\"checkbox\"> 认证声明中的每一项断言都能被随附材料独立验证</li>\n<li><input disabled=\"\" type=\"checkbox\"> 举证包自身的哈希已被锚定</li>\n</ul>\n<h2 id=\"小结\">小结</h2><ul>\n<li>可采性分真实性、合法性、关联性三层，任一不过则后续论证无意义；最小化采集是可采性设计的一部分而非额外负担。</li>\n<li>FRE 902(13)(14) 允许以&quot;认证声明 + 哈希比对&quot;完成电子证据自证，但要求提前书面通知并可供查验，且只解决真实性（<a href=\"https://www.law.cornell.edu/rules/fre/rule_902\">FRE 902</a>）。</li>\n<li>大陆法系审查侧重&quot;正常业务活动中形成&quot;与&quot;中立第三方背书&quot;，因此当场收集与第三方锚定兼具技术与法律双重价值。</li>\n<li>举证包应为自包含单元并再次锚定，各材料须明确各自证明与不证明什么，避免出现证明力真空。</li>\n<li>验签报告必须包含信任列表服务的状态起始时间、吊销数据与签署时点的覆盖关系，且任一项不确定则整体不得为 <code>VALID</code>。</li>\n<li>一键导出依赖六项前提同时成立，应定期做端到端导出演练，在争议发生前而非举证期限前发现缺陷。</li>\n<li>导出应异步并支持&quot;简版包（哈希+时间戳）先行、完整包随后&quot;的两级交付。</li>\n<li>清单可作为回归测试使用：一次举证失败暴露的通常是更早期环节的建模缺陷，因而本文的检查项同时也是对 <a href=\"../contract-template-version/terms-snapshot-at-order-time\">订单快照</a>、<a href=\"../signature-strength-capacity/contracting-capacity-party-identity\">授权链</a> 与 <a href=\"../signature-strength-capacity/digital-certificate-eseal-issuance\">证书生命周期</a> 的整体验收。</li>\n</ul>\n","headings":[{"level":1,"text":"电子合同可采性与举证包","id":"电子合同可采性与举证包"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"可采性的三层门槛","id":"可采性的三层门槛"},{"level":3,"text":"美国联邦证据规则的两个自证条款","id":"美国联邦证据规则的两个自证条款"},{"level":3,"text":"中国法下的电子数据审查","id":"中国法下的电子数据审查"},{"level":2,"text":"举证包的组成","id":"举证包的组成"},{"level":3,"text":"一个自包含的证据单元","id":"一个自包含的证据单元"},{"level":3,"text":"验签报告","id":"验签报告"},{"level":3,"text":"认证声明","id":"认证声明"},{"level":2,"text":"产出举证包的工程能力","id":"产出举证包的工程能力"},{"level":3,"text":"一键导出背后的依赖","id":"一键导出背后的依赖"},{"level":3,"text":"导出性能","id":"导出性能"},{"level":2,"text":"交付前的自检清单","id":"交付前的自检清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"签署-生效-归档生命周期与检索","url":"/l-doc-books/h/global-ecommerce/crossborder-econtract-esignature/contract-evidence-archive/esign-lifecycle-archive-retrieval"},"next":null}