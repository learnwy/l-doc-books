dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"US_SALES\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"jurisdiction\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"US\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"role\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"operating\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"parent\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SG_OPS\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"functions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"local_sales\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"logistics\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"risk_assumed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"limited_credit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"substance_tier\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"local_operations\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"tax_note\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"federal_21pct; state_tax_separate\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"edges\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"HK_HOLD\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SG_OPS\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"type\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"equity\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"pct\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SG_OPS\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"US_SALES\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"type\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"equity\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"pct\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>三个字段值得单独说明。<code>role</code> 决定了实体在四流对齐中的默认位置——控股层不出现在货物买卖链条上。<code>substance_tier</code> 决定它每年要在实质申报上投入多少。<code>risk_assumed</code> 与功能画像模块里的 <code>risk_excluded</code> 必须互补，两者放在一起才能看出这家实体&quot;不是什么&quot;，而排除项往往比承担项更能说明架构意图。</p>\n<h2 id=\"布局设计的三条自检\">布局设计的三条自检</h2><p>在把区域布局定稿之前，有三条自检能挡掉多数结构性错误。</p>\n<p><strong>第一，每个实体能否用一句话说清它承担什么风险。</strong> 如果一句话说不清，说明功能定位还没完成，此时不应进入设立流程。功能定位的方法见 <a href=\"trading-entity-function-risk\">贸易主体功能与风险定位</a>。</p>\n<p><strong>第二，每笔跨实体支付能否对应一个已签协议。</strong> 股息、特许权使用费、服务费、利息、货物价款五类支付各自需要不同的协议基础与定价依据，缺协议的支付在稽查中会被直接重新定性。</p>\n<p><strong>第三，控股层是否只做控股。</strong> 一旦控股实体开始参与业务决策，它在功能上就与运营实体重叠，可能被认定为他国居民企业或构成常设机构。控股层保持&quot;只持股、不经营&quot;是它享受参股豁免的前提。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>区域布局本质是三类实体（控股、运营、结算）的职能切分，切分依据是税务、外汇与法律责任三组约束。</li>\n<li>选择辖区时要同时看名义税率、条约网络、资金流动、实质要求与合规成本，其中条约网络对股息路径的成本影响常常大于名义税率差异。</li>\n<li>香港 8.25%/16.5% 两级制建立在来源地原则之上，&quot;在哪注册&quot;不决定纳税义务，&quot;利润从哪里产生&quot;才决定。</li>\n<li>结算实体的职能边界最容易失控；一旦它承担库存或市场风险，功能画像与利润归属立刻错位。</li>\n<li>三条定稿自检：每个实体能一句话说清风险、每笔跨实体支付有协议、控股层只做控股。</li>\n</ul>\n<hr>\n<p><strong>延伸阅读（本 hub 内）</strong>：<a href=\"trading-entity-function-risk\">贸易主体功能与风险定位</a> 讲功能画像的方法；<a href=\"economic-substance-setup\">经济实质与实体设立要求</a> 讲实质测试；<a href=\"../pe-tp-entity-link/regional-settlement-profit\">区域结算/利润布局合规</a> 讲利润布局的税务约束。</p>\n","headings":[{"level":1,"text":"控股/运营/结算实体区域布局","id":"控股-运营-结算实体区域布局"},{"level":2,"text":"核心概念：三类实体的职能边界","id":"核心概念-三类实体的职能边界"},{"level":2,"text":"高频辖区的取舍维度","id":"高频辖区的取舍维度"},{"level":3,"text":"条约网络比名义税率更重要","id":"条约网络比名义税率更重要"},{"level":3,"text":"外汇与资金管制的现实约束","id":"外汇与资金管制的现实约束"},{"level":2,"text":"常见形态与它们的适用条件","id":"常见形态与它们的适用条件"},{"level":3,"text":"区域总部的功能与实质","id":"区域总部的功能与实质"},{"level":2,"text":"实体地图的结构化表达","id":"实体地图的结构化表达"},{"level":2,"text":"布局设计的三条自检","id":"布局设计的三条自检"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"贸易主体功能与风险定位","url":"/l-doc-books/h/global-ecommerce/global-entity-trade-structure/entity-footprint-design/trading-entity-function-risk"}}