dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">720</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"aggregate\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"aggregation_key\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"owner_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"category_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"level\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"value_thresholds\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"include_in_alert\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"detail_only_below\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"quiet_hours\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"start\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"20:00\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"end\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"08:00\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"timezone\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"location_local\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"exempt_levels\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"P1\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"escalation\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"needs_ack_within_hours\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"P1\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"P2\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">24</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"P3\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">168</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"escalate_to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"P1\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"category_manager\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"P2\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"category_lead\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"P3\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"owner_manager\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"max_escalation_depth\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"closure_requires\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"action_taken\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"evidence_ref\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"result_metric_recheck_days\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>location_local</code> 时区是跨境场景的必要配置：同一品类可能由不同国家的团队负责，静音窗口必须按<strong>仓位所在时区</strong>而不是系统时区判定。<code>closure_requires</code> 里的 <code>result_metric_recheck_days</code> 是把闭环真正闭合的关键——任务标记完成不等于问题解决，必须在一个周期后回看指标是否真的改善。</p>\n<h3 id=\"告警质量的自监控\">告警质量的自监控</h3><p>预警系统需要监控自己的健康度，三个指标：<strong>确认延迟</strong>（发出到确认的中位时长）、<strong>驳回率</strong>（责任人判定为误报的比例）、<strong>复发率</strong>（同对象 90 天内重复进入同一状态的比例）。驳回率是最有价值的信号——它直接告诉我们规则阈值是否过松。驳回率持续高于 20% 时应触发阈值重估，这条规则把「模型校准」从人工任务变成系统功能，与 <a href=\"../obsolete-excess-detect/slowmoving-deadstock-rule-alert\">呆滞规则</a> 的阈值学习形成闭环。</p>\n<h2 id=\"责任人归属模型\">责任人归属模型</h2><h3 id=\"归属的优先级\">归属的优先级</h3><p>责任人归属由三个变量决定，优先级从高到低：<strong>品类归属</strong>（该品类由谁负责）、<strong>仓位归属</strong>（该仓由谁负责）、<strong>兜底责任人</strong>（无人认领时的默认）。品类优先于仓位的原因是：库存问题的根因通常在品类策略（选品、定价、预测），而不在仓库运营。把缺货告警派给仓管是典型的归属错误——仓管无法改变需求预测。</p>\n<h3 id=\"代理与轮值\">代理与轮值</h3><p>责任人必须支持<strong>代理与轮值</strong>，否则休假期间的告警会全部堆积。代理关系应有明确的有效期与范围，且必须记录在案（谁在什么时间代理了谁），因为后续复盘需要知道当时的处置决策由谁做出。</p>\n<h3 id=\"无主告警的处理\">无主告警的处理</h3><p>跨境经营的常见情形是<strong>新品或新市场尚无明确责任人</strong>。这类告警必须有兜底路径：进入无主队列并每日提醒品类负责人，超过阈值时升级至供应链总监。无主队列的存在本身就是治理指标——无主告警占比高说明组织职责划分跟不上业务扩张。</p>\n<h2 id=\"闭环的验证\">闭环的验证</h2><h3 id=\"三件事才算闭环\">三件事才算闭环</h3><p>一条告警真正闭环需要<strong>三个证据同时存在</strong>：动作记录（做了什么）、结果指标（做完后指标如何）、复核结论（是否达到预期）。只有第一个的是「已处理未验证」，只有前两个的是「已验证未归档」。工程上要求 <a href=\"transfer-promotion-markdown-suggest\">建议层</a> 的 <code>suggestion_id</code> 与告警 <code>alert_id</code> 双向关联，这样任一方向都能追溯完整链路。</p>\n<h3 id=\"与健康度评分的互证\">与健康度评分的互证</h3><p>闭环质量本身应成为 <a href=\"../inventory-health-metric/health-score-redyellow-green\">库存健康度评分</a> 的扣分项之一：<strong>告警超期未处理数</strong>与<strong>盘点计划完成率</strong>同属流程健康度。这形成一个自增强回路——闭环做得差的品类评分被扣分，被扣分的品类进改善清单，改善清单推动闭环执行。缺少这个回路，告警系统就只是外挂的通知工具，与评分体系各自为政。</p>\n<h3 id=\"目标设定的一致性\">目标设定的一致性</h3><p>给责任人的处置目标应符合 <a href=\"https://en.wikipedia.org/wiki/SMART_criteria\">SMART criteria</a> 的五要素，尤其是 Measurable（「Quantifying, or at least suggesting, an indicator of progress」）与 Time-related（「Including a timeline for expected results」）。库存告警的 SLA 天然满足 Time-related，但常违反 Measurable——「尽快处理呆滞」不是目标，「14 天内将本品类呆滞金额降至 X 以下」才是。目标设定的模板应固化在告警任务里，让责任人接到任务时就有可衡量的完成标准。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>闭环预警的目标是提高单条告警的信息密度，不是提高覆盖率。</li>\n<li>责任人模型要有 R 与 A 的区分；库存告警的典型错误是有 R 无 A。</li>\n<li>告警分级由「金额影响 × 时效紧迫度」共同决定，P1/P2/P3 的送达、SLA、升级规则各不相同。</li>\n<li>推送由状态跃迁驱动，抑制靠冷却期 + 聚合 + 静音窗口，静音窗口按仓位本地时区判定。</li>\n<li>告警系统要自监控确认延迟、驳回率、复发率，驳回率超阈值触发规则重估。</li>\n<li>责任人归属品类优先于仓位，必须支持代理轮值与无主兜底队列。</li>\n<li>闭环需要动作、结果指标、复核结论三证据齐备，并与健康度评分的流程维度互相验证。</li>\n</ul>\n","headings":[{"level":1,"text":"库存预警推送与责任人闭环","id":"库存预警推送与责任人闭环"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"告警分级与聚合","id":"告警分级与聚合"},{"level":3,"text":"分级的两个维度","id":"分级的两个维度"},{"level":3,"text":"聚合规则","id":"聚合规则"},{"level":2,"text":"推送与抑制的工程实现","id":"推送与抑制的工程实现"},{"level":3,"text":"状态跃迁驱动而非快照驱动","id":"状态跃迁驱动而非快照驱动"},{"level":3,"text":"抑制三件套","id":"抑制三件套"},{"level":3,"text":"告警质量的自监控","id":"告警质量的自监控"},{"level":2,"text":"责任人归属模型","id":"责任人归属模型"},{"level":3,"text":"归属的优先级","id":"归属的优先级"},{"level":3,"text":"代理与轮值","id":"代理与轮值"},{"level":3,"text":"无主告警的处理","id":"无主告警的处理"},{"level":2,"text":"闭环的验证","id":"闭环的验证"},{"level":3,"text":"三件事才算闭环","id":"三件事才算闭环"},{"level":3,"text":"与健康度评分的互证","id":"与健康度评分的互证"},{"level":3,"text":"目标设定的一致性","id":"目标设定的一致性"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"调拨/促销/清仓建议（建议层）","url":"/l-doc-books/h/global-ecommerce/inventory-health-obsolete-diagnosis/recommendation-dashboard/transfer-promotion-markdown-suggest"},"next":{"title":"品类/仓库健康看板与改善跟踪","url":"/l-doc-books/h/global-ecommerce/inventory-health-obsolete-diagnosis/recommendation-dashboard/inventory-health-category-dashboard"}}