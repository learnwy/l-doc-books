-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)                        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn_count,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">SUM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">net_amount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)              </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> base_amt,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">SUM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tax_amount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)              </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tax_amt,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tax_point_date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">date</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">          AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> original_period_ref</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tax_credit_notes c</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tax_transaction_facts f </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">original_fact_id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">issue_date</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> BETWEEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :period_from </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :period_to</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tax_point_date</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :period_from</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  GROUP BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tax_rate_code</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tax_point_date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">date</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'current'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bucket, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> current_txn</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UNION ALL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> SELECT</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'in_period_credit'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> in_period_credit</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UNION ALL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> SELECT</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'cross_period_credit'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cross_period_credit;</span></span></code></pre></div><p>三个 bucket 的分离是本段的核心：把&quot;本期交易&quot;&quot;本期红冲本期原票&quot;&quot;本期红冲历史原票&quot;分开统计，就能按辖区规则决定第三桶是并入本期还是触发更正流程。把它们混在一个 <code>SUM</code> 里，跨期红冲会被静默地按本期处理——这在要求原期冲减的辖区是申报错误。</p>\n<h2 id=\"申报数据包与可复现性\">申报数据包与可复现性</h2><p>提交给税务机关的是一份数据包，包含申报表与支撑明细。明细必须与汇总绑定，因为稽查时最常见的问法是&quot;这个数字包含哪些交易&quot;。</p>\n<table>\n<thead>\n<tr>\n<th>产物</th>\n<th>内容</th>\n<th>价值</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>申报表</td>\n<td>按法定字段结构的汇总数</td>\n<td>提交对象</td>\n</tr>\n<tr>\n<td>明细清单</td>\n<td>构成每个汇总数的交易 ID 列表</td>\n<td>使数字可被解释</td>\n</tr>\n<tr>\n<td>生成参数</td>\n<td>期次、辖区、税号、规则版本、生成时间</td>\n<td>使结果可被复现</td>\n</tr>\n<tr>\n<td>提交回执</td>\n<td>受理编号、时间、渠道、原文</td>\n<td>举证与争议</td>\n</tr>\n<tr>\n<td>更正链</td>\n<td>后续更正及原因，与原申报关联</td>\n<td>使历史可被追踪</td>\n</tr>\n</tbody></table>\n<p>其中&quot;生成参数&quot;里的<strong>规则版本</strong>是与下一章的直接接口：若某个税率规则事后被判定有误，需要靠版本号判断哪些申报要更正，见 <a href=\"../indirect-tax-audit-rule-change/tax-rate-rule-change-sync\">税率规则变更的系统跟进</a>。缺少这个字段时，重算结果无法映射回已提交的申报表，只能整批重做。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>申报的本质是按规则折叠交易：归属时点、纳税期、税号归属、税率档、税基口径、红冲方向，六项都要显式化。</li>\n<li>归属时点不是单一日期：事实表必须保留交付、开票、收款多个时点，申报时按配置选择。</li>\n<li>纳税期是实体而非动态计算：频率变更会产生过渡期次，具体截止日必须存字段（节假日多不顺延）。</li>\n<li>税基按行按税率反推，混合税率订单不可对总额做一次除法。</li>\n<li>红冲必须区分&quot;本期冲本期&quot;与&quot;本期冲历史&quot;，后者按辖区规则走负项或更正流程。</li>\n<li>申报数据包必须包含明细清单与规则版本，否则数年后无法解释当时的申报。</li>\n</ul>\n","headings":[{"level":1,"text":"申报日历、税期与计税口径","id":"申报日历-税期与计税口径"},{"level":2,"text":"核心概念：申报是把逐笔交易折叠成一张表，折叠方式由规则决定","id":"核心概念-申报是把逐笔交易折叠成一张表-折叠方式由规则决定"},{"level":2,"text":"纳税期的构造与变更","id":"纳税期的构造与变更"},{"level":3,"text":"频率的确定与变更","id":"频率的确定与变更"},{"level":3,"text":"截止日的算法","id":"截止日的算法"},{"level":2,"text":"计税口径的三组选择","id":"计税口径的三组选择"},{"level":3,"text":"归属时点：交付、开票还是收款","id":"归属时点-交付-开票还是收款"},{"level":3,"text":"税基构成：运费、折扣与含税价","id":"税基构成-运费-折扣与含税价"},{"level":3,"text":"红冲方向：原期冲减还是本期单列","id":"红冲方向-原期冲减还是本期单列"},{"level":2,"text":"申报数据包与可复现性","id":"申报数据包与可复现性"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"税号生命周期管理与有效性校验","url":"/l-doc-books/h/global-ecommerce/crossborder-indirect-tax-registration-filing/indirect-tax-registration/tax-id-lifecycle-validation"},"next":{"title":"IOSS/OSS 等一站式简化机制","url":"/l-doc-books/h/global-ecommerce/crossborder-indirect-tax-registration-filing/periodic-filing-remittance/ioss-oss-simplified-scheme"}}