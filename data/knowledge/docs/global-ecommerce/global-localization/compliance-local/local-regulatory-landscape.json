">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> estimatedMitigationCost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computeRiskMatrix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  assessment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RiskAssessment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> priority</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> score</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> assessment.dimensions</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      name: d.name,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      score: d.likelihood </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d.impact,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      priority: d.likelihood </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d.impact </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 6</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'critical'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d.likelihood </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d.impact </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'high'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'medium'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.score);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>风险类型</th>\n<th>典型场景</th>\n<th>最大影响</th>\n<th>预防成本</th>\n<th>发生后成本</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数据泄露</td>\n<td>GDPR 违规</td>\n<td>营收 4% 罚款</td>\n<td>$50K/年</td>\n<td>$1M+</td>\n</tr>\n<tr>\n<td>税务违规</td>\n<td>漏报 VAT</td>\n<td>补税+罚息</td>\n<td>$20K/年</td>\n<td>$200K+</td>\n</tr>\n<tr>\n<td>产品安全</td>\n<td>不合规产品召回</td>\n<td>全品下架</td>\n<td>$30K 认证</td>\n<td>$500K+</td>\n</tr>\n<tr>\n<td>广告违规</td>\n<td>虚假宣传</td>\n<td>禁止销售</td>\n<td>$10K 审核</td>\n<td>$100K+</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>全球电商法规高度碎片化，欧盟最严格，美国联邦-州双轨制最复杂</li>\n<li>合规是市场进入的前置条件，违规成本远高于合规投入</li>\n<li>GDPR、DSA、VAT 是欧盟市场的三大合规重点</li>\n<li>美国市场需要同时满足联邦法规和各州隐私法的不同要求</li>\n<li>系统化的合规风险评估覆盖法律、运营和声誉三个维度</li>\n<li>建立专职合规团队或与本地法律顾问合作是长期经营的必要投资</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li><a href=\"../compliance-local/data-privacy-compliance\">数据保护与隐私合规</a>：隐私合规是法规概览中 GDPR/DSA 模块的深入展开。</li>\n<li><a href=\"../compliance-local/tax-customs\">跨境税务与关税</a>：VAT/关税是法规概览中财务影响最直接的合规领域。</li>\n<li><a href=\"../../compliance-tax-legal/legal-risk-management/platform-policy-compliance\">平台政策合规</a>：平台规则是与法定法规并行的另一合规来源。</li>\n</ul>\n","headings":[{"level":1,"text":"本地法规概览","id":"本地法规概览"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"主要市场法规框架","id":"主要市场法规框架"},{"level":2,"text":"合规风险评估","id":"合规风险评估"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"消费者保护合规","url":"/l-doc-books/h/global-ecommerce/global-localization/compliance-local/consumer-protection-local"},"next":{"title":"数据本地化","url":"/l-doc-books/h/global-ecommerce/global-localization/compliance-local/data-localization"}}