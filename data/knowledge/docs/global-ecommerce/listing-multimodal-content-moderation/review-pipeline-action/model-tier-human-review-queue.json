n class=\"vlist\" style=\"height:0.648em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3263em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.3263em;vertical-align:-1.5763em;\"></span><span class=\"minner munder\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.75em;\"><span style=\"top:-1.4237em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord cjk_fallback mtight\">影响面</span></span></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"minner munder\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.75em;\"><span class=\"svg-align\" style=\"top:-2.102em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"stretchy\" style=\"height:0.548em;min-width:1.6em;\"><span class=\"brace-left\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMinYMin slice\"><path d=\"M0 6l6-6h17c12.688 0 19.313.3 20 1 4 4 7.313 8.3 10 13\n 35.313 51.3 80.813 93.8 136.5 127.5 55.688 33.7 117.188 55.8 184.5 66.5.688\n 0 2 .3 4 1 18.688 2.7 76 4.3 172 5h399450v120H429l-6-1c-124.688-8-235-61.7\n-331-161C60.687 138.7 32.312 99.3 7 54L0 41V6z\"/></svg></span><span class=\"brace-center\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMidYMin slice\"><path d=\"M199572 214\nc100.7 8.3 195.3 44 280 108 55.3 42 101.7 93 139 153l9 14c2.7-4 5.7-8.7 9-14\n 53.3-86.7 123.7-153 211-199 66.7-36 137.3-56.3 212-62h199568v120H200432c-178.3\n 11.7-311.7 78.3-403 201-6 8-9.7 12-11 12-.7.7-6.7 1-18 1s-17.3-.3-18-1c-1.3 0\n-5-4-11-12-44.7-59.3-101.3-106.3-170-141s-145.3-54.3-229-60H0V214z\"/></svg></span><span class=\"brace-right\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMaxYMin slice\"><path d=\"M399994 0l6 6v35l-6 11c-56 104-135.3 181.3-238 232-57.3\n 28.7-117 45-179 50H-300V214h399897c43.3-7 81-15 113-26 100.7-33 179.7-91 237\n-174 2.7-5 6-9 10-13 .7-1 7.3-1 20-1h17z\"/></svg></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mop\">lo<span style=\"margin-right:0.0139em;\">g</span></span><span class=\"mopen\">(</span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">impressions</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.242em;\"><span style=\"top:-2.4559em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">7</span><span class=\"mord mathnormal mtight\">d</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2441em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.898em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.5763em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.9069em;vertical-align:-1.4763em;\"></span><span class=\"minner munder\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4306em;\"><span style=\"top:-1.5237em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord cjk_fallback mtight\">时效权重</span></span></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"minner munder\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4306em;\"><span class=\"svg-align\" style=\"top:-2.202em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"stretchy\" style=\"height:0.548em;min-width:1.6em;\"><span class=\"brace-left\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMinYMin slice\"><path d=\"M0 6l6-6h17c12.688 0 19.313.3 20 1 4 4 7.313 8.3 10 13\n 35.313 51.3 80.813 93.8 136.5 127.5 55.688 33.7 117.188 55.8 184.5 66.5.688\n 0 2 .3 4 1 18.688 2.7 76 4.3 172 5h399450v120H429l-6-1c-124.688-8-235-61.7\n-331-161C60.687 138.7 32.312 99.3 7 54L0 41V6z\"/></svg></span><span class=\"brace-center\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMidYMin slice\"><path d=\"M199572 214\nc100.7 8.3 195.3 44 280 108 55.3 42 101.7 93 139 153l9 14c2.7-4 5.7-8.7 9-14\n 53.3-86.7 123.7-153 211-199 66.7-36 137.3-56.3 212-62h199568v120H200432c-178.3\n 11.7-311.7 78.3-403 201-6 8-9.7 12-11 12-.7.7-6.7 1-18 1s-17.3-.3-18-1c-1.3 0\n-5-4-11-12-44.7-59.3-101.3-106.3-170-141s-145.3-54.3-229-60H0V214z\"/></svg></span><span class=\"brace-right\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMaxYMin slice\"><path d=\"M399994 0l6 6v35l-6 11c-56 104-135.3 181.3-238 232-57.3\n 28.7-117 45-179 50H-300V214h399897c43.3-7 81-15 113-26 100.7-33 179.7-91 237\n-174 2.7-5 6-9 10-13 .7-1 7.3-1 20-1h17z\"/></svg></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0269em;\">w</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0269em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">channel</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.798em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.4763em;\"><span></span></span></span></span></span></span></span></span></span></div><p><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>log</mi><mo>⁡</mo></mrow><annotation encoding=\"application/x-tex\">\\log</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mop\">lo<span style=\"margin-right:0.0139em;\">g</span></span></span></span></span></span> 压缩的作用是避免头部爆款商品垄断整个队列——一个百万曝光的商品按线性计入会永远排在第一位，而 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>log</mi><mo>⁡</mo></mrow><annotation encoding=\"application/x-tex\">\\log</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mop\">lo<span style=\"margin-right:0.0139em;\">g</span></span></span></span></span></span> 让它与其他高曝光商品可比。<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>w</mi><mtext>channel</mtext></msub></mrow><annotation encoding=\"application/x-tex\">w_{\\text{channel}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0269em;\">w</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0269em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">channel</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 区分同步通道（发布前，权重高）与异步通道（巡检，权重低）。</p>\n<h3 id=\"队列的容量与积压\">队列的容量与积压</h3><p>队列是一个需要显式容量管理的资源。当入库速率超过复核速率时，队列会积压，而积压的后果是不对称的：发布前的样本积压会阻塞商家，发布后的样本积压会让违规内容多存活一段时间。因此队列必须有<strong>背压机制</strong>——当积压超过某个水位时，自动收紧上游的入队条件。</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE review_queue_item (&#10;  item_id       BIGINT PRIMARY KEY,&#10;  asset_id      BIGINT       NOT NULL,&#10;  shop_id       BIGINT       NOT NULL,&#10;  priority      DECIMAL(12,4) NOT NULL,   -- 计算所得排序分&#10;  channel       VARCHAR(16)  NOT NULL,    -- &#39;pre_publish&#39; | &#39;patrol&#39;&#10;  reason_codes  JSON         NOT NULL,    -- 命中的规则与模型标签&#10;  enqueued_at   TIMESTAMP    NOT NULL,&#10;  sla_deadline  TIMESTAMP    NOT NULL,    -- 渠道决定的时限&#10;  claimed_by    BIGINT,                   -- 复核员，NULL 即未领取&#10;  decided_at    TIMESTAMP,&#10;  decision      VARCHAR(16)               -- &#39;violation&#39; | &#39;clean&#39; | &#39;escalate&#39;&#10;);&#10;&#10;CREATE INDEX idx_queue_claim&#10;  ON review_queue_item (channel, claimed_by, priority DESC)&#10;  WHERE claimed_by IS NULL;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> review_queue_item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  item_id       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  asset_id      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">       NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  shop_id       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">       NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  priority      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 计算所得排序分</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  channel       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 'pre_publish' | 'patrol'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  reason_codes  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">JSON</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">         NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 命中的规则与模型标签</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  enqueued_at   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMP</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">    NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sla_deadline  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMP</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">    NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 渠道决定的时限</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  claimed_by    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,                   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 复核员，NULL 即未领取</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  decided_at    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  decision      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)               </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 'violation' | 'clean' | 'escalate'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> idx_queue_claim</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> review_queue_item (channel, claimed_by, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">priority DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> claimed_by </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p><code>sla_deadline</code> 与 <code>priority</code> 分开存储是刻意的：排序决定复核顺序，时限决定是否已经超期需要升级。两者不能混成一个字段，否则超期的低优先级样本永远不会被发现。<code>reason_codes</code> 保存命中的违规原因，它有两个关键用途——复核员需要知道该看什么，而模型迭代需要知道这条被判无违规的样本当初是被哪条规则误召回的。</p>\n<h3 id=\"抽检与随机样本的作用\">抽检与随机样本的作用</h3><p>除了灰区样本，队列里还必须有<strong>随机抽检样本</strong>——从低置信度放行的素材中按固定比例随机抽取。它们的作用不是抓违规（命中率极低），而是<strong>估计漏放率</strong>：只有随机样本才能给出放行集合中真实违规率的无偏估计。没有这一路样本，系统的漏放情况完全不可观测。抽检比例与漏放率估计的关系统一在 <a href=\"../moderation-accuracy-ops/moderation-precision-falseneg\">4.2 审核精确率/漏放/误杀度量</a> 中展开。</p>\n<h2 id=\"复核员的界面与反馈闭环\">复核员的界面与反馈闭环</h2><h3 id=\"复核需要的是证据而非分数\">复核需要的是证据而非分数</h3><p>复核员看到的界面决定了复核的质量与速度。只显示一个 0.71 的分数会让复核员无从下手；应该显示的是<strong>当初触发判定的具体证据</strong>——命中的规则、命中的文本片断、被框出的图像区域、视频的时间戳。这正是第 1、2 章要求把 <code>box_polygon</code>、<code>match_span</code>、<code>time_range_ms</code> 落库的原因：这些字段的唯一消费者就是复核界面与申诉通知，它们是判定可解释性的物理载体。</p>\n<h3 id=\"复核结论必须反哺\">复核结论必须反哺</h3><p>人工复核的结论是<strong>最昂贵的标注数据</strong>，因为它是人类专家对边界样本的判断。这条数据流必须双向使用：正向用于训练模型（灰区样本的硬标签正是模型最需要的），反向用于校准阈值（复核确认无违规的样本构成误杀集，用于调整 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>θ</mi><mtext>review</mtext></msub></mrow><annotation encoding=\"application/x-tex\">\\theta_{\\text{review}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">θ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3175em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">review</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>）。如果复核结论只用于当下的处置决定而不回流到模型与阈值，人审成本就只买到了单次判定，而没有买到系统能力的提升。</p>\n<p>这条反哺链路的有效性取决于反馈的时效与结构化程度。成熟的工业做法是把每次复核落成一条带标签、带原因码、带证据引用的记录，再按类目与规则聚合后批量回流——在线学习式的高频回流在审核场景下风险过高，因为单条复核结论可能带有复核员的主观偏差，需要聚合后再调整。这条链路的度量闭环见 <a href=\"../moderation-accuracy-ops/moderation-precision-falseneg\">4.2 审核精确率/漏放/误杀度量</a>。</p>\n<h3 id=\"复核质量本身也要被度量\">复核质量本身也要被度量</h3><p>复核员之间的判定一致性是可测量的，做法是<strong>交叉复核</strong>：让一部分样本被两名复核员独立判定，统计一致率。一致率低的规则通常是规则表述本身有歧义，需要重写而非更换复核员。这条度量与 <a href=\"../moderation-accuracy-ops/moderation-precision-falseneg\">4.2</a> 中的复核准确率指标是同一份数据。</p>\n<h2 id=\"与发布链路的分工\">与发布链路的分工</h2><p>分层结构的落点最终要与发布链路的时延预算对齐。发布前拦截只能使用<strong>能在等待窗口内完成</strong>的那部分判定——通常是轻量模型的快速判定加规则匹配；重模型、OCR、ASR、向量检索这些耗时环节放在发布后的异步通道，见 <a href=\"prepost-block-patrol-action\">3.2 发布前拦截与发布后巡检</a>。这个分工决定了分层的具体实现：同一套分层策略要在两个通道上各实例化一份，只是同步通道的 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>θ</mi><mtext>block</mtext></msub></mrow><annotation encoding=\"application/x-tex\">\\theta_{\\text{block}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">θ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">block</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 更高（只放行极高置信的拦截）、灰区更窄（因为同步人审容量极小）。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>机审分层的三个维度是置信度、严重度与可逆性；把严重度设为独立维度是为了处理&quot;低置信度但不可逆错误&quot;的样本，这类样本应无视置信度一律进人工。</li>\n<li>用似然比而非裸分数做灰区划分与队列排序，使不同模型、不同类目的输出可以在同一尺度上比较；似然比估计表需要随模型更新定期重估。</li>\n<li>队列优先级由似然比、影响面（用对数压缩避免爆款垄断）与时效权重相乘构成；任一维度为零则不紧急。</li>\n<li>队列需要显式容量管理与背压机制，<code>priority</code> 与 <code>sla_deadline</code> 必须分开存储，否则超期的低优先级样本永远不被发现。</li>\n<li>队列必须包含随机抽检样本，它命中率虽低，却是估计放行集合中真实违规率（漏放率）的唯一无偏来源。</li>\n<li>复核界面应显示触发判定的具体证据（规则、文本片断、图像区域、时间戳），这要求前两章把相应字段落库；复核结论必须双向反哺模型训练与阈值校准，并可用交叉复核度量规则歧义。</li>\n</ul>\n","headings":[{"level":1,"text":"机审模型分层与人审复核队列","id":"机审模型分层与人审复核队列"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"三层结构不是三层就够","id":"三层结构不是三层就够"},{"level":3,"text":"严重度必须独立于置信度","id":"严重度必须独立于置信度"},{"level":3,"text":"似然比优于裸分数","id":"似然比优于裸分数"},{"level":2,"text":"人审队列的设计","id":"人审队列的设计"},{"level":3,"text":"优先级的三个输入","id":"优先级的三个输入"},{"level":3,"text":"队列的容量与积压","id":"队列的容量与积压"},{"level":3,"text":"抽检与随机样本的作用","id":"抽检与随机样本的作用"},{"level":2,"text":"复核员的界面与反馈闭环","id":"复核员的界面与反馈闭环"},{"level":3,"text":"复核需要的是证据而非分数","id":"复核需要的是证据而非分数"},{"level":3,"text":"复核结论必须反哺","id":"复核结论必须反哺"},{"level":3,"text":"复核质量本身也要被度量","id":"复核质量本身也要被度量"},{"level":2,"text":"与发布链路的分工","id":"与发布链路的分工"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"以图搜重/重复铺货与盗图识别","url":"/l-doc-books/h/global-ecommerce/listing-multimodal-content-moderation/multimodal-text-video/duplicate-listing-image-neardup"},"next":{"title":"发布前拦截与发布后巡检处置","url":"/l-doc-books/h/global-ecommerce/listing-multimodal-content-moderation/review-pipeline-action/prepost-block-patrol-action"}}