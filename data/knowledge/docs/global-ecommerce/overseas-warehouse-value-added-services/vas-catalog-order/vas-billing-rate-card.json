lass=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"line_code\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"LABEL_STOCK\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"uom\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"PCS\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"unit_price\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.03</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"line_code\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"DE_LABEL\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"uom\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"PCS\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"unit_price\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.08</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"line_code\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SETUP\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"uom\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"TIME\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"unit_price\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">25.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"effective_from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-07-01\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"effective_to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-12-31\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"最低消费与附加费\">最低消费与附加费</h3><p>最低消费保护仓库不被小单淹没，附加费覆盖非常规情况：加急、非工作时间、超规件、危品。附加费必须做成可枚举的结构化字段而不是备注，否则无法自动出账。加急费通常按行项金额的百分比或固定额收，两者取高是常见的合同写法。</p>\n<h2 id=\"计费事件的产生时点\">计费事件的产生时点</h2><h3 id=\"完成即计费与月度汇总\">完成即计费与月度汇总</h3><p>两种时点各有取舍。完成即计费让账务实时、客户可查，但返工与冲正会更频繁；月度汇总减少小额调整，但客户对账滞后。多数仓网采用完成即计费加月度对账确认。计费事件在工单进入 <code>COMPLETED</code> 时产生，携带工单 ID、行项、数量、费率卡版本。费率卡版本必须随事件冻结——月度中途调价时，事件按发生日的费率计价，汇总时不做回溯。</p>\n<h3 id=\"冲正与调整单\">冲正与调整单</h3><p>任何计费错误都不得直接修改历史事件，必须通过调整单冲正。调整单携带被冲正事件 ID、冲正金额、原因码。这个不可变事件流的设计让对账可审计，也是客户争议处理的基础。缺少原因码的调整会在季度复盘时变成无法解释的账目。</p>\n<h3 id=\"预授权与额度\">预授权与额度</h3><p>跨境客户常采用预付余额或信用额度。工单确认时需要校验额度并在必要时预授权，作业完成后按实际量结算。预授权金额与实结金额的差异要能自动释放，否则客户额度会被长期占用。</p>\n<h2 id=\"对账与争议闭环\">对账与争议闭环</h2><p>对账的核心是<strong>可解释性</strong>：客户看到账单必须能下钻到工单、再下钻到作业证据（照片、时间戳、操作员）。如果账单只能到月度总额，争议永远无法关闭。对账流程应支持按服务变体、按 SKU、按时间三维切片，差异超过阈值时自动生成争议工单并挂起对应金额。</p>\n<p>账单下钻要能到作业证据，这对证据的可检索性提出了要求。质检类作业的照片与判定结果必须按工单号可预测地组织，具体的最小证据集与冷热分层策略见 <a href=\"../kitting-repack-qc/inspection-grade-photo-qc\">质检/分级/拍照与合格判定</a> 中对证据链的设计。当客户拒付某笔质检费时，能立刻调出该工单的缺陷特写照片与判定依据，是争议快速关闭的唯一方式。</p>\n<p>计价口径本身也必须唯一。目录版本与费率版本的选择时点必须一致，这一点在 <a href=\"vas-service-catalog-sku\">VAS 服务目录与可作业 SKU</a> 中已经点明——目录按订单创建日选版本、费率按作业完成日选版本，会在调价窗口产生系统性差异。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>费率卡的每条行项对应一个作业活动池，用作业成本法的逻辑归集资源消耗。</li>\n<li>计价单位有按件、按次、按工时、按重/体积四种，每种都有必须写明的边界定义。</li>\n<li>按件计价必须绑死「件」的层级；按工时计价必须扣除等待时长。</li>\n<li>阶梯量价优先用超额累进，避免阈值悬崖；最低消费与附加费必须结构化。</li>\n<li>计费事件在工单完成时产生并冻结费率版本，修改一律走调整单与原因码。</li>\n<li>返工要按归因决定是否收费：客户信息错误收费，仓库差错内部承担。</li>\n<li>对账必须可下钻到作业证据；计价口径与目录版本时点必须一致。</li>\n</ul>\n","headings":[{"level":1,"text":"VAS 计费与费率卡","id":"vas-计费与费率卡"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"计价单位的四种形态","id":"计价单位的四种形态"},{"level":3,"text":"按件计价","id":"按件计价"},{"level":3,"text":"按次计价","id":"按次计价"},{"level":3,"text":"按工时计价","id":"按工时计价"},{"level":3,"text":"按重量/体积计价","id":"按重量-体积计价"},{"level":2,"text":"费率卡的数据结构","id":"费率卡的数据结构"},{"level":3,"text":"行项与匹配维度","id":"行项与匹配维度"},{"level":3,"text":"阶梯量价","id":"阶梯量价"},{"level":3,"text":"最低消费与附加费","id":"最低消费与附加费"},{"level":2,"text":"计费事件的产生时点","id":"计费事件的产生时点"},{"level":3,"text":"完成即计费与月度汇总","id":"完成即计费与月度汇总"},{"level":3,"text":"冲正与调整单","id":"冲正与调整单"},{"level":3,"text":"预授权与额度","id":"预授权与额度"},{"level":2,"text":"对账与争议闭环","id":"对账与争议闭环"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"VAS 作业工单与作业指令","url":"/l-doc-books/h/global-ecommerce/overseas-warehouse-value-added-services/vas-catalog-order/vas-work-order-instruction"},"next":{"title":"当地语/合规标签贴标整改（联182）","url":"/l-doc-books/h/global-ecommerce/overseas-warehouse-value-added-services/labeling-relabeling/local-compliance-label-apply"}}