292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"logo_typography\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"genuine\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"标准字重与字距\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"suspect\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"字距压缩 8%\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"evidence\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"photo-01.jpg\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"feature\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"stitching\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"genuine\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"双线密缝\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"suspect\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"单线疏缝\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"evidence\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"photo-02.jpg\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"feature\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"serial\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"genuine\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"可查防伪码\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"suspect\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"码段不存在\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"evidence\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"verify-log.json\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"prior_records\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"CUS-DET-2025-YYYY\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"CN-Judgment-2025-####\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"submitted_at\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-09-28\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>prior_records</code> 是这类材料里权重最高的一块。同一侵权方的在先扣留或判决记录，能显著降低海关对「侵权事实明显存在」的认定门槛——这也是为什么品牌保护团队要把每一次扣留记录沉淀下来，而不是结案即归档。</p>\n<h2 id=\"通知环节的时间预算\">通知环节的时间预算</h2><p>从收到扣留通知到需要提交材料，可用时间通常很短。一条可操作的预算线：</p>\n<ul>\n<li>第 0 天：收到通知，确认适用路径（依职权还是依申请）与法定期限。</li>\n<li>第 1 天：联系境内代理确认联系人与担保工具状态。</li>\n<li>第 2 天：整理权利基础与侵权比对材料。</li>\n<li>第 3 天（依职权路径）：提交扣留申请与担保，完成回应。</li>\n</ul>\n<p>把这三天的动作预先写成清单并指定责任人，是唯一能可靠命中窗口的办法。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>扣留通知是双向的，收发货人一旦被通知即获得异议与陈述申辩的起点；送达争议是首个常见争点。</li>\n<li>异议针对扣留措施，陈述申辩针对实体是否侵权，两者材料不同，需分别准备。</li>\n<li>在部分程序（如欧盟销毁程序与小件货物程序）中沉默被推定为同意；沉默不等于维持现状。</li>\n<li>收发货人的抗辩分三类：权属授权、权利瑕疵、程序担保；程序抗辩最高效。</li>\n<li>陈述申辩材料按「权利基础—侵权比对—证据印证」组织，在先记录权重最高。</li>\n<li>从通知到提交只有几天，必须预设清单与责任人。</li>\n</ul>\n","headings":[{"level":1,"text":"收发货人通知、异议与陈述申辩","id":"收发货人通知-异议与陈述申辩"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"通知义务的双向结构","id":"通知义务的双向结构"},{"level":3,"text":"送达为什么容易出问题","id":"送达为什么容易出问题"},{"level":2,"text":"收发货人的程序权利清单","id":"收发货人的程序权利清单"},{"level":2,"text":"沉默的推定效力","id":"沉默的推定效力"},{"level":2,"text":"收发货人的三类常见抗辩","id":"收发货人的三类常见抗辩"},{"level":3,"text":"权属与授权抗辩","id":"权属与授权抗辩"},{"level":3,"text":"权利瑕疵抗辩","id":"权利瑕疵抗辩"},{"level":3,"text":"程序与担保抗辩","id":"程序与担保抗辩"},{"level":2,"text":"陈述申辩材料的组织","id":"陈述申辩材料的组织"},{"level":2,"text":"通知环节的时间预算","id":"通知环节的时间预算"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"依职权扣留与依申请扣留：两条路径的选择与时限","url":"/l-doc-books/h/global-ecommerce/customs-ip-border-recordal-enforcement/border-detention-process/exofficio-vs-application-detention"},"next":{"title":"权利人保证金与收发货人反担保","url":"/l-doc-books/h/global-ecommerce/customs-ip-border-recordal-enforcement/border-detention-process/right-holder-bond-counterbond"}}