list-r\"><span class=\"vlist\" style=\"height:0.1645em;\"><span style=\"top:-2.357em;margin-left:-0.0278em;margin-right:0.0714em;\"><span class=\"pstrut\" style=\"height:2.5em;\"></span><span class=\"sizing reset-size3 size1 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.143em;\"><span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2501em;\"><span></span></span></span></span></span></span><span class=\"mord\">∥</span><span class=\"mord\"><span class=\"mord mathnormal\">h</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">ℓ</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">h</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9484em;\"><span style=\"top:-2.3987em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">ℓ</span></span></span><span style=\"top:-3.1809em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">orig</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3013em;\"><span></span></span></span></span></span></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mord\"><span class=\"mord\">∥</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8641em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9493em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.6276em;\"><span></span></span></span></span></span></span></span></span></span></div><p>其中 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>h</mi><mi mathvariant=\"normal\">ℓ</mi></msub></mrow><annotation encoding=\"application/x-tex\">h_\\ell</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">h</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">ℓ</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 是第 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">ℓ</mi></mrow><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord\">ℓ</span></span></span></span></span> 层激活，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>u</mi></mrow><annotation encoding=\"application/x-tex\">u</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">u</span></span></span></span></span> 是固定的随机单位向量，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>c</mi></mrow><annotation encoding=\"application/x-tex\">c</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">c</span></span></span></span></span> 是缩放系数。直觉是：把危险概念在模型内部的表示「打乱成噪声」，模型就算权重里还残留相关信息，也调取不出连贯的输出。RMU 在 WMDP 这类危险能力清除任务上表现突出，是 2024 年 WMDP 基准论文一并提出的方法，相关评测见 <a href=\"../practice/unlearning-evaluation\">遗忘评测</a>。</p>\n<h2 id=\"三种方法的取舍\">三种方法的取舍</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[近似遗忘:在权重上原地动手] --&gt; B[梯度上升 GA]&#10;    A --&gt; C[负偏好优化 NPO]&#10;    A --&gt; D[表示误导 RMU]&#10;    B --&gt; B1[最直接&lt;br/&gt;损失无界易发散]&#10;    C --&gt; C1[有界损失自动刹车&lt;br/&gt;稳定性好]&#10;    D --&gt; D1[改隐藏激活&lt;br/&gt;擅长概念级清除]&#10;    B1 --&gt; E[需保留项约束]&#10;    C1 --&gt; E&#10;    D1 --&gt; E&#10;    E --&gt; F[共同张力:遗忘越狠 效用越伤]\">flowchart TD\n    A[近似遗忘:在权重上原地动手] --&gt; B[梯度上升 GA]\n    A --&gt; C[负偏好优化 NPO]\n    A --&gt; D[表示误导 RMU]\n    B --&gt; B1[最直接&lt;br/&gt;损失无界易发散]\n    C --&gt; C1[有界损失自动刹车&lt;br/&gt;稳定性好]\n    D --&gt; D1[改隐藏激活&lt;br/&gt;擅长概念级清除]\n    B1 --&gt; E[需保留项约束]\n    C1 --&gt; E\n    D1 --&gt; E\n    E --&gt; F[共同张力:遗忘越狠 效用越伤]</pre><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>动手层面</th>\n<th>稳定性</th>\n<th>最适场景</th>\n<th>主要弱点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>梯度上升 GA</td>\n<td>输出损失</td>\n<td>差，易发散</td>\n<td>小规模、有保留项约束</td>\n<td>灾难性遗忘</td>\n</tr>\n<tr>\n<td>NPO</td>\n<td>输出损失</td>\n<td>好，损失有界</td>\n<td>样本级遗忘（如 TOFU）</td>\n<td>仍可能被重学习恢复</td>\n</tr>\n<tr>\n<td>RMU</td>\n<td>隐藏表示</td>\n<td>中等</td>\n<td>概念级危险能力（如 WMDP）</td>\n<td>调参敏感、可能伤通用能力</td>\n</tr>\n</tbody></table>\n<p>一个反复被验证的经验是：在 <a href=\"../practice/membership-attacks\">成员推断验证</a> 会讲到的重学习攻击下，这三种方法都不同程度地脆弱——遗忘后只要在少量遗忘集样本上微调几步，被压下去的记忆往往原样回弹。2025 年的研究还发现一个反直觉现象：用更简单的优化器、更朴素的损失（如 SimNPO 对 NPO 的简化）反而往往更抗重学习。这暗示「遗忘得深」与「损失设计得花哨」并不正相关，简单稳健常常胜出。</p>\n<h2 id=\"为什么近似方法天然需要验证\">为什么近似方法天然需要验证</h2><p>梯度上升族的根本特征，是它们只保证「在可观测行为上像遗忘了」，给不出 <a href=\"../exact/exact-guarantees\">精确遗忘保证</a> 那样的分布等价。模型在 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>D</mi><mi>f</mi></msub></mrow><annotation encoding=\"application/x-tex\">D_f</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">D</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 上回答错了，可能是真删了相关参数，也可能只是被这几步梯度临时压住、信息仍蛰伏在权重里。这道理论与现实的鸿沟，正是为什么近似方法离不开下游的经验验证——没有验证的近似遗忘，等于一句无法兑现的承诺。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>梯度上升遗忘的直觉是「反向训练」：在遗忘集上最大化损失，但交叉熵无上界会导致发散。</li>\n<li>实用形式必须加保留项 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>+</mo><mi>λ</mi><mi mathvariant=\"script\">L</mi><mo stretchy=\"false\">(</mo><mi>θ</mi><mo separator=\"true\">;</mo><msub><mi>D</mi><mi>r</mi></msub><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">+\\lambda\\mathcal{L}(\\theta;D_r)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">+</span><span class=\"mord mathnormal\">λ</span><span class=\"mord mathcal\">L</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">θ</span><span class=\"mpunct\">;</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">D</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span></span>，把「遗忘质量 vs 模型效用」的矛盾写进损失。</li>\n<li>NPO 借 DPO 的有界损失给遗忘装上「自动刹车」，遗忘到位即梯度衰减，稳定性远胜朴素 GA。</li>\n<li>RMU 改在隐藏表示层动手，把危险概念的激活带偏成噪声，擅长 WMDP 式概念级清除。</li>\n<li>三族在重学习攻击下都脆弱；2025 年研究显示更简单的优化设计反而更抗恢复，故近似方法必须配经验验证。</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>本 hub 内：<a href=\"influence-based\">基于影响函数</a> 是另一条更有理论保证的近似路线；<a href=\"../practice/membership-attacks\">成员推断验证</a> 揭示这些方法为何会被重学习攻破。</li>\n<li>跨 hub：NPO 的偏好优化血缘见 <a href=\"../../rlhf-preference-alignment/direct-methods/dpo\">DPO 直接偏好优化</a>；表示层操纵与对齐的关系见 <a href=\"../../ai-safety-alignment/alignment-techniques/dpo-and-alternatives\">DPO 及替代方法</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"梯度上升遗忘","id":"梯度上升遗忘"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"朴素梯度上升与它的发散问题","id":"朴素梯度上升与它的发散问题"},{"level":2,"text":"NPO：把上界还给损失","id":"npo-把上界还给损失"},{"level":2,"text":"RMU：不在输出层而在表示层动手","id":"rmu-不在输出层而在表示层动手"},{"level":2,"text":"三种方法的取舍","id":"三种方法的取舍"},{"level":2,"text":"为什么近似方法天然需要验证","id":"为什么近似方法天然需要验证"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"精确遗忘保证","url":"/l-doc-books/h/ai-llm/machine-unlearning/exact/exact-guarantees"},"next":{"title":"基于影响函数","url":"/l-doc-books/h/ai-llm/machine-unlearning/approximate/influence-based"}}