"color:#6F42C1;--shiki-dark:#B392F0\"> sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(delay);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> response</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        headers: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          'User-Agent'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getRandomUA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          'Accept-Language'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'zh-CN,zh;q=0.9,en;q=0.8'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (response.status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 429</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(delay </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pow</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, attempt));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> parseResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url, response);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      markProxyFailed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(proxy, proxyConfig);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Failed to crawl ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">url</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} after ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">maxRetries</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} attempts`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"ai-抓取生态-robots-协商-llm-抽取与语料化采集\">AI 抓取生态：robots 协商、LLM 抽取与语料化采集</h2><p>生成式 AI 让抓取从纯粹的&quot;爬虫 vs 反爬&quot;对抗，演化为三层并存的生态：授权协商、语义抽取和面向语料的采集。</p>\n<p><strong>AI 爬虫的 robots 管理（双向视角）</strong> 主流 AI 厂商的爬虫不再只遵循笼统的 <code>User-agent: *</code> 规则，而是提供专属 robots token 让站长精细控制：</p>\n<ul>\n<li>OpenAI 官方 bots 文档定义了 GPTBot 等一组 robots.txt 标签，站长可以用它们管理自己内容是否被用于训练 OpenAI 的生成式模型或触发实时检索（platform.openai.com/docs/bots）</li>\n<li>Common Crawl 的 CCBot 提供 robots.txt 退出通道（<code>User-agent: CCBot / Disallow: /</code>），并以反向 DNS 验证 + 公开 IP 段 JSON 的方式帮助站长识别假冒 CCBot 的流量（commoncrawl.org/ccbot）</li>\n<li>Google 在官方爬虫文档中区分了用于搜索索引与用于 AI 训练/grounding 的爬虫控制方式，站长可分别设置</li>\n</ul>\n<p>作为<strong>采集方</strong>：自建 AI 数据管线时应声明真实 UA、遵守目标站的 AI 爬虫规则、在 robots.txt 框架内工作；作为<strong>站长方</strong>：为内容资产配置 AI 爬虫授权策略（全量允许 / 训练禁止 / 完全禁止）已成为 SEO 与数据治理的标准动作。双方都依赖&quot;身份可验证&quot;——UA 声明 + 反向 DNS 校验是当前识别 AI 爬虫的通行做法。</p>\n<p><strong>LLM 结构化抽取替代手写解析</strong> 传统路径要求为每个站点手写 CSS 选择器/XPath，页面改版即失效。LLM 抽取将&quot;理解页面结构&quot;交给模型：输入清洗后的页面文本或 DOM，配合 JSON Schema 约束输出，即可零样本完成字段抽取。代价是每页一次 LLM 调用的成本与延迟，因此生产中常用混合策略——高频站点保留手写解析器，长尾站点走 LLM 抽取，用小样本金标集对比两者的字段级准确率再路由：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[原始页面] --&gt; B[正文/DOM 清洗]&#10;    B --&gt; C{站点类型}&#10;    C --&gt;|高频核心站点| D[手写 CSS/XPath 解析器]&#10;    C --&gt;|长尾/新站点| E[LLM + JSON Schema 抽取]&#10;    D --&gt; F[结构化记录]&#10;    E --&gt; F&#10;    F --&gt; G{抽样校验}&#10;    G --&gt;|字段准确率达标| H[入库]&#10;    G --&gt;|不达标| I[人工修复解析器 / 调整 Prompt]&#10;    I --&gt; D&#10;    I --&gt; E\">graph TD\n    A[原始页面] --&gt; B[正文/DOM 清洗]\n    B --&gt; C{站点类型}\n    C --&gt;|高频核心站点| D[手写 CSS/XPath 解析器]\n    C --&gt;|长尾/新站点| E[LLM + JSON Schema 抽取]\n    D --&gt; F[结构化记录]\n    E --&gt; F\n    F --&gt; G{抽样校验}\n    G --&gt;|字段准确率达标| H[入库]\n    G --&gt;|不达标| I[人工修复解析器 / 调整 Prompt]\n    I --&gt; D\n    I --&gt; E</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface LlmExtractionTask {&#10;  pageContent: string;&#10;  schema: Record&lt;string, &#39;string&#39; | &#39;number&#39; | &#39;boolean&#39; | &#39;string[]&#39;&gt;;&#10;  instruction: string;&#10;  fallbackParser?: string;&#10;}&#10;&#10;interface ExtractionRoute {&#10;  route(domain: string, page: string): &#39;handwritten&#39; | &#39;llm&#39;;&#10;}&#10;&#10;async function extractStructured(&#10;  task: LlmExtractionTask,&#10;  route: ExtractionRoute,&#10;): Promise&lt;Record&lt;string, unknown&gt;&gt; {&#10;  if (route.route(parseDomain(task.pageContent), task.pageContent) === &#39;handwritten&#39; &amp;&amp; task.fallbackParser) {&#10;    return runLegacyParser(task.fallbackParser, task.pageContent);&#10;  }&#10;  return callLlmWithSchema({&#10;    prompt: `${task.instruction}\\n\\n${task.pageContent}`,&#10;    schema: task.schema,&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LlmExtractionTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  pageContent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  schema</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'string'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'number'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'boolean'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'string[]'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  instruction</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  fallbackParser</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ExtractionRoute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  route</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">domain</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'handwritten'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'llm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> extractStructured</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  task</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LlmExtractionTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  route</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ExtractionRoute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (route.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">route</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parseDomain</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(task.pageContent), task.pageContent) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'handwritten'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> task.fallbackParser) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> runLegacyParser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(task.fallbackParser, task.pageContent);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> callLlmWithSchema</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    prompt: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">task</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">instruction</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">task</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pageContent</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    schema: task.schema,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>面向语料的 Markdown 化采集</strong> 当目标是 LLM 训练/RAG 语料而非数据库记录时，采集产物从&quot;字段表&quot;变成&quot;干净文档&quot;。以 Firecrawl 为代表的一类服务直接把网页转为 Markdown/清洁文本输出（firecrawl.dev），省去模板维护；通用做法是&quot;正文抽取 → 转 Markdown → 去噪（导航/广告/脚本残留）→ 语言识别 → 去重&quot;，Markdown 的标题层级和列表结构天然保留了文档语义，比纯文本更利于后续切分与检索。</p>\n<h2 id=\"增量采集与变更检测\">增量采集与变更检测</h2><p>对于需要持续更新的数据源，增量采集比全量重新采集效率高出数十倍。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[数据源] --&gt; B{变更检测}&#10;    B --&gt;|Last-Modified| C[时间戳对比]&#10;    B --&gt;|ETag| D[内容哈希对比]&#10;    B --&gt;|Sitemap| E[索引文件解析]&#10;    B --&gt;|RSS/API| F[增量接口]&#10;    C --&gt; G{有变更?}&#10;    D --&gt; G&#10;    E --&gt; G&#10;    F --&gt; G&#10;    G --&gt;|是| H[增量采集]&#10;    G --&gt;|否| I[跳过]&#10;    H --&gt; J[差异计算]&#10;    J --&gt; K[更新存储]\">graph TD\n    A[数据源] --&gt; B{变更检测}\n    B --&gt;|Last-Modified| C[时间戳对比]\n    B --&gt;|ETag| D[内容哈希对比]\n    B --&gt;|Sitemap| E[索引文件解析]\n    B --&gt;|RSS/API| F[增量接口]\n    C --&gt; G{有变更?}\n    D --&gt; G\n    E --&gt; G\n    F --&gt; G\n    G --&gt;|是| H[增量采集]\n    G --&gt;|否| I[跳过]\n    H --&gt; J[差异计算]\n    J --&gt; K[更新存储]</pre><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>适用场景</th>\n<th>优势</th>\n<th>劣势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间戳对比</td>\n<td>支持 Last-Modified 的网站</td>\n<td>简单高效</td>\n<td>部分网站不支持</td>\n</tr>\n<tr>\n<td>内容哈希</td>\n<td>任意网页</td>\n<td>精确检测</td>\n<td>需要存储历史哈希</td>\n</tr>\n<tr>\n<td>Sitemap 解析</td>\n<td>SEO 友好的网站</td>\n<td>全站索引</td>\n<td>更新不一定及时</td>\n</tr>\n<tr>\n<td>API 轮询</td>\n<td>提供 API 的平台</td>\n<td>结构化数据</td>\n<td>受限于 API 限制</td>\n</tr>\n<tr>\n<td>WebSocket 推送</td>\n<td>实时数据源</td>\n<td>零延迟</td>\n<td>需要维护连接</td>\n</tr>\n</tbody></table>\n<h2 id=\"数据采集的合规与伦理\">数据采集的合规与伦理</h2><p>数据采集必须在法律和伦理框架内进行，这不仅是道德要求，也是业务可持续性的保障。</p>\n<table>\n<thead>\n<tr>\n<th>合规要求</th>\n<th>具体措施</th>\n<th>风险等级</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>robots.txt</td>\n<td>遵守 Disallow 规则及 AI 爬虫专属 token</td>\n<td>法律风险</td>\n</tr>\n<tr>\n<td>速率限制</td>\n<td>每域名每秒不超过 1 请求</td>\n<td>被封禁</td>\n</tr>\n<tr>\n<td>个人数据</td>\n<td>不采集可识别个人信息</td>\n<td>GDPR/个保法</td>\n</tr>\n<tr>\n<td>版权内容</td>\n<td>注意内容使用授权</td>\n<td>知识产权</td>\n</tr>\n<tr>\n<td>服务条款</td>\n<td>检查网站 ToS 中的爬虫条款</td>\n<td>合同纠纷</td>\n</tr>\n</tbody></table>\n<p>robots.txt 的语义在 AI 时代已经扩展：除了传统的 Disallow 路径规则，GPTBot、CCBot 等 AI 爬虫 token 让站长能区分&quot;允许搜索索引&quot;与&quot;允许用于模型训练&quot;。采集训练语料前，应先解析目标站针对 AI 爬虫的声明，无法确证授权时选择官方开放数据集（如 Common Crawl 语料库）或付费数据服务。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Web 爬虫与数据采集))&#10;    架构设计&#10;      调度器&#10;      下载器&#10;      解析器&#10;      存储&#10;    反爬对抗&#10;      UA 轮换&#10;      代理池&#10;      无头浏览器&#10;    AI 抓取生态&#10;      GPTBot robots 管理&#10;      CCBot 退出与验证&#10;      LLM 结构化抽取&#10;      Markdown 化采集&#10;    增量采集&#10;      时间戳对比&#10;      内容哈希&#10;      Sitemap&#10;    合规伦理&#10;      robots.txt&#10;      速率限制&#10;      隐私保护\">mindmap\n  root((Web 爬虫与数据采集))\n    架构设计\n      调度器\n      下载器\n      解析器\n      存储\n    反爬对抗\n      UA 轮换\n      代理池\n      无头浏览器\n    AI 抓取生态\n      GPTBot robots 管理\n      CCBot 退出与验证\n      LLM 结构化抽取\n      Markdown 化采集\n    增量采集\n      时间戳对比\n      内容哈希\n      Sitemap\n    合规伦理\n      robots.txt\n      速率限制\n      隐私保护</pre><ul>\n<li>数据采集是 AI 数据工程的起点，采集质量决定了模型效果的天花板</li>\n<li>生产级爬虫需要模块化架构：调度器、下载器、解析器、存储和监控</li>\n<li>反爬对抗是实际工程中的核心挑战，需要代理池、UA 轮换和请求节流等策略</li>\n<li>AI 抓取生态已从纯对抗转向协商：GPTBot 等 robots token、CCBot 的退出与反向 DNS 验证让授权管理成为双向动作</li>\n<li>LLM 结构化抽取用 JSON Schema 约束替代手写 CSS/XPath，适合长尾站点；高频站点仍保留手写解析以控制成本</li>\n<li>面向 LLM 语料的采集以 Markdown 化输出为目标，正文抽取、去噪和去重是标准前置步骤</li>\n<li>增量采集相比全量采集效率提升数十倍，是持续更新数据源的最佳实践</li>\n<li>数据采集必须在法律和伦理框架内进行，遵守 robots.txt 和隐私法规</li>\n<li>对于商业数据需求，优先考虑付费数据服务而非自建爬虫</li>\n</ul>\n","headings":[{"level":1,"text":"Web 爬虫与数据采集","id":"web-爬虫与数据采集"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"爬虫架构设计","id":"爬虫架构设计"},{"level":2,"text":"反爬对抗策略","id":"反爬对抗策略"},{"level":2,"text":"AI 抓取生态：robots 协商、LLM 抽取与语料化采集","id":"ai-抓取生态-robots-协商-llm-抽取与语料化采集"},{"level":2,"text":"增量采集与变更检测","id":"增量采集与变更检测"},{"level":2,"text":"数据采集的合规与伦理","id":"数据采集的合规与伦理"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"数据清洗流水线","url":"/l-doc-books/h/ai-llm/ai-data-engineering/data-collection-cleaning/data-cleaning-pipeline"}}