\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    processedIds,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> StreamEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> eventId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">event</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">partition</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">event</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">offset</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (processedIds.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventId)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(event);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      processedIds.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventId);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"背压与流控\">背压与流控</h2><p>当消费者处理速度跟不上生产者发送速度时，需要背压（Backpressure）机制防止系统过载。</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>实现</th>\n<th>效果</th>\n<th>副作用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>缓冲区限制</td>\n<td>设置消息队列深度上限</td>\n<td>生产者阻塞</td>\n<td>数据延迟增加</td>\n</tr>\n<tr>\n<td>采样丢弃</td>\n<td>超载时随机丢弃消息</td>\n<td>保持低延迟</td>\n<td>数据不完整</td>\n</tr>\n<tr>\n<td>动态分区</td>\n<td>增加消费者和分区</td>\n<td>提升吞吐</td>\n<td>运维成本增加</td>\n</tr>\n<tr>\n<td>降级处理</td>\n<td>简化处理逻辑</td>\n<td>保持吞吐</td>\n<td>结果精度降低</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((流式数据接入))&#10;    消息队列&#10;      Kafka&#10;      分区与副本&#10;      消息回溯&#10;    流处理&#10;      窗口计算&#10;      状态管理&#10;      水位线&#10;    一致性&#10;      At-Least-Once&#10;      Exactly-Once&#10;      幂等处理&#10;    流控&#10;      背压机制&#10;      动态扩展&#10;      降级策略\">mindmap\n  root((流式数据接入))\n    消息队列\n      Kafka\n      分区与副本\n      消息回溯\n    流处理\n      窗口计算\n      状态管理\n      水位线\n    一致性\n      At-Least-Once\n      Exactly-Once\n      幂等处理\n    流控\n      背压机制\n      动态扩展\n      降级策略</pre><ul>\n<li>流式数据接入使 AI 系统能够基于最新数据进行实时推理和持续学习</li>\n<li>消息队列（如 Kafka）是流式架构的基础，提供生产者和消费者之间的解耦缓冲</li>\n<li>窗口计算（滚动/滑动/会话）是流处理中聚合分析的核心模式</li>\n<li>At-Least-Once + 幂等消费者是兼顾性能和正确性的最佳实践</li>\n<li>背压和流控机制防止消费者过载，保证系统稳定性</li>\n<li>流式与批量处理应互补使用，而非互相替代</li>\n</ul>\n","headings":[{"level":1,"text":"流式数据接入","id":"流式数据接入"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"消息队列架构","id":"消息队列架构"},{"level":2,"text":"流处理模式","id":"流处理模式"},{"level":2,"text":"数据一致性与容错","id":"数据一致性与容错"},{"level":2,"text":"背压与流控","id":"背压与流控"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据去重","url":"/l-doc-books/h/ai-llm/ai-data-engineering/data-collection-cleaning/data-deduplication"},"next":{"title":"标注策略与工具","url":"/l-doc-books/h/ai-llm/ai-data-engineering/data-labeling-quality/labeling-strategies"}}