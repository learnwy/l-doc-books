hiki-dark:#79B8FF\"> str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">eval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(expression))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">agent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ReActAgent(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">tools</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"search\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: search, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"calculator\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: calculator})</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> agent.run(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Python 3.12 发布于哪一年？距今多少年？\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result)</span></span></code></pre></div><hr>\n<h2 id=\"react-与其他模式的对比\">ReAct 与其他模式的对比</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph CoT[&quot;思维链 (CoT)&quot;]&#10;        direction TB&#10;        C1[&quot;Thought 1&quot;] --&gt; C2[&quot;Thought 2&quot;] --&gt; C3[&quot;Answer&quot;]&#10;    end&#10;    subgraph Act[&quot;纯行动&quot;]&#10;        direction TB&#10;        A1[&quot;Action 1&quot;] --&gt; A2[&quot;Action 2&quot;] --&gt; A3[&quot;Action 3&quot;]&#10;    end&#10;    subgraph ReAct&#10;        direction TB&#10;        R1[&quot;Thought&quot;] --&gt; R2[&quot;Action&quot;] --&gt; R3[&quot;Observation&quot;] --&gt; R1&#10;    end\">flowchart LR\n    subgraph CoT[\"思维链 (CoT)\"]\n        direction TB\n        C1[\"Thought 1\"] --&gt; C2[\"Thought 2\"] --&gt; C3[\"Answer\"]\n    end\n    subgraph Act[\"纯行动\"]\n        direction TB\n        A1[\"Action 1\"] --&gt; A2[\"Action 2\"] --&gt; A3[\"Action 3\"]\n    end\n    subgraph ReAct\n        direction TB\n        R1[\"Thought\"] --&gt; R2[\"Action\"] --&gt; R3[\"Observation\"] --&gt; R1\n    end</pre><blockquote>\n<p><strong>提示：</strong> ReAct 模式是目前大多数 Agent 框架的基础范式。LangChain 的 AgentExecutor、OpenAI 的 Function Calling 都可以看作 ReAct 的变体实现。理解 ReAct 是掌握 Agent 开发的关键。</p>\n</blockquote>\n<hr>\n<h2 id=\"常见问题与优化策略\">常见问题与优化策略</h2><p>在实际应用中，ReAct 模式可能遇到以下问题：</p>\n<table>\n<thead>\n<tr>\n<th>问题</th>\n<th>表现</th>\n<th>解决策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>推理循环</td>\n<td>Agent 在相同的思考和行动之间反复循环</td>\n<td>设置最大步数限制，检测重复模式</td>\n</tr>\n<tr>\n<td>工具选择错误</td>\n<td>Agent 选择了不适合当前任务的工具</td>\n<td>优化工具描述，提供使用示例</td>\n</tr>\n<tr>\n<td>过早终止</td>\n<td>Agent 在信息不充分时给出答案</td>\n<td>在 Prompt 中强调验证步骤</td>\n</tr>\n<tr>\n<td>上下文溢出</td>\n<td>多步交互导致上下文窗口用尽</td>\n<td>摘要压缩历史轨迹</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ReActConfig {&#10;  maxSteps: number;&#10;  duplicateDetection: boolean;&#10;  trajectoryCompression: boolean;&#10;  minConfidenceThreshold: number;&#10;}&#10;&#10;const defaultConfig: ReActConfig = {&#10;  maxSteps: 10,&#10;  duplicateDetection: true,&#10;  trajectoryCompression: true,&#10;  minConfidenceThreshold: 0.8,&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReActConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  maxSteps</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  duplicateDetection</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  trajectoryCompression</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  minConfidenceThreshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> defaultConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReActConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  maxSteps: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  duplicateDetection: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  trajectoryCompression: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  minConfidenceThreshold: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>ReAct 将推理（Reasoning）与行动（Acting）结合，形成 Thought-Action-Observation 循环。</li>\n<li>与纯推理或纯行动相比，ReAct 在可解释性和准确性上都有优势。</li>\n<li>ReAct Agent 的实现核心是解析 LLM 输出中的 Action 指令并路由到对应工具。</li>\n<li>推理循环、工具选择错误、过早终止是常见问题，需要通过步数限制和重复检测来防范。</li>\n<li>ReAct 是现代 Agent 框架的基础范式，理解它对掌握 Agent 开发至关重要。</li>\n</ul>\n","headings":[{"level":1,"text":"ReAct 模式","id":"react-模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"推理与行动的结合","id":"推理与行动的结合"},{"level":2,"text":"Thought-Action-Observation 循环","id":"thought-action-observation-循环"},{"level":2,"text":"ReAct Agent 实现","id":"react-agent-实现"},{"level":2,"text":"ReAct 与其他模式的对比","id":"react-与其他模式的对比"},{"level":2,"text":"常见问题与优化策略","id":"常见问题与优化策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Agent 核心概念","url":"/l-doc-books/h/ai-llm/ai-agent-development/foundations/agent-concepts"},"next":{"title":"规划与推理","url":"/l-doc-books/h/ai-llm/ai-agent-development/foundations/planning-and-reasoning"}}