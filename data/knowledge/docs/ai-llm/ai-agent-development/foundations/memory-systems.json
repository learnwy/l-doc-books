hiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  successRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AgentMemory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  episodic</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EpisodicMemory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  semantic</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SemanticMemory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  procedural</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProceduralMemory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"记忆检索\">记忆检索</h2><p>记忆的价值在于检索。当 Agent 面对新任务时，需要从记忆库中找到最相关的信息。有效的检索策略通常结合多个维度：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    Q[&quot;当前查询&quot;] --&gt; R1[&quot;相关性&lt;br/&gt;语义相似度&quot;]&#10;    Q --&gt; R2[&quot;时效性&lt;br/&gt;时间衰减&quot;]&#10;    Q --&gt; R3[&quot;重要性&lt;br/&gt;预设权重&quot;]&#10;    R1 --&gt; S[&quot;综合评分&quot;]&#10;    R2 --&gt; S&#10;    R3 --&gt; S&#10;    S --&gt; TOP[&quot;Top-K 结果&quot;]\">flowchart LR\n    Q[\"当前查询\"] --&gt; R1[\"相关性&lt;br/&gt;语义相似度\"]\n    Q --&gt; R2[\"时效性&lt;br/&gt;时间衰减\"]\n    Q --&gt; R3[\"重要性&lt;br/&gt;预设权重\"]\n    R1 --&gt; S[\"综合评分\"]\n    R2 --&gt; S\n    R3 --&gt; S\n    S --&gt; TOP[\"Top-K 结果\"]</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import numpy as np&#10;from datetime import datetime, timedelta&#10;&#10;class MemoryRetriever:&#10;    def __init__(self, decay_factor: float = 0.995):&#10;        self.decay_factor = decay_factor&#10;&#10;    def retrieve(&#10;        self,&#10;        query_embedding: np.ndarray,&#10;        memories: list[MemoryEntry],&#10;        top_k: int = 5,&#10;        weights: dict = None&#10;    ) -&gt; list[MemoryEntry]:&#10;        if weights is None:&#10;            weights = {&quot;relevance&quot;: 0.5, &quot;recency&quot;: 0.3, &quot;importance&quot;: 0.2}&#10;&#10;        scored = []&#10;        now = datetime.now()&#10;&#10;        for memory in memories:&#10;            relevance = self._cosine_similarity(&#10;                query_embedding, memory.metadata.get(&quot;embedding&quot;, [])&#10;            )&#10;&#10;            hours_ago = (now - memory.timestamp).total_seconds() / 3600&#10;            recency = self.decay_factor ** hours_ago&#10;&#10;            score = (&#10;                weights[&quot;relevance&quot;] * relevance +&#10;                weights[&quot;recency&quot;] * recency +&#10;                weights[&quot;importance&quot;] * memory.importance&#10;            )&#10;            scored.append((score, memory))&#10;&#10;        scored.sort(key=lambda x: x[0], reverse=True)&#10;        return [m for _, m in scored[:top_k]]&#10;&#10;    def _cosine_similarity(self, a: np.ndarray, b: np.ndarray) -&gt; float:&#10;        if len(a) == 0 or len(b) == 0:&#10;            return 0.0&#10;        return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datetime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datetime, timedelta</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MemoryRetriever</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, decay_factor: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.995</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.decay_factor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> decay_factor</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark