style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"传输层\">传输层</h2><p>MCP 规范按版本演进传输机制。2024 年 11 月的规范定义了 Stdio 与 HTTP+SSE 两种传输；2025 年 3 月 26 日的规范修订引入 <strong>Streamable HTTP</strong> 取代 HTTP+SSE，并在 2025 年 6 月 18 日修订中成为正式标准（见 <a href=\"https://modelcontextprotocol.io/specification/2025-06-18/basic/transports\">MCP 规范 Transports 章节</a>）。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph Stdio 传输&#10;        C1[&quot;MCP Client&quot;] &lt;--&gt;|stdin/stdout| S1[&quot;MCP Server&lt;br/&gt;(子进程)&quot;]&#10;    end&#10;    subgraph Streamable HTTP 传输&#10;        C2[&quot;MCP Client&quot;] &lt;--&gt;|&quot;HTTP POST + SSE 流&quot;| S2[&quot;MCP Server&lt;br/&gt;(独立 HTTP 服务)&quot;]&#10;    end\">flowchart TD\n    subgraph Stdio 传输\n        C1[\"MCP Client\"] &lt;--&gt;|stdin/stdout| S1[\"MCP Server&lt;br/&gt;(子进程)\"]\n    end\n    subgraph Streamable HTTP 传输\n        C2[\"MCP Client\"] &lt;--&gt;|\"HTTP POST + SSE 流\"| S2[\"MCP Server&lt;br/&gt;(独立 HTTP 服务)\"]\n    end</pre><table>\n<thead>\n<tr>\n<th>传输方式</th>\n<th>工作机制</th>\n<th>适用场景</th>\n<th>优势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Stdio</td>\n<td>通过子进程标准输入输出通信</td>\n<td>本地工具、IDE 插件</td>\n<td>简单、低延迟</td>\n</tr>\n<tr>\n<td>Streamable HTTP</td>\n<td>客户端经单个 HTTP 端点发送消息，服务端可用 SSE 流式返回</td>\n<td>远程服务、云端工具、多租户部署</td>\n<td>可跨网络、支持认证与断线重连、无状态可扩展</td>\n</tr>\n</tbody></table>\n<p>Streamable HTTP 的关键改进：客户端只需向<strong>一个</strong>端点发 HTTP POST；服务端可以选择用 SSE 流返回响应，也可以在会话内主动向客户端推送消息。相比旧的 HTTP+SSE 传输，它去掉了「必须维持两条通道」的要求，天然适配无状态的 HTTP 基础设施（负载均衡、Serverless 部署）。旧的 HTTP+SSE 服务器通过向后兼容路径继续被现有客户端支持，新实现应优先采用 Streamable HTTP。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import asyncio&#10;from mcp.server import Server&#10;from mcp.server.stdio import stdio_server&#10;&#10;server = Server(&quot;local-tools&quot;)&#10;&#10;async def main():&#10;    async with stdio_server() as (read_stream, write_stream):&#10;        await server.run(read_stream, write_stream)&#10;&#10;asyncio.run(main())\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> asyncio</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mcp.server </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Server</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mcp.server.stdio </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stdio_server</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">server </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Server(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"local-tools\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">():</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stdio_server() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (read_stream, write_stream):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> server.run(read_stream, write_stream)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">asyncio.run(main())</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { McpServer } from &#39;@modelcontextprotocol/sdk/server/mcp.js&#39;;&#10;import { StdioServerTransport } from &#39;@modelcontextprotocol/sdk/server/stdio.js&#39;;&#10;&#10;const server = new McpServer({&#10;  name: &#39;local-tools&#39;,&#10;  version: &#39;1.0.0&#39;,&#10;});&#10;&#10;server.tool(&#39;read_file&#39;, { path: { type: &#39;string&#39;, description: &#39;文件路径&#39; } }, async ({ path }) =&gt; {&#10;  const content = await readFile(path, &#39;utf-8&#39;);&#10;  return { content: [{ type: &#39;text&#39;, text: content }] };&#10;});&#10;&#10;const transport = new StdioServerTransport();&#10;await server.connect(transport);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { McpServer } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@modelcontextprotocol/sdk/server/mcp.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { StdioServerTransport } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@modelcontextprotocol/