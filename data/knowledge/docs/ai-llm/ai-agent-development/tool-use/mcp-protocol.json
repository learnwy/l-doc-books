an style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    required</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from mcp.server import Server&#10;from mcp.types import Tool, Resource, TextContent&#10;&#10;server = Server(&quot;demo-server&quot;)&#10;&#10;@server.list_tools()&#10;async def list_tools() -&gt; list[Tool]:&#10;    return [&#10;        Tool(&#10;            name=&quot;query_database&quot;,&#10;            description=&quot;在数据库中执行 SQL 查询&quot;,&#10;            inputSchema={&#10;                &quot;type&quot;: &quot;object&quot;,&#10;                &quot;properties&quot;: {&#10;                    &quot;sql&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;description&quot;: &quot;SQL 查询语句&quot;},&#10;                    &quot;database&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;description&quot;: &quot;数据库名称&quot;}&#10;                },&#10;                &quot;required&quot;: [&quot;sql&quot;]&#10;            }&#10;        )&#10;    ]&#10;&#10;@server.call_tool()&#10;async def call_tool(name: str, arguments: dict) -&gt; list[TextContent]:&#10;    if name == &quot;query_database&quot;:&#10;        result = await execute_sql(arguments[&quot;sql&quot;])&#10;        return [TextContent(type=&quot;text&quot;, text=str(result))]&#10;    raise ValueError(f&quot;未知工具: {name}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#