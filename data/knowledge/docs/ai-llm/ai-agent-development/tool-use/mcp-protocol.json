quot;] --&gt; H[&quot;请求处理器&quot;]&#10;    H --&gt; LT[&quot;list_tools&lt;br/&gt;列出可用工具&quot;]&#10;    H --&gt; CT[&quot;call_tool&lt;br/&gt;执行工具调用&quot;]&#10;    H --&gt; LR[&quot;list_resources&lt;br/&gt;列出数据源&quot;]&#10;    H --&gt; RR[&quot;read_resource&lt;br/&gt;读取数据&quot;]&#10;    H --&gt; LP[&quot;list_prompts&lt;br/&gt;列出模板&quot;]&#10;    H --&gt; GP[&quot;get_prompt&lt;br/&gt;获取模板&quot;]\">flowchart TD\n    S[\"MCP Server\"] --&gt; H[\"请求处理器\"]\n    H --&gt; LT[\"list_tools&lt;br/&gt;列出可用工具\"]\n    H --&gt; CT[\"call_tool&lt;br/&gt;执行工具调用\"]\n    H --&gt; LR[\"list_resources&lt;br/&gt;列出数据源\"]\n    H --&gt; RR[\"read_resource&lt;br/&gt;读取数据\"]\n    H --&gt; LP[\"list_prompts&lt;br/&gt;列出模板\"]\n    H --&gt; GP[\"get_prompt&lt;br/&gt;获取模板\"]</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from mcp.server import Server&#10;from mcp.types import Tool, Resource, TextContent, Prompt, PromptMessage&#10;&#10;server = Server(&quot;knowledge-base&quot;)&#10;&#10;KNOWLEDGE = {&#10;    &quot;python&quot;: &quot;Python 是一种高级编程语言...&quot;,&#10;    &quot;typescript&quot;: &quot;TypeScript 是 JavaScript 的超集...&quot;&#10;}&#10;&#10;@server.list_resources()&#10;async def list_resources() -&gt; list[Resource]:&#10;    return [&#10;        Resource(&#10;            uri=f&quot;kb://{topic}&quot;,&#10;            name=f&quot;{topic} 知识文档&quot;,&#10;            mimeType=&quot;text/plain&quot;&#10;        )&#10;        for topic in KNOWLEDGE&#10;    ]&#10;&#10;@server.read_resource()&#10;async def read_resource(uri: str) -&gt; str:&#10;    topic = uri.replace(&quot;kb://&quot;, &quot;&quot;)&#10;    return KNOWLEDGE.get(topic, &quot;未找到相关知识&quot;)&#10;&#10;@server.list_prompts()&#10;async def list_prompts() -&gt; list[Prompt]:&#10;    return [&#10;        Prompt(&#10;            name=&quot;explain_concept&quot;,&#10;            description=&quot;用简单语言解释技术概念&quot;,&#10;            arguments=[&#10;                {&quot;name&quot;: &quot;concept&quot;, &quot;required&quot;: True, &quot;description&quot;: &quot;要解释的概念&quot;}&#10;            ]&#10;        )&#10;    ]\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mcp.server </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Server</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mcp.types </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Tool, Resource, TextContent, Prompt, PromptMessage</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">server </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Server(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"knowledge-base\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">KNOWLEDGE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"python\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Python 是一种高级编程语言...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"typescript\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"TypeScript 是 JavaScript 的超集...\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">@server.list_resources</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> list_resources</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() -> list[Resource]:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Resource(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            uri</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kb://</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">topic</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">topic</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 知识文档\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            mimeType</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"text/plain\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> topic </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> KNOWLEDGE</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">@server.read_resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> read_resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(uri: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    topic </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uri.replace(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kb://\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> KNOWLEDGE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.get(topic, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"未找到相关知识\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">@server.list_prompts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> list_prompts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() -> list[Prompt]:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Prompt(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"explain_concept\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"用简单语言解释技术概念\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            arguments</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                {</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"concept\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"required\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"description\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"要解释的概念\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> MCP 的生态正在快速发展。目前已有文件系统、GitHub、Slack、数据库等多种官方和社区 MCP 服务器。在开发自己的 MCP 服务器之前，先查看是否已有现成的实现。</p>\n</blockquote>\n<hr>\n<h2 id=\"mcp-与-function-calling-的关系\">MCP 与 Function Calling 的关系</h2><table>\n<thead>\n<tr>\n<th>对比维度</th>\n<th>Function Calling</th>\n<th>MCP</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>定义层级</td>\n<td>API 级别</td>\n<td>协议级别</td>\n</tr>\n<tr>\n<td>标准化</td>\n<td>各厂商不同</td>\n<td>统一标准</td>\n</tr>\n<tr>\n<td>工具发现</td>\n<td>静态配置</td>\n<td>动态发现</td>\n</tr>\n<tr>\n<td>数据访问</td>\n<td>仅通过工具</td>\n<td>Resources 原语</td>\n</tr>\n<tr>\n<td>传输方式</td>\n<td>HTTP API</td>\n<td>Stdio / Streamable HTTP</td>\n</tr>\n<tr>\n<td>生态系统</td>\n<td>厂商锁定</td>\n<td>开放生态</td>\n</tr>\n</tbody></table>\n<p>MCP 可以看作是 Function Calling 的标准化和扩展。它不仅标准化了工具调用，还增加了资源访问和提示模板两个维度。值得一提的是，MCP 已不再只是 Anthropic 一家的生态——2025 年起 OpenAI 与 Google 也先后宣布在其 Agent 产品线中支持 MCP，使其成为跨厂商的工具连接事实标准。</p>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>MCP 是 Anthropic 于 2024 年推出的开放协议，标准化了 LLM 应用与外部工具/数据的交互。</li>\n<li>MCP 定义了 Tools（工具）、Resources（资源）、Prompts（模板）三种核心原语。</li>\n<li>传输层在 2025-03-26 规范修订中引入 Streamable HTTP 取代旧的 HTTP+SSE，并于 2025-06-18 规范正式定型；本地场景仍以 Stdio 为主。</li>\n<li>MCP 服务器通过实现标准的请求处理器来暴露工具和数据。</li>\n<li>MCP 是 Function Calling 的标准化演进，提供了更完整的工具交互框架。</li>\n</ul>\n","headings":[{"level":1,"text":"MCP 协议","id":"mcp-协议"},{"level":2,"text":"什么是 Model Context Protocol","id":"什么是-model-context-protocol"},{"level":2,"text":"核心概念：Tools / Resources / Prompts","id":"核心概念-tools-resources-prompts"},{"level":2,"text":"传输层","id":"传输层"},{"level":2,"text":"MCP 服务器开发实践","id":"mcp-服务器开发实践"},{"level":2,"text":"MCP 与 Function Calling 的关系","id":"mcp-与-function-calling-的关系"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"工具设计模式","url":"/l-doc-books/h/ai-llm/ai-agent-development/tool-use/tool-design-patterns"},"next":{"title":"API 集成","url":"/l-doc-books/h/ai-llm/ai-agent-development/tool-use/api-integration"}}