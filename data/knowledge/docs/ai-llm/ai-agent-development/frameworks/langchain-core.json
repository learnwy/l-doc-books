str:&#10;    &quot;&quot;&quot;计算数学表达式。支持基本的四则运算。&quot;&quot;&quot;&#10;    return str(eval(expression))&#10;&#10;prompt = ChatPromptTemplate.from_messages([&#10;    (&quot;system&quot;, &quot;你是一个有用的助手，可以使用工具帮助用户。&quot;),&#10;    (&quot;placeholder&quot;, &quot;{chat_history}&quot;),&#10;    (&quot;user&quot;, &quot;{input}&quot;),&#10;    (&quot;placeholder&quot;, &quot;{agent_scratchpad}&quot;)&#10;])&#10;&#10;llm = ChatOpenAI(model=&quot;gpt-5.6-terra&quot;)&#10;agent = create_tool_calling_agent(llm, [search_web, calculate], prompt)&#10;executor = AgentExecutor(agent=agent, tools=[search_web, calculate], verbose=True)&#10;&#10;result = executor.invoke({&quot;input&quot;: &quot;Python 3.12 发布于哪年？距今多少年？&quot;, &quot;chat_history&quot;: []})&#10;print(result[&quot;output&quot;])\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> langchain_openai </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ChatOpenAI</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> langchain.agents </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> create_tool_calling_agent, AgentExecutor</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> langchain_core.prompts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ChatPromptTemplate</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span 