=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    goal</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"确保文档的技术准确性和内容完整性\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    backstory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"你是一位严谨的技术审查员，对细节要求极高。\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    verbose</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>CrewAI 的任务定义包含明确的期望输出：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"research_task = Task(&#10;    description=&quot;研究近两年 AI Agent 框架的发展脉络，包括 LangGraph、AutoGen、CrewAI 的版本演进和关键新特性。&quot;,&#10;    expected_output=&quot;一份包含各框架最新特性对比的研究报告&quot;,&#10;    agent=researcher&#10;)&#10;&#10;writing_task = Task(&#10;    description=&quot;基于研究报告，撰写一篇关于 AI Agent 框架选型的技术博客。&quot;,&#10;    expected_output=&quot;一篇 1500 字左右的技术博客，包含代码示例和对比表格&quot;,&#10;    agent=writer,&#10;    context=[research_task]&#10;)&#10;&#10;review_task = Task(&#10;    description=&quot;审查技术博客的准确性和完整性，提出修改建议。&quot;,&#10;    expected_output=&quot;审查意见列表和修改后的最终版本&quot;,&#10;    agent=reviewer,&#10;    context=[writing_task]&#10;)&#10;&#10;crew = Crew(&#10;    agents=[researcher, writer, reviewer],&#10;    tasks=[research_task, writing_task, review_task],&#10;    process=Process.sequential,&#10;    verbose=True&#10;)&#10;&#10;result = crew.kickoff()&#10;print(result)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">research_task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Task(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"研究近两年 AI Agent 框架的发展脉络，包括 LangGraph、AutoGen、CrewAI 的版本演进和关键新特性。\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    expected_output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"一份包含各框架最新特性对比的研究报告\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    agent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">researcher</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">writing_task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Task(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"基于研究报告，撰写一篇关于 AI Agent 框架选型的技术博客。\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    expected_output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"一篇 1500 字左右的技术博客，包含代码示例和对比表格\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    agent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">writer,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    context</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[research_task]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">review_task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Task(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"审查技术博客的准确性和完整性，提出修改建议。\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    expected_output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"审查意见列表和修改后的最终版本\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    agent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">reviewer,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    context</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[writing_task]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">crew </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Crew(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    agents</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[researcher, writer, reviewer],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    tasks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[research_task, writing_task, review_task],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    process</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Process.sequential,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    verbose</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> crew.kickoff()</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result)</span></span></code></pre></div><hr>\n<h2 id=\"对话模式对比\">对话模式对比</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph AutoGen 对话流&#10;        U[&quot;用户&quot;] --&gt;|消息| A[&quot;助手 Agent&quot;]&#10;        A --&gt;|代码| UE[&quot;执行代理&quot;]&#10;        UE --&gt;|结果| A&#10;        A --&gt;|修改后代码| R[&quot;审查 Agent&quot;]&#10;        R --&gt;|反馈| A&#10;    end&#10;    subgraph CrewAI 任务流&#10;        T1[&quot;研究任务&quot;] --&gt; T2[&quot;撰写任务&quot;]&#10;        T2 --&gt; T3[&quot;审查任务&quot;]&#10;        T3 --&gt;|需要修改| T2&#10;    end\">flowchart TD\n    subgraph AutoGen 对话流\n        U[\"用户\"] --&gt;|消息| A[\"助手 Agent\"]\n        A --&gt;|代码| UE[\"执行代理\"]\n        UE --&gt;|结果| A\n        A --&gt;|修改后代码| R[\"审查 Agent\"]\n        R --&gt;|反馈| A\n    end\n    subgraph CrewAI 任务流\n        T1[\"研究任务\"] --&gt; T2[\"撰写任务\"]\n        T2 --&gt; T3[\"审查任务\"]\n        T3 --&gt;|需要修改| T2\n    end</pre><table>\n<thead>\n<tr>\n<th>对比维度</th>\n<th>AutoGen</th>\n<th>CrewAI</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>编排模型</td>\n<td>对话消息传递（Team 编排）</td>\n<td>任务分配+流程</td>\n</tr>\n<tr>\n<td>Agent 定义</td>\n<td>system_message + model_client</td>\n<td>role + goal + backstory</td>\n</tr>\n<tr>\n<td>灵活性</td>\n<td>高，支持自定义对话流与图编排</td>\n<td>中，预定义流程模式</td>\n</tr>\n<tr>\n<td>代码执行</td>\n<td>CodeExecutor 组件（含 Docker）</td>\n<td>通过工具支持</td>\n</tr>\n<tr>\n<td>上手难度</td>\n<td>中等</td>\n<td>较简单</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>复杂对话和调试</td>\n<td>团队协作类任务</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 如果你的场景是「多个角色按流程完成任务」（如研究→写作→审查），CrewAI 的直觉性更强。如果需要灵活的 Agent 间对话和动态路由，AutoGen 更适合。两者都可以与 LangChain 工具生态集成。</p>\n</blockquote>\n<hr>\n<h2 id=\"2025-年后的多框架格局\">2025 年后的多框架格局</h2><p>AutoGen 与 CrewAI 之外，2025 年出现了几个值得了解的官方框架，共同点是都把「模型循环 + 工具 + 移交」封装为一等抽象：</p>\n<table>\n<thead>\n<tr>\n<th>框架</th>\n<th>开发者</th>\n<th>特点</th>\n<th>入口</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>OpenAI Agents SDK</td>\n<td>OpenAI</td>\n<td>Agent、Handoff、Guardrail 三原语，配合 Responses API 使用</td>\n<td><a href=\"https://openai.github.io/openai-agents-python/\">openai.github.io/openai-agents-python</a></td>\n</tr>\n<tr>\n<td>Google ADK</td>\n<td>Google</td>\n<td>多 Agent 组装与评估工具链，与 Gemini 及 Vertex AI 集成</td>\n<td><a href=\"https://google.github.io/adk-docs/\">google.github.io/adk-docs</a></td>\n</tr>\n<tr>\n<td>Microsoft Agent Framework</td>\n<td>微软</td>\n<td>承接 AutoGen 与 Semantic Kernel 的统一框架</td>\n<td><a href=\"https://learn.microsoft.com/en-us/agent-framework/overview/agent-framework-overview\">learn.microsoft.com/agent-framework</a></td>\n</tr>\n<tr>\n<td>LangGraph</td>\n<td>LangChain</td>\n<td>图结构的有状态编排，1.x 已是 LangChain 生态的 Agent 主线</td>\n<td><a href=\"https://langchain-ai.github.io/langgraph/\">langchain-ai.github.io/langgraph</a></td>\n</tr>\n</tbody></table>\n<p>这些框架在「单 Agent 循环」层面高度趋同，真正的差异在编排语义（对话式 vs 图式 vs 角色式）与生态绑定。Google 于 2025 年 4 月发布 ADK 时同步开放了 A2A 协议用于跨厂商 Agent 互联——协议层面的互操作正在成为框架之外的第二条主线，详见第三章「多 Agent 系统」。</p>\n<hr>\n<h2 id=\"框架选型建议\">框架选型建议</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"def recommend_framework(requirements: dict) -&gt; str:&#10;    complexity = requirements.get(&quot;complexity&quot;, &quot;medium&quot;)&#10;    interaction_type = requirements.get(&quot;interaction&quot;, &quot;task&quot;)&#10;    code_execution = requirements.get(&quot;code_execution&quot;, False)&#10;    customization = requirements.get(&quot;customization&quot;, &quot;medium&quot;)&#10;&#10;    if interaction_type == &quot;conversation&quot; and customization == &quot;high&quot;:&#10;        return &quot;AutoGen - 灵活的对话驱动编排&quot;&#10;    elif interaction_type == &quot;task&quot; and complexity in (&quot;low&quot;, &quot;medium&quot;):&#10;        return &quot;CrewAI - 直观的角色和任务定义&quot;&#10;    elif code_execution:&#10;        return &quot;AutoGen - 内置代码执行沙箱&quot;&#10;    else:&#10;        return &quot;根据团队经验选择，两者都可胜任&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> recommend_framework</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(requirements: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    complexity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requirements.get(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"complexity\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"medium\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    interaction_type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requirements.get(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"interaction\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"task\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    code_execution </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requirements.get(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"code_execution\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">False</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    customization </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requirements.get(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"customization\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"medium\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> interaction_type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"conversation\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> and</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customization </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"high\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"AutoGen - 灵活的对话驱动编排\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    elif</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> interaction_type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"task\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> and</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> complexity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"low\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"medium\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"CrewAI - 直观的角色和任务定义\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    elif</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> code_execution:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"AutoGen - 内置代码执行沙箱\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"根据团队经验选择，两者都可胜任\"</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>AutoGen 和 CrewAI 是两个主流的多 Agent 框架，分别采用对话驱动和角色扮演的设计哲学。</li>\n<li>AutoGen 自 v0.4 起采用事件驱动架构（AgentChat + Core 两层 API），v0.2 API 已停止维护，新代码应使用 <code>autogen_agentchat</code> 包。</li>\n<li>CrewAI 使用 Role-Goal-Backstory 定义 Agent，通过 Task 和 Process 编排流程。</li>\n<li>AutoGen 适合需要灵活对话和代码执行的场景，CrewAI 适合结构化的团队协作任务；OpenAI Agents SDK、Google ADK 与 Microsoft Agent Framework 是选型时同样值得评估的官方框架。</li>\n<li>两者都可以与 LangChain 工具生态集成，选型应基于具体场景需求。</li>\n</ul>\n","headings":[{"level":1,"text":"AutoGen 与 CrewAI","id":"autogen-与-crewai"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"多 Agent 框架概览","id":"多-agent-框架概览"},{"level":2,"text":"AutoGen：对话驱动","id":"autogen-对话驱动"},{"level":2,"text":"CrewAI：角色扮演","id":"crewai-角色扮演"},{"level":2,"text":"对话模式对比","id":"对话模式对比"},{"level":2,"text":"2025 年后的多框架格局","id":"2025-年后的多框架格局"},{"level":2,"text":"框架选型建议","id":"框架选型建议"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"LlamaIndex 索引框架","url":"/l-doc-books/h/ai-llm/ai-agent-development/frameworks/llamaindex"},"next":{"title":"自定义框架设计","url":"/l-doc-books/h/ai-llm/ai-agent-development/frameworks/custom-framework-design"}}