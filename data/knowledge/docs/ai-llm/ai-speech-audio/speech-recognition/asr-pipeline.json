#E1E4E8\">.norm(x)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>模型</th>\n<th>年份</th>\n<th>架构</th>\n<th>参数量</th>\n<th>LibriSpeech WER</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DeepSpeech 2</td>\n<td>2015</td>\n<td>RNN (GRU)</td>\n<td>~30M</td>\n<td>5.3%</td>\n</tr>\n<tr>\n<td>Conformer</td>\n<td>2020</td>\n<td>Attention + Conv</td>\n<td>~118M</td>\n<td>1.9%</td>\n</tr>\n<tr>\n<td>wav2vec 2.0</td>\n<td>2020</td>\n<td>自监督预训练</td>\n<td>~317M</td>\n<td>1.8%</td>\n</tr>\n<tr>\n<td>Whisper Large</td>\n<td>2022</td>\n<td>Transformer E2E</td>\n<td>~1.5B</td>\n<td>2.7%（zero-shot）</td>\n</tr>\n<tr>\n<td>USM</td>\n<td>2023</td>\n<td>多语言 SSL</td>\n<td>~2B</td>\n<td>1.5%</td>\n</tr>\n<tr>\n<td>Parakeet TDT v2</td>\n<td>2025</td>\n<td>FastConformer + TDT</td>\n<td>~0.6B</td>\n<td>开源榜单第一梯队</td>\n</tr>\n</tbody></table>\n<h2 id=\"评估指标\">评估指标</h2><table>\n<thead>\n<tr>\n<th>指标</th>\n<th>公式</th>\n<th>说明</th>\n<th>典型值</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>WER</td>\n<td>(S+D+I)/N</td>\n<td>词错误率</td>\n<td>2-15%</td>\n</tr>\n<tr>\n<td>CER</td>\n<td>(S+D+I)/N (字符)</td>\n<td>字错误率</td>\n<td>1-10%</td>\n</tr>\n<tr>\n<td>RTF</td>\n<td>处理时间/音频时长</td>\n<td>实时因子</td>\n<td>&lt;0.1（实时）</td>\n</tr>\n<tr>\n<td>延迟</td>\n<td>首字输出时间</td>\n<td>流式场景关键</td>\n<td>&lt;500ms</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import jiwer&#10;&#10;reference = &quot;今天的天气非常好&quot;&#10;hypothesis = &quot;今天天气非常好&quot;&#10;&#10;error = jiwer.wer(reference, hypothesis)&#10;print(f&quot;WER: {error:.2%}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> jiwer</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">reference </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"今天的天气非常好\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hypothesis </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"今天天气非常好\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">error </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> jiwer.wer(reference, hypothesis)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"WER: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">error</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.2%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>ASR 流水线从音频预处理、特征提取到声学建模、解码输出，形成完整的语音转文本链路</li>\n<li>梅尔频谱是现代端到端 ASR 的标准输入特征，模拟人耳感知的频率分辨率</li>\n<li>CTC 通过引入 blank 符号解决输入输出长度不对齐问题，是端到端 ASR 的核心解码框架</li>\n<li>Conformer（Attention + 卷积）是当前 ASR 声学模型的主流架构</li>\n<li>Beam Search + 语言模型可在贪心解码基础上提升 10-20% 的准确率</li>\n<li>WER（词错误率）是 ASR 系统的核心评估指标，顶尖系统在 LibriSpeech 上达到 1.5-2%</li>\n</ul>\n","headings":[{"level":1,"text":"ASR 流水线","id":"asr-流水线"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"音频特征提取","id":"音频特征提取"},{"level":2,"text":"CTC 解码原理","id":"ctc-解码原理"},{"level":2,"text":"声学模型架构演进","id":"声学模型架构演进"},{"level":2,"text":"评估指标","id":"评估指标"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"Whisper 与现代 ASR 模型","url":"/l-doc-books/h/ai-llm/ai-speech-audio/speech-recognition/whisper-and-modern-asr"}}