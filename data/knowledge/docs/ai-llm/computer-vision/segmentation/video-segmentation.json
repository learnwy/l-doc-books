E4E8\">        assignments </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(embeddings)):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            max_sim, max_idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> similarity[i].max(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            track_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> list</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.tracks.keys())[max_idx]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> max_sim </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.threshold:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                assignments.append(track_id)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">                self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.tracks[track_id][</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'embedding'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> embeddings[i]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                assignments.append(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.next_id)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">                self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.tracks[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.next_id] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'embedding'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: embeddings[i], </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'mask'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: masks[i]}</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">                self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.next_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> assignments</span></span></code></pre></div><p>GenVIS 将视频实例分割建模为生成式序列预测问题，使用自回归的方式逐步生成每帧的实例掩码，自然地建立了跨帧的时序关联。DVIS 提出了将追踪和分割解耦的思路，先进行帧级分割再进行序列级关联，在长视频场景中表现出色。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((视频分割))&#10;    半监督 VOS&#10;      STM 记忆网络&#10;      XMem 多层记忆&#10;      Cutie 目标记忆&#10;    SAM 2&#10;      交互式提示&#10;      记忆传播&#10;      双向修正&#10;    SAM 3&#10;      概念提示&#10;      图像视频统一&#10;    视频实例分割&#10;      在线关联&#10;      离线建模&#10;      GenVIS 生成式\">mindmap\n  root((视频分割))\n    半监督 VOS\n      STM 记忆网络\n      XMem 多层记忆\n      Cutie 目标记忆\n    SAM 2\n      交互式提示\n      记忆传播\n      双向修正\n    SAM 3\n      概念提示\n      图像视频统一\n    视频实例分割\n      在线关联\n      离线建模\n      GenVIS 生成式</pre><ul>\n<li>视频分割的核心挑战是保持跨帧的时序一致性</li>\n<li>基于记忆的方法是半监督 VOS 的主流范式，XMem 有效处理长视频记忆管理</li>\n<li>SAM 2 将交互式分割扩展到视频，支持多帧提示和双向传播</li>\n<li>视频实例分割需要同时解决检测、分割和追踪三个子问题</li>\n<li>在线方法（逐帧+关联）在实时场景中更实用，离线方法精度更高</li>\n<li>SAM 2 支持零样本交互式视频分割；SAM 3（arXiv:2511.16719）进一步以概念提示在图像与视频中完成开放集检测、分割与追踪</li>\n</ul>\n","headings":[{"level":1,"text":"视频分割","id":"视频分割"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"半监督视频目标分割","id":"半监督视频目标分割"},{"level":2,"text":"SAM 2 与交互式视频分割","id":"sam-2-与交互式视频分割"},{"level":2,"text":"SAM 3 与概念提示分割","id":"sam-3-与概念提示分割"},{"level":2,"text":"视频实例分割","id":"视频实例分割"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"全景分割","url":"/l-doc-books/h/ai-llm/computer-vision/segmentation/panoptic-segmentation"},"next":{"title":"视频理解","url":"/l-doc-books/h/ai-llm/computer-vision/video-and-3d/video-understanding"}}