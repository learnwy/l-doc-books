>),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            nn.Conv2d(in_channels, out_channels, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            nn.BatchNorm2d(out_channels), nn.ReLU())</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.project </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.Sequential(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            nn.Conv2d(out_channels </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, out_channels, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            nn.BatchNorm2d(out_channels), nn.ReLU())</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x.shape[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        pool </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.functional.interpolate(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.pool(x), </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">size</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">size, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">mode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bilinear'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">align_corners</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">False</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        out </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.cat([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv1(x), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv6(x), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv12(x), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv18(x), pool], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.project(out)</span></span></code></pre></div><p>DeepLabV3+ 在 DeepLabV3 的基础上添加了简单而有效的解码器模块。编码器输出经过 ASPP 后与编码器浅层的特征通过跳跃连接融合，恢复物体边界的精细细节。这一改进使 DeepLabV3+ 在 Cityscapes 等基准上达到了当时的最佳水平。</p>\n<h2 id=\"segformer-与-transformer-分割\">SegFormer 与 Transformer 分割</h2><p>SegFormer 将 Transformer 引入语义分割，提出了层级化的 Mix Transformer（MiT）编码器和极其轻量的全 MLP 解码器。MiT 编码器在四个阶段逐步降低分辨率，每个阶段使用高效的自注意力（Efficient Self-Attention）减少计算量。</p>\n<p>SegFormer 的解码器设计极其简洁：将四个阶段的特征图统一上采样到 1/4 分辨率后拼接，通过 MLP 融合并输出分割结果。这种设计几乎不增加额外计算量，同时充分利用了多尺度特征。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from transformers import SegformerForSemanticSegmentation, SegformerImageProcessor&#10;import torch&#10;&#10;processor = SegformerImageProcessor.from_pretrained(&quot;nvidia/segformer-b0-finetuned-cityscapes-1024-1024&quot;)&#10;model = SegformerForSemanticSegmentation.from_pretrained(&quot;nvidia/segformer-b0-finetuned-cityscapes-1024-1024&quot;)&#10;model.eval()&#10;&#10;dummy = torch.randn(1, 3, 1024, 1024)&#10;with torch.no_grad():&#10;    outputs = model(pixel_values=dummy)&#10;    logits = outputs.logits&#10;    print(f&quot;SegFormer 输出: {logits.shape}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> transformers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SegformerForSemanticSegmentation, SegformerImageProcessor</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">processor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SegformerImageProcessor.from_pretrained(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"nvidia/segformer-b0-finetuned-cityscapes-1024-1024\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SegformerForSemanticSegmentation.from_pretrained(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"nvidia/segformer-b0-finetuned-cityscapes-1024-1024\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model.eval()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dummy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.randn(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1024</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1024</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.no_grad():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outputs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> model(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pixel_values</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dummy)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    logits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> outputs.logits</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SegFormer 输出: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">logits.shape</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>Segment Anything Model（SAM）开创了通用分割的新范式。SAM 在超过 10 亿个掩码的 SA-1B 数据集上训练，能够通过点、框或文本提示分割任意物体。SAM 的设计包含重量级图像编码器（ViT-H）和轻量级掩码解码器，图像特征只需计算一次即可响应多次提示。2025 年 11 月发布的 SAM 3（arXiv:2511.16719）将提示扩展到概念层面——名词短语或图像示例——可在图像和视频中检测、分割并追踪所有匹配实例，把通用分割推进到开放集语义层面。</p>\n<table>\n<thead>\n<tr>\n<th>模型</th>\n<th>类型</th>\n<th>编码器</th>\n<th>解码器</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SegFormer</td>\n<td>专用分割</td>\n<td>MiT (Transformer)</td>\n<td>全 MLP</td>\n<td>轻量高效</td>\n</tr>\n<tr>\n<td>SAM</td>\n<td>通用分割</td>\n<td>ViT-H</td>\n<td>轻量掩码头</td>\n<td>零样本提示分割</td>\n</tr>\n<tr>\n<td>SAM 2</td>\n<td>视频分割</td>\n<td>Hiera</td>\n<td>记忆模块</td>\n<td>时序一致性</td>\n</tr>\n<tr>\n<td>SAM 3</td>\n<td>概念分割</td>\n<td>—（统一模型）</td>\n<td>含检测+追踪</td>\n<td>名词短语/示例提示</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((语义分割))&#10;    全卷积架构&#10;      FCN&#10;      U-Net&#10;      跳跃连接&#10;    DeepLab 系列&#10;      空洞卷积&#10;      ASPP 多尺度&#10;      DeepLabV3+&#10;    Transformer 分割&#10;      SegFormer&#10;      Mask2Former&#10;    通用分割&#10;      SAM&#10;      SAM 2&#10;      SAM 3\">mindmap\n  root((语义分割))\n    全卷积架构\n      FCN\n      U-Net\n      跳跃连接\n    DeepLab 系列\n      空洞卷积\n      ASPP 多尺度\n      DeepLabV3+\n    Transformer 分割\n      SegFormer\n      Mask2Former\n    通用分割\n      SAM\n      SAM 2\n      SAM 3</pre><ul>\n<li>FCN 开创了端到端语义分割，全卷积设计使网络可以处理任意尺寸输入</li>\n<li>U-Net 的对称结构和跳跃连接在小数据集上尤其有效，是医学影像分割的首选</li>\n<li>空洞卷积在不降低分辨率的情况下增大感受野，ASPP 捕获多尺度上下文</li>\n<li>SegFormer 以极轻量的 MLP 解码器达到了出色的精度-效率权衡</li>\n<li>SAM 实现了通用的提示式分割，开创了视觉基础模型的新方向；SAM 3 已把提示扩展到概念层面（arXiv:2511.16719）</li>\n<li>实际项目中根据数据量和任务需求选择：小数据用 U-Net，大数据用 SegFormer 或 Mask2Former</li>\n</ul>\n","headings":[{"level":1,"text":"语义分割","id":"语义分割"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"FCN 与全卷积架构","id":"fcn-与全卷积架构"},{"level":2,"text":"DeepLab 与空洞卷积","id":"deeplab-与空洞卷积"},{"level":2,"text":"SegFormer 与 Transformer 分割","id":"segformer-与-transformer-分割"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"实时检测","url":"/l-doc-books/h/ai-llm/computer-vision/object-detection/real-time-detection"},"next":{"title":"实例分割","url":"/l-doc-books/h/ai-llm/computer-vision/segmentation/instance-segmentation"}}