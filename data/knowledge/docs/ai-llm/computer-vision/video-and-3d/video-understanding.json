r:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_frames </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> num_frames</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x, num_patches):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        b </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x.shape[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x_spatial </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x.view(b </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_frames, num_patches, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x_spatial, _ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.spatial_attn(x_spatial, x_spatial, x_spatial)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x_spatial.view(b, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_frames </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> num_patches, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x_temporal </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x.view(b </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> num_patches, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_frames, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x_temporal, _ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.temporal_attn(x_temporal, x_temporal, x_temporal)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x_temporal.view(b, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_frames </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> num_patches, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x</span></span></code></pre></div><p>VideoMAE 将掩码自编码器（MAE）扩展到视频预训练，通过遮挡极高比例（90%）的时空 patch 并预测被遮挡的像素来学习视频表示。由于视频帧间的时间冗余性，高掩码率不仅可行而且是必要的——低掩码率会让模型通过时间插值轻松恢复像素，无法学到有意义的表示。VideoMAE v2 在大规模数据上训练，在 Kinetics-400 上达到了 86.6% 的 Top-1 准确率。</p>\n<h2 id=\"从专用编码器到视频基础模型\">从专用编码器到视频基础模型</h2><p>2024 年以来，视频理解的重心逐渐从「专用编码器 + 任务头」转向大规模视频基础模型和多模态大模型。InternVideo2（2024，arXiv:2403.15377）将视频、音频与文本统一到同一框架中进行大规模预训练，在动作识别、视频文本检索和视频字幕生成等多种任务上刷新了当时的最好结果。</p>\n<p>另一条更彻底的路线是视频多模态大模型（Video MLLM）：将采样后的视频帧作为视觉 token 序列直接送入大语言模型，使视频问答、描述与时序定位统一为对话式推理。Qwen2-VL（arXiv:2409.12191）以原生动态分辨率机制处理任意分辨率和时长的视频输入，是这条路线的代表工作之一。就工程选型而言，掩码预训练编码器（如 VideoMAE 系列）仍是提取紧凑视频特征的高效方案；而需要开放词汇的问答、描述与定位能力时，视频多模态大模型已成为新的默认起点。</p>\n<h2 id=\"时序动作检测\">时序动作检测</h2><p>时序动作检测（Temporal Action Detection）不仅要识别视频中的动作类别，还要定位动作发生的起止时间。这类似于图像中的目标检测，只是从空间域转移到了时间域。</p>\n<p>时序动作检测通常分为提议生成和分类两个阶段。BMN（Boundary-Matching Network）预测每个时间位置是动作开始或结束的概率，然后将开始-结束对组合为候选提议。ActionFormer 使用 Transformer 编码视频特征序列，直接预测每个时间位置的动作类别和时间范围。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn as nn&#10;&#10;class ActionFormerHead(nn.Module):&#10;    def __init__(self, in_dim, num_classes, num_layers=3):&#10;        super().__init__()&#10;        self.cls_head = nn.Sequential(&#10;            nn.Conv1d(in_dim, in_dim, 3, padding=1),&#10;            nn.ReLU(),&#10;            nn.Conv1d(in_dim, num_classes, 1),&#10;        )&#10;        self.reg_head = nn.Sequential(&#10;            nn.Conv1d(in_dim, in_dim, 3, padding=1),&#10;            nn.ReLU(),&#10;            nn.Conv1d(in_dim, 2, 1),&#10;        )&#10;&#10;    def forward(self, features):&#10;        cls_logits = self.cls_head(features)&#10;        reg_offsets = self.reg_head(features)&#10;        return cls_logits, reg_offsets\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ActionFormerHead</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Module</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, in_dim, num_classes, num_layers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        super</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005