E --&gt; FIX_R[\"Provide stack trace&lt;br/&gt;+ input data sample\"]\n    LOGIC --&gt; FIX_L[\"Provide expected behavior&lt;br/&gt;+ actual behavior comparison\"]\n    PERF --&gt; FIX_P[\"Provide perf metrics&lt;br/&gt;+ code hotspot analysis\"]</pre><h3 id=\"提升-ai-调试效果的技巧\">提升 AI 调试效果的技巧</h3><table>\n<thead>\n<tr>\n<th>技巧</th>\n<th>说明</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>提供最小复现用例</td>\n<td>去掉无关代码，只保留触发问题的核心逻辑</td>\n<td>将 200 行文件精简为 20 行复现脚本</td>\n</tr>\n<tr>\n<td>分阶段排查</td>\n<td>先确定问题在前端还是后端，再逐层深入</td>\n<td>&quot;这个 API 返回了什么？让我先检查网络层&quot;</td>\n</tr>\n<tr>\n<td>对比法</td>\n<td>提供正常工作的版本和出错版本的差异</td>\n<td>&quot;这个函数上周还正常，这周改了 X 后出错&quot;</td>\n</tr>\n<tr>\n<td>二分法定位</td>\n<td>在代码中间加日志，逐步缩小问题范围</td>\n<td>&quot;在第 50 行之前数据是正确的&quot;</td>\n</tr>\n<tr>\n<td>橡皮鸭效应</td>\n<td>向 AI 解释你的代码逻辑，往往自己就能发现问题</td>\n<td>&quot;这个函数先做 A，然后做 B……等等，B 不对&quot;</td>\n</tr>\n</tbody></table>\n<h3 id=\"ai-调试的有效提问模板\">AI 调试的有效提问模板</h3><div class=\"code-block-wrapper\" data-lang=\"markdown\" data-code=\"## 编译错误调试&#10;&#10;以下 TypeScript 代码编译失败，错误信息如下： [粘贴完整 tsc 输出]&#10;&#10;相关类型定义： [粘贴涉及的 interface/type]&#10;&#10;请分析错误原因并提供修复方案。&#10;&#10;## 运行时异常调试&#10;&#10;以下函数在特定输入下抛出异常： [粘贴函数代码]&#10;&#10;错误堆栈： [粘贴完整堆栈]&#10;&#10;输入数据： [粘贴触发异常的输入]&#10;&#10;## 逻辑错误调试&#10;&#10;以下函数的输出不符合预期： [粘贴函数代码]&#10;&#10;输入：[值] → 期望输出：[值] → 实际输出：[值]&#10;&#10;请分析逻辑错误在哪里。\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 编译错误调试</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">以下 TypeScript 代码编译失败，错误信息如下： [粘贴完整 tsc 输出]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">相关类型定义： [粘贴涉及的 interface/type]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">请分析错误原因并提供修复方案。</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 运行时异常调试</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">以下函数在特定输入下抛出异常： [</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">粘贴函数代码</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">错误堆栈： [</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">粘贴完整堆栈</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">输入数据： [</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">粘贴触发异常的输入</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 逻辑错误调试</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">以下函数的输出不符合预期： [</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">粘贴函数代码</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">输入：[</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">值</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] → 期望输出：[</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">值</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] → 实际输出：[</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">值</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">请分析逻辑错误在哪里。</span></span></code></pre></div><hr>\n<h2 id=\"常见问题\">常见问题</h2><h3 id=\"ai-无法理解我的错误上下文怎么办\">AI 无法理解我的错误上下文怎么办？</h3><p>当项目过大、AI 无法获取完整上下文时：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"策略 1：逐步缩小范围&#10;  - 先提供模块级别的描述&#10;  - 再提供具体文件和函数&#10;  - 最后聚焦到出错的那几行&#10;&#10;策略 2：创建独立复现脚本&#10;  - 将问题从项目中剥离&#10;  - 用最少的代码复现问题&#10;  - 这本身就是定位问题的有效手段&#10;&#10;策略 3：分层排查&#10;  - 网络层：API 请求/响应是否正确&#10;  - 数据层：数据库查询结果是否符合预期&#10;  - 逻辑层：业务逻辑处理是否正确&#10;  - 表现层：UI 渲染是否正确\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>策略 1：逐步缩小范围</span></span>\n<span class=\"line\"><span>  - 先提供模块级别的描述</span></span>\n<span class=\"line\"><span>  - 再提供具体文件和函数</span></span>\n<span class=\"line\"><span>  - 最后聚焦到出错的那几行</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>策略 2：创建独立复现脚本</span></span>\n<span class=\"line\"><span>  - 将问题从项目中剥离</span></span>\n<span class=\"line\"><span>  - 用最少的代码复现问题</span></span>\n<span class=\"line\"><span>  - 这本身就是定位问题的有效手段</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>策略 3：分层排查</span></span>\n<span class=\"line\"><span>  - 网络层：API 请求/响应是否正确</span></span>\n<span class=\"line\"><span>  - 数据层：数据库查询结果是否符合预期</span></span>\n<span class=\"line\"><span>  - 逻辑层：业务逻辑处理是否正确</span></span>\n<span class=\"line\"><span>  - 表现层：UI 渲染是否正确</span></span></code></pre></div><h3 id=\"ai-调试在什么情况下会失效\">AI 调试在什么情况下会失效？</h3><table>\n<thead>\n<tr>\n<th>失效场景</th>\n<th>原因</th>\n<th>替代方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>并发竞态条件</td>\n<td>问题不可确定性复现</td>\n<td>使用传统并发调试工具</td>\n</tr>\n<tr>\n<td>环境特定问题</td>\n<td>AI 无法访问你的运行环境</td>\n<td>提供环境信息（OS、版本、配置）</td>\n</tr>\n<tr>\n<td>第三方库内部 Bug</td>\n<td>AI 可能不了解库的内部实现</td>\n<td>查阅 GitHub Issues，降级版本</td>\n</tr>\n<tr>\n<td>内存泄漏</td>\n<td>需要 profiler 数据支持</td>\n<td>使用 Chrome DevTools / heapdump</td>\n</tr>\n<tr>\n<td>隐蔽的时序问题</td>\n<td>依赖精确的执行顺序分析</td>\n<td>添加详细时序日志，使用调试器</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> AI 调试最擅长的是&quot;有明确错误信息的问题&quot;。对于&quot;行为异常但没有报错&quot;的情况，先通过添加日志和断言来制造错误信息，再求助 AI。</p>\n</blockquote>\n<h3 id=\"如何利用-ai-编写回归测试\">如何利用 AI 编写回归测试？</h3><p>修复 Bug 后，让 AI 帮你生成回归测试以防止问题再次出现：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 向 AI 描述：&#10;// &quot;为以下修复生成回归测试：validateUser 函数之前在 body 为 undefined 时崩溃，&#10;//  现在已添加空值检查。请用 Jest 编写测试。&quot;&#10;&#10;// AI 生成的回归测试&#10;describe(&#39;validateUser&#39;, () =&gt; {&#10;  it(&#39;应该处理 undefined 输入&#39;, () =&gt; {&#10;    const result = validateUser(undefined);&#10;    expect(result.valid).toBe(false);&#10;    expect(result.error).toBe(&#39;请求体不能为空&#39;);&#10;  });&#10;&#10;  it(&#39;应该处理 null 输入&#39;, () =&gt; {&#10;    const result = validateUser(null);&#10;    expect(result.valid).toBe(false);&#10;  });&#10;&#10;  it(&#39;应该处理空对象&#39;, () =&gt; {&#10;    const result = validateUser({});&#10;    expect(result.valid).toBe(false);&#10;    expect(result.error).toContain(&#39;邮箱&#39;);&#10;  });&#10;&#10;  it(&#39;应该处理缺少 email 字段的输入&#39;, () =&gt; {&#10;    const result = validateUser({ password: &#39;123456&#39; });&#10;    expect(result.valid).toBe(false);&#10;  });&#10;&#10;  it(&#39;应该接受有效输入&#39;, () =&gt; {&#10;    const result = validateUser({&#10;      email: &#39;test@example.com&#39;,&#10;      password: &#39;123456&#39;,&#10;    });&#10;    expect(result.valid).toBe(true);&#10;  });&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 向 AI 描述：</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"为以下修复生成回归测试：validateUser 函数之前在 body 为 undefined 时崩溃，</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//  现在已添加空值检查。请用 Jest 编写测试。\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// AI 生成的回归测试</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">describe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'validateUser'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  it</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'应该处理 undefined 输入'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> validateUser</span><span style=\"color:#24292E;--shik