-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> validateUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'test@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      password: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'123456'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result.valid).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>复现→定位→修复→验证</strong>是 AI 辅助调试的核心闭环，AI 在每个阶段都能提供有价值的协助。</li>\n<li><strong>完整的错误信息</strong>是 AI 诊断的基础——粘贴完整的错误堆栈、提供相关代码、描述复现步骤，三者缺一不可。</li>\n<li><strong>结构化的调试请求</strong>（问题描述 + 错误信息 + 相关代码 + 复现步骤 + 期望行为）可以显著提升 AI 的诊断质量。</li>\n<li><strong>日志分析</strong>是 AI 的强项，面对大量日志数据时，AI 可以快速识别模式、关联错误、按优先级排列问题。</li>\n<li>AI 调试有明确的<strong>局限性</strong>：并发竞态、环境特定问题、内存泄漏等场景需要回归传统调试手段。</li>\n<li>每次修复后都应<strong>编写回归测试</strong>，AI 可以根据修复内容快速生成对应的测试用例。</li>\n</ul>\n","headings":[{"level":1,"text":"调试与排错","id":"调试与排错"},{"level":2,"text":"场景描述","id":"场景描述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心原则","id":"核心原则"},{"level":3,"text":"复现→定位→修复→验证","id":"复现-定位-修复-验证"},{"level":3,"text":"错误信息是最重要的上下文","id":"错误信息是最重要的上下文"},{"level":2,"text":"操作步骤","id":"操作步骤"},{"level":3,"text":"步骤一：收集并整理错误信息","id":"步骤一-收集并整理错误信息"},{"level":3,"text":"步骤二：构建调试请求","id":"步骤二-构建调试请求"},{"level":3,"text":"步骤三：AI 辅助日志分析","id":"步骤三-ai-辅助日志分析"},{"level":3,"text":"步骤四：验证修复方案","id":"步骤四-验证修复方案"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"常见调试模式速查","id":"常见调试模式速查"},{"level":3,"text":"提升 AI 调试效果的技巧","id":"提升-ai-调试效果的技巧"},{"level":3,"text":"AI 调试的有效提问模板","id":"ai-调试的有效提问模板"},{"level":2,"text":"常见问题","id":"常见问题"},{"level":3,"text":"AI 无法理解我的错误上下文怎么办？","id":"ai-无法理解我的错误上下文怎么办"},{"level":3,"text":"AI 调试在什么情况下会失效？","id":"ai-调试在什么情况下会失效"},{"level":3,"text":"如何利用 AI 编写回归测试？","id":"如何利用-ai-编写回归测试"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"高效协作模式","url":"/l-doc-books/h/ai-llm/ai-coding/practice/collaboration-patterns"},"next":{"title":"代码审查与质量","url":"/l-doc-books/h/ai-llm/ai-coding/practice/code-review-and-quality"}}