\"Step-by-step Execution\"]\n    EXEC --&gt; VERIFY[\"Verify output\"]\n    VERIFY --&gt;|\"Not met\"| ADJUST[\"Adjust solution\"]\n    ADJUST --&gt; EXEC\n    VERIFY --&gt;|\"Met\"| OUTPUT[\"Deliver result\"]</pre><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# .trae/skills/doc-generator/SKILL.md 的行为定义&#10;agent_behavior:&#10;  name: doc-generator&#10;  description: 根据代码自动生成 API 文档&#10;&#10;  workflow:&#10;    - step: scan&#10;      action: 扫描 src/ 目录下所有导出的函数和类型&#10;      output: 函数签名列表&#10;&#10;    - step: analyze&#10;      action: 分析每个函数的参数、返回值和用途&#10;      output: 函数文档草稿&#10;&#10;    - step: generate&#10;      action: 按照模板生成 Markdown 文档&#10;      template: docs/api/{module-name}.md&#10;      output: 文档文件&#10;&#10;    - step: validate&#10;      action: 检查文档的完整性和格式&#10;      checks:&#10;        - 所有公开函数是否都有文档&#10;        - 参数描述是否完整&#10;        - 返回值是否说明&#10;        - 示例代码是否可运行\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># .trae/skills/doc-generator/SKILL.md 的行为定义</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">agent_behavior</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">doc-generator</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  description</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">根据代码自动生成 API 文档</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  workflow</span><span style=\"color:#24292E;--shiki-dark:#E1E4