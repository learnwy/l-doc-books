r:#032F62;--shiki-dark:#9ECBFF\"> 'rejected'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.reason);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { succeeded, failed, totalTasks: subtasks.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"核心组件\">核心组件</h2><h3 id=\"多智能体协作范式\">多智能体协作范式</h3><p>多智能体系统有三种主要的协作拓扑：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph Sequential Collaboration&#10;        direction LR&#10;        SEQ_A[&quot;Agent A&quot;] --&gt;|&quot;Output&quot;| SEQ_B[&quot;Agent B&quot;] --&gt;|&quot;Output&quot;| SEQ_C[&quot;Agent C&quot;]&#10;    end\">flowchart LR\n    subgraph Sequential Collaboration\n        direction LR\n        SEQ_A[\"Agent A\"] --&gt;|\"Output\"| SEQ_B[\"Agent B\"] --&gt;|\"Output\"| SEQ_C[\"Agent C\"]\n    end</pre><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph Parallel Collaboration&#10;        COORDINATOR[&quot;Coordinator&quot;]&#10;        COORDINATOR --&gt; PAR_A[&quot;Agent A&quot;]&#10;        COORDINATOR --&gt; PAR_B[&quot;Agent B&quot;]&#10;        COORDINATOR --&gt; PAR_C[&quot;Agent C&quot;]&#10;        PAR_A --&gt; AGGREGATOR[&quot;Aggregator&quot;]&#10;        PAR_B --&gt; AGGREGATOR&#10;        PAR_C --&gt; AGGREGATOR&#10;    end\">flowchart TD\n    subgraph Parallel Collaboration\n        COORDINATOR[\"Coordinator\"]\n        COORDINATOR --&gt; PAR_A[\"Agent A\"]\n        COORDINATOR --&gt; PAR_B[\"Agent B\"]\n        COORDINATOR --&gt; PAR_C[\"Agent C\"]\n        PAR_A --&gt; AGGREGATOR[\"Aggregator\"]\n        PAR_B --&gt; AGGREGATOR\n        PAR_C --&gt; AGGREGATOR\n    end</pre><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph Hierarchical Collaboration&#10;        BOSS[&quot;Commander Agent&quot;]&#10;        BOSS --&gt; MGR1[&quot;Manager Agent 1&quot;]&#10;        BOSS --&gt; MGR2[&quot;Manager Agent 2&quot;]&#10;        MGR1 --&gt; W1[&quot;Worker Agent 1a&quot;]&#10;        MGR1 --&gt; W2[&quot;Worker Agent 1b&quot;]&#10;        MGR2 --&gt; W3[&quot;Worker Agent 2a&quot;]&#10;        MGR2 --&gt; W4[&quot;Worker Agent 2b&quot;]&#10;    end\">flowchart TD\n    subgraph Hierarchical Collaboration\n        BOSS[\"Commander Agent\"]\n        BOSS --&gt; MGR1[\"Manager Agent 1\"]\n        BOSS --&gt; MGR2[\"Manager Agent 2\"]\n        MGR1 --&gt; W1[\"Worker Agent 1a\"]\n        MGR1 --&gt; W2[\"Worker Agent 1b\"]\n        MGR2 --&gt; W3[\"Worker Agent 2a\"]\n        MGR2 --&gt; W4[\"Worker Agent 2b\"]\n    end</pre><table>\n<thead>\n<tr>\n<th>范式</th>\n<th>数据流</th>\n<th>适用场景</th>\n<th>复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>顺序协作（Sequential）</td>\n<td>线性流水线，A → B → C</td>\n<td>步骤之间有强依赖</td>\n<td>低</td>\n</tr>\n<tr>\n<td>并行协作（Parallel）</td>\n<td>分发-汇总，扇出/扇入</td>\n<td>子任务相互独立</td>\n<td>中</td>\n</tr>\n<tr>\n<td>层级协作（Hierarchical）</td>\n<td>树状多级委派</td>\n<td>超大型任务需要多层分解</td>\n<td>高</td>\n</tr>\n</tbody></table>\n<h3 id=\"通信机制\">通信机制</h3><p>子 Agent 之间的通信方式决定了系统的灵活性和效率：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type MessageChannel = &#39;direct&#39; | &#39;broadcast&#39; | &#39;event_bus&#39;;&#10;&#10;interface AgentMessage {&#10;  from: string;&#10;  to: string | &#39;all&#39;;&#10;  channel: MessageChannel;&#10;  type: &#39;request&#39; | &#39;response&#39; | &#39;notification&#39;;&#10;  payload: unknown;&#10;  timestamp: number;&#10;}&#10;&#10;interface MessageBus {&#10;  publish(message: AgentMessage): void;&#10;  subscribe(agentId: string, filter: MessageFilter): void;&#10;  waitForResponse(requestId: string, timeout: number): Promise&lt;AgentMessage&gt;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MessageChannel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'direct'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'broadcast'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'event_bus'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AgentMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  from</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  to</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'all'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  channel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MessageChannel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'request'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'response'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'notification'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  payload</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  timestamp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MessageBus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  publish</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">message</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AgentMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  subscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">agentId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">filter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MessageFilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  waitForResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">requestId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">timeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">AgentMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>通信方式</th>\n<th>特征</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>直接调用（Direct）</td>\n<td>编排器直接调用子 Agent</td>\n<td>简单层级结构</td>\n</tr>\n<tr>\n<td>消息广播（Broadcast）</td>\n<td>向所有 Agent 发送通知</td>\n<td>状态同步、全局事件</td>\n</tr>\n<tr>\n<td>事件总线（Event Bus）</td>\n<td>基于订阅的解耦通信</td>\n<td>复杂多 Agent 系统</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"优缺点分析\">优缺点分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>优势</th>\n<th>劣势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>能力</td>\n<td>专业化分工，每个子 Agent 精通一个领域</td>\n<td>需要设计合理的任务边界和分工</td>\n</tr>\n<tr>\n<td>性能</td>\n<td>独立子任务可并行执行</td>\n<td>通信和同步引入额外开销</td>\n</tr>\n<tr>\n<td>可靠性</td>\n<td>单个子 Agent 失败可隔离和重试</td>\n<td>编排逻辑本身可能成为单点故障</td>\n</tr>\n<tr>\n<td>上下文</td>\n<td>每个子 Agent 有独立的上下文空间</td>\n<td>跨 Agent 的信息传递可能有损耗</td>\n</tr>\n<tr>\n<td>可扩展性</td>\n<td>容易添加新的专业 Agent</td>\n<td>系统复杂度随 Agent 数量增长</td>\n</tr>\n<tr>\n<td>成本</td>\n<td>子 Agent 可使用更便宜的模型</td>\n<td>总 Token 消耗通常高于单 Agent</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"变体与演进\">变体与演进</h2><h3 id=\"真实案例-trae-的子-agent-分发\">真实案例：Trae 的子 Agent 分发</h3><p>Trae IDE 在处理复杂任务时会启动子 Agent（SubAgent）来隔离子任务的执行上下文：</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant U as User&#10;    participant MA as Trae Main Agent&#10;    participant SA as SubAgent&#10;    participant T as Tools&#10;&#10;    U-&gt;&gt;MA: &quot;Refactor auth module and add tests&quot;&#10;    MA-&gt;&gt;MA: Analyze task, decide to create sub-agent&#10;&#10;    MA-&gt;&gt;SA: Create SubAgent (focused on test writing)&#10;    Note over SA: Independent context window&lt;br/&gt;Dedicated system prompt&lt;br/&gt;Limited tool set&#10;&#10;    SA-&gt;&gt;T: Search existing code&#10;    T--&gt;&gt;SA: Return code content&#10;    SA-&gt;&gt;T: Write test files&#10;    T--&gt;&gt;SA: File created&#10;&#10;    SA--&gt;&gt;MA: Return test writing result&#10;    MA-&gt;&gt;MA: Aggregate main and sub-task results&#10;    MA--&gt;&gt;U: Return complete solution\">sequenceDiagram\n    participant U as User\n    participant MA as Trae Main Agent\n    participant SA as SubAgent\n    participant T as Tools\n\n    U-&gt;&gt;MA: \"Refactor auth module and add tests\"\n    MA-&gt;&gt;MA: Analyze task, decide to create sub-agent\n\n    MA-&gt;&gt;SA: Create SubAgent (focused on test writing)\n    Note over SA: Independent context window&lt;br/&gt;Dedicated system prompt&lt;br/&gt;Limited tool set\n\n    SA-&gt;&gt;T: Search existing code\n    T--&gt;&gt;SA: Return code content\n    SA-&gt;&gt;T: Write test files\n    T--&gt;&gt;SA: File created\n\n    SA--&gt;&gt;MA: Return test writing result\n    MA-&gt;&gt;MA: Aggregate main and sub-task results\n    MA--&gt;&gt;U: Return complete solution</pre><p>子 Agent 的关键设计特点：</p>\n<ul>\n<li><strong>独立上下文</strong>：子 Agent 有自己的对话历史，不会污染主 Agent 的上下文</li>\n<li><strong>工具限定</strong>：子 Agent 只能使用完成子任务所需的工具子集</li>\n<li><strong>结果回传</strong>：子 Agent 完成后将摘要结果返回给主 Agent</li>\n</ul>\n<h3 id=\"真实案例-claude-code-的任务分解\">真实案例：Claude Code 的任务分解</h3><p>Claude Code 使用类似的子进程模式来处理需要并行探索的任务：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# Claude Code 的 Task 工具工作方式（概念示意）&#10;&#10;# 主 Agent 创建一个子任务&#10;# 子任务在独立的上下文中运行&#10;# 结果汇总回主 Agent&#10;&#10;# 类比 Unix 进程模型：&#10;# 主 Agent = 父进程&#10;# SubAgent = 子进程（fork）&#10;# 结果汇总 = 子进程退出码 + 输出\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Claude Code 的 Task 工具工作方式（概念示意）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 主 Agent 创建一个子任务</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 子任务在独立的上下文中运行</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 结果汇总回主 Agent</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 类比 Unix 进程模型：</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 主 Agent = 父进程</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># SubAgent = 子进程（fork）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 结果汇总 = 子进程退出码 + 输出</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    MAIN[&quot;Claude Code Main Agent&quot;]&#10;    MAIN --&gt;|&quot;Task: Analyze API design&quot;| T1[&quot;Sub-task Agent 1&quot;]&#10;    MAIN --&gt;|&quot;Task: Check type safety&quot;| T2[&quot;Sub-task Agent 2&quot;]&#10;    MAIN --&gt;|&quot;Task: Review test coverage&quot;| T3[&quot;Sub-task Agent 3&quot;]&#10;&#10;    T1 --&gt;|&quot;Analysis report&quot;| MERGE[&quot;Result Aggregation&quot;]&#10;    T2 --&gt;|&quot;Type issue list&quot;| MERGE&#10;    T3 --&gt;|&quot;Coverage report&quot;| MERGE&#10;&#10;    MERGE --&gt; MAIN\">flowchart TD\n    MAIN[\"Claude Code Main Agent\"]\n    MAIN --&gt;|\"Task: Analyze API design\"| T1[\"Sub-task Agent 1\"]\n    MAIN --&gt;|\"Task: Check type safety\"| T2[\"Sub-task Agent 2\"]\n    MAIN --&gt;|\"Task: Review test coverage\"| T3[\"Sub-task Agent 3\"]\n\n    T1 --&gt;|\"Analysis report\"| MERGE[\"Result Aggregation\"]\n    T2 --&gt;|\"Type issue list\"| MERGE\n    T3 --&gt;|\"Coverage report\"| MERGE\n\n    MERGE --&gt; MAIN</pre><h3 id=\"演进趋势\">演进趋势</h3><table>\n<thead>\n<tr>\n<th>趋势</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Agent 市场化</td>\n<td>子 Agent 可以从&quot;市场&quot;中按需选取，按能力付费</td>\n</tr>\n<tr>\n<td>协议标准化</td>\n<td>Agent 之间通过 MCP 等标准协议互操作</td>\n</tr>\n<tr>\n<td>动态编排</td>\n<td>编排器根据任务特征动态决定需要哪些子 Agent</td>\n</tr>\n<tr>\n<td>自组织团队</td>\n<td>Agent 之间自动协商分工，无需预设层级结构</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>当单个 Agent 面对复杂、跨领域的任务时，拆分为多个专业化的子 Agent 是提升能力和效率的自然选择。编排器模式提供了集中式的任务协调，委派机制确保子任务的完整移交，扇出/扇入策略实现了并行加速。顺序、并行和层级三种协作范式适应不同的任务结构。Trae 和 Claude Code 等现代 AI 编程工具已经在实践中广泛使用子 Agent 架构来应对真实场景中的复杂编程任务。理解这些模式，将帮助你更好地使用和评估 AI 编程工具的能力。</p>\n","headings":[{"level":1,"text":"SubAgent 与多智能体","id":"subagent-与多智能体"},{"level":2,"text":"问题背景","id":"问题背景"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"模式定义","id":"模式定义"},{"level":3,"text":"为什么要拆分为子 Agent","id":"为什么要拆分为子-agent"},{"level":2,"text":"工作流程","id":"工作流程"},{"level":3,"text":"编排器模式（Orchestrator Pattern）","id":"编排器模式-orchestrator-pattern"},{"level":3,"text":"委派模式（Delegation Pattern）","id":"委派模式-delegation-pattern"},{"level":3,"text":"扇出/扇入模式（Fan-Out / Fan-In）","id":"扇出-扇入模式-fan-out-fan-in"},{"level":2,"text":"核心组件","id":"核心组件"},{"level":3,"text":"多智能体协作范式","id":"多智能体协作范式"},{"level":3,"text":"通信机制","id":"通信机制"},{"level":2,"text":"优缺点分析","id":"优缺点分析"},{"level":2,"text":"变体与演进","id":"变体与演进"},{"level":3,"text":"真实案例：Trae 的子 Agent 分发","id":"真实案例-trae-的子-agent-分发"},{"level":3,"text":"真实案例：Claude Code 的任务分解","id":"真实案例-claude-code-的任务分解"},{"level":3,"text":"演进趋势","id":"演进趋势"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Agent 核心概念","url":"/l-doc-books/h/ai-llm/ai-coding/agent-patterns/agent-fundamentals"},"next":{"title":"ReAct 模式","url":"/l-doc-books/h/ai-llm/ai-coding/agent-patterns/react-pattern"}}