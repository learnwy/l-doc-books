8-9.7 12-11 12-.7.7-6.7 1-18 1s-17.3-.3-18-1c-1.3 0\n-5-4-11-12-44.7-59.3-101.3-106.3-170-141s-145.3-54.3-229-60H0V214z\"/></svg></span><span class=\"brace-right\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMaxYMin slice\"><path d=\"M399994 0l6 6v35l-6 11c-56 104-135.3 181.3-238 232-57.3\n 28.7-117 45-179 50H-300V214h399897c43.3-7 81-15 113-26 100.7-33 179.7-91 237\n-174 2.7-5 6-9 10-13 .7-1 7.3-1 20-1h17z\"/></svg></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3175em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">community</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">L</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">c</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">summary</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9341em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.6124em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.9069em;vertical-align:-1.4763em;\"></span><span class=\"minner munder\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4306em;\"><span style=\"top:-1.5237em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord cjk_fallback mtight\">消歧</span></span></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"minner munder\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4306em;\"><span class=\"svg-align\" style=\"top:-2.202em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"stretchy\" style=\"height:0.548em;min-width:1.6em;\"><span class=\"brace-left\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMinYMin slice\"><path d=\"M0 6l6-6h17c12.688 0 19.313.3 20 1 4 4 7.313 8.3 10 13\n 35.313 51.3 80.813 93.8 136.5 127.5 55.688 33.7 117.188 55.8 184.5 66.5.688\n 0 2 .3 4 1 18.688 2.7 76 4.3 172 5h399450v120H429l-6-1c-124.688-8-235-61.7\n-331-161C60.687 138.7 32.312 99.3 7 54L0 41V6z\"/></svg></span><span class=\"brace-center\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMidYMin slice\"><path d=\"M199572 214\nc100.7 8.3 195.3 44 280 108 55.3 42 101.7 93 139 153l9 14c2.7-4 5.7-8.7 9-14\n 53.3-86.7 123.7-153 211-199 66.7-36 137.3-56.3 212-62h199568v120H200432c-178.3\n 11.7-311.7 78.3-403 201-6 8-9.7 12-11 12-.7.7-6.7 1-18 1s-17.3-.3-18-1c-1.3 0\n-5-4-11-12-44.7-59.3-101.3-106.3-170-141s-145.3-54.3-229-60H0V214z\"/></svg></span><span class=\"brace-right\" style=\"height:0.548em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.548em\" viewBox=\"0 0 400000 548\" preserveAspectRatio=\"xMaxYMin slice\"><path d=\"M399994 0l6 6v35l-6 11c-56 104-135.3 181.3-238 232-57.3\n 28.7-117 45-179 50H-300V214h399897c43.3-7 81-15 113-26 100.7-33 179.7-91 237\n-174 2.7-5 6-9 10-13 .7-1 7.3-1 20-1h17z\"/></svg></span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\">c</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">resolve</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.798em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.4763em;\"><span></span></span></span></span></span></span></span></span></span></div><ul>\n<li><strong>抽取</strong>（<a href=\"../construction/entity-extraction\">实体与关系抽取</a>）：要对每个文本块调用 LLM，含 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>g</mi></mrow><annotation encoding=\"application/x-tex\">g</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">g</span></span></span></span></span> 轮 gleanings 则乘 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>g</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">(1+g)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">g</span><span class=\"mclose\">)</span></span></span></span></span>。块数 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>N</mi><mtext>chunk</mtext></msub></mrow><annotation encoding=\"application/x-tex\">N_{\\text{chunk}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">chunk</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 随语料线性增长，这是第一大头。</li>\n<li><strong>社区摘要</strong>（<a href=\"../construction/community-detection\">社区检测与摘要</a>）：要对每个社区、每个层级 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>L</mi></mrow><annotation encoding=\"application/x-tex\">L</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\">L</span></span></span></span></span> 各生成一份报告。社区数可达数千、层级数层，这是第二大头，也是原始 GraphRAG 贵的主因。</li>\n<li><strong>消歧</strong>：模糊实体的 LLM 裁决，相对小。</li>\n</ul>\n<p>查询成本则是 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>N</mi><mtext>query</mtext></msub><mo>⋅</mo><msub><mi>C</mi><mtext>query</mtext></msub></mrow><annotation encoding=\"application/x-tex\">N_{\\text{query}} \\cdot C_{\\text{query}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">query</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">query</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span>——Local 便宜、Global 因 map-reduce 多次调用而贵。总账是 <a href=\"../foundations/graph-rag-patterns\">模式谱系</a> 里那个 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>C</mi><mtext>index</mtext></msub><mo>+</mo><msub><mi>N</mi><mtext>query</mtext></msub><mo>⋅</mo><msub><mi>C</mi><mtext>query</mtext></msub></mrow><annotation encoding=\"application/x-tex\">C_{\\text{index}} + N_{\\text{query}} \\cdot C_{\\text{query}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">index</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">query</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">query</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span>，所有降本手段都在动这个式子的某一项。</p>\n<h2 id=\"降本路线-从-33k-到个位数美元\">降本路线：从 $33k 到个位数美元</h2><p>2026 年的轻量流派本质上都是「把上面某一项归零或大幅压低」。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;  FULL[原始 GraphRAG&lt;br/&gt;$33k 量级] --&gt; A{砍哪一项?}&#10;  A --&gt;|砍社区摘要| LAZY[LazyGraphRAG&lt;br/&gt;延迟到查询时现算&lt;br/&gt;索引降至 0.1%]&#10;  A --&gt;|绕过社区结构| LIGHT[LightRAG&lt;br/&gt;双层检索&lt;br/&gt;索引约 1/6000·可增量]&#10;  A --&gt;|压多跳为一跳| HIPPO[HippoRAG&lt;br/&gt;PPR·10-30x 更省]&#10;  A --&gt;|压缩 context| PATH[PathRAG&lt;br/&gt;路径剪枝&lt;br/&gt;context -44%]&#10;  LAZY --&gt; COST[索引成本 ≈ 向量 RAG&lt;br/&gt;&lt;$5/语料]&#10;  LIGHT --&gt; COST\">flowchart TD\n  FULL[原始 GraphRAG&lt;br/&gt;$33k 量级] --&gt; A{砍哪一项?}\n  A --&gt;|砍社区摘要| LAZY[LazyGraphRAG&lt;br/&gt;延迟到查询时现算&lt;br/&gt;索引降至 0.1%]\n  A --&gt;|绕过社区结构| LIGHT[LightRAG&lt;br/&gt;双层检索&lt;br/&gt;索引约 1/6000·可增量]\n  A --&gt;|压多跳为一跳| HIPPO[HippoRAG&lt;br/&gt;PPR·10-30x 更省]\n  A --&gt;|压缩 context| PATH[PathRAG&lt;br/&gt;路径剪枝&lt;br/&gt;context -44%]\n  LAZY --&gt; COST[索引成本 ≈ 向量 RAG&lt;br/&gt;&lt;$5/语料]\n  LIGHT --&gt; COST</pre><table>\n<thead>\n<tr>\n<th>方案</th>\n<th>砍掉的成本项</th>\n<th>索引降幅</th>\n<th>代价</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>LazyGraphRAG</td>\n<td>社区摘要（延迟到查询时）</td>\n<td>至 0.1%（&lt;$5/语料）</td>\n<td>全局查询慢、贵（但仍报 700x 更低于原全局查询）</td>\n</tr>\n<tr>\n<td>LightRAG</td>\n<td>不依赖社区结构</td>\n<td>约 1/6000</td>\n<td>全局概览能力略弱于满预算</td>\n</tr>\n<tr>\n<td>HippoRAG</td>\n<td>多跳压成一次 PPR</td>\n<td>10–30x 更省</td>\n<td>偏多跳、全局摘要弱</td>\n</tr>\n<tr>\n<td>PathRAG</td>\n<td>context（路径剪枝）</td>\n<td>查询 token −44%</td>\n<td>仅省查询侧</td>\n</tr>\n<tr>\n<td>抽取换小模型</td>\n<td>抽取单价</td>\n<td>视模型</td>\n<td>抽取质量下降风险</td>\n</tr>\n</tbody></table>\n<p>要点：<strong>LazyGraphRAG 把索引成本降到与向量 RAG 同量级（报道中单语料可低至 5 美元以下）</strong>，代价是把成本后移到查询——所以它适合「语料大、但查询量不确定或较少」的场景；查询量极大时，原始 GraphRAG 把摘要预算摊薄反而可能更划算。这又回到 <a href=\"../foundations/graph-rag-patterns\">模式谱系</a> 的核心权衡：没有通用最优，按你的 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>N</mi><mtext>query</mtext></msub></mrow><annotation encoding=\"application/x-tex\">N_{\\text{query}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">query</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 和更新频率算。</p>\n<h2 id=\"增量维护-被低估的长期成本\">增量维护：被低估的长期成本</h2><p>POC 算的是「建一次图多少钱」，但生产系统的真实成本是<strong>语料一直在变</strong>。每来一批新文档，要么重建、要么增量：</p>\n<ul>\n<li><strong>全量重建</strong>：最简单也最贵，每次更新都把抽取 + 社区检测 + 摘要从头跑一遍。原始 GraphRAG 因社区结构是全局的，小改动也可能牵动整棵社区树，往往被迫近似全量重建——这是它在高频更新场景的致命伤。</li>\n<li><strong>增量更新</strong>：只对受影响的局部重抽、重连、局部重摘要。<strong>LightRAG 主打这一点</strong>——它不依赖全局社区结构，新文档只需局部接入图，无需重跑全图，这也是它在「语料常变」业务里比原始 GraphRAG 实用得多的根本原因（机制见 <a href=\"../construction/graph-construction\">图谱构建</a>）。</li>\n</ul>\n<p>增量还要处理<strong>删除与时效</strong>：旧文档下线了，对应的实体描述、关系、声明要不要撤？带时间戳的声明（<a href=\"../construction/entity-extraction\">实体抽取</a> 里的 claim）让「按时间过滤过期事实」成为可能，但工程上需要专门的失效逻辑。</p>\n<h2 id=\"省钱不能省到伤质量-常见误区\">省钱不能省到伤质量：常见误区</h2><table>\n<thead>\n<tr>\n<th>省钱动作</th>\n<th>看似省</th>\n<th>实际代价</th>\n<th>建议</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>gleaning 设 0</td>\n<td>省抽取 token</td>\n<td>漏抽，多跳断链</td>\n<td>至少 1 轮</td>\n</tr>\n<tr>\n<td>全用最小模型抽取</td>\n<td>单价低</td>\n<td>抽取噪声拖垮全图</td>\n<td>抽取用中档、摘要可用小档</td>\n</tr>\n<tr>\n<td>跳过实体消歧</td>\n<td>省裁决调用</td>\n<td>图碎成孤岛</td>\n<td>至少做精确+模糊匹配</td>\n</tr>\n<tr>\n<td>社区只做一层</td>\n<td>省摘要</td>\n<td>失去分层粒度</td>\n<td>按查询粒度需求定层数</td>\n</tr>\n<tr>\n<td>缓存全不做</td>\n<td>—</td>\n<td>重复查询重复烧钱</td>\n<td>缓存社区报告、热查询结果</td>\n</tr>\n</tbody></table>\n<p>最务实的省钱往往不在「砍步骤」，而在<strong>缓存与复用</strong>：社区报告一次生成可长期复用、热点查询结果可缓存、抽取结果可版本化避免重抽。这些是「不伤质量的免费午餐」，应优先于「砍 gleaning、换小模型」这类有副作用的手段。降本之后到底还划不划算，要回到 <a href=\"graph-rag-evaluation\">评测</a> 量出的质量提升来对账——成本和收益必须放一起看。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>GraphRAG 成本几乎全在<strong>离线索引的 LLM 调用</strong>：抽取（随语料线性）和社区摘要（每社区每层一次）是两大头，原始方案因此贵到 $33k 量级。</li>\n<li>降本路线本质是「砍某一项」：<strong>LazyGraphRAG</strong> 延迟摘要把索引降到 0.1%（&lt;$5/语料）、<strong>LightRAG</strong> 绕过社区结构（约 1/6000 且可增量）、HippoRAG 压多跳、PathRAG 压 context——但成本多是后移而非消失。</li>\n<li><strong>增量维护是被低估的长期成本</strong>：原始 GraphRAG 高频更新近乎被迫全量重建，LightRAG 的局部增量是其在变动语料里更实用的根因；还要处理删除与时效。</li>\n<li>省钱别伤质量：缓存与复用是免费午餐，应先于「砍 gleaning、换小模型」这类有副作用的手段；最终要和评测出的质量提升对账。</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>同 hub：两大成本项的来源见 <a href=\"../construction/entity-extraction\">实体与关系抽取</a> 与 <a href=\"../construction/community-detection\">社区检测与摘要</a>；增量机制见 <a href=\"../construction/graph-construction\">图谱构建</a>；各流派取舍见 <a href=\"../foundations/graph-rag-patterns\">模式谱系</a>；成本对账靠 <a href=\"graph-rag-evaluation\">评测</a>。</li>\n<li>跨 hub：增量更新的通用工程见 <a href=\"../../rag-knowledge-systems/knowledge-base-engineering/incremental-updates\">RAG 知识系统 · 增量更新</a>；智能体 RAG 的延迟成本权衡见 <a href=\"../../agentic-rag/practice/latency-cost-tradeoffs\">智能体 RAG · 延迟成本权衡</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"成本与维护","id":"成本与维护"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"成本从哪来：一张索引账单的解剖","id":"成本从哪来-一张索引账单的解剖"},{"level":2,"text":"降本路线：从 $33k 到个位数美元","id":"降本路线-从-33k-到个位数美元"},{"level":2,"text":"增量维护：被低估的长期成本","id":"增量维护-被低估的长期成本"},{"level":2,"text":"省钱不能省到伤质量：常见误区","id":"省钱不能省到伤质量-常见误区"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"评测","url":"/l-doc-books/h/ai-llm/graph-rag-knowledge/practice/graph-rag-evaluation"},"next":{"title":"落地与边界","url":"/l-doc-books/h/ai-llm/graph-rag-knowledge/practice/graph-rag-in-practice"}}