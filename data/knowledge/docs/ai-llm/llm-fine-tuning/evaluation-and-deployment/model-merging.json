5CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w_a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w_b</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                merged_state[key] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    torch.sin((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> omega) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.sin(omega) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w_a</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                    +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.sin(t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> omega) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.sin(omega) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w_b</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                )</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            merged_state[key] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w_a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w_b</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> merged_state</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>参数</th>\n<th>线性插值</th>\n<th>SLERP</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>插值空间</td>\n<td>欧几里得</td>\n<td>球面</td>\n</tr>\n<tr>\n<td>范数保持</td>\n<td>否</td>\n<td>是</td>\n</tr>\n<tr>\n<td>适用模型数</td>\n<td>2</td>\n<td>2</td>\n</tr>\n<tr>\n<td>插值比例</td>\n<td>alpha (0-1)</td>\n<td>t (0-1)</td>\n</tr>\n<tr>\n<td>推荐场景</td>\n<td>快速实验</td>\n<td>正式合并</td>\n</tr>\n</tbody></table>\n<h2 id=\"ties-与-dare\">TIES 与 DARE</h2><p>TIES（TRIM, Elect Sign, and Disjoint Merge）通过稀疏化和符号选举机制解决多模型合并时的参数冲突问题。DARE（Drop And REscale）则通过随机丢弃大部分微调增量来减少模型间的干扰：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"def ties_merge(&#10;    base_model_path: str,&#10;    model_paths: list[str],&#10;    density: float = 0.2,&#10;    weights: list[float] | None = None,&#10;) -&gt; dict:&#10;    base = AutoModelForCausalLM.from_pretrained(base_model_path)&#10;    base_state = base.state_dict()&#10;&#10;    if weights is None:&#10;        weights = [1.0 / len(model_paths)] * len(model_paths)&#10;&#10;    task_vectors = []&#10;    for path in model_paths:&#10;        model = AutoModelForCausalLM.from_pretrained(path)&#10;        tv = {}&#10;        for key in base_state:&#10;            tv[key] = model.state_dict()[key] - base_state[key]&#10;        task_vectors.append(tv)&#10;&#10;    merged_state = {}&#10;    for key in base_state:&#10;        deltas = torch.stack([tv[key] for tv in task_vectors])&#10;&#10;        magnitudes = deltas.abs()&#10;        threshold = torch.quantile(magnitudes.flatten(), 1 - density)&#10;        mask = magnitudes &gt;= threshold&#10;        trimmed = deltas * mask&#10;&#10;        signs = torch.sign(trimmed)&#10;        sign_sum = signs.sum(dim=0)&#10;        elected_sign = torch.sign(sign_sum)&#10;&#10;        aligned = trimmed * (signs == elected_sign.unsqueeze(0))&#10;        weight_tensor = torch.tensor(weights).view(-1, *([1] * (deltas.dim() - 1)))&#10;        merged_delta = (aligned * weight_tensor).sum(dim=0)&#10;&#10;        merged_state[key] = base_state[key] + merged_delta&#10;&#10;    return merged_state\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ties_merge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    base_model_path: