normalize: 1 },&#10;    outputPath: &#39;./merged-multi&#39;,&#10;  },&#10;  {&#10;    method: &#39;dare_ties&#39;,&#10;    models: [&#39;code-llama&#39;, &#39;math-llama&#39;],&#10;    parameters: { density: 0.05, weight: 0.5 },&#10;    outputPath: &#39;./merged-dare&#39;,&#10;  },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MergekitConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  method</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  models</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  parameters</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  outputPath</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> mergeConfigs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MergekitConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'slerp'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    models: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'code-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'chat-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameters: { t: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outputPath: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./merged-code-chat'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ties'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    models: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'code-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'math-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'chat-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameters: { density: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, normalize: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outputPath: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./merged-multi'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dare_ties'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    models: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'code-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'math-llama'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameters: { density: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, weight: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outputPath: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./merged-dare'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><h2 id=\"合并策略选择\">合并策略选择</h2><p>不同场景下的最佳合并策略取决于模型数量、能力差异和质量要求：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐方法</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>两个互补模型</td>\n<td>SLERP</td>\n<td>球面插值保持范数</td>\n</tr>\n<tr>\n<td>多模型能力组合</td>\n<td>TIES/DARE</td>\n<td>稀疏化减少冲突</td>\n</tr>\n<tr>\n<td>快速实验</td>\n<td>Linear</td>\n<td>最简单快速</td>\n</tr>\n<tr>\n<td>LoRA 适配器合并</td>\n<td>Task Arithmetic</td>\n<td>任务向量直接加法</td>\n</tr>\n<tr>\n<td>最高质量要求</td>\n<td>Model Stock</td>\n<td>验证集优化权重</td>\n</tr>\n</tbody></table>\n<p>合并后必须进行评估，验证各项能力是否保持且没有出现冲突。常见的问题包括：合并后某些能力退化、生成质量下降、安全对齐丢失。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>模型合并在权重空间中组合多模型能力，推理成本不增加</li>\n<li>SLERP 球面插值优于简单线性平均，适合两模型合并</li>\n<li>TIES 通过裁剪、符号选举和不相交合并解决多模型参数冲突</li>\n<li>DARE 通过随机丢弃 90%+ 微调增量实现稀疏合并</li>\n<li>mergekit 工具提供声明式配置，支持多种合并方法</li>\n<li>合并后必须评估各项能力保持情况，特别关注安全对齐是否丢失</li>\n</ul>\n","headings":[{"level":1,"text":"模型合并技术","id":"模型合并技术"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"线性插值与 SLERP","id":"线性插值与-slerp"},{"level":2,"text":"TIES 与 DARE","id":"ties-与-dare"},{"level":2,"text":"使用 mergekit 工具","id":"使用-mergekit-工具"},{"level":2,"text":"合并策略选择","id":"合并策略选择"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"微调效果评估体系","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/evaluation-and-deployment/fine-tuning-evaluation"},"next":{"title":"部署优化策略","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/evaluation-and-deployment/deployment-optimization"}}