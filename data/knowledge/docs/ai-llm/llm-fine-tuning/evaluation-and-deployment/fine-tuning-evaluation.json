-shiki-dark:#79B8FF\">float</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.95</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    min_task_score: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.80</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"general_benchmarks\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.run_general_benchmarks()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"task_benchmarks\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.run_task_benchmarks()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"llm_judge\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.run_llm_judge()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"safety_check\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.run_safety_check()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"regression_check\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.check_regression(results)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> check_regression</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, results: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        general </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"general_benchmarks\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        passed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> all</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.min_general_score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baseline_score</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> score, baseline_score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> zip</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                general[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"current\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].values(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                general[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"baseline\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].values(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"passed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: passed, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"details\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: general}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>流水线阶段</th>\n<th>耗时</th>\n<th>自动化程度</th>\n<th>阻断条件</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>通用基准</td>\n<td>10-30 min</td>\n<td>完全自动</td>\n<td>能力退化 &gt;5%</td>\n</tr>\n<tr>\n<td>任务评估</td>\n<td>5-15 min</td>\n<td>完全自动</td>\n<td>未达目标阈值</td>\n</tr>\n<tr>\n<td>LLM-as-Judge</td>\n<td>30-60 min</td>\n<td>半自动</td>\n<td>平均分 &lt;3.5/5</td>\n</tr>\n<tr>\n<td>安全检查</td>\n<td>15-30 min</td>\n<td>完全自动</td>\n<td>任何安全违规</td>\n</tr>\n<tr>\n<td>人工抽检</td>\n<td>2-4 hours</td>\n<td>手动</td>\n<td>严重质量问题</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>微调评估需要覆盖能力保持、任务适配和安全对齐三个层面</li>\n<li>自动化基准测试是检测灾难性遗忘的第一道防线</li>\n<li>LLM-as-Judge 为开放式生成提供了可扩展的评估方案</li>\n<li>位置交换和多次评估是提高 LLM 评审可靠性的关键技巧</li>\n<li>A/B 测试是上线前的最终验证，需确保统计显著性</li>\n<li>评估流水线应自动化运行，设置明确的阻断条件防止质量退化</li>\n</ul>\n","headings":[{"level":1,"text":"微调效果评估体系","id":"微调效果评估体系"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"自动化基准测试","id":"自动化基准测试"},{"level":2,"text":"LLM-as-Judge 评估","id":"llm-as-judge-评估"},{"level":2,"text":"人工评估与 A/B 测试","id":"人工评估与-a-b-测试"},{"level":2,"text":"评估流水线设计","id":"评估流水线设计"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"SFT 监督微调","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/alignment-techniques/sft"},"next":{"title":"模型合并技术","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/evaluation-and-deployment/model-merging"}}