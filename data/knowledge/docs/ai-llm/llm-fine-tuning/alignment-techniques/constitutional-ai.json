/span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"回答 B：</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">response_b</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"哪个回答更好？请回答 A 或 B，并解释原因。\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            judgment </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> generate(model, tokenizer, comparison_prompt)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            chosen </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response_a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"A\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> judgment[:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response_b</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            rejected </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response_b </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chosen </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response_a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response_a</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            pairs.append(PreferencePair(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                prompt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">prompt,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                chosen</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">chosen,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                rejected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rejected,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                principle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">principle[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                confidence</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pairs</span></span></code></pre></div><p>生成的偏好数据可以直接用于 DPO 训练或传统的 RLHF 流程：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from trl import DPOConfig, DPOTrainer&#10;&#10;dpo_config = DPOConfig(&#10;    output_dir=&quot;./cai-dpo-output&quot;,&#10;    num_train_epochs=1,&#10;    per_device_train_batch_size=4,&#10;    learning_rate=5e-7,&#10;    beta=0.1,&#10;    loss_type=&quot;sigmoid&quot;,&#10;    warmup_ratio=0.1,&#10;)&#10;&#10;trainer = DPOTrainer(&#10;    model=model,&#10;    ref_model=ref_model,&#10;    args=dpo_config,&#10;    train_dataset=ai_preference_dataset,&#10;    tokenizer=tokenizer,&#10;)&#10;&#10;trainer.train()\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trl </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DPOConfig, DPOTrainer</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dpo_config </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DPOConfig(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    output_dir</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./cai-dpo-output\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    num_train_epochs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    per_device_train_batch_size</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    learning_rate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5e-7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    beta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    loss_type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sigmoid\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    warmup_ratio</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">trainer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DPOTrainer(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    model</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    ref_model</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ref_model,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    args</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dpo_config,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    train_dataset</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ai_preference_dataset,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    tokenizer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">tokenizer,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">trainer.train()</span></span></code></pre></div><h2 id=\"cai-的优势与局限\">CAI 的优势与局限</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph 优势&#10;        A1[低标注成本] --&gt; A2[原则可审查]&#10;        A2 --&gt; A3[可扩展性强]&#10;        A3 --&gt; A4[持续改进]&#10;    end&#10;    subgraph 局限&#10;        B1[依赖模型能力] --&gt; B2[原则设计困难]&#10;        B2 --&gt; B3[自我评估偏差]&#10;        B3 --&gt; B4[效果上限]&#10;    end\">graph TB\n    subgraph 优势\n        A1[低标注成本] --&gt; A2[原则可审查]\n        A2 --&gt; A3[可扩展性强]\n        A3 --&gt; A4[持续改进]\n    end\n    subgraph 局限\n        B1[依赖模型能力] --&gt; B2[原则设计困难]\n        B2 --&gt; B3[自我评估偏差]\n        B3 --&gt; B4[效果上限]\n    end</pre><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>优势</th>\n<th>局限</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>成本</td>\n<td>无需大规模人工标注</td>\n<td>需要强大的基础模型</td>\n</tr>\n<tr>\n<td>透明性</td>\n<td>原则可公开审查</td>\n<td>原则到行为的映射不精确</td>\n</tr>\n<tr>\n<td>可扩展性</td>\n<td>原则容易扩展和修改</td>\n<td>原则间可能冲突</td>\n</tr>\n<tr>\n<td>质量</td>\n<td>多轮修正提升质量</td>\n<td>受限于模型自身能力</td>\n</tr>\n<tr>\n<td>安全性</td>\n<td>系统化的安全覆盖</td>\n<td>可能过度保守</td>\n</tr>\n</tbody></table>\n<p>CAI 的核心局限在于模型的&quot;自我批评能力&quot;受限于模型自身的理解水平。如果模型本身无法识别某类有害内容，宪法原则也无法帮助它修正。因此 CAI 通常与少量的人工审查结合使用，在关键安全维度上仍保留人类监督。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Constitutional AI 通过宪法原则引导模型自我批评和修正，大幅减少人工标注需求</li>\n<li>宪法原则应覆盖无害性、诚实性、有用性、公平性等核心维度</li>\n<li>自我修正 SFT + RLAIF 两阶段训练是 CAI 的标准流程</li>\n<li>AI 生成的偏好数据可直接用于 DPO 训练，简化了对齐流程</li>\n<li>核心局限是模型自我评估能力的上限，关键安全维度仍需人类监督</li>\n<li>CAI 与 RLHF/DPO 互补，实践中常结合使用以平衡成本和质量</li>\n</ul>\n","headings":[{"level":1,"text":"Constitutional AI 宪法式 AI","id":"constitutional-ai-宪法式-ai"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"宪法原则设计","id":"宪法原则设计"},{"level":2,"text":"自我批评与修正流程","id":"自我批评与修正流程"},{"level":2,"text":"RLAIF 训练流程","id":"rlaif-训练流程"},{"level":2,"text":"CAI 的优势与局限","id":"cai-的优势与局限"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"DPO 直接偏好优化","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/alignment-techniques/dpo"},"next":{"title":"SFT 监督微调","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/alignment-techniques/sft"}}