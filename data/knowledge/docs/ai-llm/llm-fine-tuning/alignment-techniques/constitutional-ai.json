;&#10;                f&quot;哪个回答更好？请回答 A 或 B，并解释原因。&quot;&#10;            )&#10;            judgment = generate(model, tokenizer, comparison_prompt)&#10;            chosen = response_a if &quot;A&quot; in judgment[:10] else response_b&#10;            rejected = response_b if chosen == response_a else response_a&#10;&#10;            pairs.append(PreferencePair(&#10;                prompt=prompt,&#10;                chosen=chosen,&#10;                rejected=rejected,&#10;                principle=principle[&quot;name&quot;],&#10;                confidence=0.8,&#10;            ))&#10;    return pairs\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dataclasses </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dataclass</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">@dataclass</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PreferencePair</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    prompt: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    chosen: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rejected: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    principle: