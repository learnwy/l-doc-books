hiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QLoRAConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  parameter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  recommended</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  rationale</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> qloraGuidelines</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QLoRAConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameter: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'learning_rate'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommended: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1e-4 ~ 3e-4'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rationale: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'量化后梯度噪声更大，过高的学习率会导致不稳定'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameter: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'max_grad_norm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommended: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0.3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rationale: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'比标准 LoRA 更低，防止量化梯度的大幅波动'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameter: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bnb_4bit_compute_dtype'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommended: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bfloat16'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rationale: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'BF16 比 FP16 在反量化计算中更稳定'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameter: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gradient_checkpointing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommended: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'True'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rationale: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'显存节省的核心手段，QLoRA 几乎必开'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parameter: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'optim'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommended: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'paged_adamw_8bit'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rationale: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'8-bit 优化器配合分页机制进一步压缩显存'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>建议 Rank</th>\n<th>Batch Size</th>\n<th>学习率</th>\n<th>训练时长</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>RTX 4090 + 7B</td>\n<td>16-32</td>\n<td>4</td>\n<td>2e-4</td>\n<td>2-4h</td>\n</tr>\n<tr>\n<td>RTX 4090 + 13B</td>\n<td>8-16</td>\n<td>2</td>\n<td>1.5e-4</td>\n<td>4-8h</td>\n</tr>\n<tr>\n<td>A100 40G + 70B</td>\n<td>16-32</td>\n<td>2</td>\n<td>1e-4</td>\n<td>12-24h</td>\n</tr>\n</tbody></table>\n<h2 id=\"lora-vs-qlora-选择\">LoRA vs QLoRA 选择</h2><p>在有足够 GPU 资源时，标准 LoRA 通常是更好的选择，因为量化会引入精度损失和训练速度下降：</p>\n<table>\n<thead>\n<tr>\n<th>决策因素</th>\n<th>选择 LoRA</th>\n<th>选择 QLoRA</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>显存充足（≥2x LoRA需求）</td>\n<td>✅</td>\n<td></td>\n</tr>\n<tr>\n<td>单卡训练大模型（&gt;13B）</td>\n<td></td>\n<td>✅</td>\n</tr>\n<tr>\n<td>追求最佳效果</td>\n<td>✅</td>\n<td></td>\n</tr>\n<tr>\n<td>硬件预算有限</td>\n<td></td>\n<td>✅</td>\n</tr>\n<tr>\n<td>训练速度优先</td>\n<td>✅</td>\n<td></td>\n</tr>\n<tr>\n<td>需要合并后量化部署</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>QLoRA 通过 NF4 量化将基础模型压缩到 4-bit，使单张消费级 GPU 能微调 70B 模型</li>\n<li>NormalFloat4 是信息论最优的 4-bit 格式，结合双重量化进一步压缩存储</li>\n<li><code>prepare_model_for_kbit_training</code> 和 <code>paged_adamw_8bit</code> 是 QLoRA 的关键配置</li>\n<li>超参数需要更保守：更低的梯度裁剪阈值（0.3），必开梯度检查点</li>\n<li>有足够 GPU 资源时优先选择标准 LoRA，QLoRA 的核心价值是降低硬件门槛</li>\n</ul>\n","headings":[{"level":1,"text":"QLoRA 量化微调","id":"qlora-量化微调"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"NormalFloat4 量化","id":"normalfloat4-量化"},{"level":2,"text":"QLoRA 完整训练流程","id":"qlora-完整训练流程"},{"level":2,"text":"QLoRA 调优策略","id":"qlora-调优策略"},{"level":2,"text":"LoRA vs QLoRA 选择","id":"lora-vs-qlora-选择"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"LoRA 原理与实践","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/parameter-efficient-methods/lora"},"next":{"title":"其他参数高效方法","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/parameter-efficient-methods/other-peft-methods"}}