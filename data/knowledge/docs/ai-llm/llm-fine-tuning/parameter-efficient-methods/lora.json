dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    scenario: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'风格迁移（如特定写作风格）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommendedRank: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    targetModules: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'q_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'v_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gate_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    reasoning: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'风格涉及注意力模式和 FFN 层的联合调整'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    scenario: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'多任务适配'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recommendedRank: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    targetModules: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'q_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'k_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'v_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'o_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gate_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'down_proj'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    reasoning: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'多任务需要最大参数容量，接近全量微调的能力'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>Rank</th>\n<th>可训练参数比</th>\n<th>训练速度</th>\n<th>效果</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>4-8</td>\n<td>~0.05%</td>\n<td>最快</td>\n<td>基础</td>\n<td>格式调整</td>\n</tr>\n<tr>\n<td>16-32</td>\n<td>~0.2%</td>\n<td>快</td>\n<td>良好</td>\n<td>领域适配</td>\n</tr>\n<tr>\n<td>64-128</td>\n<td>~1%</td>\n<td>中等</td>\n<td>优秀</td>\n<td>深度定制</td>\n</tr>\n<tr>\n<td>256+</td>\n<td>~3%</td>\n<td>较慢</td>\n<td>接近全量</td>\n<td>极端场景</td>\n</tr>\n</tbody></table>\n<h2 id=\"lora-合并与部署\">LoRA 合并与部署</h2><p>训练完成后，LoRA 适配器可以合并回基础模型，消除推理时的额外开销：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from peft import PeftModel&#10;from transformers import AutoModelForCausalLM&#10;&#10;base_model = AutoModelForCausalLM.from_pretrained(&#10;    &quot;Qwen/Qwen3-8B&quot;,&#10;    torch_dtype=&quot;auto&quot;,&#10;)&#10;&#10;lora_model = PeftModel.from_pretrained(base_model, &quot;./lora-adapter&quot;)&#10;&#10;merged_model = lora_model.merge_and_unload()&#10;merged_model.save_pretrained(&quot;./merged-model&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> peft </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PeftModel</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> transformers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> AutoModelForCausalLM</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">base_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> AutoModelForCausalLM.from_pretrained(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"Qwen/Qwen3-8B\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    torch_dtype</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"auto\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">lora_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PeftModel.from_pretrained(base_model, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./lora-adapter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">merged_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lora_model.merge_and_unload()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">merged_model.save_pretrained(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./merged-model\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>LoRA 的另一个独特优势是<strong>适配器可组合</strong>——同一基础模型可以加载不同的 LoRA 适配器来切换不同的行为，无需维护多个完整模型副本。这对于多租户场景（每个客户一个适配器）非常有价值。</p>\n<h2 id=\"lora-变体\">LoRA 变体</h2><p>LoRA 的成功催生了多种改进变体，每种都针对特定的局限性进行了优化：</p>\n<table>\n<thead>\n<tr>\n<th>变体</th>\n<th>核心改进</th>\n<th>优势</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DoRA</td>\n<td>权重分解为方向和幅度</td>\n<td>效果更接近全量微调</td>\n<td>高质量需求</td>\n</tr>\n<tr>\n<td>AdaLoRA</td>\n<td>动态调整各层 rank</td>\n<td>参数分配更高效</td>\n<td>资源受限</td>\n</tr>\n<tr>\n<td>LoRA+</td>\n<td>不同学习率用于 A/B</td>\n<td>收敛更快更稳定</td>\n<td>通用</td>\n</tr>\n<tr>\n<td>rsLoRA</td>\n<td>缩放因子除以 √r</td>\n<td>大 rank 时更稳定</td>\n<td>rank &gt; 64</td>\n</tr>\n<tr>\n<td>GLoRA</td>\n<td>全局低秩适配</td>\n<td>跨层参数共享</td>\n<td>极低参数预算</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>LoRA 将权重更新分解为低秩矩阵乘积，可训练参数仅占 0.1-1%，大幅降低显存需求</li>\n<li>rank 选择遵循任务复杂度原则：格式调整 8-16，领域适配 16-32，深度定制 64+</li>\n<li>target_modules 应覆盖注意力层（q/k/v/o_proj），复杂任务可扩展到 FFN 层</li>\n<li>训练后可合并回基础模型消除推理开销，也可保持独立适配器实现多租户部署</li>\n<li>LoRA 变体（DoRA、AdaLoRA 等）针对特定场景进一步优化，应根据需求选择</li>\n</ul>\n","headings":[{"level":1,"text":"LoRA 原理与实践","id":"lora-原理与实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"LoRA 配置与训练","id":"lora-配置与训练"},{"level":2,"text":"秩与目标模块选择","id":"秩与目标模块选择"},{"level":2,"text":"LoRA 合并与部署","id":"lora-合并与部署"},{"level":2,"text":"LoRA 变体","id":"lora-变体"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"全量微调","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/fine-tuning-fundamentals/full-fine-tuning"},"next":{"title":"QLoRA 量化微调","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/parameter-efficient-methods/qlora"}}