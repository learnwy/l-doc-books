E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> customerResponse</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> callWithAdapter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'如何退货？'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'customer-service'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> codeResponse</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> callWithAdapter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'审查这段代码'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'code-review'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>LoRA 热切换的优势是多个适配器共享基础模型的 GPU 显存，每个适配器只需额外几十 MB 的内存。这使得单台服务器可以同时服务数十个微调版本。</p>\n<h2 id=\"监控与自动扩缩容\">监控与自动扩缩容</h2><p>生产推理服务需要完善的监控和自动扩缩容策略：</p>\n<table>\n<thead>\n<tr>\n<th>监控指标</th>\n<th>告警阈值</th>\n<th>扩缩容依据</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>请求延迟 P95</td>\n<td>&gt; 10s</td>\n<td>纵向扩容（更多 GPU）</td>\n</tr>\n<tr>\n<td>GPU 利用率</td>\n<td>&gt; 90% 持续 5min</td>\n<td>横向扩容（更多实例）</td>\n</tr>\n<tr>\n<td>队列深度</td>\n<td>&gt; 50</td>\n<td>横向扩容</td>\n</tr>\n<tr>\n<td>Token/s 吞吐</td>\n<td>&lt; 预期 50%</td>\n<td>检查模型配置</td>\n</tr>\n<tr>\n<td>错误率</td>\n<td>&gt; 1%</td>\n<td>排查故障</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>vLLM 的 PagedAttention 是当前最高效的推理引擎，GPU 利用率可达 90%+</li>\n<li>连续批处理是现代 LLM 推理的核心优化，避免了短请求等待长请求的问题</li>\n<li>LoRA 热切换允许单台服务器同时服务数十个微调版本，共享基础模型显存</li>\n<li>推理 API 应兼容 OpenAI 格式，降低客户端集成成本</li>\n<li>生产部署需要完善的监控告警和自动扩缩容策略</li>\n</ul>\n","headings":[{"level":1,"text":"模型服务化部署","id":"模型服务化部署"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"vLLM 部署","id":"vllm-部署"},{"level":2,"text":"批处理与并发优化","id":"批处理与并发优化"},{"level":2,"text":"多模型与 LoRA 热切换","id":"多模型与-lora-热切换"},{"level":2,"text":"监控与自动扩缩容","id":"监控与自动扩缩容"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"模型量化与压缩","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/evaluation-deployment/quantization"},"next":null}