le=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'格式'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, description: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'是否遵循输出格式要求'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, weight: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  scaleMin: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  scaleMax: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>LLM-as-Judge 的主要偏见包括位置偏见（偏好第一个回答）、冗长偏见（偏好较长的回答）和自我偏好（评审模型偏好同家族模型的输出风格）。缓解策略包括随机交换回答顺序、多次评估取平均、使用不同模型交叉评估。</p>\n<blockquote>\n<p>本文是评估方法学的<strong>深入层</strong>（三种方法的组合策略与偏见治理）；评估体系在微调项目收尾流程中的位置与决策框架（含能力保持/安全对齐层面），见同 hub 第四章的<a href=\"../../evaluation-and-deployment/fine-tuning-evaluation\">微调效果评估体系</a>。</p>\n</blockquote>\n<h2 id=\"a-b-测试与对比评估\">A/B 测试与对比评估</h2><p>对比评估让评估者直接比较两个模型的输出，是最可靠的评估方式：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ABTestResult {&#10;  prompt: string;&#10;  modelA: string;&#10;  modelB: string;&#10;  winner: &#39;A&#39; | &#39;B&#39; | &#39;tie&#39;;&#10;  confidence: number;&#10;  dimension: string;&#10;}&#10;&#10;const calculateWinRate = (&#10;  results: ABTestResult[],&#10;): {&#10;  winRateA: number;&#10;  winRateB: number;&#10;  tieRate: number;&#10;  byDimension: Record&lt;string, { A: number; B: number; tie: number }&gt;;&#10;} =&gt; {&#10;  const total = results.length;&#10;  const winsA = results.filter((r) =&gt; r.winner === &#39;A&#39;).length;&#10;  const winsB = results.filter((r) =&gt; r.winner === &#39;B&#39;).length;&#10;  const ties = results.filter((r) =&gt; r.winner === &#39;tie&#39;).length;&#10;&#10;  const byDimension: Record&lt;string, { A: number; B: number; tie: number }&gt; = {};&#10;  for (const r of results) {&#10;    if (!byDimension[r.dimension]) {&#10;      byDimension[r.dimension] = { A: 0, B: 0, tie: 0 };&#10;    }&#10;    byDimension[r.dimension][r.winner === &#39;tie&#39; ? &#39;tie&#39; : r.winner]++;&#10;  }&#10;&#10;  return {&#10;    winRateA: winsA / total,&#10;    winRateB: winsB / total,&#10;    tieRate: ties / total,&#10;    byDimension,&#10;  };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ABTestResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  prompt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  modelA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  modelB</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  winner</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'A'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'B'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'tie'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  confidence</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  dimension</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> calculateWinRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  results</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ABTestResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">): {</span></span>\n<span c