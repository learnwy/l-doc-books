eadings":[{"level":1,"text":"微调评估方法","id":"微调评估方法"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"自动化基准测试","id":"自动化基准测试"},{"level":2,"text":"LLM-as-Judge 评估","id":"llm-as-judge-评估"},{"level":2,"text":"A/B 测试与对比评估","id":"a-b-测试与对比评估"},{"level":2,"text":"退化检测与安全评估","id":"退化检测与安全评估"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"部署优化策略","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/evaluation-and-deployment/deployment-optimization"},"next":{"title":"模型量化与压缩","url":"/l-doc-books/h/ai-llm/llm-fine-tuning/evaluation-deployment/quantization"}}