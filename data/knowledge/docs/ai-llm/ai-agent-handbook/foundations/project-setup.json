uot;: {&#10;    &quot;typecheck&quot;: &quot;tsc --noEmit&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"shared\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"private\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"type\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"module\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"main\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./src/index.ts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"scripts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"typecheck\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tsc --noEmit\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>shared/src/index.ts 定义通用类型：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export interface ChatMessage {&#10;  role: &#39;user&#39; | &#39;assistant&#39; | &#39;system&#39;;&#10;  content: string;&#10;}&#10;&#10;export interface ChatRequest {&#10;  messages: ChatMessage[];&#10;  model?: string;&#10;}&#10;&#10;export interface ChatResponse {&#10;  message: ChatMessage;&#10;  usage?: { inputTokens: number; outputTokens: number };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ChatMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  role</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'user'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'assistant'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'system'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  content</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ChatRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  messages</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ChatMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  model</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ChatResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  message</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ChatMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  usage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">inputTokens</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">outputTokens</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>在 agent 和 web 中引用 shared：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"cd ../agent &amp;&amp; pnpm add shared --workspace&#10;cd ../web &amp;&amp; pnpm add shared --workspace\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">cd</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ../agent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pnpm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> add</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> shared</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --workspace</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">cd</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ../web</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pnpm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> add</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> shared</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --workspace</span></span></code></pre></div><hr>\n<h2 id=\"完整目录结构\">完整目录结构</h2><div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"ai-agent-platform/&#10;├── pnpm-workspace.yaml&#10;├── package.json&#10;├── tsconfig.base.json&#10;├── agent/&#10;│   ├── package.json&#10;│   ├── tsconfig.json&#10;│   └── src/&#10;│       ├── index.ts&#10;│       ├── routes/&#10;│       ├── providers/&#10;│       ├── tools/&#10;│       └── skills/&#10;├── web/&#10;│   ├── package.json&#10;│   ├── tsconfig.json&#10;│   └── src/&#10;│       ├── main.tsx&#10;│       ├── App.tsx&#10;│       ├── pages/&#10;│       ├── components/&#10;│       └── hooks/&#10;└── shared/&#10;    ├── package.json&#10;    └── src/&#10;        └── index.ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>ai-agent-platform/</span></span>\n<span class=\"line\"><span>├── pnpm-workspace.yaml</span></span>\n<span class=\"line\"><span>├── package.json</span></span>\n<span class=\"line\"><span>├── tsconfig.base.json</span></span>\n<span class=\"line\"><span>├── agent/</span></span>\n<span class=\"line\"><span>│   ├── package.json</span></span>\n<span class=\"line\"><span>│   ├── tsconfig.json</span></span>\n<span class=\"line\"><span>│   └── src/</span></span>\n<span class=\"line\"><span>│       ├── index.ts</span></span>\n<span class=\"line\"><span>│       ├── routes/</span></span>\n<span class=\"line\"><span>│       ├── providers/</span></span>\n<span class=\"line\"><span>│       ├── tools/</span></span>\n<span class=\"line\"><span>│       └── skills/</span></span>\n<span class=\"line\"><span>├── web/</span></span>\n<span class=\"line\"><span>│   ├── package.json</span></span>\n<span class=\"line\"><span>│   ├── tsconfig.json</span></span>\n<span class=\"line\"><span>│   └── src/</span></span>\n<span class=\"line\"><span>│       ├── main.tsx</span></span>\n<span class=\"line\"><span>│       ├── App.tsx</span></span>\n<span class=\"line\"><span>│       ├── pages/</span></span>\n<span class=\"line\"><span>│       ├── components/</span></span>\n<span class=\"line\"><span>│       └── hooks/</span></span>\n<span class=\"line\"><span>└── shared/</span></span>\n<span class=\"line\"><span>    ├── package.json</span></span>\n<span class=\"line\"><span>    └── src/</span></span>\n<span class=\"line\"><span>        └── index.ts</span></span></code></pre></div><hr>\n<h2 id=\"验证搭建结果\">验证搭建结果</h2><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"pnpm install&#10;&#10;pnpm dev:agent&#10;# 输出: Agent server running on http://localhost:3000&#10;&#10;curl http://localhost:3000/health&#10;# 输出: {&quot;status&quot;:&quot;ok&quot;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pnpm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> install</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pnpm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> dev:agent</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 输出: Agent server running on http://localhost:3000</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">curl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> http://localhost:3000/health</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 输出: {\"status\":\"ok\"}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant Dev as 开发者&#10;    participant Agent as Agent 服务 :3000&#10;    participant Web as React 前端 :5173&#10;&#10;    Dev-&gt;&gt;Agent: curl /health&#10;    Agent--&gt;&gt;Dev: {&quot;status&quot;:&quot;ok&quot;}&#10;    Dev-&gt;&gt;Web: 浏览器访问&#10;    Web-&gt;&gt;Agent: fetch /api/chat&#10;    Agent--&gt;&gt;Web: JSON 响应\">sequenceDiagram\n    participant Dev as 开发者\n    participant Agent as Agent 服务 :3000\n    participant Web as React 前端 :5173\n\n    Dev-&gt;&gt;Agent: curl /health\n    Agent--&gt;&gt;Dev: {\"status\":\"ok\"}\n    Dev-&gt;&gt;Web: 浏览器访问\n    Web-&gt;&gt;Agent: fetch /api/chat\n    Agent--&gt;&gt;Web: JSON 响应</pre><hr>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>为什么错</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>把 API Key 写进 <code>package.json</code> 或源码</td>\n<td>一旦提交即永久泄漏，仓库历史无法真正删除</td>\n<td>全部走 <code>.env</code> + <code>.gitignore</code>，CI 中用 secret 注入</td>\n</tr>\n<tr>\n<td>依赖版本写 <code>latest</code> 或省略</td>\n<td>次日构建即可能因上游 breaking change 而失败，且不可复现</td>\n<td>锁定主版本区间（如 <code>&quot;ai&quot;: &quot;^6.0.0&quot;</code>），升级走显式 diff review</td>\n</tr>\n<tr>\n<td>agent/web/shared 三包混在一个 <code>package.json</code></td>\n<td>前端构建会把服务端依赖一起打包，部署粒度也无法拆分</td>\n<td>Monorepo 分包，各包独立声明依赖与构建脚本</td>\n</tr>\n<tr>\n<td>先写业务再补目录结构</td>\n<td>providers/tools/skills 边界事后很难划清，容易长成单文件上帝模块</td>\n<td>初始化时就把目录骨架和类型契约（shared）立起来</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>采用 pnpm workspace 管理 Monorepo，agent/、web/、shared/ 三个包各司其职。</li>\n<li>TypeScript 配置通过 <code>tsconfig.base.json</code> 统一继承，保证编译选项一致。</li>\n<li>Hono 提供轻量高性能的 API 层，<code>@hono/node-server</code> 运行在 Node.js 环境。</li>\n<li>React 前端通过 Vite 脚手架初始化，使用 <code>@ai-sdk/react</code> 集成 AI 能力。</li>\n<li>shared 包承载跨端共享的类型定义，通过 <code>workspace:</code> 协议引用。</li>\n<li>完成搭建后务必通过 <code>/health</code> 端点验证服务正常运行。</li>\n</ul>\n","headings":[{"level":1,"text":"项目搭建","id":"项目搭建"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"整体架构","id":"整体架构"},{"level":2,"text":"初始化项目","id":"初始化项目"},{"level":2,"text":"TypeScript 配置","id":"typescript-配置"},{"level":2,"text":"搭建 Agent 服务","id":"搭建-agent-服务"},{"level":2,"text":"搭建 Web 前端","id":"搭建-web-前端"},{"level":2,"text":"搭建 Shared 包","id":"搭建-shared-包"},{"level":2,"text":"完整目录结构","id":"完整目录结构"},{"level":2,"text":"验证搭建结果","id":"验证搭建结果"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"AI SDK 6 概览","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/foundations/ai-sdk-overview"}}