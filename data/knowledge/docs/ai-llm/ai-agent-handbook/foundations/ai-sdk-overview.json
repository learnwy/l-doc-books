05CC5;--shiki-dark:#79B8FF\"> start</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> doGenerate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Duration: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Date</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> start</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}ms`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"框架对比\">框架对比</h2><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>AI SDK</th>\n<th>LangChain.js</th>\n<th>直接调用 API</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>类型安全</td>\n<td>原生 TypeScript，完整类型</td>\n<td>部分类型支持</td>\n<td>需自行定义类型</td>\n</tr>\n<tr>\n<td>流式处理</td>\n<td>内置 streamText</td>\n<td>需配置 Streaming</td>\n<td>手动处理 SSE</td>\n</tr>\n<tr>\n<td>工具调用</td>\n<td>声明式 tool()</td>\n<td>链式 Tool 绑定</td>\n<td>手动拼装 JSON</td>\n</tr>\n<tr>\n<td>Agent 循环</td>\n<td>stopWhen 循环控制</td>\n<td>AgentExecutor</td>\n<td>完全自行实现</td>\n</tr>\n<tr>\n<td>Provider 切换</td>\n<td>换一行代码</td>\n<td>换 LLM 类实例</td>\n<td>重写请求逻辑</td>\n</tr>\n<tr>\n<td>前端集成</td>\n<td>useChat</td>\n<td>无官方 React 支持</td>\n<td>完全自行实现</td>\n</tr>\n<tr>\n<td>包体积</td>\n<td>轻量（核心 &lt; 50KB）</td>\n<td>较重（依赖链长）</td>\n<td>最轻</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>低</td>\n<td>中等（概念较多）</td>\n<td>高（需理解底层协议）</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"安装与版本\">安装与版本</h2><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"pnpm add ai @ai-sdk/openai @ai-sdk/react\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pnpm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> add</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ai</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> @ai-sdk/openai</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> @ai-sdk/react</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;dependencies&quot;: {&#10;    &quot;ai&quot;: &quot;^6.0.0&quot;,&#10;    &quot;@ai-sdk/openai&quot;: &quot;^3.0.0&quot;,&#10;    &quot;@ai-sdk/react&quot;: &quot;^3.0.0&quot;,&#10;    &quot;zod&quot;: &quot;^4.1.8&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"dependencies\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"ai\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"^6.0.0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"@ai-sdk/openai\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"^3.0.0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"@ai-sdk/react\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"^3.0.0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"zod\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"^4.1.8\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p>本手册基于 AI SDK 6（npm 包 <code>ai@^6</code>，配套 Provider 包为 <code>@ai-sdk/*@^3</code>）撰写。AI SDK 大版本迭代很快，新 major 发布时请优先阅读官方 Migration Guide——v4 → v5 就曾批量重命名核心 API（如 <code>maxSteps</code> → <code>stopWhen: stepCountIs()</code>、<code>parameters</code> → <code>inputSchema</code>、<code>CoreMessage</code> 拆分为 <code>ModelMessage</code>/<code>UIMessage</code>），照搬旧示例会直接编译失败。</p>\n</blockquote>\n<hr>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>为什么错</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>照旧教程硬编码 <code>maxSteps: 5</code> 这类 v4 API</td>\n<td>v5+ 已移除该参数，运行时静默忽略或直接类型报错</td>\n<td>用 <code>stopWhen: stepCountIs(5)</code>；升级大版本先读 Migration Guide</td>\n</tr>\n<tr>\n<td>把所有模型调用都写成 <code>generateText</code></td>\n<td>聊天场景一次性等待全部生成，首 token 延迟等于总生成时长</td>\n<td>交互界面一律 <code>streamText</code> + 流式协议，后端批处理才用 <code>generateText</code></td>\n</tr>\n<tr>\n<td>在中间件里做重 IO（同步写库、发 HTTP）</td>\n<td>中间件在每次模型调用的热路径上，重 IO 会放大全部请求延迟</td>\n<td>中间件只做轻量横切（日志、计时、脱敏），重操作异步化或下沉到工具层</td>\n</tr>\n<tr>\n<td>用 <code>as any</code> 绕过 <code>tool()</code> 的 Schema 类型</td>\n<td>工具入参失去类型约束，模型传错参数只能在运行时爆炸</td>\n<td>让 Zod schema 单一事实源驱动类型推断，编译期就拦截参数错误</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>AI SDK 分为 Core、Provider、UI 三层，职责清晰，按需引入。</li>\n<li><code>generateText</code> 用于一次性生成，<code>streamText</code> 用于流式输出，<code>generateObject</code> 用于结构化输出。</li>\n<li>工具调用通过声明式 <code>tool()</code> 定义，模型自主决定何时调用。</li>\n<li>Agent 循环基于 <code>stopWhen</code> 终止条件实现 ReAct 模式，自动处理多轮工具调用。</li>\n<li>中间件系统支持日志、缓存、监控等横切关注点的注入。</li>\n<li>相比 LangChain.js 和直接调用 API，AI SDK 在类型安全、流式处理和前端集成方面优势明显。</li>\n</ul>\n","headings":[{"level":1,"text":"AI SDK 6 概览","id":"ai-sdk-6-概览"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么选择 AI SDK","id":"为什么选择-ai-sdk"},{"level":2,"text":"核心模块","id":"核心模块"},{"level":2,"text":"核心 API","id":"核心-api"},{"level":3,"text":"generateText","id":"generatetext"},{"level":3,"text":"streamText","id":"streamtext"},{"level":3,"text":"generateObject","id":"generateobject"},{"level":2,"text":"工具调用","id":"工具调用"},{"level":2,"text":"Agent 循环","id":"agent-循环"},{"level":2,"text":"中间件","id":"中间件"},{"level":2,"text":"框架对比","id":"框架对比"},{"level":2,"text":"安装与版本","id":"安装与版本"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"项目搭建","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/foundations/project-setup"},"next":{"title":"多模型 Provider","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/foundations/multi-model-provider"}}