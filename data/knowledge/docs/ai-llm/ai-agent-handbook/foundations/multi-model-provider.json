\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ollama</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'qwen3:8b'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getModel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">modelId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LanguageModel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> factory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> providers[modelId];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">factory) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Unknown model: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">modelId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> factory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"provider-对比\">Provider 对比</h2><table>\n<thead>\n<tr>\n<th>Provider</th>\n<th>SDK 包</th>\n<th>兼容模式</th>\n<th>代表模型</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>OpenAI</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>原生</td>\n<td>gpt-5, gpt-5-mini</td>\n<td>生态最完善</td>\n</tr>\n<tr>\n<td>Anthropic</td>\n<td><code>@ai-sdk/anthropic</code></td>\n<td>原生</td>\n<td>Claude Sonnet 4.5 / Opus 4.5</td>\n<td>长上下文，推理强</td>\n</tr>\n<tr>\n<td>Google</td>\n<td><code>@ai-sdk/google</code></td>\n<td>原生</td>\n<td>Gemini 3 系列</td>\n<td>百万级 token 上下文</td>\n</tr>\n<tr>\n<td>DeepSeek</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>OpenAI 兼容</td>\n<td>deepseek-chat/reasoner</td>\n<td>性价比高</td>\n</tr>\n<tr>\n<td>豆包</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>OpenAI 兼容</td>\n<td>doubao-1.5-pro</td>\n<td>字节跳动，中文优化</td>\n</tr>\n<tr>\n<td>GLM</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>OpenAI 兼容</td>\n<td>glm-4-plus</td>\n<td>智谱 AI</td>\n</tr>\n<tr>\n<td>Qwen</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>OpenAI 兼容</td>\n<td>qwen-plus/max</td>\n<td>阿里云，多模态</td>\n</tr>\n<tr>\n<td>MiniMax</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>OpenAI 兼容</td>\n<td>MiniMax-Text-01</td>\n<td>长文本处理</td>\n</tr>\n<tr>\n<td>Ollama</td>\n<td><code>@ai-sdk/openai</code></td>\n<td>OpenAI 兼容</td>\n<td>llama3, qwen3, gemma3</td>\n<td>本地部署，隐私安全</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p>模型 ID 迭代极快，且日期后缀 ID（如 <code>claude-sonnet-4-5-20250929</code>）会随版本滚动退役。接入前务必以各厂商官方 Models 文档核对 ID 当前有效；注册表里建议用稳定的别名映射到具体 ID。</p>\n</blockquote>\n<hr>\n<h2 id=\"在路由中使用\">在路由中使用</h2><p>将 Provider 注册表集成到 Hono 路由：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { Hono } from &#39;hono&#39;;&#10;import { generateText } from &#39;ai&#39;;&#10;import { getModel } from &#39;../providers/index.js&#39;;&#10;&#10;const chat = new Hono();&#10;&#10;chat.post(&#39;/chat&#39;, async (c) =&gt; {&#10;  const { messages, model: modelId = &#39;gpt-5&#39; } = await c.req.json();&#10;&#10;  const { text, usage } = await generateText({&#10;    model: getModel(modelId),&#10;    messages,&#10;  });&#10;&#10;  return c.json({ text, usage });&#10;});&#10;&#10;export default chat;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Hono } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'hono'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { generateText } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ai'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { getModel } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../providers/index.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> chat</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Hono</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">chat.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/chat'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">messages</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">model</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">modelId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'gpt-5'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.req.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">usage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    model: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getModel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(modelId),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    messages,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ text, usage });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chat;</span></span></code></pre></div><p>请求时通过 <code>model</code> 字段切换模型：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"curl -X POST http://localhost:3000/chat \\&#10;  -H &quot;Content-Type: application/json&quot; \\&#10;  -d &#39;{&#10;    &quot;model&quot;: &quot;deepseek-chat&quot;,&#10;    &quot;messages&quot;: [{&quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;你好&quot;}]&#10;  }&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">curl</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -X</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> POST</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> http://localhost:3000/chat</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -H</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"Content-Type: application/json\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -d</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '{</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"model\": \"deepseek-chat\",</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"messages\": [{\"role\": \"user\", \"content\": \"你好\"}]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }'</span></span></code></pre></div><hr>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>为什么错</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>把模型 ID 直接散落在业务代码里</td>\n<td>换模型要全局 grep 替换，还容易漏掉日期后缀变体</td>\n<td>集中到 Provider 注册表，业务层只引用稳定别名</td>\n</tr>\n<tr>\n<td>为每个厂商复制一套调用代码</td>\n<td>每家 SDK 升级都要同步改 N 处，行为还不一致</td>\n<td>统一走 AI SDK Provider 抽象，差异收敛在 <code>createOpenAI({ baseURL })</code> 一类配置里</td>\n</tr>\n<tr>\n<td>用不存在的型号名&quot;脑补&quot;示例</td>\n<td>运行时才报 invalid model 错误，且读者无法复现</td>\n<td>示例只用官方文档可查证的 ID，并注明核对的文档版本/日期</td>\n</tr>\n<tr>\n<td>默认模型永远用最强档</td>\n<td>简单分类、摘要也跑旗舰档，成本放大数十倍</td>\n<td>注册表按任务分层：gpt-5 做主控，gpt-5-mini/nano 做轻量任务</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>AI SDK 的 Provider 层将不同厂商 API 统一为 <code>LanguageModel</code> 接口，实现一行代码切换模型。</li>\n<li>大量国产模型兼容 OpenAI API 格式，使用 <code>createOpenAI</code> + 自定义 <code>baseURL</code> 即可接入。</li>\n<li>所有 API Key 通过环境变量管理，绝不硬编码，务必将 <code>.env</code> 加入 <code>.gitignore</code>。</li>\n<li>通过 Provider 注册表集中管理模型实例，在路由中通过模型标识符动态选择。</li>\n<li>Ollama 支持本地模型运行，适用于离线开发和隐私敏感场景。</li>\n</ul>\n","headings":[{"level":1,"text":"多模型 Provider","id":"多模型-provider"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Provider 架构","id":"provider-架构"},{"level":2,"text":"环境变量配置","id":"环境变量配置"},{"level":2,"text":"Provider 安装","id":"provider-安装"},{"level":2,"text":"逐一配置 Provider","id":"逐一配置-provider"},{"level":3,"text":"OpenAI","id":"openai"},{"level":3,"text":"Anthropic","id":"anthropic"},{"level":3,"text":"DeepSeek","id":"deepseek"},{"level":3,"text":"豆包 (Doubao)","id":"豆包-doubao"},{"level":3,"text":"GLM (智谱)","id":"glm-智谱"},{"level":3,"text":"Qwen (通义千问)","id":"qwen-通义千问"},{"level":3,"text":"MiniMax","id":"minimax"},{"level":3,"text":"Ollama（本地模型）","id":"ollama-本地模型"},{"level":2,"text":"Provider 注册表","id":"provider-注册表"},{"level":2,"text":"Provider 对比","id":"provider-对比"},{"level":2,"text":"在路由中使用","id":"在路由中使用"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"AI SDK 6 概览","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/foundations/ai-sdk-overview"},"next":{"title":"第一次对话","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/foundations/first-conversation"}}