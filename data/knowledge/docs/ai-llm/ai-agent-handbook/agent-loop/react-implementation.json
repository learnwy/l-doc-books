i-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.messages });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.text;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>三个方法的职责清晰分离：<code>think</code> 调用模型但<strong>不设 <code>maxSteps</code></strong>，只执行一步；<code>act</code> 并发执行工具并在内部捕获异常，将错误作为 Observation 返回给模型；<code>observe</code> 按 <code>ModelMessage</code> 格式将 <code>tool-call</code> 和 <code>tool-result</code> 追加到消息列表，通过 <code>toolCallId</code> 关联。</p>\n<hr>\n<h2 id=\"运行与执行轨迹\">运行与执行轨迹</h2><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { openai } from &#39;@ai-sdk/openai&#39;;&#10;import { tool } from &#39;ai&#39;;&#10;import { z } from &#39;zod&#39;;&#10;&#10;const agent = new ReActAgent({&#10;  model: openai(&#39;gpt-5&#39;),&#10;  tools: {&#10;    weather: tool({&#10;      description: &#39;获取城市天气&#39;,&#10;      inputSchema: z.object({ city: z.string() }),&#10;      execute: async ({ city }) =&gt; {&#10;        const db: Record&lt;string, number&gt; = { 北京: 28, 东京: 32 };&#10;        return { city, temp: db[city] ?? 20 };&#10;      },&#10;    }),&#10;    calculator: tool({&#10;      description: &#39;数学计算&#39;,&#10;      inputSchema: z.object({ expression: z.string() }),&#10;      execute: async ({ expression }) =&gt; ({&#10;        result: new Function(`return ${expression}`)(),&#10;      }),&#10;    }),&#10;  },&#10;  systemPrompt: &#39;你是一个有用的助手，可以查询天气和进行数学计算。&#39;,&#10;  maxSteps: 10,&#10;});&#10;&#10;const answer = await agent.run(&#39;北京和东京的温差是多少度？&#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><