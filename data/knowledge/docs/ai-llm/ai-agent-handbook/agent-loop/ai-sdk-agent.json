n><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">toolName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}(${</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">call</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">args</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">})`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"迁移清单\">迁移清单</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[&quot;1. 保留 tool 定义不变&quot;] --&gt; B[&quot;2. 删除 ReActAgent 类&quot;]&#10;    B --&gt; C[&quot;3. systemPrompt → system 参数&quot;]&#10;    C --&gt; D[&quot;4. stopWhen → generateText 参数&quot;]&#10;    D --&gt; E[&quot;5. act() 错误处理 →&lt;br/&gt;tool.execute 内部&quot;]&#10;    E --&gt; F[&quot;6. onStepFinish 替代手动日志&quot;]&#10;    F --&gt; G[&quot;7. result.steps 替代手动轨迹&quot;]\">flowchart TD\n    A[\"1. 保留 tool 定义不变\"] --&gt; B[\"2. 删除 ReActAgent 类\"]\n    B --&gt; C[\"3. systemPrompt → system 参数\"]\n    C --&gt; D[\"4. stopWhen → generateText 参数\"]\n    D --&gt; E[\"5. act() 错误处理 →&lt;br/&gt;tool.execute 内部\"]\n    E --&gt; F[\"6. onStepFinish 替代手动日志\"]\n    F --&gt; G[\"7. result.steps 替代手动轨迹\"]</pre><p>迁移前后对比：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const agent = new ReActAgent({&#10;  model: openai(&#39;gpt-5&#39;),&#10;  tools,&#10;  systemPrompt: &#39;你是一个有用的助手&#39;,&#10;  maxSteps: 10,&#10;});&#10;const answer = await agent.run(&#39;北京天气如何？&#39;);&#10;&#10;const result = await generateText({&#10;  model: openai(&#39;gpt-5&#39;),&#10;  system: &#39;你是一个有用的助手&#39;,&#10;  prompt: &#39;北京天气如何？&#39;,&#10;  tools,&#10;  stopWhen: stepCountIs(10),&#10;});&#10;const answer = result.text;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> agent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReActAgent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  model: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">openai</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gpt-5'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tools,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  systemPrompt: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'你是一个有用的助手'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  maxSteps: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> answer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> agent.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'北京天气如何？'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  model: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">openai</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gpt-5'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  system: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'你是一个有用的助手'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  prompt: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'北京天气如何？'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tools,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  stopWhen: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stepCountIs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> answer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.text;</span></span></code></pre></div><hr>\n<h2 id=\"何时仍需手动循环\">何时仍需手动循环</h2><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>自定义终止逻辑</td>\n<td>根据工具结果内容决定是否继续</td>\n</tr>\n<tr>\n<td>步骤间状态管理</td>\n<td>维护数据库事务、文件锁等外部状态</td>\n</tr>\n<tr>\n<td>条件分支循环</td>\n<td>根据中间结果切换工具集或模型</td>\n</tr>\n<tr>\n<td>人机协作循环</td>\n<td>某些步骤暂停等待用户确认</td>\n</tr>\n<tr>\n<td>异构模型编排</td>\n<td>不同步骤使用不同模型</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>为什么错</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>不设步数上限或设得过大</td>\n<td>模型陷入&quot;调用→失败→再调用&quot;循环时，成本随步数线性放大</td>\n<td><code>stopWhen: stepCountIs(10)</code> 这类保守上限 + 工具内自检退出</td>\n</tr>\n<tr>\n<td>把业务异常原样 throw 给框架</td>\n<td>整轮 generateText 直接失败，前几步的成果全部作废</td>\n<td>可恢复错误在 <code>tool.execute</code> 内捕获并返回错误信息，让模型改道</td>\n</tr>\n<tr>\n<td>用 <code>onStepFinish</code> 同步写库/发请求</td>\n<td>它在执行热路径上，阻塞会拖慢每一步并放大延迟</td>\n<td>回调只做入队与计数，副作用交给后台消费者</td>\n</tr>\n<tr>\n<td>无脑迁移到 SDK 循环</td>\n<td>条件分支、人机协作等场景 SDK 内置循环表达不了</td>\n<td>对照&quot;何时仍需手动循环&quot;清单判断，不要为了用框架而用框架</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>AI SDK 6 的 <code>generateText</code> + <code>tools</code> + <code>stopWhen</code> 是 ReAct 循环的工程化封装，自动完成模型调用、工具执行、结果回填和循环控制。从手动 <code>ReActAgent</code> 迁移到 SDK 的核心改动是：删除循环管理代码，将错误处理下沉到 <code>tool.execute</code> 内部，用 <code>onStepFinish</code> 替代手动日志，用 <code>result.steps</code> 获取执行轨迹。SDK 覆盖了绝大多数场景，但自定义终止逻辑、步骤间状态管理、人机协作等高级需求仍可能需要手动循环。理解底层实现，才能在使用框架时准确判断其能力边界。</p>\n","headings":[{"level":1,"text":"AI SDK 6 工具循环代理","id":"ai-sdk-6-工具循环代理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"从手动循环到框架抽象","id":"从手动循环到框架抽象"},{"level":2,"text":"generateText + stopWhen：内置 ReAct 循环","id":"generatetext-stopwhen-内置-react-循环"},{"level":2,"text":"手动实现 vs AI SDK 对照","id":"手动实现-vs-ai-sdk-对照"},{"level":2,"text":"steps 追踪与 onStepFinish 监听","id":"steps-追踪与-onstepfinish-监听"},{"level":2,"text":"迁移清单","id":"迁移清单"},{"level":2,"text":"何时仍需手动循环","id":"何时仍需手动循环"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ReAct 实现","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/agent-loop/react-implementation"},"next":{"title":"中间件链","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/agent-loop/middleware-chain"}}