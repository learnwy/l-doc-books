7583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> line</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lines) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> line.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">data: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '[DONE]'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> parsed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(data);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      process.stdout.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">write</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(parsed.text);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>如果使用 AI SDK 的 <code>useChat</code> hook，上述解析逻辑已被完全封装，只需一行即可接入流式端点（详见第四节 React Chat 组件）。</p>\n<hr>\n<h2 id=\"流式处理的数据流\">流式处理的数据流</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[用户发送消息] --&gt; B[Hono 路由接收]&#10;    B --&gt; C[streamText 调用 LLM]&#10;    C --&gt; D[LLM 逐 token 返回]&#10;    D --&gt; E[转换为 SSE 事件]&#10;    E --&gt; F[chunked 传输到客户端]&#10;    F --&gt; G[客户端解析渲染]&#10;    G --&gt; H[用户看到逐字输出]\">flowchart LR\n    A[用户发送消息] --&gt; B[Hono 路由接收]\n    B --&gt; C[streamText 调用 LLM]\n    C --&gt; D[LLM 逐 token 返回]\n    D --&gt; E[转换为 SSE 事件]\n    E --&gt; F[chunked 传输到客户端]\n    F --&gt; G[客户端解析渲染]\n    G --&gt; H[用户看到逐字输出]</pre><hr>\n<h2 id=\"错误处理与中断\">错误处理与中断</h2><p>流式传输中需要处理两类异常：服务端生成错误和客户端主动断开。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { Hono } from &#39;hono&#39;;&#10;import { streamText, convertToModelMessages } from &#39;ai&#39;;&#10;import { openai } from &#39;@ai-sdk/openai&#39;;&#10;&#10;const app = new Hono();&#10;&#10;app.post(&#39;/api/chat/safe&#39;, async (c) =&gt; {&#10;  const { messages } = await c.req.json();&#10;&#10;  try {&#10;    const result = streamText({&#10;      model: openai(&#39;gpt-5&#39;),&#10;      messages: await convertToModelMessages(messages),&#10;      abortSignal: c.req.raw.signal,&#10;      onError: ({ error }) =&gt; {&#10;        console.error(&#39;Stream error:&#39;, error);&#10;      },&#10;    });&#10;&#10;    return result.toUIMessageStreamResponse();&#10;  } catch (error) {&#10;    return c.json({ error: &#39;Failed to start stream&#39; }, 500);&#10;  }&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Hono } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'hono'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { streamText, convertToModelMessages } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ai'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { openai } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@ai-sdk/openai'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> app</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Hono</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">app.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/chat/safe'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">messages</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.req.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> streamText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      model: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">openai</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gpt-5'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      messages: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> convertToModelMessages</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(messages),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      abortSignal: c.req.raw.signal,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      onError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: ({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Stream error:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, error);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toUIMessageStreamResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ error: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Failed to start stream'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p><code>abortSignal</code> 绑定到请求的 signal，当客户端关闭连接时自动取消 LLM 调用，避免无用的 token 消耗和费用浪费。</p>\n<hr>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>为什么错</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>手写 SSE 解析却忽略跨 chunk 截断</td>\n<td>一个 JSON 事件可能被 TCP 分包切成两半，<code>JSON.parse</code> 直接抛异常</td>\n<td>用 buffer 缓存并按 <code>\\n\\n</code> 分隔符切分（或直接用 <code>useChat</code> 封装）</td>\n</tr>\n<tr>\n<td>把客户端 UIMessage 原样塞进 <code>streamText</code></td>\n<td>v5+ 消息模型拆分后，类型不匹配且工具调用部分无法被正确理解</td>\n<td>入口先 <code>await convertToModelMessages(messages)</code> 再传入</td>\n</tr>\n<tr>\n<td>流式端点不绑定 <code>abortSignal</code></td>\n<td>用户关掉页面后模型仍在生成，token 照常计费</td>\n<td><code>abortSignal: c.req.raw.signal</code>，让断连即停</td>\n</tr>\n<tr>\n<td>在 <code>onError</code> 里把内部错误原文透传给客户端</td>\n<td>泄漏堆栈、上游 URL、Key 片段等敏感信息</td>\n<td>日志记全量细节，响应只返回通用错误码与提示</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((SSE 流式响应))&#10;    协议基础&#10;      text/event-stream&#10;      chunked transfer&#10;      单向推送&#10;    服务端&#10;      streamText API&#10;      toUIMessageStreamResponse&#10;      Hono stream 辅助&#10;    客户端&#10;      fetch + ReadableStream&#10;      EventSource 解析&#10;      useChat 封装&#10;    工程要点&#10;      abortSignal 中断控制&#10;      错误处理&#10;      no-cache 头设置\">mindmap\n  root((SSE 流式响应))\n    协议基础\n      text/event-stream\n      chunked transfer\n      单向推送\n    服务端\n      streamText API\n      toUIMessageStreamResponse\n      Hono stream 辅助\n    客户端\n      fetch + ReadableStream\n      EventSource 解析\n      useChat 封装\n    工程要点\n      abortSignal 中断控制\n      错误处理\n      no-cache 头设置</pre><ul>\n<li><strong>SSE</strong> 是 AI 流式响应的标准协议，基于 HTTP 长连接实现服务端到客户端的单向推送。</li>\n<li>AI SDK 6 的 <code>streamText</code> 和 <code>toUIMessageStreamResponse()</code> 封装了完整的流式链路，一行代码即可在 Hono 中开启流式端点。</li>\n<li>客户端通过 <code>ReadableStream</code> 或 AI SDK 的 <code>useChat</code> hook 消费流式数据。</li>\n<li>生产环境中必须处理 <code>abortSignal</code> 中断和错误回退，避免无用的 token 消耗。</li>\n</ul>\n","headings":[{"level":1,"text":"SSE 流式响应","id":"sse-流式响应"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要流式响应","id":"为什么需要流式响应"},{"level":2,"text":"SSE 协议基础","id":"sse-协议基础"},{"level":2,"text":"Hono 流式路由","id":"hono-流式路由"},{"level":2,"text":"自定义流式响应","id":"自定义流式响应"},{"level":2,"text":"客户端消费","id":"客户端消费"},{"level":2,"text":"流式处理的数据流","id":"流式处理的数据流"},{"level":2,"text":"错误处理与中断","id":"错误处理与中断"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"第一次对话","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/foundations/first-conversation"},"next":{"title":"对话历史管理","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/streaming-and-chat/chat-history"}}