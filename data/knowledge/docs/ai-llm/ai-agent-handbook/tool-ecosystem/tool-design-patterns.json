73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TParams</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> withTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(def.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(params), timeout, def.name);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"工具生命周期\">工具生命周期</h2><p>从定义到执行完成，一个工具调用经历完整的生命周期：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    DEFINE[&quot;定义阶段&lt;br/&gt;声明 name / description / inputSchema&quot;] --&gt; REGISTER[&quot;注册阶段&lt;br/&gt;加入 tools 对象&quot;]&#10;    REGISTER --&gt; SELECT[&quot;选择阶段&lt;br/&gt;模型根据描述选择工具&quot;]&#10;    SELECT --&gt; VALIDATE[&quot;校验阶段&lt;br/&gt;Zod 验证参数合法性&quot;]&#10;    VALIDATE --&gt;|校验失败| ERROR_V[&quot;返回参数错误&quot;]&#10;    VALIDATE --&gt;|校验通过| EXECUTE[&quot;执行阶段&lt;br/&gt;调用 execute 回调&quot;]&#10;    EXECUTE --&gt; TIMEOUT{&quot;超时检查&quot;}&#10;    TIMEOUT --&gt;|超时| ERROR_T[&quot;返回超时错误&quot;]&#10;    TIMEOUT --&gt;|正常| RESULT[&quot;结果阶段&lt;br/&gt;返回 ToolResult&quot;]&#10;    RESULT --&gt; FEEDBACK[&quot;反馈阶段&lt;br/&gt;结果注入上下文&quot;]&#10;    FEEDBACK --&gt; SELECT&#10;    ERROR_V --&gt; FEEDBACK&#10;    ERROR_T --&gt; FEEDBACK\">flowchart TD\n    DEFINE[\"定义阶段&lt;br/&gt;声明 name / description / inputSchema\"] --&gt; REGISTER[\"注册阶段&lt;br/&gt;加入 tools 对象\"]\n    REGISTER --&gt; SELECT[\"选择阶段&lt;br/&gt;模型根据描述选择工具\"]\n    SELECT --&gt; VALIDATE[\"校验阶段&lt;br/&gt;Zod 验证参数合法性\"]\n    VALIDATE --&gt;|校验失败| ERROR_V[\"返回参数错误\"]\n    VALIDATE --&gt;|校验通过| EXECUTE[\"执行阶段&lt;br/&gt;调用 execute 回调\"]\n    EXECUTE --&gt; TIMEOUT{\"超时检查\"}\n    TIMEOUT --&gt;|超时| ERROR_T[\"返回超时错误\"]\n    TIMEOUT --&gt;|正常| RESULT[\"结果阶段&lt;br/&gt;返回 ToolResult\"]\n    RESULT --&gt; FEEDBACK[\"反馈阶段&lt;br/&gt;结果注入上下文\"]\n    FEEDBACK --&gt; SELECT\n    ERROR_V --&gt; FEEDBACK\n    ERROR_T --&gt; FEEDBACK</pre><hr>\n<h2 id=\"设计清单\">设计清单</h2><p>开发新工具时，对照以下清单逐项检查：</p>\n<table>\n<thead>\n<tr>\n<th>#</th>\n<th>检查项</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>1</td>\n<td>单一职责</td>\n<td>工具只做一件事，描述能用一句话概括</td>\n</tr>\n<tr>\n<td>2</td>\n<td>参数描述</td>\n<td>每个参数都有 <code>.describe()</code></td>\n</tr>\n<tr>\n<td>3</td>\n<td>参数约束</td>\n<td>使用 <code>min/max/enum/regex</code> 限制取值范围</td>\n</tr>\n<tr>\n<td>4</td>\n<td>默认值</td>\n<td>非必要参数提供合理默认值</td>\n</tr>\n<tr>\n<td>5</td>\n<td>错误返回</td>\n<td>失败时返回结构化错误，不抛异常</td>\n</tr>\n<tr>\n<td>6</td>\n<td>幂等标记</td>\n<td>标注工具是否幂等</td>\n</tr>\n<tr>\n<td>7</td>\n<td>超时设置</td>\n<td>配置合理的超时时间</td>\n</tr>\n<tr>\n<td>8</td>\n<td>返回格式</td>\n<td>统一使用 <code>ToolResult</code> 类型</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>工具设计的核心是&quot;对模型友好&quot;与&quot;对系统安全&quot;的平衡。单一职责让模型精准选择，精确的 Zod Schema 防止参数错误，结构化错误返回给模型恢复机会，幂等设计保证重复调用安全，超时控制防止 Agent 循环卡死。遵循统一的 <code>ToolDefinition</code> 接口和生命周期管理，工具生态才能在规模增长时保持可靠。</p>\n","headings":[{"level":1,"text":"工具设计模式","id":"工具设计模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要设计原则","id":"为什么需要设计原则"},{"level":2,"text":"单一职责原则","id":"单一职责原则"},{"level":2,"text":"工具接口类型定义","id":"工具接口类型定义"},{"level":2,"text":"参数校验与 Zod Schema","id":"参数校验与-zod-schema"},{"level":2,"text":"错误处理策略","id":"错误处理策略"},{"level":2,"text":"幂等性设计","id":"幂等性设计"},{"level":2,"text":"超时控制","id":"超时控制"},{"level":2,"text":"工具生命周期","id":"工具生命周期"},{"level":2,"text":"设计清单","id":"设计清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Prompt 注入","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/skill-system/prompt-injection"},"next":{"title":"文件/Web/数据库工具","url":"/l-doc-books/h/ai-llm/ai-agent-handbook/tool-ecosystem/builtin-tools"}}