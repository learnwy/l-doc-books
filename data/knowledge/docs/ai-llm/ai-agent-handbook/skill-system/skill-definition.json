ine\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">RunCommand</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">toolcalls</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">priority</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">---</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## Purpose</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">处理用户的文件管理请求，包括创建新文件、移动文件位置、重命名和删除操作。确保操作安全且符合项目约定。</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## Trigger Patterns</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> \"创建一个新的组件文件 Button.tsx\"</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> \"把 utils.ts 移动到 shared/ 目录下\"</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> \"删除 temp/ 下的所有临时文件\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## Usage</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">1.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 解析用户请求中的文件路径和操作类型</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">2.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 验证目标路径的合法性</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">3.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 执行文件操作</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">4.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 确认操作结果</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## Implementation</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 创建文件前检查是否已存在同名文件</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 删除操作前先读取文件内容作为确认</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 移动文件时保留 git 历史（使用 git mv）</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 遵循项目的目录结构约定</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## Safety</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 禁止删除 .git 目录和配置文件</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 禁止操作项目根目录之外的文件</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 批量删除超过 5 个文件时需要用户确认</span></span></code></pre></div><hr>\n<h2 id=\"frontmatter-解析实现\">Frontmatter 解析实现</h2><p>使用 <code>gray-matter</code> 库解析 SKILL.md 的 frontmatter 和正文：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import matter from &#39;gray-matter&#39;;&#10;import { z } from &#39;zod&#39;;&#10;&#10;const skillFrontmatterSchema = z.object({&#10;  name: z.string().regex(/^[a-z][a-z0-9-]*$/),&#10;  version: z.string().regex(/^\\d+\\.\\d+\\.\\d+$/),&#10;  description: z.string().min(1),&#10;  trigger: z.array(z.string()).min(1),&#10;  category: z.string().optional(),&#10;  requiredTools: z.array(z.string()).optional(),&#10;  toolcalls: z.boolean().optional().default(false),&#10;  priority: z.number().optional().default(0),&#10;  enabled: z.boolean().optional().default(true),&#10;});&#10;&#10;function parseSkillFile(filePath: string, content: string) {&#10;  const { data, content: body } = matter(content);&#10;  const frontmatter = skillFrontmatterSchema.parse(data);&#10;&#10;  const sections = extractSections(body);&#10;&#10;  return { filePath, frontmatter, sections };&#10;}&#10;&#10;function extractSections(body: string): Record&lt;string, string&gt; {&#10;  const sections: Record&lt;string, string&gt; = {};&#10;  const regex = /^## (.+)$/gm;&#10;  const headings: { title: string; index: number }[] = [];&#10;&#10;  let match: RegExpExecArray | null;&#10;  while ((match = regex.exec(body)) !== null) {&#10;    headings.push({ title: match[1].trim(), index: match.index });&#10;  }&#10;&#10;  for (let i = 0; i &lt; headings.length; i++) {&#10;    const start = headings[i].index + headings[i].title.length + 4;&#10;    const end = i + 1 &lt; headings.length ? headings[i + 1].index : body.length;&#10;    sections[headings[i].title] = body.slice(start, end