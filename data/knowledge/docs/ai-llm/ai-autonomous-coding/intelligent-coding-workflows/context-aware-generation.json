t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.valueDensity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.valueDensity);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> selected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ContextCandidate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> usedTokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> candidate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sorted) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (usedTokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> candidate.tokenCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> budget.allocated.codeContext) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      selected.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(candidate);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      usedTokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> candidate.tokenCount;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> selected;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>上下文内容</th>\n<th>Token 占用</th>\n<th>信息价值</th>\n<th>价值密度</th>\n<th>加载优先级</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>目标文件类型定义</td>\n<td>低</td>\n<td>极高</td>\n<td>极高</td>\n<td>第一优先</td>\n</tr>\n<tr>\n<td>相关接口/类型</td>\n<td>低-中</td>\n<td>高</td>\n<td>高</td>\n<td>第一优先</td>\n</tr>\n<tr>\n<td>当前文件完整内容</td>\n<td>中</td>\n<td>高</td>\n<td>中</td>\n<td>第二优先</td>\n</tr>\n<tr>\n<td>相关文件摘要</td>\n<td>低</td>\n<td>中</td>\n<td>中高</td>\n<td>第二优先</td>\n</tr>\n<tr>\n<td>相关文件完整内容</td>\n<td>高</td>\n<td>中</td>\n<td>低</td>\n<td>第三优先</td>\n</tr>\n<tr>\n<td>项目级配置</td>\n<td>低</td>\n<td>中</td>\n<td>中</td>\n<td>第二优先</td>\n</tr>\n<tr>\n<td>远端依赖方源码</td>\n<td>高</td>\n<td>低</td>\n<td>极低</td>\n<td>仅按需</td>\n</tr>\n</tbody></table>\n<h2 id=\"跨文件依赖感知\">跨文件依赖感知</h2><p>在真实项目中，一个文件的代码变更往往会影响其他文件。跨文件依赖感知让 Agent 在修改一个文件时，自动识别并处理受影响的其他文件。</p>\n<p><strong>Import 链分析</strong>是最基础的跨文件感知。当 Agent 修改了一个模块的导出接口时，需要自动识别所有导入该接口的文件，并评估是否需要同步修改。</p>\n<p><strong>类型传播分析</strong>更加深入。当修改了一个 TypeScript 接口的字段时，所有使用该接口作为参数或返回值的函数都可能需要更新。TypeScript 编译器的类型检查错误会自动暴露这些传播链。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DependencyAnalyzer {&#10;  getImporters(filePath: string): Promise&lt;string[]&gt;;&#10;  getExports(filePath: string): Promise&lt;ExportInfo[]&gt;;&#10;  getTypeUsages(typeName: string): Promise&lt;TypeUsage[]&gt;;&#10;  getCallGraph(functionName: string): Promise&lt;CallGraphNode&gt;;&#10;&#10;  analyzeImpact(change: FileChange): Promise&lt;ImpactReport&gt;;&#10;}&#10;&#10;interface ImpactReport {&#10;  directlyAffected: string[];&#10;  transitivelyAffected: string[];&#10;  riskLevel: &#39;low&#39; | &#39;medium&#39; | &#39;high&#39;;&#10;  suggestedActions: SuggestedAction[];&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DependencyAnalyzer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getImporters</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">filePath</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getExports</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">filePath</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ExportInfo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getTypeUsages</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">typeName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">TypeUsage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getCallGraph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">functionName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">CallGraphNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  analyzeImpact</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">change</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FileChange</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ImpactReport</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ImpactReport</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  directlyAffected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  transitivelyAffected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  riskLevel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'low'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'medium'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'high'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  suggestedActions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SuggestedAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>变更影响半径估算</strong>帮助 Agent 决定需要检查多大范围的文件。一个工具函数的签名变更可能影响数十个调用者，而一个组件内部状态的修改通常只影响组件本身。</p>\n<table>\n<thead>\n<tr>\n<th>变更类型</th>\n<th>影响半径</th>\n<th>传播方式</th>\n<th>Agent 应对策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>内部实现修改</td>\n<td>极小</td>\n<td>无传播</td>\n<td>仅验证当前文件</td>\n</tr>\n<tr>\n<td>导出函数签名变更</td>\n<td>中</td>\n<td>Import 链</td>\n<td>搜索所有 importer</td>\n</tr>\n<tr>\n<td>类型/接口字段变更</td>\n<td>大</td>\n<td>类型传播</td>\n<td>运行 tsc 定位所有错误</td>\n</tr>\n<tr>\n<td>公共 API 变更</td>\n<td>极大</td>\n<td>跨模块</td>\n<td>全量构建 + 测试</td>\n</tr>\n<tr>\n<td>配置文件变更</td>\n<td>不确定</td>\n<td>构建系统</td>\n<td>完整重建 + 回归测试</td>\n</tr>\n</tbody></table>\n<h2 id=\"风格一致性维护\">风格一致性维护</h2><p>代码风格一致性是上下文感知的&quot;软约束&quot;。它不像类型检查那样有明确的对错判断，但对代码可维护性和团队协作至关重要。Agent 生成的代码如果风格与项目不一致，即使功能正确也会被审查者要求修改。</p>\n<p><strong>风格学习</strong>是指 Agent 通过分析现有代码来推断项目的编码偏好。关键的风格维度包括：</p>\n<ul>\n<li><strong>命名规范</strong>：<code>camelCase</code> vs <code>snake_case</code>，前缀/后缀习惯（如 <code>I</code> 前缀的接口、<code>use</code> 前缀的 Hook）</li>\n<li><strong>导入组织</strong>：分组顺序（外部包 → 内部模块 → 相对路径）、是否使用路径别名</li>\n<li><strong>函数风格</strong>：箭头函数 vs function 声明、命名导出 vs 默认导出</li>\n<li><strong>错误处理</strong>：try-catch vs Result 类型、错误边界模式</li>\n<li><strong>组件模式</strong>：FC 箭头函数 vs function 组件、Props 接口命名</li>\n</ul>\n<p>Agent 可以通过分析同目录下的已有文件来学习这些偏好，然后在生成新代码时遵循相同的模式。更高级的方案是将风格规则编码为项目级配置（如 AGENTS.md 中的编码规则），Agent 在系统 Prompt 中读取这些规则。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[分析已有代码] --&gt; B[提取风格模式]&#10;    B --&gt; C[命名规范]&#10;    B --&gt; D[导入顺序]&#10;    B --&gt; E[函数风格]&#10;    B --&gt; F[错误处理模式]&#10;    C --&gt; G[风格配置]&#10;    D --&gt; G&#10;    E --&gt; G&#10;    F --&gt; G&#10;    G --&gt; H[约束代码生成]\">graph LR\n    A[分析已有代码] --&gt; B[提取风格模式]\n    B --&gt; C[命名规范]\n    B --&gt; D[导入顺序]\n    B --&gt; E[函数风格]\n    B --&gt; F[错误处理模式]\n    C --&gt; G[风格配置]\n    D --&gt; G\n    E --&gt; G\n    F --&gt; G\n    G --&gt; H[约束代码生成]</pre><h2 id=\"小结\">小结</h2><ul>\n<li><strong>上下文感知是代码生成质量的决定性因素</strong>，从&quot;补全片段&quot;到&quot;理解项目后生成&quot;的跃迁依赖于全面的上下文构建。</li>\n<li><strong>代码库索引</strong>（嵌入向量、AST 索引、符号图）是上下文感知的基础设施，不同索引类型适合不同查询需求。</li>\n<li><strong>多路检索</strong>（语义 + 符号 + 路径 + 依赖）结合 RRF 排序，实现精准的上下文获取。</li>\n<li><strong>上下文窗口管理</strong>以&quot;价值密度&quot;为核心指标，渐进式加载从骨架到细节的三阶段策略是主流方案。</li>\n<li><strong>跨文件依赖感知</strong>通过 Import 链和类型传播分析，自动识别变更影响半径。</li>\n<li><strong>风格一致性维护</strong>通过分析已有代码或读取项目级规则，确保生成代码与项目风格统一。</li>\n</ul>\n","headings":[{"level":1,"text":"上下文感知的代码生成","id":"上下文感知的代码生成"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"代码库索引技术","id":"代码库索引技术"},{"level":2,"text":"检索增强代码生成","id":"检索增强代码生成"},{"level":2,"text":"上下文窗口管理","id":"上下文窗口管理"},{"level":2,"text":"跨文件依赖感知","id":"跨文件依赖感知"},{"level":2,"text":"风格一致性维护","id":"风格一致性维护"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"任务分解与自主规划策略","url":"/l-doc-books/h/ai-llm/ai-autonomous-coding/intelligent-coding-workflows/task-decomposition-planning"},"next":{"title":"测试驱动的 AI 编码循环","url":"/l-doc-books/h/ai-llm/ai-autonomous-coding/intelligent-coding-workflows/test-driven-ai-coding"}}