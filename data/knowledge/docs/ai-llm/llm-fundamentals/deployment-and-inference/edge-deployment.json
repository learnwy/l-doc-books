>受内存限制</td>\n</tr>\n<tr>\n<td>Mac</td>\n<td>llama.cpp</td>\n<td>跨平台、成熟</td>\n<td>CPU 为主</td>\n</tr>\n<tr>\n<td>iPhone/iPad</td>\n<td>CoreML</td>\n<td>原生优化、低功耗</td>\n<td>模型需小于 4GB</td>\n</tr>\n<tr>\n<td>Android</td>\n<td>llama.cpp</td>\n<td>跨平台</td>\n<td>性能受限</td>\n</tr>\n<tr>\n<td>Web</td>\n<td>WebLLM/ONNX</td>\n<td>浏览器运行</td>\n<td>WebGPU 支持</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"端侧部署权衡\">端侧部署权衡</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"tradeoffs = {&#10;    &quot;模型大小 vs 质量&quot;: {&#10;        &quot;说明&quot;: &quot;更小的模型质量更差，但运行更快&quot;,&#10;        &quot;建议&quot;: &quot;7B Q4 是桌面端的甜点配置&quot;,&#10;    },&#10;    &quot;量化程度 vs 精度&quot;: {&#10;        &quot;说明&quot;: &quot;更激进的量化会损失更多精度&quot;,&#10;        &quot;建议&quot;: &quot;Q4_K_M 是最佳平衡点&quot;,&#10;    },&#10;    &quot;上下文长度 vs 内存&quot;: {&#10;        &quot;说明&quot;: &quot;更长的上下文需要更多 KV 缓存内存&quot;,&#10;        &quot;建议&quot;: &quot;根据可用内存动态调整&quot;,&#10;    },&#10;    &quot;速度 vs 功耗&quot;: {&#10;        &quot;说明&quot;: &quot;移动设备需要关注电池续航&quot;,&#10;        &quot;建议&quot;: &quot;使用 Neural Engine 降低功耗&quot;,&#10;    },&#10;}&#10;&#10;for topic, info in tradeoffs.items():&#10;    print(f&quot;权衡: {topic}&quot;)&#10;    print(f&quot;  说明: {info[&#39;说明&#39;]}&quot;)&#10;    print(f&quot;  建议: {info[&#39;建议&#39;]}\\n&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">tradeoffs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"模型大小 vs 质量\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"说明\"</span><span style=\"color:#