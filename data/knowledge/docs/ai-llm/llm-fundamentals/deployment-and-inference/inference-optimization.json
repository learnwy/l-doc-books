   return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> accepted, gamma</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"投机解码效果:\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">acceptance_rates </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"代码生成\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.85</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"创意写作\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"数学推理\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.70</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> task, rate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> acceptance_rates.items():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    speedup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"  </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">task</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: 接受率 </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.0%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> → 约 </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">speedup</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.1f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">x 加速\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 投机解码在草稿模型与目标模型输出分布相似时效果最好。同一系列的小大模型对（如 LLaMA-1B + LLaMA-70B）通常是最佳搭配。</p>\n</blockquote>\n<hr>\n<h2 id=\"批处理策略\">批处理策略</h2><p>高效的批处理是提升吞吐量的关键：</p>\n<table>\n<thead>\n<tr>\n<th>批处理策略</th>\n<th>说明</th>\n<th>优点</th>\n<th>缺点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>静态批处理</td>\n<td>等凑满一批再处理</td>\n<td>实现简单</td>\n<td>延迟高</td>\n</tr>\n<tr>\n<td>连续批处理</td>\n<td>完成的请求立即替换</td>\n<td>高吞吐</td>\n<td>实现复杂</td>\n</tr>\n<tr>\n<td>分块 Prefill</td>\n<td>分块处理长 prompt</td>\n<td>减少首 token 延迟</td>\n<td>额外开销</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    subgraph 静态批处理&#10;        S1[&quot;请求 1 ████████&quot;]&#10;        S2[&quot;请求 2 ████---padding---&quot;]&#10;        S3[&quot;请求 3 ██████---pad---&quot;]&#10;    end&#10;    subgraph 连续批处理&#10;        C1[&quot;请求 1 ████████&quot;]&#10;        C2[&quot;请求 2 ████ → 请求 4 ██████&quot;]&#10;        C3[&quot;请求 3 ██████ → 请求 5 ████&quot;]&#10;    end\">flowchart TB\n    subgraph 静态批处理\n        S1[\"请求 1 ████████\"]\n        S2[\"请求 2 ████---padding---\"]\n        S3[\"请求 3 ██████---pad---\"]\n    end\n    subgraph 连续批处理\n        C1[\"请求 1 ████████\"]\n        C2[\"请求 2 ████ → 请求 4 ██████\"]\n        C3[\"请求 3 ██████ → 请求 5 ████\"]\n    end</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"metrics = {&#10;    &quot;首 token 延迟 (TTFT)&quot;: &quot;用户感知的响应速度&quot;,&#10;    &quot;token 间延迟 (ITL)&quot;: &quot;生成流畅度&quot;,&#10;    &quot;端到端延迟 (E2E)&quot;: &quot;完整请求耗时&quot;,&#10;    &quot;吞吐量 (tokens/s)&quot;: &quot;系统处理能力&quot;,&#10;    &quot;GPU 利用率&quot;: &quot;硬件使用效率&quot;,&#10;}&#10;&#10;print(&quot;关键推理性能指标:&quot;)&#10;for metric, desc in metrics.items():&#10;    print(f&quot;  {metric}: {desc}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">metrics </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"首 token 延迟 (TTFT)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"用户感知的响应速度\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"token 间延迟 (ITL)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"生成流畅度\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"端到端延迟 (E2E)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"完整请求耗时\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"吞吐量 (tokens/s)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"系统处理能力\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"GPU 利用率\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"硬件使用效率\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"关键推理性能指标:\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metric, desc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics.items():</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"  </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">metric</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">desc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"tensorrt-llm\">TensorRT-LLM</h2><p>TensorRT-LLM 是 NVIDIA 的高性能 LLM 推理优化库，提供了一系列深度优化：</p>\n<table>\n<thead>\n<tr>\n<th>优化技术</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>算子融合</td>\n<td>合并多个小算子为大算子</td>\n</tr>\n<tr>\n<td>量化推理</td>\n<td>INT8/FP8 精度推理</td>\n</tr>\n<tr>\n<td>内核优化</td>\n<td>CUDA 内核深度调优</td>\n</tr>\n<tr>\n<td>张量并行</td>\n<td>多 GPU 模型切分</td>\n</tr>\n<tr>\n<td>飞行批处理</td>\n<td>高效的连续批处理</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"print(&quot;TensorRT-LLM 典型加速效果:&quot;)&#10;speedups = {&#10;    &quot;LLaMA-7B (单卡)&quot;: &quot;2-3x&quot;,&#10;    &quot;LLaMA-70B (8卡)&quot;: &quot;3-5x&quot;,&#10;    &quot;Mistral-7B (FP8)&quot;: &quot;2-4x&quot;,&#10;}&#10;for model, speedup in speedups.items():&#10;    print(f&quot;  {model}: {speedup} 加速 (相比 HuggingFace)&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"TensorRT-LLM 典型加速效果:\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">speedups </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"LLaMA-7B (单卡)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2-3x\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"LLaMA-70B (8卡)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"3-5x\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"Mistral-7B (FP8)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2-4x\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> model, speedup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> speedups.items():</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"  </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">speedup</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 加速 (相比 HuggingFace)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>LLM 推理分为 Prefill（计算密集）和 Decode（带宽密集）两个阶段。</li>\n<li>KV 缓存是主要显存消耗来源，GQA、PagedAttention 和 KV 量化是关键优化手段。</li>\n<li>投机解码用小模型预测+大模型验证，在不损失质量的情况下加速 1.5-3x。</li>\n<li>连续批处理替代静态批处理可显著提升吞吐量。</li>\n<li>TensorRT-LLM 提供从算子融合到量化推理的全栈优化。</li>\n</ul>\n","headings":[{"level":1,"text":"推理优化","id":"推理优化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"推理性能瓶颈","id":"推理性能瓶颈"},{"level":2,"text":"KV 缓存优化","id":"kv-缓存优化"},{"level":2,"text":"投机解码","id":"投机解码"},{"level":2,"text":"批处理策略","id":"批处理策略"},{"level":2,"text":"TensorRT-LLM","id":"tensorrt-llm"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"模型量化","url":"/l-doc-books/h/ai-llm/llm-fundamentals/deployment-and-inference/model-quantization"},"next":{"title":"服务框架","url":"/l-doc-books/h/ai-llm/llm-fundamentals/deployment-and-inference/serving-frameworks"}}