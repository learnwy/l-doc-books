nt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"  </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">k</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">v</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>防御层</th>\n<th>措施</th>\n<th>优先级</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>系统层</td>\n<td>系统提示中嵌入安全规则</td>\n<td>必须</td>\n</tr>\n<tr>\n<td>输入层</td>\n<td>意图检测 + 关键词过滤</td>\n<td>必须</td>\n</tr>\n<tr>\n<td>模型层</td>\n<td>RLHF 对齐训练</td>\n<td>必须</td>\n</tr>\n<tr>\n<td>输出层</td>\n<td>毒性检测 + PII 过滤</td>\n<td>必须</td>\n</tr>\n<tr>\n<td>监控层</td>\n<td>日志审计 + 异常告警</td>\n<td>推荐</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>LLM 安全涵盖有害内容、隐私泄露、偏见放大和越狱攻击等多个维度。</li>\n<li>多层防御（输入过滤 + 对齐训练 + 输出过滤 + 监控审计）是最佳实践。</li>\n<li>越狱攻击手法持续进化，需要定期更新防御策略。</li>\n<li>Red Teaming 是系统性发现安全漏洞的关键方法。</li>\n<li>安全是持续过程而非一次性任务，需要建立持续监控和改进机制。</li>\n</ul>\n","headings":[{"level":1,"text":"安全与护栏","id":"安全与护栏"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"LLM 安全挑战","id":"llm-安全挑战"},{"level":2,"text":"内容过滤","id":"内容过滤"},{"level":2,"text":"越狱防御","id":"越狱防御"},{"level":2,"text":"Red Teaming","id":"red-teaming"},{"level":2,"text":"安全护栏框架","id":"安全护栏框架"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"幻觉缓解","url":"/l-doc-books/h/ai-llm/llm-fundamentals/evaluation-and-safety