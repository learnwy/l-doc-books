lass DynamicFewShot:&#10;    def __init__(self, example_pool, embedder):&#10;        self.examples = example_pool&#10;        self.embedder = embedder&#10;        self.example_embeddings = embedder.encode(&#10;            [e[&quot;input&quot;] for e in example_pool]&#10;        )&#10;&#10;    def get_prompt(self, query, k=3):&#10;        query_emb = self.embedder.encode([query])[0]&#10;        similarities = np.dot(self.example_embeddings, query_emb)&#10;        top_k = np.argsort(similarities)[-k:][::-1]&#10;&#10;        prompt = &quot;&quot;&#10;        for idx in top_k:&#10;            ex = self.examples[idx]&#10;            prompt += f&quot;输入: {ex[&#39;input&#39;]}\\n输出: {ex[&#39;output&#39;]}\\n\\n&quot;&#10;&#10;        prompt += f&quot;输入: {query}\\n输出:&quot;&#10;        return prompt&#10;&#10;example_pool = [&#10;    {&quot;input&quot;: &quot;苹果是什么颜色？&quot;, &quot;output&quot;: &quot;红色、绿色或黄色&quot;},&#10;    {&quot;input&quot;: &quot;Python 的创始人是谁？&quot;, &quot;output&quot;: &quot;Guido van Rossum&quot;},&#10;    {&quot;input&quot;: &quot;地球到月球的距离？&quot;, &quot;output&quot;: &quot;约 38.4 万公里&quot;},&#10;    {&quot;input&quot;: &quot;什么是递归？&quot;, &quot;output&quot;: &quot;函数调用自身的编程技术&quot;},&#10;]&#10;&#10;print(f&quot;示例池大小: {len(example_pool)}&quot;)&#10;print(&quot;动态 Few-shot 根据查询相似度检索最相关的示例&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DynamicFewShot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, example_pool, embedder):</span></span>\n<span class=\"line