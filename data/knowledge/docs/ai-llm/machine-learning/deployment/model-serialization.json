;--shiki-dark:#FFAB70\">    input_names</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'input'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    output_names</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'output'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    dynamic_axes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'input'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'batch'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'output'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'batch'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}},</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    opset_version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">18</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ONNX 模型已导出\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><blockquote>\n<p><strong>版本注意：</strong> <code>dynamic_axes</code> 属于基于 TorchScript 的遗留导出路径。PyTorch 2.x 起官方推荐 <code>dynamo=True</code>（现已默认开启）的新导出路径，它基于 <code>torch.export</code>，动态维度改用 <code>dynamic_shapes</code> 参数描述；旧参数仍可用但不再演进（见 <a href=\"https://docs.pytorch.org/docs/stable/onnx.html\">torch.onnx 官方文档</a>）。ONNX 算子集本身也在持续演进：opset 13 发布于 2021 年，而截至 2026 年 ONNX 1.23 文档对应的默认算子集已到 opset 28（见 <a href=\"https://onnx.ai/onnx/\">onnx.ai</a>）；示例选 opset 18 是为了兼容主流推理引擎的常见交集。</p>\n</blockquote>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[&quot;PyTorch 模型&quot;] --&gt; B[&quot;torch.onnx.export&quot;]&#10;    B --&gt; C[&quot;ONNX 文件&quot;]&#10;    C --&gt; D[&quot;ONNX Runtime&quot;]&#10;    C --&gt; E[&quot;TensorRT&quot;]&#10;    C --&gt; F[&quot;CoreML&quot;]&#10;    C --&gt; G[&quot;LiteRT&lt;br/&gt;(原 TFLite)&quot;]\">flowchart LR\n    A[\"PyTorch 模型\"] --&gt; B[\"torch.onnx.export\"]\n    B --&gt; C[\"ONNX 文件\"]\n    C --&gt; D[\"ONNX Runtime\"]\n    C --&gt; E[\"TensorRT\"]\n    C --&gt; F[\"CoreML\"]\n    C --&gt; G[\"LiteRT&lt;br/&gt;(原 TFLite)\"]</pre><hr>\n<h2 id=\"torchscript\">TorchScript</h2><p>TorchScript 是 PyTorch 自带的模型序列化方案，支持脱离 Python 环境运行。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn as nn&#10;&#10;class SimpleNet(nn.Module):&#10;    def __init__(self):&#10;        super().__init__()&#10;        self.fc1 = nn.Linear(10, 50)&#10;        self.relu = nn.ReLU()&#10;        self.fc2 = nn.Linear(50, 3)&#10;&#10;    def forward(self, x):&#10;        return self.fc2(self.relu(self.fc1(x)))&#10;&#10;model = SimpleNet()&#10;model.eval()&#10;&#10;scripted = torch.jit.script(model)&#10;scripted.save(&#39;/tmp/model_scripted.pt&#39;)&#10;&#10;traced = torch.jit.trace(model, torch.randn(1, 10))&#10;traced.save(&#39;/tmp/model_traced.pt&#39;)&#10;&#10;loaded = torch.jit.load(&#39;/tmp/model_scripted.pt&#39;)&#10;x = torch.randn(1, 10)&#10;with torch.no_grad():&#10;    out = loaded(x)&#10;print(f&quot;TorchScript 输出形状: {list(out.shape)}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SimpleNet</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Module</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        super</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">__init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc1 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.Linear(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.relu </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.ReLU()</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc2 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.Linear(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc2(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.relu(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc1(x)))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SimpleNet()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model.eval()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scripted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.jit.script(model)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scripted.save(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/tmp/model_scripted.pt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">traced </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.jit.trace(model, torch.randn(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">traced.save(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/tmp/model_traced.pt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">loaded </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.jit.load(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/tmp/model_scripted.pt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.randn(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.no_grad():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    out </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loaded(x)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"TorchScript 输出形状: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{list</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(out.shape)</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>方式</th>\n<th>原理</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>torch.jit.script</td>\n<td>编译 Python 代码</td>\n<td>包含条件/循环的模型</td>\n</tr>\n<tr>\n<td>torch.jit.trace</td>\n<td>跟踪一次前向传播</td>\n<td>固定控制流的模型</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"版本控制\">版本控制</h2><p>模型版本控制是生产环境中必不可少的实践，确保模型的可追溯性和可复现性。</p>\n<table>\n<thead>\n<tr>\n<th>工具</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Git LFS</td>\n<td>Git 大文件扩展</td>\n<td>小团队、小模型</td>\n</tr>\n<tr>\n<td>DVC</td>\n<td>数据版本控制</td>\n<td>数据 + 模型版本管理</td>\n</tr>\n<tr>\n<td>MLflow Model Registry</td>\n<td>模型注册中心</td>\n<td>企业级 MLOps</td>\n</tr>\n<tr>\n<td>W&amp;B Artifacts</td>\n<td>实验追踪 + 制品管理</td>\n<td>实验管理</td>\n</tr>\n<tr>\n<td>Hugging Face Hub (GGUF)</td>\n<td>LLM 权重托管与 GGUF 格式分发</td>\n<td>开源大模型的分发与复用</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>说明：</strong> 在大语言模型场景，社区事实上的分发格式是 <strong>GGUF</strong>（llama.cpp 生态使用的单文件权重格式，见 <a href=\"https://github.com/ggml-org/ggml/blob/master/docs/gguf.md\">ggml 规范文档</a> 与 <a href=\"https://huggingface.co/docs/hub/en/gguf\">Hugging Face GGUF 文档</a>），它把权重、分词器和元数据打包为一个文件，直接面向端侧推理。</p>\n</blockquote>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"model_metadata = {&#10;    &quot;model_name&quot;: &quot;iris_classifier&quot;,&#10;    &quot;version&quot;: &quot;1.2.0&quot;,&#10;    &quot;framework&quot;: &quot;sklearn&quot;,&#10;    &quot;algorithm&quot;: &quot;RandomForest&quot;,&#10;    &quot;metrics&quot;: {&#10;        &quot;accuracy&quot;: 0.9556,&#10;        &quot;f1_weighted&quot;: 0.9554,&#10;    },&#10;    &quot;hyperparameters&quot;: {&#10;        &quot;n_estimators&quot;: 100,&#10;        &quot;max_depth&quot;: None,&#10;    },&#10;    &quot;training_data&quot;: &quot;iris_dataset_v2&quot;,&#10;    &quot;created_at&quot;: &quot;2026-03-30&quot;,&#10;}&#10;&#10;import json&#10;print(json.dumps(model_metadata, indent=2))\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model_metadata </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"model_name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"iris_classifier\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"version\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"1.2.0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"framework\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sklearn\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"algorithm\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"RandomForest\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"metrics\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"accuracy\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.9556</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"f1_weighted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.9554</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"hyperparameters\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"n_estimators\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"max_depth\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"training_data\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"iris_dataset_v2\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"created_at\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-03-30\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> json</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(json.dumps(model_metadata, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">indent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 在生产环境中，总是保存权重而非完整模型。完整模型与 Python 版本和库版本强绑定，容易在环境变化时出问题。同时，ONNX 是跨框架部署的最佳选择。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>Pickle/Joblib</strong> 是 scikit-learn 模型的标准保存方式，但有安全风险。</li>\n<li>PyTorch 推荐保存 <strong>state_dict</strong>，Checkpoint 用于断点续训。</li>\n<li><strong>ONNX</strong> 是跨框架模型交换标准，搭配 ONNX Runtime 可实现高效推理；导出时注意 opset 版本与 PyTorch 新旧两条导出路径的差异。</li>\n<li><strong>TorchScript</strong> 支持脱离 Python 运行，适合 C++ 推理环境。</li>\n<li><strong>版本控制</strong>确保模型的可追溯性，DVC 和 MLflow 是常用工具。</li>\n</ul>\n","headings":[{"level":1,"text":"模型序列化","id":"模型序列化"},{"level":2,"text":"什么是模型序列化","id":"什么是模型序列化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Python Pickle","id":"python-pickle"},{"level":2,"text":"PyTorch 模型保存","id":"pytorch-模型保存"},{"level":2,"text":"ONNX 格式","id":"onnx-格式"},{"level":2,"text":"TorchScript","id":"torchscript"},{"level":2,"text":"版本控制","id":"版本控制"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据增强","url":"/l-doc-books/h/ai-llm/machine-learning/feature-engineering/data-augmentation"},"next":{"title":"CoreML 与 ONNX","url":"/l-doc-books/h/ai-llm/machine-learning/deployment/coreml-and-onnx"}}