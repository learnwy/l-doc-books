an></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'epoch'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'model_state_dict'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: model.state_dict(),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'optimizer_state_dict'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: torch.optim.Adam(model.parameters()).state_dict(),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'loss'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">torch.save(checkpoint, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/tmp/checkpoint.pth'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Checkpoint 已保存\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>保存方式</th>\n<th>内容</th>\n<th>推荐场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>state_dict</td>\n<td>只保存权重</td>\n<td>部署、迁移学习</td>\n</tr>\n<tr>\n<td>完整模型</td>\n<td>模型结构 + 权重</td>\n<td>快速原型</td>\n</tr>\n<tr>\n<td>Checkpoint</td>\n<td>权重 + 优化器 + epoch</td>\n<td>断点续训</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"onnx-格式\">ONNX 格式</h2><p>ONNX（Open Neural Network Exchange）是跨框架的模型交换标准。训练在 PyTorch 中完成，推理可以用 ONNX Runtime、TensorRT 等高效引擎。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn as nn&#10;&#10;class SimpleNet(nn.Module):&#10;    def __init__(self):&#10;        super().__init__()&#10;        self.fc1 = nn.Linear(10, 50)&#10;        self.relu = nn.ReLU()&#10;        self.fc2 = nn.Linear(50, 3)&#10;&#10;    def forward(self, x):&#10;        return self.fc2(self.relu(self.fc1(x)))&#10;&#10;model = SimpleNet()&#10;model.eval()&#10;&#10;dummy_input = torch.randn(1, 10)&#10;&#10;torch.onnx.export(&#10;    model, dummy_input,&#10;    &#39;/tmp/model.onnx&#39;,&#10;    input_names=[&#39;input&#39;],&#10;    output_names=[&#39;output&#39;],&#10;    dynamic_axes={&#39;input&#39;: {0: &#39;batch&#39;}, &#39;output&#39;: {0: &#39;batch&#39;}},&#10;    opset_version=18,&#10;)&#10;print(&quot;ONNX 模型已导出&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SimpleNet</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Mod