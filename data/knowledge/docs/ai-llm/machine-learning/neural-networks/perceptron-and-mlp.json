, ∞)</td>\n<td>计算高效，最常用</td>\n</tr>\n<tr>\n<td>Leaky ReLU</td>\n<td><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>max</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mn>0.01</mn><mi>x</mi><mo separator=\"true\">,</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\max(0.01x, x)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\">max</span><span class=\"mopen\">(</span><span class=\"mord\">0.01</span><span class=\"mord mathnormal\">x</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span></span></span></span></span></td>\n<td>(-∞, ∞)</td>\n<td>解决 ReLU 死亡问题</td>\n</tr>\n<tr>\n<td>GELU</td>\n<td><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi><mo>⋅</mo><mi mathvariant=\"normal\">Φ</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">x \\cdot \\Phi(x)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4445em;\"></span><span class=\"mord mathnormal\">x</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">Φ</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span></span></span></span></span></td>\n<td>≈(-0.17, ∞)</td>\n<td>Transformer 常用</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn.functional as F&#10;&#10;x = torch.linspace(-3, 3, 7)&#10;print(f&quot;输入:       {x.tolist()}&quot;)&#10;print(f&quot;Sigmoid:    {torch.sigmoid(x).tolist()}&quot;)&#10;print(f&quot;Tanh:       {torch.tanh(x).tolist()}&quot;)&#10;print(f&quot;ReLU:       {F.relu(x).tolist()}&quot;)&#10;print(f&quot;LeakyReLU:  {F.leaky_relu(x, 0.01).tolist()}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn.functional </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.linspace(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"输入:       </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">x.tolist()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Sigmoid:    </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">torch.sigmoid(x).tolist()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Tanh:       </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">torch.tanh(x).tolist()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ReLU:       </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">F.relu(x).tolist()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"LeakyReLU:  </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">F.leaky_relu(x, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.01</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).tolist()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"万能逼近定理\">万能逼近定理</h2><p>万能逼近定理（Universal Approximation Theorem）指出：一个具有单个隐藏层和足够多神经元的前馈网络，可以以任意精度逼近任何连续函数。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[&quot;任意连续函数 f(x)&quot;] --&gt; B[&quot;单隐藏层 MLP&lt;br/&gt;足够多神经元&quot;]&#10;    B --&gt; C[&quot;逼近精度可任意小&quot;]&#10;    D[&quot;但实际中...&quot;] --&gt; E[&quot;深度网络&lt;br/&gt;参数效率更高&quot;]&#10;    D --&gt; F[&quot;优化更容易&lt;br/&gt;层次化特征提取&quot;]\">flowchart LR\n    A[\"任意连续函数 f(x)\"] --&gt; B[\"单隐藏层 MLP&lt;br/&gt;足够多神经元\"]\n    B --&gt; C[\"逼近精度可任意小\"]\n    D[\"但实际中...\"] --&gt; E[\"深度网络&lt;br/&gt;参数效率更高\"]\n    D --&gt; F[\"优化更容易&lt;br/&gt;层次化特征提取\"]</pre><p>虽然理论上一层就够，但实践中<strong>深度网络</strong>（多个隐藏层）比宽而浅的网络更高效：</p>\n<table>\n<thead>\n<tr>\n<th>对比</th>\n<th>浅而宽网络</th>\n<th>深而窄网络</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>参数量</td>\n<td>指数级</td>\n<td>多项式级</td>\n</tr>\n<tr>\n<td>特征抽象</td>\n<td>一步到位</td>\n<td>层层递进</td>\n</tr>\n<tr>\n<td>训练难度</td>\n<td>相对简单</td>\n<td>需要技巧（BN、残差等）</td>\n</tr>\n<tr>\n<td>实际效果</td>\n<td>受限</td>\n<td>更优</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> MLP 是所有深度学习模型的基础。理解感知机的线性局限性、隐藏层引入非线性的机制，以及激活函数的作用，是深入学习 CNN、RNN 等架构的前提。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>感知机</strong>是最简单的神经网络，只能处理线性可分问题。</li>\n<li><strong>XOR 问题</strong>证明了单层网络的局限性，推动了多层网络的发展。</li>\n<li><strong>多层感知机</strong>通过隐藏层和激活函数获得了强大的非线性表达能力。</li>\n<li><strong>激活函数</strong>是引入非线性的关键，ReLU 是目前最常用的选择。</li>\n<li><strong>万能逼近定理</strong>提供了理论保证，但实际中深度网络比宽浅网络更高效。</li>\n</ul>\n","headings":[{"level":1,"text":"感知机与多层网络","id":"感知机与多层网络"},{"level":2,"text":"感知机","id":"感知机"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"XOR 问题","id":"xor-问题"},{"level":2,"text":"多层感知机（MLP）","id":"多层感知机-mlp"},{"level":2,"text":"激活函数","id":"激活函数"},{"level":2,"text":"万能逼近定理","id":"万能逼近定理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"集成方法","url":"/l-doc-books/h/ai-llm/machine-learning/classical-algorithms/ensemble-methods"},"next":{"title":"反向传播","url":"/l-doc-books/h/ai-llm/machine-learning/neural-networks/backpropagation"}}