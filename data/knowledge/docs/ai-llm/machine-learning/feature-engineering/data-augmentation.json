变语义</td>\n</tr>\n<tr>\n<td>随机插入</td>\n<td>在随机位置插入近义词</td>\n<td>可能破坏句法</td>\n</tr>\n<tr>\n<td>随机交换</td>\n<td>随机交换两个词的位置</td>\n<td>对语序敏感的任务谨慎</td>\n</tr>\n<tr>\n<td>随机删除</td>\n<td>以概率 p 删除每个词</td>\n<td>可能丢失关键信息</td>\n</tr>\n<tr>\n<td>回译</td>\n<td>翻译成外语再翻回来</td>\n<td>需要翻译模型</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import random&#10;import re&#10;&#10;def random_deletion(text, p=0.1):&#10;    words = text.split()&#10;    if len(words) == 1:&#10;        return text&#10;    remaining = [w for w in words if random.random() &gt; p]&#10;    return &#39; &#39;.join(remaining) if remaining else random.choice(words)&#10;&#10;def random_swap(text, n=1):&#10;    words = text.split()&#10;    for _ in range(n):&#10;        if len(words) &gt;= 2:&#10;            i, j = random.sample(range(len(words)), 2)&#10;            words[i], words[j] = words[j], words[i]&#10;    return &#39; &#39;.join(words)&#10;&#10;text = &quot;机器学习是人工智能的重要分支&quot;&#10;print(f&quot;原始文本: {text}&quot;)&#10;random.seed(42)&#10;for i in range(3):&#10;    print(f&quot;  随机删除 {i+1}: {random_deletion(text, p=0.2)}&quot;)&#10;    print(f&quot;  随机交换 {i+1}: {random_swap(text, n=1)}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> random</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> re</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> random_deletion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(text, p</span><span style=\"color:#D73A49;--shiki-dark:#F9758