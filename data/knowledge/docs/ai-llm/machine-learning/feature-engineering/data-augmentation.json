-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.array(synthetic)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_minority </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> X[y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_synthetic </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> simple_smote(X_minority, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_synthetic</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">450</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_new </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.vstack([X, X_synthetic])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">y_new </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.concatenate([y, np.ones(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(X_synthetic))])</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"增强分布: 类别0=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(y_new</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.0f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">, 类别1=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(y_new</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.0f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>SMOTE 变体</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SMOTE</td>\n<td>基础版本</td>\n<td>通用类别不平衡</td>\n</tr>\n<tr>\n<td>Borderline-SMOTE</td>\n<td>只在边界附近生成</td>\n<td>类别有重叠时</td>\n</tr>\n<tr>\n<td>ADASYN</td>\n<td>自适应，在更难的区域生成更多</td>\n<td>密度不均时</td>\n</tr>\n<tr>\n<td>SMOTE-ENN</td>\n<td>SMOTE + 近邻清洗</td>\n<td>噪声较多时</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"增强策略选择\">增强策略选择</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[&quot;数据类型？&quot;]&#10;    A --&gt;|&quot;图像&quot;| B[&quot;几何+颜色变换&lt;br/&gt;Mixup/CutMix&quot;]&#10;    A --&gt;|&quot;文本&quot;| C[&quot;同义词替换&lt;br/&gt;回译&quot;]&#10;    A --&gt;|&quot;表格&quot;| D[&quot;SMOTE&lt;br/&gt;噪声注入&quot;]&#10;    A --&gt;|&quot;时序&quot;| E[&quot;时间扭曲&lt;br/&gt;窗口切片&quot;]&#10;    B --&gt; F[&quot;注意:&lt;br/&gt;保持标签一致性&quot;]&#10;    C --&gt; F&#10;    D --&gt; F&#10;    E --&gt; F\">flowchart TD\n    A[\"数据类型？\"]\n    A --&gt;|\"图像\"| B[\"几何+颜色变换&lt;br/&gt;Mixup/CutMix\"]\n    A --&gt;|\"文本\"| C[\"同义词替换&lt;br/&gt;回译\"]\n    A --&gt;|\"表格\"| D[\"SMOTE&lt;br/&gt;噪声注入\"]\n    A --&gt;|\"时序\"| E[\"时间扭曲&lt;br/&gt;窗口切片\"]\n    B --&gt; F[\"注意:&lt;br/&gt;保持标签一致性\"]\n    C --&gt; F\n    D --&gt; F\n    E --&gt; F</pre><table>\n<thead>\n<tr>\n<th>数据类型</th>\n<th>推荐增强方法</th>\n<th>注意事项</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>图像</td>\n<td>翻转、裁剪、颜色抖动、Mixup</td>\n<td>医学图像谨慎翻转</td>\n</tr>\n<tr>\n<td>文本</td>\n<td>回译、同义词替换、EDA</td>\n<td>注意语义保持</td>\n</tr>\n<tr>\n<td>表格</td>\n<td>SMOTE、噪声注入</td>\n<td>注意分布一致</td>\n</tr>\n<tr>\n<td>时序</td>\n<td>时间扭曲、窗口裁剪</td>\n<td>保持时序关系</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 数据增强不能替代高质量的原始数据收集。增强最有效的场景是：原始数据质量好但数量不足，或需要模型对特定变换具有不变性时。过度增强反而会引入噪声。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>图像增强</strong>是最成熟的领域，几何变换和颜色变换是标准操作，Mixup/CutMix 进一步提升效果。</li>\n<li><strong>文本增强</strong>需要更谨慎，回译和同义词替换是相对安全的选择。</li>\n<li><strong>SMOTE</strong> 是解决类别不平衡的经典方法，通过插值生成合成少数类样本。</li>\n<li>增强策略需要根据数据类型和任务特点选择，核心原则是保持标签一致性。</li>\n<li>数据增强是正则化的一种形式，与 Dropout 等方法互补使用效果更佳。</li>\n</ul>\n","headings":[{"level":1,"text":"数据增强","id":"数据增强"},{"level":2,"text":"什么是数据增强","id":"什么是数据增强"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"图像数据增强","id":"图像数据增强"},{"level":3,"text":"Mixup 与 CutMix","id":"mixup-与-cutmix"},{"level":2,"text":"文本数据增强","id":"文本数据增强"},{"level":2,"text":"合成数据生成","id":"合成数据生成"},{"level":3,"text":"SMOTE","id":"smote"},{"level":2,"text":"增强策略选择","id":"增强策略选择"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"降维","url":"/l-doc-books/h/ai-llm/machine-learning/feature-engineering/dimensionality-reduction"},"next":{"title":"模型序列化","url":"/l-doc-books/h/ai-llm/machine-learning/deployment/model-serialization"}}