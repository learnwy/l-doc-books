#10;from sklearn.model_selection import cross_val_score&#10;&#10;data = load_breast_cancer()&#10;X, y = data.data, data.target&#10;&#10;model = RandomForestClassifier(n_estimators=50, random_state=42)&#10;&#10;full_score = cross_val_score(model, X, y, cv=5).mean()&#10;print(f&quot;全部特征 ({X.shape[1]}): {full_score:.4f}&quot;)&#10;&#10;sfs = SequentialFeatureSelector(&#10;    model, n_features_to_select=10,&#10;    direction=&#39;forward&#39;, cv=5, n_jobs=-1&#10;)&#10;sfs.fit(X, y)&#10;selected_mask = sfs.get_support()&#10;selected_names = [data.feature_names[i] for i, s in enumerate(selected_mask) if s]&#10;&#10;subset_score = cross_val_score(model, X[:, selected_mask], y, cv=5).mean()&#10;print(f&quot;选择特征 ({sum(selected_mask)}): {subset_score:.4f}&quot;)&#10;print(f&quot;选中特征: {selected_names}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.feature_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SequentialFeatureSelector</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.ensemble </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RandomForestClassifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_breast_cancer</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97