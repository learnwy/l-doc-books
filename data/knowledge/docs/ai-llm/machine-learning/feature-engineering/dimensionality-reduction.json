 class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"  数字 </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">digit</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: 中心=(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">center[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:7.2f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">center[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:7.2f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)  样本数=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">mask.sum()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>t-SNE 的关键参数：</p>\n<table>\n<thead>\n<tr>\n<th>参数</th>\n<th>作用</th>\n<th>建议范围</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>perplexity</td>\n<td>近似近邻数</td>\n<td>5-50</td>\n</tr>\n<tr>\n<td>learning_rate</td>\n<td>优化步长</td>\n<td>10-1000</td>\n</tr>\n<tr>\n<td>n_iter</td>\n<td>迭代次数</td>\n<td>≥ 1000</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"umap\">UMAP</h2><p>UMAP（Uniform Manifold Approximation and Projection）是 t-SNE 的改进版，速度更快，且支持对新数据的变换。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.datasets import load_digits&#10;from sklearn.model_selection import train_test_split&#10;from sklearn.neighbors import KNeighborsClassifier&#10;from sklearn.decomposition import PCA&#10;import numpy as np&#10;&#10;digits = load_digits()&#10;X, y = digits.data, digits.target&#10;X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)&#10;&#10;knn = KNeighborsClassifier(n_neighbors=5)&#10;knn.fit(X_train, y_train)&#10;print(f&quot;原始维度 ({X.shape[1]}): KNN 准确率={knn.score(X_test, y_test):.4f}&quot;)&#10;&#10;pca = PCA(n_components=20)&#10;X_train_pca = pca.fit_transform(X_train)&#10;X_test_pca = pca.transform(X_test)&#10;knn_pca = KNeighborsClassifier(n_neighbors=5).fit(X_train_pca, y_train)&#10;print(f&quot;PCA 20 维:         KNN 准确率={knn_pca.score(X_test_pca, y_test):.4f}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_digits</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> train_test_split</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.neighbors </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> KNeighborsClassifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.decomposition </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> PCA</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">digits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_digits()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X, y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> digits.data, digits.target</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_train, X_test, y_train, y_test </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> train_test_split(X, y, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">test_size</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">knn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> KNeighborsClassifier(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_neighbors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">knn.fit(X_train, y_train)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"原始维度 (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X.shape[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">): KNN 准确率=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">knn.score(X_test, y_test)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pca </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PCA(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_components</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_train_pca </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pca.fit_transform(X_train)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_test_pca </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pca.transform(X_test)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">knn_pca </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> KNeighborsClassifier(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_neighbors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).fit(X_train_pca, y_train)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"PCA 20 维:         KNN 准确率=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">knn_pca.score(X_test_pca, y_test)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>对比维度</th>\n<th>PCA</th>\n<th>t-SNE</th>\n<th>UMAP</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>类型</td>\n<td>线性</td>\n<td>非线性</td>\n<td>非线性</td>\n</tr>\n<tr>\n<td>速度</td>\n<td>快</td>\n<td>慢</td>\n<td>中</td>\n</tr>\n<tr>\n<td>可变换新数据</td>\n<td>是</td>\n<td>否</td>\n<td>是</td>\n</tr>\n<tr>\n<td>全局结构</td>\n<td>保留</td>\n<td>不保留</td>\n<td>较好保留</td>\n</tr>\n<tr>\n<td>主要用途</td>\n<td>降维+去噪</td>\n<td>可视化</td>\n<td>可视化+降维</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"自编码器降维\">自编码器降维</h2><p>自编码器（Autoencoder）是一种基于神经网络的非线性降维方法。它学习将输入压缩到低维瓶颈层，再重构回原始维度。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[&quot;输入 x&lt;br/&gt;d 维&quot;] --&gt; B[&quot;编码器&quot;]&#10;    B --&gt; C[&quot;瓶颈层&lt;br/&gt;k 维&quot;]&#10;    C --&gt; D[&quot;解码器&quot;]&#10;    D --&gt; E[&quot;重构 x&#39;&lt;br/&gt;d 维&quot;]&#10;    E --&gt; F[&quot;最小化&lt;br/&gt;||x - x&#39;||²&quot;]\">flowchart LR\n    A[\"输入 x&lt;br/&gt;d 维\"] --&gt; B[\"编码器\"]\n    B --&gt; C[\"瓶颈层&lt;br/&gt;k 维\"]\n    C --&gt; D[\"解码器\"]\n    D --&gt; E[\"重构 x'&lt;br/&gt;d 维\"]\n    E --&gt; F[\"最小化&lt;br/&gt;||x - x'||²\"]</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn as nn&#10;from sklearn.datasets import load_digits&#10;from sklearn.model_selection import train_test_split&#10;from sklearn.preprocessing import StandardScaler&#10;&#10;digits = load_digits()&#10;X = StandardScaler().fit_transform(digits.data)&#10;X_train, X_test = train_test_split(X, test_size=0.3, random_state=42)&#10;&#10;X_train_t = torch.tensor(X_train, dtype=torch.float32)&#10;X_test_t = torch.tensor(X_test, dtype=torch.float32)&#10;&#10;class Autoencoder(nn.Module):&#10;    def __init__(self, input_dim, latent_dim):&#10;        super().__init__()&#10;        self.encoder = nn.Sequential(&#10;            nn.Linear(input_dim, 32),&#10;            nn.ReLU(),&#10;            nn.Linear(32, latent_dim),&#10;        )&#10;        self.decoder = nn.Sequential(&#10;            nn.Linear(latent_dim, 32),&#10;            nn.ReLU(),&#10;            nn.Linear(32, input_dim),&#10;        )&#10;&#10;    def forward(self, x):&#10;        z = self.encoder(x)&#10;        return self.decoder(z), z&#10;&#10;ae = Autoencoder(64, 10)&#10;optimizer = torch.optim.Adam(ae.parameters(), lr=0.001)&#10;&#10;for epoch in range(200):&#10;    recon, _ = ae(X_train_t)&#10;    loss = nn.MSELoss()(recon, X_train_t)&#10;    optimizer.zero_grad()&#10;    loss.backward()&#10;    optimizer.step()&#10;&#10;ae.eval()&#10;with torch.no_grad():&#10;    recon_test, z_test = ae(X_test_t)&#10;    test_loss = nn.MSELoss()(recon_test, X_test_t)&#10;    print(f&quot;重构损失: {test_loss.item():.4f}&quot;)&#10;    print(f&quot;潜在空间维度: {z_test.shape[1]}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_digits</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> train_test_split</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.preprocessing </span><span style=\"c