n></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    optimizer.zero_grad()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    loss.backward()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    optimizer.step()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ae.eval()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.no_grad():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recon_test, z_test </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ae(X_test_t)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    test_loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.MSELoss()(recon_test, X_test_t)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"重构损失: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">test_loss.item()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"潜在空间维度: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">z_test.shape[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"流形学习\">流形学习</h2><p>流形学习（Manifold Learning）假设高维数据实际位于一个低维流形上，通过发现这个流形结构来进行降维。</p>\n<table>\n<thead>\n<tr>\n<th>方法</th>\n<th>核心思想</th>\n<th>优势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Isomap</td>\n<td>测地线距离</td>\n<td>保留全局几何</td>\n</tr>\n<tr>\n<td>LLE</td>\n<td>局部线性重构</td>\n<td>保留局部结构</td>\n</tr>\n<tr>\n<td>t-SNE</td>\n<td>概率分布匹配</td>\n<td>可视化效果好</td>\n</tr>\n<tr>\n<td>UMAP</td>\n<td>拓扑数据分析</td>\n<td>快速、可扩展</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.manifold import Isomap, LocallyLinearEmbedding&#10;from sklearn.datasets import load_digits&#10;import numpy as np&#10;&#10;digits = load_digits()&#10;X, y = digits.data[:500], digits.target[:500]&#10;&#10;methods = {&#10;    &quot;Isomap&quot;:  Isomap(n_components=2, n_neighbors=10),&#10;    &quot;LLE&quot;:     LocallyLinearEmbedding(n_components=2, n_neighbors=10),&#10;}&#10;&#10;for name, method in methods.items():&#10;    X_2d = method.fit_transform(X)&#10;    print(f&quot;{name:10s} 输出形状: {X_2d.shape}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.manifold </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Isomap, LocallyLinearEmbedding</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_digits</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">digits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_digits()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X, y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> digits.data[:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], digits.target[:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">methods </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"Isomap\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:  Isomap(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_components</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_neighbors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"LLE\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:     LocallyLinearEmbedding(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_components</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_neighbors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> name, method </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> methods.items():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    X_2d </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> method.fit_transform(X)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:10s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 输出形状: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_2d.shape</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> PCA 应作为降维的第一选择：速度快、可解释性好、可变换新数据。只有当 PCA 效果不足以满足需求时，再考虑非线性方法（t-SNE/UMAP 用于可视化，自编码器用于特征学习）。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>PCA</strong> 是线性降维的首选，通过方差最大化提取主成分，速度快且可解释。</li>\n<li><strong>t-SNE</strong> 擅长高维数据可视化，但不支持变换新数据且速度较慢。</li>\n<li><strong>UMAP</strong> 在 t-SNE 基础上改进了速度和新数据支持，是可视化的更好选择。</li>\n<li><strong>自编码器</strong>利用神经网络实现非线性降维，可以学习更复杂的特征表示。</li>\n<li><strong>流形学习</strong>假设数据位于低维流形上，通过发现流形结构进行降维。</li>\n</ul>\n","headings":[{"level":1,"text":"降维","id":"降维"},{"level":2,"text":"为什么需要降维","id":"为什么需要降维"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"PCA（主成分分析）","id":"pca-主成分分析"},{"level":2,"text":"t-SNE","id":"t-sne"},{"level":2,"text":"UMAP","id":"umap"},{"level":2,"text":"自编码器降维","id":"自编码器降维"},{"level":2,"text":"流形学习","id":"流形学习"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"特征选择","url":"/l-doc-books/h/ai-llm/machine-learning/feature-engineering/feature-selection"},"next":{"title":"数据增强","url":"/l-doc-books/h/ai-llm/machine-learning/feature-engineering/data-augmentation"}}