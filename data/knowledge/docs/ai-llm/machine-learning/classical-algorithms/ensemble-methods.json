lor:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">stacking </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StackingClassifier(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    estimators</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">estimators,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    final_estimator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LogisticRegression(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">max_iter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    cv</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">stacking.fit(X_train, y_train)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Stacking 准确率: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">stacking.score(X_test, y_test)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> name, model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> estimators:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    model.fit(X_train, y_train)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"  </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:5s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 单独准确率: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model.score(X_test, y_test)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 在实际竞赛和工程中，集成方法几乎是标配。随机森林适合快速建立基线，XGBoost/LightGBM 适合精调性能，Stacking 适合最终冲刺。合理选择集成策略可以显著提升模型效果。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>集成学习通过组合多个模型来提升性能，主要分为 <strong>Bagging</strong> 和 <strong>Boosting</strong> 两大路线。</li>\n<li><strong>Bagging</strong> 降低方差，通过并行训练和投票/平均聚合；<strong>Random Forest</strong> 是其最成功的代表。</li>\n<li><strong>Boosting</strong> 降低偏差，通过串行训练逐步修正错误；XGBoost、LightGBM 等梯度提升实现在表格数据上长期保持第一梯度的精度。</li>\n<li><strong>Stacking</strong> 通过分层组合不同类型的模型，充分利用各模型的互补优势。</li>\n<li>集成方法是机器学习竞赛和工业应用中性能最优的技术之一。</li>\n</ul>\n","headings":[{"level":1,"text":"集成方法","id":"集成方法"},{"level":2,"text":"什么是集成学习","id":"什么是集成学习"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Bagging","id":"bagging"},{"level":2,"text":"随机森林","id":"随机森林"},{"level":2,"text":"Boosting","id":"boosting"},{"level":2,"text":"XGBoost","id":"xgboost"},{"level":2,"text":"Stacking","id":"stacking"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"SVM 与核方法","url":"/l-doc-books/h/ai-llm/machine-learning/classical-algorithms/svm-and-kernel"},"next":{"title":"感知机与多层网络","url":"/l-doc-books/h/ai-llm/machine-learning/neural-networks/perceptron-and-mlp"}}