4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">models </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"Random Forest\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: RandomForestClassifier(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_estimators</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"GBDT\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: GradientBoostingClassifier(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_estimators</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> name, model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> models.items():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    model.fit(X_train, y_train)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    train_acc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> model.score(X_train, y_train)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    test_acc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> model.score(X_test, y_test)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:20s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 训练=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">train_acc</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  测试=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">test_acc</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>XGBoost 的核心改进：</p>\n<table>\n<thead>\n<tr>\n<th>改进点</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>正则化目标函数</td>\n<td>损失函数中加入模型复杂度惩罚</td>\n</tr>\n<tr>\n<td>二阶泰勒展开</td>\n<td>使用一阶和二阶梯度信息优化</td>\n</tr>\n<tr>\n<td>列采样</td>\n<td>类似随机森林的特征采样</td>\n</tr>\n<tr>\n<td>缺失值处理</td>\n<td>自动学习缺失值的分裂方向</td>\n</tr>\n<tr>\n<td>并行化</td>\n<td>特征维度的并行化加速</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"stacking\">Stacking</h2><p>Stacking（堆叠泛化）使用多个不同类型的基模型，将它们的输出作为新特征，输入到一个元模型（Meta-Learner）中进行最终预测。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[&quot;训练数据&quot;]&#10;    A --&gt; B[&quot;基模型 1&lt;br/&gt;Random Forest&quot;]&#10;    A --&gt; C[&quot;基模型 2&lt;br/&gt;SVM&quot;]&#10;    A --&gt; D[&quot;基模型 3&lt;br/&gt;KNN&quot;]&#10;    B --&gt; E[&quot;预测 1&quot;]&#10;    C --&gt; F[&quot;预测 2&quot;]&#10;    D --&gt; G[&quot;预测 3&quot;]&#10;    E --&gt; H[&quot;元模型&lt;br/&gt;Logistic Regression&quot;]&#10;    F --&gt; H&#10;    G --&gt; H&#10;    H --&gt; I[&quot;最终预测&quot;]\">flowchart TD\n    A[\"训练数据\"]\n    A --&gt; B[\"基模型 1&lt;br/&gt;Random Forest\"]\n    A --&gt; C[\"基模型 2&lt;br/&gt;SVM\"]\n    A --&gt; D[\"基模型 3&lt;br/&gt;KNN\"]\n    B --&gt; E[\"预测 1\"]\n    C --&gt; F[\"预测 2\"]\n    D --&gt; G[\"预测 3\"]\n    E --&gt; H[\"元模型&lt;br/&gt;Logistic Regression\"]\n    F --&gt; H\n    G --&gt; H\n    H --&gt; I[\"最终预测\"]</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.ensemble import StackingClassifier, RandomForestClassifier&#10;from sklearn.svm import SVC&#10;from sklearn.neighbors import KNeighborsClassifier&#10;from sklearn.linear_model import LogisticRegression&#10;from sklearn.datasets import load_iris&#10;from sklearn.model_selection import train_test_split&#10;&#10;iris = load_iris()&#10;X_train, X_test, y_train, y_test = train_test_split(&#10;    iris.data, iris.target, test_size=0.3, random_state=42&#10;)&#10;&#10;estimators = [&#10;    (&#39;rf&#39;, RandomForestClassifier(n_estimators=50, random_state=42)),&#10;    (&#39;svc&#39;, SVC(probability=True, random_state=42)),&#10;    (&#39;knn&#39;, KNeighborsClassifier(n_neighbors=5)),&#10;]&#10;&#10;stacking = StackingClassifier(&#10;    estimators=estimators,&#10;    final_estimator=LogisticRegression(max_iter=200),&#10;    cv=5&#10;)&#10;stacking.fit(X_train, y_train)&#10;&#10;print(f&quot;Stacking 准确率: {stacking.score(X_test, y_test):.4f}&quot;)&#10;&#10;for name, model in estimators:&#10;    model.fit(X_train, y_train)&#10;    print(f&quot;  {name:5s} 单独准确率: {model.score(X_test, y_test):.4f}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.ensemble </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StackingClassifier, RandomForestClassifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.svm </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SVC</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.neighbors </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> KNeighborsClassifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style