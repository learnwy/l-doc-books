or:#24292E;--shiki-dark:#E1E4E8\"> db</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"学习到的参数: w=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">w</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.2f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">, b=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">b</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.2f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"真实参数:     w=3.00, b=4.00\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"交叉验证\">交叉验证</h2><p>交叉验证（Cross-Validation）是评估模型泛化能力的标准方法。最常用的是 K 折交叉验证（K-Fold CV）。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    subgraph 5-Fold 交叉验证&#10;        F1[&quot;Fold 1: 验证 | 训练 | 训练 | 训练 | 训练&quot;]&#10;        F2[&quot;Fold 2: 训练 | 验证 | 训练 | 训练 | 训练&quot;]&#10;        F3[&quot;Fold 3: 训练 | 训练 | 验证 | 训练 | 训练&quot;]&#10;        F4[&quot;Fold 4: 训练 | 训练 | 训练 | 验证 | 训练&quot;]&#10;        F5[&quot;Fold 5: 训练 | 训练 | 训练 | 训练 | 验证&quot;]&#10;    end&#10;    F1 --&gt; R[&quot;平均性能得分&quot;]&#10;    F2 --&gt; R&#10;    F3 --&gt; R&#10;    F4 --&gt; R&#10;    F5 --&gt; R\">flowchart TB\n    subgraph 5-Fold 交叉验证\n        F1[\"Fold 1: 验证 | 训练 | 训练 | 训练 | 训练\"]\n        F2[\"Fold 2: 训练 | 验证 | 训练 | 训练 | 训练\"]\n        F3[\"Fold 3: 训练 | 训练 | 验证 | 训练 | 训练\"]\n        F4[\"Fold 4: 训练 | 训练 | 训练 | 验证 | 训练\"]\n        F5[\"Fold 5: 训练 | 训练 | 训练 | 训练 | 验证\"]\n    end\n    F1 --&gt; R[\"平均性能得分\"]\n    F2 --&gt; R\n    F3 --&gt; R\n    F4 --&gt; R\n    F5 --&gt; R</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.model_selection import cross_val_score&#10;from sklearn.ensemble import RandomForestClassifier&#10;from sklearn.datasets import load_iris&#10;&#10;iris = load_iris()&#10;clf = RandomForestClassifier(n_estimators=100, random_state=42)&#10;&#10;scores = cross_val_score(clf, iris.data, iris.target, cv=5, scoring=&#39;accuracy&#39;)&#10;print(f&quot;各折准确率: {scores}&quot;)&#10;print(f&quot;平均准确率: {scores.mean():.4f} ± {scores.std():.4f}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cross_val_score</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.ensemble </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RandomForestClassifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_iris</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">iris </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_iris()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">clf </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RandomForestClassifier(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_estimators</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scores </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cross_val_score(clf, iris.data, iris.target, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">cv</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">scoring</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'accuracy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"各折准确率: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scores</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"平均准确率: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scores.mean()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ± </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scores.std()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>常见的交叉验证策略：</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>适用场景</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>K-Fold</td>\n<td>通用</td>\n<td>数据分为 K 份，轮流作为验证集</td>\n</tr>\n<tr>\n<td>Stratified K-Fold</td>\n<td>分类任务</td>\n<td>保持每折中类别比例一致</td>\n</tr>\n<tr>\n<td>Leave-One-Out</td>\n<td>小数据集</td>\n<td>每次留一个样本做验证</td>\n</tr>\n<tr>\n<td>Time Series Split</td>\n<td>时序数据</td>\n<td>保持时间顺序，前部训练后部验证</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"过拟合与欠拟合\">过拟合与欠拟合</h2><p>过拟合（Overfitting）和欠拟合（Underfitting）是监督学习中最核心的挑战。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph 模型表现诊断&#10;        A[&quot;欠拟合&lt;br/&gt;训练误差高&lt;br/&gt;测试误差高&quot;]&#10;        B[&quot;良好拟合&lt;br/&gt;训练误差低&lt;br/&gt;测试误差低&quot;]&#10;        C[&quot;过拟合&lt;br/&gt;训练误差低&lt;br/&gt;测试误差高&quot;]&#10;    end&#10;    A --&gt;|&quot;增加复杂度&quot;| B&#10;    B --&gt;|&quot;过度增加复杂度&quot;| C\">flowchart LR\n    subgraph 模型表现诊断\n        A[\"欠拟合&lt;br/&gt;训练误差高&lt;br/&gt;测试误差高\"]\n        B[\"良好拟合&lt;br/&gt;训练误差低&lt;br/&gt;测试误差低\"]\n        C[\"过拟合&lt;br/&gt;训练误差低&lt;br/&gt;测试误差高\"]\n    end\n    A --&gt;|\"增加复杂度\"| B\n    B --&gt;|\"过度增加复杂度\"| C</pre><p>常用的过拟合缓解方法：</p>\n<table>\n<thead>\n<tr>\n<th>方法</th>\n<th>原理</th>\n<th>实现方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>正则化</td>\n<td>限制模型参数大小</td>\n<td>L1/L2 惩罚项</td>\n</tr>\n<tr>\n<td>早停</td>\n<td>在验证误差上升前停止训练</td>\n<td>监控验证集损失</td>\n</tr>\n<tr>\n<td>Dropout</td>\n<td>随机丢弃部分神经元</td>\n<td>训练时以概率 p 关闭</td>\n</tr>\n<tr>\n<td>数据增强</td>\n<td>增加训练样本多样性</td>\n<td>旋转、翻转、裁剪</td>\n</tr>\n<tr>\n<td>集成学习</td>\n<td>组合多个弱学习器</td>\n<td>Bagging、Boosting</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.linear_model import Ridge, Lasso&#10;from sklearn.datasets import make_regression&#10;from sklearn.model_selection import train_test_split&#10;&#10;X, y = make_regression(n_samples=100, n_features=50, noise=10, random_state=42)&#10;X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)&#10;&#10;ridge = Ridge(alpha=1.0).fit(X_train, y_train)&#10;lasso = Lasso(alpha=1.0).fit(X_train, y_train)&#10;&#10;print(f&quot;Ridge R²: {ridge.score(X_test, y_test):.4f}&quot;)&#10;print(f&quot;Lasso R²: {lasso.score(X_test, y_test):.4f}&quot;)&#10;print(f&quot;Lasso 非零系数数量: {(lasso.coef_ != 0).sum()}/{len(lasso.coef_)}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.linear_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Ridge, Lasso</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> make_regression</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> train_test_split</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X, y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> make_regression(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_samples</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_features</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">noise</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_train, X_test, y_train, y_test </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> train_test_split(X, y, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">test_size</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ridge </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Ridge(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">alpha</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).fit(X_train, y_train)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">lasso </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Lasso(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">alpha</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).fit(X_train, y_train)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Ridge R²: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ridge.score(X_test, y_test)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Lasso R²: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">lasso.score(X_test, y_test)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Lasso 非零系数数量: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(lasso.coef_ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).sum()</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(lasso.coef_)</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 观察训练集和验证集的学习曲线（Learning Curve），可以直观判断模型是过拟合还是欠拟合。如果两条曲线有较大间距，通常意味着过拟合。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>监督学习从带标签数据中学习映射关系，分为<strong>分类</strong>（离散输出）和<strong>回归</strong>（连续输出）两大任务。</li>\n<li>训练过程的核心是通过<strong>最小化损失函数</strong>来寻找最优模型参数。</li>\n<li><strong>交叉验证</strong>是评估模型泛化能力的标准方法，K-Fold 是最常用的策略。</li>\n<li><strong>过拟合</strong>是最大的实践挑战，可通过正则化、早停、Dropout 等方法缓解。</li>\n<li>通过学习曲线和验证集表现来诊断模型状态，是构建可靠模型的关键技能。</li>\n</ul>\n","headings":[{"level":1,"text":"监督学习","id":"监督学习"},{"level":2,"text":"什么是监督学习","id":"什么是监督学习"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"分类与回归","id":"分类与回归"},{"level":2,"text":"训练过程","id":"训练过程"},{"level":2,"text":"交叉验证","id":"交叉验证"},{"level":2,"text":"过拟合与欠拟合","id":"过拟合与欠拟合"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"机器学习概览","url":"/l-doc-books/h/ai-llm/machine-learning/foundations/ml-overview"},"next":{"title":"无监督学习","url":"/l-doc-books/h/ai-llm/machine-learning/foundations/unsupervised-learning"}}