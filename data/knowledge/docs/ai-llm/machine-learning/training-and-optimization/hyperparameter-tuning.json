br/&gt;几组超参数&quot;] --&gt; B[&quot;构建代理模型&lt;br/&gt;高斯过程&quot;]&#10;    B --&gt; C[&quot;选择下一组超参数&lt;br/&gt;最大化采集函数&quot;]&#10;    C --&gt; D[&quot;评估模型性能&quot;]&#10;    D --&gt; E[&quot;更新代理模型&quot;]&#10;    E --&gt; F{&quot;预算用完？&quot;}&#10;    F --&gt;|&quot;否&quot;| C&#10;    F --&gt;|&quot;是&quot;| G[&quot;返回最优参数&quot;]\">flowchart TD\n    A[\"初始随机评估&lt;br/&gt;几组超参数\"] --&gt; B[\"构建代理模型&lt;br/&gt;高斯过程\"]\n    B --&gt; C[\"选择下一组超参数&lt;br/&gt;最大化采集函数\"]\n    C --&gt; D[\"评估模型性能\"]\n    D --&gt; E[\"更新代理模型\"]\n    E --&gt; F{\"预算用完？\"}\n    F --&gt;|\"否\"| C\n    F --&gt;|\"是\"| G[\"返回最优参数\"]</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.model_selection import cross_val_score&#10;from sklearn.ensemble import GradientBoostingClassifier&#10;from sklearn.datasets import load_breast_cancer&#10;import numpy as np&#10;&#10;data = load_breast_cancer()&#10;&#10;def objective(params):&#10;    model = GradientBoostingClassifier(&#10;        n_estimators=int(params[&#39;n_estimators&#39;]),&#10;        max_depth=int(params[&#39;max_depth&#39;]),&#10;        learning_rate=params[&#39;learning_rate&#39;],&#10;        min_samples_split=int(params[&#39;min_samples_split&#39;]),&#10;        random_state=42&#10;    )&#10;    scores = cross_val_score(model, data.data, data.target, cv=5, scoring=&#39;accuracy&#39;)&#10;    return scores.mean()&#10;&#10;np.random.seed(42)&#10;best_score = 0&#10;best_params = None&#10;&#10;for trial in range(30):&#10;    params = {&#10;        &#39;n_estimators&#39;: np.random.randint(50, 300),&#10;        &#39;max_depth&#39;: np.random.randint(2, 8),&#10;        &#39;learning_rate&#39;: np.random.uniform(0.01, 0.3),&#10;        &#39;min_samples_split&#39;: np.random.randint(2, 15),&#10;    }&#10;    score = objective(params)&#10;    if score &gt; best_score:&#10;        best_score = score&#10;        best_params = params&#10;        print(f&quot;Trial {trial+1:2d}: score={score:.4f} ★ {params}&quot;)&#10;&#10;print(f&quot;\\n最优分数: {best_score:.4f}&quot;)&#10;print(f&quot;最优参数: {best_params}&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cross_val_score</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.ensemble </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GradientBoostingClassifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.datasets </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_breast_cancer</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_breast_cancer()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> objective</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(params):</span></span>\n<sp