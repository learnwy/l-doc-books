\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>本体设计的核心原则包括：清晰性（每个概念有明确定义）、一致性（不存在逻辑矛盾）、可扩展性（容易添加新概念）、最小承诺（不过度约束）和最小编码偏差（不依赖特定实现）。</p>\n<h2 id=\"本体设计模式\">本体设计模式</h2><p>本体设计模式（Ontology Design Patterns, ODPs）是经过验证的可复用解决方案，用于处理知识建模中的常见问题。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DesignPattern {&#10;  name: string;&#10;  problem: string;&#10;  solution: string;&#10;  classes: string[];&#10;  relations: string[];&#10;}&#10;&#10;const N_ARY_RELATION_PATTERN: DesignPattern = {&#10;  name: &#39;N-ary Relation&#39;,&#10;  problem: &#39;需要表示涉及3个以上参与者的关系&#39;,&#10;  solution: &#39;将关系具化为一个类（事件/情境节点）&#39;,&#10;  classes: [&#39;Event&#39;, &#39;Participant&#39;, &#39;Role&#39;],&#10;  relations: [&#39;hasParticipant&#39;, &#39;hasRole&#39;, &#39;hasTime&#39;, &#39;hasLocation&#39;],&#10;};&#10;&#10;const PART_WHOLE_PATTERN: DesignPattern = {&#10;  name: &#39;Part-Whole&#39;,&#10;  problem: &#39;表示部分-整体关系（组成、包含、成员）&#39;,&#10;  solution: &#39;区分不同类型的部分关系&#39;,&#10;  classes: [&#39;Whole&#39;, &#39;Part&#39;],&#10;  relations: [&#39;hasPart&#39;, &#39;isPartOf&#39;, &#39;hasMember&#39;, &#39;isComponentOf&#39;],&#10;};&#10;&#10;const TIME_INTERVAL_PATTERN: DesignPattern = {&#10;  name: &#39;Time Interval&#39;,&#10;  problem: &#39;表示知识的时间有效性&#39;,&#10;  solution: &#39;引入时间区间类关联时变属性&#39;,&#10;  classes: [&#39;TimeInterval&#39;, &#39;TemporalEntity&#39;],&#10;  relations: [&#39;validFrom&#39;, &#39;validTo&#39;, &#39;during&#39;],&#10;};&#10;&#10;interface OntologyValidator {&#10;  checkConsistency(ontology: Ontology): ConsistencyReport;&#10;  checkCompleteness(ontology: Ontology, questions: CompetencyQuestion[]): CompletenessReport;&#10;  findRedundancy(ontology: Ontology): RedundancyReport;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" sty