iki-dark:#9ECBFF\">', '</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    );</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (shouldStop) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    currentEntities </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nextEntities;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> answer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.llm.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">generateAnswer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(question, reasoning);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { answer, reasoning };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>KGQA 将自然语言问题转化为知识图谱上的查询或推理，是 KG 最直接的应用场景</li>\n<li>语义解析方法将问题转化为 SPARQL 查询，精确但需要处理实体链接和关系链接</li>\n<li>多跳推理通过路径搜索或嵌入空间运算处理需要多步推理的复杂问题</li>\n<li>LLM+KG 结合（ToG、StructGPT）利用 LLM 的推理能力和 KG 的精确知识，是最新前沿方向</li>\n<li>实际 KGQA 系统需要综合语义解析、嵌入推理和 LLM 能力，应对不同复杂度的问题</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li><a href=\"../kg-applications/kg-qa-systems\">知识图谱问答系统</a>：从任务到工程化系统的落地视角</li>\n<li><a href=\"../kg-reasoning/neural-reasoning\">神经网络推理</a>：多跳问答背后的神经推理方法</li>\n<li><a href=\"../../natural-language-processing/information-extraction/question-answering\">问答（自然语言处理）</a>：文本型 QA 的方法，可与 KGQA 互补对照</li>\n<li><a href=\"../../ai-search-retrieval/query-understanding/semantic-matching\">语义匹配（搜索与检索）</a>：问题理解与关系链接所依赖的语义匹配技术</li>\n</ul>\n","headings":[{"level":1,"text":"知识图谱问答","id":"知识图谱问答"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"语义解析方法","id":"语义解析方法"},{"level":2,"text":"多跳推理问答","id":"多跳推理问答"},{"level":2,"text":"LLM 与知识图谱结合","id":"llm-与知识图谱结合"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"知识图谱嵌入","url":"/l-doc-books/h/ai-llm/knowledge-graphs/kg-reasoning/kg-embedding"},"next":{"title":"知识图谱推理","url":"/l-doc-books/h/ai-llm/knowledge-graphs/kg-reasoning/kg-reasoning"}}