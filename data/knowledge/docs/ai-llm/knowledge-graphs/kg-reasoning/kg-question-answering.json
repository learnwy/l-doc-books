 style=\"color:#032F62;--shiki-dark:#9ECBFF\">'哪些'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> question.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'列出'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'list'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (question.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'比较'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> question.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'更'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'comparison'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'factoid'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>语义解析的核心挑战是将非结构化的自然语言映射到结构化的查询语言。这个过程需要解决实体链接（将问题中的实体提及映射到 KG 实体）、关系链接（将问题中的关系表达映射到 KG 关系）和查询构造（将识别出的实体和关系组装为合法的查询）三个问题。</p>\n<h2 id=\"多跳推理问答\">多跳推理问答</h2><p>简单 KGQA 只需一步查询（如 &quot;北京的人口是多少&quot;），但很多问题需要多步推理（如 &quot;发明电话的人出生在哪个国家&quot;）。多跳推理需要沿着知识图谱中的路径进行逐步推理。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MultiHopConfig {&#10;  maxHops: number;&#10;  beamWidth: number;&#10;  pruneThreshold: number;&#10;}&#10;&#10;interface ReasoningPath {&#10;  entities: string[];&#10;  relations: string[];&#10;  score: number;&#10;}&#10;&#10;async function multiHopReasoning(&#10;  question: string,&#10;  startEntity: string,&#10;  kg: KnowledgeGraph,&#10;  config: MultiHopConfig,&#10;): Promise&lt;ReasoningPath[]&gt; {&#10;  let beams: ReasoningPath[] = [&#10;    {&#10;      entities: [startEntity],&#10;      relations: [],&#10;      score: 1.0,&#10;    },&#10;  ];&#10;&#10;  for (let hop = 0; hop &lt; config.maxHops; hop++) {&#10;    const nextBeams: ReasoningPath[] = [];&#10;&#10;    for (const beam of beams) {&#10;      const lastEntity = beam.entities[beam.entities.length - 1];&#10;      const neighbors = kg.getNeighbors(lastEntity);&#10;&#10;      for (const { relation, entity } of neighbors) {&#10;        const stepScore = computeStepScore(question, beam, relation, entity);&#10;        if (stepScore &gt;= config.pruneThreshold) {&#10;          nextBeams.push({&#10;            entities: [...beam.entities, entity],&#10;            relations: [...beam.relations, relation],&#10;            score: beam.score * stepScore,&#10;          });&#10;        }&#10;      }&#10;    }&#10;&#10;    beams = nextBeams.sort((a, b) =&gt; b.score - a.score).slice(0, config.beamWidth);&#10;  }&#10;&#10;  return beams;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MultiHopConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  maxHops</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  beamWidth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  pruneThreshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReasoningPath</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  entities</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  relations</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> 