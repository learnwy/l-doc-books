an></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> beams;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>推理方式</th>\n<th>可解释性</th>\n<th>多跳能力</th>\n<th>效率</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>子图检索</td>\n<td>提取子图后排序</td>\n<td>高</td>\n<td>受限于子图大小</td>\n<td>中</td>\n</tr>\n<tr>\n<td>路径排序</td>\n<td>枚举路径后评分</td>\n<td>高</td>\n<td>路径长度受限</td>\n<td>低</td>\n</tr>\n<tr>\n<td>嵌入推理</td>\n<td>向量空间多步运算</td>\n<td>低</td>\n<td>理论无限</td>\n<td>高</td>\n</tr>\n<tr>\n<td>图注意力</td>\n<td>GNN 消息传递</td>\n<td>中</td>\n<td>取决于层数</td>\n<td>中</td>\n</tr>\n</tbody></table>\n<h2 id=\"llm-与知识图谱结合\">LLM 与知识图谱结合</h2><p>大语言模型与知识图谱的结合是 KGQA 的最新范式。LLM 提供强大的自然语言理解和推理能力，知识图谱提供精确、结构化的事实知识，两者互补可以显著提升问答质量。</p>\n<p>Think-on-Graph（ToG）是一种代表性方法：LLM 在知识图谱上进行 &quot;思考&quot;，每一步选择最相关的关系和实体进行探索，直到找到答案。StructGPT 则让 LLM 通过工具调用的方式与知识图谱交互，执行结构化查询。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface TogConfig {&#10;  llm: LLMClient;&#10;  kg: KnowledgeGraph;&#10;  maxDepth: number;&#10;  explorationWidth: number;&#10;}&#10;&#10;async function thinkOnGraph(question: string, config: TogConfig): Promise&lt;{ answer: string; reasoning: string[] }&gt; {&#10;  const reasoning: string[] = [];&#10;  const entities = await config.llm.extractEntities(question);&#10;  let currentEntities = await linkEntities(entities, config.kg);&#10;&#10;  for (let depth = 0; depth &lt; config.maxDepth; depth++) {&#10;    const relations = getAvailableRelations(currentEntities, config.kg);&#10;    const selectedRelations = await config.llm.selectRelations(&#10;      question,&#10;      currentEntities,&#10;      relations,&#10;      config.explorationWidth,&#10;    );&#10;&#10;    const nextEntities = explore(currentEntities, selectedRelations, config.kg);&#10;    const shouldStop = await config.llm.checkTermination(question, nextEntities, reasoning);&#10;&#10;    reasoning.push(&#10;      `Step ${depth + 1}: ${selectedRelations.join(&#39;, &#39;)} -&gt; ${nextEntities.map((e) =&gt; e.label).join(&#39;, &#39;)}`,&#10;    );&#10;&#10;    if (shouldStop) break;&#10;    currentEntities = nextEntities;&#10;  }&#10;&#10;  const answer = await config.llm.generateAnswer(question, reasoning);&#10;  return { answer, reasoning };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TogConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  llm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LLMClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  kg</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> KnowledgeGraph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  maxDepth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  explorationWidth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span cl