24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, margin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> posScore </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> negScore);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>TransE 的主要局限是难以处理一对多、多对一和多对多关系。例如，如果多个实体 t1, t2, t3 都是 (h, r) 的正确尾实体，TransE 会迫使 t1 ≈ t2 ≈ t3，导致这些实体的表示退化为相同向量。TransH 和 TransR 通过引入关系特定的超平面投影和矩阵变换来解决这一问题。</p>\n<h2 id=\"语义匹配模型\">语义匹配模型</h2><p>语义匹配模型（Semantic Matching Models）通过实体和关系向量的交互来衡量三元组的合理性。DistMult 使用双线性对角模型：<code>f(h, r, t) = h^T · diag(r) · t = Σ h_i · r_i · t_i</code>。DistMult 天然适合对称关系（如「互为朋友」），因为 f(h, r, t) = f(t, r, h)，但无法区分非对称关系（如「父子关系」）。</p>\n<p>ComplEx 通过引入复数空间来解决非对称问题。实体和关系被嵌入到复数空间 C^d 中，评分函数取实部：<code>f(h, r, t) = Re(Σ h_i · r_i · t̄_i)</code>，其中 t̄ 是 t 的复共轭。复共轭的引入打破了对称性，使得 f(h, r, t) ≠ f(t, r, h)。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ComplExEmbedding {&#10;  readonly real: Float32Array;&#10;  readonly imaginary: Float32Array;&#10;}&#10;&#10;function complExScore(h: ComplExEmbedding, r: ComplExEmbedding, t: ComplExEmbedding): number {&#10;  let score = 0;&#10;  const dim = h.real.length;&#10;&#10;  for (let i = 0; i &lt; dim; i++) {&#10;    score += h.real[i] * r.real[i] * t.real[i];&#10;    score += h.imaginary[i] * r.real[i] * t.imaginary[i];&#10;    score += h.real[i] * r.imaginary[i] * t.imaginary[i];&#10;    score -= h.imaginary[i] * r.imaginary[i] * t.real[i];&#10;  }&#10;&#10;  return score;&#10;}&#10;&#10;function rotatEScore(h: ComplExEmbedding, r: ComplExEmbedding, t: ComplExEmbedding): number {&#10;  let score = 0;&#10;  const dim = h.real.length;&#10;&#10;  for (let i = 0; i &lt; dim; i++) {&#10;    const rotatedReal = h.real[i] * r.real[i] - h.imaginary[i] * r.imaginary[i];&#10;    const rotatedImag = h.real[i] * r.imaginary[i] + h.imaginary[i] * r.real[i];&#10;&#10;    const diffReal = rotatedReal - t.real[i];&#10;    const diffImag = rotatedImag - t.imaginary[i];&#10;&#10;    score += diffReal * diffReal + diffImag * diffImag;&#10;  }&#10;&#10;  return -Math.sqrt(score);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ComplExEmbedding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> real</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> imaginary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--sh