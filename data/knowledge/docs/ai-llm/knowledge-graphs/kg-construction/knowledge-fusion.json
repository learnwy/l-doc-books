esolve(conflict: Conflict): string;&#10;}&#10;&#10;function majorityVoting(conflict: Conflict): string {&#10;  const valueCounts = new Map&lt;string, number&gt;();&#10;  for (const cv of conflict.values) {&#10;    valueCounts.set(cv.value, (valueCounts.get(cv.value) ?? 0) + 1);&#10;  }&#10;  let maxCount = 0;&#10;  let result = &#39;&#39;;&#10;  for (const [value, count] of valueCounts) {&#10;    if (count &gt; maxCount) {&#10;      maxCount = count;&#10;      result = value;&#10;    }&#10;  }&#10;  return result;&#10;}&#10;&#10;function sourceQualityWeighted(conflict: Conflict, sourceWeights: Map&lt;string, number&gt;): string {&#10;  let bestValue = &#39;&#39;;&#10;  let bestScore = -Infinity;&#10;  for (const cv of conflict.values) {&#10;    const weight = sourceWeights.get(cv.source) ?? 0.5;&#10;    const score = weight * cv.confidence;&#10;    if (score &gt; bestScore) {&#10;      bestScore = score;&#10;      bestValue = cv.value;&#10;    }&#10;  }&#10;  return bestValue;&#10;}&#10;&#10;function temporalRecency(conflict: Conflict): string {&#10;  const sorted = [...conflict.values].sort((a, b) =&gt; b.timestamp.getTime() - a.timestamp.getTime());&#10;  return sorted[0].value;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConflictType</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'value_conflict'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'type_conflict'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'temporal_conflict'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span>