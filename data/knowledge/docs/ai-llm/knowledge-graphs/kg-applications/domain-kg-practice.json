9;guarantees&#39; | &#39;sued_by&#39;;&#10;&#10;interface RiskAssessment {&#10;  entity: string;&#10;  directRisks: RiskFactor[];&#10;  indirectRisks: RiskFactor[];&#10;  riskPropagationPaths: RiskPath[];&#10;}&#10;&#10;interface RiskPath {&#10;  entities: string[];&#10;  relations: string[];&#10;  riskScore: number;&#10;}&#10;&#10;function assessSupplyChainRisk(company: string, financialKG: FinancialKG, maxDepth: number = 3): RiskAssessment {&#10;  const directRisks = financialKG.getRelated(company, &#39;has_risk&#39;);&#10;  const suppliers = financialKG.traverseBFS(company, [&#39;supplies&#39;, &#39;depends_on&#39;], maxDepth);&#10;&#10;  const indirectRisks: RiskFactor[] = [];&#10;  const propagationPaths: RiskPath[] = [];&#10;&#10;  for (const supplier of suppliers) {&#10;    const risks = financialKG.getRelated(supplier.entity, &#39;has_risk&#39;);&#10;    for (const risk of risks) {&#10;      const path = financialKG.shortestPath(company, supplier.entity);&#10;      const riskScore = risk.severity / (path.length + 1);&#10;      indirectRisks.push({ ...risk, source: supplier.entity, propagatedScore: riskScore });&#10;      propagationPaths.push({ entities: path.entities, relations: path.relations, riskScore });&#10;    }&#10;  }&#10;&#10;  return {&#10;    entity: company,&#10;    directRisks: directRisks.map((r) =&gt; ({ ...r, source: company, propagatedScore: r.severity })),&#10;    indirectRisks,&#10;    riskPropagationPaths: propagationPaths.sort((a, b) =&gt; b.riskScore - a.riskScore),&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FinancialKGSchema</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-