ark:#E1E4E8\"> llm.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">generate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prompt);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> triples</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> parseTriples</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(response);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> validateTriples</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(triples, schema);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> validateTriples</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">triples</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Triple</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">schema</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OntologySchema</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Triple</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> triples.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> relation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> schema.properties.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.label </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t.predicate);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">relation) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>应用方向</th>\n<th>LLM 的贡献</th>\n<th>KG 的贡献</th>\n<th>联合效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>知识抽取</td>\n<td>语言理解和生成</td>\n<td>本体约束和验证</td>\n<td>更高精度的抽取</td>\n</tr>\n<tr>\n<td>事实核查</td>\n<td>推理和解释</td>\n<td>事实检索</td>\n<td>减少幻觉</td>\n</tr>\n<tr>\n<td>问答系统</td>\n<td>自然语言交互</td>\n<td>精确知识</td>\n<td>可靠的答案</td>\n</tr>\n<tr>\n<td>知识发现</td>\n<td>假设生成</td>\n<td>验证和补充</td>\n<td>新知识发现</td>\n</tr>\n</tbody></table>\n<h2 id=\"graphrag-与社区摘要\">GraphRAG 与社区摘要</h2><p>GraphRAG 是微软于 2024 年提出并开源的一种基于图结构的 RAG 方法。它不是简单地检索与问题相关的文档片段，而是首先用 LLM 从文档中抽取实体与关系构建知识图谱，然后利用图社区检测算法（通常为 Leiden）将图谱划分为多个主题社区，对每个社区分层生成摘要。查询时，系统将问题与社区摘要进行匹配，选择最相关的社区作为上下文。这种设计将原本分散在数百个文档中的全局信息压缩为若干社区摘要，使 LLM 能够在有限的上下文窗口内获得全局视角。</p>\n<p>这种方法特别适合需要全局理解（如 &quot;这个数据集的主要主题是什么&quot;）而非局部检索的问题。传统向量 RAG 在这类问题上表现不佳，因为答案分散在大量文档中，无法通过局部相似度命中。</p>\n<h3 id=\"图-rag-生态速览-2024-末-2026\">图 RAG 生态速览（2024 末–2026）</h3><p>自原版 GraphRAG 开源以来，图 RAG 已从单一实现演化为一个快速演化的生态（以下信息以各项目官方仓库和技术报告为准）：</p>\n<table>\n<thead>\n<tr>\n<th>项目</th>\n<th>来源 / 时间</th>\n<th>核心思路</th>\n<th>相对原版的关键差异</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>LazyGraphRAG</td>\n<td>微软，2024 末</td>\n<td>延迟计算：索引期仅用轻量嵌入 + NER 构建概念共现图，查询时才调用 LLM 精炼子图与摘要</td>\n<td>索引成本降低约一个数量级，适合数据频繁变化场景</td>\n</tr>\n<tr>\n<td>LightRAG</td>\n<td>港大等，2024-10（arXiv:2410.05779）</td>\n<td>双层检索：低层（实体细节）与高层（主题语义）并行，图谱支持增量插入</td>\n<td>更轻量，增量更新无需全量重建社区</td>\n</tr>\n<tr>\n<td>Graphiti</td>\n<td>Zep 开源，2024–2025</td>\n<td>时序知识图谱：双时间轴建模（事件发生时间 vs 摄入时间），过时边标记失效而非删除</td>\n<td>面向 Agent 记忆的动态图谱，支持时间感知检索</td>\n</tr>\n</tbody></table>\n<p>从工程视角看，这条演化线的共同趋势有三点：<strong>压低索引期的 LLM 调用成本</strong>、<strong>支持增量更新而非全量重建</strong>、<strong>从静态快照走向时序感知</strong>。选型直觉：静态语料的全局问答题可用原版 GraphRAG 或 LightRAG；数据高频变化、预算敏感优先 LazyGraphRAG 式延迟计算；Agent 长期记忆场景则应直接考虑 Graphiti 类时序图谱。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface GraphRAGPipeline {&#10;  extractEntities(chunks: string[]): Promise&lt;Entity[]&gt;;&#10;  buildGraph(entities: Entity[], relations: Relation[]): KnowledgeGraph;&#10;  detectCommunities(graph: KnowledgeGraph): Community[];&#10;  summarizeCommunities(communities: Community[]): CommunitySummary[];&#10;  query(question: string, summaries: CommunitySummary[]): Promise&lt;string&gt;;&#10;}&#10;&#10;interface Community {&#10;  id: string;&#10;  nodes: string[];&#10;  edges: Array&lt;{ source: string; target: string; relation: string }&gt;;&#10;  level: number;&#10;}&#10;&#10;interface CommunitySummary {&#10;  communityId: string;&#10;  title: string;&#10;  summary: string;&#10;  keyEntities: string[];&#10;  embedding: Float32Array;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphRAGPipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  extractEntities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">chunks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Entity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  buildGraph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">entities</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Entity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">relations</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Relation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> KnowledgeGraph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  detectCommunities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">graph</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> KnowledgeGraph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Community</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  summarizeCommunities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">communities</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Community</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CommunitySummary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">question</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">summaries</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CommunitySummary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Community</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  nodes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  edges</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">source</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">target</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">relation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  level</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CommunitySummary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  communityId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  title</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  summary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  keyEntities</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  embedding</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>KG 增强 LLM 通过结构化知识减少幻觉、提升事实准确性，是 AI 应用的核心技术方向</li>\n<li>KG-RAG 在推理阶段从图谱检索结构化知识作为上下文，无需重训模型</li>\n<li>LLM 反过来可以驱动 KG 构建，利用强大的语言理解能力提升抽取精度，且已成为图 RAG 系统构建图谱的标准路径</li>\n<li>GraphRAG 通过社区摘要支持全局理解型问题，弥补了传统 RAG 的局限；LazyGraphRAG、LightRAG、Graphiti 等后续工作正在把它推向更低成本、增量更新与时序感知</li>\n<li>KG 与 LLM 的结合是双向增强：KG 让 LLM 更准确，LLM 让 KG 更完善</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li><a href=\"../kg-reasoning/neural-reasoning\">神经网络推理</a>：LLM+KG 检索增强推理的方法基础</li>\n<li><a href=\"../kg-applications/kg-qa-systems\">知识图谱问答系统</a>：KG 为 LLM 提供可验证事实的典型问答落地</li>\n<li><a href=\"../../llm-fundamentals/evaluation-and-safety/hallucination-mitigation\">幻觉缓解（LLM 基础）</a>：KG 增强 LLM 的核心动机——用结构化事实压制幻觉</li>\n<li><a href=\"../../llm-fundamentals/rag-and-retrieval/rag-architecture\">RAG 架构（LLM 基础）</a>：GraphRAG 是 RAG 与 KG 结合的延伸形态</li>\n</ul>\n","headings":[{"level":1,"text":"知识图谱增强 LLM","id":"知识图谱增强-llm"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"KG-RAG 检索增强","id":"kg-rag-检索增强"},{"level":2,"text":"LLM 驱动的 KG 构建","id":"llm-驱动的-kg-构建"},{"level":2,"text":"GraphRAG 与社区摘要","id":"graphrag-与社区摘要"},{"level":3,"text":"图 RAG 生态速览（2024 末–2026）","id":"图-rag-生态速览-2024-末-2026"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"知识图谱增强搜索","url":"/l-doc-books/h/ai-llm/knowledge-graphs/kg-applications/kg-enhanced-search"},"next":{"title":"领域知识图谱实践","url":"/l-doc-books/h/ai-llm/knowledge-graphs/kg-applications/domain-kg-practice"}}