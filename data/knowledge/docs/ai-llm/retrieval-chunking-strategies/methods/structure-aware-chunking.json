#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxLength) }, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">index</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxLength, (index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxLength),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> chunkStructuralBlocks</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sourceId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">blocks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> StructuralBlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">maxLength</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> IndexedBlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> blocks.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">block</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">blockIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> parts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> block.text.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxLength </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [block.text] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> splitOversized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(block.text, maxLength);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> parts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">partIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">sourceId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">blockIndex</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">partIndex</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      path: block.path,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      text: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">block</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">path</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">' > '</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">text</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>验收不应只看每块是否小于上限，还要抽样验证标题路径是否正确、表格和代码围栏是否保持完整、解析器判定的阅读顺序是否符合页面。对同一份文档保存原始解析树、规范化结构块与最终索引块三层产物，才能在质量回归时定位责任边界。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>结构感知分块顺着文档自带的显式结构（Markdown 标题、HTML 标签、PDF 版面）切，对技术文档性价比最高，无需像语义分块那样猜边界。</li>\n<li>Markdown 标题切分保留完整标题路径作元数据，拼回块开头是几乎零成本的上下文增强；超长小节内部再套递归切分。</li>\n<li>HTML 必须先除噪（剥 script/nav/footer、正文抽取）再按语义标签切；表格需单独处理。</li>\n<li>PDF 最难，质量上限由前置版面解析决定，双栏/扫描件需版面还原与 OCR，否则错误会向下传播。</li>\n<li>继续阅读本 hub 的 <a href=\"fixed-recursive-chunking\">固定与递归分块</a>、<a href=\"../advanced/chunk-metadata\">元数据与上下文增强</a> 与 <a href=\"../advanced/multimodal-chunking\">表格代码多模态分块</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"结构感知分块","id":"结构感知分块"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Markdown 标题切分：把目录当边界","id":"markdown-标题切分-把目录当边界"},{"level":2,"text":"HTML 与网页：先除噪再切","id":"html-与网页-先除噪再切"},{"level":2,"text":"PDF 与版面：最难啃的结构","id":"pdf-与版面-最难啃的结构"},{"level":2,"text":"结构优先、长度兜底的两级算法","id":"结构优先-长度兜底的两级算法"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"语义分块","url":"/l-doc-books/h/ai-llm/retrieval-chunking-strategies/methods/semantic-chunking"},"next":{"title":"父子与窗口检索","url":"/l-doc-books/h/ai-llm/retrieval-chunking-strategies/advanced/parent-child-windows"}}