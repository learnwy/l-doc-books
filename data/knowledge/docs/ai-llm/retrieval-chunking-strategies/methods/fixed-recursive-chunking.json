dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (current) chunks.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">splitRecursively</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(current, maxLength, rest));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chunks.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">chunk</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chunk.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">trim</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> chunks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> splitRecursively</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'第一段。第二段很长。第三段。'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'。'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'，'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span></code></pre></div><p>上线前要补三类测试：中英文标点混合时不丢字符；超长无分隔文本最终能降级完成；所有输出按顺序拼接后与输入语义等价。若还要重叠，应在递归切分完成后按 token 区间生成窗口，而不是在每一级递归里重复注入文本，否则很容易制造指数级重复。</p>\n<h2 id=\"什么时候该升级到更高级的方法\">什么时候该升级到更高级的方法</h2><p>递归切分是个强默认，但不是万能。它仍然「不理解内容」：它在句号处断开，却不知道两段话是否其实在讲同一件事、该不该合并。当出现以下信号，就该考虑升级——但要先用 <a href=\"../practice/chunking-evaluation\">分块评测</a> 确认收益盖过成本，因为更高级的方法往往慢得多、复杂得多。</p>\n<p>升级方向取决于瓶颈在哪。若文档有清晰的标题层级（Markdown、技术手册），升级到 <a href=\"structure-aware-chunking\">结构感知分块</a> 通常立竿见影。若内容是密集交叉引用的通用散文、且递归切分的块主题混杂，可评估 <a href=\"semantic-chunking\">语义分块</a>，但要警惕它易碎成超短块。若问题是「召回准但单块上下文不足」，那不是切法问题，而该上 <a href=\"../advanced/parent-child-windows\">父子与窗口检索</a>。值得强调：2026 年的基准共识是，绝大多数项目根本不需要升级，递归切分已经够好，过早上语义分块往往是得不偿失的过度工程。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>固定与递归切分不理解内容、只依赖结构信号，却是应优先建立的强基线；复杂方法必须在同一评测集上证明收益。</li>\n<li>固定切分会盲切词/句，仅适合无结构文本或需绝对均匀块长的场景，常靠重叠缓解。</li>\n<li>递归切分按「段→行→句→词」有序分隔符逐级降级，尊重自然边界，几乎零额外成本，是通用默认；中文需把中文标点加入分隔符。</li>\n<li>升级到语义/结构/父子方法前，先用评测确认收益，多数项目无需升级——过早上语义分块常是过度工程。</li>\n<li>继续阅读本 hub 的 <a href=\"semantic-chunking\">语义分块</a>、<a href=\"structure-aware-chunking\">结构感知分块</a> 与 <a href=\"../foundations/chunk-size-overlap\">分块粒度与重叠</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"固定与递归分块","id":"固定与递归分块"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"固定大小切分：朴素但有用","id":"固定大小切分-朴素但有用"},{"level":2,"text":"递归字符切分：尊重自然边界","id":"递归字符切分-尊重自然边界"},{"level":2,"text":"一个可运行的递归切分核心","id":"一个可运行的递归切分核心"},{"level":2,"text":"什么时候该升级到更高级的方法","id":"什么时候该升级到更高级的方法"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"分块对检索的影响","url":"/l-doc-books/h/ai-llm/retrieval-chunking-strategies/foundations/chunking-impact"},"next":{"title":"语义分块","url":"/l-doc-books/h/ai-llm/retrieval-chunking-strategies/methods/semantic-chunking"}}