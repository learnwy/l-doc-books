-shiki-dark:#79B8FF\"> 700</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mel_high </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2595</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.log10(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> high_freq </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 700</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mel_points </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.linspace(mel_low, mel_high, n_mels </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    hz_points </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 700</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> **</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (mel_points </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2595</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    bins </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.floor((n_fft </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hz_points </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sr).astype(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fbank </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.zeros((n_mels, n_fft </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">//</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(n_mels):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        fbank[i, bins[i]:bins[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.linspace(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, bins[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bins[i])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        fbank[i, bins[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]:bins[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.linspace(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, bins[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bins[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fbank</span></span></code></pre></div><p>FBank（梅尔滤波器组特征）省略了 MFCC 的 DCT 步骤，直接使用梅尔滤波器组的对数输出，保留了更多频域信息。在深度学习时代，FBank 已经取代 MFCC 成为主流特征，因为深度模型能够自动学习更优的特征变换。Whisper 等模型使用 80 维的 log-Mel spectrogram 作为输入。</p>\n<h2 id=\"ctc-与端到端模型\">CTC 与端到端模型</h2><p>CTC（Connectionist Temporal Classification）是实现端到端语音识别的关键技术。它解决了语音识别中的对齐问题——训练数据只提供了音频和对应的文字，但没有逐帧的对齐标注。CTC 引入了空白符号（blank），允许模型在任意时刻输出空白来表示&quot;当前帧不输出字符&quot;。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[音频帧序列] --&gt; B[编码器]&#10;    B --&gt; C[帧级概率分布]&#10;    C --&gt; D{解码方式}&#10;    D --&gt;|CTC| E[前缀搜索]&#10;    D --&gt;|Attention| F[自回归解码]&#10;    D --&gt;|CTC+Att| G[联合解码]&#10;    E --&gt; H[文本输出]&#10;    F --&gt; H&#10;    G --&gt; H\">graph TD\n    A[音频帧序列] --&gt; B[编码器]\n    B --&gt; C[帧级概率分布]\n    C --&gt; D{解码方式}\n    D --&gt;|CTC| E[前缀搜索]\n    D --&gt;|Attention| F[自回归解码]\n    D --&gt;|CTC+Att| G[联合解码]\n    E --&gt; H[文本输出]\n    F --&gt; H\n    G --&gt; H</pre><p>Conformer 是当前语音识别最常用的编码器架构。它将卷积层和 Transformer 的自注意力层交替堆叠——卷积层捕捉局部的时频模式（如辅音的短时频谱特征），自注意力层建模全局依赖（如长距离的语义关系）。这种混合架构在多个基准上超越了纯 Transformer 和纯卷积模型。</p>\n<p>联合 CTC-Attention 模型同时训练 CTC 分支和 Attention 解码器，在推理时用 CTC 前缀分数辅助 Attention 束搜索。CTC 提供了单调的对齐约束（输出顺序与输入顺序一致），Attention 提供了灵活的条件生成能力，二者互补。WeNet 和 ESPnet 等开源框架都采用了这种联合架构。</p>\n<h2 id=\"whisper-与大规模预训练\">Whisper 与大规模预训练</h2><p>Whisper 是 OpenAI 发布的大规模弱监督语音识别模型。它在 68 万小时的互联网音频数据上训练（涵盖 96 种语言），使用 Transformer Encoder-Decoder 架构。Whisper 的核心创新不在模型架构（标准 Transformer），而在训练策略——使用互联网上大规模的弱标注数据（如视频字幕）替代高成本的精标注数据。</p>\n<table>\n<thead>\n<tr>\n<th>Whisper 模型</th>\n<th>参数量</th>\n<th>英语 WER</th>\n<th>多语言 WER</th>\n<th>推理速度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>tiny</td>\n<td>39M</td>\n<td>7.6%</td>\n<td>14.2%</td>\n<td>极快</td>\n</tr>\n<tr>\n<td>base</td>\n<td>74M</td>\n<td>5.0%</td>\n<td>10.5%</td>\n<td>快</td>\n</tr>\n<tr>\n<td>small</td>\n<td>244M</td>\n<td>3.4%</td>\n<td>8.3%</td>\n<td>中</td>\n</tr>\n<tr>\n<td>medium</td>\n<td>769M</td>\n<td>2.9%</td>\n<td>7.0%</td>\n<td>较慢</td>\n</tr>\n<tr>\n<td>large-v3</td>\n<td>1.5B</td>\n<td>2.1%</td>\n<td>5.3%</td>\n<td>慢</td>\n</tr>\n</tbody></table>\n<p>流式语音识别是工程落地的核心需求。离线模型需要等待整段语音结束才能开始识别，而流式模型可以实时输出中间结果。分块注意力（Chunk-based Attention）将输入按固定时长分块，每个块只关注当前块和之前的块，实现了低延迟的流式输出。</p>\n<h2 id=\"从-whisper-到语音大模型-2023-2026\">从 Whisper 到语音大模型（2023–2026）</h2><p>Whisper 之后，ASR 沿三条主线继续演进，截至 2026 年的格局大致如下：</p>\n<p><strong>蒸馏与加速</strong>。Whisper 本体持续迭代（large-v3 于 2023 年 11 月发布），社区蒸馏路线降低了部署门槛——Distil-Whisper（Hugging Face，2023）在保持接近精度的同时大幅缩小模型；OpenAI 于 2024 年 10 月推出的 large-v3-turbo 将解码层削减至 4 层，速度提升约 8 倍，成为转写场景的性价比默认选择。</p>\n<p><strong>API 语音模型与开源强基线</strong>。2025 年 3 月 OpenAI 发布 gpt-4o-transcribe 系列，把 ASR 建立在多模态基座之上，公开评测显示其 WER 优于 Whisper large-v3。开源侧也出现了更强的专用模型：阿里 FunAudioLLM 的 SenseVoice-Small（2024 年开源）主打多语言+情感标注与极高推理速度；小红书 FireRedASR（2025 年初开源）在中文基准上取得领先；工业流式场景中 Paraformer/FunASR 等仍是常见选择。中文/多语言生产选型已不必默认绑定 Whisper。</p>\n<p><strong>语音进入多模态 LLM</strong>。GPT-4o、Qwen-Omni 等端到端语音对话模型将音频作为 LLM 的原生输入输出模态，&quot;识别—理解—生成&quot;在单一模型内完成。这正在吸收一部分传统 ASR 的应用面（如语音对话、同声传译原型），但转写、字幕、会议记录等纯转写场景中，独立 ASR 模型因成本低、可控性强而仍是刚需——两种路线在可预见的时期内将长期共存。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((语音识别))&#10;    声学前端&#10;      MFCC/FBank&#10;      梅尔频谱图&#10;      数据增强&#10;    模型架构&#10;      CTC&#10;      Attention&#10;      Conformer&#10;    大规模预训练&#10;      Whisper&#10;      蒸馏与turbo&#10;      多语言识别&#10;    语音大模型&#10;      API语音模型&#10;      开源强基线&#10;      多模态端到端&#10;    工程实践&#10;      流式识别&#10;      端点检测&#10;      噪声鲁棒\">mindmap\n  root((语音识别))\n    声学前端\n      MFCC/FBank\n      梅尔频谱图\n      数据增强\n    模型架构\n      CTC\n      Attention\n      Conformer\n    大规模预训练\n      Whisper\n      蒸馏与turbo\n      多语言识别\n    语音大模型\n      API语音模型\n      开源强基线\n      多模态端到端\n    工程实践\n      流式识别\n      端点检测\n      噪声鲁棒</pre><ul>\n<li>语音识别将语音信号转换为文字，WER/CER 是标准评估指标</li>\n<li>FBank 和梅尔频谱图是深度学习时代的主流声学特征</li>\n<li>CTC 解决了帧级对齐问题，Conformer 结合卷积和注意力捕捉局部和全局模式</li>\n<li>联合 CTC-Attention 模型利用两者优势，是当前主流的端到端架构</li>\n<li>Whisper 通过大规模弱监督预训练实现了 96 种语言的强大识别能力</li>\n<li>Whisper 之后（2023–2026）：蒸馏加速（large-v3-turbo、Distil-Whisper）、API 语音模型（gpt-4o-transcribe）与开源强基线（SenseVoice、FireRedASR）并行，语音正成为多模态 LLM 的原生模态</li>\n<li>流式识别通过分块注意力实现低延迟输出，是工程落地的核心需求</li>\n</ul>\n","headings":[{"level":1,"text":"语音识别","id":"语音识别"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"声学特征与前端处理","id":"声学特征与前端处理"},{"level":2,"text":"CTC 与端到端模型","id":"ctc-与端到端模型"},{"level":2,"text":"Whisper 与大规模预训练","id":"whisper-与大规模预训练"},{"level":2,"text":"从 Whisper 到语音大模型（2023–2026）","id":"从-whisper-到语音大模型-2023-2026"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"表格抽取","url":"/l-doc-books/h/ai-llm/natural-language-processing/information-extraction/table-extraction"},"next":{"title":"语音合成","url":"/l-doc-books/h/ai-llm/natural-language-processing/speech-processing/speech-synthesis"}}