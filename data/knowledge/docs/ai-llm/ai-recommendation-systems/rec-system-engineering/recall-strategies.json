E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> commonUsers.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> userI</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> commonUsers[i];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> userJ</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> commonUsers[j];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> commonCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">userItems.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userI)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userItems.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userJ)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item)).</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (commonCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.alpha);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> score;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Swing 的核心思想是：如果两个物品被共同交互的用户对之间重叠较少（即这些用户的兴趣比较独特），那么这两个物品的相似度应该更高。这种设计惩罚了活跃用户对相似度计算的过大影响。</p>\n<h2 id=\"多路召回融合与配额分配\">多路召回融合与配额分配</h2><p>多路召回的配额分配直接影响推荐效果。每路召回的配额需要根据其对最终推荐效果的贡献来动态调整。</p>\n<table>\n<thead>\n<tr>\n<th>分配策略</th>\n<th>方法</th>\n<th>优势</th>\n<th>劣势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>固定配额</td>\n<td>人工设定</td>\n<td>简单稳定</td>\n<td>无法自适应</td>\n</tr>\n<tr>\n<td>效果加权</td>\n<td>按线上贡献占比</td>\n<td>动态调整</td>\n<td>需要持续监控</td>\n</tr>\n<tr>\n<td>Bandit 分配</td>\n<td>多臂老虎机</td>\n<td>自动探索优化</td>\n<td>收敛较慢</td>\n</tr>\n<tr>\n<td>用户分群</td>\n<td>不同用户不同配额</td>\n<td>个性化</td>\n<td>维护成本高</td>\n</tr>\n</tbody></table>\n<p>召回通道之间的重合度也是重要的监控指标。如果两个通道的重合度过高，说明它们覆盖了相似的物品空间，应该考虑合并或调整。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>召回是推荐系统的第一阶段，从全量物品中快速筛选候选集，核心目标是高召回率和低延迟</li>\n<li>向量召回（双塔模型 + ANN）是最主流的泛化召回方法，能捕获语义层面的用户-物品匹配</li>\n<li>Swing 改进了 I2I 相似度计算，惩罚活跃用户的过大影响，提升长尾物品的召回</li>\n<li>多路召回覆盖不同推荐维度，配额分配需要基于效果贡献动态优化</li>\n<li>召回质量是排序效果的上界，召回阶段遗漏的物品无法在后续阶段被补回</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>同 hub：<a href=\"../deep-rec-models/embedding-based-models\">基于嵌入的推荐模型</a> —— 本篇向量召回所依赖的双塔模型训练细节。</li>\n<li>同 hub：<a href=\"../collaborative-filtering/memory-based-cf\">基于记忆的协同过滤</a> —— Swing/I2I 通道背后的 ItemCF 相似度原理。</li>\n</ul>\n","headings":[{"level":1,"text":"召回策略","id":"召回策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基于向量的召回","id":"基于向量的召回"},{"level":2,"text":"Swing 与 I2I 召回","id":"swing-与-i2i-召回"},{"level":2,"text":"多路召回融合与配额分配","id":"多路召回融合与配额分配"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"序列推荐","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-algorithms/sequential-recommendation"},"next":{"title":"排序与重排序","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-system-engineering/ranking-reranking"}}