on</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> calculateRequiredSampleSize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  baselineMetric</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  expectedUplift</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  alpha</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  beta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> delta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baselineMetric </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> expectedUplift;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> variance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baselineMetric </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baselineMetric);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> zAlpha</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1.96</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> zBeta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.84</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ceil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> variance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (zAlpha </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> zBeta) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> delta </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>分层实验（Layered Experimentation）允许多个实验同时运行在同一批用户上。通过将流量分为正交的层（Layer），不同层的实验互不干扰。Google 的 Overlapping Experiment Infrastructure 是分层实验的工业标杆。</p>\n<h2 id=\"推荐核心指标体系\">推荐核心指标体系</h2><p>推荐系统的在线指标需要覆盖用户体验、商业价值和平台生态三个维度。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"分层实验的核心设计是流量正交性。每一层使用不同的哈希盐（Salt），确保同一用户在不同层被独立随机分配到不同实验组。例如，召回层实验和排序层实验位于不同的实验层，同一用户可能在召回层属于实验组，在排序层属于对照组。这种设计使得多个团队可以并行开展实验而互不干扰。&#10;&#10;```typescript&#10;interface ExperimentLayer {&#10;  layerId: string&#10;  salt: string&#10;  experiments: ExperimentConfig[]&#10;  trafficAllocation: Map&lt;string, number&gt;&#10;}&#10;&#10;interface MultiLayerSystem {&#10;  layers: ExperimentLayer[]&#10;}&#10;&#10;function getLayerAssignment(&#10;  userId: string,&#10;  layer: ExperimentLayer,&#10;): string {&#10;  const bucket = murmurhash(`${userId}:${layer.salt}`) % 1000&#10;  let accumulated = 0&#10;  for (const [experimentId, traffic] of layer.trafficAllocation) {&#10;    accumulated += traffic * 1000&#10;    if (bucket &lt; accumulated) return experimentId&#10;  }&#10;  return &#39;control&#39;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">分层实验的核心设计是流量正交性。每一层使用不同的哈希盐（Salt），确保同一用户在不同层被独立随机分配到不同实验组。例如，召回层实验和排序层实验位于不同的实验层，同一用户可能在召回层属于实验组，在排序层属于对照组。这种设计使得多个团队可以并行开展实验而互不干扰。</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">```typescript</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">interface ExperimentLayer {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  layerId: string</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  salt: string</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  experiments: ExperimentConfig[]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  trafficAllocation: Map&#x3C;string, number></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">interface MultiLayerSystem {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  layers: ExperimentLayer[]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">function getLayerAssignment(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  userId: string,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  layer: ExperimentLayer,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">): string {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  const bucket = murmurhash(`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">${userId}:${layer.salt}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`) % 1000</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  let accumulated = 0</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  for (const [experimentId, traffic] of layer.trafficAllocation) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    accumulated += traffic * 1000</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    if (bucket &#x3C; accumulated) return experimentId</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  return 'control'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span></code></pre></div><p>interface RecMetrics { engagement: EngagementMetrics; business: BusinessMetrics; ecosystem: EcosystemMetrics; }</p>\n<p>interface EngagementMetrics { ctr: number; timeSpent: number; sessionLength: number; returnRate: number; diversityIndex: number; }</p>\n<p>interface BusinessMetrics { gmv: number; arpu: number; conversionRate: number; orderCount: number; avgOrderValue: number; }</p>\n<p>interface EcosystemMetrics { creatorRetention: number; itemCoverage: number; giniCoefficient: number; longTailExposure: number; }</p>\n<p>function computeListDiversity(items: string[], categoryFn: (item: string) =&gt; string): number { const categories = items.map(categoryFn); const uniqueCategories = new Set(categories); return uniqueCategories.size / items.length; }</p>\n<p>function computeGiniCoefficient(exposures: number[]): number { const sorted = [...exposures].sort((a, b) =&gt; a - b); const n = sorted.length; const mean = sorted.reduce((s, v) =&gt; s + v, 0) / n; let numerator = 0; for (let i = 0; i &lt; n; i++) { for (let j = 0; j &lt; n; j++) { numerator += Math.abs(sorted[i] - sorted[j]); } } return numerator / (2 _ n _ n * mean); }</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"&#10;| 指标       | 计算方式            | 衡量维度 | 注意事项       |&#10;| ---------- | ------------------- | -------- | -------------- |&#10;| CTR        | 点击/曝光           | 用户兴趣 | 受位置偏差影响 |&#10;| CVR        | 转化/点击           | 商业转化 | 延迟转化需等待 |&#10;| 用户时长   | 总停留时间/DAU      | 用户黏性 | 需排除异常值   |&#10;| 物品覆盖率 | 被曝光物品/全量物品 | 生态公平 | 区分品类计算   |&#10;| 基尼系数   | 曝光量不平等度      | 供给均衡 | 越低越均衡     |&#10;&#10;## 常见实验陷阱&#10;&#10;在线实验中存在多种可能导致错误结论的陷阱，需要仔细识别和避免。&#10;&#10;Simpson 悖论：在整体和子群中观察到相反的趋势。例如，新策略整体 CTR 下降，但在每个用户群中 CTR 都上升——这是因为新策略改变了不同用户群的流量占比。新奇效应：用户对新策略的初始反应可能高于或低于长期效果。需要等待足够长的时间让效果稳定。溢出效应：实验组用户的行为可能影响对照组（如社交推荐场景），导致实验效果被低估或高估。&#10;&#10;## 小结&#10;&#10;- A/B 测试是验证推荐策略改进的金标准，分流正确性和样本量是基础保障&#10;- 分层实验允许多个实验并行运行，是大规模推荐系统的标准实验基础设施&#10;- 推荐指标需覆盖用户体验（CTR、时长）、商业价值（GMV、CVR）和生态健康（覆盖率、基尼系数）&#10;- Simpson 悖论、新奇效应和溢出效应是常见的实验陷阱，需要通过正确的实验设计来规避&#10;- 实验决策应基于主要指标的统计显著性和护栏指标的安全性综合判断\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span></span></span>\n<span class=\"line\"><span>| 指标       | 计算方式            | 衡量维度 | 注意事项       |</span></span>\n<span class=\"line\"><span>| ---------- | ------------------- | -------- | -------------- |</span></span>\n<span class=\"line\"><span>| CTR        | 点击/曝光           | 用户兴趣 | 受位置偏差影响 |</span></span>\n<span class=\"line\"><span>| CVR        | 转化/点击           | 商业转化 | 延迟转化需等待 |</span></span>\n<span class=\"line\"><span>| 用户时长   | 总停留时间/DAU      | 用户黏性 | 需排除异常值   |</span></span>\n<span class=\"line\"><span>| 物品覆盖率 | 被曝光物品/全量物品 | 生态公平 | 区分品类计算   |</span></span>\n<span class=\"line\"><span>| 基尼系数   | 曝光量不平等度      | 供给均衡 | 越低越均衡     |</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>## 常见实验陷阱</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>在线实验中存在多种可能导致错误结论的陷阱，需要仔细识别和避免。</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>Simpson 悖论：在整体和子群中观察到相反的趋势。例如，新策略整体 CTR 下降，但在每个用户群中 CTR 都上升——这是因为新策略改变了不同用户群的流量占比。新奇效应：用户对新策略的初始反应可能高于或低于长期效果。需要等待足够长的时间让效果稳定。溢出效应：实验组用户的行为可能影响对照组（如社交推荐场景），导致实验效果被低估或高估。</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>## 小结</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>- A/B 测试是验证推荐策略改进的金标准，分流正确性和样本量是基础保障</span></span>\n<span class=\"line\"><span>- 分层实验允许多个实验并行运行，是大规模推荐系统的标准实验基础设施</span></span>\n<span class=\"line\"><span>- 推荐指标需覆盖用户体验（CTR、时长）、商业价值（GMV、CVR）和生态健康（覆盖率、基尼系数）</span></span>\n<span class=\"line\"><span>- Simpson 悖论、新奇效应和溢出效应是常见的实验陷阱，需要通过正确的实验设计来规避</span></span>\n<span class=\"line\"><span>- 实验决策应基于主要指标的统计显著性和护栏指标的安全性综合判断</span></span></code></pre></div><h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>同 hub：<a href=\"../rec-engineering/rec-evaluation\">推荐效果评估</a> —— 本篇 AB 实验所处的完整三层评估体系（离线/在线/长期）。</li>\n<li>同 hub：<a href=\"../rec-applications/content-recommendation\">内容推荐</a> —— 实验中生态类指标（基尼系数、覆盖率）的业务来源。</li>\n</ul>\n","headings":[{"level":1,"text":"在线实验与 A/B 测试","id":"在线实验与-a-b-测试"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"实验设计与分流","id":"实验设计与分流"},{"level":2,"text":"推荐核心指标体系","id":"推荐核心指标体系"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"排序与重排序","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-system-engineering/ranking-reranking"},"next":{"title":"推荐系统工程架构","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-engineering/rec-system-architecture"}}