 const scores: number[] = [];&#10;  for (let i = 0; i &lt; sequence.length; i++) {&#10;    if (!mask[i]) {&#10;      scores.push(-Infinity);&#10;      continue;&#10;    }&#10;    scores.push(dotProduct(sequence[i], target));&#10;  }&#10;&#10;  const weights = softmax(new Float32Array(scores));&#10;  const dim = target.length;&#10;  const result = new Float32Array(dim);&#10;&#10;  for (let i = 0; i &lt; sequence.length; i++) {&#10;    for (let d = 0; d &lt; dim; d++) {&#10;      result[d] += weights[i] * sequence[i][d];&#10;    }&#10;  }&#10;&#10;  return result;&#10;}&#10;&#10;interface PositionalEncoding {&#10;  type: &#39;sinusoidal&#39; | &#39;learnable&#39; | &#39;relative_time&#39;;&#10;  maxLength: number;&#10;  dimension: number;&#10;}&#10;&#10;function timeAwarePositionalEncoding(timestamps: number[], currentTime: number, dimension: number): Float32Array[] {&#10;  return timestamps.map((t) =&gt; {&#10;    const timeDiff = (currentTime - t) / 3600000;&#10;    const encoding = new Float32Array(dimension);&#10;    for (let i = 0; i &lt; dimension; i += 2) {&#10;      const freq = 1 / Math.pow(10000, i / dimension);&#10;      encoding[i] = Math.sin(timeDiff * freq);&#10;      if (i + 1 &lt; dimension) encoding[i + 1] = Math.cos(timeDiff * freq);&#10;    }&#10;    return encoding;&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SequenceFeature</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  items</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></sp