{"seq":3,"slug":"feature-engineering","title":"推荐特征工程","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-fundamentals/feature-engineering","wordCount":844,"readingTime":4,"html":"<h1 id=\"推荐特征工程\">推荐特征工程</h1><h2 id=\"核心概念\">核心概念</h2><p>特征工程（Feature Engineering）是推荐系统中将原始数据转化为模型输入特征的过程，直接决定了模型的性能上界。推荐系统的特征来源多样，包括用户侧、物品侧、上下文侧以及用户-物品交叉侧，需要从海量原始数据中提炼出有效的信号。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph 特征来源&#10;        RAW_U[用户原始数据] --&gt; FE_U[用户特征]&#10;        RAW_I[物品原始数据] --&gt; FE_I[物品特征]&#10;        RAW_C[上下文数据] --&gt; FE_C[上下文特征]&#10;        RAW_UI[交互数据] --&gt; FE_UI[交叉特征]&#10;    end&#10;    FE_U --&gt; MODEL[推荐模型]&#10;    FE_I --&gt; MODEL&#10;    FE_C --&gt; MODEL&#10;    FE_UI --&gt; MODEL\">graph TB\n    subgraph 特征来源\n        RAW_U[用户原始数据] --&gt; FE_U[用户特征]\n        RAW_I[物品原始数据] --&gt; FE_I[物品特征]\n        RAW_C[上下文数据] --&gt; FE_C[上下文特征]\n        RAW_UI[交互数据] --&gt; FE_UI[交叉特征]\n    end\n    FE_U --&gt; MODEL[推荐模型]\n    FE_I --&gt; MODEL\n    FE_C --&gt; MODEL\n    FE_UI --&gt; MODEL</pre><table>\n<thead>\n<tr>\n<th>特征类别</th>\n<th>示例</th>\n<th>处理方式</th>\n<th>存储方式</th>\n<th>更新频率</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>用户静态</td>\n<td>年龄、性别</td>\n<td>Embedding</td>\n<td>离线特征表</td>\n<td>天级</td>\n</tr>\n<tr>\n<td>用户动态</td>\n<td>近7天点击品类</td>\n<td>聚合统计</td>\n<td>特征服务</td>\n<td>小时级</td>\n</tr>\n<tr>\n<td>用户实时</td>\n<td>当前 session 行为</td>\n<td>实时计算</td>\n<td>内存缓存</td>\n<td>秒级</td>\n</tr>\n<tr>\n<td>物品静态</td>\n<td>品类、价格</td>\n<td>Embedding</td>\n<td>离线特征表</td>\n<td>天级</td>\n</tr>\n<tr>\n<td>物品统计</td>\n<td>CTR、CVR</td>\n<td>滑动窗口统计</td>\n<td>特征服务</td>\n<td>小时级</td>\n</tr>\n<tr>\n<td>交叉特征</td>\n<td>用户-品类偏好度</td>\n<td>矩阵计算</td>\n<td>特征服务</td>\n<td>天级</td>\n</tr>\n<tr>\n<td>上下文</td>\n<td>时间、位置、设备</td>\n<td>数值/Embedding</td>\n<td>实时传入</td>\n<td>实时</td>\n</tr>\n</tbody></table>\n<h2 id=\"离散特征编码\">离散特征编码</h2><p>推荐系统中大量特征是离散的（如用户 ID、物品 ID、品类、城市等），需要编码为数值向量。Embedding 是处理高基数离散特征的标准方法。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface EmbeddingTable {&#10;  vocabSize: number;&#10;  embeddingDim: number;&#10;  weights: Float32Array[];&#10;  defaultEmbedding: Float32Array;&#10;}&#10;&#10;interface FeatureConfig {&#10;  name: string;&#10;  type: &#39;categorical&#39; | &#39;numerical&#39; | &#39;sequence&#39; | &#39;multi_hot&#39;;&#10;  vocabSize?: number;&#10;  embeddingDim?: number;&#10;  hashBuckets?: number;&#10;}&#10;&#10;function hashEmbedding(&#10;  featureValue: string,&#10;  numBuckets: number,&#10;  embeddingDim: number,&#10;  table: Float32Array[],&#10;): Float32Array {&#10;  const hashValue = murmurhash(featureValue) % numBuckets;&#10;  return table[hashValue];&#10;}&#10;&#10;function multiHotEncoding(&#10;  values: string[],&#10;  embeddingTable: EmbeddingTable,&#10;  pooling: &#39;mean&#39; | &#39;sum&#39; | &#39;max&#39;,&#10;): Float32Array {&#10;  const embeddings = values.map((v) =&gt; {&#10;    const idx = hashString(v) % embeddingTable.vocabSize;&#10;    return embeddingTable.weights[idx] ?? embeddingTable.defaultEmbedding;&#10;  });&#10;&#10;  if (pooling === &#39;sum&#39;) {&#10;    return sumVectors(embeddings);&#10;  }&#10;  if (pooling === &#39;max&#39;) {&#10;    return maxPoolVectors(embeddings);&#10;  }&#10;  return meanVectors(embeddings);&#10;}&#10;&#10;interface FeatureInteraction {&#10;  features: string[];&#10;  method: &#39;concat&#39; | &#39;hadamard&#39; | &#39;bilinear&#39; | &#39;fm&#39;;&#10;}&#10;&#10;function fmInteraction(embeddings: Float32Array[]): Float32Array {&#10;  const n = embeddings.length;&#10;  const dim = embeddings[0].length;&#10;  const sumOfSquare = new Float32Array(dim);&#10;  const squareOfSum = new Float32Array(dim);&#10;&#10;  for (let i = 0; i &lt; n; i++) {&#10;    for (let d = 0; d &lt; dim; d++) {&#10;      squareOfSum[d] += embeddings[i][d];&#10;      sumOfSquare[d] += embeddings[i][d] * embeddings[i][d];&#10;    }&#10;  }&#10;&#10;  const result = new Float32Array(dim);&#10;  for (let d = 0; d &lt; dim; d++) {&#10;    result[d] = 0.5 * (squareOfSum[d] * squareOfSum[d] - sumOfSquare[d]);&#10;  }&#10;  return result;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EmbeddingTable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  vocabSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  embeddingDim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  weights</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  defaultEmbedding</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FeatureConfig</span><span style=\"color:#24292E