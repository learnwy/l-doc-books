pan style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(dim);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; e </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> expertOutputs.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; e</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; d </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dim; d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        output[d] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gateWeights[e] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> expertOutputs[e][d];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> output;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>深度推荐模型从 Wide &amp; Deep 开始，通过自动特征交叉和序列建模超越了传统方法</li>\n<li>DCN-V2 通过矩阵参数化的交叉网络实现高效的显式高阶特征交互</li>\n<li>DIN/DIEN/SIM 系列通过注意力和时序建模捕获用户兴趣的多样性和演化</li>\n<li>MMOE/PLE 通过专家网络和门控机制处理多任务优化中的跷跷板效应</li>\n<li>模型效果的提升需要与特征工程、训练策略和在线系统优化协同推进</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>同 hub：<a href=\"../deep-rec-models/embedding-based-models\">基于嵌入的推荐模型</a> —— 本篇 Wide &amp; Deep、DCN、DIN 部分的深入篇。</li>\n<li>同 hub：<a href=\"../deep-rec-models/sequence-rec-models\">序列推荐模型</a> —— 本篇 DIN/DIEN/SIM 序列建模线的完整展开与工业部署。</li>\n</ul>\n","headings":[{"level":1,"text":"深度推荐模型","id":"深度推荐模型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Wide & Deep 与特征交叉网络","id":"wide-deep-与特征交叉网络"},{"level":2,"text":"用户行为序列建模","id":"用户行为序列建模"},{"level":2,"text":"多任务与多目标优化","id":"多任务与多目标优化"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"协同过滤","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-algorithms/collaborative-filtering"},"next":{"title":"序列推荐","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-algorithms/sequential-recommendation"}}