/span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Infinity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> weights</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> softmax</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(scores));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> weightedSum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(values, weights);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outputs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(output);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> outputs;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>SASRec 使用因果注意力掩码（Causal Mask），确保位置 i 的预测只能看到位置 i 之前的信息。训练时采用 next-item prediction 目标，对序列中每个位置预测下一个物品。</p>\n<h2 id=\"bert4rec-与双向建模\">BERT4Rec 与双向建模</h2><p>BERT4Rec 将 BERT 的掩码语言模型（MLM）思想应用到序列推荐中。与 SASRec 的单向（左到右）建模不同，BERT4Rec 采用双向注意力，在训练时随机掩码序列中的部分物品，让模型基于上下文预测被掩码的物品。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface BERT4RecConfig {&#10;  maxSeqLength: number;&#10;  embeddingDim: number;&#10;  numHeads: number;&#10;  numBlocks: number;&#10;  maskRatio: number;&#10;}&#10;&#10;function maskSequence(&#10;  sequence: string[],&#10;  maskRatio: number,&#10;  maskToken: string,&#10;): { maskedSequence: string[]; maskedPositions: number[]; originalItems: string[] } {&#10;  const maskedSequence = [...sequence];&#10;  const maskedPositions: number[] = [];&#10;  const originalItems: string[] = [];&#10;&#10;  for (let i = 0; i &lt; sequence.length; i++) {&#10;    if (Math.random() &lt; maskRatio) {&#10;      maskedPositions.push(i);&#10;      originalItems.push(sequence[i]);&#10;      maskedSequence[i] = maskToken;&#10;    }&#10;  }&#10;&#10;  return { maskedSequence, maskedPositions, originalItems };&#10;}&#10;&#10;function bert4recLoss(predictions: Float32Array[], maskedPositions: number[], originalItemIds: number[]): number {&#10;  let loss = 0;&#10;  for (let i = 0; i &lt; maskedPositions.length; i++) {&#10;    const pos = maskedPositions[i];&#10;    const logits = predictions[pos];&#10;    loss += crossEntropyLoss(logits, originalItemIds[i]);&#10;  }&#10;  return loss / maskedPositions.length;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BERT4RecConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  maxSeqLength</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span>