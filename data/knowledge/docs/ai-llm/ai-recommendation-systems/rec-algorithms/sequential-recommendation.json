;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maskRatio) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      maskedPositions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      originalItems.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sequence[i]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      maskedSequence[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maskToken;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { maskedSequence, maskedPositions, originalItems };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bert4recLoss</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">predictions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">maskedPositions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">originalItemIds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maskedPositions.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> pos</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maskedPositions[i];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> logits</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> predictions[pos];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> crossEntropyLoss</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(logits, originalItemIds[i]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maskedPositions.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>BERT4Rec 在推理时将目标位置设为 [MASK]，利用双向上下文预测该位置的物品。实验表明双向建模在某些场景下优于单向模型，但在线推理时需要额外处理（不能像 SASRec 那样直接用最后一个位置的输出）。</p>\n<h2 id=\"会话推荐与图序列\">会话推荐与图序列</h2><p>会话推荐（Session-based Recommendation）针对匿名短期会话场景，用户可能没有长期历史记录，只有当前 session 内的行为序列。SR-GNN 将 session 内的物品序列构建为图结构，用图神经网络捕获物品之间的复杂转移关系。</p>\n<table>\n<thead>\n<tr>\n<th>方法</th>\n<th>建模方式</th>\n<th>长期依赖</th>\n<th>冷启动</th>\n<th>计算效率</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>GRU4Rec</td>\n<td>循环神经网络</td>\n<td>中</td>\n<td>差</td>\n<td>快</td>\n</tr>\n<tr>\n<td>NARM</td>\n<td>注意力+GRU</td>\n<td>较好</td>\n<td>差</td>\n<td>中</td>\n</tr>\n<tr>\n<td>SR-GNN</td>\n<td>图神经网络</td>\n<td>好</td>\n<td>中</td>\n<td>慢</td>\n</tr>\n<tr>\n<td>FGNN</td>\n<td>图+注意力</td>\n<td>好</td>\n<td>中</td>\n<td>慢</td>\n</tr>\n<tr>\n<td>SASRec</td>\n<td>自注意力</td>\n<td>好</td>\n<td>差</td>\n<td>快</td>\n</tr>\n</tbody></table>\n<p>会话推荐的核心挑战是在极短的行为序列（通常只有几个到十几个物品）中准确捕获用户的短期意图。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>序列推荐将用户行为建模为时序信号，捕获兴趣的演变模式和物品间的顺序依赖</li>\n<li>SASRec 通过因果自注意力实现高效的单向序列建模，是工业界最广泛使用的基线</li>\n<li>BERT4Rec 的双向掩码预训练在某些场景下优于单向模型，但推理时需额外处理</li>\n<li>会话推荐（SR-GNN）用图结构建模 session 内物品的复杂转移关系，适合匿名短期场景</li>\n<li>序列推荐与传统 CF、深度模型的融合（如 DIN + SASRec）是工业实践的趋势</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>同 hub：<a href=\"../deep-rec-models/sequence-rec-models\">序列推荐模型</a> —— 本篇 SASRec/BERT4Rec 部分的深入篇，含轻量级模型与 KV Cache 部署。</li>\n<li>同 hub：<a href=\"../deep-rec-models/graph-neural-rec\">图神经网络推荐</a> —— 本篇 SR-GNN 一节背后图建模方法的系统展开。</li>\n</ul>\n","headings":[{"level":1,"text":"序列推荐","id":"序列推荐"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基于自注意力的序列推荐","id":"基于自注意力的序列推荐"},{"level":2,"text":"BERT4Rec 与双向建模","id":"bert4rec-与双向建模"},{"level":2,"text":"会话推荐与图序列","id":"会话推荐与图序列"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"深度推荐模型","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-algorithms/deep-rec-models"},"next":{"title":"召回策略","url":"/l-doc-books/h/ai-llm/ai-recommendation-systems/rec-system-engineering/recall-strategies"}}