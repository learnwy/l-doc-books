<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(([</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">score</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({ item, score: score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (simSums.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1e-8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) }))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.score </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.score)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, topK);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>ItemCF 计算物品之间的相似度，然后根据用户历史喜欢的物品推荐相似物品。相比 UserCF，ItemCF 的物品相似度矩阵更加稳定（因为物品属性变化慢于用户兴趣变化），更适合工业场景。Amazon 的 &quot;购买了此商品的用户还购买了&quot; 就是 ItemCF 的经典应用。</p>\n<h2 id=\"矩阵分解\">矩阵分解</h2><p>矩阵分解（Matrix Factorization, MF）将用户-物品交互矩阵分解为两个低秩矩阵的乘积，每个用户和物品都用一个 k 维的隐因子向量表示。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MFModel {&#10;  userFactors: Map&lt;string, Float32Array&gt;;&#10;  itemFactors: Map&lt;string, Float32Array&gt;;&#10;  userBias: Map&lt;string, number&gt;;&#10;  itemBias: Map&lt;string, number&gt;;&#10;  globalBias: number;&#10;  latentDim: number;&#10;}&#10;&#10;function mfPredict(model: MFModel, userId: string, itemId: string): number {&#10;  const userFactor = model.userFactors.get(userId);&#10;  const itemFactor = model.itemFactors.get(itemId);&#10;  if (!userFactor || !itemFactor) return model.globalBias;&#10;&#10;  let dot = 0;&#10;  for (let k = 0; k &lt; model.latentDim; k++) {&#10;    dot += userFactor[k] * itemFactor[k];&#10;  }&#10;&#10;  return model.globalBias + (model.userBias.get(userId) ?? 0) + (model.itemBias.get(itemId) ?? 0) + dot;&#10;}&#10;&#10;function sgdUpdate(&#10;  model: MFModel,&#10;  userId: string,&#10;  itemId: string,&#10;  rating: number,&#10;  learningRate: number,&#10;  regularization: number,&#10;): void {&#10;  const predicted = mfPredict(model, userId, itemId);&#10;  const error = rating - predicted;&#10;&#10;  const userFactor = model.userFactors.get(userId)!;&#10;  const itemFactor = model.itemFactors.get(itemId)!;&#10;&#10;  for (let k = 0; k &lt; model.latentDim; k++) {&#10;    const uGrad = error * itemFactor[k] - regularization * userFactor[k];&#10;    const iGrad = error * userFactor[k] - regularization * itemFactor[k];&#10;    userFactor[k] += learningRate * uGrad;&#10;    itemFactor[k] += learningRate * iGrad;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MFModel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  userFactors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  itemFactors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  userBias</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--sh