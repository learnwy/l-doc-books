>userInputTokens</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TokenBudget</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> systemPrompt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, totalWindow </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.015</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> outputReserve</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, totalWindow </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.06</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> safetyBuffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalWindow </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> userInput</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userInputTokens;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> available</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalWindow </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> systemPrompt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> outputReserve </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> safetyBuffer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userInput;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> retrievalContext</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">floor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(available </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.65</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> conversationHistory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> available </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> retrievalContext;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    systemPrompt,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    retrievalContext,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    conversationHistory,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    userInput,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outputReserve,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    safetyBuffer,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"上下文质量优化\">上下文质量优化</h2><p>注入的上下文质量直接决定模型输出质量。低质量上下文（噪声多、相关性低、信息过时）会导致模型输出幻觉或不准确的内容。</p>\n<table>\n<thead>\n<tr>\n<th>优化策略</th>\n<th>方法</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>相关性排序</td>\n<td>按语义相似度降序排列</td>\n<td>最相关的信息优先被模型关注</td>\n</tr>\n<tr>\n<td>去重与去噪</td>\n<td>删除重复和无关片段</td>\n<td>减少 Token 浪费</td>\n</tr>\n<tr>\n<td>新鲜度加权</td>\n<td>近期文档得分加权</td>\n<td>信息时效性更好</td>\n</tr>\n<tr>\n<td>多样性约束</td>\n<td>确保覆盖多个子话题</td>\n<td>避免单一视角偏见</td>\n</tr>\n<tr>\n<td>格式标准化</td>\n<td>统一文档格式和标记</td>\n<td>减少模型解析负担</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"# 上下文注入格式规范&#10;&#10;每个注入的文档片段使用以下格式：&#10;&#10;---&#10;[文档 {序号}]&#10;来源：{来源名称}&#10;更新时间：{日期}&#10;相关度：{高/中}&#10;&#10;{文档内容}&#10;---&#10;&#10;注意事项：&#10;- 文档内容已根据相关性排序，优先参考前面的文档&#10;- 标注&quot;相关度：中&quot;的文档可能仅部分相关&#10;- 如果文档之间信息矛盾，以更新时间较新的为准\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span># 上下文注入格式规范</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>每个注入的文档片段使用以下格式：</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>---</span></span>\n<span class=\"line\"><span>[文档 {序号}]</span></span>\n<span class=\"line\"><span>来源：{来源名称}</span></span>\n<span class=\"line\"><span>更新时间：{日期}</span></span>\n<span class=\"line\"><span>相关度：{高/中}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>{文档内容}</span></span>\n<span class=\"line\"><span>---</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>注意事项：</span></span>\n<span class=\"line\"><span>- 文档内容已根据相关性排序，优先参考前面的文档</span></span>\n<span class=\"line\"><span>- 标注\"相关度：中\"的文档可能仅部分相关</span></span>\n<span class=\"line\"><span>- 如果文档之间信息矛盾，以更新时间较新的为准</span></span></code></pre></div><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((动态上下文注入))&#10;    检索上下文&#10;      语义检索&#10;      分数过滤&#10;      去重处理&#10;    对话历史&#10;      滑动窗口&#10;      摘要压缩&#10;      选择性保留&#10;    Token 预算&#10;      窗口分配&#10;      动态调整&#10;      安全缓冲&#10;    质量优化&#10;      相关性排序&#10;      新鲜度加权&#10;      多样性约束&#10;    工程实践&#10;      格式标准化&#10;      来源标注&#10;      矛盾处理\">mindmap\n  root((动态上下文注入))\n    检索上下文\n      语义检索\n      分数过滤\n      去重处理\n    对话历史\n      滑动窗口\n      摘要压缩\n      选择性保留\n    Token 预算\n      窗口分配\n      动态调整\n      安全缓冲\n    质量优化\n      相关性排序\n      新鲜度加权\n      多样性约束\n    工程实践\n      格式标准化\n      来源标注\n      矛盾处理</pre><ul>\n<li>动态上下文注入是 RAG 和 Agent 系统的核心基础设施</li>\n<li>检索上下文通过语义检索获取最相关的外部知识，需要分数过滤和去重</li>\n<li>对话历史管理需要在信息保留和 Token 消耗之间平衡</li>\n<li>Token 预算分配是有限上下文窗口下的关键工程决策</li>\n<li>上下文质量优化（排序、去噪、多样性）直接影响最终输出质量</li>\n<li>统一的注入格式和来源标注帮助模型更好地利用上下文信息</li>\n</ul>\n","headings":[{"level":1,"text":"动态上下文注入","id":"动态上下文注入"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"检索上下文注入","id":"检索上下文注入"},{"level":2,"text":"对话历史管理","id":"对话历史管理"},{"level":2,"text":"Token 预算分配","id":"token-预算分配"},{"level":2,"text":"上下文质量优化","id":"上下文质量优化"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"约束与护栏","url":"/l-doc-books/h/ai-llm/prompt-engineering/system-prompt-design/constraint-and-guardrails"},"next":{"title":"任务分解与规划","url":"/l-doc-books/h/ai-llm/prompt-engineering/advanced-patterns/decomposition-and-planning"}}