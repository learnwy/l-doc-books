ZONE2 --&gt; ZONE3 --&gt; ZONE4 --&gt; ZONE5</pre><table>\n<thead>\n<tr>\n<th>区间</th>\n<th>状态</th>\n<th>触发动作</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>0-65%</td>\n<td>安全</td>\n<td>仅 snip + micro（常规）</td>\n</tr>\n<tr>\n<td>65-70%</td>\n<td>预警</td>\n<td>snip + micro（更积极）</td>\n</tr>\n<tr>\n<td>70-90%</td>\n<td>Collapse 区</td>\n<td>激活 context collapse</td>\n</tr>\n<tr>\n<td>90-100%</td>\n<td>Compact 区</td>\n<td>触发 auto compact</td>\n</tr>\n<tr>\n<td>100%+</td>\n<td>溢出</td>\n<td>reactive compact（紧急）</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"压缩效果量化\">压缩效果量化</h2><p>以一个典型的 100 轮对话为例，展示各层压缩的累积效果：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 模拟数据：100 轮对话的压缩效果&#10;interface CompressionMetrics {&#10;  originalTokens: number;&#10;  afterSnip: number;&#10;  afterMicro: number;&#10;  afterCollapse: number;&#10;  afterAutoCompact: number;&#10;}&#10;&#10;const example: CompressionMetrics = {&#10;  originalTokens: 250_000,&#10;  afterSnip: 175_000, // -30%&#10;  afterMicro: 150_000, // -15% (在 snip 基础上)&#10;  afterCollapse: 100_000, // -33% (在 micro 基础上)&#10;  afterAutoCompact: 50_000, // -50% (在 collapse 基础上)&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 模拟数据：100 轮对话的压缩效果</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CompressionMetrics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  originalTokens</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  afterSnip</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  afterMicro</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  afterCollapse</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  afterAutoCompact</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> example</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CompressionMetrics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  originalTokens: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">250_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  afterSnip: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">175_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -30%</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  afterMicro: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">150_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -15% (在 snip 基础上)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  afterCollapse: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -33% (在 micro 基础上)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  afterAutoCompact: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -50% (在 collapse 基础上)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>Token 数</th>\n<th>压缩比</th>\n<th>累积压缩</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>原始对话</td>\n<td>250,000</td>\n<td>—</td>\n<td>—</td>\n</tr>\n<tr>\n<td>Snip 后</td>\n<td>175,000</td>\n<td>-30%</td>\n<td>-30%</td>\n</tr>\n<tr>\n<td>Micro 后</td>\n<td>150,000</td>\n<td>-14%</td>\n<td>-40%</td>\n</tr>\n<tr>\n<td>Collapse 后</td>\n<td>100,000</td>\n<td>-33%</td>\n<td>-60%</td>\n</tr>\n<tr>\n<td>Auto Compact 后</td>\n<td>50,000</td>\n<td>-50%</td>\n<td>-80%</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    ORIG[&quot;原始: 250k tokens&quot;] --&gt; SNIP[&quot;Snip: 175k (-30%)&quot;]&#10;    SNIP --&gt; MICRO[&quot;Micro: 150k (-40% 累积)&quot;]&#10;    MICRO --&gt; COLLAPSE[&quot;Collapse: 100k (-60% 累积)&quot;]&#10;    COLLAPSE --&gt; AUTO[&quot;Auto Compact: 50k (-80% 累积)&quot;]\">graph TD\n    ORIG[\"原始: 250k tokens\"] --&gt; SNIP[\"Snip: 175k (-30%)\"]\n    SNIP --&gt; MICRO[\"Micro: 150k (-40% 累积)\"]\n    MICRO --&gt; COLLAPSE[\"Collapse: 100k (-60% 累积)\"]\n    COLLAPSE --&gt; AUTO[\"Auto Compact: 50k (-80% 累积)\"]</pre><hr>\n<h2 id=\"压缩策略选择\">压缩策略选择</h2><p>不同场景下的最优压缩策略不同：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐策略</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>短对话（&lt;50k）</td>\n<td>snip + micro</td>\n<td>足够且零成本</td>\n</tr>\n<tr>\n<td>中等对话（50-150k）</td>\n<td>+ collapse</td>\n<td>不需要 API 调用</td>\n</tr>\n<tr>\n<td>长对话（&gt;150k）</td>\n<td>+ auto compact</td>\n<td>需要 LLM 深度摘要</td>\n</tr>\n<tr>\n<td>413 错误恢复</td>\n<td>reactive compact</td>\n<td>紧急释放空间</td>\n</tr>\n<tr>\n<td>CI/CD 模式</td>\n<td>积极 auto compact</td>\n<td>单次对话，无需保留完整历史</td>\n</tr>\n<tr>\n<td>交互模式</td>\n<td>保守策略</td>\n<td>用户可能需要回溯</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> <code>/compact</code> 斜杠命令允许用户手动触发压缩。在长时间会话中，如果你注意到模型的回答质量下降（因为上下文太长导致注意力稀释），可以主动执行 <code>/compact</code> 来重置上下文。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((上下文窗口策略))&#10;    四层架构&#10;      Snip 每轮自动&#10;      Micro 每轮自动&#10;      Collapse 70% 触发&#10;      Auto Compact 90% 触发&#10;    设计哲学&#10;      能不调 API 就不调&#10;      渐进式压缩&#10;      力度递增&#10;    Token 估算&#10;      字符/3.5 快速估算&#10;      ±15% 精度&#10;      足够用于阈值判断&#10;    窗口分区&#10;      安全区 0-65%&#10;      预警区 65-70%&#10;      Collapse 区 70-90%&#10;      Compact 区 90-100%&#10;      溢出区 100%+&#10;    效果量化&#10;      100 轮对话&#10;      累积压缩 80%&#10;      250k → 50k tokens\">mindmap\n  root((上下文窗口策略))\n    四层架构\n      Snip 每轮自动\n      Micro 每轮自动\n      Collapse 70% 触发\n      Auto Compact 90% 触发\n    设计哲学\n      能不调 API 就不调\n      渐进式压缩\n      力度递增\n    Token 估算\n      字符/3.5 快速估算\n      ±15% 精度\n      足够用于阈值判断\n    窗口分区\n      安全区 0-65%\n      预警区 65-70%\n      Collapse 区 70-90%\n      Compact 区 90-100%\n      溢出区 100%+\n    效果量化\n      100 轮对话\n      累积压缩 80%\n      250k → 50k tokens</pre><ul>\n<li>Claude Code 采用<strong>四层渐进式压缩</strong>架构：snip → microcompact → context collapse → auto compact，力度依次递增。</li>\n<li>前三层是<strong>纯本地操作</strong>（无 API 调用），只有第四层 auto compact 需要调用 LLM。</li>\n<li>Token 估算使用<strong>字符/3.5</strong> 快速算法，精度 ±15%，对阈值判断足够。</li>\n<li>上下文窗口分为<strong>五个区间</strong>，每个区间触发不同级别的压缩策略。</li>\n<li>在典型的 100 轮对话中，四层压缩<strong>累积可压缩 80%</strong>（250k → 50k tokens）。</li>\n<li>设计哲学：<strong>能不调 API 就不调</strong>，最大化利用本地快速压缩。</li>\n</ul>\n","headings":[{"level":1,"text":"上下文窗口策略","id":"上下文窗口策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"四层压缩架构","id":"四层压缩架构"},{"level":2,"text":"触发条件与时机","id":"触发条件与时机"},{"level":2,"text":"Token 估算","id":"token-估算"},{"level":2,"text":"上下文窗口配置","id":"上下文窗口配置"},{"level":2,"text":"压缩效果量化","id":"压缩效果量化"},{"level":2,"text":"压缩策略选择","id":"压缩策略选择"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"提示词缓存","url":"/l-doc-books/h/ai-llm/claude-code-architecture/prompt-engineering/prompt-caching"},"next":{"title":"Snip 与 Microcompact","url":"/l-doc-books/h/ai-llm/claude-code-architecture/context-and-compaction/snip-and-microcompact"}}