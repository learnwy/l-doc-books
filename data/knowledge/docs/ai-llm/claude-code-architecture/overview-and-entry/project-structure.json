tyle=\"color:#6A737D;--shiki-dark:#6A737D\">// （空）</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>机制</th>\n<th>触发时机</th>\n<th>粒度</th>\n<th>典型用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>feature()</code> 宏</td>\n<td>构建时</td>\n<td>代码块级</td>\n<td>实验性功能开关</td>\n</tr>\n<tr>\n<td><code>define</code> 替换</td>\n<td>Bun build</td>\n<td>表达式级</td>\n<td>环境常量注入</td>\n</tr>\n<tr>\n<td>tree-shaking</td>\n<td>构建时</td>\n<td>模块/函数级</td>\n<td>未使用代码消除</td>\n</tr>\n<tr>\n<td>GrowthBook</td>\n<td>运行时</td>\n<td>请求级</td>\n<td>A/B 测试、灰度发布</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[&quot;feature(&#39;X&#39;)&quot;] --&gt; B{Bun define}&#10;    B --&gt;|true| C[保留代码块]&#10;    B --&gt;|false| D[替换为 false]&#10;    D --&gt; E[tree-shaking]&#10;    E --&gt; F[代码块被消除]&#10;    C --&gt; G[进入产物]\">graph LR\n    A[\"feature('X')\"] --&gt; B{Bun define}\n    B --&gt;|true| C[保留代码块]\n    B --&gt;|false| D[替换为 false]\n    D --&gt; E[tree-shaking]\n    E --&gt; F[代码块被消除]\n    C --&gt; G[进入产物]</pre><blockquote>\n<p><strong>提示：</strong> <code>feature()</code> 宏只在构建时生效，不会出现在运行时代码中。如果你在源码中搜索 <code>feature(</code> 调用，可以追踪所有实验性功能的入口。</p>\n</blockquote>\n<hr>\n<h2 id=\"关键依赖\">关键依赖</h2><p>Claude Code 的依赖选型反映了其&quot;终端原生 AI Agent&quot;的定位。以下是最核心的依赖库：</p>\n<h3 id=\"cli-框架-commander-js\">CLI 框架：Commander.js</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// src/main.tsx — CLI 定义（简化）&#10;import { Command } from &#39;commander&#39;;&#10;import type { OptionValues } from &#39;@commander-js/extra-typings&#39;;&#10;&#10;const program = new Command()&#10;  .name(&#39;claude&#39;)&#10;  .version(VERSION)&#10;  .argument(&#39;[prompt...]&#39;, &#39;初始提示词&#39;)&#10;  .option(&#39;-p, --print&#39;, &#39;非交互模式，输出后退出&#39;)&#10;  .option(&#39;--model &lt;model&gt;&#39;, &#39;指定模型&#39;)&#10;  .option(&#39;--max-turns &lt;n&gt;&#39;, &#39;最大对话轮次&#39;, parseInt)&#10;  .option(&#39;--allowedTools &lt;tools...&gt;&#39;, 