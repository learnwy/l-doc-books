pic SDK</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// src/services/claude.ts — API 客户端工厂（简化）&#10;import Anthropic from &#39;@anthropic-ai/sdk&#39;;&#10;import { AnthropicBedrock } from &#39;@anthropic-ai/bedrock-sdk&#39;;&#10;import { AnthropicVertex } from &#39;@anthropic-ai/vertex-sdk&#39;;&#10;&#10;type ClientProvider = &#39;direct&#39; | &#39;bedrock&#39; | &#39;vertex&#39; | &#39;foundry&#39;;&#10;&#10;function createClient(provider: ClientProvider): Anthropic {&#10;  switch (provider) {&#10;    case &#39;direct&#39;:&#10;      return new Anthropic({ apiKey: getApiKey() });&#10;    case &#39;bedrock&#39;:&#10;      return new AnthropicBedrock({ region: getAwsRegion() });&#10;    case &#39;vertex&#39;:&#10;      return new AnthropicVertex({ projectId: getGcpProject() });&#10;    case &#39;foundry&#39;:&#10;      return createFoundryClient();&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// src/services/claude.ts — API 客户端工厂（简化）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Anthropic </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@anthropic-ai/sdk'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { AnthropicBedrock } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@anthropic-ai/bedrock-sdk'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--