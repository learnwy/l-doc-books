#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'direct'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Anthropic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ apiKey: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getApiKey</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'bedrock'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AnthropicBedrock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ region: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getAwsRegion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vertex'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AnthropicVertex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ projectId: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getGcpProject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'foundry'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createFoundryClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>核心依赖全景：</p>\n<table>\n<thead>\n<tr>\n<th>依赖</th>\n<th>用途</th>\n<th>版本特征</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>commander</code> + <code>@commander-js/extra-typings</code></td>\n<td>CLI 参数解析与命令注册</td>\n<td>类型安全的命令定义</td>\n</tr>\n<tr>\n<td><code>ink</code> + <code>react</code></td>\n<td>终端 UI 渲染框架</td>\n<td>React 18 + Ink 5</td>\n</tr>\n<tr>\n<td><code>yoga-layout</code></td>\n<td>Flexbox 布局引擎</td>\n<td>Facebook 的跨平台布局</td>\n</tr>\n<tr>\n<td><code>@anthropic-ai/sdk</code></td>\n<td>Anthropic API 客户端</td>\n<td>流式 + 批量模式</td>\n</tr>\n<tr>\n<td><code>@anthropic-ai/bedrock-sdk</code></td>\n<td>AWS Bedrock 适配</td>\n<td>跨云支持</td>\n</tr>\n<tr>\n<td><code>@modelcontextprotocol/sdk</code></td>\n<td>MCP 协议客户端</td>\n<td>标准 MCP 实现</td>\n</tr>\n<tr>\n<td><code>chalk</code></td>\n<td>终端着色</td>\n<td>输出格式化</td>\n</tr>\n<tr>\n<td><code>zod</code></td>\n<td>运行时类型校验</td>\n<td>配置验证</td>\n</tr>\n<tr>\n<td><code>growthbook</code></td>\n<td>运行时 Feature Flag</td>\n<td>A/B 测试</td>\n</tr>\n<tr>\n<td><code>@opentelemetry/*</code></td>\n<td>可观测性</td>\n<td>遥测数据采集</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph 用户交互层&#10;        CLI[Commander.js CLI]&#10;        UI[React + Ink UI]&#10;        YOGA[Yoga Layout]&#10;    end&#10;    subgraph 核心引擎&#10;        QE[QueryEngine]&#10;        QL[queryLoop]&#10;        STREAM[Streaming]&#10;    end&#10;    subgraph API 层&#10;        SDK[Anthropic SDK]&#10;        BEDROCK[Bedrock SDK]&#10;        VERTEX[Vertex SDK]&#10;        MCP[MCP SDK]&#10;    end&#10;    subgraph 基础设施&#10;        ZOD[Zod 校验]&#10;        CHALK[Chalk 着色]&#10;        OTEL[OpenTelemetry]&#10;        GB[GrowthBook]&#10;    end&#10;    CLI --&gt; QE&#10;    UI --&gt; QE&#10;    UI --&gt; YOGA&#10;    QE --&gt; QL&#10;    QL --&gt; STREAM&#10;    STREAM --&gt; SDK&#10;    STREAM --&gt; BEDROCK&#10;    STREAM --&gt; VERTEX&#10;    QE --&gt; MCP&#10;    QE --&gt; ZOD&#10;    UI --&gt; CHALK&#10;    QL --&gt; OTEL&#10;    QE --&gt; GB\">graph TB\n    subgraph 用户交互层\n        CLI[Commander.js CLI]\n        UI[React + Ink UI]\n        YOGA[Yoga Layout]\n    end\n    subgraph 核心引擎\n        QE[QueryEngine]\n        QL[queryLoop]\n        STREAM[Streaming]\n    end\n    subgraph API 层\n        SDK[Anthropic SDK]\n        BEDROCK[Bedrock SDK]\n        VERTEX[Vertex SDK]\n        MCP[MCP SDK]\n    end\n    subgraph 基础设施\n        ZOD[Zod 校验]\n        CHALK[Chalk 着色]\n        OTEL[OpenTelemetry]\n        GB[GrowthBook]\n    end\n    CLI --&gt; QE\n    UI --&gt; QE\n    UI --&gt; YOGA\n    QE --&gt; QL\n    QL --&gt; STREAM\n    STREAM --&gt; SDK\n    STREAM --&gt; BEDROCK\n    STREAM --&gt; VERTEX\n    QE --&gt; MCP\n    QE --&gt; ZOD\n    UI --&gt; CHALK\n    QL --&gt; OTEL\n    QE --&gt; GB</pre><hr>\n<h2 id=\"构建产物与分发\">构建产物与分发</h2><p>Claude Code 的构建产物是单个 JavaScript bundle 文件，通过 npm 分发。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// package.json（关键字段简化）&#10;{&#10;  &quot;name&quot;: &quot;@anthropic-ai/claude-code&quot;,&#10;  &quot;bin&quot;: { &quot;claude&quot;: &quot;./dist/cli.js&quot; },&#10;  &quot;files&quot;: [&quot;dist/&quot;],&#10;  &quot;engines&quot;: { &quot;node&quot;: &quot;&gt;=18.0.0&quot; },&#10;  &quot;scripts&quot;: {&#10;    &quot;build&quot;: &quot;bun run build.ts&quot;,&#10;    &quot;typecheck&quot;: &quot;tsc --noEmit&quot;,&#10;    &quot;lint&quot;: &quot;eslint src/&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// package.json（关键字段简化）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"@anthropic-ai/claude-code\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"bin\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"claude\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist/cli.js\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"files\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"dist/\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"engines\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"node\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\">=18.0.0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"scripts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"build\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"bun run build.ts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"typecheck\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tsc --noEmit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"lint\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"eslint src/\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>产物</th>\n<th>说明</th>\n<th>大小</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>dist/cli.js</code></td>\n<td>主入口 bundle</td>\n<td>~2MB（minified）</td>\n</tr>\n<tr>\n<td><code>dist/cli.js.map</code></td>\n<td>Source map</td>\n<td>~5MB</td>\n</tr>\n<tr>\n<td><code>dist/skills/</code></td>\n<td>捆绑技能文件</td>\n<td>~100KB</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 由于使用了 <code>feature()</code> 宏的死代码消除，不同构建配置产出的 bundle 大小可能差异显著。禁用的 feature 相关代码会被完全移除。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((项目结构))&#10;    Monorepo 布局&#10;      src/ 30+ 子目录&#10;      tools/ 工具实现&#10;      query/ 对话引擎&#10;      ink/ 终端 UI&#10;      services/ API 服务&#10;    构建系统&#10;      Bun 构建工具&#10;      feature 宏&#10;      死代码消除&#10;      tree-shaking&#10;    关键依赖&#10;      Commander.js CLI&#10;      React + Ink UI&#10;      Anthropic SDK&#10;      MCP SDK&#10;      OpenTelemetry&#10;    构建产物&#10;      单 bundle 分发&#10;      npm 包发布&#10;      Source map 支持\">mindmap\n  root((项目结构))\n    Monorepo 布局\n      src/ 30+ 子目录\n      tools/ 工具实现\n      query/ 对话引擎\n      ink/ 终端 UI\n      services/ API 服务\n    构建系统\n      Bun 构建工具\n      feature 宏\n      死代码消除\n      tree-shaking\n    关键依赖\n      Commander.js CLI\n      React + Ink UI\n      Anthropic SDK\n      MCP SDK\n      OpenTelemetry\n    构建产物\n      单 bundle 分发\n      npm 包发布\n      Source map 支持</pre><ul>\n<li>Claude Code 采用 <strong>Monorepo</strong> 结构，<code>src/</code> 下 30+ 子目录按功能域划分，<code>main.tsx</code> 是 4684 行的超大入口文件。</li>\n<li>构建系统基于 <strong>Bun</strong>，通过自定义 <code>feature()</code> 宏实现构建时条件编译，配合 tree-shaking 实现死代码消除。</li>\n<li><strong>Commander.js</strong> 提供类型安全的 CLI 框架，<strong>React + Ink</strong> 实现终端 UI，<strong>Anthropic SDK</strong> 支持四种 API 提供商。</li>\n<li>最终构建产物为<strong>单 bundle 文件</strong>，通过 npm 分发，支持 Node.js 18+ 运行时。</li>\n</ul>\n","headings":[{"level":1,"text":"项目结构","id":"项目结构"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Monorepo 目录布局","id":"monorepo-目录布局"},{"level":2,"text":"构建系统","id":"构建系统"},{"level":3,"text":"feature() 宏与死代码消除","id":"feature-宏与死代码消除"},{"level":2,"text":"关键依赖","id":"关键依赖"},{"level":3,"text":"CLI 框架：Commander.js","id":"cli-框架-commander-js"},{"level":3,"text":"终端 UI：React + Ink + Yoga","id":"终端-ui-react-ink-yoga"},{"level":3,"text":"API 客户端：Anthropic SDK","id":"api-客户端-anthropic-sdk"},{"level":2,"text":"构建产物与分发","id":"构建产物与分发"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"入口与初始化","url":"/l-doc-books/h/ai-llm/claude-code-architecture/overview-and-entry/entry-and-initialization"}}