emories.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sections.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'&#x3C;team-memories></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> formatMemoryList</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(teamMemories) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;/team-memories>'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sections.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    BUILD[buildCombinedMemoryPrompt] --&gt; TYPES[注入 scope 说明]&#10;    BUILD --&gt; PRIV[扫描 memory/]&#10;    BUILD --&gt; TEAM[扫描 memory/team/]&#10;&#10;    PRIV --&gt; PRIVTAG[&quot;&amp;lt;private-memories&amp;gt;&quot;]&#10;    TEAM --&gt; TEAMTAG[&quot;&amp;lt;team-memories&amp;gt;&quot;]&#10;&#10;    TYPES --&gt; MERGE[合并输出]&#10;    PRIVTAG --&gt; MERGE&#10;    TEAMTAG --&gt; MERGE\">flowchart TD\n    BUILD[buildCombinedMemoryPrompt] --&gt; TYPES[注入 scope 说明]\n    BUILD --&gt; PRIV[扫描 memory/]\n    BUILD --&gt; TEAM[扫描 memory/team/]\n\n    PRIV --&gt; PRIVTAG[\"&amp;lt;private-memories&amp;gt;\"]\n    TEAM --&gt; TEAMTAG[\"&amp;lt;team-memories&amp;gt;\"]\n\n    TYPES --&gt; MERGE[合并输出]\n    PRIVTAG --&gt; MERGE\n    TEAMTAG --&gt; MERGE</pre><table>\n<thead>\n<tr>\n<th>标签</th>\n<th>包含内容</th>\n<th>模型行为指导</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>&lt;scope type=&quot;private&quot;&gt;</code></td>\n<td>私有记忆说明</td>\n<td>存储个人偏好和修正</td>\n</tr>\n<tr>\n<td><code>&lt;scope type=&quot;team&quot;&gt;</code></td>\n<td>团队记忆说明</td>\n<td>存储约定、架构和共享上下文</td>\n</tr>\n<tr>\n<td><code>&lt;private-memories&gt;</code></td>\n<td>私有记忆列表</td>\n<td>仅影响当前用户</td>\n</tr>\n<tr>\n<td><code>&lt;team-memories&gt;</code></td>\n<td>团队记忆列表</td>\n<td>影响所有团队成员</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> <code>&lt;scope&gt;</code> 标签的设计使模型能够区分记忆来源，从而在写入时选择正确的目录——个人修正写入私有目录，团队约定写入团队目录。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((团队记忆))&#10;    双目录架构&#10;      memory/ 私有&#10;      memory/team/ 共享&#10;      Git 管理共享部分&#10;    安全防护&#10;      PathTraversalError&#10;      null 字节拒绝&#10;      绝对路径拒绝&#10;    符号链接解析&#10;      realpathDeepestExisting&#10;      逐级回退策略&#10;      尽力解析真实路径&#10;    两阶段验证&#10;      字符串快速拒绝&#10;      realpath 深度验证&#10;      纵深防御理念&#10;    Prompt 合并&#10;      scope 标签区分&#10;      private/team 分组&#10;      合并输出统一注入\">mindmap\n  root((团队记忆))\n    双目录架构\n      memory/ 私有\n      memory/team/ 共享\n      Git 管理共享部分\n    安全防护\n      PathTraversalError\n      null 字节拒绝\n      绝对路径拒绝\n    符号链接解析\n      realpathDeepestExisting\n      逐级回退策略\n      尽力解析真实路径\n    两阶段验证\n      字符串快速拒绝\n      realpath 深度验证\n      纵深防御理念\n    Prompt 合并\n      scope 标签区分\n      private/team 分组\n      合并输出统一注入</pre><ul>\n<li>团队记忆采用<strong>双目录架构</strong>：<code>memory/</code> 存私有记忆，<code>memory/team/</code> 存共享记忆，通过 Git 管理共享部分。</li>\n<li><code>PathTraversalError</code> 配合键名验证拦截 <code>..</code> 遍历、绝对路径注入和 <strong>null 字节截断</strong>三类攻击。</li>\n<li><code>realpathDeepestExisting()</code> 逐级解析符号链接，即使目标路径不完全存在也能发现中间目录的链接重定向。</li>\n<li><code>validateTeamMemWritePath()</code> 实现<strong>两阶段验证</strong>：字符串快速拒绝 + realpath 深度验证，兼顾性能与安全。</li>\n<li><code>buildCombinedMemoryPrompt()</code> 通过 <code>&lt;scope&gt;</code> 标签将私有和团队记忆合并注入，指导模型正确区分记忆来源。</li>\n</ul>\n","headings":[{"level":1,"text":"团队记忆","id":"团队记忆"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"双目录架构","id":"双目录架构"},{"level":2,"text":"PathTraversalError 安全防护","id":"pathtraversalerror-安全防护"},{"level":2,"text":"realpathDeepestExisting 符号链接解析","id":"realpathdeepestexisting-符号链接解析"},{"level":2,"text":"validateTeamMemWritePath 两阶段验证","id":"validateteammemwritepath-两阶段验证"},{"level":2,"text":"validateTeamMemKey 键名验证","id":"validateteammemkey-键名验证"},{"level":2,"text":"teamMemPrompts 与 scope 标签","id":"teammemprompts-与-scope-标签"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"AI 驱动的记忆召回","url":"/l-doc-books/h/ai-llm/claude-code-architecture/memory-system/ai-powered-recall"},"next":{"title":"对话历史","url":"/l-doc-books/h/ai-llm/claude-code-architecture/memory-system/conversation-history"}}