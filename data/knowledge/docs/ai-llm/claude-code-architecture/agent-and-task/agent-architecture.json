or:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  description: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'General-purpose coding assistant'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  systemPrompt: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'You are a helpful coding assistant...'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  allowedTools: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  model: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sonnet'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  autoBackground: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> EXPLORE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BuiltinAgentDefinition</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'explore'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  description: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Codebase exploration and understanding'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  systemPrompt: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Explore the codebase to answer questions...'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  allowedTools: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'FileRead'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Grep'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Glob'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Bash'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  model: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'haiku'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  autoBackground: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>内置 Agent</th>\n<th>模型</th>\n<th>工具集</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>GENERAL_PURPOSE</td>\n<td>Sonnet</td>\n<td>全部</td>\n<td>通用编码辅助</td>\n</tr>\n<tr>\n<td>STATUSLINE_SETUP</td>\n<td>Haiku</td>\n<td>Bash, FileRead</td>\n<td>状态栏配置</td>\n</tr>\n<tr>\n<td>EXPLORE</td>\n<td>Haiku</td>\n<td>只读工具</td>\n<td>代码库探索</td>\n</tr>\n<tr>\n<td>PLAN</td>\n<td>Sonnet</td>\n<td>只读工具</td>\n<td>任务规划</td>\n</tr>\n<tr>\n<td>CLAUDE_CODE_GUIDE</td>\n<td>Sonnet</td>\n<td>只读工具</td>\n<td>使用指导</td>\n</tr>\n<tr>\n<td>VERIFICATION</td>\n<td>Sonnet</td>\n<td>全部</td>\n<td>结果验证</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    AGENTS[&quot;内置 Agent&quot;] --&gt; GP[&quot;GENERAL_PURPOSE&lt;br/&gt;Sonnet / 全部工具&quot;]&#10;    AGENTS --&gt; EXP[&quot;EXPLORE&lt;br/&gt;Haiku / 只读&quot;]&#10;    AGENTS --&gt; PLAN[&quot;PLAN&lt;br/&gt;Sonnet / 只读&quot;]&#10;    AGENTS --&gt; VER[&quot;VERIFICATION&lt;br/&gt;Sonnet / 全部&quot;]&#10;    AGENTS --&gt; SL[&quot;STATUSLINE&lt;br/&gt;Haiku / 最小&quot;]&#10;    AGENTS --&gt; GUIDE[&quot;GUIDE&lt;br/&gt;Sonnet / 只读&quot;]\">graph LR\n    AGENTS[\"内置 Agent\"] --&gt; GP[\"GENERAL_PURPOSE&lt;br/&gt;Sonnet / 全部工具\"]\n    AGENTS --&gt; EXP[\"EXPLORE&lt;br/&gt;Haiku / 只读\"]\n    AGENTS --&gt; PLAN[\"PLAN&lt;br/&gt;Sonnet / 只读\"]\n    AGENTS --&gt; VER[\"VERIFICATION&lt;br/&gt;Sonnet / 全部\"]\n    AGENTS --&gt; SL[\"STATUSLINE&lt;br/&gt;Haiku / 最小\"]\n    AGENTS --&gt; GUIDE[\"GUIDE&lt;br/&gt;Sonnet / 只读\"]</pre><p>EXPLORE 和 PLAN 使用较低成本的 Haiku/Sonnet 模型且只赋予只读工具，体现了&quot;最小权限&quot;原则——探索和规划不需要修改文件的能力。</p>\n<blockquote>\n<p><strong>提示：</strong> 自定义 agent 可以通过 <code>agentDefinitions</code> 配置扩展，它们与内置 agent 使用相同的定义格式，并在运行时合并到可用 agent 列表中。</p>\n</blockquote>\n<hr>\n<h2 id=\"自动后台阈值\">自动后台阈值</h2><p>当子 agent 执行时间超过阈值（120 秒）时，系统会自动将其转为后台任务，避免阻塞父 agent 的对话流。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const AUTO_BACKGROUND_THRESHOLD_MS = 120 * 1000;&#10;&#10;async function executeSubagent(input: AgentToolInput, context: ToolUseContext): Promise&lt;ToolResult&lt;AgentOutput&gt;&gt; {&#10;  const startTime = Date.now();&#10;&#10;  const handle = createSubagent(input, context);&#10;&#10;  const result = await Promise.race([&#10;    handle.waitForCompletion(),&#10;    sleep(AUTO_BACKGROUND_THRESHOLD_MS).then(() =&gt; &#39;timeout&#39; as const),&#10;  ]);&#10;&#10;  if (result === &#39;timeout&#39; || input.run_in_background) {&#10;    handle.moveToBackground();&#10;    return successResult({&#10;      status: &#39;backgrounded&#39;,&#10;      taskId: handle.taskId,&#10;      message: `Agent moved to background after ${AUTO_BACKGROUND_THRESHOLD_MS / 1000}s`,&#10;    });&#10;  }&#10;&#10;  return successResult({ status: &#39;completed&#39;, output: result });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> AUTO_BACKGROUND_THRESHOLD_MS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 120</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> executeSubagent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">input</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AgentToolInput</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">context</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ToolUseContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ToolResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">AgentOutput</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> startTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> handle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createSubagent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(input, context);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">race</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    handle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">waitForCompletion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">AUTO_BACKGROUND_THRESHOLD_MS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'timeout'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'timeout'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> input.run_in_background) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    handle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">moveToBackground</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> successResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'backgrounded'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      taskId: handle.taskId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      message: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Agent moved to background after ${</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">AUTO_BACKGROUND_THRESHOLD_MS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}s`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> successResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'completed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, output: result });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    START[&quot;启动子 Agent&quot;] --&gt; RACE{&quot;竞赛: 完成 vs 120s&quot;}&#10;    RACE --&gt;|&quot;完成 &lt; 120s&quot;| DONE[&quot;返回结果&quot;]&#10;    RACE --&gt;|&quot;超时 ≥ 120s&quot;| BG[&quot;转为后台任务&quot;]&#10;    BG --&gt; TASKID[&quot;返回 taskId&quot;]&#10;&#10;    INPUT{&quot;run_in_background?&quot;}&#10;    INPUT --&gt;|true| BG_DIRECT[&quot;直接后台运行&quot;]&#10;    INPUT --&gt;|false| START\">flowchart TD\n    START[\"启动子 Agent\"] --&gt; RACE{\"竞赛: 完成 vs 120s\"}\n    RACE --&gt;|\"完成 &lt; 120s\"| DONE[\"返回结果\"]\n    RACE --&gt;|\"超时 ≥ 120s\"| BG[\"转为后台任务\"]\n    BG --&gt; TASKID[\"返回 taskId\"]\n\n    INPUT{\"run_in_background?\"}\n    INPUT --&gt;|true| BG_DIRECT[\"直接后台运行\"]\n    INPUT --&gt;|false| START</pre><table>\n<thead>\n<tr>\n<th>参数</th>\n<th>值</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>自动后台阈值</td>\n<td>120s</td>\n<td>超过此时间自动转后台</td>\n</tr>\n<tr>\n<td><code>run_in_background</code></td>\n<td>布尔</td>\n<td>显式请求后台运行</td>\n</tr>\n<tr>\n<td>后台返回值</td>\n<td>taskId</td>\n<td>用于后续查询任务状态</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"fork-子-agent-的缓存共享\">Fork 子 Agent 的缓存共享</h2><p>fork 模式最重要的优化是 prompt cache 共享。子 agent 继承父 agent 的对话历史作为 prompt 前缀，API 请求可以直接命中已有的缓存。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ForkContext {&#10;  conversationHistory: Message[];&#10;  promptCachePrefix: string;&#10;  systemPrompt: string;&#10;}&#10;&#10;function buildForkApiRequest(childPrompt: string, forkContext: ForkContext): ApiRequest {&#10;  return {&#10;    system: forkContext.systemPrompt,&#10;    messages: [...forkContext.conversationHistory, { role: &#39;user&#39;, content: childPrompt }],&#10;    cacheControl: {&#10;      prefixLength: forkContext.conversationHistory.length,&#10;    },&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ForkContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  conversationHistory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Message</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  promptCachePrefix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  systemPrompt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildForkApiRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">childPrompt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">forkContext</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ForkContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ApiRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    system: forkContext.systemPrompt,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    messages: [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">forkContext.conversationHistory, { role: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'user'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, content: childPrompt }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    cacheControl: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      prefixLength: forkContext.conversationHistory.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant Parent as 父 Agent&#10;    participant API as Anthropic API&#10;    participant Child as 子 Agent (fork)&#10;&#10;    Parent-&gt;&gt;API: 请求 (建立 cache)&#10;    API--&gt;&gt;Parent: 响应 (cache_creation)&#10;&#10;    Parent-&gt;&gt;Child: fork (继承 history)&#10;    Child-&gt;&gt;API: 请求 (共享 prefix)&#10;    Note over API: cache_read 命中!&#10;    API--&gt;&gt;Child: 响应 (cache_read)\">sequenceDiagram\n    participant Parent as 父 Agent\n    participant API as Anthropic API\n    participant Child as 子 Agent (fork)\n\n    Parent-&gt;&gt;API: 请求 (建立 cache)\n    API--&gt;&gt;Parent: 响应 (cache_creation)\n\n    Parent-&gt;&gt;Child: fork (继承 history)\n    Child-&gt;&gt;API: 请求 (共享 prefix)\n    Note over API: cache_read 命中!\n    API--&gt;&gt;Child: 响应 (cache_read)</pre><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>无缓存共享</th>\n<th>fork 缓存共享</th>\n<th>节省</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>父上下文 10K token</td>\n<td>子 agent 重建缓存</td>\n<td>子 agent 命中缓存</td>\n<td>10K creation</td>\n</tr>\n<tr>\n<td>连续 3 个子任务</td>\n<td>3x 重建</td>\n<td>3x 命中</td>\n<td>30K creation</td>\n</tr>\n<tr>\n<td>长对话后创建子任务</td>\n<td>高昂的重建成本</td>\n<td>零重建成本</td>\n<td>显著</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> prompt cache 共享是 fork 模式成为默认隔离模式的主要原因——在 API 成本结构中，cache_creation 的价格是 cache_read 的 4 倍。</p>\n</blockquote>\n<hr>\n<h2 id=\"快照之后的演进-claude-agent-sdk\">快照之后的演进：Claude Agent SDK</h2><p>本章剖析的 AgentTool / 子 agent 编排是 CLI 进程内的实现。快照之后（2025 年下半年），Anthropic 把驱动 Claude Code 的同一套 agent loop、工具集与会话管理抽取为可编程库——<strong>Claude Agent SDK</strong>（由早期的 Claude Code SDK 更名而来），目前提供 <strong>Python 与 TypeScript</strong> 两种官方绑定；其他语言可以通过子进程方式运行 CLI（<code>claude -p --output-format json</code>）复用同一条循环。</p>\n<p>对本章的阅读这意味着两件事：</p>\n<table>\n<thead>\n<tr>\n<th>视角</th>\n<th>本章快照内容</th>\n<th>Agent SDK 现状</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>agent loop</td>\n<td>QueryEngine 内部的查询循环</td>\n<td>同一循环作为库在用户进程中运行</td>\n</tr>\n<tr>\n<td>子 agent</td>\n<td>AgentTool fork/worktree 隔离</td>\n<td>SDK 原生 subagents 能力，定义方式与 <code>.claude/</code> 一致</td>\n</tr>\n<tr>\n<td>会话</td>\n<td>JSONL 本地会话文件</td>\n<td>SDK 支持会话持久化、resume 与 fork</td>\n</tr>\n<tr>\n<td>扩展点</td>\n<td>MCP、hooks、skills</td>\n<td>全部保留为 SDK 的编程接口</td>\n</tr>\n</tbody></table>\n<p>也就是说，正文解析的架构不再是&quot;闭源 CLI 的黑盒内部&quot;，而是一个有官方编程契约的产品边界——快照中的实现细节会漂移，但这些概念（loop、subagent、session、hook）已成为稳定术语。来源：<a href=\"https://code.claude.com/docs/en/agent-sdk\">Agent SDK overview</a>。</p>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((智能体架构))&#10;    AgentTool&#10;      5 种隔离模式&#10;      SubagentType 子类型&#10;      自定义 Agent 扩展&#10;    隔离模式&#10;      fork 继承上下文&#10;      worktree git 隔离&#10;      remote 远程环境&#10;      in-process 同进程&#10;      background 后台&#10;    内置 Agent&#10;      GENERAL_PURPOSE 通用&#10;      EXPLORE 只读探索&#10;      PLAN 任务规划&#10;      VERIFICATION 结果验证&#10;    自动后台&#10;      120s 阈值&#10;      run_in_background 选项&#10;      返回 taskId 异步查询&#10;    缓存共享&#10;      fork 继承 history&#10;      prompt cache 命中&#10;      cache_read 节省 4x 成本\">mindmap\n  root((智能体架构))\n    AgentTool\n      5 种隔离模式\n      SubagentType 子类型\n      自定义 Agent 扩展\n    隔离模式\n      fork 继承上下文\n      worktree git 隔离\n      remote 远程环境\n      in-process 同进程\n      background 后台\n    内置 Agent\n      GENERAL_PURPOSE 通用\n      EXPLORE 只读探索\n      PLAN 任务规划\n      VERIFICATION 结果验证\n    自动后台\n      120s 阈值\n      run_in_background 选项\n      返回 taskId 异步查询\n    缓存共享\n      fork 继承 history\n      prompt cache 命中\n      cache_read 节省 4x 成本</pre><ul>\n<li>AgentTool 支持 <strong>5 种隔离模式</strong>（fork/worktree/remote/in-process/background），fork 为默认且最常用。</li>\n<li>fork 模式继承父 agent 的对话上下文，实现 <strong>prompt cache 共享</strong>，cache_read 比 cache_creation 便宜 4 倍。</li>\n<li>6 个<strong>内置 Agent</strong> 遵循最小权限原则——探索和规划只赋予只读工具，通用和验证赋予全部工具。</li>\n<li>子 agent 执行超过 <strong>120 秒</strong>自动转为后台任务，通过 taskId 异步查询结果。</li>\n<li>自定义 agent 通过 <code>agentDefinitions</code> 配置扩展，与内置 agent 使用相同的定义格式。</li>\n</ul>\n","headings":[{"level":1,"text":"智能体架构","id":"智能体架构"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"AgentTool 核心设计","id":"agenttool-核心设计"},{"level":2,"text":"五种隔离模式详解","id":"五种隔离模式详解"},{"level":2,"text":"内置 Agent 定义","id":"内置-agent-定义"},{"level":2,"text":"自动后台阈值","id":"自动后台阈值"},{"level":2,"text":"Fork 子 Agent 的缓存共享","id":"fork-子-agent-的缓存共享"},{"level":2,"text":"快照之后的演进：Claude Agent SDK","id":"快照之后的演进-claude-agent-sdk"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"权限与安全","url":"/l-doc-books/h/ai-llm/claude-code-architecture/tool-system/permission-and-security"},"next":{"title":"任务生命周期","url":"/l-doc-books/h/ai-llm/claude-code-architecture/agent-and-task/task-lifecycle"}}