\n<td>高</td>\n<td>中</td>\n<td>伪影放大</td>\n</tr>\n<tr>\n<td>CodeFormer</td>\n<td>面部修复</td>\n<td>高</td>\n<td>中</td>\n<td>面部不自然</td>\n</tr>\n<tr>\n<td>自适应锐化</td>\n<td>细节增强</td>\n<td>中</td>\n<td>低</td>\n<td>噪声放大</td>\n</tr>\n<tr>\n<td>颜色校正</td>\n<td>色彩优化</td>\n<td>中</td>\n<td>低</td>\n<td>色偏</td>\n</tr>\n<tr>\n<td>JPEG 优化</td>\n<td>文件压缩</td>\n<td>无</td>\n<td>低</td>\n<td>质量损失</td>\n</tr>\n</tbody></table>\n<h2 id=\"质量控制与自动化评估\">质量控制与自动化评估</h2><p>自动化质量控制是生产管线不可或缺的环节。通过结合美学评分模型、CLIP Score 和 NSFW 检测器，可以自动筛选低质量或不当内容的生成结果。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;from transformers import CLIPProcessor, CLIPModel&#10;&#10;class QualityChecker:&#10;    def __init__(self, device=&quot;cuda&quot;):&#10;        self.clip_model = CLIPModel.from_pretrained(&quot;openai/clip-vit-base-patch32&quot;).to(device)&#10;        self.clip_processor = CLIPProcessor.from_pretrained(&quot;openai/clip-vit-base-patch32&quot;)&#10;        self.device = device&#10;&#10;    def clip_score(self, image, text):&#10;        inputs = self.clip_processor(text=[text], images=image, return_tensors=&quot;pt&quot;).to(self.device)&#10;        with torch.no_grad():&#10;            outputs = self.clip_model(**inputs)&#10;            score = outputs.logits_per_image.item() / 100.0&#10;        return score&#10;&#10;    def check_quality(self, image, prompt, thresholds=None):&#10;        if thresholds is None:&#10;            thresholds = {&quot;clip_score&quot;: 0.25, &quot;min_size&quot;: 512}&#10;        score = self.clip_score(image, prompt)&#10;        w, h = image.size&#10;        return {&#10;            &quot;clip_score&quot;: score,&#10;            &quot;clip_pass&quot;: score &gt;= thresholds[&quot;clip_score&quot;],&#10;            &quot;size_pass&quot;: min(w, h) &gt;= thresholds[&quot;min_size&quot;],&#10;            &quot;overall_pass&quot;: score &gt;= thresholds[&quot;clip_score&quot;] and min(w, h) &gt;= thresholds[&quot;min_size&quot;],&#10;        }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> transformers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CLIPProcessor, CLIPModel</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QualityChecker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, device</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"cuda\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.clip_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CLIPModel.from_pretrained(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"openai/clip-vit-base-patch32\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).to(device)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.clip_processor </span><span style=\"color:#D73A49;--shiki-dark:#F975