shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">device</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">x.device))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        z, delta_logp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> odeint(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.dynamics, state, torch.tensor([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        z, delta_logp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], delta_logp[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        log_pz </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (z </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).sum(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z.shape[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.log(torch.tensor(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3.14159</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> log_pz </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> delta_logp</span></span></code></pre></div><p>Flow Matching 是 CNF 训练的最新方法，它避免了 ODE 求解器在训练中的高计算成本。核心思想是直接训练速度场 v<em>θ(x, t) 去匹配一个条件最优传输路径的速度场。训练目标是简单的均方误差：L = E[||v</em>θ(xₜ, t) - u(xₜ|x₁)||²]，其中 u 是从噪声到数据的线性插值速度。Stable Diffusion 3 和 FLUX 的训练就是基于 Flow Matching 的 Rectified Flow 框架。</p>\n<table>\n<thead>\n<tr>\n<th>流方法</th>\n<th>变换类型</th>\n<th>似然计算</th>\n<th>表达能力</th>\n<th>训练成本</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>RealNVP</td>\n<td>仿射耦合</td>\n<td>精确（三角雅可比）</td>\n<td>中等</td>\n<td>低</td>\n</tr>\n<tr>\n<td>Glow</td>\n<td>1×1卷积+耦合</td>\n<td>精确</td>\n<td>高</td>\n<td>中</td>\n</tr>\n<tr>\n<td>Neural ODE</td>\n<td>连续 ODE</td>\n<td>Hutchinson 近似</td>\n<td>很高</td>\n<td>高</td>\n</tr>\n<tr>\n<td>Flow Matching</td>\n<td>条件速度场</td>\n<td>不直接计算</td>\n<td>极高</td>\n<td>中</td>\n</tr>\n<tr>\n<td>Rectified Flow</td>\n<td>线性插值路径</td>\n<td>不直接计算</td>\n<td>极高</td>\n<td>中</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((标准化流))&#10;    基础架构&#10;      仿射耦合层&#10;      1×1 可逆卷积&#10;      多尺度结构&#10;    精确似然&#10;      变量替换公式&#10;      三角雅可比&#10;      LU 分解加速&#10;    连续流&#10;      Neural ODE&#10;      Hutchinson 估计&#10;      Flow Matching&#10;    现代发展&#10;      Rectified Flow&#10;      SD3 / FLUX&#10;      训练效率提升\">mindmap\n  root((标准化流))\n    基础架构\n      仿射耦合层\n      1×1 可逆卷积\n      多尺度结构\n    精确似然\n      变量替换公式\n      三角雅可比\n      LU 分解加速\n    连续流\n      Neural ODE\n      Hutchinson 估计\n      Flow Matching\n    现代发展\n      Rectified Flow\n      SD3 / FLUX\n      训练效率提升</pre><ul>\n<li>标准化流通过可逆变换实现精确的对数似然计算，无需变分近似</li>\n<li>仿射耦合层通过三角雅可比矩阵实现高效的密度计算，是离散流的核心构件</li>\n<li>Glow 的 1×1 可逆卷积和多尺度架构显著增强了模型的表达能力</li>\n<li>连续标准化流将离散变换推广为 ODE，Hutchinson 估计器实现高效的迹计算</li>\n<li>Flow Matching 避免了训练时的 ODE 求解，成为最新的连续流训练范式</li>\n<li>Rectified Flow 框架被 SD3 和 FLUX 采用，标准化流思想正在与扩散模型深度融合</li>\n</ul>\n","headings":[{"level":1,"text":"标准化流模型","id":"标准化流模型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"仿射耦合层与 RealNVP","id":"仿射耦合层与-realnvp"},{"level":2,"text":"Glow 与 1×1 可逆卷积","id":"glow-与-1-1-可逆卷积"},{"level":2,"text":"连续标准化流与 Neural ODE","id":"连续标准化流与-neural-ode"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"VAE 基础原理","url":"/l-doc-books/h/ai-llm/generative-ai/gan-and-vae/vae-fundamentals"},"next":{"title":"文图架构设计","url":"/l-doc-books/h/ai-llm/generative-ai/text-to-image/text-image-architecture"}}