#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), nn.Sigmoid(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> encode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        h </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.encoder(x).flatten(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc_mu(h), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc_logvar(h)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> reparameterize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, mu, logvar):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        std </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.exp(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> logvar)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mu </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> std </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.randn_like(std)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> decode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, z):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        h </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.fc_decode(z).view(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">256</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.decoder(h)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        mu, logvar </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.encode(x)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        z </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.reparameterize(mu, logvar)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.decode(z), mu, logvar</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> elbo_loss</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(recon, target, mu, logvar, beta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    recon_loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F.mse_loss(recon, target, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">reduction</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sum'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    kl_loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.sum(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> logvar </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mu.pow(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> logvar.exp())</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> recon_loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> beta </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kl_loss</span></span></code></pre></div><p>训练中常见的问题是 KL 散度坍缩（posterior collapse）：解码器变得足够强大以至于忽略隐变量信息，导致 q(z|x) 退化为先验 p(z)。缓解策略包括 KL 退火（训练前期将 KL 系数从 0 逐步增大到 1）、自由比特（设置 KL 的最低阈值）、以及使用弱解码器（限制解码器容量迫使其依赖隐变量）。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph KL 退火策略&#10;        A[训练开始] --&gt; B[β = 0 纯重构]&#10;        B --&gt; C[β 线性增长]&#10;        C --&gt; D[β = 1 完整 ELBO]&#10;    end&#10;    subgraph 自由比特&#10;        E[计算每维 KL] --&gt; F{KL_i &gt; λ?}&#10;        F --&gt;|是| G[保留 KL_i]&#10;        F --&gt;|否| H[设置 KL_i = λ]&#10;    end\">graph TD\n    subgraph KL 退火策略\n        A[训练开始] --&gt; B[β = 0 纯重构]\n        B --&gt; C[β 线性增长]\n        C --&gt; D[β = 1 完整 ELBO]\n    end\n    subgraph 自由比特\n        E[计算每维 KL] --&gt; F{KL_i &gt; λ?}\n        F --&gt;|是| G[保留 KL_i]\n        F --&gt;|否| H[设置 KL_i = λ]\n    end</pre><h2 id=\"vq-vae-与离散隐空间\">VQ-VAE 与离散隐空间</h2><p>VQ-VAE（Vector Quantized VAE）用离散码本（codebook）替代连续高斯隐空间。编码器输出连续向量 z_e，通过最近邻查找映射到码本中最接近的嵌入向量 z_q = e_k，其中 k = argmin ||z_e - e_i||。解码器从量化后的 z_q 重构数据。这种离散化带来了两个关键优势：完全避免了 KL 坍缩问题，以及为下游自回归模型提供了离散 token 序列。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn as nn&#10;import torch.nn.functional as F&#10;&#10;class VectorQuantizer(nn.Module):&#10;    def __init__(self, n_embeddings=512, embedding_dim=64, commitment_cost=0.25):&#10;        super().__init__()&#10;        self.embedding = nn.Embedding(n_embeddings, embedding_dim)&#10;        self.commitment_cost = commitment_cost&#10;        nn.init.uniform_(self.embedding.weight, -1 / n_embeddings, 1 / n_embeddings)&#10;&#10;    def forward(self, z_e):&#10;        b, c, h, w = z_e.shape&#10;        flat = z_e.permute(0, 2, 3, 1).reshape(-1, c)&#10;        distances = torch.cdist(flat, self.embedding.weight)&#10;        indices = distances.argmin(dim=1)&#10;        z_q = self.embedding(indices).view(b, h, w, c).permute(0, 3, 1, 2)&#10;        loss = F.mse_loss(z_q.detach(), z_e) + self.commitment_cost * F.mse_loss(z_q, z_e.detach())&#10;        z_q = z_e + (z_q - z_e).detach()&#10;        return z_q, loss, indices.view(b, h, w)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn.functional </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> VectorQuantizer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Module</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, n_embeddings</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">512</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, embedding_dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, commitment_cost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        super</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">__init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.embedding </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.Embedding(n_embeddings, embedding_dim)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.commitment_cost </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> commitment_cost</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        nn.init.uniform_(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.embedding.weight, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n_embeddings, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n_embeddings)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, z_e):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        b, c, h, w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_e.shape</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        flat </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_e.permute(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).reshape(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, c)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        distances </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.cdist(flat, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.embedding.weight)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        indices </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> distances.argmin(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        z_q </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.embedding(indices).view(b, h, w, c).permute(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        loss </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F.mse_loss(z_q.detach(), z_e) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.commitment_cost </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F.mse_loss(z_q, z_e.detach())</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        z_q </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_e </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (z_q </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_e).detach()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z_q, loss, indices.view(b, h, w)</span></span></code></pre></div><p>VQ-VAE 的训练损失包含三项：重构损失 ||x - D(z_q)||²、码本更新损失 ||z_e.detach() - e_k||²（移动码本向量接近编码器输出）和承诺损失 ||z_e - e_k.detach()||²（鼓励编码器输出接近码本向量）。直通估计器（Straight-Through Estimator）用于将梯度从 z_q 直接复制到 z_e，绕过不可微的最近邻操作。</p>\n<p>VQ-VAE-2 引入了多尺度码本层次结构：顶层码本编码全局结构，底层码本编码局部细节。结合 PixelCNN 先验模型对码本索引进行自回归建模，VQ-VAE-2 生成的图像质量可以与 GAN 媲美。这一架构启发了后来的 DALL-E（第一版），它使用 VQ-VAE 将图像编码为 token 序列，然后用 GPT 风格的 Transformer 进行自回归生成。</p>\n<h2 id=\"hierarchical-vae-与-nvae\">Hierarchical VAE 与 NVAE</h2><p>层次化 VAE（Hierarchical VAE）通过引入多层隐变量来增强模型的表达能力。每一层隐变量捕获不同抽象层级的信息：底层编码像素级细节，中间层编码结构和纹理，顶层编码全局语义。层次化结构使得后验分布更加灵活，能够缩小变分间隙。</p>\n<p>NVAE（Nouveau VAE）是层次化 VAE 的代表作品。它通过残差参数化的层次编码器-解码器结构、深度可分离卷积和谱正则化，首次证明纯 VAE 架构可以生成与 GAN 竞争的高分辨率图像。NVAE 使用 30+ 层的隐变量层次，每一层的编码器和解码器都是轻量级的残差网络。</p>\n<table>\n<thead>\n<tr>\n<th>VAE 变体</th>\n<th>隐空间类型</th>\n<th>核心创新</th>\n<th>生成质量</th>\n<th>主要应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>标准 VAE</td>\n<td>连续高斯</td>\n<td>重参数化技巧</td>\n<td>中等</td>\n<td>基础实验</td>\n</tr>\n<tr>\n<td>β-VAE</td>\n<td>连续高斯</td>\n<td>解耦正则</td>\n<td>中等</td>\n<td>解耦表示</td>\n</tr>\n<tr>\n<td>VQ-VAE</td>\n<td>离散码本</td>\n<td>向量量化</td>\n<td>高</td>\n<td>图像/语音 token化</td>\n</tr>\n<tr>\n<td>NVAE</td>\n<td>层次连续</td>\n<td>深层次结构</td>\n<td>高</td>\n<td>高分辨率生成</td>\n</tr>\n<tr>\n<td>Stable Diffusion VAE</td>\n<td>连续（4通道）</td>\n<td>LDM 隐空间编码</td>\n<td>极高</td>\n<td>扩散模型前端</td>\n</tr>\n</tbody></table>\n<p>VAE 在现代生成式 AI 中的角色已经从独立的生成模型转变为更大系统的组件。Stable Diffusion 的 VAE 编解码器、DALL-E 的 VQ-VAE tokenizer 和 Parti 的 ViT-VQGAN 编码器都是 VAE 作为隐空间提供者的典型应用。VAE 擅长学习紧凑、结构化的数据表示，这一能力在多模态生成和视觉 tokenization 中越来越重要。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((VAE 基础))&#10;    核心框架&#10;      编码器-解码器&#10;      ELBO 优化&#10;      重参数化技巧&#10;    训练挑战&#10;      KL 坍缩&#10;      重构模糊&#10;      变分间隙&#10;    VQ-VAE&#10;      离散码本&#10;      直通估计器&#10;      Token 化&#10;    现代角色&#10;      扩散模型 VAE&#10;      视觉 tokenizer&#10;      多模态编码\">mindmap\n  root((VAE 基础))\n    核心框架\n      编码器-解码器\n      ELBO 优化\n      重参数化技巧\n    训练挑战\n      KL 坍缩\n      重构模糊\n      变分间隙\n    VQ-VAE\n      离散码本\n      直通估计器\n      Token 化\n    现代角色\n      扩散模型 VAE\n      视觉 tokenizer\n      多模态编码</pre><ul>\n<li>VAE 通过最大化 ELBO 同时训练编码器和解码器，重参数化技巧是可微分采样的关键</li>\n<li>KL 坍缩是标准 VAE 的核心挑战，KL 退火和自由比特是有效的缓解策略</li>\n<li>VQ-VAE 用离散码本替代连续隐空间，避免 KL 坍缩并支持自回归先验建模</li>\n<li>层次化 VAE（如 NVAE）通过多层隐变量增强表达能力，缩小变分间隙</li>\n<li>VAE 在现代生成系统中的核心角色是提供结构化的隐空间表示，服务于扩散模型和视觉 token 化</li>\n</ul>\n","headings":[{"level":1,"text":"VAE 基础原理","id":"vae-基础原理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"ELBO 优化与训练实践","id":"elbo-优化与训练实践"},{"level":2,"text":"VQ-VAE 与离散隐空间","id":"vq-vae-与离散隐空间"},{"level":2,"text":"Hierarchical VAE 与 NVAE","id":"hierarchical-vae-与-nvae"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"GAN 变体与演进","url":"/l-doc-books/h/ai-llm/generative-ai/gan-and-vae/gan-variants"},"next":{"title":"标准化流模型","url":"/l-doc-books/h/ai-llm/generative-ai/gan-and-vae/flow-models"}}