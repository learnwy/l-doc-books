yle=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> lowIdx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> labels[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> labels[j] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> scoreDiff</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scores[highIdx] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scores[lowIdx];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rho</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(scoreDiff));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> deltaNDCG</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computeDeltaNDCG</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(highIdx, lowIdx, labels, scores, config.ndcgTruncation);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> lambda</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(deltaNDCG) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rho;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      gradients[highIdx].gradient </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lambda;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      gradients[lowIdx].gradient </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lambda;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      gradients[highIdx].hessian </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lambda </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rho);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      gradients[lowIdx].hessian </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lambda </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rho);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gradients;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>LambdaMART 在搜索引擎、推荐系统和广告排序中有广泛应用。它的优势包括：训练速度快、可解释性较好（可以输出特征重要性）、处理稀疏特征和缺失值的能力强。</p>\n<h2 id=\"深度学习排序模型\">深度学习排序模型</h2><p>深度学习排序模型直接从原始文本或特征向量中学习排序函数，无需手工设计交互特征。它们在处理语义匹配和捕获复杂特征交互方面优于传统的 GBDT 模型。</p>\n<table>\n<thead>\n<tr>\n<th>模型</th>\n<th>架构</th>\n<th>输入</th>\n<th>优势</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DSSM</td>\n<td>双塔 MLP</td>\n<td>词袋/N-gram</td>\n<td>高效在线服务</td>\n<td>粗排</td>\n</tr>\n<tr>\n<td>KNRM</td>\n<td>核化匹配网络</td>\n<td>词嵌入交互矩阵</td>\n<td>细粒度匹配</td>\n<td>精排</td>\n</tr>\n<tr>\n<td>BERT-Ranker</td>\n<td>Cross-Encoder</td>\n<td>原始文本</td>\n<td>最高质量</td>\n<td>重排序</td>\n</tr>\n<tr>\n<td>TFR-BERT</td>\n<td>BERT + Listwise</td>\n<td>原始文本列表</td>\n<td>列表级排序</td>\n<td>精排</td>\n</tr>\n<tr>\n<td>SetRank</td>\n<td>自注意力排序</td>\n<td>候选文档集合</td>\n<td>建模文档间关系</td>\n<td>精排</td>\n</tr>\n</tbody></table>\n<p>深度学习排序模型的部署挑战主要在于推理延迟。BERT-Ranker 对每个查询-文档对都需要一次完整的 Transformer 前向传播，在线延迟高。常见的优化策略包括模型蒸馏（将 BERT 知识蒸馏到轻量级模型）、预计算（离线计算文档特征向量）和缓存（缓存高频查询的排序结果）。这些模型在完整排序漏斗中所处的阶段与延迟预算划分，见<a href=\"multi-stage-ranking\">多阶段排序</a>。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>学习排序（LTR）通过机器学习自动学习排序函数，是搜索引擎排序的核心范式</li>\n<li>Pairwise（尤其是 LambdaMART）是工业界最主流的方法，兼顾效果和效率</li>\n<li>排序特征工程是 LTR 中最关键的环节，BM25、点击率、PageRank 和嵌入相似度是核心特征</li>\n<li>LambdaMART 通过 Lambda 梯度间接优化 NDCG 等不可微的排序指标</li>\n<li>深度学习排序模型在语义匹配方面有优势，但需要通过蒸馏和缓存解决在线延迟问题</li>\n</ul>\n","headings":[{"level":1,"text":"学习排序","id":"学习排序"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"排序特征工程","id":"排序特征工程"},{"level":2,"text":"LambdaMART 与梯度提升排序","id":"lambdamart-与梯度提升排序"},{"level":2,"text":"深度学习排序模型","id":"深度学习排序模型"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"语义匹配","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/query-understanding/semantic-matching"},"next":{"title":"交叉编码器重排序","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/ranking-models/cross-encoder-reranking"}}