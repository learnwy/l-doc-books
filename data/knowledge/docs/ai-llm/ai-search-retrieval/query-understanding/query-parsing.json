-shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EntityType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        confidence: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (label.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">startsWith</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'I-'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentEntity) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      currentEntity.text </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tokens[i];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentEntity) entities.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(currentEntity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QueryEntity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      currentEntity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentEntity) entities.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(currentEntity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QueryEntity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> entities;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>实体链接（Entity Linking）将识别出的实体文本映射到知识库中的标准实体。在电商搜索中，这意味着将 &quot;苹果手机&quot; 链接到品牌 &quot;Apple&quot; 和品类 &quot;智能手机&quot;；在通用搜索中，这意味着消歧 &quot;苹果&quot; 是水果还是公司。链接过程通常包括候选生成（通过别名词典和模糊匹配找到候选实体）和候选排序（通过上下文和流行度选择最佳匹配）两步。</p>\n<h2 id=\"查询分词与归一化\">查询分词与归一化</h2><p>分词和归一化是查询解析的基础步骤，直接影响后续所有环节的质量。中文查询的分词尤为关键，错误的分词会导致实体断裂、语义扭曲。</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>方法</th>\n<th>适用场景</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>词典分词</td>\n<td>最大匹配 + 词典</td>\n<td>通用中文分词</td>\n<td>&quot;北京大学&quot; → [&quot;北京大学&quot;]</td>\n</tr>\n<tr>\n<td>统计分词</td>\n<td>HMM/CRF</td>\n<td>新词发现</td>\n<td>&quot;ChatGPT&quot; → [&quot;ChatGPT&quot;]</td>\n</tr>\n<tr>\n<td>子词分词</td>\n<td>BPE/WordPiece</td>\n<td>神经模型输入</td>\n<td>&quot;transformers&quot; → [&quot;transform&quot;, &quot;##ers&quot;]</td>\n</tr>\n<tr>\n<td>同义词归一化</td>\n<td>同义词词典</td>\n<td>标准化表达</td>\n<td>&quot;手机&quot; = &quot;手机&quot; = &quot;移动电话&quot;</td>\n</tr>\n<tr>\n<td>纠错归一化</td>\n<td>编辑距离 + LM</td>\n<td>纠正拼写错误</td>\n<td>&quot;iphon&quot; → &quot;iphone&quot;</td>\n</tr>\n<tr>\n<td>大小写归一化</td>\n<td>统一小写</td>\n<td>英文查询</td>\n<td>&quot;JavaScript&quot; → &quot;javascript&quot;</td>\n</tr>\n</tbody></table>\n<p>查询纠错（Query Spell Correction）是归一化中最重要的环节之一。常见方法包括基于编辑距离的候选生成、基于 N-gram 语言模型的候选排序，以及基于 Seq2Seq 模型的端到端纠错。在搜索日志丰富的场景下，可以利用用户的查询 session 中的改写行为（&quot;iphon → iphone&quot;）自动挖掘纠错对。归一化只是查询理解的保守入口，更激进的语义级变换（同义扩展、重构、LLM 改写）属于<a href=\"query-rewriting\">查询改写</a>的范畴，两者共享同一套词典与日志基础设施。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>查询解析是搜索系统的第一道关卡，将自然语言查询转化为结构化的检索意图</li>\n<li>意图分类决定了搜索策略的选择，导航型/信息型/交易型查询需要不同的检索和展示策略</li>\n<li>查询 NER 和实体链接解决了短文本实体识别和消歧问题，是精准检索的基础</li>\n<li>分词和归一化质量直接影响检索效果，中文分词、同义词归一化和查询纠错是重点环节</li>\n<li>现代查询解析趋向端到端的神经网络方法，但规则和词典在处理长尾 case 时仍不可替代</li>\n</ul>\n","headings":[{"level":1,"text":"查询解析","id":"查询解析"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"查询意图识别","id":"查询意图识别"},{"level":2,"text":"查询实体识别与链接","id":"查询实体识别与链接"},{"level":2,"text":"查询分词与归一化","id":"查询分词与归一化"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"嵌入模型","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/neural-retrieval/embedding-models"},"next":{"title":"查询改写","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/query-understanding/query-rewriting"}}