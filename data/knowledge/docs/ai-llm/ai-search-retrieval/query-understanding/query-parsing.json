">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> questionWords.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    containsUrl:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">https</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">:</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\/\\/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">www</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\.</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    containsBrandName: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    containsActionVerb: tokens.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">some</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actionVerbs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    avgWordIdf: tokens.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (vocabulary.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tokens.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>在搜索引擎场景中，导航型查询（如 &quot;GitHub 官网&quot;）通常直接返回目标页面，信息型查询（如 &quot;React 和 Vue 的区别&quot;）需要展示丰富的搜索结果摘要，交易型查询（如 &quot;iPhone 15 购买&quot;）需要优先展示商品和价格信息。</p>\n<p>现代方法使用 BERT 类模型进行意图分类，将查询的 [CLS] 表示输入一个全连接分类器。对于多标签场景（一个查询可能同时包含多个意图），使用 sigmoid 激活代替 softmax。意图分类的输出（如导航型标志位）通常作为特征进入下游的<a href=\"../ranking-models/learning-to-rank\">学习排序</a>模型，参与最终的相关性打分。</p>\n<h2 id=\"查询实体识别与链接\">查询实体识别与链接</h2><p>查询实体识别（Query NER）在查询文本中标注出有意义的实体（品牌、产品、属性、地点等），并将其链接到知识库中的规范实体。与文档级 NER 不同，查询 NER 面临文本极短、上下文不足、用户表达多样等挑战。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface QueryEntity {&#10;  text: string;&#10;  start: number;&#10;  end: number;&#10;  type: EntityType;&#10;  normalizedForm: string;&#10;  linkedId?: string;&#10;  confidence: number;&#10;}&#10;&#10;type EntityType = &#39;brand&#39; | &#39;product&#39; | &#39;category&#39; | &#39;attribute&#39; | &#39;location&#39; | &#39;time&#39;;&#10;&#10;interface EntityLinkingResult {&#10;  entity: QueryEntity;&#10;  candidates: Array&lt;{&#10;    id: string;&#10;    name: string;&#10;    score: number;&#10;    popularity: number;&#10;  }&gt;;&#10;  bestMatch: { id: string; name: string } | null;&#10;}&#10;&#10;function queryNER(query: string, model: SequenceLabeler): QueryEntity[] {&#10;  const tokens = tokenize(query);&#10;  const labels = model.predict(tokens);&#10;  const entities: QueryEntity[] = [];&#10;  let currentEntity: Partial&lt;QueryEntity&gt; | null = null;&#10;&#10;  for (let i = 0; i &lt; tokens.length; i++) {&#10;    const label = labels[i];&#10;    if (label.startsWith(&#39;B-&#39;)) {&#10;      if (currentEntity) entities.push(currentEntity as QueryEntity);&#10;      currentEntity = {&#10;        text: tokens[i],&#10;        start: i,&#10;        type: label.slice(2) as EntityType,&#10;        confidence: 0,&#10;      };&#10;    } else if (label.startsWith(&#39;I-&#39;) &amp;&amp; currentEntity) {&#10;      currentEntity.text += tokens[i];&#10;    } else {&#10;      if (currentEntity) entities.push(currentEntity as QueryEntity);&#10;      currentEntity = null;&#10;    }&#10;  }&#10;&#10;  if (currentEntity) entities.push(currentEntity as QueryEntity);&#10;  return entities;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;c