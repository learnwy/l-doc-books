dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'lt'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'in'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'range'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>索引构建参数对检索性能影响显著。HNSW 的 M 参数控制图的连接度（更大 = 更高召回但更慢构建和更多内存），efConstruction 控制构建质量，efSearch 控制检索精度。IVF 的 nlist 控制聚类数量，nprobe 控制检索时探查的聚类数。这些索引算法背后的图结构与量化原理，在<a href=\"../neural-retrieval/dense-retrieval\">稠密检索</a>的近似最近邻一节有详细推导。</p>\n<h2 id=\"混合搜索与过滤\">混合搜索与过滤</h2><p>实际应用中，向量搜索通常需要与标量过滤（如按日期、类别、权限筛选）结合使用。混合搜索的核心挑战是如何高效地将向量近似搜索与精确的标量过滤结合。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type FilterStrategy = &#39;pre_filter&#39; | &#39;post_filter&#39; | &#39;in_filter&#39;;&#10;&#10;interface HybridSearchConfig {&#10;  vectorWeight: number;&#10;  sparseWeight: number;&#10;  filterStrategy: FilterStrategy;&#10;  topK: number;&#10;  overFetchFactor: number;&#10;}&#10;&#10;async function hybridVectorSearch(&#10;  vectorDB: VectorDB,&#10;  query: Float32Array,&#10;  filter: FilterExpr,&#10;  config: HybridSearchConfig,&#10;): Promise&lt;SearchResult[]&gt; {&#10;  if (config.filterStrategy === &#39;pre_filter&#39;) {&#10;    const filteredIds = await vectorDB.filterIds(filter);&#10;    return vectorDB.searchWithIdSet(query, filteredIds, config.topK);&#10;  }&#10;&#10;  if (config.filterStrategy === &#39;post_filter&#39;) {&#10;    const overFetchK = config.topK * config.overFetchFactor;&#10;    const candidates = await vectorDB.search(query, overFetchK);&#10;    return candidates.filter((r) =&gt; matchesFilter(r.metadata, filter)).slice(0, config.topK);&#10;  }&#10;&#10;  return vectorDB.searchWithFilter(query, filter, config.topK);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FilterStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pre_filter'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'post_filter'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'in_filter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HybridSearchConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  vectorWeight</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  sparseWeight</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  filterStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FilterStrategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  topK</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  overFetchFactor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hybridVectorSearch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  vectorDB</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> VectorDB</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  query</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  filter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FilterExpr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HybridSearchConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">SearchResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.filterStrategy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pre_filter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> filteredIds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vectorDB.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filterIds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(filter);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vectorDB.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">searchWithIdSet</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query, filteredIds, config.topK);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.filterStrategy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'post_filter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> overFetchK</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.topK </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.overFetchFactor;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> candidates</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vectorDB.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">search</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query, overFetchK);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> candidates.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> matchesFilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(r.metadata, filter)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, config.topK);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vectorDB.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">searchWithFilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query, filter, config.topK);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>过滤策略</th>\n<th>工作方式</th>\n<th>优势</th>\n<th>劣势</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Pre-Filter</td>\n<td>先标量过滤，再向量搜索</td>\n<td>结果精确</td>\n<td>过滤后集合可能太小</td>\n<td>高选择性过滤</td>\n</tr>\n<tr>\n<td>Post-Filter</td>\n<td>先向量搜索，再标量过滤</td>\n<td>向量搜索不受影响</td>\n<td>可能返回不足 K 个结果</td>\n<td>低选择性过滤</td>\n</tr>\n<tr>\n<td>In-Filter</td>\n<td>向量搜索与过滤同时进行</td>\n<td>效率最优</td>\n<td>实现复杂</td>\n<td>通用场景</td>\n</tr>\n</tbody></table>\n<h2 id=\"分布式架构与扩展\">分布式架构与扩展</h2><p>当数据规模超过单机容量时，需要将向量数据库扩展为分布式架构。核心设计包括数据分片（Sharding）、副本（Replication）和一致性保证。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    CLIENT[客户端] --&gt; ROUTER[路由层]&#10;    ROUTER --&gt; S1[Shard 1]&#10;    ROUTER --&gt; S2[Shard 2]&#10;    ROUTER --&gt; S3[Shard 3]&#10;    S1 --&gt; R1A[副本 A]&#10;    S1 --&gt; R1B[副本 B]&#10;    S2 --&gt; R2A[副本 A]&#10;    S2 --&gt; R2B[副本 B]&#10;    S3 --&gt; R3A[副本 A]&#10;    S3 --&gt; R3B[副本 B]&#10;    subgraph 分片策略&#10;        ROUTER&#10;        S1&#10;        S2&#10;        S3&#10;    end\">graph TB\n    CLIENT[客户端] --&gt; ROUTER[路由层]\n    ROUTER --&gt; S1[Shard 1]\n    ROUTER --&gt; S2[Shard 2]\n    ROUTER --&gt; S3[Shard 3]\n    S1 --&gt; R1A[副本 A]\n    S1 --&gt; R1B[副本 B]\n    S2 --&gt; R2A[副本 A]\n    S2 --&gt; R2B[副本 B]\n    S3 --&gt; R3A[副本 A]\n    S3 --&gt; R3B[副本 B]\n    subgraph 分片策略\n        ROUTER\n        S1\n        S2\n        S3\n    end</pre><p>分片策略通常基于向量 ID 的哈希值或数据的地理/业务属性。查询时，路由层将查询广播到所有分片，每个分片返回本地 Top-K，路由层再合并排序得到全局 Top-K。分片数量的选择需要平衡查询延迟（分片越多，单分片数据越少，本地搜索越快）和网络开销（分片越多，合并成本越高）。</p>\n<p>副本机制提供读扩展和高可用性。写入时采用主从复制或多主复制，读取时可以从任意副本读取以分散负载。向量数据库的写入吞吐通常受限于索引构建成本，因此在写入密集场景需要采用批量写入和异步索引构建。向量数据库在端到端搜索系统中的位置与依赖关系，见<a href=\"search-system-architecture\">搜索系统架构</a>。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>向量数据库是语义搜索和 RAG 的核心基础设施，核心操作是 ANN 近似最近邻搜索</li>\n<li>HNSW 索引适合中小规模高精度场景，IVF-PQ 适合大规模低内存场景，DiskANN 适合磁盘级超大规模</li>\n<li>混合搜索需要将向量检索与标量过滤结合，Pre/Post/In-Filter 各有适用场景</li>\n<li>分布式架构通过分片和副本实现水平扩展和高可用，查询时广播到所有分片后合并结果</li>\n<li>选择向量数据库需综合考虑数据规模、查询延迟、过滤需求、运维成本和是否需要托管服务</li>\n</ul>\n","headings":[{"level":1,"text":"向量数据库","id":"向量数据库"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"索引构建与管理","id":"索引构建与管理"},{"level":2,"text":"混合搜索与过滤","id":"混合搜索与过滤"},{"level":2,"text":"分布式架构与扩展","id":"分布式架构与扩展"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"人工评估","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/search-evaluation/human-evaluation"},"next":{"title":"索引构建与在线服务","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/search-infrastructure/indexing-serving"}}