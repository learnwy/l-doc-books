\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handleDocumentUpdate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">indexer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> IncrementalIndexer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">doc</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProcessedDocument</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  indexer.memoryBuffer.documents.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(doc.id, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toIndexedDoc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(doc));</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  updateInvertedIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indexer.memoryBuffer.invertedIndex, doc);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  indexer.memoryBuffer.vectorIndex.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(doc.id, doc.embedding);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  indexer.memoryBuffer.currentSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (indexer.memoryBuffer.currentSize </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> indexer.mergePolicy.flushThreshold) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> segment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> flushToDisk</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indexer.memoryBuffer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    indexer.diskSegments.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(segment);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    clearMemoryBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indexer.memoryBuffer);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">shouldMerge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indexer.diskSegments, indexer.mergePolicy)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> mergeSegments</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indexer.diskSegments, indexer.mergePolicy);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>LSM（Log-Structured Merge-tree）风格的索引管理是近实时搜索引擎（如 Elasticsearch）的核心设计。新文档首先写入内存缓冲区，当缓冲区达到阈值时刷盘为一个不可变的段（Segment），后台持续合并小段为大段以提高检索效率。</p>\n<h2 id=\"在线服务架构\">在线服务架构</h2><p>在线服务架构需要在查询延迟、吞吐量和可用性之间取得平衡。核心组件包括查询路由、负载均衡、结果缓存和降级策略。把这些组件放进端到端的微服务拓扑中审视，见<a href=\"search-system-architecture\">搜索系统架构</a>。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    LB[负载均衡] --&gt; QR1[查询路由 1]&#10;    LB --&gt; QR2[查询路由 2]&#10;    QR1 --&gt; CACHE[结果缓存]&#10;    QR2 --&gt; CACHE&#10;    CACHE --&gt; SEARCH[搜索集群]&#10;    SEARCH --&gt; SHARD1[分片 1]&#10;    SEARCH --&gt; SHARD2[分片 2]&#10;    SEARCH --&gt; SHARD3[分片 3]&#10;    subgraph 在线服务&#10;        LB&#10;        QR1&#10;        QR2&#10;        CACHE&#10;    end\">graph TB\n    LB[负载均衡] --&gt; QR1[查询路由 1]\n    LB --&gt; QR2[查询路由 2]\n    QR1 --&gt; CACHE[结果缓存]\n    QR2 --&gt; CACHE\n    CACHE --&gt; SEARCH[搜索集群]\n    SEARCH --&gt; SHARD1[分片 1]\n    SEARCH --&gt; SHARD2[分片 2]\n    SEARCH --&gt; SHARD3[分片 3]\n    subgraph 在线服务\n        LB\n        QR1\n        QR2\n        CACHE\n    end</pre><table>\n<thead>\n<tr>\n<th>优化策略</th>\n<th>目标</th>\n<th>方法</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>结果缓存</td>\n<td>降低延迟</td>\n<td>热门查询缓存</td>\n<td>P50 降低 50-80%</td>\n</tr>\n<tr>\n<td>查询并行</td>\n<td>降低延迟</td>\n<td>多分片并行检索</td>\n<td>线性加速</td>\n</tr>\n<tr>\n<td>预计算</td>\n<td>降低延迟</td>\n<td>离线计算文档特征</td>\n<td>减少在线计算</td>\n</tr>\n<tr>\n<td>降级策略</td>\n<td>保证可用性</td>\n<td>异常时切换简单模型</td>\n<td>SLA 保障</td>\n</tr>\n<tr>\n<td>限流熔断</td>\n<td>保护系统</td>\n<td>过载时拒绝请求</td>\n<td>防止雪崩</td>\n</tr>\n<tr>\n<td>异步重排</td>\n<td>优化体验</td>\n<td>先返回基础结果，异步精排</td>\n<td>首屏更快</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>索引构建与在线服务是搜索系统的两大核心工程支柱，决定了数据新鲜度和查询性能</li>\n<li>文档处理管线需要保证幂等性、容错性和可追溯性，支持大规模并行处理</li>\n<li>增量索引通过 LSM 风格的内存缓冲+段合并实现近实时更新，是动态数据源的标准方案</li>\n<li>在线服务通过缓存、并行检索、降级策略和限流熔断保障延迟和可用性</li>\n<li>索引部署需要支持蓝绿发布或灰度切换，确保索引更新不影响在线服务</li>\n</ul>\n","headings":[{"level":1,"text":"索引构建与在线服务","id":"索引构建与在线服务"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"文档处理管线","id":"文档处理管线"},{"level":2,"text":"增量索引与近实时更新","id":"增量索引与近实时更新"},{"level":2,"text":"在线服务架构","id":"在线服务架构"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"向量数据库","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/search-infrastructure/vector-databases"},"next":{"title":"搜索系统架构","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/search-infrastructure/search-system-architecture"}}