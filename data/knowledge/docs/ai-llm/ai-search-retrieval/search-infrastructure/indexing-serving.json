{"seq":2,"slug":"indexing-serving","title":"索引构建与在线服务","url":"/l-doc-books/h/ai-llm/ai-search-retrieval/search-infrastructure/indexing-serving","wordCount":866,"readingTime":4,"html":"<h1 id=\"索引构建与在线服务\">索引构建与在线服务</h1><h2 id=\"核心概念\">核心概念</h2><p>索引构建与在线服务（Indexing and Serving）是搜索系统从离线数据处理到在线查询响应的完整工程管线。索引构建将原始文档转换为高效检索的数据结构，在线服务基于这些索引响应用户的实时查询请求。两者的设计直接决定了搜索系统的数据新鲜度、查询延迟和系统可用性。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph 离线索引管线&#10;        RAW[原始文档] --&gt; PARSE[文档解析]&#10;        PARSE --&gt; PROCESS[内容处理]&#10;        PROCESS --&gt; ENCODE[向量编码]&#10;        ENCODE --&gt; BUILD[索引构建]&#10;        BUILD --&gt; DEPLOY_IDX[索引部署]&#10;    end&#10;    subgraph 在线服务&#10;        QUERY[查询请求] --&gt; QP[查询处理]&#10;        QP --&gt; RETRIEVE[检索执行]&#10;        RETRIEVE --&gt; RANK[排序]&#10;        RANK --&gt; RESPONSE[返回结果]&#10;        DEPLOY_IDX --&gt; RETRIEVE&#10;    end\">graph TB\n    subgraph 离线索引管线\n        RAW[原始文档] --&gt; PARSE[文档解析]\n        PARSE --&gt; PROCESS[内容处理]\n        PROCESS --&gt; ENCODE[向量编码]\n        ENCODE --&gt; BUILD[索引构建]\n        BUILD --&gt; DEPLOY_IDX[索引部署]\n    end\n    subgraph 在线服务\n        QUERY[查询请求] --&gt; QP[查询处理]\n        QP --&gt; RETRIEVE[检索执行]\n        RETRIEVE --&gt; RANK[排序]\n        RANK --&gt; RESPONSE[返回结果]\n        DEPLOY_IDX --&gt; RETRIEVE\n    end</pre><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>离线索引</th>\n<th>近实时索引</th>\n<th>实时索引</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>更新延迟</td>\n<td>小时-天</td>\n<td>秒-分钟</td>\n<td>毫秒级</td>\n</tr>\n<tr>\n<td>索引质量</td>\n<td>最优</td>\n<td>较优</td>\n<td>可能次优</td>\n</tr>\n<tr>\n<td>构建方式</td>\n<td>全量重建</td>\n<td>增量合并</td>\n<td>内存缓冲</td>\n</tr>\n<tr>\n<td>资源消耗</td>\n<td>集中式高峰</td>\n<td>持续中等</td>\n<td>持续低</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>静态语料</td>\n<td>新闻/社交</td>\n<td>即时通讯</td>\n</tr>\n</tbody></table>\n<h2 id=\"文档处理管线\">文档处理管线</h2><p>文档处理管线将原始内容转换为可索引的结构化数据。这个过程包括文档获取、内容提取、文本清洗、特征计算和向量编码等步骤。其中向量编码环节产出的嵌入如何建索引、如何被高效检索，取决于<a href=\"vector-databases\">向量数据库</a>的索引选型与参数配置。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DocumentPipeline {&#10;  crawler: DocumentCrawler;&#10;  parser: DocumentParser;&#10;  enricher: DocumentEnricher;&#10;  encoder: DocumentEncoder;&#10;  indexer: DocumentIndexer;&#10;}&#10;&#10;interface ProcessedDocument {&#10;  id: string;&#10;  url: string;&#10;  title: string;&#10;  content: string;&#10;  cleanText: string;&#10;  tokens: string[];&#10;  embedding: Float32Array;&#10;  metadata: DocumentMetadata;&#10;  features: DocumentFeatures;&#10;}&#10;&#10;interface DocumentMetadata {&#10;  language: string;&#10;  contentType: string;&#10;  publishDate: Date;&#10;  lastModified: Date;&#10;  author: string;&#10;  domain: string;&#10;}&#10;&#10;interface DocumentFeatures {&#10;  wordCount: number;&#10;  pageRank: number;&#10;  domainAuthority: number;&#10;  qualityScore: number;&#10;  spamScore: number;&#10;  readabilityScore: number;&#10;}&#10;&#10;async function processDocument(raw: RawDocument, pipeline: DocumentPipeline): Promise&lt;ProcessedDocument&gt; {&#10;  const parsed = await pipeline.parser.parse(raw);&#10;  const enriched = await pipeline.enricher.enrich(parsed);&#10;  const embedding = await pipeline.encoder.encode(enriched.cleanText);&#10;&#10;  return {&#10;    id: raw.id,&#10;    url: raw.url,&#10;    title: parsed.title,&#10;    content: parsed.content,&#10;    cleanText: enriched.cleanText,&#10;    tokens: enriched.tokens,&#10;    embedding,&#10;    metadata: enriched.metadata,&#10;    features: enriched.features,&#10;  };&#10;}&#10;&#10;interface BatchProcessor {&#10;  batchSize: number;&#10;  concurrency: number;&#10;  retryPolicy: RetryPolicy;&#10;  deadLetterQueue: string;&#10;}&#10;&#10;async function batchProcess(&#10;  documents: RawDocument[],&#10;  pipeline: DocumentPipeline,&#10;  config: BatchProcessor,&#10;): Promise&lt;ProcessingResult&gt; {&#10;  const batches = chunk(documents, config.batchSize);&#10;  let successCount = 0;&#10;  let failCount = 0;&#10;&#10;  for (const batch of batches) {&#10;    const results = await Promise.allSettled(batch.map((doc) =&gt; processDocument(doc, pipeline)));&#10;&#10;    for (const result of results) {&#10;      if (result.status === &#39;fulfilled&#39;) {&#10;        await pipeline.indexer.index(result.value);&#10;        successCount++;&#10;      } else {&#10;        failCount++;&#10;      }&#10;    }&#10;  }&#10;&#10;  return { successCount, failCount, total: documents.length };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DocumentPipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  crawler</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DocumentCrawler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  parser</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DocumentParser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  enricher</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DocumentEnricher</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  encoder</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DocumentEncoder</span><sp