-dark:#E1E4E8\">    { limit: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, rate: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, deduction: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">210</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { limit: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">25000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, rate: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, deduction: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1410</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { limit: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">35000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, rate: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, deduction: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2660</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { limit: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">55000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, rate: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, deduction: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4410</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { limit: </span><span style=\"color:#005