span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createMomentumStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> StrategyConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cross-sectional-momentum'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  universe: { minMarketCap: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1e9</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, minAvgVolume: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1e6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, exchange: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'NYSE'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'NASDAQ'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  signals: [{ name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'momentum_12_1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, factorId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'returns'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, lookbackPeriod: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">252</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, threshold: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, direction: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'long'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  entryRules: [{ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'signal_cross'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, signal: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'momentum_12_1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, action: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'enter_long'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  exitRules: [{ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'signal_cross'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, signal: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'momentum_12_1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, action: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'exit_long'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  positionSizing: { method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'equal_weight'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, maxWeight: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  riskLimits: { maxPositionSize: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, maxDrawdown: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.15</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, maxDailyLoss: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.03</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, maxCorrelation: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, maxLeverage: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p><strong>回测验证阶段</strong>：使用历史数据模拟策略表现。需要注意前视偏差、幸存者偏差和交易成本的影响。</p>\n<p><strong>模拟交易阶段</strong>：在实时市场数据上运行策略但不实际下单，验证策略在真实环境中的行为与回测结果的一致性。</p>\n<p><strong>实盘部署阶段</strong>：逐步放大资金规模，从小仓位开始观察策略表现，确认无技术故障后逐步加仓。</p>\n<h2 id=\"量化策略分类体系\">量化策略分类体系</h2><p>量化策略可以从多个维度进行分类，不同类型的策略在持仓周期、容量限制、技术要求和风险特征上差异显著。</p>\n<p><strong>按持仓周期分类</strong>：高频策略（毫秒到分钟）、日内策略（分钟到小时）、短周期策略（天到周）、中长周期策略（周到月）。持仓周期越短，对技术基础设施的要求越高，但策略容量通常越小。</p>\n<p><strong>按信号来源分类</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>策略类型</th>\n<th>信号来源</th>\n<th>典型持仓</th>\n<th>夏普比率</th>\n<th>容量</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>趋势跟踪</td>\n<td>价格动量</td>\n<td>周-月</td>\n<td>0.5-1.0</td>\n<td>大</td>\n</tr>\n<tr>\n<td>均值回归</td>\n<td>价格偏离</td>\n<td>天-周</td>\n<td>0.8-1.5</td>\n<td>中</td>\n</tr>\n<tr>\n<td>统计套利</td>\n<td>价差收敛</td>\n<td>分钟-天</td>\n<td>1.0-2.0</td>\n<td>中</td>\n</tr>\n<tr>\n<td>基本面量化</td>\n<td>财务因子</td>\n<td>月-季</td>\n<td>0.3-0.8</td>\n<td>大</td>\n</tr>\n<tr>\n<td>事件驱动</td>\n<td>新闻/公告</td>\n<td>天-周</td>\n<td>0.5-1.2</td>\n<td>小</td>\n</tr>\n<tr>\n<td>机器学习</td>\n<td>多源特征</td>\n<td>天-月</td>\n<td>0.5-1.5</td>\n<td>中</td>\n</tr>\n</tbody></table>\n<p><strong>按市场分类</strong>：股票多空、期货CTA、期权波动率、外汇套利、跨市场套利等。不同市场的流动性、交易成本和监管要求各异，策略需要针对性设计。</p>\n<h2 id=\"数据基础设施\">数据基础设施</h2><p>数据是量化交易的燃料。高质量的数据获取、清洗和存储能力直接决定了策略研发的效率和实盘表现的可靠性。</p>\n<p><strong>数据类型</strong>：行情数据（Tick、分钟线、日线）、基本面数据（财务报表、估值指标）、另类数据（卫星图像、社交媒体情绪、供应链数据）。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DataPipeline {&#10;  ingest(source: DataSource): AsyncGenerator&lt;RawRecord&gt;;&#10;  clean(records: RawRecord[]): CleanRecord[];&#10;  validate(records: CleanRecord[]): ValidationResult;&#10;  store(records: CleanRecord[]): Promise&lt;void&gt;;&#10;}&#10;&#10;interface DataSource {&#10;  type: &#39;market&#39; | &#39;fundamental&#39; | &#39;alternative&#39;;&#10;  provider: string;&#10;  frequency: &#39;tick&#39; | &#39;minute&#39; | &#39;daily&#39;;&#10;  symbols: string[];&#10;}&#10;&#10;interface ValidationResult {&#10;  totalRecords: number;&#10;  validRecords: number;&#10;  issues: DataIssue[];&#10;}&#10;&#10;interface DataIssue {&#10;  type: &#39;missing&#39; | &#39;outlier&#39; | &#39;duplicate&#39; | &#39;stale&#39;;&#10;  symbol: string;&#10;  timestamp: number;&#10;  field: string;&#10;  details: string;&#10;}&#10;&#10;const validateOHLCV = (bar: OHLCV): DataIssue[] =&gt; {&#10;  const issues: DataIssue[] = [];&#10;  if (bar.high &lt; bar.low) {&#10;    issues.push({&#10;      type: &#39;outlier&#39;,&#10;      symbol: &#39;&#39;,&#10;      timestamp: bar.timestamp,&#10;      field: &#39;high_low&#39;,&#10;      details: `high ${bar.high} &lt; low ${bar.low}`,&#10;    });&#10;  }&#10;  if (bar.close &lt; 0 || bar.open &lt; 0) {&#10;    issues.push({&#10;      type: &#39;outlier&#39;,&#10;      symbol: &#39;&#39;,&#10;      timestamp: bar.timestamp,&#10;      field: &#39;price&#39;,&#10;      details: &#39;negative price detected&#39;,&#10;    });&#10;  }&#10;  if (bar.volume &lt; 0) {&#10;    issues.push({&#10;      type: &#39;outlier&#39;,&#10;      symbol: &#39;&#39;,&#10;      timestamp: bar.timestamp,&#10;      field: &#39;volume&#39;,&#10;      details: &#39;negative volume detected&#39;,&#10;    });&#10;  }&#10;  return issues;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span