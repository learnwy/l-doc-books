布] --&gt; B[预期损失EL]&#10;    A --&gt; C[非预期损失UL]&#10;    A --&gt; D[极端损失]&#10;    B --&gt; E[通过定价覆盖/拨备]&#10;    C --&gt; F[通过经济资本覆盖]&#10;    D --&gt; G[通过保险/证券化转移]\">graph LR\n    A[损失分布] --&gt; B[预期损失EL]\n    A --&gt; C[非预期损失UL]\n    A --&gt; D[极端损失]\n    B --&gt; E[通过定价覆盖/拨备]\n    C --&gt; F[通过经济资本覆盖]\n    D --&gt; G[通过保险/证券化转移]</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface LoanPortfolio {&#10;  loans: Array&lt;{ amount: number; pd: number; lgd: number }&gt;;&#10;}&#10;&#10;interface PortfolioRisk {&#10;  totalExposure: number;&#10;  expectedLoss: number;&#10;  expectedLossRate: number;&#10;  unexpectedLoss: number;&#10;  economicCapital: number;&#10;}&#10;&#10;const analyzePortfolioCredit = (portfolio: LoanPortfolio): PortfolioRisk =&gt; {&#10;  const totalExposure = portfolio.loans.reduce((sum, l) =&gt; sum + l.amount, 0);&#10;  const expectedLoss = portfolio.loans.reduce((sum, l) =&gt; sum + l.amount * l.pd * l.lgd, 0);&#10;&#10;  const varianceLoss = portfolio.loans.reduce((sum, l) =&gt; {&#10;    const elLoan = l.amount * l.pd * l.lgd;&#10;    const varLoan = l.amount * l.amount * l.pd * (1 - l.pd) * l.lgd * l.lgd;&#10;    return sum + varLoan;&#10;  }, 0);&#10;&#10;  const unexpectedLoss = Math.sqrt(varianceLoss);&#10;  const economicCapital = unexpectedLoss * 2.326;&#10;&#10;  return {&#10;    totalExposure: Math.round(totalExposure),&#10;    expectedLoss: Math.round(expectedLoss),&#10;    expectedLossRate: Math.round((expectedLoss / totalExposure) * 10000) / 100,&#10;    unexpectedLoss: Math.round(unexpectedLoss),&#10;    economicCapital: Math.round(economicCapital),&#10;  };&#10;};&#10;&#10;const portfolio: LoanPortfolio = {&#10;  loans: [&#10;    { amount: 1000000, pd: 0.01, lgd: 0.4 },&#10;    { amount: 500000, pd: 0.03, lgd: 0.5 },&#10;    { amount: 2000000, pd: 0.005, lgd: 0.35 },&#10;    { amount: 300000, pd: 0.08, lgd: 0.6 },&#10;  ],&#10;};&#10;&#10;const risk = analyzePortfolioCredit(portfolio);&#10;console.l