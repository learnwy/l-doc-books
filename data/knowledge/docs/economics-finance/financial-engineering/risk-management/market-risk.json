color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`最新年化波动率: ${</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">latestVol</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}%`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((市场风险))&#10;    风险类型&#10;      股票风险&#10;      利率风险&#10;      汇率风险&#10;    VaR&#10;      参数法&#10;      历史模拟&#10;      蒙特卡洛&#10;    压力测试&#10;      历史情景&#10;      假设情景&#10;      极端尾部&#10;    波动率&#10;      EWMA&#10;      GARCH&#10;      聚集效应\">mindmap\n  root((市场风险))\n    风险类型\n      股票风险\n      利率风险\n      汇率风险\n    VaR\n      参数法\n      历史模拟\n      蒙特卡洛\n    压力测试\n      历史情景\n      假设情景\n      极端尾部\n    波动率\n      EWMA\n      GARCH\n      聚集效应</pre><ul>\n<li>市场风险来源于价格波动，分为系统性风险和非系统性风险</li>\n<li>VaR 是行业标准的风险衡量工具，但无法捕捉极端尾部风险</li>\n<li>压力测试补充 VaR 的不足，模拟极端场景下的潜在损失</li>\n<li>波动率是市场风险的核心度量，EWMA 和 GARCH 是主要的建模方法</li>\n<li>风控系统的开发需要将这些模型转化为实时计算和监控能力</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li><a href=\"../risk-management/risk-metrics\">风险度量指标</a>：市场风险的量化离不开 VaR、波动率等度量指标。</li>\n<li><a href=\"../../../quantitative-finance/risk-management-quant/risk-measures/var-cvar\">量化风险管理 · VaR 与 CVaR</a>：VaR/CVaR 的严格定义与多种估计方法。</li>\n<li><a href=\"../../../economics-finance/financial-risk-management/market-credit-risk/market-risk-hedging\">金融风险管理 · 市场风险与对冲</a>：机构层面市场风险识别与对冲的体系化视角。</li>\n</ul>\n","headings":[{"level":1,"text":"市场风险","id":"市场风险"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"VaR：在险价值","id":"var-在险价值"},{"level":2,"text":"压力测试与情景分析","id":"压力测试与情景分析"},{"level":2,"text":"波动率建模","id":"波动率建模"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"Greeks 与对冲","url":"/l-doc-books/h/economics-finance/financial-engineering/derivatives-pricing/greeks-and-hedging"},"next":{"title":"信用风险","url":"/l-doc-books/h/economics-finance/financial-engineering/risk-management/credit-risk"}}