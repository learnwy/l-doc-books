th>策略名称</th>\n<th>构成</th>\n<th>使用场景</th>\n<th>最大风险</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>保护性看跌</td>\n<td>持有股票+买入Put</td>\n<td>保护持仓下行风险</td>\n<td>Put权利金</td>\n</tr>\n<tr>\n<td>备兑开仓</td>\n<td>持有股票+卖出Call</td>\n<td>增加持仓收入</td>\n<td>放弃上行空间</td>\n</tr>\n<tr>\n<td>跨式组合</td>\n<td>同行权价买Call+Put</td>\n<td>预期大幅波动</td>\n<td>两份权利金</td>\n</tr>\n<tr>\n<td>牛市价差</td>\n<td>买低行权Call+卖高行权Call</td>\n<td>温和看涨</td>\n<td>净权利金</td>\n</tr>\n<tr>\n<td>铁蝶式</td>\n<td>价差组合+跨式组合</td>\n<td>预期窄幅震荡</td>\n<td>有限</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface StrategyLeg {&#10;  option: OptionContract;&#10;  position: &#39;long&#39; | &#39;short&#39;;&#10;}&#10;&#10;const strategyPayoff = (legs: StrategyLeg[], spotPrice: number): number =&gt;&#10;  legs.reduce((total, leg) =&gt; total + optionPayoff(leg.option, spotPrice, leg.position), 0);&#10;&#10;const bullCallSpread: StrategyLeg[] = [&#10;  { option: { type: &#39;call&#39;, strike: 150, premium: 8, quantity: 100 }, position: &#39;long&#39; },&#10;  { option: { type: &#39;call&#39;, strike: 160, premium: 3, quantity: 100 }, position: &#39;short&#39; },&#10;];&#10;&#10;console.log(&#39;\\n牛市看涨价差收益:&#39;);&#10;[140, 145, 150, 155, 160, 165, 170].forEach((p) =&gt; {&#10;  console.log(`  股价$${p}: $${strategyPayoff(bullCallSpread, p)}`);&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> StrategyLeg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  option</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OptionContract</span><span style=\"color:#24292E;--shik