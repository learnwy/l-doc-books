style=\"color:#24292E;--shiki-dark:#E1E4E8\">    nominalGDP: Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(nominalGDP),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    realGDP: Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(realGDP),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    deflator,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    growthRate: Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(growthRate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    perCapita: Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(perCapita),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> china2023</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GDPComponents</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  consumption: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">564000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  investment: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">540000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  government: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">202000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  netExports: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">40000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> calculateGDP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(china2023, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.02</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1210000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`名义GDP: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">nominalGDP</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}亿`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`实际GDP: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">realGDP</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}亿`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`增长率: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">growthRate</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}%`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`人均GDP: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">perCapita</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}亿/亿人`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"经济增长理论\">经济增长理论</h2><p>经济增长的来源可以用索洛增长模型来理解：</p>\n<div class=\"math-block\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>Y</mi><mo>=</mo><mi>A</mi><mo>⋅</mo><mi>F</mi><mo stretchy=\"false\">(</mo><mi>K</mi><mo separator=\"true\">,</mo><mi>L</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">Y = A \\cdot F(K, L)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">Y</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\">A</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">F</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">K</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">L</span><span class=\"mclose\">)</span></span></span></span></span></div><p>其中 Y 是产出，A 是全要素生产率（TFP），K 是资本，L 是劳动。</p>\n<table>\n<thead>\n<tr>\n<th>增长来源</th>\n<th>说明</th>\n<th>技术行业贡献</th>\n<th>长期影响</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>资本积累（K）</td>\n<td>增加生产设备和基础设施</td>\n<td>数据中心、芯片工厂投资</td>\n<td>受边际收益递减限制</td>\n</tr>\n<tr>\n<td>劳动力增长（L）</td>\n<td>工作人口增加</td>\n<td>更多程序员进入市场</td>\n<td>受人口增长限制</td>\n</tr>\n<tr>\n<td>全要素生产率（A）</td>\n<td>技术进步和效率提升</td>\n<td>AI、自动化、新算法</td>\n<td>持续增长的核心驱动力</td>\n</tr>\n</tbody></table>\n<p>索洛模型的关键洞察是：仅靠资本积累无法维持长期增长（边际收益递减），技术进步（A 的提高）才是长期经济增长的根本源泉。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[技术进步] --&gt; B[TFP 提升]&#10;    B --&gt; C[产出增加]&#10;    C --&gt; D[利润增长]&#10;    D --&gt; E[研发投入增加]&#10;    E --&gt; A&#10;    D --&gt; F[资本积累]&#10;    F --&gt; G[短期增长]&#10;    G --&gt; H[边际收益递减]&#10;    H --&gt; I[增长放缓]\">graph LR\n    A[技术进步] --&gt; B[TFP 提升]\n    B --&gt; C[产出增加]\n    C --&gt; D[利润增长]\n    D --&gt; E[研发投入增加]\n    E --&gt; A\n    D --&gt; F[资本积累]\n    F --&gt; G[短期增长]\n    G --&gt; H[边际收益递减]\n    H --&gt; I[增长放缓]</pre><p>对程序员而言，这意味着：</p>\n<ul>\n<li><strong>短期看资本</strong>：VC 注资、IPO 热潮推动行业繁荣，但不可持续</li>\n<li><strong>长期看技术</strong>：AI、量子计算等突破性技术才是行业长期增长引擎</li>\n<li><strong>个人成长类比</strong>：学习新技能（提高个人 TFP）比简单加班（增加 L）更有长期价值</li>\n</ul>\n<h2 id=\"经济周期与技术行业\">经济周期与技术行业</h2><p>经济运行并非匀速增长，而是呈现周期性波动：</p>\n<table>\n<thead>\n<tr>\n<th>周期阶段</th>\n<th>特征</th>\n<th>技术行业表现</th>\n<th>程序员影响</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>扩张期</td>\n<td>GDP 持续增长</td>\n<td>VC 活跃，招聘旺盛</td>\n<td>薪资上涨，跳槽机会多</td>\n</tr>\n<tr>\n<td>峰顶</td>\n<td>增长达到最高点</td>\n<td>估值泡沫，过度投资</td>\n<td>薪资最高点，但风险累积</td>\n</tr>\n<tr>\n<td>衰退期</td>\n<td>GDP 连续两季下降</td>\n<td>裁员潮，融资困难</td>\n<td>裁员风险，求职竞争加剧</td>\n</tr>\n<tr>\n<td>谷底</td>\n<td>经济活动最低点</td>\n<td>行业出清，效率提升</td>\n<td>就业最困难，但估值便宜</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface EconomicCycle {&#10;  phase: &#39;expansion&#39; | &#39;peak&#39; | &#39;recession&#39; | &#39;trough&#39;;&#10;  gdpGrowth: number;&#10;  techImpact: string;&#10;  strategy: string;&#10;}&#10;&#10;const identifyCyclePhase = (&#10;  currentGrowth: number,&#10;  previousGrowth: number,&#10;  trend: &#39;accelerating&#39; | &#39;decelerating&#39;,&#10;): EconomicCycle =&gt; {&#10;  if (currentGrowth &gt; 2 &amp;&amp; trend === &#39;accelerating&#39;) {&#10;    return {&#10;      phase: &#39;expansion&#39;,&#10;      gdpGrowth: currentGrowth,&#10;      techImpact: &#39;IT预算增加，创业活跃&#39;,&#10;      strategy: &#39;积极投资技能，争取晋升&#39;,&#10;    };&#10;  }&#10;  if (currentGrowth &gt; 0 &amp;&amp; trend === &#39;decelerating&#39;) {&#10;    return {&#10;      phase: &#39;peak&#39;,&#10;      gdpGrowth: currentGrowth,&#10;      techImpact: &#39;估值过高，增长放缓&#39;,&#10;      strategy: &#39;储蓄现金，降低杠杆&#39;,&#10;    };&#10;  }&#10;  if (currentGrowth &lt; 0) {&#10;    return {&#10;      phase: &#39;recession&#39;,&#10;      gdpGrowth: currentGrowth,&#10;      techImpact: &#39;裁员潮，融资冻结&#39;,&#10;      strategy: &#39;稳定现有工作，提升核心技能&#39;,&#10;    };&#10;  }&#10;  return {&#10;    phase: &#39;trough&#39;,&#10;    gdpGrowth: currentGrowth,&#10;    techImpact: &#39;行业筑底，效率优先&#39;,&#10;    strategy: &#39;逆周期学习，为复苏做准备&#39;,&#10;  };&#10;};&#10;&#10;const current = identifyCyclePhase(1.5, 3.2, &#39;decelerating&#39;);&#10;console.log(`当前阶段: ${current.phase}`);&#10;console.log(`技术影响: ${current.techImpact}`);&#10;console.log(`策略建议: ${current.strategy}`);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EconomicCycle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  phase</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'expansion'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'peak'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'recession'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'trough'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  gdpGrowth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  techImpact</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  strategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> identifyCyclePhase</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  currentGrowth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  previousGrowth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  trend</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'accelerating'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'decelerating'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EconomicCycle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentGrowth </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trend </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'accelerating'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      phase: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'expansion'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark: