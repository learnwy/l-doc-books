 style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      strategy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'储蓄现金，降低杠杆'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentGrowth </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      phase: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'recession'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      gdpGrowth: currentGrowth,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      techImpact: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'裁员潮，融资冻结'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      strategy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'稳定现有工作，提升核心技能'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    phase: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'trough'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    gdpGrowth: currentGrowth,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    techImpact: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'行业筑底，效率优先'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    strategy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'逆周期学习，为复苏做准备'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> current</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> identifyCyclePhase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'decelerating'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`当前阶段: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">current</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">phase</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`技术影响: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">current</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">techImpact</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`策略建议: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">current</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">strategy</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>技术行业有自己的周期叠加在经济周期之上：互联网泡沫（2000）、移动互联网（2010-2015）、AI 浪潮（2023-）。理解大周期有助于做出更好的职业和投资决策。</p>\n<h2 id=\"gdp-的局限与替代指标\">GDP 的局限与替代指标</h2><p>GDP 虽然是最广泛使用的经济指标，但存在显著局限：</p>\n<ul>\n<li><strong>不衡量福利</strong>：GDP 增长不等于幸福增长，加班创造的 GDP 可能降低生活质量</li>\n<li><strong>忽略非市场活动</strong>：开源软件贡献巨大经济价值，但不计入 GDP</li>\n<li><strong>不反映分配</strong>：总量增长可能伴随不平等加剧</li>\n<li><strong>环境成本外部化</strong>：不扣除环境破坏的成本</li>\n</ul>\n<p>对程序员而言更实用的替代指标：</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>含义</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>技术行业增加值占 GDP 比重</td>\n<td>技术行业在经济中的分量</td>\n<td>评估行业前景</td>\n</tr>\n<tr>\n<td>IT 支出占 GDP 比重</td>\n<td>企业数字化投入程度</td>\n<td>评估市场规模</td>\n</tr>\n<tr>\n<td>研发支出占 GDP 比重</td>\n<td>创新投入强度</td>\n<td>评估创新环境</td>\n</tr>\n<tr>\n<td>风险投资总额</td>\n<td>创业生态活跃度</td>\n<td>评估创业机会</td>\n</tr>\n<tr>\n<td>开发者人口比</td>\n<td>技术人才密度</td>\n<td>评估人才竞争强度</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((GDP与经济增长))&#10;    GDP核算&#10;      支出法四部门&#10;      名义vs实际&#10;      人均GDP&#10;    增长理论&#10;      索洛模型&#10;      资本积累&#10;      全要素生产率&#10;    经济周期&#10;      四个阶段&#10;      技术行业叠加周期&#10;      逆周期策略&#10;    局限与替代&#10;      福利衡量不足&#10;      非市场活动遗漏&#10;      技术行业特定指标\">mindmap\n  root((GDP与经济增长))\n    GDP核算\n      支出法四部门\n      名义vs实际\n      人均GDP\n    增长理论\n      索洛模型\n      资本积累\n      全要素生产率\n    经济周期\n      四个阶段\n      技术行业叠加周期\n      逆周期策略\n    局限与替代\n      福利衡量不足\n      非市场活动遗漏\n      技术行业特定指标</pre><ul>\n<li>GDP 是衡量经济总量的核心指标，技术行业繁荣与 GDP 增长高度正相关</li>\n<li>支出法将 GDP 分为消费、投资、政府支出和净出口四部分，IT 投资是投资的重要组成</li>\n<li>索洛模型揭示技术进步是长期增长的根本驱动力，资本积累受边际递减限制</li>\n<li>经济周期的不同阶段需要不同的职业和投资策略，理解周期是做好长期规划的基础</li>\n<li>GDP 有局限性，程序员应结合技术行业特定指标做更精准的市场判断</li>\n</ul>\n","headings":[{"level":1,"text":"GDP 与经济增长","id":"gdp-与经济增长"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"GDP 核算方法与构成","id":"gdp-核算方法与构成"},{"level":2,"text":"经济增长理论","id":"经济增长理论"},{"level":2,"text":"经济周期与技术行业","id":"经济周期与技术行业"},{"level":2,"text":"GDP 的局限与替代指标","id":"gdp-的局限与替代指标"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"消费者理论","url":"/l-doc-books/h/economics-finance/economics-thinking/microeconomics/consumer-theory"},"next":{"title":"通货膨胀与货币政策","url":"/l-doc-books/h/economics-finance/economics-thinking/macroeconomics/inflation-and-monetary-policy"}}