e=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`支出: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">policy</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">spendingAction</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`科技影响: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">policy</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">techImpact</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>政策类型</th>\n<th>时滞</th>\n<th>精准度</th>\n<th>政治约束</th>\n<th>效果持续性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>自动稳定器</td>\n<td>无</td>\n<td>低</td>\n<td>低</td>\n<td>持续</td>\n</tr>\n<tr>\n<td>减税</td>\n<td>中等</td>\n<td>中</td>\n<td>高</td>\n<td>暂时</td>\n</tr>\n<tr>\n<td>增加转移支付</td>\n<td>短</td>\n<td>中</td>\n<td>中</td>\n<td>暂时</td>\n</tr>\n<tr>\n<td>公共投资</td>\n<td>长</td>\n<td>高</td>\n<td>高</td>\n<td>长期</td>\n</tr>\n</tbody></table>\n<h2 id=\"政府债务与财政可持续性\">政府债务与财政可持续性</h2><p>持续的财政赤字会积累政府债务。债务本身并非必然有害，关键在于债务的增长是否可持续——债务占 GDP 的比率是否稳定。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[财政赤字] --&gt; B[发行国债融资]&#10;    B --&gt; C[政府债务累积]&#10;    C --&gt; D{债务可持续性}&#10;    D --&gt;|利率&lt;增长率| E[债务比可控]&#10;    D --&gt;|利率&gt;增长率| F[债务螺旋风险]&#10;    F --&gt; G[增税或削支]&#10;    F --&gt; H[货币化/通胀]&#10;    F --&gt; I[债务违约]\">graph LR\n    A[财政赤字] --&gt; B[发行国债融资]\n    B --&gt; C[政府债务累积]\n    C --&gt; D{债务可持续性}\n    D --&gt;|利率&lt;增长率| E[债务比可控]\n    D --&gt;|利率&gt;增长率| F[债务螺旋风险]\n    F --&gt; G[增税或削支]\n    F --&gt; H[货币化/通胀]\n    F --&gt; I[债务违约]</pre><p><strong>债务动态方程</strong>：债务占 GDP 比率的变化取决于三个因素：</p>\n<ul>\n<li><strong>基本财政盈余</strong>：税收减去非利息支出</li>\n<li><strong>利率-增长率差</strong>：实际利率与 GDP 增长率之差（r - g）</li>\n<li><strong>初始债务水平</strong>：债务存量越大，利息负担越重</li>\n</ul>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DebtDynamics {&#10;  debtToGDP: number;&#10;  interestRate: number;&#10;  growthRate: number;&#10;  primaryBalance: number;&#10;}&#10;&#10;const projectDebt = (&#10;  initial: DebtDynamics,&#10;  years: number,&#10;): Array&lt;{ year: number; debtToGDP: number; sustainable: boolean }&gt; =&gt; {&#10;  const projections: Array&lt;{ year: number; debtToGDP: number; sustainable: boolean }&gt; = [];&#10;  let currentDebt = initial.debtToGDP;&#10;&#10;  for (let y = 1; y &lt;= years; y++) {&#10;    const interestCost = currentDebt * (initial.interestRate - initial.growthRate);&#10;    currentDebt = currentDebt + interestCost - initial.primaryBalance;&#10;    projections.push({&#10;      year: y,&#10;      debtToGDP: Math.round(currentDebt * 10) / 10,&#10;      sustainable: currentDebt &lt; 120,&#10;    });&#10;  }&#10;&#10;  return projections;&#10;};&#10;&#10;const scenario: DebtDynamics = {&#10;  debtToGDP: 80,&#10;  interestRate: 0.04,&#10;  growthRate: 0.03,&#10;  primaryBalance: -2,&#10;};&#10;&#10;const projection = projectDebt(scenario, 10);&#10;projection.forEach((p) =&gt; {&#10;  console.log(`第${p.year}年: 债务/GDP=${p.debtToGDP}%, ${p.sustainable ? &#39;可持续&#39; : &#39;需警惕&#39;}`);&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color: