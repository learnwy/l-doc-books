tyle=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { recommendation, reasoning };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> legacyRewrite</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProjectDecision</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  projectName: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'旧系统重写'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sunkCost: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  futureCostIfContinue: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">800000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  futureValueIfContinue: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">600000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  futureCostIfAbandon: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  futureValueIfAbandon: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> decision</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> rationalDecision</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(legacyRewrite);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">legacyRewrite</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">projectName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">decision</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">recommendation</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(decision.reasoning);</span></span></code></pre></div><h2 id=\"可得性偏差与风险评估\">可得性偏差与风险评估</h2><p>可得性偏差导致人们根据容易想到的例子来估计事件的频率和概率。越生动、越近期的事件在记忆中越&quot;可得&quot;，会导致高估其发生概率。</p>\n<p>在技术领域：</p>\n<ul>\n<li>最近发生的安全事件导致过度投资安全（忽略其他风险）</li>\n<li>媒体报道的技术趋势让人高估其成熟度</li>\n<li>个人经历中遇到的bug类型会被认为更常见</li>\n</ul>\n<p>对抗可得性偏差需要用数据替代直觉——建立指标体系、定期审查数据、基于统计而非印象做决策。</p>\n<table>\n<thead>\n<tr>\n<th>偏差表现</th>\n<th>直觉判断</th>\n<th>数据驱动判断</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>&quot;最近hack事件很多&quot;</td>\n<td>安全预算翻倍</td>\n<td>查看实际攻击频率和影响趋势</td>\n</tr>\n<tr>\n<td>&quot;AI会替代所有程序员&quot;</td>\n<td>恐慌转行</td>\n<td>分析具体哪些任务可被替代</td>\n</tr>\n<tr>\n<td>&quot;我们的系统经常宕机&quot;</td>\n<td>全面重构</td>\n<td>分析MTBF和实际停机时间</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((认知偏差))&#10;    锚定效应&#10;      估算偏差&#10;      薪资谈判&#10;      三点估算法&#10;    确认偏差&#10;      选择性信息&#10;      技术选型固化&#10;      红队思维&#10;    沉没成本&#10;      项目管理陷阱&#10;      理性弃止&#10;      Kill Switch&#10;    可得性偏差&#10;      风险高估&#10;      媒体影响&#10;      数据驱动&#10;    系统性对策&#10;      双系统意识&#10;      决策日志&#10;      预验尸法\">mindmap\n  root((认知偏差))\n    锚定效应\n      估算偏差\n      薪资谈判\n      三点估算法\n    确认偏差\n      选择性信息\n      技术选型固化\n      红队思维\n    沉没成本\n      项目管理陷阱\n      理性弃止\n      Kill Switch\n    可得性偏差\n      风险高估\n      媒体影响\n      数据驱动\n    系统性对策\n      双系统意识\n      决策日志\n      预验尸法</pre><ul>\n<li>认知偏差是可预测的系统性思维偏差，源于快速直觉系统的过度使用</li>\n<li>锚定效应导致估算偏差，对抗方法是使用多种独立估算方法交叉验证</li>\n<li>确认偏差使技术决策固化，需要红队思维和预验尸法来对抗</li>\n<li>沉没成本谬误是项目管理中最昂贵的偏差，理性决策只考虑未来成本和收益</li>\n<li>可得性偏差导致风险评估失真，数据驱动决策是最有效的对策</li>\n</ul>\n","headings":[{"level":1,"text":"认知偏差","id":"认知偏差"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"锚定效应与估算偏差","id":"锚定效应与估算偏差"},{"level":2,"text":"确认偏差与技术决策","id":"确认偏差与技术决策"},{"level":2,"text":"沉没成本谬误与项目管理","id":"沉没成本谬误与项目管理"},{"level":2,"text":"可得性偏差与风险评估","id":"可得性偏差与风险评估"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"不确定性下的决策","url":"/l-doc-books/h/economics-finance/economics-thinking/game-theory/decision-under-uncertainty"},"next":{"title":"前景理论","url":"/l-doc-books/h/economics-finance/economics-thinking/behavioral-economics/prospect-theory"}}