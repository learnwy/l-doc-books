ark:#B392F0\">forEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">tech</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}: 优劣比=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proConRatio</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}, ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">biasWarning</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>对抗确认偏差的方法：</p>\n<ul>\n<li><strong>红队思维</strong>：指定团队成员专门寻找和论证反面观点</li>\n<li><strong>预验尸法</strong>（Pre-mortem）：假设项目已失败，倒推可能的原因</li>\n<li><strong>决策日志</strong>：记录决策时的假设和预期，事后对比验证</li>\n<li><strong>多元信息源</strong>：刻意阅读不同立场的技术文章和评测</li>\n</ul>\n<h2 id=\"沉没成本谬误与项目管理\">沉没成本谬误与项目管理</h2><p>沉没成本谬误是指因为已经投入了不可收回的成本而继续投入资源，即使理性分析显示应该停止。在软件开发中，这是最常见也最昂贵的偏差之一。</p>\n<table>\n<thead>\n<tr>\n<th>沉没成本陷阱</th>\n<th>表现</th>\n<th>理性替代</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>&quot;我们已经写了5万行代码&quot;</td>\n<td>不愿放弃已有代码重构</td>\n<td>只评估重写vs维护的未来成本</td>\n</tr>\n<tr>\n<td>&quot;我们已经用了2年这个框架&quot;</td>\n<td>不愿迁移到更好的技术</td>\n<td>评估迁移收益vs继续使用成本</td>\n</tr>\n<tr>\n<td>&quot;我们已经在这个方向投入了3个月&quot;</td>\n<td>不愿承认方向错误</td>\n<td>Kill switch：预设放弃条件</td>\n</tr>\n<tr>\n<td>&quot;我们已经雇了专门的团队&quot;</td>\n<td>因团队存在而维持项目</td>\n<td>人员可以重新分配</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ProjectDecision {&#10;  projectName: string;&#10;  sunkCost: number;&#10;  futureCostIfContinue: number;&#10;  futureValueIfContinue: number;&#10;  futureCostIfAbandon: number;&#10;  futureValueIfAbandon: number;&#10;}&#10;&#10;const rationalDecision = (project: ProjectDecision): { recommendation: &#39;continue&#39; | &#39;abandon&#39;; reasoning: string } =&gt; {&#10;  const netContinue = project.futureValueIfContinue - project.futureCostIfContinue;&#10;  const netAbandon = project.futureValueIfAbandon - project.futureCostIfAbandon;&#10;&#10;  const recommendation = netContinue &gt; netAbandon ? &#39;continue&#39; : &#39;abandon&#39;;&#10;  const reasoning = `继续净值: ¥${netContinue}, 放弃净值: ¥${netAbandon}（沉没成本¥${project.sunkCost}不纳入考量）`;&#10;&#10;  return { recommendation, reasoning };&#10;};&#10;&#10;const legacyRewrite: ProjectDecision = {&#10;  projectName: &#39;旧系统重写&#39;,&#10;  sunkCost: 500000,&#10;  futureCostIfContinue: 800000,&#10;  futureValueIfContinue: 600000,&#10;  futureCostIfAbandon: 200000,&#10;  futureValueIfAbandon: 300000,&#10;};&#10;&#10;const decision = rationalDecision(legacyRewrite);&#10;console.log(`${legacyRewrite.projectName}: ${decision.recommendation}`);&#10;console.log(decision.reasoning);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Pro