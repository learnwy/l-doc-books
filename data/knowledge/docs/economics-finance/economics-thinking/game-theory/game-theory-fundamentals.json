shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> other</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> strategies) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> other) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> opponentStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> strategies) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (matrix[s][opponentStrategy].player1 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matrix[other][opponentStrategy].player1) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          dominant </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dominant) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dominant) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> strategies</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Strategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cooperate'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'defect'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dominant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> findDominantStrategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prisonersDilemma, strategies);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`占优策略: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dominant</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>在技术行业中的囚徒困境：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>合作</th>\n<th>背叛</th>\n<th>现实结果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>定价战</td>\n<td>维持高价</td>\n<td>降价抢客</td>\n<td>往往陷入价格战</td>\n</tr>\n<tr>\n<td>开源贡献</td>\n<td>贡献代码</td>\n<td>只使用不贡献</td>\n<td>搭便车问题</td>\n</tr>\n<tr>\n<td>技术标准</td>\n<td>采用共同标准</td>\n<td>推自己的标准</td>\n<td>标准碎片化</td>\n</tr>\n<tr>\n<td>数据共享</td>\n<td>共享数据</td>\n<td>独占数据</td>\n<td>数据孤岛</td>\n</tr>\n</tbody></table>\n<p><strong>协调博弈</strong>：两方都希望协调行动，但不确定该协调到哪个选项。典型案例是技术标准选择——VHS vs Beta、Blu-ray vs HD-DVD。</p>\n<p><strong>鹰鸽博弈</strong>：竞争中选择激进（鹰）还是温和（鸽）策略。创业公司选择烧钱扩张还是稳健经营就是鹰鸽博弈。</p>\n<h2 id=\"重复博弈与合作演化\">重复博弈与合作演化</h2><p>单次博弈中背叛是理性的，但在重复博弈中，合作可以维持。这解释了为什么长期合作关系中诚信比短期投机更有价值。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[单次博弈] --&gt; B[背叛是最优]&#10;    C[重复博弈] --&gt; D[合作可以维持]&#10;    D --&gt; E[未来的影子]&#10;    E --&gt; F[折现因子δ足够大]&#10;    F --&gt; G[以牙还牙策略]&#10;    G --&gt; H[长期均衡合作]\">graph LR\n    A[单次博弈] --&gt; B[背叛是最优]\n    C[重复博弈] --&gt; D[合作可以维持]\n    D --&gt; E[未来的影子]\n    E --&gt; F[折现因子δ足够大]\n    F --&gt; G[以牙还牙策略]\n    G --&gt; H[长期均衡合作]</pre><p><strong>以牙还牙（Tit-for-Tat）策略</strong>：</p>\n<ol>\n<li>第一轮选择合作</li>\n<li>之后模仿对手上一轮的选择</li>\n</ol>\n<p>这个简单策略在阿克塞尔罗德的计算机锦标赛中胜出，它兼具善良（先合作）、可报复（惩罚背叛）、可宽恕（对手回到合作即恢复合作）和清晰（策略易被理解）四个特性。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const titForTat = (opponentHistory: Strategy[]): Strategy =&gt; {&#10;  if (opponentHistory.length === 0) return &#39;cooperate&#39;;&#10;  return opponentHistory[opponentHistory.length - 1];&#10;};&#10;&#10;const simulateRepeatedGame = (&#10;  strategy1: (history: Strategy[]) =&gt; Strategy,&#10;  strategy2: (history: Strategy[]) =&gt; Strategy,&#10;  matrix: PayoffMatrix,&#10;  rounds: number,&#10;): { total1: number; total2: number; cooperationRate: number } =&gt; {&#10;  const history1: Strategy[] = [];&#10;  const history2: Strategy[] = [];&#10;  let total1 = 0;&#10;  let total2 = 0;&#10;  let cooperations = 0;&#10;&#10;  for (let r = 0; r &lt; rounds; r++) {&#10;    const s1 = strategy1(history2);&#10;    const s2 = strategy2(history1);&#10;    const payoff = matrix[s1][s2];&#10;    total1 += payoff.player1;&#10;    total2 += payoff.player2;&#10;    if (s1 === &#39;cooperate&#39; &amp;&amp; s2 === &#39;cooperate&#39;) cooperations++;&#10;    history1.push(s1);&#10;    history2.push(s2);&#10;  }&#10;&#10;  return {&#10;    total1,&#10;    total2,&#10;    cooperationRate: cooperations / rounds,&#10;  };&#10;};&#10;&#10;const alwaysDefect = (_: Strategy[]): Strategy =&gt; &#39;defect&#39;;&#10;const result1 = simulateRepeatedGame(titForTat, titForTat, prisonersDilemma, 100);&#10;console.log(`TFT vs TFT: 合作率=${result1.cooperationRate}`);&#10;&#10;const result2 = simulateRepeatedGame(titForTat, alwaysDefect, prisonersDilemma, 100);&#10;console.log(`TFT vs 始终背叛: 合作率=${result2.cooperationRate}`);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> titForTat</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">opponentHistory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Strategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Strategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (opponentHistory.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'cooperate'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> opponentHistory[opponentHistory.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -