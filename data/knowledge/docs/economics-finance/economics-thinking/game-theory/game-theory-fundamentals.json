=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.effectiveness </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.cost </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.effectiveness </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.cost);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">sorted.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">forEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> roi</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (s.effectiveness </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s.cost).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">type</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}: 效果=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">effectiveness</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}, 成本=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">cost</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}, ROI=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">roi</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>有效信号必须具备&quot;成本差异&quot;——高能力者发送信号的成本低于低能力者，否则信号就无法区分不同类型的发送者。开源贡献是很好的信号，因为高水平程序员更容易产出高质量的开源项目。</p>\n<h2 id=\"博弈论在技术决策中的应用\">博弈论在技术决策中的应用</h2><p>博弈论框架可以帮助分析多种技术决策场景：</p>\n<p><strong>平台策略</strong>：平台通过补贴一端用户来吸引另一端，形成网络效应。这是一个典型的多阶段博弈——前期亏损是为了建立垄断优势。</p>\n<p><strong>API 定价</strong>：提供 API 服务时，免费层级是&quot;合作&quot;的信号，吸引开发者生态；收费层级才是利润来源。定价过早或过高可能失去开发者信任。</p>\n<p><strong>技术债务博弈</strong>：短期赶功能（背叛未来的自己）vs 长期投资代码质量（合作），本质上是自我博弈中的时间不一致问题。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((博弈论基础))&#10;    基本框架&#10;      参与者与策略&#10;      收益矩阵&#10;      均衡概念&#10;    经典博弈&#10;      囚徒困境&#10;      协调博弈&#10;      鹰鸽博弈&#10;    重复博弈&#10;      以牙还牙&#10;      合作演化&#10;      声誉机制&#10;    信息博弈&#10;      逆向选择&#10;      道德风险&#10;      信号发送&#10;    技术应用&#10;      平台策略&#10;      API定价&#10;      技术债务\">mindmap\n  root((博弈论基础))\n    基本框架\n      参与者与策略\n      收益矩阵\n      均衡概念\n    经典博弈\n      囚徒困境\n      协调博弈\n      鹰鸽博弈\n    重复博弈\n      以牙还牙\n      合作演化\n      声誉机制\n    信息博弈\n      逆向选择\n      道德风险\n      信号发送\n    技术应用\n      平台策略\n      API定价\n      技术债务</pre><ul>\n<li>博弈论提供了分析策略互动的严格框架，核心是&quot;换位思考&quot;</li>\n<li>囚徒困境解释了理性个体导致集体次优的困境，广泛存在于定价战、标准竞争等场景</li>\n<li>重复博弈中合作可以维持——声誉和长期关系是合作的基础</li>\n<li>信息不对称导致逆向选择和道德风险，信号机制帮助解决信息问题</li>\n<li>博弈论思维帮助程序员在平台策略、定价设计和职业规划中做出更优决策</li>\n</ul>\n","headings":[{"level":1,"text":"博弈论基础","id":"博弈论基础"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"经典博弈模型","id":"经典博弈模型"},{"level":2,"text":"重复博弈与合作演化","id":"重复博弈与合作演化"},{"level":2,"text":"信息不对称与信号博弈","id":"信息不对称与信号博弈"},{"level":2,"text":"博弈论在技术决策中的应用","id":"博弈论在技术决策中的应用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"国际贸易","url":"/l-doc-books/h/economics-finance/economics-thinking/macroeconomics/international-trade"},"next":{"title":"纳什均衡","url":"/l-doc-books/h/economics-finance/economics-thinking/game-theory/nash-equilibrium"}}