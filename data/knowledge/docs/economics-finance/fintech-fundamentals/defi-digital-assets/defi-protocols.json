 style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildYieldStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  principal</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  actions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ComposableAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">): {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  steps: string[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  estimatedAPY: number;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  risks: string[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> steps</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}. ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">a</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">protocol</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">a</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">action</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">a</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">tokenIn</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} → ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">a</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">tokenOut</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> estimatedAPY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">apy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> protocolAPY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getProtocolBaseAPY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(action.protocol, action.action);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> apy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> protocolAPY;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> risks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '智能合约风险：任一协议的漏洞可能影响整个策略'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '清算风险：抵押品价值下跌可能触发强制清算'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '协议依赖风险：上游协议变更可能中断策略'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '预言机风险：价格数据异常可能导致异常操作'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { steps, estimatedAPY, risks };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getProtocolBaseAPY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">protocol</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">action</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> apyMap</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    lido: { stake: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    aave: { supply: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, borrow: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    curve: { provide_liquidity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    convex: { stake_lp: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> apyMap[protocol.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()]?.[action] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProtocolInteraction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  target</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  calldata</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> encodeMulticall</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">interactions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProtocolInteraction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> interactions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">target</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">calldata</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">value</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'|'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>可组合性带来了巨大的创新空间，但也引入了<strong>系统性风险</strong>——当底层协议出问题时，所有依赖它的上层协议都会受到影响，这就是所谓的&quot;DeFi 传染效应&quot;。</p>\n<h2 id=\"稳定币机制\">稳定币机制</h2><p>稳定币是 DeFi 生态的基石，提供了与法定货币挂钩的价值锚定。根据稳定机制的不同，稳定币分为三大类：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[稳定币分类] --&gt; B[法币抵押型]&#10;    A --&gt; C[加密资产抵押型]&#10;    A --&gt; D[算法型]&#10;    B --&gt; B1[USDC Circle]&#10;    B --&gt; B2[USDT Tether]&#10;    C --&gt; C1[DAI MakerDAO]&#10;    C --&gt; C2[LUSD Liquity]&#10;    D --&gt; D1[FRAX 混合型]&#10;    D --&gt; D2[UST 已崩溃]\">graph TD\n    A[稳定币分类] --&gt; B[法币抵押型]\n    A --&gt; C[加密资产抵押型]\n    A --&gt; D[算法型]\n    B --&gt; B1[USDC Circle]\n    B --&gt; B2[USDT Tether]\n    C --&gt; C1[DAI MakerDAO]\n    C --&gt; C2[LUSD Liquity]\n    D --&gt; D1[FRAX 混合型]\n    D --&gt; D2[UST 已崩溃]</pre><table>\n<thead>\n<tr>\n<th>稳定币类型</th>\n<th>代表</th>\n<th>锚定机制</th>\n<th>去中心化程度</th>\n<th>资本效率</th>\n<th>风险</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>法币抵押</td>\n<td>USDC</td>\n<td>1:1 美元储备</td>\n<td>低（中心化发行）</td>\n<td>1:1</td>\n<td>监管/冻结风险</td>\n</tr>\n<tr>\n<td>超额抵押</td>\n<td>DAI</td>\n<td>加密资产超额抵押</td>\n<td>高</td>\n<td>&lt;1:1（约 150%）</td>\n<td>清算/脱锚风险</td>\n</tr>\n<tr>\n<td>算法稳定</td>\n<td>FRAX</td>\n<td>算法+部分抵押</td>\n<td>高</td>\n<td>接近 1:1</td>\n<td>死亡螺旋风险</td>\n</tr>\n</tbody></table>\n<p>MakerDAO 的 DAI 是最经典的去中心化稳定币：用户将 ETH 等加密资产超额抵押（至少 150%）到智能合约中，铸造出 DAI。当抵押率低于清算线时，系统自动清算抵押品以维持 DAI 的价值锚定。</p>\n<div class=\"code-block-wrapper\" data-lang=\"solidity\" data-code=\"// SPDX-License-Identifier: MIT&#10;pragma solidity ^0.8.20;&#10;&#10;interface IPriceOracle {&#10;    function getPrice(address token) external view returns (uint256);&#10;}&#10;&#10;contract SimpleCDP {&#10;    IPriceOracle public immutable oracle;&#10;    address public immutable collateralToken;&#10;&#10;    uint256 public constant LIQUIDATION_RATIO = 150;&#10;    uint256 public constant LIQUIDATION_PENALTY = 13;&#10;    uint256 public constant STABILITY_FEE_BPS = 50;&#10;&#10;    struct Vault {&#10;        uint256 collateral;&#10;        uint256 debt;&#10;        uint256 lastUpdate;&#10;    }&#10;&#10;    mapping(address =&gt; Vault) public vaults;&#10;    uint256 public totalDebt;&#10;&#10;    event VaultOpened(address indexed owner, uint256 collateral, uint256 debt);&#10;    event VaultLiquidated(address indexed owner, address indexed liquidator, uint256 debt);&#10;&#10;    constructor(address _oracle, address _collateralToken) {&#10;        oracle = IPriceOracle(_oracle);&#10;        collateralToken = _collateralToken;&#10;    }&#10;&#10;    function getCollateralRatio(address owner) public view returns (uint256) {&#10;        Vault storage v = vaults[owner];&#10;        if (v.debt == 0) return type(uint256).max;&#10;&#10;        uint256 price = oracle.getPrice(collateralToken);&#10;        uint256 collateralValue = v.collateral * price / 1e18;&#10;&#10;        return collateralValue * 100 / v.debt;&#10;    }&#10;&#10;    function isLiquidatable(address owner) public view returns (bool) {&#10;        return getCollateralRatio(owner) &lt; LIQUIDATION_RATIO;&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// SPDX-License-Identifier: MIT</span></span>\n<span class=\"line\"><span>pragma solidity ^0.8.20;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>interface IPriceOracle {</span></span>\n<span class=\"line\"><span>    function getPrice(address token) external view returns (uint256);</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>contract SimpleCDP {</span></span>\n<span class=\"line\"><span>    IPriceOracle public immutable oracle;</span></span>\n<span class=\"line\"><span>    address public immutable collateralToken;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    uint256 public constant LIQUIDATION_RATIO = 150;</span></span>\n<span class=\"line\"><span>    uint256 public constant LIQUIDATION_PENALTY = 13;</span></span>\n<span class=\"line\"><span>    uint256 public constant STABILITY_FEE_BPS = 50;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    struct Vault {</span></span>\n<span class=\"line\"><span>        uint256 collateral;</span></span>\n<span class=\"line\"><span>        uint256 debt;</span></span>\n<span class=\"line\"><span>        uint256 lastUpdate;</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    mapping(address => Vault) public vaults;</span></span>\n<span class=\"line\"><span>    uint256 public totalDebt;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    event VaultOpened(address indexed owner, uint256 collateral, uint256 debt);</span></span>\n<span class=\"line\"><span>    event VaultLiquidated(address indexed owner, address indexed liquidator, uint256 debt);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    constructor(address _oracle, address _collateralToken) {</span></span>\n<span class=\"line\"><span>        oracle = IPriceOracle(_oracle);</span></span>\n<span class=\"line\"><span>        collateralToken = _collateralToken;</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    function getCollateralRatio(address owner) public view returns (uint256) {</span></span>\n<span class=\"line\"><span>        Vault storage v = vaults[owner];</span></span>\n<span class=\"line\"><span>        if (v.debt == 0) return type(uint256).max;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        uint256 price = oracle.getPrice(collateralToken);</span></span>\n<span class=\"line\"><span>        uint256 collateralValue = v.collateral * price / 1e18;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        return collateralValue * 100 / v.debt;</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    function isLiquidatable(address owner) public view returns (bool) {</span></span>\n<span class=\"line\"><span>        return getCollateralRatio(owner) &#x3C; LIQUIDATION_RATIO;</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"预言机与外部数据\">预言机与外部数据</h2><p>DeFi 协议需要获取链外的价格数据来执行清算、交易和风控等操作，预言机（Oracle）是连接链上合约与链外世界的桥梁。Chainlink 是最广泛使用的去中心化预言机网络，通过多个独立数据源和节点运营商的聚合来保证数据质量。</p>\n<table>\n<thead>\n<tr>\n<th>预言机方案</th>\n<th>数据源</th>\n<th>更新频率</th>\n<th>抗操纵性</th>\n<th>代表项目</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Chainlink</td>\n<td>多源聚合</td>\n<td>心跳 + 偏差触发</td>\n<td>高</td>\n<td>Aave、Compound</td>\n</tr>\n<tr>\n<td>Uniswap TWAP</td>\n<td>链上 DEX 价格</td>\n<td>每区块</td>\n<td>中（需大量资金操纵）</td>\n<td>Euler</td>\n</tr>\n<tr>\n<td>Pyth Network</td>\n<td>一手数据提供者</td>\n<td>亚秒级</td>\n<td>高</td>\n<td>Solana 生态</td>\n</tr>\n<tr>\n<td>Redstone</td>\n<td>按需拉取</td>\n<td>按需</td>\n<td>中</td>\n<td>新兴协议</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PriceFeed {&#10;  pair: string;&#10;  price: bigint;&#10;  decimals: number;&#10;  timestamp: number;&#10;  source: string;&#10;}&#10;&#10;interface TWAPConfig {&#10;  windowSize: number;&#10;  maxDeviation: number;&#10;}&#10;&#10;const calculateTWAP = (observations: Array&lt;{ price: bigint; timestamp: number }&gt;, config: TWAPConfig): bigint =&gt; {&#10;  const now = Math.floor(Date.now() / 1000);&#10;  const windowStart = now - config.windowSize;&#10;&#10;  const relevant = observations.filter((o) =&gt; o.timestamp &gt;= windowStart);&#10;  if (relevant.length === 0) throw new Error(&#39;No observations in window&#39;);&#10;&#10;  let weightedSum = 0n;&#10;  let totalWeight = 0n;&#10;&#10;  for (let i = 1; i &lt; relevant.length; i++) {&#10;    const duration = BigInt(relevant[i].timestamp - relevant[i - 1].timestamp);&#10;    weightedSum += relevant[i - 1].price * duration;&#10;    totalWeight += duration;&#10;  }&#10;&#10;  if (totalWeight === 0n) return relevant[0].price;&#10;  return weightedSum / totalWeight;&#10;};&#10;&#10;const validatePriceDeviation = (spotPrice: bigint, twapPrice: bigint, maxDeviationBps: number): boolean =&gt; {&#10;  const diff = spotPrice &gt; twapPrice ? spotPrice - twapPrice : twapPrice - spotPrice;&#10;&#10;  const maxDiff = (twapPrice * BigInt(maxDeviationBps)) / 10000n;&#10;  return diff &lt;= maxDiff;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PriceFeed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style