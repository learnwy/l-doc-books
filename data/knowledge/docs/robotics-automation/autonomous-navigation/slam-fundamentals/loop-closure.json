<span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">                self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.build(child_desc, level </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, child_id)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, descriptors):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        bow_vector </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> desc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> descriptors:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            word_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._descend(desc, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            bow_vector[word_id] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bow_vector.get(word_id, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bow_vector</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> _descend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, descriptor, node_id):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        node </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.nodes.get(node_id)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">is</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> or</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node.get(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'leaf'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node_id</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        centers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'centers'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        dists </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.linalg.norm(centers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> descriptor, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">axis</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        best </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.argmin(dists)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        child_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.branch_factor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> best </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._descend(descriptor, child_id)</span></span></code></pre></div><p>TF-IDF 加权在 BoW 回环检测中至关重要。TF（词频）衡量某个视觉单词在当前图像中的出现频率，IDF（逆文档频率）衡量该单词在所有图像中的区分度。高频且低区分度的单词（如地面纹理）权重被降低，而稀有且有辨识力的单词（如独特标志物）权重被提升。</p>\n<p>DBoW2/DBoW3 库是 SLAM 社区广泛使用的实现，ORB-SLAM 系列正是基于 DBoW2 进行回环检测。它引入了直接索引（Direct Index）和逆向索引（Inverse Index）双重索引结构：逆向索引用于快速检索相似图像，直接索引用于加速特征匹配的几何验证。</p>\n<h2 id=\"基于学习的场景识别\">基于学习的场景识别</h2><p>近年来，深度学习方法在场景识别领域展现出超越传统 BoW 的性能，尤其在外观变化剧烈的场景下（光照变化、季节变化、视角变化）。</p>\n<p>NetVLAD 是一种端到端的场景识别网络，它将 VLAD（Vector of Locally Aggregated Descriptors）编码过程嵌入到 CNN 中，通过可微的软分配替代硬分配，实现端到端训练。其架构包括 CNN 特征提取骨干网（如 VGG-16）和 NetVLAD 聚合层，输出一个紧凑的全局描述子。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;import torch.nn as nn&#10;import torch.nn.functional as F&#10;&#10;class NetVLADLayer(nn.Module):&#10;    def __init__(self, feature_dim, num_clusters=64):&#10;        super().__init__()&#10;        self.num_clusters = num_clusters&#10;        self.conv = nn.Conv2d(feature_dim, num_clusters, kernel_size=1, bias=True)&#10;        self.centroids = nn.Parameter(torch.randn(num_clusters, feature_dim))&#10;&#10;    def forward(self, x):&#10;        N, C, H, W = x.shape&#10;        soft_assign = self.conv(x)&#10;        soft_assign = F.softmax(soft_assign.view(N, self.num_clusters, -1), dim=2)&#10;&#10;        x_flat = x.view(N, C, -1)&#10;        vlad = torch.zeros(N, self.num_clusters, C, device=x.device)&#10;&#10;        for k in range(self.num_clusters):&#10;            residual = x_flat - self.centroids[k].unsqueeze(0).unsqueeze(2)&#10;            weighted = soft_assign[:, k:k+1, :] * residual&#10;            vlad[:, k, :] = weighted.sum(dim=2)&#10;&#10;        vlad = F.normalize(vlad.view(N, -1), p=2, dim=1)&#10;        return vlad\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.nn.functional </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NetVLADLayer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Module</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, feature_dim, num_clusters</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        super</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">__init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_clusters </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> num_clusters</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.Conv2d(feature_dim, num_clusters, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">kernel_size</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">bias</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.centroids </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.Parameter(torch.randn(num_clusters, feature_dim))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        N, C, H, W </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x.shape</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        soft_assign </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv(x)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        soft_assign </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F.softmax(soft_assign.view(N, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_clusters, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x_flat </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x.view(N, C, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        vlad </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.zeros(N, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_clusters, C, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">device</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">x.device)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> k </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.num_clusters):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            residual </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x_flat </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.centroids[k].unsqueeze(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).unsqueeze(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            weighted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> soft_assign[:, k:k</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, :] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> residual</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            vlad[:, k, :] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> weighted.sum(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        vlad </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> F.normalize(vlad.view(N, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dim</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vlad</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>特征类型</th>\n<th>光照鲁棒</th>\n<th>季节鲁棒</th>\n<th>实时性</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DBoW2/DBoW3</td>\n<td>局部特征（ORB）</td>\n<td>中</td>\n<td>低</td>\n<td>高（ms级）</td>\n<td>短期、室内</td>\n</tr>\n<tr>\n<td>NetVLAD</td>\n<td>CNN全局特征</td>\n<td>高</td>\n<td>中</td>\n<td>中（50ms）</td>\n<td>大规模城市</td>\n</tr>\n<tr>\n<td>Patch-NetVLAD</td>\n<td>局部+全局</td>\n<td>高</td>\n<td>高</td>\n<td>中</td>\n<td>多季节变化</td>\n</tr>\n<tr>\n<td>SuperGlue+VLAD</td>\n<td>学习型匹配</td>\n<td>高</td>\n<td>高</td>\n<td>低（100ms+）</td>\n<td>高精度要求</td>\n</tr>\n<tr>\n<td>PointNetVLAD</td>\n<td>3D点云</td>\n<td>免疫</td>\n<td>免疫</td>\n<td>中</td>\n<td>LiDAR场景</td>\n</tr>\n</tbody></table>\n<p>SuperPoint + SuperGlue 的组合在特征匹配阶段提供了更强的鲁棒性，可作为几何验证的替代方案。PointNetVLAD 则将 NetVLAD 思想扩展到 3D 点云域，直接在点云上进行场景识别，完全不受光照和外观变化影响。</p>\n<h2 id=\"几何验证与一致性检查\">几何验证与一致性检查</h2><p>候选回环仅通过外观相似性筛选是不够的，必须经过严格的几何验证才能被接受。错误的回环（False Positive）会向图优化注入错误约束，导致地图严重扭曲甚至崩溃，因此几何验证是回环检测的安全屏障。</p>\n<p>几何验证的标准流程包括三个步骤：</p>\n<p>第一步是特征匹配。在候选回环帧对之间进行特征匹配，获取初始匹配点对集合。使用互最近邻（Mutual Nearest Neighbor）策略并加上比率检验（Lowe&#39;s Ratio Test）可以过滤大量错误匹配。</p>\n<p>第二步是 RANSAC 几何估计。对匹配点对使用 RANSAC 算法估计基础矩阵或本质矩阵。如果内点数量超过阈值，则认为几何验证通过。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import cv2&#10;import numpy as np&#10;&#10;def geometric_verification(kp1, kp2, matches, min_inliers=30):&#10;    pts1 = np.float32([kp1[m.queryIdx].pt for m in matches])&#10;    pts2 = np.float32([kp2[m.trainIdx].pt for m in matches])&#10;&#10;    if len(pts1) &lt; 8:&#10;        return False, None, 0&#10;&#10;    F, mask = cv2.findFundamentalMat(pts1, pts2, cv2.FM_RANSAC, 3.0, 0.99)&#10;&#10;    if mask is None:&#10;        return False, None, 0&#10;&#10;    inlier_count = int(mask.sum())&#10;    inlier_ratio = inlier_count / len(matches)&#10;&#10;    passed = inlier_count &gt;= min_inliers and inlier_ratio &gt; 0.3&#10;    return passed, F, inlier_count&#10;&#10;&#10;def temporal_consistency_check(candidates, window_size=3):&#10;    verified = []&#10;    for i, cand in enumerate(candidates):&#10;        start = max(0, i - window_size)&#10;        end = min(len(candidates), i + window_size + 1)&#10;        neighbors = candidates[start:end]&#10;&#10;        consistent_count = sum(&#10;            1 for n in neighbors&#10;            if abs(n[&#39;target_frame&#39;] - cand[&#39;target_frame&#39;]) &lt; 10&#10;        )&#10;&#10;        if consistent_count &gt;= window_size:&#10;            verified.append(cand)&#10;    return verified\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cv2</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n