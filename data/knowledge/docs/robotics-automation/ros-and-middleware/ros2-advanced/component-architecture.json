port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ComposableNode</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generate_launch_description</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    container </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ComposableNodeContainer(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">        name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'perception_container'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">        namespace</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">        package</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'rclcpp_components'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">        executable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'component_container_mt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">        composable_node_descriptions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ComposableNode(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                package</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'perception'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                plugin</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'perception::ImageProcessor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'image_processor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ComposableNode(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                package</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'perception'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                plugin</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'perception::ObjectDetector'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'object_detector'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    )</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> LaunchDescription([container])</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>容器类型</th>\n<th>线程模型</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>component_container</td>\n<td>单线程</td>\n<td>简单管线</td>\n</tr>\n<tr>\n<td>component_container_mt</td>\n<td>多线程</td>\n<td>并行处理</td>\n</tr>\n<tr>\n<td>component_container_isolated</td>\n<td>隔离执行器</td>\n<td>实时性要求</td>\n</tr>\n</tbody></table>\n<h2 id=\"零拷贝通信\">零拷贝通信</h2><p>组件模式下使用 <code>UniquePtr</code> 发布消息可实现真正的零拷贝——消息数据在发布者和订阅者之间通过移动语义传递：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"auto msg = std::make_unique&lt;sensor_msgs::msg::Image&gt;();&#10;msg-&gt;header.stamp = now();&#10;msg-&gt;data = std::move(processed_data);&#10;publisher_-&gt;publish(std::move(msg));\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">auto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> msg </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">make_unique</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sensor_msgs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">msg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Image</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">msg->header.stamp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">msg->data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">move</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(processed_data);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">publisher_-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">publish</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">move</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(msg));</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>通信模式</th>\n<th>拷贝次数</th>\n<th>内存开销</th>\n<th>条件</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>跨进程（DDS）</td>\n<td>2+（序列化）</td>\n<td>高</td>\n<td>默认模式</td>\n</tr>\n<tr>\n<td>进程内 SharedPtr</td>\n<td>0（共享指针）</td>\n<td>中</td>\n<td>同进程、多订阅</td>\n</tr>\n<tr>\n<td>进程内 UniquePtr</td>\n<td>0（所有权转移）</td>\n<td>最低</td>\n<td>同进程、单订阅</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>ROS 2 组件架构通过将多个节点加载到同一进程实现零拷贝通信，大幅降低延迟</li>\n<li>组件节点通过 NodeOptions 构造函数和 REGISTER_NODE 宏实现插件化注册</li>\n<li>组件容器支持单线程、多线程和隔离执行器三种模式，适应不同性能需求</li>\n<li>UniquePtr 消息传递是实现零拷贝的关键，发布者必须放弃消息所有权</li>\n<li>生产部署推荐混合模式：性能关键路径组件化，非关键节点独立进程</li>\n</ul>\n","headings":[{"level":1,"text":"ROS 2 组件架构","id":"ros-2-组件架构"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"组件节点开发","id":"组件节点开发"},{"level":3,"text":"编写组件节点","id":"编写组件节点"},{"level":3,"text":"CMakeLists.txt 配置","id":"cmakelists-txt-配置"},{"level":2,"text":"组件容器与管理","id":"组件容器与管理"},{"level":2,"text":"零拷贝通信","id":"零拷贝通信"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ROS2 坐标变换（TF2）","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/ros2-fundamentals/tf2-transforms"},"next":{"title":"Nav2 导航框架","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/ros2-advanced/nav2-framework"}}