n</tr>\n<tr>\n<td>共享库编译</td>\n<td>编译为 .so 而非可执行文件</td>\n</tr>\n<tr>\n<td>UniquePtr 传递</td>\n<td>零拷贝的前提是使用 UniquePtr</td>\n</tr>\n</tbody></table>\n<h2 id=\"组件容器与管理\">组件容器与管理</h2><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 手动加载组件&#10;ros2 run rclcpp_components component_container&#10;&#10;ros2 component load /ComponentManager perception image_processor&#10;&#10;ros2 component list /ComponentManager\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 手动加载组件</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ros2</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rclcpp_components</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> component_container</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ros2</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> component</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> load</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /ComponentManager</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> perception</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> image_processor</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ros2</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> component</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> list</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /ComponentManager</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# Launch 文件中声明组件容器&#10;from launch import LaunchDescription&#10;from launch_ros.actions import ComposableNodeConta