v_ids):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._robots.set_joint_positions(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._default_positions[env_ids])</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._objects.set_world_poses(</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._random_positions(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(env_ids))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>RL 特性</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>GPU 并行环境</td>\n<td>数千个环境同时运行</td>\n</tr>\n<tr>\n<td>向量化观测</td>\n<td>PyTorch Tensor 直接输出</td>\n</tr>\n<tr>\n<td>Isaac Gym 兼容</td>\n<td>支持 PPO/SAC 等算法</td>\n</tr>\n<tr>\n<td>Sim-to-Real 管线</td>\n<td>域随机化 + 课程学习</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Isaac Sim 基于 Omniverse 平台，提供 RTX 光线追踪渲染和 PhysX 物理引擎的高保真仿真</li>\n<li>USD 场景格式支持多用户协作和复杂场景的版本管理</li>\n<li>域随机化是缩小 Sim-to-Real Gap 的核心策略，通过随机化视觉和物理参数提升迁移性</li>\n<li>GPU 并行仿真支持数千个环境同时运行，是强化学习训练的理想平台</li>\n<li>Isaac Sim 适合需要合成数据、RL 训练和高保真视觉仿真的场景，Gazebo 适合轻量级快速原型</li>\n</ul>\n","headings":[{"level":1,"text":"NVIDIA Isaac Sim 机器人仿真","id":"nvidia-isaac-sim-机器人仿真"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"USD 场景构建","id":"usd-场景构建"},{"level":2,"text":"域随机化","id":"域随机化"},{"level":2,"text":"强化学习集成","id":"强化学习集成"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Gazebo 仿真环境","url":"/l-doc-books/h/robotics-automation/ros-and-middleware/robot-simulation/gazebo-en