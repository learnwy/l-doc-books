;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(intervention_month)])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">treatment_post </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.array([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">44</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.25</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">np.random.normal(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                           for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(intervention_month, n_months)])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">treatment_city </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.concatenate([treatment_pre, treatment_post])</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 构造合成控制：用处理前数据拟合权重</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.column_stack([v[:intervention_month] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> control_cities.values()])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> treatment_pre</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 非负约束 + L2 正则（实际应用中应使用更严格的优化）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ridge </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Ridge(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">alpha</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">positive</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ridge.fit(X, y)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">weights </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ridge.coef_ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ridge.coef_.sum()  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 归一化权重</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 生成合成对照组的完整预测</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X_full </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.column_stack([v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> control_cities.values()])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">synthetic_control </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> X_full </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">@</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> weights</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 计算处理效果</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">att </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> treatment_city[intervention_month:] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> synthetic_control[intervention_month:]</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"平均处理效果 (ATT): </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">att.mean()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.2f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">%\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p><strong>合成控制法的优势</strong>：</p>\n<ul>\n<li>对照组的构造过程完全透明（权重可检验）</li>\n<li>天然处理了对照单元之间的异质性</li>\n<li>通过&quot;安慰剂检验&quot;（Placebo Test）可以量化不确定性</li>\n</ul>\n<p><strong>合成控制法的局限</strong>：只有当处理单元在政策实施前与某些对照单元特征相似时才有效；如果所有对照单元都与处理单元差异很大，合成控制的拟合质量会很差。</p>\n<h2 id=\"rdd-断点回归\">RDD：断点回归</h2><p>断点回归（Regression Discontinuity Design，RDD）利用**决策规则中的阈值（断点）**作为自然实验。其逻辑是：在阈值两侧的用户特征差异可忽略不计（他们只是刚好高于或低于阈值），因此两侧结果的差异可以被解释为因果效应。</p>\n<p><strong>经典产品场景</strong>：</p>\n<ul>\n<li><strong>VIP 等级门槛</strong>：消费满 1000 元升级 VIP，比较消费 990-999 元和 1000-1010 元用户的后续留存差异</li>\n<li><strong>内容审核阈值</strong>：文章被推荐需要质量分 ≥80，比较质量分 75-79 和 80-84 文章的阅读量差异</li>\n<li><strong>积分奖励临界点</strong>：积分达到 500 兑换一次奖励，比较积分 480-499 和 500-520 用户的活跃度差异</li>\n</ul>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import numpy as np&#10;import statsmodels.api as sm&#10;import matplotlib.pyplot as plt&#10;&#10;# 模拟 VIP 升级 RDD 分析&#10;np.random.seed(42)&#10;n = 2000&#10;&#10;# 消费金额（连续变量，断点在 1000 元）&#10;spending = np.random.uniform(700, 1300, n)&#10;cutoff = 1000&#10;&#10;# VIP 是否生效（处理变量，在断点右侧为1）&#10;treated = (spending &gt;= cutoff).astype(int)&#10;&#10;# 模拟结果：VIP 对 D30 留存率有 +8% 的因果效应&#10;# 加上一些平滑的背景趋势（消费越高留存越好）&#10;noise = np.random.normal(0, 5, n)&#10;retention = (&#10;    30                                # 基础留存率&#10;    + 0.01 * (spending - cutoff)     # 消费的背景效应&#10;    + 8 * treated                    # VIP 的因果效应&#10;    + noise&#10;)&#10;retention = np.clip(retention, 0, 100)&#10;&#10;# RDD 估计：在断点附近做局部线性回归&#10;bandwidth = 150  # 只使用断点 ±150 元的数据&#10;mask = np.abs(spending - cutoff) &lt;= bandwidth&#10;&#10;df_rdd = pd.DataFrame({&#10;    &#39;spending&#39;: spending[mask],&#10;    &#39;treated&#39;: treated[mask],&#10;    &#39;retention&#39;: retention[mask],&#10;    &#39;running&#39;: spending[mask] - cutoff  # 中心化运行变量&#10;})&#10;&#10;# 允许断点两侧有不同斜率的 OLS&#10;df_rdd[&#39;running_treat&#39;] = df_rdd[&#39;running&#39;] * df_rdd[&#39;treated&#39;]&#10;&#10;X = sm.add_constant(df_rdd[[&#39;running&#39;, &#39;treated&#39;, &#39;running_treat&#39;]])&#10;model = sm.OLS(df_rdd[&#39;retention&#39;], X).fit(cov_type=&#39;HC3&#39;)  # 异方差稳健 SE&#10;&#10;print(model.summary())&#10;rdd_estimate = model.params[&#39;treated&#39;]&#10;print(f&quot;\\nRDD 估计量（VIP 对留存的因果效应）: {rdd_estimate:.2f}%&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> statsmodels.api </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sm</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matplotlib.pyplot </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> plt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 模拟 VIP 升级 RDD 分析</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki