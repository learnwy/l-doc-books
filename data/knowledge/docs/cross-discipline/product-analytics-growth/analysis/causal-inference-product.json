e\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 加上一些平滑的背景趋势（消费越高留存越好）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">noise </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.random.normal(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, n)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">retention </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    30</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                                # 基础留存率</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.01</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (spending </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cutoff)     </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 消费的背景效应</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 8</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> treated                    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># VIP 的因果效应</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> noise</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">retention </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.clip(retention, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># RDD 估计：在断点附近做局部线性回归</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">bandwidth </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 150</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 只使用断点 ±150 元的数据</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">mask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.abs(spending </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cutoff) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bandwidth</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df_rdd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.DataFrame({</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'spending'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: spending[mask],</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'treated'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: treated[mask],</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'retention'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: retention[mask],</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'running'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: spending[mask] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cutoff  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 中心化运行变量</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 允许断点两侧有不同斜率的 OLS</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df_rdd[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'running_treat'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df_rdd[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'running'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df_rdd[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'treated'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">X </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sm.add_constant(df_rdd[[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'running'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'treated'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'running_treat'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sm.OLS(df_rdd[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'retention'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], X).fit(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">cov_type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'HC3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 异方差稳健 SE</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(model.summary())</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rdd_estimate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> model.params[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'treated'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">RDD 估计量（VIP 对留存的因果效应）: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rdd_estimate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.2f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">%\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p><strong>RDD 的内部效度 vs 外部效度权衡</strong>：RDD 的结论只适用于<strong>阈值附近的用户</strong>（Local Average Treatment Effect，LATE）。对于远离阈值的用户，其因果效应可能完全不同。这是 RDD 最重要的局限：内部效度高，但外部效度有限。</p>\n<h2 id=\"三种方法的选择框架\">三种方法的选择框架</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    Q1[是否有自然的时间断点&lt;br/&gt;(政策实施时间)？] --&gt;|是| Q2[是否有多个未受影响的&lt;br/&gt;可比单元？]&#10;    Q1 --&gt;|否| Q3[是否存在决策规则的&lt;br/&gt;阈值/截断点？]&#10;    Q2 --&gt;|只有1-2个处理单元| SC[合成控制法&lt;br/&gt;Synthetic Control]&#10;    Q2 --&gt;|有多个处理单元| DID_Q[处理组数量 vs 对照组]&#10;    DID_Q --&gt;|较多处理单元| DID[差分中的差分&lt;br/&gt;DID]&#10;    Q3 --&gt;|是| RDD[断点回归&lt;br/&gt;RDD]&#10;    Q3 --&gt;|否| IV[工具变量 / PSM&lt;br/&gt;或考虑设计 A/B 测试]\">flowchart TD\n    Q1[是否有自然的时间断点&lt;br/&gt;(政策实施时间)？] --&gt;|是| Q2[是否有多个未受影响的&lt;br/&gt;可比单元？]\n    Q1 --&gt;|否| Q3[是否存在决策规则的&lt;br/&gt;阈值/截断点？]\n    Q2 --&gt;|只有1-2个处理单元| SC[合成控制法&lt;br/&gt;Synthetic Control]\n    Q2 --&gt;|有多个处理单元| DID_Q[处理组数量 vs 对照组]\n    DID_Q --&gt;|较多处理单元| DID[差分中的差分&lt;br/&gt;DID]\n    Q3 --&gt;|是| RDD[断点回归&lt;br/&gt;RDD]\n    Q3 --&gt;|否| IV[工具变量 / PSM&lt;br/&gt;或考虑设计 A/B 测试]</pre><p><strong>三种方法的适用场景对比</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>方法</th>\n<th>数据要求</th>\n<th>核心假设</th>\n<th>因果推断强度</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DID</td>\n<td>面板数据，多时期</td>\n<td>平行趋势</td>\n<td>中等</td>\n<td>分批次上线、渠道差异分析</td>\n</tr>\n<tr>\n<td>Synthetic Control</td>\n<td>多个对照单元，长时序</td>\n<td>预政策时期良好拟合</td>\n<td>中高</td>\n<td>单个产品线/地区的政策评估</td>\n</tr>\n<tr>\n<td>RDD</td>\n<td>存在清晰阈值</td>\n<td>阈值附近连续性</td>\n<td>高（局部）</td>\n<td>等级制度、积分系统、算法推荐阈值</td>\n</tr>\n</tbody></table>\n<p>准实验方法不是 A/B 测试的替代品，而是在无法做 A/B 测试时的最佳替代方案。在实际产品决策中，应优先设计随机实验；当随机实验不可行时，再选择合适的准实验方法并清晰陈述其假设和局限性。</p>\n<h2 id=\"小结\">小结</h2><p>因果推断是将数据分析从&quot;观察到什么&quot;提升到&quot;为什么会这样&quot;的核心方法论。DID（差分中的差分）利用政策实施的时间断点消除共同趋势影响，适合多处理单元的分批次推广评估；合成控制法通过加权拟合构造反事实对照，适合只有单个处理单元的政策评估；断点回归利用决策规则中的自然阈值，在阈值附近实现接近随机化的因果推断，内部效度最高但外部效度有限。三种方法都有各自的识别假设，在应用时必须明确陈述假设是否成立。最重要的是：任何准实验分析都应该辅以 A/B 测试验证，将相关性洞察转化为真正的因果结论。</p>\n","headings":[{"level":1,"text":"因果推断与产品决策","id":"因果推断与产品决策"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"DID：差分中的差分","id":"did-差分中的差分"},{"level":2,"text":"Synthetic Control（合成控制法）","id":"synthetic-control-合成控制法"},{"level":2,"text":"RDD：断点回归","id":"rdd-断点回归"},{"level":2,"text":"三种方法的选择框架","id":"三种方法的选择框架"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"队列与用户分群","url":"/l-doc-books/h/cross-discipline/product-analytics-growth/analysis/cohort-user-segmentation"},"next":{"title":"A/B 测试平台架构","url":"/l-doc-books/h/cross-discipline/product-analytics-growth/experimentation/ab-test-platform-architecture"}}