gt; A2[领先性]\n    B --&gt; B1[业务结果]\n    B --&gt; B2[滞后性]</pre><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>输入指标</th>\n<th>输出指标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>定义</td>\n<td>团队可以直接影响的过程指标</td>\n<td>业务的最终结果指标</td>\n</tr>\n<tr>\n<td>时效性</td>\n<td>领先指标，变化更早出现</td>\n<td>滞后指标，变化出现较晚</td>\n</tr>\n<tr>\n<td>可控性</td>\n<td>高，团队可直接行动</td>\n<td>低，受多因素综合影响</td>\n</tr>\n<tr>\n<td>示例</td>\n<td>推送打开率、页面加载速度</td>\n<td>月收入、用户留存率</td>\n</tr>\n<tr>\n<td>作用</td>\n<td>指导日常工作</td>\n<td>衡量最终成果</td>\n</tr>\n</tbody></table>\n<h3 id=\"输入输出指标示例\">输入输出指标示例</h3><table>\n<thead>\n<tr>\n<th>输出指标（结果）</th>\n<th>输入指标（过程）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>月活跃用户数</td>\n<td>推送发送量、推送打开率、新功能采用率</td>\n</tr>\n<tr>\n<td>月度收入</td>\n<td>活跃用户数、付费转化率、ARPU</td>\n</tr>\n<tr>\n<td>用户满意度 NPS</td>\n<td>首次响应时间、问题解决率、产品崩溃率</td>\n</tr>\n<tr>\n<td>30 日留存率</td>\n<td>新手引导完成率、核心功能使用率、Day 1 留存</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 输入指标监控看板&#10;SELECT&#10;    DATE(event_time) AS date,&#10;    -- 输入指标&#10;    COUNT(DISTINCT CASE WHEN event_name = &#39;push_sent&#39; THEN user_id END) AS push_sent_users,&#10;    COUNT(DISTINCT CASE WHEN event_name = &#39;push_opened&#39; THEN user_id END) AS push_opened_users,&#10;    ROUND(&#10;        COUNT(DISTINCT CASE WHEN event_name = &#39;push_opened&#39; THEN user_id END)::NUMERIC&#10;        / NULLIF(COUNT(DISTINCT CASE WHEN event_name = &#39;push_sent&#39; THEN user_id END), 0) * 100, 2&#10;    ) AS push_open_rate,&#10;    COUNT(DISTINCT CASE WHEN event_name = &#39;onboarding_completed&#39; THEN user_id END) AS onboarding_completions,&#10;    COUNT(DISTINCT CASE WHEN event_name = &#39;core_feature_used&#39; THEN user_id END) AS core_feature_users,&#10;    -- 输出指标&#10;    COUNT(DISTINCT user_id) AS dau,&#10;    COUNT(DISTINCT CASE WHEN event_name = &#39;purchase&#39; THEN user_id END) AS paying_users&#10;FROM events&#10;WHERE event_time &gt;= CURRENT_DATE - INTERVAL &#39;30 days&#39;&#10;GROUP BY DATE(event_time)&#10;ORDER BY date;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 输入指标监控看板</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    DATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(event_time) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    -- 输入指标</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    COUNT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DISTINCT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> CASE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> WHEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_name </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'push_sent'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">END</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> push_sent_users,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    COUNT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DISTINCT</span><span style=\"color:#D73