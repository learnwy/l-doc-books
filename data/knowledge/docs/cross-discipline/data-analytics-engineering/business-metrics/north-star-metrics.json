r:#D73A49;--shiki-dark:#F97583\"> WHEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_name </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'purchase'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">END</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> paying_users</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_time </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'30 days'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(event_time)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><hr>\n<h2 id=\"指标体系设计框架\">指标体系设计框架</h2><h3 id=\"aarrr-海盗指标\">AARRR 海盗指标</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[Acquisition 获取] --&gt; B[Activation 激活]&#10;    B --&gt; C[Retention 留存]&#10;    C --&gt; D[Revenue 变现]&#10;    D --&gt; E[Referral 推荐]\">graph LR\n    A[Acquisition 获取] --&gt; B[Activation 激活]\n    B --&gt; C[Retention 留存]\n    C --&gt; D[Revenue 变现]\n    D --&gt; E[Referral 推荐]</pre><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>核心问题</th>\n<th>关键指标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>获取</td>\n<td>用户从哪里来?</td>\n<td>CAC、渠道转化率、新增用户数</td>\n</tr>\n<tr>\n<td>激活</td>\n<td>用户是否体验到核心价值?</td>\n<td>激活率、首次关键行为完成率</td>\n</tr>\n<tr>\n<td>留存</td>\n<td>用户是否持续回来?</td>\n<td>Day 1/7/30 留存率</td>\n</tr>\n<tr>\n<td>变现</td>\n<td>用户是否付费?</td>\n<td>ARPU、LTV、付费转化率</td>\n</tr>\n<tr>\n<td>推荐</td>\n<td>用户是否推荐给他人?</td>\n<td>K-Factor、NPS、邀请转化率</td>\n</tr>\n</tbody></table>\n<h3 id=\"指标治理\">指标治理</h3><table>\n<thead>\n<tr>\n<th>治理维度</th>\n<th>要求</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>命名规范</td>\n<td>指标名称统一，避免歧义</td>\n</tr>\n<tr>\n<td>口径定义</td>\n<td>每个指标有唯一明确的计算口径</td>\n</tr>\n<tr>\n<td>数据来源</td>\n<td>指标的数据来源和 ETL 逻辑有文档</td>\n</tr>\n<tr>\n<td>指标负责人</td>\n<td>每个核心指标有明确的负责人</td>\n</tr>\n<tr>\n<td>变更管理</td>\n<td>指标口径变更需要评审和通知</td>\n</tr>\n<tr>\n<td>指标字典</td>\n<td>维护全局指标字典，可搜索可查询</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>北极星指标应反映用户核心价值、可衡量、可行动、不可博弈</li>\n<li>指标树通过乘法分解和加法分解将北极星指标拆解为可操作的子指标</li>\n<li>输入指标是团队可直接行动的领先指标，输出指标是业务的滞后结果指标</li>\n<li>AARRR 框架从获取到推荐覆盖了用户生命周期的完整指标体系</li>\n<li>指标治理需要统一命名、明确口径、指定负责人和维护指标字典</li>\n</ul>\n","headings":[{"level":1,"text":"北极星指标：如何定义北极星指标、指标树分解、输入/输出指标","id":"北极星指标-如何定义北极星指标-指标树分解-输入-输出指标"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"什么是北极星指标","id":"什么是北极星指标"},{"level":2,"text":"北极星指标的定义方法","id":"北极星指标的定义方法"},{"level":3,"text":"好的北极星指标的标准","id":"好的北极星指标的标准"},{"level":3,"text":"不同产品类型的北极星指标","id":"不同产品类型的北极星指标"},{"level":3,"text":"定义流程","id":"定义流程"},{"level":2,"text":"指标树分解","id":"指标树分解"},{"level":3,"text":"指标树结构","id":"指标树结构"},{"level":3,"text":"指标分解方法","id":"指标分解方法"},{"level":2,"text":"输入指标与输出指标","id":"输入指标与输出指标"},{"level":3,"text":"概念区分","id":"概念区分"},{"level":3,"text":"输入输出指标示例","id":"输入输出指标示例"},{"level":2,"text":"指标体系设计框架","id":"指标体系设计框架"},{"level":3,"text":"AARRR 海盗指标","id":"aarrr-海盗指标"},{"level":3,"text":"指标治理","id":"指标治理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据湖：数据湖 vs 数据仓库、Lakehouse 架构、Iceberg/Hudi","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/data-warehouse-basics/data-lake"},"next":{"title":"留存分析：DAU/MAU/留存率计算、留存曲线、提升策略","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/business-metrics/retention-analysis"}}