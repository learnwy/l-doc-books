,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order_amount,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    COALESCE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">discount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> discount_amount,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> COALESCE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">discount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actual_amount,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    CASE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">status</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pending'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'paid'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'shipped'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        WHEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'completed'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        WHEN</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> THEN</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'cancelled'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        ELSE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'unknown'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    END</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order_status,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    COALESCE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">payment_method</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'unknown'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> payment_method,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    COALESCE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">source</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'unknown'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order_source,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">created_at</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dt</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ods_orders o</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LEFT JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dim_user u </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">is_current</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TRUE</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LEFT JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dim_product p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">product_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">product_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">is_current</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TRUE</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> o</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE;</span></span></code></pre></div><h3 id=\"数据质量转换规则\">数据质量转换规则</h3><table>\n<thead>\n<tr>\n<th>质量问题</th>\n<th>处理策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>NULL 值</td>\n<td>COALESCE 填充默认值或标记</td>\n</tr>\n<tr>\n<td>重复记录</td>\n<td>ROW_NUMBER 去重保留最新</td>\n</tr>\n<tr>\n<td>格式不一致</td>\n<td>标准化函数转换</td>\n</tr>\n<tr>\n<td>超范围值</td>\n<td>CASE WHEN 截断或标记</td>\n</tr>\n<tr>\n<td>编码不一致</td>\n<td>映射表转换</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"数据加载-load\">数据加载（Load）</h2><table>\n<thead>\n<tr>\n<th>加载方式</th>\n<th>实现方式</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>全量覆盖</td>\n<td>TRUNCATE + INSERT</td>\n<td>简单，数据完整</td>\n<td>小表、维度表</td>\n</tr>\n<tr>\n<td>追加插入</td>\n<td>INSERT INTO</td>\n<td>只添加新数据</td>\n<td>事实表、日志表</td>\n</tr>\n<tr>\n<td>分区覆盖</td>\n<td>INSERT OVERWRITE</td>\n<td>按分区替换</td>\n<td>日分区事实表</td>\n</tr>\n<tr>\n<td>Merge/Upsert</td>\n<td>MERGE INTO</td>\n<td>更新已有，插入新增</td>\n<td>缓慢变化维度</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"调度系统\">调度系统</h2><h3 id=\"调度架构\">调度架构</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[调度系统] --&gt; B[任务定义]&#10;    A --&gt; C[依赖管理]&#10;    A --&gt; D[执行引擎]&#10;    A --&gt; E[监控告警]&#10;    B --&gt; B1[SQL 任务/脚本任务/API 调用]&#10;    C --&gt; C1[DAG 有向无环图]&#10;    D --&gt; D1[定时触发/事件触发/手动触发]&#10;    E --&gt; E1[成功/失败/超时告警]\">graph TD\n    A[调度系统] --&gt; B[任务定义]\n    A --&gt; C[依赖管理]\n    A --&gt; D[执行引擎]\n    A --&gt; E[监控告警]\n    B --&gt; B1[SQL 任务/脚本任务/API 调用]\n    C --&gt; C1[DAG 有向无环图]\n    D --&gt; D1[定时触发/事件触发/手动触发]\n    E --&gt; E1[成功/失败/超时告警]</pre><h3 id=\"调度工具对比\">调度工具对比</h3><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>类型</th>\n<th>语言</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Apache Airflow</td>\n<td>开源</td>\n<td>Python</td>\n<td>DAG 定义灵活，生态丰富</td>\n</tr>\n<tr>\n<td>DolphinScheduler</td>\n<td>开源</td>\n<td>Java</td>\n<td>可视化 DAG，中文社区活跃</td>\n</tr>\n<tr>\n<td>dbt</td>\n<td>开源</td>\n<td>SQL/Jinja</td>\n<td>SQL 优先，版本控制集成</td>\n</tr>\n<tr>\n<td>Dagster</td>\n<td>开源</td>\n<td>Python</td>\n<td>资产导向，测试友好</td>\n</tr>\n<tr>\n<td>Prefect</td>\n<td>开源</td>\n<td>Python</td>\n<td>现代化设计，云原生</td>\n</tr>\n</tbody></table>\n<h3 id=\"dag-设计模式\">DAG 设计模式</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    ODS_ORDERS[ods_orders] --&gt; DWD_ORDER[dwd_order_detail]&#10;    ODS_USERS[ods_users] --&gt; DIM_USER[dim_user]&#10;    ODS_PRODUCTS[ods_products] --&gt; DIM_PRODUCT[dim_product]&#10;    DIM_USER --&gt; DWD_ORDER&#10;    DIM_PRODUCT --&gt; DWD_ORDER&#10;    DWD_ORDER --&gt; DWS_USER[dws_user_daily]&#10;    DWD_ORDER --&gt; DWS_PRODUCT[dws_product_daily]&#10;    DWS_USER --&gt; ADS_OVERVIEW[ads_daily_overview]&#10;    DWS_PRODUCT --&gt; ADS_OVERVIEW\">graph TD\n    ODS_ORDERS[ods_orders] --&gt; DWD_ORDER[dwd_order_detail]\n    ODS_USERS[ods_users] --&gt; DIM_USER[dim_user]\n    ODS_PRODUCTS[ods_products] --&gt; DIM_PRODUCT[dim_product]\n    DIM_USER --&gt; DWD_ORDER\n    DIM_PRODUCT --&gt; DWD_ORDER\n    DWD_ORDER --&gt; DWS_USER[dws_user_daily]\n    DWD_ORDER --&gt; DWS_PRODUCT[dws_product_daily]\n    DWS_USER --&gt; ADS_OVERVIEW[ads_daily_overview]\n    DWS_PRODUCT --&gt; ADS_OVERVIEW</pre><h3 id=\"调度最佳实践\">调度最佳实践</h3><table>\n<thead>\n<tr>\n<th>实践</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>幂等性</td>\n<td>同一任务重复执行结果一致</td>\n</tr>\n<tr>\n<td>分区隔离</td>\n<td>每次执行只处理指定分区的数据</td>\n</tr>\n<tr>\n<td>依赖声明</td>\n<td>上游任务成功后才触发下游任务</td>\n</tr>\n<tr>\n<td>超时控制</td>\n<td>设置合理的任务超时时间</td>\n</tr>\n<tr>\n<td>重试机制</td>\n<td>失败后自动重试指定次数</td>\n</tr>\n<tr>\n<td>告警通知</td>\n<td>失败或超时时及时通知相关人员</td>\n</tr>\n<tr>\n<td>数据校验</td>\n<td>加载后执行数据质量检查</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"增量处理策略\">增量处理策略</h2><h3 id=\"增量合并模式\">增量合并模式</h3><table>\n<thead>\n<tr>\n<th>模式</th>\n<th>实现方式</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>全量覆盖</td>\n<td>每次重新计算全量</td>\n<td>数据量小、逻辑复杂</td>\n</tr>\n<tr>\n<td>分区追加</td>\n<td>每日新增一个分区</td>\n<td>事件/日志类数据</td>\n</tr>\n<tr>\n<td>增量合并</td>\n<td>增量数据与存量 Merge</td>\n<td>缓慢变化的业务表</td>\n</tr>\n<tr>\n<td>拉链表</td>\n<td>保留历史版本快照</td>\n<td>需要历史状态查询</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 拉链表实现&#10;-- 步骤 1：将已变更的记录标记为过期&#10;UPDATE dwd_user_zipper&#10;SET end_date = CURRENT_DATE - INTERVAL &#39;1 day&#39;,&#10;    is_current = FALSE&#10;WHERE user_id IN (&#10;    SELECT user_id FROM ods_users WHERE dt = CURRENT_DATE&#10;)&#10;AND is_current = TRUE;&#10;&#10;-- 步骤 2：插入最新版本&#10;INSERT INTO dwd_user_zipper (user_id, user_name, city, vip_level, start_date, end_date, is_current)&#10;SELECT&#10;    user_id, user_name, city, vip_level,&#10;    CURRENT_DATE AS start_date,&#10;    &#39;9999-12-31&#39;::DATE AS end_date,&#10;    TRUE AS is_current&#10;FROM ods_users&#10;WHERE dt = CURRENT_DATE;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 拉链表实现</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 步骤 1：将已变更的记录标记为过期</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dwd_user_zipper</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> end_date </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1 day'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    is_current </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> FALSE</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ods_users </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> is_current </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TRUE;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 步骤 2：插入最新版本</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">INSERT INTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dwd_user_zipper (user_id, user_name, city, vip_level, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">start_date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, end_date, is_current)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    user_id, user_name, city, vip_level,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> start_date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '9999-12-31'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> end_date,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    TRUE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> is_current</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ods_users</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE;</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>ETL 是数据仓库建设的核心工程，ELT 模式在云数据仓库场景下越来越流行</li>\n<li>数据抽取应优先使用 CDC（变更数据捕获），其次是时间戳增量，全量抽取仅适用于小表</li>\n<li>数据转换涵盖清洗、标准化、关联、聚合和脱敏，DWD 层是最重要的转换环节</li>\n<li>调度系统通过 DAG 管理任务依赖，幂等性和分区隔离是调度设计的核心原则</li>\n<li>增量处理策略包括分区追加、增量合并和拉链表，选择取决于数据特性和分析需求</li>\n</ul>\n","headings":[{"level":1,"text":"ETL 流水线：数据抽取/转换/加载、调度系统、增量处理","id":"etl-流水线-数据抽取-转换-加载-调度系统-增量处理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"ETL 概述","id":"etl-概述"},{"level":3,"text":"ETL vs ELT","id":"etl-vs-elt"},{"level":2,"text":"数据抽取（Extract）","id":"数据抽取-extract"},{"level":3,"text":"抽取方式","id":"抽取方式"},{"level":3,"text":"CDC 实现","id":"cdc-实现"},{"level":2,"text":"数据转换（Transform）","id":"数据转换-transform"},{"level":3,"text":"转换类型","id":"转换类型"},{"level":3,"text":"数据质量转换规则","id":"数据质量转换规则"},{"level":2,"text":"数据加载（Load）","id":"数据加载-load"},{"level":2,"text":"调度系统","id":"调度系统"},{"level":3,"text":"调度架构","id":"调度架构"},{"level":3,"text":"调度工具对比","id":"调度工具对比"},{"level":3,"text":"DAG 设计模式","id":"dag-设计模式"},{"level":3,"text":"调度最佳实践","id":"调度最佳实践"},{"level":2,"text":"增量处理策略","id":"增量处理策略"},{"level":3,"text":"增量合并模式","id":"增量合并模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数仓架构：Lambda/Kappa 架构、分层设计（ODS/DWD/DWS/ADS）","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/data-warehouse-basics/dw-architecture"},"next":{"title":"OLAP 基础：OLAP vs OLTP、多维分析、ClickHouse/Doris/StarRocks","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/data-warehouse-basics/olap-basics"}}