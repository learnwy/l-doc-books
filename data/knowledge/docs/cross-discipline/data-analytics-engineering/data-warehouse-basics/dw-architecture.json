/tr>\n<tr>\n<td>数据标准化</td>\n<td>统一编码、统一时区、统一单位</td>\n</tr>\n<tr>\n<td>维度关联</td>\n<td>用代理键关联维度表</td>\n</tr>\n<tr>\n<td>数据脱敏</td>\n<td>敏感字段脱敏处理</td>\n</tr>\n<tr>\n<td>增量合并</td>\n<td>将增量数据与存量数据合并</td>\n</tr>\n</tbody></table>\n<h3 id=\"dws-层-汇总层\">DWS 层：汇总层</h3><div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE dws_user_daily_summary (&#10;    user_key        BIGINT,&#10;    date_key        INT,&#10;    order_count     INT,&#10;    total_amount    DECIMAL(12,2),&#10;    product_count   INT,&#10;    session_count   INT,&#10;    page_view_count INT,&#10;    active_duration_sec INT,&#10;    is_first_order  BOOLEAN,&#10;    dt              DATE&#10;)&#10;PARTITION BY (dt);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dws_user_daily_summary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    user_key        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    date_key        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    order_count     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    total_amount    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    product_count   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    session_count   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    page_view_count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    active_duration_sec </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    is_first_order  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BOOLEAN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    dt              </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATE</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">PARTITION</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dt);</span></span></code></pre></div><h3 id=\"ads-层-应用层\">ADS 层：应用层</h3><div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE ads_daily_business_overview (&#10;    date_key            INT PRIMARY KEY,&#10;    dau                 INT,&#10;    new_users           INT,&#10;    total_orders        INT,&#10;    total_revenue       DECIMAL(14,2),&#10;    paying_users        INT,&#10;    paying_rate         DECIMAL(6,4),&#10;    avg_order_value     DECIMAL(10,2),&#10;    day_1_retention     DECIMAL(6,4),&#10;    day_7_retention     DECIMAL(6,4)&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ads_daily_business_overview</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    date_key            </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    dau                 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    new_users           </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    total_orders        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    total_revenue       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    paying_users        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    paying_rate         </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    avg_order_value     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    day_1_retention     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    day_7_retention     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><hr>\n<h2 id=\"数据仓库建设规范\">数据仓库建设规范</h2><h3 id=\"表命名规范\">表命名规范</h3><table>\n<thead>\n<tr>\n<th>层级</th>\n<th>命名格式</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ODS</td>\n<td>ods*{源系统}*{源表名}</td>\n<td>ods_mysql_orders</td>\n</tr>\n<tr>\n<td>DWD</td>\n<td>dwd*{业务域}*{业务过程}_{detail}</td>\n<td>dwd_trade_order_detail</td>\n</tr>\n<tr>\n<td>DWS</td>\n<td>dws*{业务域}*{统计粒度}_{周期}</td>\n<td>dws_user_daily_summary</td>\n</tr>\n<tr>\n<td>ADS</td>\n<td>ads*{应用名}*{主题}</td>\n<td>ads_dashboard_overview</td>\n</tr>\n<tr>\n<td>DIM</td>\n<td>dim_{维度名}</td>\n<td>dim_product、dim_date</td>\n</tr>\n</tbody></table>\n<h3 id=\"数据域划分\">数据域划分</h3><table>\n<thead>\n<tr>\n<th>数据域</th>\n<th>覆盖范围</th>\n<th>核心事实表</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>用户域</td>\n<td>注册、登录、画像</td>\n<td>用户注册、用户登录</td>\n</tr>\n<tr>\n<td>交易域</td>\n<td>下单、支付、退款</td>\n<td>订单、支付、退款</td>\n</tr>\n<tr>\n<td>流量域</td>\n<td>页面浏览、点击、会话</td>\n<td>页面浏览、事件</td>\n</tr>\n<tr>\n<td>营销域</td>\n<td>活动、优惠券、推广</td>\n<td>活动参与、优惠券使用</td>\n</tr>\n<tr>\n<td>内容域</td>\n<td>文章、视频、评论</td>\n<td>内容发布、内容消费</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>数据仓库是面向分析的集成数据平台，与 OLTP 系统在设计目标和数据模型上有根本差异</li>\n<li>Lambda 架构通过批处理层和速度层的组合保证数据准确性和及时性，但维护成本高</li>\n<li>Kappa 架构去掉批处理层仅使用流处理，适合处理逻辑简单、延迟要求高的场景</li>\n<li>数据仓库分层（ODS→DWD→DWS→ADS）通过逐层加工实现数据复用和职责分离</li>\n<li>ODS 保持源数据原样，DWD 负责清洗标准化，DWS 面向主题汇总，ADS 直接服务应用</li>\n</ul>\n","headings":[{"level":1,"text":"数仓架构：Lambda/Kappa 架构、分层设计（ODS/DWD/DWS/ADS）","id":"数仓架构-lambda-kappa-架构-分层设计-ods-dwd-dws-ads"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"数据仓库概述","id":"数据仓库概述"},{"level":2,"text":"Lambda 架构","id":"lambda-架构"},{"level":3,"text":"Lambda 架构的优劣","id":"lambda-架构的优劣"},{"level":2,"text":"Kappa 架构","id":"kappa-架构"},{"level":3,"text":"架构选型建议","id":"架构选型建议"},{"level":2,"text":"数据仓库分层设计","id":"数据仓库分层设计"},{"level":3,"text":"各层详解","id":"各层详解"},{"level":3,"text":"ODS 层：贴源层","id":"ods-层-贴源层"},{"level":3,"text":"DWD 层：明细层","id":"dwd-层-明细层"},{"level":3,"text":"DWS 层：汇总层","id":"dws-层-汇总层"},{"level":3,"text":"ADS 层：应用层","id":"ads-层-应用层"},{"level":2,"text":"数据仓库建设规范","id":"数据仓库建设规范"},{"level":3,"text":"表命名规范","id":"表命名规范"},{"level":3,"text":"数据域划分","id":"数据域划分"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"隐私合规：GDPR/CCPA 合规、用户同意管理、数据脱敏","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/event-tracking-design/privacy-compliance"},"next":{"title":"ETL 流水线：数据抽取/转换/加载、调度系统、增量处理","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/data-warehouse-basics/etl-pipeline"}}