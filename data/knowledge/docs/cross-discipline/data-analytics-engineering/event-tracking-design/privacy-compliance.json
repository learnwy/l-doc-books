>\n</thead>\n<tbody><tr>\n<td>原始事件数据</td>\n<td>12-24 个月</td>\n<td>聚合后删除原始</td>\n<td>GDPR 存储限制原则</td>\n</tr>\n<tr>\n<td>用户行为日志</td>\n<td>6-12 个月</td>\n<td>归档或删除</td>\n<td>业务需求 + 合规</td>\n</tr>\n<tr>\n<td>聚合统计数据</td>\n<td>3-5 年</td>\n<td>持续保留</td>\n<td>无个人信息</td>\n</tr>\n<tr>\n<td>用户同意记录</td>\n<td>同意期 + 5 年</td>\n<td>归档</td>\n<td>合规审计需要</td>\n</tr>\n<tr>\n<td>数据删除日志</td>\n<td>永久</td>\n<td>永久保留</td>\n<td>证明已履行删除义务</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 数据生命周期管理&#10;-- 删除超过保留期的原始事件数据&#10;DELETE FROM events&#10;WHERE event_time &lt; CURRENT_DATE - INTERVAL &#39;24 months&#39;&#10;  AND event_time &lt; (&#10;    SELECT MIN(event_time)&#10;    FROM aggregated_daily_metrics&#10;  );&#10;&#10;-- 归档用户行为日志到冷存储&#10;INSERT INTO events_archive&#10;SELECT * FROM events&#10;WHERE event_time &lt; CURRENT_DATE - INTERVAL &#39;12 months&#39;;&#10;&#10;DELETE FROM events&#10;WHERE event_time &lt; CURRENT_DATE - INTERVAL &#39;12 months&#39;;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 数据生命周期管理</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 删除超过保留期的原始事件数据</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">DELETE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_time </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'24 months'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_time </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(event_time)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> aggregated_daily_metrics</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 归档用户行为日志到冷存储</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">INSERT INTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events_archive</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_time </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'12 months'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">DELETE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event_time </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'12 months'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><hr>\n<h2 id=\"隐私合规检查清单\">隐私合规检查清单</h2><table>\n<thead>\n<tr>\n<th>检查项</th>\n<th>要求</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>隐私政策更新</td>\n<td>隐私政策反映当前的数据处理实践</td>\n</tr>\n<tr>\n<td>同意管理实现</td>\n<td>CMP 按法规要求实现，同意可撤回</td>\n</tr>\n<tr>\n<td>数据最小化</td>\n<td>只采集业务必需的数据</td>\n</tr>\n<tr>\n<td>数据加密</td>\n<td>传输加密（TLS）+ 存储加密</td>\n</tr>\n<tr>\n<td>访问控制</td>\n<td>基于角色的数据访问权限控制</td>\n</tr>\n<tr>\n<td>数据删除流程</td>\n<td>用户删除请求可在 30 天内完成</td>\n</tr>\n<tr>\n<td>数据导出流程</td>\n<td>用户数据导出请求可在 30 天内完成</td>\n</tr>\n<tr>\n<td>第三方数据共享</td>\n<td>与第三方的数据处理协议（DPA）已签署</td>\n</tr>\n<tr>\n<td>跨境传输</td>\n<td>跨境数据传输有合法依据</td>\n</tr>\n<tr>\n<td>隐私影响评估</td>\n<td>高风险数据处理已完成 DPIA 评估</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>GDPR、CCPA 和 PIPL 是当前最重要的三部隐私法规，违规处罚严厉</li>\n<li>用户同意管理需要分级（必要/功能性/分析性/营销性），并在技术层面控制数据采集范围</li>\n<li>用户有访问、更正、删除（被遗忘权）和数据可携带等权利，需要提供技术实现</li>\n<li>数据脱敏技术包括哈希、加密、掩码、泛化和差分隐私，应根据使用场景选择合适方法</li>\n<li>数据保留策略应明确各类数据的保留期限和到期处理方式，平衡业务需求和合规要求</li>\n</ul>\n","headings":[{"level":1,"text":"隐私合规：GDPR/CCPA 合规、用户同意管理、数据脱敏","id":"隐私合规-gdpr-ccpa-合规-用户同意管理-数据脱敏"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"隐私合规的必要性","id":"隐私合规的必要性"},{"level":2,"text":"主要隐私法规","id":"主要隐私法规"},{"level":3,"text":"GDPR 核心原则","id":"gdpr-核心原则"},{"level":3,"text":"GDPR 合法性基础","id":"gdpr-合法性基础"},{"level":2,"text":"用户同意管理","id":"用户同意管理"},{"level":3,"text":"同意管理架构","id":"同意管理架构"},{"level":3,"text":"同意类型与分级","id":"同意类型与分级"},{"level":3,"text":"同意状态管理","id":"同意状态管理"},{"level":3,"text":"基于同意的数据采集控制","id":"基于同意的数据采集控制"},{"level":2,"text":"用户权利实现","id":"用户权利实现"},{"level":3,"text":"GDPR 赋予用户的权利","id":"gdpr-赋予用户的权利"},{"level":3,"text":"数据删除（被遗忘权）实现","id":"数据删除-被遗忘权-实现"},{"level":2,"text":"数据脱敏","id":"数据脱敏"},{"level":3,"text":"脱敏技术分类","id":"脱敏技术分类"},{"level":3,"text":"脱敏规则示例","id":"脱敏规则示例"},{"level":2,"text":"数据保留策略","id":"数据保留策略"},{"level":2,"text":"隐私合规检查清单","id":"隐私合规检查清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据质量：数据校验、异常检测、数据修复策略","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/event-tracking-design/data-quality"},"next":{"title":"数仓架构：Lambda/Kappa 架构、分层设计（ODS/DWD/DWS/ADS）","url":"/l-doc-books/h/cross-discipline/data-analytics-engineering/data-warehouse-basics/dw-architecture"}}