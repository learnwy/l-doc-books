le=\"color:#D73A49;--shiki-dark:#F97583\">    GROUP BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) c </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user_id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">event_time</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> >=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_DATE </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1 day'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><hr>\n<h2 id=\"用户权利实现\">用户权利实现</h2><h3 id=\"gdpr-赋予用户的权利\">GDPR 赋予用户的权利</h3><table>\n<thead>\n<tr>\n<th>权利</th>\n<th>说明</th>\n<th>技术实现</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>知情权</td>\n<td>用户有权知道数据如何被处理</td>\n<td>隐私政策页面</td>\n</tr>\n<tr>\n<td>访问权</td>\n<td>用户有权获取其个人数据副本</td>\n<td>数据导出接口</td>\n</tr>\n<tr>\n<td>更正权</td>\n<td>用户有权更正不准确的数据</td>\n<td>个人信息编辑功能</td>\n</tr>\n<tr>\n<td>删除权</td>\n<td>用户有权要求删除其数据</td>\n<td>数据删除流程</td>\n</tr>\n<tr>\n<td>限制处理权</td>\n<td>用户有权限制数据处理方式</td>\n<td>同意管理粒度控制</td>\n</tr>\n<tr>\n<td>数据可携带权</td>\n<td>用户有权以通用格式获取数据</td>\n<td>标准格式的数据导出</td>\n</tr>\n<tr>\n<td>反对权</td>\n<td>用户有权反对基于正当利益的处理</td>\n<td>退出机制（Opt-out）</td>\n</tr>\n</tbody></table>\n<h3 id=\"数据删除-被遗忘权-实现\">数据删除（被遗忘权）实现</h3><div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 用户数据删除流程&#10;-- 步骤 1：标记用户为待删除&#10;UPDATE users&#10;SET deletion_requested_at = NOW(),&#10;    status = &#39;pending_deletion&#39;&#10;WHERE user_id = &#39;U12345&#39;;&#10;&#10;-- 步骤 2：删除事件数据中的个人信息&#10;UPDATE events&#10;SET user_id = NULL,&#10;    properties = properties - &#39;email&#39; - &#39;phone&#39; - &#39;ip_address&#39;,&#10;    anonymous_id = &#39;DELETED_&#39; || MD5(anonymous_id)&#10;WHERE user_id = &#39;U12345&#39;;&#10;&#10;-- 步骤 3：删除用户画像数据&#10;DELETE FROM user_profiles WHERE user_id = &#39;U12345&#39;;&#10;&#10;-- 步骤 4：记录删除操作&#10;INSERT INTO data_deletion_log (user_id, requested_at, completed_at, tables_affected)&#10;VALUES (&#39;U12345&#39;, NOW(), NOW(), ARRAY[&#39;events&#39;, &#39;user_profiles&#39;]);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 用户数据删除流程</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 步骤 1：标记用户为待删除</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> users</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deletion_requested_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOW</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pending_deletion'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'U12345'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 步骤 2：删除事件数据中的个人信息</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    properties </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> properties </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'email'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'phone'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ip_address'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    anonymous_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'DELETED_'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ||</span><span style=\"color:#24292