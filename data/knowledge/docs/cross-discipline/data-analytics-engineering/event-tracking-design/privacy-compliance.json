rk:#F97583\">ARRAY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">['events', 'user_profiles']);</span></span></code></pre></div><hr>\n<h2 id=\"数据脱敏\">数据脱敏</h2><h3 id=\"脱敏技术分类\">脱敏技术分类</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[数据脱敏] --&gt; B[静态脱敏]&#10;    A --&gt; C[动态脱敏]&#10;    B --&gt; B1[ETL 过程中永久替换]&#10;    C --&gt; C1[查询时实时脱敏]\">graph TD\n    A[数据脱敏] --&gt; B[静态脱敏]\n    A --&gt; C[动态脱敏]\n    B --&gt; B1[ETL 过程中永久替换]\n    C --&gt; C1[查询时实时脱敏]</pre><table>\n<thead>\n<tr>\n<th>脱敏方法</th>\n<th>说明</th>\n<th>可逆性</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>哈希</td>\n<td>对原始值计算哈希</td>\n<td>否</td>\n<td>ID 关联但不可还原</td>\n</tr>\n<tr>\n<td>加密</td>\n<td>使用密钥加密</td>\n<td>是</td>\n<td>需要授权还原的场景</td>\n</tr>\n<tr>\n<td>掩码</td>\n<td>部分字符替换为 *</td>\n<td>否</td>\n<td>展示层脱敏</td>\n</tr>\n<tr>\n<td>泛化</td>\n<td>降低精度（如年龄→年龄段）</td>\n<td>否</td>\n<td>统计分析场景</td>\n</tr>\n<tr>\n<td>假名化</td>\n<td>用假名替换真实标识</td>\n<td>是</td>\n<td>保留可分析性</td>\n</tr>\n<tr>\n<td>差分隐私</td>\n<td>添加统计噪声</td>\n<td>否</td>\n<td>聚合统计场景</td>\n</tr>\n<tr>\n<td>K-匿名化</td>\n<td>确保每条记录至少有 K 条相同</td>\n<td>否</td>\n<td>发布数据集</td>\n</tr>\n</tbody></table>\n<h3 id=\"脱敏规则示例\">脱敏规则示例</h3><table>\n<thead>\n<tr>\n<th>数据类型</th>\n<th>原始数据</th>\n<th>脱敏方法</th>\n<th>脱敏结果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>手机号</td>\n<td>13812345678</td>\n<td>掩码</td>\n<td>138****5678</td>\n</tr>\n<tr>\n<td>邮箱</td>\n<td><a href=\"mailto:user@example.com\">user@example.com</a></td>\n<td>掩码</td>\n<td>u***@example.com</td>\n</tr>\n<tr>\n<td>身份证号</td>\n<td>110101199001011234</td>\n<td>掩码</td>\n<td>110101****1234</td>\n</tr>\n<tr>\n<td>IP 地址</td>\n<td>192.168.1.100</td>\n<td>泛化</td>\n<td>192.168.1.0/24</td>\n</tr>\n<tr>\n<td>精确位置</td>\n<td>(39.9042, 116.4074)</td>\n<td>泛化</td>\n<td>北京市朝阳区</td>\n</tr>\n<tr>\n<td>用户 ID</td>\n<td>U12345</td>\n<td>哈希</td>\n<td>a3f2b8c9d1...</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- SQL 层面的数据脱敏函数&#10;-- 手机号脱敏&#10;SELECT&#10;    user_id,&#10;    CONCAT(LEFT(phone, 3), &#39;****&#39;, RIGHT(phone, 4)) AS masked_phone&#10;FROM users;&#10;&#10;-- 邮箱脱敏&#10;SELECT&#10;    user_id,&#10;    CONCAT(LEFT(email, 1), &#39;***@&#39;, SPLIT_PART(email, &#39;@&#39;, 2)) AS masked_email&#10;FROM users;&#10;&#10;-- IP 地址泛化&#10;SELECT&#10;    event_id,&#10;    CONCAT(&#10;        SPLIT_PART(ip_address, &#39;.&#39;, 1), &#39;.&#39;,&#10;        SPLIT_PART(ip_address, &#39;.&#39;, 2), &#39;.&#39;,&#10;        SPLIT_PART(ip_address, &#39;.&#39;, 3), &#39;.0&#39;&#10;    ) AS generalized_ip&#10;FROM events;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- SQL 层面的数据脱敏函数</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 手机号脱敏</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    user_id,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    CONCAT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">LEFT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(phone, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'****'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">RIGHT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(phone, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> masked_phone</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> users;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 邮箱脱敏</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    user_id,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    CONCAT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">LEFT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(email, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'***@'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, SPLIT_PART(email, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'@'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> masked_email</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> users;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- IP 地址泛化</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    event_id,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#7