or:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e.layerId);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">layerId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">layerExps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">entries</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(layerGroups)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bucket</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hash</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">layerId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}_${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">userId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 10000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> exp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> layerExps) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (exp.status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'running'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">matchTargeting</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userId, exp.targetingRules)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> allocation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> exp.trafficAllocation.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bucket </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.rangeStart </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bucket </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.rangeEnd);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (allocation) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          experimentId: exp.id,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          groupId: allocation.groupId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          bucket,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 分流引擎&#10;        UID[用户 ID] --&gt; H1[哈希-层1]&#10;        UID --&gt; H2[哈希-层2]&#10;        H1 --&gt; B1[桶号 0-9999]&#10;        H2 --&gt; B2[桶号 0-9999]&#10;        B1 --&gt; A1[实验 A 分组]&#10;        B2 --&gt; A2[实验 B 分组]&#10;    end\">graph LR\n    subgraph 分流引擎\n        UID[用户 ID] --&gt; H1[哈希-层1]\n        UID --&gt; H2[哈希-层2]\n        H1 --&gt; B1[桶号 0-9999]\n        H2 --&gt; B2[桶号 0-9999]\n        B1 --&gt; A1[实验 A 分组]\n        B2 --&gt; A2[实验 B 分组]\n    end</pre><h2 id=\"配置下发与-sdk-设计\">配置下发与 SDK 设计</h2><p>实验配置的下发链路直接影响实验的时效性和用户体验。两种主要的下发模式：</p>\n<p><strong>Pull 模式</strong>：客户端定期拉取最新的实验配置。实现简单，但存在延迟——如果拉取间隔为 5 分钟，紧急停止实验最多需要等 5 分钟才能生效。</p>\n<p><strong>Push 模式</strong>：服务端主动推送配置变更。实时性好，但需要维护长连接，增加了服务端的复杂度。</p>\n<p>实际中常用的是<strong>混合模式</strong>：启动时全量拉取 + 运行时增量推送 + 定期全量同步兜底。</p>\n<table>\n<thead>\n<tr>\n<th>下发模式</th>\n<th>实时性</th>\n<th>服务端复杂度</th>\n<th>客户端复杂度</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Pull（定期拉取）</td>\n<td>分钟级</td>\n<td>低</td>\n<td>低</td>\n<td>低频变更</td>\n</tr>\n<tr>\n<td>Push（主动推送）</td>\n<td>秒级</td>\n<td>高</td>\n<td>中</td>\n<td>实时性要求高</td>\n</tr>\n<tr>\n<td>混合模式</td>\n<td>秒级</td>\n<td>中高</td>\n<td>中</td>\n<td>大规模平台</td>\n</tr>\n<tr>\n<td>边缘缓存</td>\n<td>秒级</td>\n<td>中</td>\n<td>低</td>\n<td>CDN/边缘计算</td>\n</tr>\n</tbody></table>\n<p>SDK 设计的关键考量：</p>\n<ul>\n<li><strong>本地缓存</strong>：缓存最近的分组结果，避免网络请求阻塞页面渲染</li>\n<li><strong>默认值策略</strong>：配置拉取失败时使用预设的默认值（通常为对照组）</li>\n<li><strong>曝光日志</strong>：只有当用户实际看到了实验变体时才记录曝光，避免意图分配（intent-to-treat）与实际曝光（as-treated）的偏差</li>\n<li><strong>批量上报</strong>：事件先缓存在本地，批量上报以减少网络请求</li>\n</ul>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ExperimentSDK {&#10;  getVariant(experimentId: string, defaultVariant?: string): string;&#10;  trackExposure(experimentId: string): void;&#10;  trackEvent(eventName: string, properties?: Record&lt;string, unknown&gt;): void;&#10;  refreshConfig(): Promise&lt;void&gt;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ExperimentSDK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getVariant</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">experimentId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">defaultVariant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  trackExposure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">experimentId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  trackEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">eventName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">properties</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  refreshConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"数据管道与质量保障\">数据管道与质量保障</h2><p>从用户行为到实验报告，数据需要经过收集、传输、清洗、聚合和存储等多个环节。每个环节都可能引入误差，数据质量是实验结论可靠性的基础。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    CLIENT[客户端事件] --&gt; COLLECT[事件收集器]&#10;    SERVER[服务端事件] --&gt; COLLECT&#10;    COLLECT --&gt; QUEUE[消息队列&lt;br/&gt;Kafka]&#10;    QUEUE --&gt; ETL[ETL 处理&lt;br/&gt;清洗/聚合]&#10;    ETL --&gt; DW[数据仓库&lt;br/&gt;Hive/ClickHouse]&#10;    DW --&gt; COMPUTE[统计计算]&#10;    COMPUTE --&gt; REPORT[实验报告]\">graph LR\n    CLIENT[客户端事件] --&gt; COLLECT[事件收集器]\n    SERVER[服务端事件] --&gt; COLLECT\n    COLLECT --&gt; QUEUE[消息队列&lt;br/&gt;Kafka]\n    QUEUE --&gt; ETL[ETL 处理&lt;br/&gt;清洗/聚合]\n    ETL --&gt; DW[数据仓库&lt;br/&gt;Hive/ClickHouse]\n    DW --&gt; COMPUTE[统计计算]\n    COMPUTE --&gt; REPORT[实验报告]</pre><p>数据质量检查的关键环节：</p>\n<table>\n<thead>\n<tr>\n<th>检查点</th>\n<th>检查内容</th>\n<th>异常处理</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>样本比例检查（SRM）</td>\n<td>实验组/对照组样本比例是否符合预期</td>\n<td>暂停实验，排查分流问题</td>\n</tr>\n<tr>\n<td>数据完整性</td>\n<td>事件是否存在丢失或重复</td>\n<td>去重、补数</td>\n</tr>\n<tr>\n<td>指标一致性</td>\n<td>汇总指标与明细数据是否一致</td>\n<td>重新计算</td>\n</tr>\n<tr>\n<td>时间戳检查</td>\n<td>事件时间是否在实验有效期内</td>\n<td>过滤异常数据</td>\n</tr>\n<tr>\n<td>用户去重</td>\n<td>同一用户是否被分到多个互斥组</td>\n<td>以首次分组为准</td>\n</tr>\n</tbody></table>\n<p><strong>SRM（Sample Ratio Mismatch）</strong> 是最重要的数据质量检查。如果实验设计为 50/50 分组，但实际观测到 51/49，这可能是随机波动；但如果观测到 55/45，则几乎可以确定存在技术问题（如某个分组的用户更容易触发事件、或分流逻辑有 bug）。通过卡方检验可以精确判断样本比例偏差是否显著。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((实验平台架构))&#10;    分流引擎&#10;      哈希分桶&#10;      正交分层&#10;      流量管理&#10;    配置下发&#10;      Pull 模式&#10;      Push 模式&#10;      混合模式&#10;    SDK 设计&#10;      本地缓存&#10;      曝光日志&#10;      批量上报&#10;    数据管道&#10;      事件收集&#10;      ETL 处理&#10;      质量检查&#10;    质量保障&#10;      SRM 检查&#10;      数据完整性&#10;      指标一致性\">mindmap\n  root((实验平台架构))\n    分流引擎\n      哈希分桶\n      正交分层\n      流量管理\n    配置下发\n      Pull 模式\n      Push 模式\n      混合模式\n    SDK 设计\n      本地缓存\n      曝光日志\n      批量上报\n    数据管道\n      事件收集\n      ETL 处理\n      质量检查\n    质量保障\n      SRM 检查\n      数据完整性\n      指标一致性</pre><ul>\n<li>实验平台的核心组件包括分流引擎、配置中心、SDK、数据管道和分析引擎</li>\n<li>分流引擎需要满足确定性、正交性和灵活性三个要求</li>\n<li>配置下发推荐混合模式：启动全量拉取 + 运行时增量推送 + 定期兜底同步</li>\n<li>SDK 设计需关注本地缓存、默认值策略、曝光日志和批量上报</li>\n<li>SRM 检查是最关键的数据质量验证，样本比例异常通常意味着技术问题</li>\n<li>数据管道的每个环节都可能引入误差，端到端的质量检查不可或缺</li>\n</ul>\n","headings":[{"level":1,"text":"实验平台架构设计","id":"实验平台架构设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"分流引擎设计","id":"分流引擎设计"},{"level":2,"text":"配置下发与 SDK 设计","id":"配置下发与-sdk-设计"},{"level":2,"text":"数据管道与质量保障","id":"数据管道与质量保障"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"统计功效分析","url":"/l-doc-books/h/cross-discipline/ab-testing-experimentation/statistics-foundations/statistical-power-analysis"},"next":{"title":"Feature Flag 系统","url":"/l-doc-books/h/cross-discipline/ab-testing-experimentation/experiment-platforms/feature-flag-systems"}}