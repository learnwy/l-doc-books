:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">user) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AppError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">404</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'User not found'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'USER_NOT_FOUND'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>错误处理的最佳实践包括：区分业务错误和系统错误、对外隐藏内部实现细节、记录完整的错误上下文用于调试。业务错误（如资源不存在、参数校验失败）应返回明确的错误码和人类可读的消息；系统错误（如数据库连接失败）应返回通用的 500 错误并记录详细日志。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((HTTP 请求管道))&#10;    请求接收&#10;      TCP 连接管理&#10;      Keep-Alive 复用&#10;      HTTP/2 多路复用&#10;    请求解析&#10;      Header/Body 解析&#10;      Schema 验证&#10;      流式处理&#10;    路由匹配&#10;      Trie 前缀树&#10;      参数化路由&#10;      路由分组&#10;    响应构建&#10;      内容序列化&#10;      压缩编码&#10;      ETag 缓存&#10;    错误处理&#10;      统一错误格式&#10;      业务/系统错误分离&#10;      上下文日志\">mindmap\n  root((HTTP 请求管道))\n    请求接收\n      TCP 连接管理\n      Keep-Alive 复用\n      HTTP/2 多路复用\n    请求解析\n      Header/Body 解析\n      Schema 验证\n      流式处理\n    路由匹配\n      Trie 前缀树\n      参数化路由\n      路由分组\n    响应构建\n      内容序列化\n      压缩编码\n      ETag 缓存\n    错误处理\n      统一错误格式\n      业务/系统错误分离\n      上下文日志</pre><ul>\n<li>HTTP 请求管道由接收、解析、路由、处理、响应五个阶段构成，每个阶段职责明确</li>\n<li>Keep-Alive 和 HTTP/2 多路复用是连接层面的核心优化手段</li>\n<li>请求验证应尽早执行，使用 Schema 验证同时实现数据校验和接口文档化</li>\n<li>Trie 路由算法提供 O(n) 时间复杂度的高效匹配</li>\n<li>响应压缩和 ETag 机制有效减少网络传输量</li>\n<li>统一错误处理确保异常在管道中的可控传播</li>\n<li>理解请求管道的每个阶段是构建高性能后端服务的基础</li>\n</ul>\n","headings":[{"level":1,"text":"HTTP 请求管道","id":"http-请求管道"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"请求接收与连接管理","id":"请求接收与连接管理"},{"level":2,"text":"请求解析与验证","id":"请求解析与验证"},{"level":2,"text":"路由匹配与分发","id":"路由匹配与分发"},{"level":2,"text":"响应构建与发送","id":"响应构建与发送"},{"level":2,"text":"错误处理与异常传播","id":"错误处理与异常传播"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"中间件模式","url":"/l-doc-books/h/cross-discipline/backend-architecture-patterns/request-lifecycle/middleware-patterns"}}