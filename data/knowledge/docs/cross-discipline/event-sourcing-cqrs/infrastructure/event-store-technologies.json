color:#24292E;--shiki-dark:#E1E4E8\">        timestamp: Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      headers: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'event-type'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: event.eventType,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'stream-id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: streamId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> producer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ topic, messages });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> readStream</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">streamId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> events</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PersistedEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> consumer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">subscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ topic: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">topicPrefix</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}.events`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e.streamId </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> streamId);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph Kafka Topic&#10;        P0[Partition 0] --&gt; |order-a, order-d| C0[Consumer 0]&#10;        P1[Partition 1] --&gt; |order-b, order-e| C1[Consumer 1]&#10;        P2[Partition 2] --&gt; |order-c, order-f| C2[Consumer 2]&#10;    end&#10;    A[Producer] --&gt; |key=streamId| P0&#10;    A --&gt; |key=streamId| P1&#10;    A --&gt; |key=streamId| P2\">graph LR\n    subgraph Kafka Topic\n        P0[Partition 0] --&gt; |order-a, order-d| C0[Consumer 0]\n        P1[Partition 1] --&gt; |order-b, order-e| C1[Consumer 1]\n        P2[Partition 2] --&gt; |order-c, order-f| C2[Consumer 2]\n    end\n    A[Producer] --&gt; |key=streamId| P0\n    A --&gt; |key=streamId| P1\n    A --&gt; |key=streamId| P2</pre><p>Kafka 的优势在于极高的吞吐量、成熟的运维生态和强大的消费者组机制。但它作为事件存储有固有的局限：无法按流读取（需要消费整个分区过滤），不支持乐观并发控制（需要外部机制），保留策略可能导致旧事件被清理。</p>\n<h2 id=\"postgresql-自建方案\">PostgreSQL 自建方案</h2><p>对于大多数初创项目，基于 PostgreSQL 自建事件存储是最务实的选择。团队对 PostgreSQL 的运维经验可以直接复用，且灵活的查询能力为调试和运维提供了极大便利。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const createPostgresSchema = `&#10;  CREATE TABLE IF NOT EXISTS event_streams (&#10;    stream_id VARCHAR(255) PRIMARY KEY,&#10;    stream_type VARCHAR(100) NOT NULL,&#10;    created_at TIMESTAMPTZ DEFAULT NOW()&#10;  );&#10;&#10;  CREATE TABLE IF NOT EXISTS events (&#10;    global_position BIGSERIAL PRIMARY KEY,&#10;    event_id UUID NOT NULL UNIQUE,&#10;    stream_id VARCHAR(255) NOT NULL REFERENCES event_streams(stream_id),&#10;    event_type VARCHAR(100) NOT NULL,&#10;    stream_version INTEGER NOT NULL,&#10;    data JSONB NOT NULL,&#10;    metadata JSONB NOT NULL DEFAULT &#39;{}&#39;,&#10;    created_at TIMESTAMPTZ DEFAULT NOW(),&#10;    UNIQUE(stream_id, stream_version)&#10;  );&#10;&#10;  CREATE INDEX idx_events_stream_id ON events(stream_id, stream_version);&#10;  CREATE INDEX idx_events_event_type ON events(event_type);&#10;`;&#10;&#10;const createPostgresSubscription = (&#10;  pool: Pool,&#10;  channel: string,&#10;  handler: (event: PersistedEvent) =&gt; Promise&lt;void&gt;,&#10;): { start: () =&gt; Promise&lt;void&gt;; stop: () =&gt; Promise&lt;void&gt; } =&gt; {&#10;  let client: PoolClient | null = null;&#10;&#10;  return {&#10;    async start() {&#10;      client = await pool.connect();&#10;      await client.query(`LISTEN ${channel}`);&#10;      client.on(&#39;notification&#39;, async (msg) =&gt; {&#10;        if (msg.channel === channel &amp;&amp; msg.payload) {&#10;          const event = JSON.parse(msg.payload) as PersistedEvent;&#10;          await handler(event);&#10;        }&#10;      });&#10;    },&#10;    async stop() {&#10;      if (client) {&#10;        await client.query(`UNLISTEN ${channel}`);&#10;        client.release();&#10;      }&#10;    },&#10;  };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> createPostgresSchema</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE TABLE IF NOT EXISTS event_streams (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    stream_id VARCHAR(255) PRIMARY KEY,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    stream_type VARCHAR(100) NOT NULL,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    created_at TIMESTAMPTZ DEFAULT NOW()</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  );</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE TABLE IF NOT EXISTS events (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    global_position BIGSERIAL PRIMARY KEY,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    event_id UUID NOT NULL UNIQUE,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    stream_id VARCHAR(255) NOT NULL REFERENCES event_streams(stream_id),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    event_type VARCHAR(100) NOT NULL,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    stream_version INTEGER NOT NULL,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    data JSONB NOT NULL,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    metadata JSONB NOT NULL DEFAULT '{}',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    created_at TIMESTAMPTZ DEFAULT NOW(),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    UNIQUE(stream_id, stream_version)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  );</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE INDEX idx_events_stream_id ON events(stream_id, stream_version);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE INDEX idx_events_event_type ON events(event_type);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createPostgresSubscription</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  pool</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dar