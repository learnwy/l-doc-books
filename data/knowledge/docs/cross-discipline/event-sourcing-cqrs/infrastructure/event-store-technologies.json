r:#24292E;--shiki-dark:#E1E4E8\"> client.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`LISTEN ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">channel</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      client.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'notification'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">msg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (msg.channel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> channel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> msg.payload) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(msg.payload) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PersistedEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(event);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> stop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (client) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> client.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`UNLISTEN ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">channel</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        client.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">release</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>PostgreSQL 优势</th>\n<th>PostgreSQL 局限</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>团队已有运维经验</td>\n<td>无原生事件流语义</td>\n</tr>\n<tr>\n<td>灵活 SQL 调试</td>\n<td>订阅能力有限</td>\n</tr>\n<tr>\n<td>JSONB 存储灵活</td>\n<td>高吞吐场景性能瓶颈</td>\n</tr>\n<tr>\n<td>事务保证强</td>\n<td>需自行实现竞争消费</td>\n</tr>\n<tr>\n<td>生态工具丰富</td>\n<td>无内置投影引擎</td>\n</tr>\n</tbody></table>\n<p>PostgreSQL 方案的核心限制是订阅能力——NOTIFY/LISTEN 不保证消息不丢失，适合非关键路径的实时推送。对于关键投影，仍需使用轮询 + 检查点的方式。</p>\n<h2 id=\"选型决策框架\">选型决策框架</h2><p>根据团队规模、系统阶段和技术约束，可以用以下决策流程指导选型：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    A{团队规模} --&gt; |小团队/起步| B[PostgreSQL]&#10;    A --&gt; |中等团队| C{吞吐需求}&#10;    A --&gt; |大团队/平台化| D[Kafka + 自定义层]&#10;    C --&gt; |&lt;10K events/s| E[EventStoreDB]&#10;    C --&gt; |&gt;10K events/s| D&#10;    B --&gt; F[成长后可迁移]&#10;    F --&gt; E&#10;    F --&gt; D\">graph TB\n    A{团队规模} --&gt; |小团队/起步| B[PostgreSQL]\n    A --&gt; |中等团队| C{吞吐需求}\n    A --&gt; |大团队/平台化| D[Kafka + 自定义层]\n    C --&gt; |&lt;10K events/s| E[EventStoreDB]\n    C --&gt; |&gt;10K events/s| D\n    B --&gt; F[成长后可迁移]\n    F --&gt; E\n    F --&gt; D</pre><p>选型不是一锤子买卖——从 PostgreSQL 起步，在系统成熟后根据实际瓶颈迁移到 EventStoreDB 或 Kafka，是很多成功项目的路径。关键是从第一天就设计好事件存储的抽象接口，使底层实现可替换。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((技术选型))&#10;    EventStoreDB&#10;      原生事件流&#10;      内置投影&#10;      社区较小&#10;    Kafka&#10;      极高吞吐&#10;      成熟生态&#10;      无流语义&#10;    PostgreSQL&#10;      低门槛起步&#10;      灵活查询&#10;      订阅受限&#10;    决策要素&#10;      团队能力&#10;      系统规模&#10;      抽象接口\">mindmap\n  root((技术选型))\n    EventStoreDB\n      原生事件流\n      内置投影\n      社区较小\n    Kafka\n      极高吞吐\n      成熟生态\n      无流语义\n    PostgreSQL\n      低门槛起步\n      灵活查询\n      订阅受限\n    决策要素\n      团队能力\n      系统规模\n      抽象接口</pre><ul>\n<li>EventStoreDB 是唯一专为事件溯源设计的数据库，原生支持事件流、投影和竞争消费</li>\n<li>Kafka 的高吞吐量适合大规模系统，但缺乏流级别的乐观并发和按流读取能力</li>\n<li>PostgreSQL 自建方案最适合起步阶段，团队可以复用现有运维经验</li>\n<li>选型的核心是团队能力和系统规模，而非技术先进性</li>\n<li>无论选择哪种方案，从第一天就设计好事件存储抽象接口，为未来迁移预留空间</li>\n<li>从 PostgreSQL 起步 → 成长后按需迁移，是被验证的务实路径</li>\n</ul>\n","headings":[{"level":1,"text":"事件存储技术选型","id":"事件存储技术选型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"EventStoreDB 深度分析","id":"eventstoredb-深度分析"},{"level":2,"text":"Kafka 作为事件存储","id":"kafka-作为事件存储"},{"level":2,"text":"PostgreSQL 自建方案","id":"postgresql-自建方案"},{"level":2,"text":"选型决策框架","id":"选型决策框架"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"CQRS 实现","url":"/l-doc-books/h/cross-discipline/event-sourcing-cqrs/cqrs-patterns/cqrs-implementation"},"next":{"title":"消息代理集成","url":"/l-doc-books/h/cross-discipline/event-sourcing-cqrs/infrastructure/message-broker-integration"}}