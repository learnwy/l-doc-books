 new Error(&#39;Order must contain at least one item&#39;);&#10;    }&#10;    this.raiseEvent({&#10;      eventType: &#39;OrderCreated&#39;,&#10;      payload: {&#10;        customerId: command.customerId,&#10;        items: command.items,&#10;        totalAmount: this.calculateTotal(command.items),&#10;        currency: command.currency,&#10;      },&#10;    });&#10;  }&#10;&#10;  confirmOrder(): void {&#10;    if (this.state.status !== &#39;created&#39;) {&#10;      throw new Error(`Cannot confirm order in ${this.state.status} status`);&#10;    }&#10;    this.raiseEvent({ eventType: &#39;OrderConfirmed&#39;, payload: {} });&#10;  }&#10;&#10;  private raiseEvent(partial: Partial&lt;DomainEvent&gt;): void {&#10;    const event = {&#10;      ...partial,&#10;      eventId: crypto.randomUUID(),&#10;      aggregateId: this.id,&#10;      version: this.version + 1,&#10;      timestamp: new Date(),&#10;    } as DomainEvent;&#10;    this.apply(event);&#10;    this.uncommittedEvents.push(event);&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderAggregate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> uncommittedEvents</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DomainEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"