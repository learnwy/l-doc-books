\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'full'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  evolutionPolicy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>交互模式</th>\n<th>适用场景</th>\n<th>沟通频率</th>\n<th>耦合度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>协作式</td>\n<td>两个团队探索新领域</td>\n<td>高（每日）</td>\n<td>中</td>\n</tr>\n<tr>\n<td>X-as-a-Service</td>\n<td>成熟的服务提供方</td>\n<td>低（按需）</td>\n<td>低</td>\n</tr>\n<tr>\n<td>促进式</td>\n<td>赋能团队辅导业务团队</td>\n<td>中期密集</td>\n<td>临时</td>\n</tr>\n</tbody></table>\n<h2 id=\"组织架构与限界上下文的协同演进\">组织架构与限界上下文的协同演进</h2><p>在大规模组织中，组织架构和系统架构需要协同演进。逆康威定律（Inverse Conway Maneuver）建议主动调整组织结构以获得期望的系统架构。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 协同演进的触发信号&#10;type EvolutionSignal =&#10;  | &#39;team_too_large&#39; // 团队超过 9 人&#10;  | &#39;cross_team_changes_frequent&#39; // 跨团队变更频率过高&#10;  | &#39;deployment_coupling&#39; // 部署耦合&#10;  | &#39;communication_bottleneck&#39; // 沟通瓶颈&#10;  | &#39;cognitive_overload&#39;; // 团队认知过载&#10;&#10;interface EvolutionAction {&#10;  signal: EvolutionSignal;&#10;  teamAction: string;&#10;  architectureAction: string;&#10;}&#10;&#10;const evolutionPlaybook: EvolutionAction[] = [&#10;  {&#10;    signal: &#39;team_too_large&#39;,&#10;    teamAction: &#39;拆分为两个流对齐团队&#39;,&#10;    architectureAction: &#39;相应拆分限界上下文&#39;,&#10;  },&#10;  {&#10;    signal: &#39;cross_team_changes_frequent&#39;,&#10;    teamAction: &#39;考虑合并团队或建立协作通道&#39;,&#10;    architectureAction: &#39;评估是否应合并上下文或提取共享内核&#39;,&#10;  },&#10;  {&#10;    signal: &#39;deployment_coupling&#39;,&#10;    teamAction: &#39;明确 API 契约和版本策略&#39;,&#10;    architectureAction: &#39;引入防腐层隔离变更传播&#39;,&#10;  },&#10;  {&#10;    signal: &#39;communication_bottleneck&#39;,&#10;    teamAction: &#39;建立平台团队提供自助服务&#39;,&#10;    architectureAction: &#39;将瓶颈能力平台化（开放主机服务）&#39;,&#10;  },&#10;  {&#10;    signal: &#39;cognitive_overload&#39;,&#10;    teamAction: &#39;限制团队拥有的上下文数量（最多 2 个）&#39;,&#10;    architectureAction: &#39;提取复杂子系统为独立上下文&#39;,&#10;  },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 协同演进的触发信号</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EvolutionSignal</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'team_too_large'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 团队超过 9 人</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'cross_team_changes_frequent'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 跨团队变更频率过高</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'deployment_coupling'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 部署耦合</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'communication_bottleneck'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 沟通瓶颈</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  |</span><span st