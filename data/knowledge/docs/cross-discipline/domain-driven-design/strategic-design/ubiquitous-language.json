:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> promotion.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">isExcluded</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">productId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (excludedItems.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">items</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DiscountEligibility.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ineligible</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'所有商品均在排除列表中'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> eligibleAmount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">totalAmountExcluding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(excludedItems);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DiscountEligibility.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">eligible</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(promotion.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">calculateDiscount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eligibleAmount));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    A[业务规则描述] --&gt; B[统一语言术语表]&#10;    B --&gt; C[领域模型设计]&#10;    C --&gt; D[代码实现]&#10;    D --&gt; E[测试用例]&#10;    E --&gt;|反馈| A&#10;    B --&gt; F[API 契约]&#10;    B --&gt; G[事件名称]&#10;    B --&gt; H[数据库字段]\">graph TB\n    A[业务规则描述] --&gt; B[统一语言术语表]\n    B --&gt; C[领域模型设计]\n    C --&gt; D[代码实现]\n    D --&gt; E[测试用例]\n    E --&gt;|反馈| A\n    B --&gt; F[API 契约]\n    B --&gt; G[事件名称]\n    B --&gt; H[数据库字段]</pre><p>一致性的检查清单：</p>\n<table>\n<thead>\n<tr>\n<th>检查项</th>\n<th>示例（正确）</th>\n<th>示例（违反）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>类名反映领域概念</td>\n<td><code>Order</code>, <code>ReturnRequest</code></td>\n<td><code>OrderEntity</code>, <code>DataObject</code></td>\n</tr>\n<tr>\n<td>方法名反映业务动作</td>\n<td><code>placeOrder()</code>, <code>cancelOrder()</code></td>\n<td><code>process()</code>, <code>execute()</code></td>\n</tr>\n<tr>\n<td>参数名反映业务含义</td>\n<td><code>shippingAddress</code>, <code>paymentReceipt</code></td>\n<td><code>param1</code>, <code>inputData</code></td>\n</tr>\n<tr>\n<td>事件名反映已发生的事实</td>\n<td><code>OrderPlaced</code>, <code>PaymentReceived</code></td>\n<td><code>OrderEvent</code>, <code>StatusChanged</code></td>\n</tr>\n<tr>\n<td>异常名反映业务规则违反</td>\n<td><code>InsufficientInventory</code></td>\n<td><code>BusinessException</code></td>\n</tr>\n</tbody></table>\n<h2 id=\"领域专家协作模式\">领域专家协作模式</h2><p>建立统一语言需要结构化的协作流程。以下是经过验证的协作模式。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 模式一：领域对话（Domain Storytelling）&#10;// 领域专家讲述业务故事，开发者记录并提炼术语&#10;// &quot;仓库管理员每天早上检查库存水位，&#10;//  如果某个 SKU 的可用库存低于安全库存，&#10;//  就生成一个补货申请发给采购部门。&quot;&#10;&#10;// 提炼出的领域概念：&#10;interface InventoryLevel {&#10;  sku: SKU;&#10;  availableQuantity: number;&#10;  safetyStock: number;&#10;&#10;  isBelowSafetyStock(): boolean;&#10;}&#10;&#10;interface ReplenishmentRequest {&#10;  sku: SKU;&#10;  requestedQuantity: number;&#10;  requestedBy: WarehouseKeeper;&#10;  status: &#39;pending&#39; | &#39;approved&#39; | &#39;rejected&#39;;&#10;}&#10;&#10;// 模式二：示例映射（Example Mapping）&#10;// 用具体的业务示例来验证术语的精确性&#10;// 规则：订单总金额超过 500 元免运费&#10;// 示例 1：订单 480 元 → 收运费 10 元&#10;// 示例 2：订单 500 元 → 免运费&#10;// 示例 3：订单 480 元 + 优惠券减 20 元 = 实付 460 元 → 收运费？&#10;// （发现歧义：免运费的&quot;总金额&quot;是优惠前还是优惠后？需要澄清）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 模式一：领域对话（Domain Storytelling）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 领域专家讲述业务故事，开发者记录并提炼术语</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"仓库管理员每天早上检查库存水位，</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//  如果某个 SKU 的可用库存低于安全库存，</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//  就生成一个补货申请发给采购部门。\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 提炼出的领域概念：</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InventoryLevel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  sku</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SKU</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  availableQuantity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  safetyStock</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  isBelowSafetyStock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReplenishmentRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  sku</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SKU</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  requestedQuantity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  requestedBy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> WarehouseKeeper</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pending'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'approved'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'rejected'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 模式二：示例映射（Example Mapping）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 用具体的业务示例来验证术语的精确性</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 规则：订单总金额超过 500 元免运费</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 示例 1：订单 480 元 → 收运费 10 元</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 示例 2：订单 500 元 → 免运费</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 示例 3：订单 480 元 + 优惠券减 20 元 = 实付 460 元 → 收运费？</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// （发现歧义：免运费的\"总金额\"是优惠前还是优惠后？需要澄清）</span></span></code></pre></div><p>协作的反模式：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 反模式一：开发者单方面定义术语&#10;// 领域专家从不参与代码审查，代码中的术语与业务脱节&#10;&#10;// 反模式二：技术黑话入侵业务语言&#10;// &quot;我们需要一个 handler 来 process 这个 entity 的 state transition&quot;&#10;// 应改为：&quot;我们需要在订单确认时更新库存预留状态&quot;&#10;&#10;// 反模式三：术语表停留在文档不更新&#10;// 术语表写好后就没人维护，代码已经演进但术语表还是旧版\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 反模式一：开发者单方面定义术语</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 领域专家从不参与代码审查，代码中的术语与业务脱节</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 反模式二：技术黑话入侵业务语言</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"我们需要一个 handler 来 process 这个 entity 的 state transition\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 应改为：\"我们需要在订单确认时更新库存预留状态\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 反模式三：术语表停留在文档不更新</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 术语表写好后就没人维护，代码已经演进但术语表还是旧版</span></span></code></pre></div><h2 id=\"统一语言的边界与演进\">统一语言的边界与演进</h2><p>统一语言有明确的适用范围——它只在一个限界上下文内有效。不同上下文可以（而且经常）对同一个词有不同的定义。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 在&quot;交易上下文&quot;中&#10;interface Account {&#10;  balance: Money;&#10;  deposit(amount: Money): void;&#10;  withdraw(amount: Money): void;&#10;}&#10;&#10;// 在&quot;身份认证上下文&quot;中&#10;interface Account {&#10;  email: Email;&#10;  passwordHash: string;&#10;  login(credentials: Credentials): AuthToken;&#10;  resetPassword(token: ResetToken): void;&#10;}&#10;&#10;// 两个 Account 在各自上下文中含义完全不同&#10;// 这不是命名冲突，而是限界上下文的正常表现\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在\"交易上下文\"中</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Account</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  balance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  deposit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  withdraw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在\"身份认证上下文\"中</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Account</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  email</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Email</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  passwordHash</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  login</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">credentials</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Credentials</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AuthToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  resetPassword</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">token</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ResetToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 两个 Account 在各自上下文中含义完全不同</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 这不是命名冲突，而是限界上下文的正常表现</span></span></code></pre></div><p>语言演进的治理机制：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface LanguageGovernance {&#10;  glossaryLocation: string; // 术语表存放位置&#10;  updateFrequency: &#39;weekly&#39; | &#39;biweekly&#39;;&#10;  reviewProcess: {&#10;    proposer: &#39;anyone&#39;; // 任何人可提议新术语&#10;    reviewer: &#39;domain_expert&#39;; // 领域专家审核&#10;    approver: &#39;team_lead&#39;; // 技术负责人批准代码变更&#10;  };&#10;  codeEnforcement: {&#10;    lintRules: boolean; // 是否有命名规范 lint&#10;    codeReviewChecklist: boolean; // 代码审查是否检查术语一致性&#10;    automatedGlossarySync: boolean; // 是否自动同步术语表&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LanguageGovernance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  glossaryLocation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 术语表存放位置</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  updateFrequency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'weekly'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'biweekly'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  reviewProcess</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    proposer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'anyone'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 任何人可提议新术语</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    reviewer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'domain_expert'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 领域专家审核</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    approver</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'team_lead'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 技术负责人批准代码变更</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  codeEnforcement</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    lintRules</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 是否有命名规范 lint</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    codeReviewChecklist</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 代码审查是否检查术语一致性</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    automatedGlossarySync</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 是否自动同步术语表</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((统一语言))&#10;    提炼过程&#10;      领域对话&#10;      示例映射&#10;      术语表迭代&#10;    一致性目标&#10;      类名 = 领域概念&#10;      方法名 = 业务动作&#10;      事件名 = 已发生事实&#10;    协作模式&#10;      领域专家参与设计&#10;      代码审查检查术语&#10;      定期回顾更新&#10;    边界&#10;      上下文内有效&#10;      不同上下文可重名&#10;      持续演进\">mindmap\n  root((统一语言))\n    提炼过程\n      领域对话\n      示例映射\n      术语表迭代\n    一致性目标\n      类名 = 领域概念\n      方法名 = 业务动作\n      事件名 = 已发生事实\n    协作模式\n      领域专家参与设计\n      代码审查检查术语\n      定期回顾更新\n    边界\n      上下文内有效\n      不同上下文可重名\n      持续演进</pre><ul>\n<li>统一语言是 DDD 的基石，要求业务和技术使用同一套术语</li>\n<li>语言提炼是持续迭代过程，通过领域对话和示例映射逐步精确</li>\n<li>代码应该成为领域模型的直接表达，让领域专家能读懂核心逻辑</li>\n<li>统一语言只在限界上下文内有效，不同上下文中同一词可有不同含义</li>\n<li>领域专家必须深度参与术语定义和代码审查，避免技术团队单方面定义</li>\n<li>建立术语表治理机制，确保语言随业务演进持续更新</li>\n</ul>\n","headings":[{"level":1,"text":"统一语言","id":"统一语言"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"语言提炼过程","id":"语言提炼过程"},{"level":2,"text":"代码与业务语言一致性","id":"代码与业务语言一致性"},{"level":2,"text":"领域专家协作模式","id":"领域专家协作模式"},{"level":2,"text":"统一语言的边界与演进","id":"统一语言的边界与演进"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"子域分类","url":"/l-doc-books/h/cross-discipline/domain-driven-design/strategic-design/subdomain-classification"},"next":{"title":"实体与值对象","url":"/l-doc-books/h/cross-discipline/domain-driven-design/tactical-patterns/entities-and-value-objects"}}