yle=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  cancel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">reason</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CancellationReason</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* 取消订单 */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>语言提炼的关键步骤：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 第一步：收集原始术语&#10;// 在工作坊中，让领域专家用自然语言描述业务流程&#10;// &quot;顾客在购物车里选好商品后，提交订单。系统验证库存，&#10;//  如果库存充足就锁定库存，生成待支付订单。&quot;&#10;&#10;// 第二步：识别核心概念并建立词汇表&#10;interface DomainGlossary {&#10;  terms: GlossaryEntry[];&#10;}&#10;&#10;interface GlossaryEntry {&#10;  term: string; // 统一术语&#10;  definition: string; // 在此上下文中的精确含义&#10;  aliases: string[]; // 同义词（标记为已废弃）&#10;  context: string; // 所属限界上下文&#10;  examples: string[]; // 使用示例&#10;}&#10;&#10;// 第三步：在代码中强制使用统一术语&#10;// 代码审查中拒绝不符合统一语言的命名\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 第一步：收集原始术语</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在工作坊中，让领域专家用自然语言描述业务流程</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"顾客在购物车里选好商品后，提交订单。系统验证库存，</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//  如果库存充足就锁定库存，生成待支付订单。\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 第二步：识别核心概念并建立词汇表</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DomainGlossary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  terms</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GlossaryEntry</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GlossaryEntry</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  term</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 统一术语</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  definition</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在此上下文中的精确含义</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  aliases</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 同义词（标记为已废弃）</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  context</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 所属限界上下文</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  examples</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用示例</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 第三步：在代码中强制使用统一术语</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 代码审查中拒绝不符合统一语言的命名</span></span></code></pre></div><h2 id=\"代码与业务语言一致性\">代码与业务语言一致性</h2><p>统一语言的终极目标是让代码成为领域模型的直接表达。当领域专家能读懂核心业务代码（即使不懂语法细节），统一语言就达到了目标。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 业务规则：&quot;VIP 客户在大促期间享受满减优惠，&#10;// 但需要满足最低消费金额且商品不在排除列表中&quot;&#10;&#10;// 统一语言直接映射为代码&#10;class PromotionPolicy {&#10;  canApplyDiscount(customer: Customer, order: Order, promotion: Promotion): DiscountEligibility {&#10;    if (!customer.isVIP()) {&#10;      return DiscountEligibility.ineligible(&#39;非 VIP 客户&#39;);&#10;    }&#10;&#10;    if (!promotion.isActive()) {&#10;      return DiscountEligibility.ineligible(&#39;促销活动未开始或已结束&#39;);&#10;    }&#10;&#10;    if (order.totalAmount().isLessThan(promotion.minimumSpend())) {&#10;      return DiscountEligibility.ineligible(&#39;未达到最低消费金额&#39;);&#10;    }&#10;&#10;    const excludedItems = order.items().filter((item) =&gt; promotion.isExcluded(item.productId()));&#10;&#10;    if (excludedItems.length === order.items().length) {&#10;      return DiscountEligibility.ineligible(&#39;所有商品均在排除列表中&#39;);&#10;    }&#10;&#10;    const eligibleAmount = order.totalAmountExcluding(excludedItems);&#10;    return DiscountEligibility.eligible(promotion.calculateDiscount(eligibleAmount));&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 业务规则：\"VIP 客户在大促期间享受满减优惠，</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 但需要满足最低消费金额且商品不在排除列表中\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 统一语言直接映射为代码</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PromotionPolicy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  canApplyDiscount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">customer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Customer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">order</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">promotion</s