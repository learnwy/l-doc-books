g'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createPickupSchedule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(orderId);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createPickupSchedule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">orderId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PickupSchedule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { orderId, scheduledAt: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), carrier: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'default'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>当下游完全没有话语权时，客户-供应商退化为**遵奉者（Conformist）**模式——下游被迫接受上游的模型，即使它不完全适合自己的领域。</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>客户-供应商</th>\n<th>遵奉者</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>话语权</td>\n<td>双方协商</td>\n<td>上游主导</td>\n</tr>\n<tr>\n<td>模型适配</td>\n<td>上游适度调整</td>\n<td>下游被迫适应</td>\n</tr>\n<tr>\n<td>典型场景</td>\n<td>内部团队协作</td>\n<td>使用第三方 SaaS API</td>\n</tr>\n<tr>\n<td>风险</td>\n<td>协商成本</td>\n<td>模型污染</td>\n</tr>\n</tbody></table>\n<h2 id=\"防腐层模式\">防腐层模式</h2><p>防腐层（Anti-Corruption Layer, ACL）是保护己方模型不被外部系统污染的关键模式。它在两个上下文之间建立一个翻译层，将外部模型转换为内部模型。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 外部支付网关的模型（我们无法控制）&#10;interface ExternalPaymentResponse {&#10;  txn_id: string;&#10;  amt: number;&#10;  ccy: string;&#10;  sts: &#39;S&#39; | &#39;F&#39; | &#39;P&#39;;&#10;  ts: number;&#10;}&#10;&#10;// 我们的领域模型&#10;interface PaymentResult {&#10;  readonly transactionId: TransactionId;&#10;  readonly amount: Money;&#10;  readonly status: PaymentStatus;&#10;  readonly completedAt: Date;&#10;}&#10;&#10;type PaymentStatus = &#39;succeeded&#39; | &#39;failed&#39; | &#39;pending&#39;;&#10;&#10;// 防腐层：翻译外部模型到内部模型&#10;class PaymentGatewayACL {&#10;  translatePaymentResponse(external: ExternalPaymentResponse): PaymentResult {&#10;    return {&#10;      transactionId: TransactionId.create(external.txn_id),&#10;      amount: Money.create(external.amt, external.ccy),&#10;      status: this.mapStatus(external.sts),&#10;      completedAt: new Date(external.ts * 1000),&#10;    };&#10;  }&#10;&#10;  private mapStatus(externalStatus: string): PaymentStatus {&#10;    const mapping: Record&lt;string, PaymentStatus&gt; = {&#10;      S: &#39;succeeded&#39;,&#10;      F: &#39;failed&#39;,&#10;      P: &#39;pending&#39;,&#10;    };&#10;    const status = mapping[externalStatus];&#10;    if (!status) throw new Error(`Unknown payment status: ${externalStatus}`);&#10;    return status;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 外部支付网关的模型（我们无法控制）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ExternalPaymentResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  txn_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  amt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  ccy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  sts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'S'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'F'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'P'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  ts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--sh