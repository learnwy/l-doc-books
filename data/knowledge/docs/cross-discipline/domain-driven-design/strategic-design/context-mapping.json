/div><table>\n<thead>\n<tr>\n<th>集成方式</th>\n<th>同步/异步</th>\n<th>耦合度</th>\n<th>一致性</th>\n<th>推荐场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>直接 API 调用</td>\n<td>同步</td>\n<td>高</td>\n<td>强</td>\n<td>低延迟查询</td>\n</tr>\n<tr>\n<td>领域事件</td>\n<td>异步</td>\n<td>低</td>\n<td>最终</td>\n<td>业务流程编排</td>\n</tr>\n<tr>\n<td>共享数据库</td>\n<td>同步</td>\n<td>最高</td>\n<td>强</td>\n<td>极不推荐</td>\n</tr>\n<tr>\n<td>消息队列</td>\n<td>异步</td>\n<td>低</td>\n<td>最终</td>\n<td>高吞吐解耦</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((上下文映射))&#10;    协作模式&#10;      共享内核&#10;      客户-供应商&#10;      遵奉者&#10;    隔离模式&#10;      防腐层&#10;      各行其道&#10;    标准化模式&#10;      开放主机服务&#10;      发布语言&#10;    集成策略&#10;      同步 API&#10;      领域事件&#10;      消息队列\">mindmap\n  root((上下文映射))\n    协作模式\n      共享内核\n      客户-供应商\n      遵奉者\n    隔离模式\n      防腐层\n      各行其道\n    标准化模式\n      开放主机服务\n      发布语言\n    集成策略\n      同步 API\n      领域事件\n      消息队列</pre><ul>\n<li>上下文映射描述限界上下文之间的关系，是战略设计的集成蓝图</li>\n<li>共享内核耦合度最高，仅适用于紧密协作且共享模型很小的场景</li>\n<li>客户-供应商是最常见的上下游模式，遵奉者是其退化形态</li>\n<li>防腐层是对外集成的核心防线，翻译外部模型以保护内部领域纯洁性</li>\n<li>开放主机服务搭配发布语言，为多下游提供标准化集成接口</li>\n<li>选择集成策略需综合考虑团队关系、一致性要求和延迟容忍度</li>\n</ul>\n","headings":[{"level":1,"text":"上下文映射","id":"上下文映射"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"共享内核模式","id":"共享内核模式"},{"level":2,"text":"客户-供应商与遵奉者模式","id":"客户-供应商与遵奉者模式"},{"level":2,"text":"防腐层模式","id":"防腐层模式"},{"level":2,"text":"开放主机服务与发布语言","id":"开放主机服务与发布语言"},{"level":2,"text":"集成策略选择","id":"集成策略选择"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"限界上下文","url":"/l-doc-books/h/cross-discipline/domain-driven-design/strategic-design/bounded-context"},"next":{"title":"子域分类","url":"/l-doc-books/h/cross-discipline/domain-driven-design/strategic-design/subdomain-classification"}}