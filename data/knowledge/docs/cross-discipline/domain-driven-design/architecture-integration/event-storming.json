:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  space</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    wallLength</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 至少 6-8 米连续墙面</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    stickyNotes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 8 种颜色各 100 张</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    markers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 粗头马克笔，人手一支</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> workshopBestPractices</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '所有人站着工作，保持能量和参与度'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '先发散后收敛——头脑风暴阶段不评判'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '关注领域事件而非技术实现'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '红色便利贴标记分歧点，不当场解决'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'facilitator 保持中立，引导而非主导'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '拍照记录每个阶段的墙面状态'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '工作坊后 48 小时内整理成数字文档'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>时间</th>\n<th>产出</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>事件头脑风暴</td>\n<td>30-60 min</td>\n<td>50-200 个领域事件</td>\n</tr>\n<tr>\n<td>时间线排序</td>\n<td>30-45 min</td>\n<td>业务流程图</td>\n</tr>\n<tr>\n<td>命令与聚合</td>\n<td>60-90 min</td>\n<td>命令-聚合-事件映射</td>\n</tr>\n<tr>\n<td>上下文边界</td>\n<td>30-60 min</td>\n<td>限界上下文划分</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((事件风暴))&#10;    流程&#10;      事件头脑风暴&#10;      时间线排序&#10;      命令与聚合&#10;      上下文边界&#10;    产出&#10;      领域事件清单&#10;      聚合识别&#10;      限界上下文划分&#10;      热点与问题&#10;    映射到代码&#10;      事件 → DomainEvent&#10;      命令 → 聚合方法&#10;      聚合 → AggregateRoot&#10;      策略 → DomainService&#10;    实践要点&#10;      领域专家必须参与&#10;      先发散后收敛&#10;      便利贴颜色规范\">mindmap\n  root((事件风暴))\n    流程\n      事件头脑风暴\n      时间线排序\n      命令与聚合\n      上下文边界\n    产出\n      领域事件清单\n      聚合识别\n      限界上下文划分\n      热点与问题\n    映射到代码\n      事件 → DomainEvent\n      命令 → 聚合方法\n      聚合 → AggregateRoot\n      策略 → DomainService\n    实践要点\n      领域专家必须参与\n      先发散后收敛\n      便利贴颜色规范</pre><ul>\n<li>事件风暴是连接业务需求和 DDD 模型设计的协作式工作坊</li>\n<li>通过彩色便利贴在墙上建模，降低参与门槛，让非技术人员也能贡献</li>\n<li>四阶段流程：事件发现 → 时间线排序 → 命令与聚合 → 上下文边界</li>\n<li>产出直接映射为代码：橙色事件 → DomainEvent，蓝色命令 → 聚合方法</li>\n<li>自然浮现的上下文边界是事件风暴最有价值的发现</li>\n<li>领域专家的深度参与是工作坊成功的关键前提</li>\n</ul>\n","headings":[{"level":1,"text":"事件风暴","id":"事件风暴"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"工作坊流程","id":"工作坊流程"},{"level":2,"text":"从事件风暴到代码","id":"从事件风暴到代码"},{"level":2,"text":"限界上下文的发现","id":"限界上下文的发现"},{"level":2,"text":"工作坊实践要点","id":"工作坊实践要点"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"防腐层","url":"/l-doc-books/h/cross-discipline/domain-driven-design/architecture-integration/anti-corruption-layer"},"next":{"title":"TypeScript 中的 DDD","url":"/l-doc-books/h/cross-discipline/domain-driven-design/implementation/ddd-in-typescript"}}