"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        serverAddress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">http://prometheus:9090</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        metricName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">order_processing_queue_size</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        threshold</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'50'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          sum(order_processing_queue_size)</span></span></code></pre></div><h3 id=\"keda-支持的事件源\">KEDA 支持的事件源</h3><table>\n<thead>\n<tr>\n<th>事件源</th>\n<th>伸缩依据</th>\n<th>典型场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Kafka</td>\n<td>Topic 消费延迟</td>\n<td>消息处理器</td>\n</tr>\n<tr>\n<td>RabbitMQ</td>\n<td>队列消息数</td>\n<td>任务处理器</td>\n</tr>\n<tr>\n<td>Redis</td>\n<td>List/Stream 长度</td>\n<td>异步任务</td>\n</tr>\n<tr>\n<td>PostgreSQL</td>\n<td>查询结果</td>\n<td>数据处理</td>\n</tr>\n<tr>\n<td>Prometheus</td>\n<td>自定义指标</td>\n<td>任何可度量的场景</td>\n</tr>\n<tr>\n<td>Cron</td>\n<td>定时计划</td>\n<td>预期峰值时间预热</td>\n</tr>\n<tr>\n<td>HTTP</td>\n<td>并发请求数</td>\n<td>API 服务</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"伸缩策略\">伸缩策略</h2><h3 id=\"预热和冷却\">预热和冷却</h3><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>说明</th>\n<th>配置</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>扩容预热</td>\n<td>新 Pod 启动后需要时间&quot;热身&quot;</td>\n<td>readinessProbe + 预热脚本</td>\n</tr>\n<tr>\n<td>缩容冷却</td>\n<td>缩容前等待一段时间确认不再需要</td>\n<td>stabilizationWindow</td>\n</tr>\n<tr>\n<td>定时预热</td>\n<td>在预期高峰前提前扩容</td>\n<td>CronJob + HPA minReplicas</td>\n</tr>\n<tr>\n<td>缓慢缩容</td>\n<td>逐步减少副本而非一次性减到最小</td>\n<td>scaleDown policy</td>\n</tr>\n</tbody></table>\n<h3 id=\"定时预热配置\">定时预热配置</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"apiVersion: keda.sh/v1alpha1&#10;kind: ScaledObject&#10;metadata:&#10;  name: web-app-scheduled&#10;spec:&#10;  scaleTargetRef:&#10;    name: web-app&#10;  triggers:&#10;    - type: cron&#10;      metadata:&#10;        timezone: Asia/Shanghai&#10;        start: 0 8 * * 1-5&#10;        end: 0 22 * * 1-5&#10;        desiredReplicas: &#39;10&#39;&#10;    - type: cron&#10;      metadata:&#10;        timezone: Asia/Shanghai&#10;        start: 0 22 * * 1-5&#10;        end: 0 8 * * 2-6&#10;        desiredReplicas: &#39;3&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">apiVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">keda.sh/v1alpha1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">kind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ScaledObject</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">web-app-scheduled</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">spec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  scaleTargetRef</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">web-app</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  triggers</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">cron</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        timezone</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Asia/Shanghai</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        start</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">0 8 * * 1-5</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">0 22 * * 1-5</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        desiredReplicas</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'10'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">cron</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        timezone</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Asia/Shanghai</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        start</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">0 22 * * 1-5</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">0 8 * * 2-6</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        desiredReplicas</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'3'</span></span></code></pre></div><h3 id=\"伸缩速率控制\">伸缩速率控制</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[流量突增] --&gt; B{扩容策略}&#10;    B --&gt; C[快速扩容&lt;br/&gt;60 秒内倍增]&#10;    A --&gt; D[流量下降] --&gt; E{缩容策略}&#10;    E --&gt; F[缓慢缩容&lt;br/&gt;5 分钟稳定窗口&lt;br/&gt;每次最多减 2 个]\">graph TD\n    A[流量突增] --&gt; B{扩容策略}\n    B --&gt; C[快速扩容&lt;br/&gt;60 秒内倍增]\n    A --&gt; D[流量下降] --&gt; E{缩容策略}\n    E --&gt; F[缓慢缩容&lt;br/&gt;5 分钟稳定窗口&lt;br/&gt;每次最多减 2 个]</pre><p><strong>核心原则</strong>：扩容要快，缩容要慢。扩容不及时会导致服务降级，缩容过快会导致流量反弹时再次不足。</p>\n<hr>\n<h2 id=\"自动伸缩的常见问题\">自动伸缩的常见问题</h2><table>\n<thead>\n<tr>\n<th>问题</th>\n<th>说明</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>伸缩震荡</td>\n<td>频繁扩容缩容</td>\n<td>增加稳定窗口时间</td>\n</tr>\n<tr>\n<td>冷启动延迟</td>\n<td>新 Pod 启动慢影响响应时间</td>\n<td>预热池、优化启动时间</td>\n</tr>\n<tr>\n<td>指标延迟</td>\n<td>指标采集有延迟导致伸缩滞后</td>\n<td>减小采集间隔、使用预测性伸缩</td>\n</tr>\n<tr>\n<td>资源不足</td>\n<td>集群没有足够节点分配给新 Pod</td>\n<td>配合 Cluster Autoscaler</td>\n</tr>\n<tr>\n<td>数据库瓶颈</td>\n<td>应用扩容后数据库成为瓶颈</td>\n<td>数据库连接池管理、读写分离</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>自动伸缩是云原生环境中平衡性能和成本的核心机制。HPA 适合无状态服务的水平扩展，VPA 适合有状态服务的垂直调整，KEDA 适合事件驱动场景。伸缩策略的核心原则是&quot;扩容要快、缩容要慢&quot;。通过合理的预热、冷却和稳定窗口配置，可以避免伸缩震荡。自动伸缩不是万能的——它需要配合良好的应用设计（快速启动、无状态）和基础设施支撑（Cluster Autoscaler）才能发挥最大效果。</p>\n","headings":[{"level":1,"text":"自动伸缩","id":"自动伸缩"},{"level":2,"text":"为什么需要自动伸缩","id":"为什么需要自动伸缩"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Kubernetes 自动伸缩体系","id":"kubernetes-自动伸缩体系"},{"level":2,"text":"HPA（水平 Pod 自动伸缩）","id":"hpa-水平-pod-自动伸缩"},{"level":3,"text":"工作原理","id":"工作原理"},{"level":3,"text":"计算公式","id":"计算公式"},{"level":3,"text":"HPA 配置","id":"hpa-配置"},{"level":3,"text":"HPA 参数说明","id":"hpa-参数说明"},{"level":2,"text":"VPA（垂直 Pod 自动伸缩）","id":"vpa-垂直-pod-自动伸缩"},{"level":3,"text":"HPA vs VPA","id":"hpa-vs-vpa"},{"level":2,"text":"KEDA（事件驱动自动伸缩）","id":"keda-事件驱动自动伸缩"},{"level":3,"text":"KEDA 支持的事件源","id":"keda-支持的事件源"},{"level":2,"text":"伸缩策略","id":"伸缩策略"},{"level":3,"text":"预热和冷却","id":"预热和冷却"},{"level":3,"text":"定时预热配置","id":"定时预热配置"},{"level":3,"text":"伸缩速率控制","id":"伸缩速率控制"},{"level":2,"text":"自动伸缩的常见问题","id":"自动伸缩的常见问题"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"负载预测","url":"/l-doc-books/h/cross-discipline/devops-sre/capacity-planning/load-forecasting"},"next":{"title":"成本优化","url":"/l-doc-books/h/cross-discipline/devops-sre/capacity-planning/cost-optimization"}}