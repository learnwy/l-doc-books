em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">K</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span><span class=\"mord mathnormal mtight\">s</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 为纤维/样品分配系数，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>V</mi><mi>f</mi></msub></mrow><annotation encoding=\"application/x-tex\">V_f</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">V</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.2222em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 为涂层体积，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding=\"application/x-tex\">C_0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 为初始浓度，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>V</mi><mi>s</mi></msub></mrow><annotation encoding=\"application/x-tex\">V_s</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">V</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.2222em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">s</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 为样品体积。当 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>V</mi><mi>s</mi></msub><mo>≫</mo><msub><mi>K</mi><mrow><mi>f</mi><mi>s</mi></mrow></msub><msub><mi>V</mi><mi>f</mi></msub></mrow><annotation encoding=\"application/x-tex\">V_s \\gg K_{fs} V_f</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">V</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.2222em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">s</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≫</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">K</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span><span class=\"mord mathnormal mtight\">s</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">V</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.2222em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1076em;\">f</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 时，萃取量与初始浓度成正比，不受样品体积影响。</p>\n<h3 id=\"quechers-方法\">QuEChERS 方法</h3><p>QuEChERS（Quick, Easy, Cheap, Effective, Rugged, Safe）方法是 2003 年由 Anastassiades 等人提出的食品样品前处理方法。其基本流程为：样品加入乙腈振荡萃取 → 加入 MgSO₄ 和 NaCl 盐析分层 → 取乙腈相经分散固相萃取（d-SPE）净化 → 直接进样。</p>\n<p>QuEChERS 将传统需要数小时的样品前处理缩短到 15 分钟，被全球食品安全检测实验室广泛采用，特别适合农药多残留分析（一次前处理可覆盖上百种农药的 GC-MS/MS 和 LC-MS/MS 检测）。</p>\n<h3 id=\"超临界流体萃取-sfe\">超临界流体萃取（SFE）</h3><p>超临界流体萃取利用超临界 CO₂（临界温度 31.1°C，临界压力 7.38 MPa）作为萃取剂。超临界 CO₂ 兼具气体的高扩散性和液体的溶解能力，可通过调节温度和压力精确控制其溶剂强度。SFE 特别适合天然产物中脂溶性活性成分的提取，如咖啡因脱除、精油提取、药用植物活性成分提取等。降压后 CO₂ 气化逸出，萃取物无溶剂残留。</p>\n<h2 id=\"新型萃取技术\">新型萃取技术</h2><h3 id=\"磁性固相萃取-mspe\">磁性固相萃取（MSPE）</h3><p>将磁性纳米粒子（Fe₃O₄）表面修饰吸附涂层后分散到样品溶液中，目标物吸附于磁性粒子表面后，用外加磁场将粒子快速回收，无需过滤或离心。MSPE 操作简便、速度快（数分钟完成），特别适合大体积水样中痕量污染物的富集。</p>\n<h3 id=\"分散液-液微萃取-dllme\">分散液-液微萃取（DLLME）</h3><p>将少量萃取溶剂（如氯苯）与分散剂（如丙酮）快速注入水样中，形成乳化微滴状态，极大增加了液-液接触面积，使目标物在数秒内达到分配平衡。离心后收集沉积的有机相进样分析。DLLME 富集倍数高（100-1000 倍）、溶剂用量极少（μL 级）。</p>\n<h2 id=\"实际应用案例\">实际应用案例</h2><h3 id=\"临床诊断中的电泳\">临床诊断中的电泳</h3><p>毛细管电泳在临床实验室中用于血清蛋白电泳（SPE）、血红蛋白变体分析（如地中海贫血筛查）和免疫固定电泳（检测单克隆免疫球蛋白异常）。其高通量、全自动化的特点使之成为大型医院检验科的标准配置。</p>\n<h3 id=\"环境水样中-pops-的富集\">环境水样中 POPs 的富集</h3><p>环境水样中持久性有机污染物（如多环芳烃 PAHs）浓度通常在 ng/L 至 μg/L 水平，必须经过萃取浓缩后才能被仪器检测到。典型流程：1 L 水样经 C₁₈ SPE 柱（500 mg 填料）富集 → 5 mL 二氯甲烷洗脱 → 氮吹浓缩至 0.5 mL → GC-MS 分析，富集倍数达 2000 倍。</p>\n<h3 id=\"生物样品中药物代谢物的分析\">生物样品中药物代谢物的分析</h3><p>血浆样品含有大量蛋白质和脂质，直接进样会堵塞色谱柱并产生严重的基质效应。蛋白沉淀（加入 3 倍体积乙腈或甲醇）是最简便的前处理方式，但净化效果有限；对于高灵敏度定量需求，通常采用 SPE 或液-液萃取进行更彻底的净化后再进行 LC-MS/MS 分析。</p>\n<h2 id=\"小结\">小结</h2><p>电泳技术以电场驱动带电粒子分离，在生物大分子分析中具有独特优势；萃取技术则通过相间分配实现目标物从复杂基质中的选择性富集和净化。从经典的凝胶电泳到高效的毛细管电泳，从传统液-液萃取到微型化的 SPME 和 DLLME，分离科学持续向着更快速、更灵敏、更环保的方向发展。这些技术作为色谱和质谱分析的前端模块，直接决定了最终分析结果的准确性和可靠性。</p>\n","headings":[{"level":1,"text":"电泳与萃取分离（Electrophoresis & Extraction）","id":"电泳与萃取分离-electrophoresis-extraction"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"电泳分离技术概述","id":"电泳分离技术概述"},{"level":2,"text":"凝胶电泳","id":"凝胶电泳"},{"level":3,"text":"SDS-PAGE","id":"sds-page"},{"level":3,"text":"琼脂糖凝胶电泳","id":"琼脂糖凝胶电泳"},{"level":3,"text":"二维电泳（2-DE）","id":"二维电泳-2-de"},{"level":2,"text":"毛细管电泳","id":"毛细管电泳"},{"level":3,"text":"毛细管区带电泳（CZE）","id":"毛细管区带电泳-cze"},{"level":3,"text":"毛细管胶束电动色谱（MEKC）","id":"毛细管胶束电动色谱-mekc"},{"level":3,"text":"毛细管等电聚焦（cIEF）","id":"毛细管等电聚焦-cief"},{"level":2,"text":"萃取分离技术","id":"萃取分离技术"},{"level":3,"text":"液-液萃取（LLE）","id":"液-液萃取-lle"},{"level":3,"text":"固相萃取（SPE）","id":"固相萃取-spe"},{"level":3,"text":"固相微萃取（SPME）","id":"固相微萃取-spme"},{"level":3,"text":"QuEChERS 方法","id":"quechers-方法"},{"level":3,"text":"超临界流体萃取（SFE）","id":"超临界流体萃取-sfe"},{"level":2,"text":"新型萃取技术","id":"新型萃取技术"},{"level":3,"text":"磁性固相萃取（MSPE）","id":"磁性固相萃取-mspe"},{"level":3,"text":"分散液-液微萃取（DLLME）","id":"分散液-液微萃取-dllme"},{"level":2,"text":"实际应用案例","id":"实际应用案例"},{"level":3,"text":"临床诊断中的电泳","id":"临床诊断中的电泳"},{"level":3,"text":"环境水样中 POPs 的富集","id":"环境水样中-pops-的富集"},{"level":3,"text":"生物样品中药物代谢物的分析","id":"生物样品中药物代谢物的分析"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"高效液相色谱与气相色谱（HPLC & GC）","url":"/l-doc-books/h/chemistry/analytical-chemistry/separation-techniques/hplc-gc"},"next":{"title":"电离方法（Ionization Methods）","url":"/l-doc-books/h/chemistry/analytical-chemistry/mass-spectrometry/ionization-methods"}}