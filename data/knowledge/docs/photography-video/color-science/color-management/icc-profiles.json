.1081em;\"><span style=\"top:-3.322em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight x-arrow-pad\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">Output Profile</span></span></span></span></span><span class=\"svg-align\" style=\"top:-2.689em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"hide-tail\" style=\"height:0.522em;min-width:1.469em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"0.522em\" viewBox=\"0 0 400000 522\" preserveAspectRatio=\"xMaxYMin slice\"><path d=\"M0 241v40h399891c-47.3 35.3-84 78-110 128\n-16.7 32-27.7 63.7-33 95 0 1.3-.2 2.7-.5 4-.3 1.3-.5 2.3-.5 3 0 7.3 6.7 11 20\n 11 8 0 13.2-.8 15.5-2.5 2.3-1.7 4.2-5.5 5.5-11.5 2-13.3 5.7-27 11-41 14.7-44.7\n 39-84.5 73-119.5s73.7-60.2 119-75.5c6-2 9-5.7 9-11s-3-9-9-11c-45.3-15.3-85\n-40.5-119-75.5s-58.3-74.8-73-119.5c-4.7-14-8.3-27.3-11-40-1.3-6.7-3.2-10.8-5.5\n-12.5-2.3-1.7-7.5-2.5-15.5-2.5-14 0-21 3.7-21 11 0 2 2 10.3 6 25 20.7 83.3 67\n 151.7 139 205zm0 0v40h399900v-40z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.011em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">Display/Print</span></span></span></span></span></span></div><table>\n<thead>\n<tr>\n<th>环节</th>\n<th>Profile 类型</th>\n<th>关键操作</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>拍摄</td>\n<td>相机 Profile</td>\n<td>使用 ColorChecker 拍摄参考</td>\n</tr>\n<tr>\n<td>导入</td>\n<td>—</td>\n<td>RAW 解码时应用相机 Profile</td>\n</tr>\n<tr>\n<td>编辑</td>\n<td>工作空间</td>\n<td>ProPhoto RGB 16-bit</td>\n</tr>\n<tr>\n<td>软打样</td>\n<td>打印机 Profile</td>\n<td>模拟打印效果</td>\n</tr>\n<tr>\n<td>输出屏幕</td>\n<td>显示器 Profile</td>\n<td>sRGB/P3 转换</td>\n</tr>\n<tr>\n<td>输出打印</td>\n<td>打印机 Profile</td>\n<td>感知或相对色度</td>\n</tr>\n</tbody></table>\n<h3 id=\"常见错误\">常见错误</h3><table>\n<thead>\n<tr>\n<th>错误</th>\n<th>后果</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>忽略 Profile 嵌入</td>\n<td>颜色在其他设备失真</td>\n<td>始终嵌入 Profile</td>\n</tr>\n<tr>\n<td>未校色的显示器</td>\n<td>编辑基于错误参考</td>\n<td>每月校色一次</td>\n</tr>\n<tr>\n<td>工作空间过小</td>\n<td>编辑时损失信息</td>\n<td>使用 ProPhoto/P3</td>\n</tr>\n<tr>\n<td>强制分配错误 Profile</td>\n<td>色彩全面失真</td>\n<td>区分&quot;分配&quot;vs&quot;转换&quot;</td>\n</tr>\n<tr>\n<td>双重 Gamma 校正</td>\n<td>画面过亮或过暗</td>\n<td>确认线性/编码状态</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"软打样-soft-proofing\">软打样（Soft Proofing）</h2><h3 id=\"原理\">原理</h3><p>软打样是在校准过的显示器上模拟打印输出效果——通过应用打印机 Profile 的色域限制和纸张白点，让摄影师在打印前预知结果：</p>\n<table>\n<thead>\n<tr>\n<th>步骤</th>\n<th>作用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>加载打印机 Profile</td>\n<td>定义输出色域</td>\n</tr>\n<tr>\n<td>选择渲染意图</td>\n<td>决定域外处理</td>\n</tr>\n<tr>\n<td>模拟纸白</td>\n<td>显示纸张颜色（非显示器白）</td>\n</tr>\n<tr>\n<td>模拟墨黑</td>\n<td>显示最深黑度（非显示器黑）</td>\n</tr>\n<tr>\n<td>域外警告</td>\n<td>高亮显示无法打印的区域</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"总结\">总结</h2><p>ICC 色彩管理的核心理念是&quot;设备无关&quot;——通过标准化的配置文件和连接空间，实现颜色在不同设备间的一致再现。</p>\n<table>\n<thead>\n<tr>\n<th>组件</th>\n<th>角色</th>\n<th>关键属性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ICC Profile</td>\n<td>设备色彩身份证</td>\n<td>类型/精度/版本</td>\n</tr>\n<tr>\n<td>PCS</td>\n<td>中转翻译空间</td>\n<td>Lab D50 或 XYZ D50</td>\n</tr>\n<tr>\n<td>渲染意图</td>\n<td>域外处理策略</td>\n<td>感知/相对/绝对/饱和</td>\n</tr>\n<tr>\n<td>校色仪</td>\n<td>生成准确 Profile</td>\n<td>精度/HDR支持</td>\n</tr>\n<tr>\n<td>软打样</td>\n<td>屏幕模拟输出</td>\n<td>渲染意图+纸张模拟</td>\n</tr>\n</tbody></table>\n","headings":[{"level":1,"text":"ICC 配置文件与色彩管理系统","id":"icc-配置文件与色彩管理系统"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"ICC Profile 结构","id":"icc-profile-结构"},{"level":3,"text":"Profile 类型","id":"profile-类型"},{"level":3,"text":"版本演进","id":"版本演进"},{"level":3,"text":"Profile Connection Space (PCS)","id":"profile-connection-space-pcs"},{"level":2,"text":"渲染意图（Rendering Intent）","id":"渲染意图-rendering-intent"},{"level":3,"text":"四种标准意图","id":"四种标准意图"},{"level":3,"text":"摄影中的选择","id":"摄影中的选择"},{"level":2,"text":"显示器校色","id":"显示器校色"},{"level":3,"text":"校色流程","id":"校色流程"},{"level":3,"text":"校色目标参数","id":"校色目标参数"},{"level":3,"text":"主流校色仪对比（2025-2026）","id":"主流校色仪对比-2025-2026"},{"level":2,"text":"色彩管理实战工作流","id":"色彩管理实战工作流"},{"level":3,"text":"端到端管理流程","id":"端到端管理流程"},{"level":3,"text":"常见错误","id":"常见错误"},{"level":2,"text":"软打样（Soft Proofing）","id":"软打样-soft-proofing"},{"level":3,"text":"原理","id":"原理"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"色彩空间与色域","url":"/l-doc-books/h/photography-video/color-science/color-management/color-spaces-gamut"},"next":{"title":"显示器校色实践","url":"/l-doc-books/h/photography-video/color-science/color-management/monitor-calibration"}}