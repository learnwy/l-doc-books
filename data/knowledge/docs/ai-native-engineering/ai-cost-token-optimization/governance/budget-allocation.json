: number): Promise&lt;void&gt;;&#10;&#10;  // 释放未用配额（调用失败时）&#10;  release(reservationId: string): Promise&lt;void&gt;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QuotaAPI</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 查询剩余配额</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getRemaining</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">entityId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    budget_usd</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    spent_usd</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    remaining_usd</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    remaining_pct</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    resets_at</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 预扣配额（调用前）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  reserve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    entityId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    estimated_cost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    approved</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    reservation_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    degraded_model</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 如果降级</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 确认消费（调用后）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  confirm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">reservationId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">actual_cost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 释放未用配额（调用失败时）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  release</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">reservationId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"预算分配的组织实践\">预算分配的组织实践</h2><h3 id=\"按价值分配\">按价值分配</h3><p>不是平均分配预算，而是按业务价值排优先级：</p>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>业务价值</th>\n<th>预算占比</th>\n<th>降级优先级</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>核心付费功能</td>\n<td>直接营收</td>\n<td>40%</td>\n<td>最后降级</td>\n</tr>\n<tr>\n<td>用户留存功能</td>\n<td>间接营收</td>\n<td>25%</td>\n<td>中等</td>\n</tr>\n<tr>\n<td>内部工具</td>\n<td>效率提升</td>\n<td>20%</td>\n<td>优先降级</td>\n</tr>\n<tr>\n<td>实验功能</td>\n<td>未验证</td>\n<td>10%</td>\n<td>首先降级</td>\n</tr>\n<tr>\n<td>安全/合规</td>\n<td>风险管控</td>\n<td>5%</td>\n<td>不降级</td>\n</tr>\n</tbody></table>\n<h3 id=\"预算审批流程\">预算审批流程</h3><ul>\n<li><strong>&lt; $1,000/月增量</strong>：团队 lead 审批</li>\n<li><strong><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>1</mn><mo separator=\"true\">,</mo><mn>000</mn><mo>−</mo></mrow><annotation encoding=\"application/x-tex\">1,000-</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8389em;vertical-align:-0.1944em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">000</span><span class=\"mord\">−</span></span></span></span></span>5,000/月增量</strong>：部门负责人审批 + ROI 估算</li>\n<li><strong>&gt; $5,000/月增量</strong>：VP 审批 + 详细 TCO 分析</li>\n</ul>\n<h3 id=\"月度成本复盘\">月度成本复盘</h3><p>每月固定时间进行成本复盘：</p>\n<ol>\n<li>总成本 vs 预算：是否超支</li>\n<li>各团队/项目消耗排名：谁花最多</li>\n<li>单位成本趋势：效率是否在改善</li>\n<li>异常事件回顾：本月发生了什么突增</li>\n<li>下月预算调整建议</li>\n</ol>\n<h2 id=\"与-finops-实践的对齐\">与 FinOps 实践的对齐</h2><p>LLM 成本管理本质上是 FinOps 的一个子领域。核心原则一致：</p>\n<table>\n<thead>\n<tr>\n<th>FinOps 原则</th>\n<th>LLM 成本应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>每个人都对成本负责</td>\n<td>开发者可以看到自己代码的 LLM 成本</td>\n</tr>\n<tr>\n<td>集中管理分散消费</td>\n<td>统一计量 + 分布式消费 + 集中可视</td>\n</tr>\n<tr>\n<td>及时决策</td>\n<td>实时仪表板而非月底账单</td>\n</tr>\n<tr>\n<td>按业务价值优化</td>\n<td>优先优化低 ROI 的 LLM 调用</td>\n</tr>\n<tr>\n<td>持续改进</td>\n<td>月度复盘 + 季度策略调整</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>预算治理的三层防线：配额分配决定&quot;谁能花多少&quot;（按业务价值而非平均分配）；实时追踪回答&quot;已经花了多少&quot;（速率限制防突发）；熔断策略决定&quot;超限怎么办&quot;（渐进降级优于硬切断）。会话级熔断是 Agent 系统的必备安全网。月度复盘将预算治理从被动审计转为主动优化——对齐 FinOps 的&quot;持续改进&quot;原则。</p>\n<hr>\n<blockquote>\n<p>相关文档：<a href=\"cost-observability\">成本可观测性</a> 预算控制的前提是准确的成本计量和归因</p>\n</blockquote>\n","headings":[{"level":1,"text":"预算分配与熔断机制","id":"预算分配与熔断机制"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"预算是设计约束，不是事后审计","id":"预算是设计约束-不是事后审计"},{"level":2,"text":"多层级配额体系","id":"多层级配额体系"},{"level":3,"text":"层级设计","id":"层级设计"},{"level":3,"text":"配额分配策略","id":"配额分配策略"},{"level":2,"text":"熔断策略设计","id":"熔断策略设计"},{"level":3,"text":"渐进式降级（优于硬切）","id":"渐进式降级-优于硬切"},{"level":3,"text":"会话级熔断（Agent 防护）","id":"会话级熔断-agent-防护"},{"level":2,"text":"速率限制与配额 API","id":"速率限制与配额-api"},{"level":3,"text":"Token 速率限制","id":"token-速率限制"},{"level":3,"text":"配额 API 设计","id":"配额-api-设计"},{"level":2,"text":"预算分配的组织实践","id":"预算分配的组织实践"},{"level":3,"text":"按价值分配","id":"按价值分配"},{"level":3,"text":"预算审批流程","id":"预算审批流程"},{"level":3,"text":"月度成本复盘","id":"月度成本复盘"},{"level":2,"text":"与 FinOps 实践的对齐","id":"与-finops-实践的对齐"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"成本可观测性","url":"/l-doc-books/h/ai-native-engineering/ai-cost-token-optimization/governance/cost-observability"},"next":{"title":"ROI 度量与优化决策","url":"/l-doc-books/h/ai-native-engineering/ai-cost-token-optimization/governance/roi-measurement"}}