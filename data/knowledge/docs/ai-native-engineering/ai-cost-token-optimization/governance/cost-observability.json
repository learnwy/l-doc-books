 usage),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        latency_ms: Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> start,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">metadata,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        success: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.records.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        timestamp: start,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        model: params.model,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        input_tokens: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        output_tokens: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        cached_tokens: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        total_cost_usd: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        latency_ms: Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> start,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">metadata,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        success: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> error;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"多维成本归因\">多维成本归因</h2><h3 id=\"维度一-按项目-功能模块\">维度一：按项目/功能模块</h3><p>回答&quot;哪个产品功能最烧钱&quot;：</p>\n<table>\n<thead>\n<tr>\n<th>功能模块</th>\n<th>日均调用</th>\n<th>日均成本</th>\n<th>单次均成本</th>\n<th>趋势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>智能客服</td>\n<td>50,000</td>\n<td>$300</td>\n<td>$0.006</td>\n<td>稳定</td>\n</tr>\n<tr>\n<td>内容生成</td>\n<td>8,000</td>\n<td>$480</td>\n<td>$0.060</td>\n<td>↑ 20%/周</td>\n</tr>\n<tr>\n<td>代码助手</td>\n<td>3,000</td>\n<td>$180</td>\n<td>$0.060</td>\n<td>稳定</td>\n</tr>\n<tr>\n<td>数据标注</td>\n<td>20,000</td>\n<td>$40</td>\n<td>$0.002</td>\n<td>↓ batch 化</td>\n</tr>\n<tr>\n<td>Agent 任务</td>\n<td>500</td>\n<td>$250</td>\n<td>$0.500</td>\n<td>↑ 50%/周</td>\n</tr>\n</tbody></table>\n<p>关键发现：Agent 任务调用量仅占 0.6%，但成本占比 19%——单次成本是客服的 83 倍。</p>\n<h3 id=\"维度二-按模型\">维度二：按模型</h3><p>回答&quot;模型选择是否合理&quot;：</p>\n<table>\n<thead>\n<tr>\n<th>模型</th>\n<th>调用占比</th>\n<th>成本占比</th>\n<th>成本/调用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>GPT-5.2</td>\n<td>5%</td>\n<td>45%</td>\n<td>$0.112</td>\n</tr>\n<tr>\n<td>Claude Sonnet</td>\n<td>20%</td>\n<td>30%</td>\n<td>$0.019</td>\n</tr>\n<tr>\n<td>GPT-5-mini</td>\n<td>50%</td>\n<td>15%</td>\n<td>$0.004</td>\n</tr>\n<tr>\n<td>GPT-5 Nano</td>\n<td>25%</td>\n<td>10%</td>\n<td>$0.005</td>\n</tr>\n</tbody></table>\n<p>如果 GPT-5.2 的调用中有 50% 可以降级到 Sonnet/Mini——立即省下 22% 总成本。</p>\n<h3 id=\"维度三-按用户-租户\">维度三：按用户/租户</h3><p>回答&quot;谁在花钱&quot;（SaaS 场景尤其重要）：</p>\n<ul>\n<li>Top 1% 用户贡献 30% 成本（幂律分布）</li>\n<li>检测异常用户：单用户日花费突增 &gt; 3 倍标准差 → 告警</li>\n</ul>\n<h3 id=\"维度四-按时间\">维度四：按时间</h3><p>回答&quot;什么时候花钱最多&quot;：</p>\n<ul>\n<li>工作日 vs 周末模式差异</li>\n<li>峰值时段识别（用于 batch 化迁移决策）</li>\n<li>突增检测（可能是循环 bug 或攻击）</li>\n</ul>\n<h2 id=\"异常检测与告警\">异常检测与告警</h2><h3 id=\"需要告警的模式\">需要告警的模式</h3><table>\n<thead>\n<tr>\n<th>异常类型</th>\n<th>检测方法</th>\n<th>告警阈值建议</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>成本突增</td>\n<td>小时成本 &gt; 7 天均值 × 3</td>\n<td>3x</td>\n</tr>\n<tr>\n<td>单请求异常</td>\n<td>单次成本 &gt; P99 × 5</td>\n<td>5x</td>\n</tr>\n<tr>\n<td>错误率飙升</td>\n<td>5min 错误率 &gt; 10%</td>\n<td>10%</td>\n</tr>\n<tr>\n<td>缓存命中率骤降</td>\n<td>命中率 &lt; 历史均值 - 2σ</td>\n<td>2σ</td>\n</tr>\n<tr>\n<td>Agent 循环</td>\n<td>同一 session 调用 &gt; N 次</td>\n<td>30 次</td>\n</tr>\n<tr>\n<td>Token 膨胀</td>\n<td>平均输入 token &gt; 历史 × 2</td>\n<td>2x</td>\n</tr>\n</tbody></table>\n<h3 id=\"agent-循环检测\">Agent 循环检测</h3><p>2025 年底的 $47,000 事故凸显了循环检测的重要性：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"MAX_CALLS_PER_SESSION = 50&#10;COST_CEILING_PER_SESSION = 5.0  # $5&#10;&#10;class AgentCircuitBreaker:&#10;    def __init__(self):&#10;        self.session_calls: dict[str, int] = {}&#10;        self.session_costs: dict[str, float] = {}&#10;&#10;    def check(self, session_id: str, call_cost: float) -&gt; bool:&#10;        self.session_calls[session_id] = self.session_calls.get(session_id, 0) + 1&#10;        self.session_costs[session_id] = self.session_costs.get(session_id, 0) + call_cost&#10;&#10;        if self.session_calls[session_id] &gt; MAX_CALLS_PER_SESSION:&#10;            raise BudgetExceededError(f&quot;Session {session_id}: too many calls&quot;)&#10;&#10;        if self.session_costs[session_id] &gt; COST_CEILING_PER_SESSION:&#10;            raise BudgetExceededError(f&quot;Session {session_id}: cost ceiling hit&quot;)&#10;&#10;        return True\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">MAX_CALLS_PER_SESSION</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 50</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">COST_CEILING_PER_SESSION</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 5.0</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # $5</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AgentCircuitBreaker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_calls: dict[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_costs: dict[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> check</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, session_id: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, call_cost: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">bool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_calls[session_id] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_calls.get(session_id, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_costs[session_id] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_costs.get(session_id, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> call_cost</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_calls[session_id] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MAX_CALLS_PER_SESSION</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            raise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> BudgetExceededError(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Session </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">session_id</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: too many calls\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.session_costs[session_id] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> COST_CEILING_PER_SESSION</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            raise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> BudgetExceededError(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Session </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">session_id</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: cost ceiling hit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> True</span></span></code></pre></div><h2 id=\"可观测性工具链\">可观测性工具链</h2><h3 id=\"开源方案\">开源方案</h3><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n<th>集成方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>OpenTelemetry</td>\n<td>分布式追踪 + 指标</td>\n<td>SDK 埋点</td>\n</tr>\n<tr>\n<td>Prometheus + Grafana</td>\n<td>指标存储 + 可视化</td>\n<td>中间件导出</td>\n</tr>\n<tr>\n<td>Langfuse</td>\n<td>LLM 专属可观测性</td>\n<td>SDK 集成</td>\n</tr>\n<tr>\n<td>LangSmith</td>\n<td>LangChain 生态可观测</td>\n<td>装饰器</td>\n</tr>\n<tr>\n<td>Phoenix (Arize)</td>\n<td>LLM trace + 评估</td>\n<td>OpenInference</td>\n</tr>\n</tbody></table>\n<h3 id=\"仪表板核心指标\">仪表板核心指标</h3><p>一个最小可用的 LLM 成本仪表板需要展示：</p>\n<ol>\n<li><strong>总成本趋势</strong>：日/周/月成本曲线</li>\n<li><strong>模型分布</strong>：各模型的调用量和成本占比</li>\n<li><strong>功能归因</strong>：Top 5 成本功能模块</li>\n<li><strong>效率指标</strong>：缓存命中率、批处理比例、路由分布</li>\n<li><strong>异常面板</strong>：最近 24h 的成本异常事件</li>\n</ol>\n<h2 id=\"从可观测到可行动\">从可观测到可行动</h2><p>可观测性的最终目标不是&quot;看到数据&quot;，而是<strong>驱动决策</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>观测到的现象</th>\n<th>对应行动</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>某功能成本占比 &gt; 30%</td>\n<td>优先对该功能做路由/缓存优化</td>\n</tr>\n<tr>\n<td>旗舰模型调用中 60% 是简单请求</td>\n<td>部署路由系统</td>\n</tr>\n<tr>\n<td>缓存命中率 &lt; 20%</td>\n<td>审查缓存键设计、延长 TTL</td>\n</tr>\n<tr>\n<td>Agent 平均步骤 &gt; 15</td>\n<td>优化 Agent 架构、设置步骤上限</td>\n</tr>\n<tr>\n<td>夜间批量任务走同步 API</td>\n<td>迁移到 Batch API</td>\n</tr>\n<tr>\n<td>单用户成本异常高</td>\n<td>检查是否有 bug/滥用</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>成本可观测性是所有治理能力的基础。第一步是接入计量中间件（SDK 包装器最快落地），采集 model/tokens/cost/project/feature/user 多维数据；第二步是建立仪表板展示成本趋势和归因；第三步是配置异常告警（突增、循环、膨胀）。从&quot;看清&quot;到&quot;行动&quot;的转化是可观测性的最终价值——每个观测到的异常都应该有对应的优化行动。</p>\n<hr>\n<blockquote>\n<p>相关文档：<a href=\"budget-allocation\">预算分配与熔断</a> 在可观测的基础上，建立主动的成本控制机制</p>\n</blockquote>\n","headings":[{"level":1,"text":"成本可观测性","id":"成本可观测性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"你无法优化你没有计量的东西","id":"你无法优化你没有计量的东西"},{"level":2,"text":"计量中间件设计","id":"计量中间件设计"},{"level":3,"text":"采集的核心字段","id":"采集的核心字段"},{"level":3,"text":"实现方式","id":"实现方式"},{"level":2,"text":"多维成本归因","id":"多维成本归因"},{"level":3,"text":"维度一：按项目/功能模块","id":"维度一-按项目-功能模块"},{"level":3,"text":"维度二：按模型","id":"维度二-按模型"},{"level":3,"text":"维度三：按用户/租户","id":"维度三-按用户-租户"},{"level":3,"text":"维度四：按时间","id":"维度四-按时间"},{"level":2,"text":"异常检测与告警","id":"异常检测与告警"},{"level":3,"text":"需要告警的模式","id":"需要告警的模式"},{"level":3,"text":"Agent 循环检测","id":"agent-循环检测"},{"level":2,"text":"可观测性工具链","id":"可观测性工具链"},{"level":3,"text":"开源方案","id":"开源方案"},{"level":3,"text":"仪表板核心指标","id":"仪表板核心指标"},{"level":2,"text":"从可观测到可行动","id":"从可观测到可行动"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"量化与蒸馏的成本收益","url":"/l-doc-books/h/ai-native-engineering/ai-cost-token-optimization/infrastructure/quantization-distillation-cost"},"next":{"title":"预算分配与熔断机制","url":"/l-doc-books/h/ai-native-engineering/ai-cost-token-optimization/governance/budget-allocation"}}