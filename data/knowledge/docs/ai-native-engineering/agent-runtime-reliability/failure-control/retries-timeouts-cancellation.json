E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'reconcile'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (input.errorClass </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'permanent'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'stop'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, reason: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'permanent_error'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">input.idempotent) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'reconcile'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cap</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">250</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> **</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> input.attempt);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> delayMs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> input.retryAfterMs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">floor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cap);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> delayMs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> input.remainingMs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'retry'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, delayMs } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'stop'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, reason: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'deadline'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>示例中的 full jitter 只用于说明，生产实现应使用可注入随机源以便测试，并尊重供应商的 <code>Retry-After</code>。真正的分类应在工具适配器内完成，因为只有它理解供应商错误语义。运行时保存分类结果和原始证据，避免恢复后由新代码把同一错误重新解释成另一类别。</p>\n<p>重试层级只选一个负责跨时间恢复。HTTP 客户端可以处理连接建立前的极短传输重试，模型网关可以处理供应商路由，而 agent 运行时负责业务动作的长重试；但三层必须共享尝试计数或明确禁用重叠默认值。否则每层最多三次会放大成 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msup><mn>3</mn><mn>3</mn></msup><mo>=</mo><mn>27</mn></mrow><annotation encoding=\"application/x-tex\">3^3=27</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8141em;\"></span><span class=\"mord\"><span class=\"mord\">3</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">3</span></span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">27</span></span></span></span></span> 次调用。</p>\n<h2 id=\"退避-抖动与重试配额\">退避、抖动与重试配额</h2><p>指数退避的目标不是礼貌等待，而是降低故障期间的同步压力。无抖动时，大量运行会在相同时间点醒来，形成周期性尖峰；full jitter 从 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">[</mo><mn>0</mn><mo separator=\"true\">,</mo><mi>c</mi><mi>a</mi><mi>p</mi><mo stretchy=\"false\">]</mo></mrow><annotation encoding=\"application/x-tex\">[0, cap]</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">c</span><span class=\"mord mathnormal\">a</span><span class=\"mord mathnormal\">p</span><span class=\"mclose\">]</span></span></span></span></span> 随机选择延迟，使请求分散。退避上限防止等待无限增长，最大累计时间确保任务不会静默挂起数小时。</p>\n<p>重试还需要共享配额。可为每个租户、依赖和错误类别维护 token bucket：正常成功补充 token，失败重试消耗 token；配额用尽后快速失败或延迟入队。这样单个故障供应商不会让所有运行把容量花在重复尝试上。</p>\n<p>重试预算应同时计入钱和时间。一次高价模型重试可能比十次轻量元数据查询更昂贵。运行信封可以定义模型 token、工具调用和总成本上限，策略根据已消费回执扣减。恢复不能重置预算，否则反复崩溃会绕过控制。</p>\n<p>过载错误的最佳响应通常是减少工作，而不是更努力重试。运行时可以降低并发、切换已验证的降级路径、缩短低优先级输出，或把任务推迟到有业务价值的最晚时间。无法在有效期内完成的请求应明确拒绝，避免把陈旧任务留在队列拖累新流量。</p>\n<h2 id=\"取消是持久命令\">取消是持久命令</h2><p>取消不是杀掉当前进程，而是记录“调用方不再要求继续”的持久意图，并将其传播到所有子动作。取消事件应包含发起者、原因、时间、目标范围和策略版本。worker 在模型流、工具心跳、队列消费和长循环的安全点检查取消令牌。</p>\n<p>gRPC 取消指南要求服务端主动停止本地处理并理想地向上游调用传播取消，同时指出库通常无法强行中断应用处理器，处理器必须协作检查。<a href=\"https://grpc.io/docs/guides/cancellation/\">gRPC Cancellation</a>对 agent 工具同样适用：运行时可以发送取消信号，但工具必须实现可中断点，且此前修改不会自动回滚。</p>\n<p>取消状态机应区分 <code>cancel_requested</code>、<code>cancelling</code> 与 <code>cancelled</code>。收到请求先阻止签发新动作，再取消可中断调用，等待或强制终止剩余尝试，最后对已确认副作用进行保留、补偿或人工处置。只有对账完成才能进入 <code>cancelled</code> 终态。</p>\n<p>若外部系统不支持取消，运行时仍应停止消费结果作为新计划输入，但必须保存晚到回执。否则动作已经发生却不在账本中，后续审计会误以为取消成功。晚到成功可能触发补偿，也可能按业务规则保留效果。</p>\n<p>取消还应沿父子关系传播，但传播策略不是永远级联。父运行取消后，专属于它的子运行应取消；已经转化为独立业务责任的子运行可能继续。父子创建时就要声明 <code>abandon</code>、<code>request_cancel</code> 或 <code>wait_for_cleanup</code> 策略。</p>\n<h2 id=\"推测执行与请求对冲\">推测执行与请求对冲</h2><p>对只读、无副作用且尾延迟严重的请求，可以在延迟分位数达到阈值后发起对冲请求，采用先成功者并取消其余。这不是普通重试，因为原请求仍在运行。若对写操作使用对冲，即使有幂等键也会增加供应端争用和冲突，默认应禁止。</p>\n<p>对模型生成进行对冲还会引入输出选择问题和双倍成本。只有当产品明确允许多个候选、预算已授权，并且选择器本身可评估时才使用。不能把“取最快响应”当作可靠性，因为最快输出可能质量更差。</p>\n<p>熔断器与重试配额互补。熔断器在依赖持续失败时阻止新尝试，让系统快速降级；半开探针用于判断恢复。熔断状态要按供应商、区域、模型或工具能力隔离，不能因为一个模型超时就关闭整个 agent 平台。</p>\n<h2 id=\"验证时间与取消语义\">验证时间与取消语义</h2><p>测试环境需要可控时钟、可控随机源和可注入故障。使用真实睡眠会让测试缓慢且不稳定；虚拟时钟可以推进 deadline，验证退避顺序、预算耗尽和审批到期。每次尝试记录计划时间与实际开始时间，以发现队列延迟已经吞掉预算。</p>\n<p>故障矩阵至少包含：请求发送前超时、服务端成功后客户端超时、<code>429</code> 带或不带 <code>Retry-After</code>、取消与成功同时到达、取消无法传播、晚到响应、多个层默认重试、worker 重启后剩余 deadline 计算。每个场景都要断言外部效果数量、最终状态、尝试成本和取消原因。</p>\n<p>对有副作用动作，时间控制必须与<a href=\"../execution-contract/idempotency-side-effect-receipts\">幂等与副作用回执</a>一起验证；运行级资源上限和队列行为在<a href=\"concurrency-budgets-backpressure\">并发、资源预算与背压</a>继续展开。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>从运行绝对 deadline 向步骤和尝试切片，并为持久化、对账与清理预留时间。</li>\n<li>根据具体依赖的错误语义分类，结果未知先对账，永久错误不重试。</li>\n<li>采用有上限的指数退避、抖动和共享重试配额，避免多层乘法放大。</li>\n<li>把取消记录为持久命令，在安全点传播，并承认已经发生的副作用不会自动回滚。</li>\n<li>仅对安全只读调用谨慎使用对冲，把模型成本与质量选择纳入授权。</li>\n<li>用可控时钟和精确崩溃点测试时间协议，而不是只测快乐路径。</li>\n</ul>\n","headings":[{"level":1,"text":"重试、超时与取消","id":"重试-超时与取消"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"从运行截止时间向下切片","id":"从运行截止时间向下切片"},{"level":2,"text":"重试策略由错误分类驱动","id":"重试策略由错误分类驱动"},{"level":2,"text":"退避、抖动与重试配额","id":"退避-抖动与重试配额"},{"level":2,"text":"取消是持久命令","id":"取消是持久命令"},{"level":2,"text":"推测执行与请求对冲","id":"推测执行与请求对冲"},{"level":2,"text":"验证时间与取消语义","id":"验证时间与取消语义"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"幂等与副作用回执","url":"/l-doc-books/h/ai-native-engineering/agent-runtime-reliability/execution-contract/idempotency-side-effect-receipts"},"next":{"title":"并发、资源预算与背压","url":"/l-doc-books/h/ai-native-engineering/agent-runtime-reliability/failure-control/concurrency-budgets-backpressure"}}