ull_number: prNumber });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> commitId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pullRequest.data.head.sha;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> finding</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> findings) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (finding.severity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'critical'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> finding.severity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'warning'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> octokit.pulls.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createReviewComment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">repo,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        pull_number: prNumber,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        commit_id: commitId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        path: finding.file,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        line: finding.line,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        body: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">formatComment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(finding),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> formatComment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">finding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> emoji</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { critical: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'🔴'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, warning: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'🟡'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, suggestion: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'🔵'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">emoji</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">[</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">finding</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">severity</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} **${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">finding</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">category</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">finding</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">message</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">finding</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">suggestion</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `**Suggestion:** ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">finding</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">suggestion</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"控制审查噪音的实践经验\">控制审查噪音的实践经验</h2><p>审查噪音（大量低价值评论）是 AI 代码审查最常见的失败模式。控制策略：</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>实现方式</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>仅对 critical 和 warning 发行内评论</td>\n<td>过滤 suggestion 级别</td>\n<td>减少 40-60% 评论量</td>\n</tr>\n<tr>\n<td>按文件优先级过滤</td>\n<td>跳过 vendor/generated</td>\n<td>聚焦核心逻辑</td>\n</tr>\n<tr>\n<td>设置每次 PR 最大评论数上限</td>\n<td><code>MAX_COMMENTS = 10</code></td>\n<td>避免大型 PR 评论泛滥</td>\n</tr>\n<tr>\n<td>注入已知误报模式</td>\n<td>历史数据反馈到 Prompt</td>\n<td>减少重复误报</td>\n</tr>\n<tr>\n<td>跟踪 Dismissed 评论</td>\n<td>工程师关闭评论时记录</td>\n<td>积累误报数据用于优化</td>\n</tr>\n</tbody></table>\n<p>关于代码审查触发的具体时机和门控设计，参见 <a href=\"../foundations/agent-in-pipeline-patterns\">Agent 嵌入流水线的触发模式</a>。关于当 AI 审查产出不可靠时的降级策略，参见 <a href=\"../operations/guardrails-rollback\">护栏与回滚策略</a>。关于代码审查发现测试缺口后如何触发测试生成，参见 <a href=\"test-generation-maintenance\">测试生成与维护</a>。</p>\n<h2 id=\"小结\">小结</h2><p>CI 中的 AI 代码审查以&quot;第一道防线&quot;模式运行：覆盖机械性检查（风格、常见 bug、安全嗅探），不越界到架构判断。选型上，小团队用 Copilot code review 或 Claude Code GitHub Action 即可；需要深度定制的大团队可自建。Prompt 设计的核心是明确排除范围、要求具体修复建议、区分必须修复和建议改进三个严重级别。控制噪音（FPR &lt; 20%）是持续使用的关键，通过限制评论量、注入历史误报模式、追踪 dismissed 评论来实现。</p>\n","headings":[{"level":1,"text":"CI 中的 AI 代码审查","id":"ci-中的-ai-代码审查"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"主流工具的集成模式","id":"主流工具的集成模式"},{"level":2,"text":"GitHub Actions 集成实现","id":"github-actions-集成实现"},{"level":2,"text":"Prompt 设计原则","id":"prompt-设计原则"},{"level":2,"text":"行内评论的 API 实现","id":"行内评论的-api-实现"},{"level":2,"text":"控制审查噪音的实践经验","id":"控制审查噪音的实践经验"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"反馈闭环架构","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/foundations/feedback-loop-architecture"},"next":{"title":"失败自动分诊与修复","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/quality-gates/auto-triage-failure"}}