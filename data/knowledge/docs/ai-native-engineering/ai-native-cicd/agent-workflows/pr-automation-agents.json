lor:#005CC5;--shiki-dark:#79B8FF\"> recentActivityScore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getRecentActivityScore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(reviewer, changedFiles);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 维度 3：当前 review 负载（正在审查的 PR 数量，越少越好）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> loadScore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getReviewerLoadScore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(reviewer);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 维度 4：时区可用性（与 PR 作者时区重叠度）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> timezoneScore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computeTimezoneScore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(reviewer);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ownershipScore </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.4</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> recentActivityScore </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loadScore </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> timezoneScore </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>审查者分配的透明度：自动分配后在 PR 上评论说明分配原因，避免&quot;黑盒&quot;感：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"🤖 Auto-assigned reviewers based on:&#10;- @alice: owns src/auth/ (CODEOWNERS match), last modified 3 of 5 changed files&#10;- @bob: recent activity in src/api/middleware/, low current review load (2 active PRs)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>🤖 Auto-assigned reviewers based on:</span></span>\n<span class=\"line\"><span>- @alice: owns src/auth/ (CODEOWNERS match), last modified 3 of 5 changed files</span></span>\n<span class=\"line\"><span>- @bob: recent activity in src/api/middleware/, low current review load (2 active PRs)</span></span></code></pre></div><h2 id=\"pr-健康监控与-sla-追踪\">PR 健康监控与 SLA 追踪</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    PR[PR 创建] --&gt; SLA_START[SLA 计时开始]&#10;    SLA_START --&gt; MONITOR[持续监控\\n每 4 小时]&#10;&#10;    MONITOR --&gt; CHECK{SLA 状态}&#10;    CHECK --&gt;|未超期| MONITOR&#10;    CHECK --&gt;|超期 24h| REMIND1[提醒审查者]&#10;    CHECK --&gt;|超期 48h| REMIND2[提醒 + 抄送 Tech Lead]&#10;    CHECK --&gt;|超期 72h| ESCALATE[升级:通知 Manager\\n标记为 Blocked]\">flowchart LR\n    PR[PR 创建] --&gt; SLA_START[SLA 计时开始]\n    SLA_START --&gt; MONITOR[持续监控\\n每 4 小时]\n\n    MONITOR --&gt; CHECK{SLA 状态}\n    CHECK --&gt;|未超期| MONITOR\n    CHECK --&gt;|超期 24h| REMIND1[提醒审查者]\n    CHECK --&gt;|超期 48h| REMIND2[提醒 + 抄送 Tech Lead]\n    CHECK --&gt;|超期 72h| ESCALATE[升级:通知 Manager\\n标记为 Blocked]</pre><p>SLA 追踪的实现可以用 GitHub Actions 定时任务：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"on:&#10;  schedule:&#10;    - cron: &#39;0 */4 * * *&#39; # 每 4 小时检查一次&#10;&#10;jobs:&#10;  pr-health-monitor:&#10;    runs-on: ubuntu-latest&#10;    steps:&#10;      - name: Check PR SLAs&#10;        uses: actions/github-script@v7&#10;        with:&#10;          script: |&#10;            const openPRs = await github.rest.pulls.list({&#10;              ...context.repo,&#10;              state: &#39;open&#39;,&#10;              per_page: 100&#10;            });&#10;&#10;            for (const pr of openPRs.data) {&#10;              const ageHours = (Date.now() - new Date(pr.created_at)) / 3600000;&#10;              const lastActivity = await getLastActivity(pr.number);&#10;              const hoursSinceActivity = (Date.now() - lastActivity) / 3600000;&#10;              &#10;              if (hoursSinceActivity &gt; 48 &amp;&amp; !pr.labels.some(l =&gt; l.name === &#39;blocked&#39;)) {&#10;                await sendSLAReminder(pr, hoursSinceActivity);&#10;              }&#10;            }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  schedule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">cron</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0 */4 * * *'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 每 4 小时检查一次</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  pr-health-monitor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Check PR SLAs</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/github-script@v7</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          script</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            const openPRs = await github.rest.pulls.list({</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              ...context.repo,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              state: 'open',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              per_page: 100</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            for (const pr of openPRs.data) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              const ageHours = (Date.now() - new Date(pr.created_at)) / 3600000;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              const lastActivity = await getLastActivity(pr.number);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              const hoursSinceActivity = (Date.now() - lastActivity) / 3600000;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              if (hoursSinceActivity > 48 &#x26;&#x26; !pr.labels.some(l => l.name === 'blocked')) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                await sendSLAReminder(pr, hoursSinceActivity);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            }</span></span></code></pre></div><h2 id=\"自动标签与分类\">自动标签与分类</h2><p>基于 diff 内容自动打标签，提升 PR 可发现性和过滤效率：</p>\n<table>\n<thead>\n<tr>\n<th>标签</th>\n<th>触发条件</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>size/S</code> <code>size/M</code> <code>size/L</code> <code>size/XL</code></td>\n<td>diff 行数阈值</td>\n<td>估算 review 时间</td>\n</tr>\n<tr>\n<td><code>type/feature</code></td>\n<td>新增公开 API 或功能模块</td>\n<td>变更分类</td>\n</tr>\n<tr>\n<td><code>type/bugfix</code></td>\n<td>修复已有功能</td>\n<td>变更分类</td>\n</tr>\n<tr>\n<td><code>type/refactor</code></td>\n<td>无功能变更的代码重组</td>\n<td>变更分类</td>\n</tr>\n<tr>\n<td><code>area/frontend</code> <code>area/backend</code> <code>area/infra</code></td>\n<td>变更文件的路径模式</td>\n<td>路由审查者</td>\n</tr>\n<tr>\n<td><code>needs-migration</code></td>\n<td>包含数据库 migration 文件</td>\n<td>触发 DBA 审查</td>\n</tr>\n<tr>\n<td><code>breaking-change</code></td>\n<td>AI 检测到 public API 签名变更</td>\n<td>触发特殊审查流程</td>\n</tr>\n</tbody></table>\n<p>PR 自动化 agent 的上下游关系：它产出的结构化描述和标签，是发布变更日志 agent（见 <a href=\"release-changelog-agents\">发布与变更日志 Agent</a>）的输入数据源；而代码审查 agent（见 <a href=\"../quality-gates/ai-code-review-in-ci\">CI 中的 AI 代码审查</a>）则是 PR 生命周期中并行运行的另一个 agent。</p>\n<h2 id=\"异步云端-coding-agent-的分工边界-2025-2026\">异步云端 Coding Agent 的分工边界（2025—2026）</h2><p>本篇讨论的描述生成、审查者分配、自动标签属于<strong>流程型自动化</strong>——它们优化 PR 的流转效率，不产出代码变更。2025 年后，另一类<strong>实现型 agent</strong> 成为主流：GitHub 的 <a href=\"https://docs.github.com/en/copilot/concepts/agents/coding-agent/about-coding-agent\">Copilot cloud agent</a> 从 issue 指派出发在托管环境完成实现并回开 draft PR；<a href=\"https://developers.openai.com/codex/cloud\">OpenAI Codex cloud</a> 在并行隔离云环境中跑任务、产出可检查的 diff；Google 的 <a href=\"https://jules.google.com/\">Jules</a> 读取仓库上下文直接交付 PR；Cognition 的 Devin 属于同类。</p>\n<p>两类 agent 在真实流水线中的分工：</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>流程型（本篇）</th>\n<th>实现型（云端 coding agent）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>产出</td>\n<td>标签、描述、提醒、分配建议</td>\n<td>完整的代码变更分支与 draft PR</td>\n</tr>\n<tr>\n<td>触发</td>\n<td>PR/issue 事件的 webhook</td>\n<td>issue 指派、评论指令、任务面板</td>\n</tr>\n<tr>\n<td>风险等级</td>\n<td>低（不改代码）</td>\n<td>高（产出必须过完整 CI 门 + 人审合并）</td>\n</tr>\n<tr>\n<td>失败代价</td>\n<td>错标/误提醒，易回退</td>\n<td>引入缺陷或安全问题，需门控拦截</td>\n</tr>\n</tbody></table>\n<p>工程含义：实现型 agent 的每一个产出 PR 都应被视为不可信输入——它要经过与本篇流程型 agent 相同的门控体系（标签、审查者分配、AI review），而不是绕过。第四章的护栏设计对这两类 agent 同样适用。</p>\n<h2 id=\"小结\">小结</h2><p>PR 自动化 Agent 覆盖 PR 生命周期中最高频的重复性任务：描述生成（基于 diff 和提交历史的结构化模板）、智能审查者分配（所有权 + 近期活动 + 负载 + 时区多维度评分）、自动标签、SLA 健康监控。自动分配必须透明——说明分配理由，避免工程师对自动决策的不信任。SLA 监控需要三级响应（提醒、抄送 TL、升级）避免 PR 在静默中超期。</p>\n","headings":[{"level":1,"text":"PR 自动化 Agent","id":"pr-自动化-agent"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"PR 生命周期自动化全景","id":"pr-生命周期自动化全景"},{"level":2,"text":"PR 描述自动生成","id":"pr-描述自动生成"},{"level":2,"text":"智能审查者分配","id":"智能审查者分配"},{"level":2,"text":"PR 健康监控与 SLA 追踪","id":"pr-健康监控与-sla-追踪"},{"level":2,"text":"自动标签与分类","id":"自动标签与分类"},{"level":2,"text":"异步云端 Coding Agent 的分工边界（2025—2026）","id":"异步云端-coding-agent-的分工边界-2025-2026"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"测试生成与维护","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/quality-gates/test-generation-maintenance"},"next":{"title":"发布与变更日志 Agent","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/agent-workflows/release-changelog-agents"}}