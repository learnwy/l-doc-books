ki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> parseChangelogResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(response.content[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].text);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"处理不规范的-commit-信息\">处理不规范的 Commit 信息</h2><p>现实中大量 commit 不遵循 Conventional Commits 规范。Agent 需要从自由格式的 commit 信息中推断语义：</p>\n<table>\n<thead>\n<tr>\n<th>不规范 commit 示例</th>\n<th>推断类型</th>\n<th>推断逻辑</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>fixed null pointer in user service</code></td>\n<td>FIXED</td>\n<td>包含 &quot;fix&quot; 关键词</td>\n</tr>\n<tr>\n<td><code>add export endpoint for reports</code></td>\n<td>ADDED</td>\n<td>包含 &quot;add&quot; + 功能性描述</td>\n</tr>\n<tr>\n<td><code>remove deprecated v1 API</code></td>\n<td>REMOVED</td>\n<td>包含 &quot;remove&quot; + &quot;deprecated&quot;</td>\n</tr>\n<tr>\n<td><code>update DB connection pool size</code></td>\n<td>CHANGED</td>\n<td>配置/参数变更</td>\n</tr>\n<tr>\n<td><code>refactor auth middleware</code></td>\n<td>内部（跳过）</td>\n<td>&quot;refactor&quot; 通常不影响用户</td>\n</tr>\n<tr>\n<td><code>WIP login page</code></td>\n<td>内部（跳过）</td>\n<td>WIP 标记表示未完成</td>\n</tr>\n</tbody></table>\n<p>对于推断置信度低于 0.6 的 commit，agent 应标记为 <code>[REVIEW_NEEDED]</code>，要求人工确认分类。</p>\n<h2 id=\"破坏性变更的特殊处理\">破坏性变更的特殊处理</h2><p>破坏性变更（Breaking Changes）需要特别处理，确保迁移路径清晰：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 检测 PR 是否包含破坏性变更&#10;async function detectBreakingChanges(diff, prDescription) {&#10;  const breakingSignals = [&#10;    /BREAKING[\\s-]CHANGE:/i.test(prDescription),&#10;    /removed.*public.*api/i.test(prDescription),&#10;    diff.includes(&#39;- export&#39;) &amp;&amp; diff.includes(&#39;+ // removed&#39;),&#10;    /deprecated.*removed/i.test(prDescription),&#10;  ];&#10;&#10;  if (breakingSignals.some(Boolean)) {&#10;    // 生成迁移指南&#10;    const migrationGuide = await generateMigrationGuide(diff, prDescription);&#10;    return { isBreaking: true, migrationGuide };&#10;  }&#10;  return { isBreaking: false };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 检测 PR 是否包含破坏性变更</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> detectBreakingChanges</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">diff</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">prDescription</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> breakingSignals</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    /</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">BREAKING</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[\\s-]</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">CHANGE:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prDescription),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    /</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">removed</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">public</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">api</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prDescription),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    diff.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'- export'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> diff.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'+ // removed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    /</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">deprecated</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">removed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prDescription),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (breakingSignals.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">some</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Boolean)) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 生成迁移指南</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> migrationGuide</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateMigrationGuide</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(diff, prDescription);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { isBreaking: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, migrationGuide };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { isBreaking: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>破坏性变更在发布说明中必须置顶，格式示例：</p>\n<div class=\"code-block-wrapper\" data-lang=\"markdown\" data-code=\"## ⚠️ Breaking Changes&#10;&#10;### Removed: `UserService.getById()` API&#10;&#10;**Migration Guide:**&#10;Replace calls to `UserService.getById(id)` with `UserService.findUser({ id })`.&#10;&#10;Before:&#10;&#10;```typescript&#10;const user = await userService.getById(123);&#10;```\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## ⚠️ Breaking Changes</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### Removed: </span><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">`UserService.getById()`</span><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\"> API</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-light-font-weight:bold;--shiki-dark:#E1E4E8;--shiki-dark-font-weight:bold\">**Migration Guide:**</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Replace calls to </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">`UserService.getById(id)`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> with </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">`UserService.findUser({ id })`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Before:</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">```typescript</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">123</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">```</span></span></code></pre></div><p>After:</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const user = await userService.findUser({ id: 123 });\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">findUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ id: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">123</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><p><strong>Why:</strong> The old API was deprecated in v2.3.0 and has been removed to simplify the user service interface.</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"&#10;## 发布流程集成&#10;&#10;```yaml&#10;# .github/workflows/release-notes.yml&#10;name: Generate Release Notes&#10;on:&#10;  push:&#10;    tags:&#10;      - &#39;v*&#39;&#10;&#10;jobs:&#10;  release-notes:&#10;    runs-on: ubuntu-latest&#10;    steps:&#10;      - uses: actions/checkout@v4&#10;        with:&#10;          fetch-depth: 0&#10;&#10;      - name: Get Previous Tag&#10;        id: prev-tag&#10;        run: |&#10;          PREV=$(git describe --tags --abbrev=0 HEAD^ 2&gt;/dev/null || echo &quot;&quot;)&#10;          echo &quot;tag=$PREV&quot; &gt;&gt; $GITHUB_OUTPUT&#10;&#10;      - name: Generate Changelog&#10;        env:&#10;          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}&#10;          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}&#10;        run: |&#10;          node scripts/generate-changelog.mjs \\&#10;            --from ${{ steps.prev-tag.outputs.tag }} \\&#10;            --to ${{ github.ref_name }} \\&#10;            --output changelog/&#10;&#10;      - name: Create GitHub Release (Draft)&#10;        uses: actions/github-script@v7&#10;        with:&#10;          script: |&#10;            const fs = require(&#39;fs&#39;);&#10;            const userNotes = fs.readFileSync(&#39;changelog/user-notes.md&#39;, &#39;utf8&#39;);&#10;&#10;            await github.rest.repos.createRelease({&#10;              ...context.repo,&#10;              tag_name: context.ref.replace(&#39;refs/tags/&#39;, &#39;&#39;),&#10;              name: `Release ${context.ref.replace(&#39;refs/tags/&#39;, &#39;&#39;)}`,&#10;              body: userNotes,&#10;              draft: true,  // 草稿状态，等人工审查后发布&#10;              prerelease: false&#10;            });\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span></span></span>\n<span class=\"line\"><span>## 发布流程集成</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>```yaml</span></span>\n<span class=\"line\"><span># .github/workflows/release-notes.yml</span></span>\n<span class=\"line\"><span>name: Generate Release Notes</span></span>\n<span class=\"line\"><span>on:</span></span>\n<span class=\"line\"><span>  push:</span></span>\n<span class=\"line\"><span>    tags:</span></span>\n<span class=\"line\"><span>      - 'v*'</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>jobs:</span></span>\n<span class=\"line\"><span>  release-notes:</span></span>\n<span class=\"line\"><span>    runs-on: ubuntu-latest</span></span>\n<span class=\"line\"><span>    steps:</span></span>\n<span class=\"line\"><span>      - uses: actions/checkout@v4</span></span>\n<span class=\"line\"><span>        with:</span></span>\n<span class=\"line\"><span>          fetch-depth: 0</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>      - name: Get Previous Tag</span></span>\n<span class=\"line\"><span>        id: prev-tag</span></span>\n<span class=\"line\"><span>        run: |</span></span>\n<span class=\"line\"><span>          PREV=$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo \"\")</span></span>\n<span class=\"line\"><span>          echo \"tag=$PREV\" >> $GITHUB_OUTPUT</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>      - name: Generate Changelog</span></span>\n<span class=\"line\"><span>        env:</span></span>\n<span class=\"line\"><span>          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}</span></span>\n<span class=\"line\"><span>          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}</span></span>\n<span class=\"line\"><span>        run: |</span></span>\n<span class=\"line\"><span>          node scripts/generate-changelog.mjs \\</span></span>\n<span class=\"line\"><span>            --from ${{ steps.prev-tag.outputs.tag }} \\</span></span>\n<span class=\"line\"><span>            --to ${{ github.ref_name }} \\</span></span>\n<span class=\"line\"><span>            --output changelog/</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>      - name: Create GitHub Release (Draft)</span></span>\n<span class=\"line\"><span>        uses: actions/github-script@v7</span></span>\n<span class=\"line\"><span>        with:</span></span>\n<span class=\"line\"><span>          script: |</span></span>\n<span class=\"line\"><span>            const fs = require('fs');</span></span>\n<span class=\"line\"><span>            const userNotes = fs.readFileSync('changelog/user-notes.md', 'utf8');</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>            await github.rest.repos.createRelease({</span></span>\n<span class=\"line\"><span>              ...context.repo,</span></span>\n<span class=\"line\"><span>              tag_name: context.ref.replace('refs/tags/', ''),</span></span>\n<span class=\"line\"><span>              name: `Release ${context.ref.replace('refs/tags/', '')}`,</span></span>\n<span class=\"line\"><span>              body: userNotes,</span></span>\n<span class=\"line\"><span>              draft: true,  // 草稿状态，等人工审查后发布</span></span>\n<span class=\"line\"><span>              prerelease: false</span></span>\n<span class=\"line\"><span>            });</span></span></code></pre></div><p>关于 PR 自动化 agent 如何为变更日志提供结构化的输入数据，参见 <a href=\"pr-automation-agents\">PR 自动化 Agent</a>。关于在运营层面管理这些 agent 的成本，参见 <a href=\"../operations/cost-latency-budgets\">成本与延迟预算</a>。</p>\n<h2 id=\"小结\">小结</h2><p>发布变更日志 Agent 的核心数据流：收集 tag 区间内的 PR 集合 → 过滤内部/基础设施变更 → AI 语义归类（Added/Fixed/Changed/Security/Breaking）→ 生成双受众发布说明 → 草稿状态发布供人工审查。处理不规范 commit 是现实中最大的挑战，低置信度归类应标记为 REVIEW_NEEDED。破坏性变更必须置顶并附迁移指南。发布说明始终以草稿形式创建，人工审查批准后才正式发布，保留最终决策权。</p>\n","headings":[{"level":1,"text":"发布与变更日志 Agent","id":"发布与变更日志-agent"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"变更日志生成的数据流","id":"变更日志生成的数据流"},{"level":2,"text":"数据收集：从 PR 到结构化变更集","id":"数据收集-从-pr-到结构化变更集"},{"level":2,"text":"AI 语义归类与 changelog 生成","id":"ai-语义归类与-changelog-生成"},{"level":2,"text":"处理不规范的 Commit 信息","id":"处理不规范的-commit-信息"},{"level":2,"text":"破坏性变更的特殊处理","id":"破坏性变更的特殊处理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"PR 自动化 Agent","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/agent-workflows/pr-automation-agents"},"next":{"title":"依赖与安全 Agent","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/agent-workflows/dependency-security-agents"}}