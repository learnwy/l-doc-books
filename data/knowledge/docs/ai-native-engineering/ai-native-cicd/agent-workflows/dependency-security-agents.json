BFF\">${{ secrets.GITHUB_TOKEN }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          ANTHROPIC_API_KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ secrets.ANTHROPIC_API_KEY }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          node scripts/ai-dep-upgrade.mjs \\</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            --outdated outdated.json \\</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            --max-prs 3 \\</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            --risk-threshold medium</span></span></code></pre></div><h2 id=\"sbom-生成与维护\">SBOM 生成与维护</h2><p>软件物料清单（SBOM）是合规和供应链安全的基础文档：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 生成 SPDX 格式的 SBOM&#10;async function generateSBOM(projectRoot) {&#10;  const { execSync } = require(&#39;child_process&#39;);&#10;&#10;  // 使用 syft 生成基础 SBOM&#10;  execSync(&#39;syft . -o spdx-json &gt; sbom.spdx.json&#39;, { cwd: projectRoot });&#10;&#10;  const sbom = JSON.parse(fs.readFileSync(&#39;sbom.spdx.json&#39;));&#10;&#10;  // AI 增强：为每个依赖添加风险标注&#10;  const enrichedPackages = await Promise.all(&#10;    sbom.packages.map(async (pkg) =&gt; {&#10;      const cveCount = await queryCVEDatabase(pkg.name, pkg.versionInfo);&#10;      return {&#10;        ...pkg,&#10;        riskAnnotation: {&#10;          cve_count: cveCount,&#10;          last_checked: new Date().toISOString(),&#10;          status: cveCount &gt; 0 ? &#39;needs_review&#39; : &#39;clean&#39;,&#10;        },&#10;      };&#10;    }),&#10;  );&#10;&#10;  return { ...sbom, packages: enrichedPackages };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 生成 SPDX 格式的 SBOM</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateSBOM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">projectRoot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">execSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> require</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'child_process'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 使用 syft 生成基础 SBOM</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  execSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'syft . -o spdx-json > sbom.spdx.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { cwd: projectRoot });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sbom</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(fs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">readFileSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sbom.spdx.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // AI 增强：为每个依赖添加风险标注</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> enrichedPackages</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">all</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sbom.packages.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pkg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cveCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> queryCVEDatabase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pkg.name, pkg.versionInfo);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pkg,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        riskAnnotation: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          cve_count: cveCount,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          last_checked: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toISOString</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          status: cveCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'needs_review'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'clean'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">sbom, packages: enrichedPackages };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关于如何将依赖安全 PR 融入 PR 自动化流程，参见 <a href=\"pr-automation-agents\">PR 自动化 Agent</a>。关于控制安全扫描的运行成本，参见 <a href=\"../operations/cost-latency-budgets\">成本与延迟预算</a>。</p>\n<h2 id=\"小结\">小结</h2><p>依赖与安全 Agent 的核心价值是在规则匹配之上增加语义理解层：可达性分析区分&quot;理论上存在 CVE&quot;和&quot;在当前代码中实际可利用&quot;，升级风险评估区分&quot;可以自动合并&quot;和&quot;需要人工规划的迁移项目&quot;。自动化行动必须保守：低风险补丁可以自动合并，高风险升级只创建 Issue 不创建 PR，避免自动化在供应链安全场景引入新的风险。SBOM 的生成与维护是合规的基础，AI 可以辅助风险标注但不替代人工审查。</p>\n","headings":[{"level":1,"text":"依赖与安全 Agent","id":"依赖与安全-agent"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"依赖与安全 Agent 的工作模式","id":"依赖与安全-agent-的工作模式"},{"level":2,"text":"CVE 安全扫描与可达性分析","id":"cve-安全扫描与可达性分析"},{"level":2,"text":"依赖升级风险评估","id":"依赖升级风险评估"},{"level":2,"text":"自动生成安全/升级 PR","id":"自动生成安全-升级-pr"},{"level":2,"text":"SBOM 生成与维护","id":"sbom-生成与维护"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"发布与变更日志 Agent","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/agent-workflows/release-changelog-agents"},"next":{"title":"Prompt 版本化与可观测性","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/operations/prompt-versioning-observability"}}