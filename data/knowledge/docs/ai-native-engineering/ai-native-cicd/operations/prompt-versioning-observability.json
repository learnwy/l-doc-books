#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> recordExecution</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 写入本地 NDJSON 日志文件</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  fs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">appendFileSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'agent-executions.ndjson'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(record) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 发送到指标平台（Datadog / Prometheus）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  metrics.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">gauge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'agent.duration_ms'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, record.duration_ms, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    agent_type: record.agent_type,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    prompt_version: record.prompt_version,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  metrics.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">increment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'agent.findings'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, record.findings_count, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    agent_type: record.agent_type,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    severity: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'critical'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    count: record.severity_breakdown.critical,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  metrics.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">gauge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'agent.tokens'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, record.input_tokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> record.output_tokens, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    agent_type: record.agent_type,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    model: record.model,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"可观测性指标体系\">可观测性指标体系</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph 质量指标&#10;        Q1[误报率 FPR\\n目标: &lt; 20%]&#10;        Q2[有效发现率 TPR\\n目标: &gt; 60%]&#10;        Q3[门控阻断率\\n目标: &lt; 5%]&#10;    end&#10;&#10;    subgraph 性能指标&#10;        P1[执行 P95 延迟\\n目标: &lt; 60s]&#10;        P2[Token 消耗 P95\\n监控月度趋势]&#10;        P3[API 成功率\\n目标: &gt; 99%]&#10;    end&#10;&#10;    subgraph Prompt 版本指标&#10;        V1[按版本的 FPR 趋势]&#10;        V2[按版本的平均延迟]&#10;        V3[版本升级后的指标对比]&#10;    end\">flowchart LR\n    subgraph 质量指标\n        Q1[误报率 FPR\\n目标: &lt; 20%]\n        Q2[有效发现率 TPR\\n目标: &gt; 60%]\n        Q3[门控阻断率\\n目标: &lt; 5%]\n    end\n\n    subgraph 性能指标\n        P1[执行 P95 延迟\\n目标: &lt; 60s]\n        P2[Token 消耗 P95\\n监控月度趋势]\n        P3[API 成功率\\n目标: &gt; 99%]\n    end\n\n    subgraph Prompt 版本指标\n        V1[按版本的 FPR 趋势]\n        V2[按版本的平均延迟]\n        V3[版本升级后的指标对比]\n    end</pre><p>关键 Dashboard 指标及告警阈值：</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>告警阈值</th>\n<th>处理方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>误报率（7 天滚动均值）</td>\n<td>&gt; 25%</td>\n<td>审查 Prompt，考虑回滚</td>\n</tr>\n<tr>\n<td>执行 P95 延迟</td>\n<td>&gt; 120s</td>\n<td>检查 API 限流，考虑换更快的模型</td>\n</tr>\n<tr>\n<td>API 错误率（1 小时）</td>\n<td>&gt; 5%</td>\n<td>检查 API 配额，触发降级模式</td>\n</tr>\n<tr>\n<td>单次 PR 的 token 消耗</td>\n<td>&gt; 50k tokens</td>\n<td>审查 diff 预处理逻辑</td>\n</tr>\n<tr>\n<td>门控阻断率（当日）</td>\n<td>&gt; 10%</td>\n<td>检查是否 Prompt 过于激进</td>\n</tr>\n</tbody></table>\n<h2 id=\"prompt-a-b-测试\">Prompt A/B 测试</h2><p>在推出新版 Prompt 前，通过 A/B 测试验证效果：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 按 PR 编号哈希决定 A/B 分组（稳定分组）&#10;function selectPromptVersion(prNumber, experiment) {&#10;  const hash = parseInt(crypto.createHash(&#39;md5&#39;).update(String(prNumber)).digest(&#39;hex&#39;).slice(0, 8), 16);&#10;&#10;  const normalized = hash / 0xffffffff;&#10;&#10;  if (normalized &lt; experiment.control_percentage / 100) {&#10;    return experiment.control_version; // 当前稳定版&#10;  } else {&#10;    return experiment.treatment_version; // 新版本&#10;  }&#10;}&#10;&#10;// 在执行记录中标记实验分组&#10;record.experiment_group = promptVersion === experiment.control_version ? &#39;control&#39; : &#39;treatment&#39;;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 按 PR 编号哈希决定 A/B 分组（稳定分组）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> selectPromptVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">prNumber</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">experiment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hash</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> parseInt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(crypto.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createHash</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'md5'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">update</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prNumber)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">digest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hex'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> normalized</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hash </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0xffffffff</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (normalized </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> experiment.control_percentage </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> experiment.control_version; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 当前稳定版</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> experiment.treatment_version; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 新版本</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在执行记录中标记实验分组</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">record.experiment_group </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> promptVersion </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> experiment.control_version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'control'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'treatment'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p>关于 Prompt 版本化与反馈闭环的关联，参见 <a href=\"../foundations/feedback-loop-architecture\">反馈闭环架构</a>。关于控制 token 成本，参见 <a href=\"cost-latency-budgets\">成本与延迟预算</a>。</p>\n<p>Prompt 版本化成熟度的评估清单：</p>\n<ul>\n<li>所有 Prompt 文件存储在版本控制中，带 semver 和 frontmatter 元数据</li>\n<li>Prompt Registry 已部署，agent 代码通过 Registry API 加载 Prompt（不硬编码）</li>\n<li>每次 agent 执行记录了 Prompt 版本、token 消耗、执行延迟到可查询的存储</li>\n<li>FPR、TPR、延迟的 Dashboard 已建立，有配套告警规则</li>\n<li>新版 Prompt 通过 A/B 测试验证后才升级到 latest</li>\n<li>有一键回滚脚本，能在 5 分钟内将 Prompt 回滚到指定版本</li>\n</ul>\n<h2 id=\"小结\">小结</h2><p>Prompt 版本化的工程实践：将 Prompt 作为带 semver 的文件存储在版本控制中，通过 Prompt Registry 解耦 Prompt 与代码部署，每次执行记录 Prompt 版本供效果对比分析。可观测性体系覆盖三类指标：质量（FPR、TPR、阻断率）、性能（延迟、token 消耗、API 成功率）、版本（各版本指标对比）。A/B 测试是新版 Prompt 上线前的必要验证步骤，通过 PR 编号哈希分组保证分组稳定。告警阈值应在团队采用初期设置得宽松，随成熟度逐步收紧。</p>\n","headings":[{"level":1,"text":"Prompt 版本化与可观测性","id":"prompt-版本化与可观测性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Prompt 文件结构与版本管理","id":"prompt-文件结构与版本管理"},{"level":2,"text":"Prompt Registry 的实现","id":"prompt-registry-的实现"},{"level":2,"text":"执行记录与指标采集","id":"执行记录与指标采集"},{"level":2,"text":"可观测性指标体系","id":"可观测性指标体系"},{"level":2,"text":"Prompt A/B 测试","id":"prompt-a-b-测试"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"依赖与安全 Agent","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/agent-workflows/dependency-security-agents"},"next":{"title":"成本与延迟预算","url":"/l-doc-books/h/ai-native-engineering/ai-native-cicd/operations/cost-latency-budgets"}}