tyle=\"color:#032F62;--shiki-dark:#9ECBFF\">            \"compliance\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: compliance,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            \"pass_rate\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(compliance.values()) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(compliance)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        })</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    overall_pass_rate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(r[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"pass_rate\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(results)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"overall\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: overall_pass_rate, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"details\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: results}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>指令遵循能力是模型训练的结果，头部闭源旗舰（Claude/GPT/Gemini）&gt; 主流开源模型，差异来自 RLHF 质量、instruction hierarchy 设计与 Constitutional AI 类训练方法</li>\n<li>Instruction Hierarchy 定义了 System &gt; User &gt; Assistant 的优先级，在 Prompt 设计中要主动利用这个机制而不是被动依赖</li>\n<li>不同模型偏好不同的指令写法：Claude 偏好 XML 结构化，GPT 系列偏好末尾强调，开源模型需要 redundancy + few-shot</li>\n<li>避免指令过载（超过 7 个约束）、避免纯负向指令、消除歧义是提升遵循率的三个最有效手段</li>\n<li>指令遵循质量需要通过测试用例系统性验证，不能靠直觉判断</li>\n</ul>\n","headings":[{"level":1,"text":"指令遵循原理","id":"指令遵循原理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Instruction Hierarchy 的工程含义","id":"instruction-hierarchy-的工程含义"},{"level":3,"text":"什么是 Instruction Hierarchy","id":"什么是-instruction-hierarchy"},{"level":3,"text":"冲突场景与处理差异","id":"冲突场景与处理差异"},{"level":2,"text":"不同模型的指令写法适配","id":"不同模型的指令写法适配"},{"level":3,"text":"Claude：利用宪法式训练","id":"claude-利用宪法式训练"},{"level":3,"text":"GPT 系列：明确优先级声明","id":"gpt-系列-明确优先级声明"},{"level":3,"text":"开源模型：防御式写法","id":"开源模型-防御式写法"},{"level":2,"text":"指令遵循的常见失效模式","id":"指令遵循的常见失效模式"},{"level":3,"text":"失效模式 1：指令过载","id":"失效模式-1-指令过载"},{"level":3,"text":"失效模式 2：负向指令的低效","id":"失效模式-2-负向指令的低效"},{"level":3,"text":"失效模式 3：歧义触发","id":"失效模式-3-歧义触发"},{"level":2,"text":"测试指令遵循质量的方法","id":"测试指令遵循质量的方法"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Prompt 解剖学","url":"/l-doc-books/h/ai-native-engineering/prompt-engineering-patterns/fundamentals/prompt-anatomy"},"next":{"title":"上下文窗口经济学","url":"/l-doc-books/h/ai-native-engineering/prompt-engineering-patterns/fundamentals/context-window-economics"}}