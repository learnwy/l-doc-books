4292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> validateDateRange</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(start, end, tz);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">          expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result.valid).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">          expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result.error).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toContain</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'365'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"第四步-分析发现的反例\">第四步：分析发现的反例</h3><p>当 fast-check 发现反例时，请 LLM 解释：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"fast-check 报告：&#10;Property &quot;reversed range should be invalid&quot; failed.&#10;Counterexample: [&quot;2024-02-29&quot;, &quot;2024-02-28&quot;, &quot;UTC&quot;]&#10;&#10;请分析这个反例说明了什么 bug，以及如何修复。\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>fast-check 报告：</span></span>\n<span class=\"line\"><span>Property \"reversed range should be invalid\" failed.</span></span>\n<span class=\"line\"><span>Counterexample: [\"2024-02-29\", \"2024-02-28\", \"UTC\"]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>请分析这个反例说明了什么 bug，以及如何修复。</span></span></code></pre></div><p>LLM 会识别出这涉及闰年日期的特殊处理，帮助工程师快速定位 bug 根因。</p>\n<h2 id=\"发现高价值-property-的启发式规则\">发现高价值 Property 的启发式规则</h2><p>当你不确定一个函数有哪些值得测试的 property 时，用这些规则引导 LLM 推断：</p>\n<table>\n<thead>\n<tr>\n<th>规则</th>\n<th>示例场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>编解码互逆</strong></td>\n<td><code>decode(encode(x)) === x</code></td>\n</tr>\n<tr>\n<td><strong>排序幂等性</strong></td>\n<td><code>sort(sort(arr))</code> 应该等于 <code>sort(arr)</code></td>\n</tr>\n<tr>\n<td><strong>单调性</strong></td>\n<td>输入增大，输出也不减小（或不增大）</td>\n</tr>\n<tr>\n<td><strong>组合律</strong></td>\n<td><code>f(f(x, a), b) === f(x, combine(a, b))</code></td>\n</tr>\n<tr>\n<td><strong>空元素</strong></td>\n<td>加入空元素不改变结果</td>\n</tr>\n<tr>\n<td><strong>大小一致性</strong></td>\n<td>操作前后集合大小满足的关系</td>\n</tr>\n<tr>\n<td><strong>对称性</strong></td>\n<td>交换参数不影响结果（或有可预测的影响）</td>\n</tr>\n<tr>\n<td><strong>保持性</strong></td>\n<td>某些输入特征被输出保留（排序、类型、长度约束）</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>属性测试的门槛在于&quot;想出有价值的 property&quot;，LLM 能系统化地从函数语义推断候选 property，显著降低这个门槛。</li>\n<li>LLM 在属性测试中扮演三个角色：property 发现者（推断测试性质）、shrinking 辅助者（帮助找最小反例）、反例翻译者（把随机数据翻译为可理解的故障描述）。</li>\n<li>实践工作流是：LLM 发现 property → 人工筛选 → 转化为 fast-check 代码 → 运行发现反例 → LLM 解释反例 → 修复 bug。</li>\n<li>八类启发式规则（编解码互逆、幂等性、单调性、组合律、空元素、大小一致性、对称性、保持性）可以作为引导 LLM 发现 property 的系统化框架。</li>\n<li>属性测试框架负责反例搜索和自动收缩，LLM 负责领域语义推断，两者各做最擅长的事，结合才能发挥最大效果。</li>\n</ul>\n","headings":[{"level":1,"text":"AI 辅助属性测试：QuickCheck + LLM 的协同","id":"ai-辅助属性测试-quickcheck-llm-的协同"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"属性测试的基本原理","id":"属性测试的基本原理"},{"level":2,"text":"LLM 在属性测试中的三个角色","id":"llm-在属性测试中的三个角色"},{"level":3,"text":"角色一：Property 发现者","id":"角色一-property-发现者"},{"level":3,"text":"角色三：反例翻译者","id":"角色三-反例翻译者"},{"level":3,"text":"第二步：让 LLM 发现 property","id":"第二步-让-llm-发现-property"},{"level":3,"text":"第三步：转化为 fast-check 代码","id":"第三步-转化为-fast-check-代码"},{"level":3,"text":"第四步：分析发现的反例","id":"第四步-分析发现的反例"},{"level":2,"text":"发现高价值 Property 的启发式规则","id":"发现高价值-property-的启发式规则"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"集成测试与 E2E 测试的 AI 辅助生成","url":"/l-doc-books/h/ai-native-engineering/ai-native-testing/techniques/integration-e2e-generation"},"next":{"title":"AI Agent 驱动的 TDD：spec → test → impl 循环","url":"/l-doc-books/h/ai-native-engineering/ai-native-testing/workflows/ai-agent-tdd"}}