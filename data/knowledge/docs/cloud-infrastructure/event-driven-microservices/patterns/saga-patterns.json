(ctx, ReleaseStockActivity, reservationID)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fmt.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Errorf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"order confirmation failed: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%w</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, err)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Activity 实现：实际调用下游服务</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReserveStockActivity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">order</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    resp, err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> inventoryClient.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ReserveStock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ctx, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">inventory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ReserveRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        OrderID: order.ID,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Items:   order.Items,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, err  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Temporal 会根据 RetryPolicy 自动重试</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> resp.ReservationID, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">nil</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"// 启动 Workflow&#10;func startOrderSaga(order Order) error {&#10;    c, _ := client.Dial(client.Options{HostPort: &quot;temporal:7233&quot;})&#10;&#10;    options := client.StartWorkflowOptions{&#10;        ID:        &quot;create-order-&quot; + order.ID,&#10;        TaskQueue: &quot;order-processing&quot;,&#10;    }&#10;&#10;    // 幂等：相同 Workflow ID 不会重复启动&#10;    _, err := c.ExecuteWorkflow(context.Background(), options, CreateOrderWorkflow, order)&#10;    return err&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 启动 Workflow</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> startOrderSaga</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">order</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    c, _ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> client.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Dial</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">client</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Options</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{HostPort: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"temporal:7233\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    options </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> client</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">StartWorkflowOptions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ID:        </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"create-order-\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order.ID,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        TaskQueue: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"order-processing\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 幂等：相同 Workflow ID 不会重复启动</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    _, err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ExecuteWorkflow</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(context.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Background</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), options, CreateOrderWorkflow, order)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"temporal-的恢复能力\">Temporal 的恢复能力</h3><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant W as Temporal Worker&#10;    participant T as Temporal Server&#10;    participant DB as Temporal DB&#10;&#10;    W-&gt;&gt;T: 开始执行 Workflow&#10;    T-&gt;&gt;DB: 持久化执行历史&#10;    Note over W: Worker 进程崩溃&#10;    Note over T: Workflow 任务超时&#10;    T-&gt;&gt;W: 重新调度(新 Worker 实例)&#10;    W-&gt;&gt;T: 重放已完成步骤(从历史恢复状态)&#10;    W-&gt;&gt;W: 从崩溃点继续执行\">sequenceDiagram\n    participant W as Temporal Worker\n    participant T as Temporal Server\n    participant DB as Temporal DB\n\n    W-&gt;&gt;T: 开始执行 Workflow\n    T-&gt;&gt;DB: 持久化执行历史\n    Note over W: Worker 进程崩溃\n    Note over T: Workflow 任务超时\n    T-&gt;&gt;W: 重新调度(新 Worker 实例)\n    W-&gt;&gt;T: 重放已完成步骤(从历史恢复状态)\n    W-&gt;&gt;W: 从崩溃点继续执行</pre><p>Temporal 的核心魔法：Worker 重启后，Temporal 重放 Workflow 历史，<strong>重新执行所有 Activity 调用的记录</strong>（但不实际再次调用外部服务），恢复到崩溃前的状态，然后从断点继续。</p>\n<h2 id=\"补偿事务设计原则\">补偿事务设计原则</h2><table>\n<thead>\n<tr>\n<th>原则</th>\n<th>说明</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>幂等性</strong></td>\n<td>补偿操作可以安全重试</td>\n<td><code>DELETE FROM reservations WHERE order_id = ?</code>（重复执行无副作用）</td>\n</tr>\n<tr>\n<td><strong>语义逆操作</strong></td>\n<td>补偿是业务语义的逆，而非物理回滚</td>\n<td><code>RefundPayment</code>（不是删除支付记录）</td>\n</tr>\n<tr>\n<td><strong>补偿可能失败</strong></td>\n<td>设计补偿失败的处理路径</td>\n<td>补偿失败→人工介入队列</td>\n</tr>\n<tr>\n<td><strong>时间窗口</strong></td>\n<td>某些操作有时间限制，补偿要及时</td>\n<td>支付可以退款的时间窗口</td>\n</tr>\n</tbody></table>\n<p><strong>补偿失败处理（死信队列 + 人工介入）：</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"// 如果补偿失败，发送到人工介入队列&#10;func AlertManualInterventionActivity(ctx context.Context, orderID string, err error) error {&#10;    alert := ManualInterventionAlert{&#10;        OrderID:   orderID,&#10;        Error:     err.Error(),&#10;        CreatedAt: time.Now(),&#10;        Severity:  &quot;HIGH&quot;,&#10;    }&#10;    return alertingService.Send(ctx, alert)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 如果补偿失败，发送到人工介入队列</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AlertManualInterventionActivity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">orderID</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">err</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    alert </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ManualInterventionAlert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        OrderID:   orderID,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Error:     err.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        CreatedAt: time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Severity:  </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"HIGH\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> alertingService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ctx, alert)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"choreography-vs-orchestration-选型指引\">Choreography vs Orchestration 选型指引</h2><table>\n<thead>\n<tr>\n<th>考量维度</th>\n<th>Choreography</th>\n<th>Orchestration</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>复杂度</strong></td>\n<td>低（无中央协调者）</td>\n<td>中（需要维护 Orchestrator）</td>\n</tr>\n<tr>\n<td><strong>可视性</strong></td>\n<td>低（流程分散）</td>\n<td>高（集中定义）</td>\n</tr>\n<tr>\n<td><strong>耦合度</strong></td>\n<td>低（通过事件解耦）</td>\n<td>中（服务需要知道 Orchestrator）</td>\n</tr>\n<tr>\n<td><strong>步骤数</strong></td>\n<td>适合 ≤4 步简单流程</td>\n<td>适合 5+ 步或有并行/条件分支</td>\n</tr>\n<tr>\n<td><strong>调试难度</strong></td>\n<td>高（需追踪多个服务）</td>\n<td>低（集中日志）</td>\n</tr>\n<tr>\n<td><strong>故障恢复</strong></td>\n<td>需自行实现</td>\n<td>Temporal 等工具原生支持</td>\n</tr>\n</tbody></table>\n<h2 id=\"兄弟文档参考\">兄弟文档参考</h2><p>本文聚焦 Saga 的编排实现；Saga 依赖的事件发布可靠性机制（Outbox 模式），参见第1章的最终一致性文档；Saga 与 CQRS 如何结合（Saga 触发投影更新），参见本章 CQRS 文档。</p>\n<h2 id=\"小结\">小结</h2><p>Saga 是分布式系统中替代跨服务 ACID 事务的标准模式，核心是将分布式操作分解为本地事务序列，并为每个步骤设计幂等的补偿事务。Choreography 适合步骤少（≤4步）的简单线性流程；Orchestration 适合复杂的多步骤、有分支和并行的业务流程。Temporal 通过持久化 Workflow 执行历史解决了 Saga 的可靠性难题——Worker 崩溃后可以从断点恢复，无需从头重放已完成步骤。补偿事务必须是幂等的，并且要设计补偿本身失败时的处理路径（人工介入队列）。</p>\n","headings":[{"level":1,"text":"Saga 编排模式：分布式事务的工程实现","id":"saga-编排模式-分布式事务的工程实现"},{"level":2,"text":"Saga 的核心概念","id":"saga-的核心概念"},{"level":2,"text":"Saga 的两种模式","id":"saga-的两种模式"},{"level":3,"text":"Choreography（编排/编舞）","id":"choreography-编排-编舞"},{"level":3,"text":"Orchestration（编排/协调）","id":"orchestration-编排-协调"},{"level":2,"text":"Temporal：工作流引擎实现 Saga","id":"temporal-工作流引擎实现-saga"},{"level":3,"text":"Temporal 的核心概念","id":"temporal-的核心概念"},{"level":3,"text":"Temporal Saga 实现示例（Go）","id":"temporal-saga-实现示例-go"},{"level":3,"text":"Temporal 的恢复能力","id":"temporal-的恢复能力"},{"level":2,"text":"补偿事务设计原则","id":"补偿事务设计原则"},{"level":2,"text":"Choreography vs Orchestration 选型指引","id":"choreography-vs-orchestration-选型指引"},{"level":2,"text":"兄弟文档参考","id":"兄弟文档参考"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"事件溯源与 Event Store","url":"/l-doc-books/h/cloud-infrastructure/event-driven-microservices/patterns/event-sourcing"},"next":{"title":"CQRS 与投影重建","url":"/l-doc-books/h/cloud-infrastructure/event-driven-microservices/patterns/cqrs-projections"}}