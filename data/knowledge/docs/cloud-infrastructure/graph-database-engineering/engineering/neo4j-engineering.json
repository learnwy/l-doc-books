span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">               \"MERGE (a)-[:KNOWS {since: date()}]->(b)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">               Map.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"alice@example.com\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"bob@example.com\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>Python 驱动</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from neo4j import GraphDatabase&#10;&#10;driver = GraphDatabase.driver(&quot;bolt://localhost:7687&quot;, auth=(&quot;neo4j&quot;, &quot;password&quot;))&#10;&#10;def find_friends(tx, name):&#10;    result = tx.run(&#10;        &quot;MATCH (p:Person {name: $name})-[:KNOWS]-&gt;(f:Person) RETURN f.name AS friend&quot;,&#10;        name=name&#10;    )&#10;    return [record[&quot;friend&quot;] for record in result]&#10;&#10;with driver.session() as session:&#10;    friends = session.execute_read(find_friends, &quot;Alice&quot;)&#10;    print(friends)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> neo4j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GraphDatabase</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">driver </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GraphDatabase.driver(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"bolt://localhost:7687\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">auth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"neo4j\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"password\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> find_friends</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(tx, name):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tx.run(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"MATCH (p:Person </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> $name}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)-[:KNOWS]->(f:Person) RETURN f.name AS friend\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">        name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">name</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    )</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [record[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"friend\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> record </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> driver.session() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> session:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    friends </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> session.execute_read(find_friends, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Alice\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(friends)</span></span></code></pre></div><p><strong>连接池配置最佳实践</strong>：</p>\n<ul>\n<li><code>maxConnectionPoolSize</code>：CPU 核数的 2-4 倍</li>\n<li><code>connectionAcquisitionTimeout</code>：30 秒（防止饿死）</li>\n<li>驱动为单例（整个应用共享一个 Driver 实例）</li>\n</ul>\n<h2 id=\"apoc-neo4j-的标准扩展库\">APOC：Neo4j 的标准扩展库</h2><p><strong>APOC（Awesome Procedures On Cypher）</strong> 是 Neo4j 的官方扩展过程库，提供 400+ 个实用过程和函数，涵盖数据导入导出、集合操作、字符串处理、时间操作、图算法等。</p>\n<h3 id=\"安装-apoc\">安装 APOC</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 方式一：Docker&#10;docker run -e NEO4J_PLUGINS=&#39;[&quot;apoc&quot;]&#39; neo4j:5&#10;&#10;# 方式二：neo4j.conf&#10;dbms.security.procedures.unrestricted=apoc.*&#10;# 下载 apoc.jar 放入 $NEO4J_HOME/plugins/\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 方式一：Docker</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">docker</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> NEO4J_PLUGINS='[\"apoc\"]'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> neo4j:5</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 方式二：neo4j.conf</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dbms.security.procedures.unrestricted</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">=apoc.*</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 下载 apoc.jar 放入 $NEO4J_HOME/plugins/</span></span></code></pre></div><h3 id=\"批量操作\">批量操作</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- apoc.periodic.iterate：分批处理大量数据（避免内存溢出）&#10;CALL apoc.periodic.iterate(&#10;  &#39;MATCH (p:Person) RETURN p&#39;,&#10;  &#39;SET p.processed = true&#39;,&#10;  {batchSize: 1000, parallel: false}&#10;)&#10;YIELD batches, total, timeTaken, committedOperations&#10;RETURN batches, total, timeTaken&#10;&#10;-- apoc.periodic.commit：事务内批量提交&#10;CALL apoc.periodic.commit(&#10;  &#39;MATCH (p:Person) WHERE p.score IS NULL&#10;   WITH p LIMIT 500&#10;   SET p.score = apoc.text.levenshteinDistance(p.name, &quot;Alice&quot;)&#10;   RETURN count(*)&#39;,&#10;  {}&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- apoc.periodic.iterate：分批处理大量数据（避免内存溢出）</span></span>\n<span class=\"line\"><span>CALL apoc.periodic.iterate(</span></span>\n<span class=\"line\"><span>  'MATCH (p:Person) RETURN p',</span></span>\n<span class=\"line\"><span>  'SET p.processed = true',</span></span>\n<span class=\"line\"><span>  {batchSize: 1000, parallel: false}</span></span>\n<span class=\"line\"><span>)</span></span>\n<span class=\"line\"><span>YIELD batches, total, timeTaken, committedOperations</span></span>\n<span class=\"line\"><span>RETURN batches, total, timeTaken</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- apoc.periodic.commit：事务内批量提交</span></span>\n<span class=\"line\"><span>CALL apoc.periodic.commit(</span></span>\n<span class=\"line\"><span>  'MATCH (p:Person) WHERE p.score IS NULL</span></span>\n<span class=\"line\"><span>   WITH p LIMIT 500</span></span>\n<span class=\"line\"><span>   SET p.score = apoc.text.levenshteinDistance(p.name, \"Alice\")</span></span>\n<span class=\"line\"><span>   RETURN count(*)',</span></span>\n<span class=\"line\"><span>  {}</span></span>\n<span class=\"line\"><span>)</span></span></code></pre></div><h3 id=\"数据导入\">数据导入</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- 从 CSV 导入（比 LOAD CSV 更灵活）&#10;CALL apoc.load.csv(&#39;file:///users.csv&#39;, {header: true, sep: &#39;,&#39;})&#10;YIELD map AS row&#10;MERGE (p:Person {email: row.email})&#10;SET p.name = row.name, p.age = toInteger(row.age)&#10;&#10;-- 从 JSON 导入&#10;CALL apoc.load.json(&#39;https://api.example.com/data&#39;)&#10;YIELD value&#10;UNWIND value.users AS user&#10;MERGE (p:Person {id: user.id})&#10;SET p += user.attributes\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- 从 CSV 导入（比 LOAD CSV 更灵活）</span></span>\n<span class=\"line\"><span>CALL apoc.load.csv('file:///users.csv', {header: true, sep: ','})</span></span>\n<span class=\"line\"><span>YIELD map AS row</span></span>\n<span class=\"line\"><span>MERGE (p:Person {email: row.email})</span></span>\n<span class=\"line\"><span>SET p.name = row.name, p.age = toInteger(row.age)</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 从 JSON 导入</span></span>\n<span class=\"line\"><span>CALL apoc.load.json('https://api.example.com/data')</span></span>\n<span class=\"line\"><span>YIELD value</span></span>\n<span class=\"line\"><span>UNWIND value.users AS user</span></span>\n<span class=\"line\"><span>MERGE (p:Person {id: user.id})</span></span>\n<span class=\"line\"><span>SET p += user.attributes</span></span></code></pre></div><h3 id=\"图结构操作\">图结构操作</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- 获取节点的所有关系类型&#10;MATCH (p:Person {name: &#39;Alice&#39;})&#10;RETURN apoc.node.relationshipTypes(p) AS relTypes&#10;&#10;-- 动态关系类型查询（关系类型作为变量）&#10;MATCH (p:Person {name: &#39;Alice&#39;})&#10;CALL apoc.cypher.run(&#10;  &#39;MATCH (p)-[r:&#39; + $relType + &#39;]-&gt;(n) RETURN n&#39;,&#10;  {p: p, relType: &#39;KNOWS&#39;}&#10;)&#10;YIELD value&#10;RETURN value.n&#10;&#10;-- 路径查询&#10;CALL apoc.path.spanningTree(&#10;  startNode,&#10;  {relationshipFilter: &#39;KNOWS|FRIENDS_WITH&#39;, maxLevel: 3}&#10;)&#10;YIELD path&#10;RETURN path\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- 获取节点的所有关系类型</span></span>\n<span class=\"line\"><span>MATCH (p:Person {name: 'Alice'})</span></span>\n<span class=\"line\"><span>RETURN apoc.node.relationshipTypes(p) AS relTypes</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 动态关系类型查询（关系类型作为变量）</span></span>\n<span class=\"line\"><span>MATCH (p:Person {name: 'Alice'})</span></span>\n<span class=\"line\"><span>CALL apoc.cypher.run(</span></span>\n<span class=\"line\"><span>  'MATCH (p)-[r:' + $relType + ']->(n) RETURN n',</span></span>\n<span class=\"line\"><span>  {p: p, relType: 'KNOWS'}</span></span>\n<span class=\"line\"><span>)</span></span>\n<span class=\"line\"><span>YIELD value</span></span>\n<span class=\"line\"><span>RETURN value.n</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 路径查询</span></span>\n<span class=\"line\"><span>CALL apoc.path.spanningTree(</span></span>\n<span class=\"line\"><span>  startNode,</span></span>\n<span class=\"line\"><span>  {relationshipFilter: 'KNOWS|FRIENDS_WITH', maxLevel: 3}</span></span>\n<span class=\"line\"><span>)</span></span>\n<span class=\"line\"><span>YIELD path</span></span>\n<span class=\"line\"><span>RETURN path</span></span></code></pre></div><h3 id=\"模式匹配与文本处理\">模式匹配与文本处理</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- 正则表达式&#10;MATCH (p:Person)&#10;WHERE apoc.text.regexGroups(p.name, &#39;^(Alice|Bob)(.*)$&#39;) IS NOT NULL&#10;RETURN p.name&#10;&#10;-- 字符串相似度&#10;MATCH (p:Person), (q:Person)&#10;WHERE id(p) &lt; id(q)&#10;  AND apoc.text.levenshteinSimilarity(p.name, q.name) &gt; 0.8&#10;RETURN p.name, q.name,&#10;       apoc.text.levenshteinSimilarity(p.name, q.name) AS similarity\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- 正则表达式</span></span>\n<span class=\"line\"><span>MATCH (p:Person)</span></span>\n<span class=\"line\"><span>WHERE apoc.text.regexGroups(p.name, '^(Alice|Bob)(.*)$') IS NOT NULL</span></span>\n<span class=\"line\"><span>RETURN p.name</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 字符串相似度</span></span>\n<span class=\"line\"><span>MATCH (p:Person), (q:Person)</span></span>\n<span class=\"line\"><span>WHERE id(p) &#x3C; id(q)</span></span>\n<span class=\"line\"><span>  AND apoc.text.levenshteinSimilarity(p.name, q.name) > 0.8</span></span>\n<span class=\"line\"><span>RETURN p.name, q.name,</span></span>\n<span class=\"line\"><span>       apoc.text.levenshteinSimilarity(p.name, q.name) AS similarity</span></span></code></pre></div><h2 id=\"gds-图数据科学库\">GDS：图数据科学库</h2><p><strong>GDS（Graph Data Science）</strong> 是 Neo4j 的图算法库，提供 50+ 个图算法，包括中心性（Centrality）、社区检测（Community Detection）、相似度（Similarity）、路径查找（Path Finding）等。</p>\n<h3 id=\"gds-工作流\">GDS 工作流</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[原生图 Neo4j DB] --&gt;|投影| B[内存图 In-Memory Graph]&#10;    B --&gt;|算法执行| C{执行模式}&#10;    C --&gt;|stream| D[流式返回结果]&#10;    C --&gt;|write| E[结果写回 DB]&#10;    C --&gt;|stats| F[仅统计信息]&#10;    C --&gt;|mutate| G[修改内存图]\">graph TD\n    A[原生图 Neo4j DB] --&gt;|投影| B[内存图 In-Memory Graph]\n    B --&gt;|算法执行| C{执行模式}\n    C --&gt;|stream| D[流式返回结果]\n    C --&gt;|write| E[结果写回 DB]\n    C --&gt;|stats| F[仅统计信息]\n    C --&gt;|mutate| G[修改内存图]</pre><h3 id=\"图投影\">图投影</h3><p>GDS 先将图数据投影到内存中的高效表示（CSR 格式），再执行算法：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- 创建原生投影（高性能，但灵活性有限）&#10;CALL gds.graph.project(&#10;  &#39;socialGraph&#39;,              -- 图名称&#10;  &#39;Person&#39;,                   -- 节点标签&#10;  &#39;KNOWS&#39;,                    -- 关系类型&#10;  {&#10;    nodeProperties: [&#39;age&#39;],   -- 投影节点属性&#10;    relationshipProperties: [&#39;weight&#39;]  -- 投影关系属性&#10;  }&#10;)&#10;YIELD graphName, nodeCount, relationshipCount, projectMillis&#10;RETURN graphName, nodeCount, relationshipCount&#10;&#10;-- Cypher 投影（更灵活，支持自定义逻辑）&#10;CALL gds.graph.project.cypher(&#10;  &#39;weightedGraph&#39;,&#10;  &#39;MATCH (n:Person) RETURN id(n) AS id, n.age AS age&#39;,&#10;  &#39;MATCH (a:Person)-[r:KNOWS]-&gt;(b:Person)&#10;   RETURN id(a) AS source, id(b) AS target, r.strength AS weight&#39;&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- 创建原生投影（高性能，但灵活性有限）</span></span>\n<span class=\"line\"><span>CALL gds.graph.project(</span></span>\n<span class=\"line\"><span>  'socialGraph',              -- 图名称</span></span>\n<span class=\"line\"><span>  'Person',                   -- 节点标签</span></span>\n<span class=\"line\"><span>  'KNOWS',                    -- 关系类型</span></span>\n<span class=\"line\"><span>  {</span></span>\n<span class=\"line\"><span>    nodeProperties: ['age'],   -- 投影节点属性</span></span>\n<span class=\"line\"><span>    relationshipProperties: ['weight']  -- 投影关系属性</span></span>\n<span class=\"line\"><span>  }</span></span>\n<span class=\"line\"><span>)</span></span>\n<span class=\"line\"><span>YIELD graphName, nodeCount, relationshipCount, projectMillis</span></span>\n<span class=\"line\"><span>RETURN graphName, nodeCount, relationshipCount</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- Cypher 投影（更灵活，支持自定义逻辑）</span></span>\n<span class=\"line\"><span>CALL gds.graph.project.cypher(</span></span>\n<span class=\"line\"><span>  'weightedGraph',</span></span>\n<span class=\"line\"><span>  'MATCH (n:Person) RETURN id(n) AS id, n.age AS age',</span></span>\n<span class=\"line\"><span>  'MATCH (a:Person)-[r:KNOWS]->(b:Person)</span></span>\n<span class=\"line\"><span>   RETURN id(a) AS source, id(b) AS target, r.strength AS weight'</span></span>\n<span class=\"line\"><span>)</span></span></code></pre></div><h3 id=\"中心性算法\">中心性算法</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- PageRank：衡量节点的全局影响力&#10;CALL gds.pageRank.stream(&#39;socialGraph&#39;, {&#10;  maxIterations: 20,&#10;  dampingFactor: 0.85&#10;})&#10;YIELD nodeId, score&#10;WITH gds.util.asNode(nodeId) AS person, score&#10;RETURN person.name AS name, score&#10;ORDER BY score DESC&#10;LIMIT 10&#10;&#10;-- 将 PageRank 写回节点属性&#10;CALL gds.pageRank.write(&#39;socialGraph&#39;, {&#10;  maxIterations: 20,&#10;  writeProperty: &#39;pagerank&#39;&#10;})&#10;YIELD nodePropertiesWritten, ranIterations&#10;&#10;-- 中间中心性（Betweenness Centrality）：识别信息桥节点&#10;CALL gds.betweenness.stream(&#39;socialGraph&#39;)&#10;YIELD nodeId, score&#10;RETURN gds.util.asNode(nodeId).name AS name, score&#10;ORDER BY score DESC&#10;LIMIT 10\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- PageRank：衡量节点的全局影响力</span></span>\n<span class=\"line\"><span>CALL gds.pageRank.stream('socialGraph', {</span></span>\n<span class=\"line\"><span>  maxIterations: 20,</span></span>\n<span class=\"line\"><span>  dampingFactor: 0.85</span></span>\n<span class=\"line\"><span>})</span></span>\n<span class=\"line\"><span>YIELD nodeId, score</span></span>\n<span class=\"line\"><span>WITH gds.util.asNode(nodeId) AS person, score</span></span>\n<span class=\"line\"><span>RETURN person.name AS name, score</span></span>\n<span class=\"line\"><span>ORDER BY score DESC</span></span>\n<span class=\"line\"><span>LIMIT 10</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 将 PageRank 写回节点属性</span></span>\n<span class=\"line\"><span>CALL gds.pageRank.write('socialGraph', {</span></span>\n<span class=\"line\"><span>  maxIterations: 20,</span></span>\n<span class=\"line\"><span>  writeProperty: 'pagerank'</span></span>\n<span class=\"line\"><span>})</span></span>\n<span class=\"line\"><span>YIELD nodePropertiesWritten, ranIterations</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 中间中心性（Betweenness Centrality）：识别信息桥节点</span></span>\n<span class=\"line\"><span>CALL gds.betweenness.stream('socialGraph')</span></span>\n<span class=\"line\"><span>YIELD nodeId, score</span></span>\n<span class=\"line\"><span>RETURN gds.util.asNode(nodeId).name AS name, score</span></span>\n<span class=\"line\"><span>ORDER BY score DESC</span></span>\n<span class=\"line\"><span>LIMIT 10</span></span></code></pre></div><h3 id=\"社区检测算法\">社区检测算法</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- Louvain 算法：模块度优化的层次化社区检测&#10;CALL gds.louvain.stream(&#39;socialGraph&#39;, {&#10;  maxLevels: 10,&#10;  maxIterations: 10,&#10;  tolerance: 0.0001&#10;})&#10;YIELD nodeId, communityId, intermediateCommunityIds&#10;RETURN gds.util.asNode(nodeId).name AS name,&#10;       communityId,&#10;       size(intermediateCommunityIds) AS levels&#10;&#10;-- 弱连通组件（WCC）：识别孤立的子图&#10;CALL gds.wcc.stream(&#39;socialGraph&#39;)&#10;YIELD nodeId, componentId&#10;RETURN componentId, count(nodeId) AS size&#10;ORDER BY size DESC&#10;LIMIT 10&#10;&#10;-- 标签传播算法（LPA）：快速社区检测&#10;CALL gds.labelPropagation.stream(&#39;socialGraph&#39;, {&#10;  maxIterations: 10,&#10;  seedProperty: &#39;communityId&#39;  -- 可用已知标签初始化&#10;})&#10;YIELD nodeId, communityId\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- Louvain 算法：模块度优化的层次化社区检测</span></span>\n<span class=\"line\"><span>CALL gds.louvain.stream('socialGraph', {</span></span>\n<span class=\"line\"><span>  maxLevels: 10,</span></span>\n<span class=\"line\"><span>  maxIterations: 10,</span></span>\n<span class=\"line\"><span>  tolerance: 0.0001</span></span>\n<span class=\"line\"><span>})</span></span>\n<span class=\"line\"><span>YIELD nodeId, communityId, intermediateCommunityIds</span></span>\n<span class=\"line\"><span>RETURN gds.util.asNode(nodeId).name AS name,</span></span>\n<span class=\"line\"><span>       communityId,</span></span>\n<span class=\"line\"><span>       size(intermediateCommunityIds) AS levels</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 弱连通组件（WCC）：识别孤立的子图</span></span>\n<span class=\"line\"><span>CALL gds.wcc.stream('socialGraph')</span></span>\n<span class=\"line\"><span>YIELD nodeId, componentId</span></span>\n<span class=\"line\"><span>RETURN componentId, count(nodeId) AS size</span></span>\n<span class=\"line\"><span>ORDER BY size DESC</span></span>\n<span class=\"line\"><span>LIMIT 10</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 标签传播算法（LPA）：快速社区检测</span></span>\n<span class=\"line\"><span>CALL gds.labelPropagation.stream('socialGraph', {</span></span>\n<span class=\"line\"><span>  maxIterations: 10,</span></span>\n<span class=\"line\"><span>  seedProperty: 'communityId'  -- 可用已知标签初始化</span></span>\n<span class=\"line\"><span>})</span></span>\n<span class=\"line\"><span>YIELD nodeId, communityId</span></span></code></pre></div><h3 id=\"相似度算法\">相似度算法</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- 节点相似度（基于共同邻居）&#10;CALL gds.nodeSimilarity.stream(&#39;socialGraph&#39;, {&#10;  similarityCutoff: 0.5,&#10;  topK: 10&#10;})&#10;YIELD node1, node2, similarity&#10;RETURN gds.util.asNode(node1).name AS person1,&#10;       gds.util.asNode(node2).name AS person2,&#10;       similarity&#10;ORDER BY similarity DESC&#10;&#10;-- 结果写回（创建 SIMILAR_TO 关系）&#10;CALL gds.nodeSimilarity.write(&#39;socialGraph&#39;, {&#10;  writeRelationshipType: &#39;SIMILAR_TO&#39;,&#10;  writeProperty: &#39;score&#39;,&#10;  similarityCutoff: 0.5&#10;})\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- 节点相似度（基于共同邻居）</span></span>\n<span class=\"line\"><span>CALL gds.nodeSimilarity.stream('socialGraph', {</span></span>\n<span class=\"line\"><span>  similarityCutoff: 0.5,</span></span>\n<span class=\"line\"><span>  topK: 10</span></span>\n<span class=\"line\"><span>})</span></span>\n<span class=\"line\"><span>YIELD node1, node2, similarity</span></span>\n<span class=\"line\"><span>RETURN gds.util.asNode(node1).name AS person1,</span></span>\n<span class=\"line\"><span>       gds.util.asNode(node2).name AS person2,</span></span>\n<span class=\"line\"><span>       similarity</span></span>\n<span class=\"line\"><span>ORDER BY similarity DESC</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>-- 结果写回（创建 SIMILAR_TO 关系）</span></span>\n<span class=\"line\"><span>CALL gds.nodeSimilarity.write('socialGraph', {</span></span>\n<span class=\"line\"><span>  writeRelationshipType: 'SIMILAR_TO',</span></span>\n<span class=\"line\"><span>  writeProperty: 'score',</span></span>\n<span class=\"line\"><span>  similarityCutoff: 0.5</span></span>\n<span class=\"line\"><span>})</span></span></code></pre></div><h3 id=\"路径查找\">路径查找</h3><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"-- Dijkstra 最短路径（加权）&#10;MATCH (source:Person {name: &#39;Alice&#39;}), (target:Person {name: &#39;Bob&#39;})&#10;CALL gds.shortestPath.dijkstra.stream(&#39;weightedGraph&#39;, {&#10;  sourceNode: source,&#10;  targetNode: target,&#10;  relationshipWeightProperty: &#39;weight&#39;&#10;})&#10;YIELD index, sourceNode, targetNode, totalCost, nodeIds, costs, path&#10;RETURN totalCost,&#10;       [nodeId IN nodeIds | gds.util.asNode(nodeId).name] AS route,&#10;       costs AS hopCosts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- Dijkstra 最短路径（加权）</span></span>\n<span class=\"line\"><span>MATCH (source:Person {name: 'Alice'}), (target:Person {name: 'Bob'})</span></span>\n<span class=\"line\"><span>CALL gds.shortestPath.dijkstra.stream('weightedGraph', {</span></span>\n<span class=\"line\"><span>  sourceNode: source,</span></span>\n<span class=\"line\"><span>  targetNode: target,</span></span>\n<span class=\"line\"><span>  relationshipWeightProperty: 'weight'</span></span>\n<span class=\"line\"><span>})</span></span>\n<span class=\"line\"><span>YIELD index, sourceNode, targetNode, totalCost, nodeIds, costs, path</span></span>\n<span class=\"line\"><span>RETURN totalCost,</span></span>\n<span class=\"line\"><span>       [nodeId IN nodeIds | gds.util.asNode(nodeId).name] AS route,</span></span>\n<span class=\"line\"><span>       costs AS hopCosts</span></span></code></pre></div><h2 id=\"neo4j-auradb-云托管服务\">Neo4j AuraDB：云托管服务</h2><p><strong>AuraDB</strong> 是 Neo4j 的全托管云服务，分三个层级：</p>\n<table>\n<thead>\n<tr>\n<th>版本</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>AuraDB Free</td>\n<td>永久免费，有容量限制（200K 节点/400K 关系）</td>\n<td>学习和 POC</td>\n</tr>\n<tr>\n<td>AuraDB Professional</td>\n<td>按月付费，自动备份，多区域部署</td>\n<td>中小型生产</td>\n</tr>\n<tr>\n<td>AuraDB Enterprise</td>\n<td>SLA 保证，私有链接（VPC Peering），高可用</td>\n<td>企业生产</td>\n</tr>\n</tbody></table>\n<p>连接 AuraDB 与本地 Neo4j 使用完全相同的 Bolt 驱动，只需替换连接 URI：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"bolt+s://xxxxxxxx.databases.neo4j.io\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>bolt+s://xxxxxxxx.databases.neo4j.io</span></span></code></pre></div><h2 id=\"小结\">小结</h2><p>Neo4j 的工程生态三层架构：Bolt 协议提供高效的客户端连接，APOC 扩展库提供数据导入、批量操作、文本处理等实用工具，GDS 图算法库提供从 PageRank 到社区检测的完整图分析能力。生产工程中，大批量数据操作必须使用 <code>apoc.periodic.iterate</code> 分批提交；图算法必须先创建图投影，再在投影上运行算法；AuraDB 是规避 Neo4j 运维复杂度的最简路径。驱动程序应全生命周期使用单例 Driver 实例，利用连接池管理并发。</p>\n<h2 id=\"本章其他文档\">本章其他文档</h2><ul>\n<li>Schema 设计模式：良好的 Schema 是 APOC 批量操作的前提</li>\n<li>查询性能优化：GDS 算法结果可以驱动索引和查询策略的优化</li>\n</ul>\n","headings":[{"level":1,"text":"Neo4j 工程实践：Bolt、APOC 与 GDS","id":"neo4j-工程实践-bolt-apoc-与-gds"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Bolt 协议","id":"bolt-协议"},{"level":3,"text":"协议概述","id":"协议概述"},{"level":3,"text":"驱动程序使用","id":"驱动程序使用"},{"level":2,"text":"APOC：Neo4j 的标准扩展库","id":"apoc-neo4j-的标准扩展库"},{"level":3,"text":"安装 APOC","id":"安装-apoc"},{"level":3,"text":"批量操作","id":"批量操作"},{"level":3,"text":"数据导入","id":"数据导入"},{"level":3,"text":"图结构操作","id":"图结构操作"},{"level":3,"text":"模式匹配与文本处理","id":"模式匹配与文本处理"},{"level":2,"text":"GDS：图数据科学库","id":"gds-图数据科学库"},{"level":3,"text":"GDS 工作流","id":"gds-工作流"},{"level":3,"text":"图投影","id":"图投影"},{"level":3,"text":"中心性算法","id":"中心性算法"},{"level":3,"text":"社区检测算法","id":"社区检测算法"},{"level":3,"text":"相似度算法","id":"相似度算法"},{"level":3,"text":"路径查找","id":"路径查找"},{"level":2,"text":"Neo4j AuraDB：云托管服务","id":"neo4j-auradb-云托管服务"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"本章其他文档","id":"本章其他文档"}],"prev":{"title":"图数据库查询性能优化","url":"/l-doc-books/h/cloud-infrastructure/graph-database-engineering/engineering/performance-optimization"},"next":{"title":"分布式图数据库：NebulaGraph 与 TigerGraph","url":"/l-doc-books/h/cloud-infrastructure/graph-database-engineering/platforms/distributed-graph-databases"}}