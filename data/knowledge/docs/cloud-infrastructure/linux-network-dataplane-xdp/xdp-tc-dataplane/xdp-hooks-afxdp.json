:#005CC5;--shiki-dark:#79B8FF\"> 2048</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, .tx_ring_size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2048</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .libbpf_flags </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> XSK_LIBBPF_FLAGS__INHIBIT_PROG_LOAD,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .bind_flags  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> XDP_ZEROCOPY </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> XDP_USE_NEED_WAKEUP,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xsk_socket__create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">xsk</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"eth0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, queue_id, umem, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">tx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">cfg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 3. 循环: 先补充 FILL, 再收 RX */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* 把空闲 chunk 地址补进 fill ring */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xsk_ring_prod__reserve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">fill, batch, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">idx_fill) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> batch) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> batch; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xsk_ring_prod__fill_addr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">fill, idx_fill </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> free_addrs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[i];</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        xsk_ring_prod__submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">fill, batch);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* 收取 rx ring 中的包 */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rcvd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xsk_ring_cons__peek</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rx, batch, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">idx_rx);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rcvd; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        __u64 addr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xsk_ring_cons__rx_desc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rx, idx_rx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i)->addr;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        __u32 len  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xsk_ring_cons__rx_desc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rx, idx_rx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i)->len;</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        /* addr 指向 UMEM 中的 chunk, 直接解析, 无拷贝 */</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        process_packet</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xsk_umem__get_data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(buffer, addr), len);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    xsk_ring_cons__release</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rx, rcvd);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* 若使用了 XDP_USE_NEED_WAKEUP, 需显式通知内核 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xsk_ring_prod__needs_wakeup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">fill))</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        recvfrom</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xsk_socket__fd</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(xsk), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, MSG_DONTWAIT, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>几个工程要点。<code>frame_headroom</code> 必须至少为 <code>XDP_PACKET_HEADROOM</code>（256 字节），否则 native 模式绑定会失败。<code>XDP_ZEROCOPY</code> 要求驱动支持，并且<strong>同一个网卡队列不能被内核的其他 XDP 程序与 AF_XDP 同时使用</strong>——绑定 AF_XDP 时通常需要加载一个把该队列流量 <code>XDP_REDIRECT</code> 到该 socket 的 XDP 程序。<code>XDP_USE_NEED_WAKEUP</code> 是忙闲混合的关键：它让应用可以只在必要时唤醒内核，从而在空闲时进入 <code>poll()</code> 睡眠而不烧 CPU，这是 AF_XDP 相对 DPDK 最重要的可运维性优势（见 <a href=\"../packet-path/kernel-bypass\">内核旁路：AF_XDP、DPDK 与取舍</a>）。</p>\n<p>AF_XDP 与 XDP 的另一个区别是<strong>它只需要检查一次边界</strong>：进入 RX ring 的包已经被 XDP 程序验证过长度，UMEM 的 chunk 是固定大小的，应用读 <code>len</code> 字节即可。这省掉了 XDP 程序里那一串 <code>(void *)(hdr + 1) &gt; data_end</code> 检查，是 AF_XDP 编程体验上的实际改善。</p>\n<h2 id=\"性能定位与典型陷阱\">性能定位与典型陷阱</h2><p>把三种挂载模式的性能量级放在一起，可以给出一个可靠的判断框架：</p>\n<ul>\n<li>单核 <code>XDP_DROP</code>（native）：约 2000 万到 4000 万 pps 级，这是纯丢弃的极限值，常被用作「数据面是否配置正确」的基准测试。</li>\n<li>单核 AF_XDP 零拷贝接收：约 500 万到 1000 万 pps 级，取决于包大小与用户态处理量。</li>\n<li>单核常规协议栈收包（含 socket 交付）：约 100 万到 300 万 pps 级。</li>\n<li>单核 <code>XDP_PASS</code> 到协议栈：略低于常规路径（因为多了 BPF 执行），没有性能收益，只有可编程性收益。</li>\n</ul>\n<p>最常见的三个陷阱：<strong>用 generic 模式做压测</strong>（结果毫无参考价值）；<strong>在 XDP 程序里做复杂处理而不用辅助数据结构</strong>（程序执行时间与每包成本线性相关，超过预算会丢包）；<strong>忘记 <code>XDP_TX</code> 需要重算校验和与交换 MAC</strong>（表现为包发出去了但对端不理）。</p>\n<p>一个务实的性能验证方法：先用 <code>xdp-bench</code> 或简单的 <code>XDP_DROP</code> 程序测出本机数据面上限，再逐步增加程序逻辑（解析 → map 查找 → 改写 → 重定向），每个阶段观察 pps 下降幅度。这样能定位出「哪一步的逻辑吃掉了一半性能」，而不是拿一个综合结果猜。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>XDP 三种模式中只有 native 与 offload 是生产选项，generic 会退化到常规路径之后执行，比不用 XDP 更慢；部署应显式指定 <code>xdpdrv</code>。</li>\n<li>六个返回码有隐含的资源语义：<code>XDP_TX</code> 需自行交换 MAC 与重算校验和；<code>XDP_REDIRECT</code> 的目标 map 必须与设备匹配；<code>XDP_TX</code>/<code>XDP_REDIRECT</code> 绕过 qdisc 与 BQL。</li>\n<li>XDP 程序必须通过 verifier 的边界证明：每次指针解引用前都要检查 <code>data_end</code>，这是与普通内核代码最大差别。</li>\n<li>AF_XDP 通过 UMEM 加四个 ring 实现零拷贝用户态收发，<code>frame_headroom</code> 与 <code>XDP_USE_NEED_WAKEUP</code> 是两个关键配置，零拷贝需驱动支持。</li>\n<li>性能量级参照：单核 <code>XDP_DROP</code> 数千万 pps、AF_XDP 数百至千万 pps、常规协议栈百万级；<code>XDP_PASS</code> 没有性能收益。</li>\n<li>需要按策略分类与整形时，TC-BPF 比 XDP 更合适，见 <a href=\"tc-bpf-filtering\">TC-BPF 分类、负载均衡与 DDoS 过滤</a>；程序间共享状态的 map 选型见 <a href=\"maps-cilium-case\">BPF map 数据共享与 Cilium 数据面案例</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"XDP 三种挂载点、返回码与 AF_XDP","id":"xdp-三种挂载点-返回码与-af_xdp"},{"level":2,"text":"核心概念：挂载位置决定性能上限","id":"核心概念-挂载位置决定性能上限"},{"level":2,"text":"返回码语义与隐含副作用","id":"返回码语义与隐含副作用"},{"level":2,"text":"AF_XDP：从内核直达用户态","id":"af_xdp-从内核直达用户态"},{"level":2,"text":"性能定位与典型陷阱","id":"性能定位与典型陷阱"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"qdisc、BQL 与发送侧拥塞","url":"/l-doc-books/h/cloud-infrastructure/linux-network-dataplane-xdp/nic-scaling/qdisc-bql"},"next":{"title":"TC-BPF 分类、负载均衡与 DDoS 过滤","url":"/l-doc-books/h/cloud-infrastructure/linux-network-dataplane-xdp/xdp-tc-dataplane/tc-bpf-filtering"}}