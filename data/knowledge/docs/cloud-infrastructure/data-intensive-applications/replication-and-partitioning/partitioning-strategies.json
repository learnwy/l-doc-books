nters.items():&#10;            recent = [t for t in timestamps if now - t &lt; 60]&#10;            rates[pid] = len(recent)&#10;&#10;        avg_rate = sum(rates.values()) / len(rates) if rates else 0&#10;        hotspots = [&#10;            pid for pid, rate in rates.items()&#10;            if rate &gt; avg_rate * self.threshold_ratio&#10;        ]&#10;        return hotspots&#10;&#10;    def suggest_mitigation(self, hotspot_pid):&#10;        &quot;&quot;&quot;热点缓解建议&quot;&quot;&quot;&#10;        return {&#10;            &#39;split&#39;: f&#39;Split partition {hotspot_pid} into sub-ranges&#39;,&#10;            &#39;salt&#39;: &#39;Add random prefix to distribute writes&#39;,&#10;            &#39;cache&#39;: &#39;Add read cache for hot partition&#39;,&#10;            &#39;rate_limit&#39;: &#39;Apply rate limiting per key&#39;&#10;        }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HotspotDetector</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"分区热点检测\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, num_partitions, window_seconds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.counters </span><span style=\"color:#D73A49;--shiki-dark:#F9