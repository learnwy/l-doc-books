an class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">timeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">30s</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">retry_policy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  max_attempts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  backoff</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">exponential</span></span></code></pre></div><h3 id=\"幂等性保障\">幂等性保障</h3><p>分布式事务中的每个操作都必须是幂等的（重复执行结果相同）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"class IdempotentProcessor:&#10;    &quot;&quot;&quot;基于幂等键的消息处理&quot;&quot;&quot;&#10;    def __init__(self, store):&#10;        self.store = store  # Redis 或数据库&#10;&#10;    async def process(self, idempotency_key, handler):&#10;        # 检查是否已处理&#10;        existing = await self.store.get(f&quot;idem:{idempotency_key}&quot;)&#10;        if existing:&#10;            return json.loads(existing)  # 返回之前的结果&#10;&#10;        # 执行业务逻辑&#10;        result = await handler()&#10;&#10;        # 记录结果 (设置 TTL 防止无限增长)&#10;        await self.store.setex(&#10;            f&quot;idem:{idempotency_key}&quot;,&#10;            ttl=86400 * 7,  # 7 天&#10;            value=json.dumps(result)&#10;        )&#10;        return result\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> IdempotentProcessor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"基于幂等键的消息处理\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, store):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.store </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> store  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Redis 或数据库</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, idempotency_key, handler):</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 检查是否已处理</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        existing </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.store.get(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"idem:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">idempotency_key</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> existing:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> json.loads(existing)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 返回之前的结果</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 执行业务逻辑</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> handler()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 记录结果 (设置 TTL 防止无限增长)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.store.setex(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"idem:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">idempotency_key</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            ttl</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">86400</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 7 天</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">            value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">json.dumps(result)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"方案对比总结\">方案对比总结</h3><table>\n<thead>\n<tr>\n<th>方案</th>\n<th>一致性</th>\n<th>性能</th>\n<th>复杂度</th>\n<th>隔离性</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>2PC/XA</td>\n<td>强一致</td>\n<td>低</td>\n<td>中</td>\n<td>完全隔离</td>\n<td>同构数据库跨库事务</td>\n</tr>\n<tr>\n<td>TCC</td>\n<td>强一致</td>\n<td>中</td>\n<td>高</td>\n<td>业务隔离</td>\n<td>金融核心场景</td>\n</tr>\n<tr>\n<td>Saga (编排)</td>\n<td>最终一致</td>\n<td>高</td>\n<td>中</td>\n<td>无隔离</td>\n<td>长流程业务</td>\n</tr>\n<tr>\n<td>Saga (协调)</td>\n<td>最终一致</td>\n<td>高</td>\n<td>中-高</td>\n<td>无隔离</td>\n<td>需要可观测的业务流</td>\n</tr>\n<tr>\n<td>本地消息表</td>\n<td>最终一致</td>\n<td>高</td>\n<td>低</td>\n<td>无隔离</td>\n<td>简单跨服务同步</td>\n</tr>\n<tr>\n<td>事务消息</td>\n<td>最终一致</td>\n<td>高</td>\n<td>低</td>\n<td>无隔离</td>\n<td>RocketMQ 生态</td>\n</tr>\n</tbody></table>\n<h3 id=\"设计原则\">设计原则</h3><ol>\n<li><strong>能用单库事务就不用分布式事务</strong>：设计时优先考虑数据归属</li>\n<li><strong>Saga 是首选</strong>：大多数业务场景最终一致性足够</li>\n<li><strong>幂等性是前提</strong>：所有参与者操作必须幂等</li>\n<li><strong>补偿操作必须可靠</strong>：失败的补偿写入死信队列人工处理</li>\n<li><strong>超时 = 不确定</strong>：超时后必须查询而非假设失败</li>\n<li><strong>监控优先</strong>：分布式事务必须有全链路追踪</li>\n</ol>\n<h3 id=\"常见陷阱\">常见陷阱</h3><ul>\n<li><strong>悬挂事务</strong>：Cancel 先于 Try 到达（网络乱序），需要防悬挂检查</li>\n<li><strong>空回滚</strong>：Try 超时后执行 Cancel，但 Try 实际还未到达</li>\n<li><strong>补偿风暴</strong>：批量失败触发大量补偿操作导致系统过载</li>\n<li><strong>2PC 超时卡死</strong>：协调者崩溃后参与者永久阻塞</li>\n</ul>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具/框架</th>\n<th>模式</th>\n<th>语言</th>\n<th>特色</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Seata</td>\n<td>AT/TCC/Saga/XA</td>\n<td>Java</td>\n<td>阿里开源，多模式</td>\n</tr>\n<tr>\n<td>DTM</td>\n<td>Saga/TCC/XA/2-phase Msg</td>\n<td>Go</td>\n<td>跨语言 gRPC/HTTP</td>\n</tr>\n<tr>\n<td>Temporal</td>\n<td>Saga (Workflow)</td>\n<td>多语言</td>\n<td>工作流引擎</td>\n</tr>\n<tr>\n<td>Cadence</td>\n<td>Saga (Workflow)</td>\n<td>Go/Java</td>\n<td>Uber 开源</td>\n</tr>\n<tr>\n<td>Eventuate Tram</td>\n<td>Saga (编排/协调)</td>\n<td>Java</td>\n<td>事件驱动</td>\n</tr>\n<tr>\n<td>Axon Framework</td>\n<td>Saga + Event Sourcing</td>\n<td>Java/Kotlin</td>\n<td>CQRS 生态</td>\n</tr>\n<tr>\n<td>RocketMQ</td>\n<td>事务消息</td>\n<td>Java</td>\n<td>本地事务+消息</td>\n</tr>\n<tr>\n<td>Kafka</td>\n<td>事务性生产者</td>\n<td>多语言</td>\n<td>Exactly-once 投递</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>分布式事务没有银弹。2PC 提供强一致性但性能差且有阻塞风险；Saga 通过补偿实现最终一致性，是微服务架构的主流选择；TCC 在需要强隔离的业务场景（如金融）中提供业务层面的 2PC 语义。</p>\n<p>2026 年的趋势是越来越多的系统倾向于&quot;避免分布式事务&quot;而非&quot;实现分布式事务&quot;：通过领域建模将强一致性边界限制在单个服务内（聚合根），跨服务通信使用最终一致性的事件驱动方案。当确实需要跨服务原子性时，Saga + 工作流引擎（如 Temporal）提供了最佳的可观测性和可维护性平衡。</p>\n","headings":[{"level":1,"text":"分布式事务实现机制","id":"分布式事务实现机制"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"两阶段提交（2PC）","id":"两阶段提交-2pc"},{"level":3,"text":"三阶段提交（3PC）","id":"三阶段提交-3pc"},{"level":3,"text":"Saga 模式","id":"saga-模式"},{"level":3,"text":"TCC 模式（Try-Confirm-Cancel）","id":"tcc-模式-try-confirm-cancel"},{"level":3,"text":"Google Spanner 的 TrueTime","id":"google-spanner-的-truetime"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"方案选择决策树","id":"方案选择决策树"},{"level":3,"text":"微服务中的 Saga 实践","id":"微服务中的-saga-实践"},{"level":3,"text":"幂等性保障","id":"幂等性保障"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"方案对比总结","id":"方案对比总结"},{"level":3,"text":"设计原则","id":"设计原则"},{"level":3,"text":"常见陷阱","id":"常见陷阱"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"ACID 与 BASE：事务语义对比","url":"/l-doc-books/h/cloud-infrastructure/data-intensive-applications/transactions-and-consistency/acid-vs-base"},"next":{"title":"分布式一致性模型","url":"/l-doc-books/h/cloud-infrastructure/data-intensive-applications/transactions-and-consistency/consistency-models"}}