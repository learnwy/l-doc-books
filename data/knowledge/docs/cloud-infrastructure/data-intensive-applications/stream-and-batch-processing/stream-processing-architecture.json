4292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"lambda-vs-kappa-架构\">Lambda vs Kappa 架构</h3><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Lambda 架构</th>\n<th>Kappa 架构</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>计算路径</td>\n<td>批处理层 + 速度层</td>\n<td>仅流处理层</td>\n</tr>\n<tr>\n<td>代码重复</td>\n<td>高（两套逻辑）</td>\n<td>低（一套逻辑）</td>\n</tr>\n<tr>\n<td>准确性</td>\n<td>批处理层保证最终精确</td>\n<td>依赖流处理的精确性</td>\n</tr>\n<tr>\n<td>运维复杂度</td>\n<td>高（两套系统）</td>\n<td>低</td>\n</tr>\n<tr>\n<td>历史回溯</td>\n<td>批处理重跑</td>\n<td>重放事件日志</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>精确性要求极高</td>\n<td>大多数实时场景</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"Lambda 架构:&#10;  Event Stream → [Speed Layer: Flink] → Serving (近似实时结果)&#10;             → [Batch Layer: Spark]  → Serving (精确结果, T+1)&#10;&#10;Kappa 架构:&#10;  Event Stream (Kafka, 长期保存) → [Stream Layer: Flink] → Serving&#10;  需要回溯时: 从 Kafka offset 0 重放 → Flink 重新计算\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Lambda 架构:</span></span>\n<span class=\"line\"><span>  Event Stream → [Speed Layer: Flink] → Serving (近似实时结果)</span></span>\n<span class=\"line\"><span>             → [Batch Layer: Spark]  → Serving (精确结果, T+1)</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>Kappa 架构:</span></span>\n<span class=\"line\"><span>  Event Stream (Kafka, 长期保存) → [Stream Layer: Flink] → Serving</span></span>\n<span class=\"line\"><span>  需要回溯时: 从 Kafka offset 0 重放 → Flink 重新计算</span></span></code></pre></div><h3 id=\"kafka-flink-实时管道\">Kafka + Flink 实时管道</h3><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# PyFlink: 实时用户行为聚合&#10;from pyflink.table import EnvironmentSettings, TableEnvironment&#10;&#10;t_env = TableEnvironment.create(EnvironmentSettings.in_streaming_mode())&#10;&#10;# Source: Kafka&#10;t_env.execute_sql(&quot;&quot;&quot;&#10;    CREATE TABLE user_events (&#10;        user_id STRING,&#10;        event_type STRING,&#10;        event_time TIMESTAMP(3),&#10;        WATERMARK FOR event_time AS event_time - INTERVAL &#39;5&#39; SECOND&#10;    ) WITH (&#10;        &#39;connector&#39; = &#39;kafka&#39;,&#10;        &#39;topic&#39; = &#39;user-events&#39;,&#10;        &#39;properties.bootstrap.servers&#39; = &#39;kafka:9092&#39;,&#10;        &#39;format&#39; = &#39;json&#39;,&#10;        &#39;scan.startup.mode&#39; = &#39;latest-offset&#39;&#10;    )&#10;&quot;&quot;&quot;)&#10;&#10;# 实时聚合: 每 5 分钟窗口统计&#10;t_env.execute_sql(&quot;&quot;&quot;&#10;    CREATE TABLE user_metrics (&#10;        window_start TIMESTAMP(3),&#10;        user_id STRING,&#10;        event_count BIGINT,&#10;        unique_events BIGINT&#10;    ) WITH (&#10;        &#39;connector&#39; = &#39;jdbc&#39;,&#10;        &#39;url&#39; = &#39;jdbc:postgresql://db:5432/metrics&#39;,&#10;        &#39;table-name&#39; = &#39;user_metrics&#39;&#10;    )&#10;&quot;&quot;&quot;)&#10;&#10;t_env.execute_sql(&quot;&quot;&quot;&#10;    INSERT INTO user_metrics&#10;    SELECT&#10;        window_start,&#10;        user_id,&#10;        COUNT(*) as event_count,&#10;        COUNT(DISTINCT event_type) as unique_events&#10;    FROM TABLE(&#10;        TUMBLE(TABLE user_events, DESCRIPTOR(event_time), INTERVAL &#39;5&#39; MINUTE)&#10;    )&#10;    GROUP BY window_start, user_id&#10;&quot;&quot;&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># PyFlink: 实时用户行为聚合</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pyflink.table </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> EnvironmentSettings, TableEnvironment</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">t_env </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TableEnvironment.create(EnvironmentSettings.in_streaming_mode())</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Source: Kafka</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">t_env.execute_sql(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    CREATE TABLE user_events (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        user_id STRING,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        event_type STRING,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        event_time TIMESTAMP(3),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        WATERMARK FOR event_time AS event_time - INTERVAL '5' SECOND</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    ) WITH (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'connector' = 'kafka',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'topic' = 'user-events',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'properties.bootstrap.servers' = 'kafka:9092',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'format' = 'json',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'scan.startup.mode' = 'latest-offset'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    )</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 实时聚合: 每 5 分钟窗口统计</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">t_env.execute_sql(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    CREATE TABLE user_metrics (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        window_start TIMESTAMP(3),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        user_id STRING,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        event_count BIGINT,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        unique_events BIGINT</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    ) WITH (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'connector' = 'jdbc',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'url' = 'jdbc:postgresql://db:5432/metrics',</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'table-name' = 'user_metrics'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    )</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">t_env.execute_sql(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    INSERT INTO user_metrics</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    SELECT</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        window_start,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        user_id,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        COUNT(*) as event_count,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        COUNT(DISTINCT event_type) as unique_events</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    FROM TABLE(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        TUMBLE(TABLE user_events, DESCRIPTOR(event_time), INTERVAL '5' MINUTE)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    )</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    GROUP BY window_start, user_id</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"流处理框架选型\">流处理框架选型</h3><table>\n<thead>\n<tr>\n<th>框架</th>\n<th>延迟</th>\n<th>吞吐</th>\n<th>状态管理</th>\n<th>生态</th>\n<th>推荐场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Apache Flink</td>\n<td>毫秒级</td>\n<td>高</td>\n<td>优秀</td>\n<td>广</td>\n<td>通用实时计算</td>\n</tr>\n<tr>\n<td>Kafka Streams</td>\n<td>毫秒级</td>\n<td>中-高</td>\n<td>良好</td>\n<td>Kafka</td>\n<td>轻量级流处理</td>\n</tr>\n<tr>\n<td>Apache Spark Structured Streaming</td>\n<td>秒级</td>\n<td>极高</td>\n<td>良好</td>\n<td>Spark</td>\n<td>已有 Spark 投入</td>\n</tr>\n<tr>\n<td>Materialize</td>\n<td>毫秒级</td>\n<td>中</td>\n<td>优秀</td>\n<td>SQL</td>\n<td>增量物化视图</td>\n</tr>\n<tr>\n<td>RisingWave</td>\n<td>毫秒级</td>\n<td>中-高</td>\n<td>优秀</td>\n<td>SQL</td>\n<td>云原生流数据库</td>\n</tr>\n</tbody></table>\n<h3 id=\"生产环境关键配置\">生产环境关键配置</h3><ul>\n<li><strong>Checkpoint 间隔</strong>：30-120 秒（过短增加开销，过长增加恢复时间）</li>\n<li><strong>Parallelism</strong>：与 Kafka 分区数对齐</li>\n<li><strong>内存管理</strong>：为 RocksDB 预留足够堆外内存</li>\n<li><strong>背压监控</strong>：告警阈值 &gt; 50% 持续 5 分钟</li>\n<li><strong>Savepoint 策略</strong>：版本升级前手动触发 Savepoint</li>\n</ul>\n<h3 id=\"ai-时代的流处理新需求\">AI 时代的流处理新需求</h3><p>2026 年 AI 场景对流处理提出了更高要求：</p>\n<ul>\n<li><strong>数据新鲜度 &lt; 500ms</strong>：RAG 系统需要近实时的上下文更新</li>\n<li><strong>特征实时计算</strong>：ML Feature Store 的在线特征需要流式更新</li>\n<li><strong>向量流处理</strong>：实时 Embedding 生成和索引更新</li>\n<li><strong>Agent 工作流</strong>：AI Agent 的感知-推理-行动循环需要实时数据</li>\n</ul>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>类型</th>\n<th>特色</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Apache Kafka</td>\n<td>消息/事件存储</td>\n<td>流处理的事件骨干</td>\n</tr>\n<tr>\n<td>Apache Flink</td>\n<td>流处理引擎</td>\n<td>最强大的有状态流处理</td>\n</tr>\n<tr>\n<td>Kafka Streams</td>\n<td>流处理库</td>\n<td>轻量级、无独立集群</td>\n</tr>\n<tr>\n<td>Apache Pulsar</td>\n<td>消息/流存储</td>\n<td>分层存储、多租户</td>\n</tr>\n<tr>\n<td>Redpanda</td>\n<td>Kafka 兼容</td>\n<td>C++ 实现、更低延迟</td>\n</tr>\n<tr>\n<td>Materialize</td>\n<td>流式物化视图</td>\n<td>SQL 语义的增量计算</td>\n</tr>\n<tr>\n<td>Confluent Cloud</td>\n<td>托管流平台</td>\n<td>Kafka + Flink 一站式</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>流处理架构的核心是在延迟、准确性和复杂度之间取得平衡。事件时间语义和 Watermark 解决了乱序问题；有状态计算和 Checkpoint 解决了容错问题；Exactly-Once 语义解决了正确性问题。这三大机制构成了现代流处理框架的技术基石。</p>\n<p>2026 年的趋势是流处理进一步&quot;民主化&quot;——从需要深厚分布式系统知识的专家工具，演变为 SQL 即可驱动的实时分析平台（如 RisingWave、Materialize）。同时 AI 实时推理的需求将流处理从&quot;数据管道工具&quot;提升为&quot;AI 基础设施&quot;，数据新鲜度成为 AI 系统可靠性的关键指标。</p>\n","headings":[{"level":1,"text":"流处理架构与实时计算","id":"流处理架构与实时计算"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"流处理的核心挑战","id":"流处理的核心挑战"},{"level":3,"text":"事件时间 vs 处理时间","id":"事件时间-vs-处理时间"},{"level":3,"text":"Watermark 机制","id":"watermark-机制"},{"level":3,"text":"窗口类型","id":"窗口类型"},{"level":3,"text":"状态管理与 Checkpoint","id":"状态管理与-checkpoint"},{"level":3,"text":"Exactly-Once 语义实现","id":"exactly-once-语义实现"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"Flink 实时欺诈检测","id":"flink-实时欺诈检测"},{"level":3,"text":"Lambda vs Kappa 架构","id":"lambda-vs-kappa-架构"},{"level":3,"text":"Kafka + Flink 实时管道","id":"kafka-flink-实时管道"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"流处理框架选型","id":"流处理框架选型"},{"level":3,"text":"生产环境关键配置","id":"生产环境关键配置"},{"level":3,"text":"AI 时代的流处理新需求","id":"ai-时代的流处理新需求"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"MapReduce 演进：从批处理到统一计算","url":"/l-doc-books/h/cloud-infrastructure/data-intensive-applications/stream-and-batch-processing/mapreduce-evolution"},"next":{"title":"事件溯源与 CQRS 模式","url":"/l-doc-books/h/cloud-infrastructure/data-intensive-applications/stream-and-batch-processing/event-sourcing-cqrs"}}