ion,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                        customProperties</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                            \"domain\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: spec.domain,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                            \"owner\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: spec.owner,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                            \"slo_freshness\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: spec.slo.freshness.threshold,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    OwnershipClass(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">owners</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                        OwnerClass(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">owner</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"urn:li:corpuser:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">spec.ownerEmail</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    ])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    )</span></span></code></pre></div><h2 id=\"访问控制平台能力\">访问控制平台能力</h2><p>平台提供统一的数据访问控制框架，而非每个数据产品自行实现：</p>\n<h3 id=\"基于角色的数据访问\">基于角色的数据访问</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# access-policies/roles.yaml&#10;roles:&#10;  data-analyst:&#10;    description: &#39;数据分析师，可读非 PII 数据&#39;&#10;    permissions:&#10;      - resource: &#39;bigquery-tables&#39;&#10;        datasets: [&#39;*_domain.*_v*&#39;]&#10;        conditions:&#10;          - &#39;NOT sensitivity=PII&#39;&#10;      - resource: &#39;kafka-topics&#39;&#10;        topics: [&#39;*.events.v*&#39;]&#10;        conditions:&#10;          - &#39;NOT classification=CONFIDENTIAL&#39;&#10;&#10;  ml-engineer:&#10;    description: &#39;ML 工程师，可读特征存储和训练数据&#39;&#10;    permissions:&#10;      - resource: &#39;feature-store&#39;&#10;        features: [&#39;*&#39;]&#10;      - resource: &#39;bigquery-tables&#39;&#10;        datasets: [&#39;ml_domain.*&#39;]&#10;&#10;  pii-data-consumer:&#10;    description: &#39;经审批的 PII 数据消费者&#39;&#10;    requirements:&#10;      - &#39;manager_approval&#39;&#10;      - &#39;data_privacy_training_complete&#39;&#10;    permissions:&#10;      - resource: &#39;bigquery-tables&#39;&#10;        datasets: [&#39;user_domain.*&#39;]&#10;        conditions:&#10;          - &#39;sensitivity=PII&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># access-policies/roles.yaml</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">roles</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  data-analyst</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    description</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'数据分析师，可读非 PII 数据'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    permissions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bigquery-tables'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        datasets</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'*_domain.*_v*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        conditions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'NOT sensitivity=PII'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'kafka-topics'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        topics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'*.events.v*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        conditions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'NOT classification=CONFIDENTIAL'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  ml-engineer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    description</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ML 工程师，可读特征存储和训练数据'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    permissions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'feature-store'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        features</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bigquery-tables'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        datasets</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ml_domain.*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  pii-data-consumer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    description</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'经审批的 PII 数据消费者'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    requirements</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'manager_approval'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'data_privacy_training_complete'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    permissions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">resource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bigquery-tables'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        datasets</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'user_domain.*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        conditions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sensitivity=PII'</span></span></code></pre></div><h3 id=\"动态数据脱敏\">动态数据脱敏</h3><p>平台在查询层提供透明的数据脱敏能力：</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 平台层的脱敏视图示例（BigQuery Column-Level Security）&#10;CREATE ROW ACCESS POLICY email_masking&#10;ON user_domain.user_profiles&#10;GRANT TO (&quot;group:data-analyst@company.com&quot;)&#10;FILTER USING (TRUE);&#10;&#10;-- 对 data-analyst 角色，email 字段自动脱敏&#10;-- 通过 BigQuery Policy Tag + Data Masking Rules 实现\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 平台层的脱敏视图示例（BigQuery Column-Level Security）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ROW</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ACCESS </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">POLICY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> email_masking</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user_domain</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user_profiles</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GRANT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"group:data-analyst@company.com\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FILTER</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> USING</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (TRUE);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 对 data-analyst 角色，email 字段自动脱敏</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 通过 BigQuery Policy Tag + Data Masking Rules 实现</span></span></code></pre></div><h2 id=\"平台采用度量\">平台采用度量</h2><p>平台团队应定期测量以下指标，验证自服务能力的实际效果：</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>测量方法</th>\n<th>目标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>新数据产品交付周期</td>\n<td>从需求提出到首个消费者可用的天数</td>\n<td>&lt; 5 个工作日</td>\n</tr>\n<tr>\n<td>平台工具采用率</td>\n<td>使用标准模板创建的数据产品比例</td>\n<td>&gt; 80%</td>\n</tr>\n<tr>\n<td>平台工单量</td>\n<td>领域团队向平台团队提交的支持工单数</td>\n<td>逐季度下降</td>\n</tr>\n<tr>\n<td>数据产品 SLO 达成率</td>\n<td>所有活跃数据产品的平均 SLO 达成率</td>\n<td>&gt; 99%</td>\n</tr>\n<tr>\n<td>消费者满意度</td>\n<td>NPS 季度调查</td>\n<td>&gt; 40</td>\n</tr>\n</tbody></table>\n<h2 id=\"核心概念\">核心概念</h2><table>\n<thead>\n<tr>\n<th>概念</th>\n<th>定义</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>自服务数据平台</strong></td>\n<td>让领域团队无需依赖平台团队就能独立构建数据产品的基础设施工具集</td>\n</tr>\n<tr>\n<td><strong>数据产品模板（Data Product Template）</strong></td>\n<td>平台提供的可复用脚手架，涵盖管道、质量规则、CI/CD 标准配置</td>\n</tr>\n<tr>\n<td><strong>平台即产品（Platform as Product）</strong></td>\n<td>将平台团队的工作视为内部产品开发，领域团队是内部客户</td>\n</tr>\n<tr>\n<td><strong>Backstage</strong></td>\n<td>Spotify 开源的内部开发者门户，可扩展为数据产品平台统一入口</td>\n</tr>\n<tr>\n<td><strong>DataHub</strong></td>\n<td>领英开源的元数据平台，提供数据目录、血缘和 Schema Registry 功能</td>\n</tr>\n<tr>\n<td><strong>声明式基础设施</strong></td>\n<td>通过 YAML 声明所需资源，由 Terraform/Crossplane 自动创建实际云资源</td>\n</tr>\n<tr>\n<td><strong>RBAC（基于角色的访问控制）</strong></td>\n<td>按用户角色授予数据访问权限的访问控制模型</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>自服务平台的成功标志是&quot;领域团队不再需要向平台团队提工单&quot;。实现这一目标需要：提供有意见（opinionated）的数据产品模板降低起始复杂度；构建声明式基础设施申请机制让领域团队自助配置资源；用 Backstage 提供统一的开发者体验入口；用 DataHub/OpenMetadata 打通元数据流转。平台团队的 KPI 应从&quot;执行请求数量&quot;转变为&quot;平台采用率&quot;和&quot;领域团队生产力&quot;。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[领域团队] --&gt;|使用 dp-cli| B[数据产品模板]&#10;    A --&gt;|填写 YAML| C[声明式基础设施]&#10;    C --&gt;|Terraform/Crossplane| D[云资源 Kafka/BigQuery]&#10;    B --&gt;|生成| E[CI/CD 流水线]&#10;    E --&gt;|自动注册| F[DataHub 目录]&#10;    E --&gt;|SLO 监控| G[Prometheus/Grafana]&#10;    H[平台团队] --&gt;|构建和维护| B&#10;    H --&gt;|构建和维护| C\">graph TD\n    A[领域团队] --&gt;|使用 dp-cli| B[数据产品模板]\n    A --&gt;|填写 YAML| C[声明式基础设施]\n    C --&gt;|Terraform/Crossplane| D[云资源 Kafka/BigQuery]\n    B --&gt;|生成| E[CI/CD 流水线]\n    E --&gt;|自动注册| F[DataHub 目录]\n    E --&gt;|SLO 监控| G[Prometheus/Grafana]\n    H[平台团队] --&gt;|构建和维护| B\n    H --&gt;|构建和维护| C</pre>","headings":[{"level":1,"text":"自服务数据平台设计","id":"自服务数据平台设计"},{"level":2,"text":"平台即产品思维","id":"平台即产品思维"},{"level":3,"text":"平台能力框架","id":"平台能力框架"},{"level":2,"text":"核心平台能力设计","id":"核心平台能力设计"},{"level":3,"text":"数据产品模板（Data Product Template）","id":"数据产品模板-data-product-template"},{"level":3,"text":"计算和存储基础设施模板","id":"计算和存储基础设施模板"},{"level":3,"text":"Backstage 作为数据平台门户","id":"backstage-作为数据平台门户"},{"level":3,"text":"DataHub 插件集成","id":"datahub-插件集成"},{"level":2,"text":"访问控制平台能力","id":"访问控制平台能力"},{"level":3,"text":"基于角色的数据访问","id":"基于角色的数据访问"},{"level":3,"text":"动态数据脱敏","id":"动态数据脱敏"},{"level":2,"text":"平台采用度量","id":"平台采用度量"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据产品规格设计","url":"/l-doc-books/h/cloud-infrastructure/data-mesh-architecture/architecture/data-product-spec"},"next":{"title":"数据发现与目录系统","url":"/l-doc-books/h/cloud-infrastructure/data-mesh-architecture/architecture/discovery-catalog"}}