ort DatahubRestEmitter&#10;from datahub.metadata.schema_classes import DatasetPropertiesClass&#10;&#10;def register_data_product(spec_yaml_path: str) -&gt; None:&#10;    &quot;&quot;&quot;从 spec.yaml 自动注册数据产品到 DataHub&quot;&quot;&quot;&#10;    spec = load_spec(spec_yaml_path)&#10;&#10;    emitter = DatahubRestEmitter(&quot;https://datahub.internal&quot;)&#10;&#10;    # 注册数据集&#10;    dataset_urn = f&quot;urn:li:dataset:(urn:li:dataPlatform:{spec.platform},{spec.name},PROD)&quot;&#10;&#10;    emitter.emit_mce(&#10;        MetadataChangeEvent(&#10;            proposedSnapshot=DatasetSnapshotClass(&#10;                urn=dataset_urn,&#10;                aspects=[&#10;                    DatasetPropertiesClass(&#10;                        description=spec.description,&#10;                        customProperties={&#10;                            &quot;domain&quot;: spec.domain,&#10;                            &quot;owner&quot;: spec.owner,&#10;                            &quot;slo_freshness&quot;: spec.slo.freshness.threshold,&#10;                        }&#10;                    ),&#10;                    OwnershipClass(owners=[&#10;                        OwnerClass(owner=f&quot;urn:li:corpuser:{spec.ownerEmail}&quot;)&#10;                    ])&#10;                ]&#10;            )&#10;        )&#10;    )\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># datahub_publisher.py</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 数据产品 CI/CD 中自动注册到 DataHub</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datahub.emitter.rest_emitter </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span sty