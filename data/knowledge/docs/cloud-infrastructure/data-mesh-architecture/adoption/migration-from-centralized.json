:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">iter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(bq.query(legacy_query).result()))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    new_result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">iter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(bq.query(new_query).result()))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    reconciliation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: date,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"row_count_diff\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(legacy_result.row_count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> new_result.row_count),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"row_count_match\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(legacy_result.row_count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> new_result.row_count)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> legacy_result.row_count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.001</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 允许 0.1% 差异</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"total_amount_diff_pct\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            (legacy_result.total_amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> new_result.total_amount)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> legacy_result.total_amount</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"amount_match\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(legacy_result.total_amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> new_result.total_amount)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> legacy_result.total_amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.0001</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 金额允许 0.01% 差异</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> reconciliation</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 在 CI/CD 中每日运行对比，不通过则阻断旧路径下线</span></span></code></pre></div><h2 id=\"lakehouse-到-mesh-的迁移路径\">Lakehouse 到 Mesh 的迁移路径</h2><p>对于已经建立了 Lakehouse（Delta Lake / Apache Iceberg）的组织，迁移策略有其特殊性。</p>\n<h3 id=\"iceberg-table-作为数据产品的存储层\">Iceberg Table 作为数据产品的存储层</h3><p>Lakehouse 的 Iceberg/Delta 表可以直接作为数据产品的存储层，无需重新构建存储：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"迁移策略：重新包装而非重建&#10;&#10;旧模式：&#10;  ETL Pipeline ──→ iceberg_catalog.orders 表（中央治理）&#10;&#10;新模式（数据产品化包装）：&#10;  Order Domain CDC ──→ Flink ──→ iceberg_catalog.order_domain.order_events&#10;                                          │&#10;                           数据产品规格（spec.yaml）&#10;                           定义输出端口、SLO、元数据&#10;                                          │&#10;                           DataHub 注册，作为&quot;数据产品&quot;对外可见\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>迁移策略：重新包装而非重建</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>旧模式：</span></span>\n<span class=\"line\"><span>  ETL Pipeline ──→ iceberg_catalog.orders 表（中央治理）</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>新模式（数据产品化包装）：</span></span>\n<span class=\"line\"><span>  Order Domain CDC ──→ Flink ──→ iceberg_catalog.order_domain.order_events</span></span>\n<span class=\"line\"><span>                                          │</span></span>\n<span class=\"line\"><span>                           数据产品规格（spec.yaml）</span></span>\n<span class=\"line\"><span>                           定义输出端口、SLO、元数据</span></span>\n<span class=\"line\"><span>                                          │</span></span>\n<span class=\"line\"><span>                           DataHub 注册，作为\"数据产品\"对外可见</span></span></code></pre></div><p>关键变化不是存储格式，而是：</p>\n<ul>\n<li>治理所有权从中央团队转到 Order Domain</li>\n<li>添加了 SLO 定义和监控</li>\n<li>通过 spec.yaml 正式声明数据产品接口</li>\n<li>在数据目录中注册，支持自助发现</li>\n</ul>\n<h3 id=\"旧-etl-与新-cdc-的并行期治理\">旧 ETL 与新 CDC 的并行期治理</h3><p>在双轨并行期间，需要明确哪条路径的数据是&quot;权威来源&quot;（Source of Truth）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# migration-governance.yaml&#10;dataProduct: order-events&#10;migration_period:&#10;  start: &#39;2026-07-01&#39;&#10;  expected_end: &#39;2026-10-01&#39;&#10;&#10;authoritative_source_during_migration:&#10;  before_cutover: &#39;legacy_warehouse.orders&#39;&#10;  after_cutover: &#39;order_domain.order_events_v2&#39;&#10;&#10;cutover_criteria:&#10;  - &#39;100% 消费者已完成迁移验证&#39;&#10;  - &#39;新路径 30 天 SLO 达成率 &gt; 99.5%&#39;&#10;  - &#39;对比验证 7 天连续通过&#39;&#10;&#10;rollback_plan:&#10;  trigger: &#39;SLO 达成率连续 3 天 &lt; 99%&#39;&#10;  action: &#39;通知所有消费者回退到旧路径，DPO 进行根因分析&#39;&#10;  max_rollback_time: &#39;2 小时&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># migration-governance.yaml</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">dataProduct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">order-events</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">migration_period</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  start</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2026-07-01'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  expected_end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2026-10-01'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">authoritative_source_during_migration</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  before_cutover</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'legacy_warehouse.orders'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  after_cutover</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'order_domain.order_events_v2'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">cutover_criteria</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'100% 消费者已完成迁移验证'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'新路径 30 天 SLO 达成率 > 99.5%'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'对比验证 7 天连续通过'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">rollback_plan</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  trigger</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'SLO 达成率连续 3 天 &#x3C; 99%'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'通知所有消费者回退到旧路径，DPO 进行根因分析'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  max_rollback_time</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2 小时'</span></span></code></pre></div><h2 id=\"迁移风险矩阵与缓解措施\">迁移风险矩阵与缓解措施</h2><table>\n<thead>\n<tr>\n<th>风险</th>\n<th>概率</th>\n<th>影响</th>\n<th>缓解措施</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>新旧数据不一致</td>\n<td>中</td>\n<td>高</td>\n<td>自动化对比验证每日运行</td>\n</tr>\n<tr>\n<td>消费者迁移延迟</td>\n<td>高</td>\n<td>中</td>\n<td>提前 90 天通知；提供迁移支持</td>\n</tr>\n<tr>\n<td>平台能力不足支撑迁移速度</td>\n<td>中</td>\n<td>中</td>\n<td>先做平台成熟度验证再加速迁移</td>\n</tr>\n<tr>\n<td>旧路径提前下线</td>\n<td>低</td>\n<td>高</td>\n<td>强制要求消费者迁移验证通过后才下线</td>\n</tr>\n<tr>\n<td>DPO 角色空缺</td>\n<td>中</td>\n<td>高</td>\n<td>组织层面明确 DPO 任命和 KPI，不允许无 DPO 的数据产品上线</td>\n</tr>\n</tbody></table>\n<h2 id=\"核心概念\">核心概念</h2><table>\n<thead>\n<tr>\n<th>概念</th>\n<th>定义</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>Strangler Fig 模式</strong></td>\n<td>渐进式迁移策略：新系统逐步&quot;包围&quot;旧系统，直到旧系统可以安全停用</td>\n</tr>\n<tr>\n<td><strong>双写（Dual-Write）</strong></td>\n<td>迁移期间数据同时写入旧路径和新数据产品，确保消费者有充足切换时间</td>\n</tr>\n<tr>\n<td><strong>数据对比验证（Data Reconciliation）</strong></td>\n<td>自动比对新旧数据路径的关键指标，验证数据一致性</td>\n</tr>\n<tr>\n<td><strong>消费者迁移清单</strong></td>\n<td>记录所有依赖特定数据产品的消费者及其迁移状态的文档</td>\n</tr>\n<tr>\n<td><strong>授权来源（Source of Truth）</strong></td>\n<td>在双轨并行期间，明确哪条路径的数据是权威参考</td>\n</tr>\n<tr>\n<td><strong>反向写回（Reverse Write）</strong></td>\n<td>新数据产品向旧数仓写入兼容视图，让旧消费者无缝过渡</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>从集中式数据平台到数据网格的迁移，核心原则是&quot;渐进式、可回滚、价值驱动&quot;。Strangler Fig 模式保证旧消费者不受影响；双写阶段提供充足的验证时间；数据对比（reconciliation）是切换决策的客观依据。迁移最大的风险不是技术，而是消费者迁移的组织协调——建立消费者清单、明确迁移截止日期、提供迁移支持是关键保障。</p>\n<pre class=\"mermaid\" data-diagram-type=\"gantt\" data-source=\"gantt&#10;    title 数据域迁移甘特图示例&#10;    dateFormat YYYY-MM-DD&#10;    section Order Domain&#10;    部署新数据产品(双写)    :active, 2026-07-01, 30d&#10;    消费者迁移(新路径验证)  :2026-07-15, 45d&#10;    对比验证(7天绿)         :2026-08-15, 14d&#10;    旧路径下线               :milestone, 2026-09-01, 0d&#10;    section User Domain&#10;    部署新数据产品           :2026-08-01, 30d&#10;    消费者迁移               :2026-08-20, 45d\">gantt\n    title 数据域迁移甘特图示例\n    dateFormat YYYY-MM-DD\n    section Order Domain\n    部署新数据产品(双写)    :active, 2026-07-01, 30d\n    消费者迁移(新路径验证)  :2026-07-15, 45d\n    对比验证(7天绿)         :2026-08-15, 14d\n    旧路径下线               :milestone, 2026-09-01, 0d\n    section User Domain\n    部署新数据产品           :2026-08-01, 30d\n    消费者迁移               :2026-08-20, 45d</pre>","headings":[{"level":1,"text":"从集中式数据平台迁移到数据网格","id":"从集中式数据平台迁移到数据网格"},{"level":2,"text":"迁移的核心原则","id":"迁移的核心原则"},{"level":2,"text":"Strangler Fig 模式","id":"strangler-fig-模式"},{"level":2,"text":"双写阶段（Dual-Write Phase）","id":"双写阶段-dual-write-phase"},{"level":3,"text":"双写实现策略","id":"双写实现策略"},{"level":2,"text":"消费者迁移管理","id":"消费者迁移管理"},{"level":3,"text":"消费者清单与迁移状态追踪","id":"消费者清单与迁移状态追踪"},{"level":3,"text":"迁移验证对比（Data Reconciliation）","id":"迁移验证对比-data-reconciliation"},{"level":2,"text":"Lakehouse 到 Mesh 的迁移路径","id":"lakehouse-到-mesh-的迁移路径"},{"level":3,"text":"Iceberg Table 作为数据产品的存储层","id":"iceberg-table-作为数据产品的存储层"},{"level":3,"text":"旧 ETL 与新 CDC 的并行期治理","id":"旧-etl-与新-cdc-的并行期治理"},{"level":2,"text":"迁移风险矩阵与缓解措施","id":"迁移风险矩阵与缓解措施"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"组织变革与 Conway 定律对齐","url":"/l-doc-books/h/cloud-infrastructure/data-mesh-architecture/adoption/organization-change"},"next":{"title":"数据网格成熟度评估模型","url":"/l-doc-books/h/cloud-infrastructure/data-mesh-architecture/adoption/maturity-model"}}