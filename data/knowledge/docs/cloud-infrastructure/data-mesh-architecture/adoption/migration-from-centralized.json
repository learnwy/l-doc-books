onciliation = {&#10;        &quot;date&quot;: date,&#10;        &quot;row_count_diff&quot;: abs(legacy_result.row_count - new_result.row_count),&#10;        &quot;row_count_match&quot;: (&#10;            abs(legacy_result.row_count - new_result.row_count)&#10;            / legacy_result.row_count &lt; 0.001  # 允许 0.1% 差异&#10;        ),&#10;        &quot;total_amount_diff_pct&quot;: abs(&#10;            (legacy_result.total_amount - new_result.total_amount)&#10;            / legacy_result.total_amount&#10;        ),&#10;        &quot;amount_match&quot;: (&#10;            abs(legacy_result.total_amount - new_result.total_amount)&#10;            / legacy_result.total_amount &lt; 0.0001  # 金额允许 0.01% 差异&#10;        ),&#10;    }&#10;&#10;    return reconciliation&#10;&#10;# 在 CI/CD 中每日运行对比，不通过则阻断旧路径下线\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># migration/validate_migration.py</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> reconcile_order_data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(date: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    对比旧数仓和新数据产品在指定日期的数据一致性</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    bq