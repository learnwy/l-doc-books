292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.paymentService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">processPayment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ctx),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      compensate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.paymentService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">refundPayment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ctx),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">context</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> completedSteps</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.steps.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.steps[i].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(context);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        completedSteps.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> stepIndex</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> completedSteps.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reverse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.steps[stepIndex].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">compensate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(context);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> error;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>协调式 Saga 的优势是业务流程集中定义、状态追踪清晰、易于实现复杂的分支逻辑和超时处理。劣势是协调器可能成为单点故障和性能瓶颈，且引入了额外的服务依赖。</p>\n<p>状态机是协调器的核心，定义了 Saga 在正常流程和补偿流程中的所有合法状态转换。状态持久化到数据库中，确保协调器重启后可以从断点继续执行。Temporal 和 Cadence 等工作流引擎提供了开箱即用的 Saga 协调器实现，内置了状态持久化、超时处理和重试机制。</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>编排式 Saga</th>\n<th>协调式 Saga</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>协调方式</td>\n<td>事件驱动，去中心化</td>\n<td>集中协调器</td>\n</tr>\n<tr>\n<td>业务可见性</td>\n<td>流程分散，难以追踪</td>\n<td>流程集中，状态清晰</td>\n</tr>\n<tr>\n<td>耦合度</td>\n<td>松耦合</td>\n<td>协调器与参与者耦合</td>\n</tr>\n<tr>\n<td>复杂流程</td>\n<td>难以实现分支和条件</td>\n<td>天然支持</td>\n</tr>\n<tr>\n<td>适用规模</td>\n<td>3-5 个参与者</td>\n<td>5+ 个参与者</td>\n</tr>\n<tr>\n<td>调试难度</td>\n<td>高（事件链追踪）</td>\n<td>低（协调器日志）</td>\n</tr>\n</tbody></table>\n<h2 id=\"隔离性与语义锁\">隔离性与语义锁</h2><p>Saga 模式天然缺少 ACID 事务的隔离性（Isolation），在 Saga 执行期间，中间状态对其他事务可见。这可能导致脏读（读取到未最终提交的中间状态）和不可重复读（同一数据在 Saga 执行期间被其他事务修改）等异常。</p>\n<p>语义锁（Semantic Lock）是解决隔离性问题的常用策略。在订单 Saga 中，创建订单时将状态设为&quot;PENDING&quot;而非&quot;CONFIRMED&quot;，告诉其他事务该订单正在处理中。只有 Saga 的最后一步成功后，才将状态更新为&quot;CONFIRMED&quot;。其他查询订单的事务看到&quot;PENDING&quot;状态时可以选择等待或按业务规则处理。</p>\n<p>交换律（Commutative Updates）设计使得并发的 Saga 操作无论执行顺序如何都能产生正确结果。例如余额扣减操作设计为&quot;扣减指定金额&quot;而非&quot;设置为指定余额&quot;，两个并发的扣减操作无论先后都能得到正确的最终余额。</p>\n<p>重新读取值策略在补偿前重新读取数据的最新值，确保补偿操作基于最新状态执行。如果重新读取发现数据已被其他事务修改到不可补偿的状态，则触发人工介入流程。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Saga 将跨服务事务分解为本地事务 + 补偿事务，实现最终一致性</li>\n<li>编排式 Saga 适合简单流程（3-5 步），协调式 Saga 适合复杂流程（5+ 步）</li>\n<li>补偿事务是独立的业务操作而非简单撤销，必须满足幂等性</li>\n<li>Saga 缺少 ACID 隔离性，通过语义锁、交换律和重新读取等策略缓解</li>\n<li>Temporal/Cadence 等工作流引擎提供开箱即用的 Saga 协调器</li>\n<li>事件设计应包含充足上下文，Schema 版本通过 Registry 管理兼容性</li>\n</ul>\n","headings":[{"level":1,"text":"Saga 分布式事务模式","id":"saga-分布式事务模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"编排式 Saga","id":"编排式-saga"},{"level":2,"text":"协调式 Saga","id":"协调式-saga"},{"level":2,"text":"隔离性与语义锁","id":"隔离性与语义锁"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"API 网关模式","url":"/l-doc-books/h/cloud-infrastructure/microservices-architecture/microservices-patterns/api-gateway-pattern"},"next":{"title":"同步通信模式","url":"/l-doc-books/h/cloud-infrastructure/microservices-architecture/service-communication/sync-communication"}}