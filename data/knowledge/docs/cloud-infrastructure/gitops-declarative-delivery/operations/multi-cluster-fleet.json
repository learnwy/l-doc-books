--shiki-dark:#85E89D\">        files</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">path</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">clusters/*/cluster.yaml</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 读取每个 cluster.yaml</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  template</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'{{cluster_name}}-apps'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    spec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      destination</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        server</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'{{cluster_server}}'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        namespace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">default</span></span></code></pre></div><h2 id=\"flux-多租户多集群模式\">Flux 多租户多集群模式</h2><p>Flux 通过分层 Kustomization 实现多集群管理：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"fleet-infra/&#10;├── clusters/&#10;│   ├── prod-us-east-1/&#10;│   │   ├── flux-system/           # Flux 组件本身的配置&#10;│   │   │   ├── gotk-components.yaml&#10;│   │   │   └── gotk-sync.yaml&#10;│   │   └── apps.yaml              # 这个集群部署哪些应用&#10;│   └── staging/&#10;│       ├── flux-system/&#10;│       └── apps.yaml&#10;├── apps/&#10;│   ├── base/&#10;│   │   └── payment-service/&#10;│   └── overlays/&#10;│       ├── production/&#10;│       └── staging/&#10;└── infrastructure/&#10;    ├── base/&#10;    │   ├── cert-manager/&#10;    │   └── ingress-nginx/&#10;    └── overlays/&#10;        ├── production/&#10;        └── staging/\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>fleet-infra/</span></span>\n<span class=\"line\"><span>├── clusters/</span></span>\n<span class=\"line\"><span>│   ├── prod-us-east-1/</span></span>\n<span class=\"line\"><span>│   │   ├── flux-system/           # Flux 组件本身的配置</span></span>\n<span class=\"line\"><span>│   │   │   ├── gotk-components.yaml</span></span>\n<span class=\"line\"><span>│   │   │   └── gotk-sync.yaml</span></span>\n<span class=\"line\"><span>│   │   └── apps.yaml              # 这个集群部署哪些应用</span></span>\n<span class=\"line\"><span>│   └── staging/</span></span>\n<span class=\"line\"><span>│       ├── flux-system/</span></span>\n<span class=\"line\"><span>│       └── apps.yaml</span></span>\n<span class=\"line\"><span>├── apps/</span></span>\n<span class=\"line\"><span>│   ├── base/</span></span>\n<span class=\"line\"><span>│   │   └── payment-service/</span></span>\n<span class=\"line\"><span>│   └── overlays/</span></span>\n<span class=\"line\"><span>│       ├── production/</span></span>\n<span class=\"line\"><span>│       └── staging/</span></span>\n<span class=\"line\"><span>└── infrastructure/</span></span>\n<span class=\"line\"><span>    ├── base/</span></span>\n<span class=\"line\"><span>    │   ├── cert-manager/</span></span>\n<span class=\"line\"><span>    │   └── ingress-nginx/</span></span>\n<span class=\"line\"><span>    └── overlays/</span></span>\n<span class=\"line\"><span>        ├── production/</span></span>\n<span class=\"line\"><span>        └── staging/</span></span></code></pre></div><p>每个集群的 <code>apps.yaml</code>（Kustomization）引用通用应用层：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# clusters/prod-us-east-1/apps.yaml&#10;apiVersion: kustomize.toolkit.fluxcd.io/v1&#10;kind: Kustomization&#10;metadata:&#10;  name: apps&#10;  namespace: flux-system&#10;spec:&#10;  interval: 10m&#10;  sourceRef:&#10;    kind: GitRepository&#10;    name: fleet-infra&#10;  path: ./apps/overlays/production # 生产环境 overlay&#10;  prune: true&#10;  dependsOn:&#10;    - name: infrastructure # 先等 infrastructure 就绪\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># clusters/prod-us-east-1/apps.yaml</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">apiVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">kustomize.toolkit.fluxcd.io/v1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">kind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Kustomization</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">apps</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  namespace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">flux-system</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">spec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  interval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">10m</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  sourceRef</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    kind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">GitRepository</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">fleet-infra</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  path</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">./apps/overlays/production</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 生产环境 overlay</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  prune</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  dependsOn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">infrastructure</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 先等 infrastructure 就绪</span></span></code></pre></div><h2 id=\"集群标签策略\">集群标签策略</h2><p>统一的集群标签体系是多集群管理的基础：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# 推荐的集群标签体系&#10;metadata:&#10;  labels:&#10;    env: production # dev | staging | production&#10;    region: us-east-1 # 云区域&#10;    provider: aws # aws | gcp | azure | on-prem&#10;    tier: business-critical # business-critical | standard | experimental&#10;    team: platform # 负责团队&#10;    cluster-id: &#39;prod-east-001&#39; # 唯一标识符\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 推荐的集群标签体系</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  labels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    env</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">production</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # dev | staging | production</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    region</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">us-east-1</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 云区域</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    provider</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">aws</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # aws | gcp | azure | on-prem</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    tier</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">business-critical</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # business-critical | standard | experimental</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    team</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">platform</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 负责团队</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    cluster-id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'prod-east-001'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 唯一标识符</span></span></code></pre></div><p>这些标签用于 ApplicationSet Cluster Generator 的 selector，实现精细的应用分发控制。</p>\n<h2 id=\"集群升级的-gitops-策略\">集群升级的 GitOps 策略</h2><p>Kubernetes 版本升级是多集群管理的高频操作：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[测试集群先升级&lt;br/&gt;dev-cluster K8s 1.28→1.29] --&gt; B[验证应用兼容性&lt;br/&gt;运行冒烟测试]&#10;    B --&gt; C[Staging 集群升级&lt;br/&gt;监控 2 周]&#10;    C --&gt; D[生产集群滚动升级&lt;br/&gt;逐集群分批进行]&#10;    D --&gt; E[更新 Git 中的&lt;br/&gt;K8s 版本声明]\">graph LR\n    A[测试集群先升级&lt;br/&gt;dev-cluster K8s 1.28→1.29] --&gt; B[验证应用兼容性&lt;br/&gt;运行冒烟测试]\n    B --&gt; C[Staging 集群升级&lt;br/&gt;监控 2 周]\n    C --&gt; D[生产集群滚动升级&lt;br/&gt;逐集群分批进行]\n    D --&gt; E[更新 Git 中的&lt;br/&gt;K8s 版本声明]</pre><p>在 Git 中跟踪集群版本：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# clusters/prod-us-east-1/cluster.yaml&#10;cluster_name: prod-us-east-1&#10;kubernetes_version: &#39;1.29&#39; # 记录当前版本，用于合规审计&#10;last_upgrade_date: &#39;2026-06-15&#39;&#10;upgrade_channel: stable\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># clusters/prod-us-east-1/cluster.yaml</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">cluster_name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">prod-us-east-1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">kubernetes_version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1.29'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 记录当前版本，用于合规审计</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">last_upgrade_date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2026-06-15'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">upgrade_channel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">stable</span></span></code></pre></div><h2 id=\"多集群的统一可观测性\">多集群的统一可观测性</h2><p>多集群管理需要聚合视图：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# Argo CD：查看所有集群所有 Application 的状态&#10;argocd app list --all-namespaces&#10;&#10;# 按集群过滤&#10;argocd app list --dest-server https://prod-us-east-1.example.com&#10;&#10;# Flux：多集群需要分别访问每个集群（或使用 fleet management 工具）&#10;kubectl --context prod-us-east-1 get kustomizations -A&#10;kubectl --context prod-eu-west-1 get kustomizations -A\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Argo CD：查看所有集群所有 Application 的状态</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">argocd</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> list</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --all-namespaces</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 按集群过滤</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">argocd</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> list</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --dest-server</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> https://prod-us-east-1.example.com</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Flux：多集群需要分别访问每个集群（或使用 fleet management 工具）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --context</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> prod-us-east-1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> get</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> kustomizations</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -A</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --context</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> prod-eu-west-1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> get</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> kustomizations</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -A</span></span></code></pre></div><p>第三方工具增强多集群可观测性：</p>\n<table>\n<thead>\n<tr>\n<th>工具</th>\n<th>功能</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Argo CD Multi-Cluster UI</td>\n<td>Argo CD 内置，跨集群应用视图</td>\n</tr>\n<tr>\n<td>Rancher Fleet</td>\n<td>专为大规模集群舰队设计，Kubernetes 原生</td>\n</tr>\n<tr>\n<td>Portainer</td>\n<td>多集群统一管理 Web UI</td>\n</tr>\n<tr>\n<td>Grafana（多数据源）</td>\n<td>聚合多集群 Prometheus 指标</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>多集群舰队管理的核心是&quot;把集群当成应用一样管理&quot;：通过统一的 label 体系标记集群属性，通过 ApplicationSet Generator（Cluster/Matrix/Git）批量生成和维护跨集群的应用部署，通过 Kustomize overlay 或 postBuild 变量替换处理集群间的差异配置。Argo CD 的 ApplicationSet 是目前最成熟的多集群调度方案，三种 Generator 分别应对不同的扩展需求：Cluster Generator 用于&quot;所有集群部署同一组件&quot;，Matrix Generator 用于&quot;所有应用 × 所有集群&quot;，Git Generator 用于&quot;每个集群有独立的参数文件&quot;。Flux 的多集群方案更依赖分层 Kustomization，在集群数量可控时是更简洁的选择。随着集群数量增长（超过 50 个），专为舰队设计的工具（Rancher Fleet）比通用 GitOps 工具更具扩展优势。</p>\n<hr>\n<p><em>下一步：<a href=\"compliance-audit-trail\">合规与审计追踪</a> 展示如何将 GitOps 的 Git 历史转化为满足 SOC2、PCI-DSS 等合规要求的审计证明。</em></p>\n","headings":[{"level":1,"text":"多集群舰队管理：GitOps 在大规模集群环境中的扩展","id":"多集群舰队管理-gitops-在大规模集群环境中的扩展"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"多集群 GitOps 的核心挑战","id":"多集群-gitops-的核心挑战"},{"level":2,"text":"Argo CD 多集群：集群注册与 ApplicationSet","id":"argo-cd-多集群-集群注册与-applicationset"},{"level":3,"text":"集群注册","id":"集群注册"},{"level":3,"text":"Cluster Generator：自动发现集群","id":"cluster-generator-自动发现集群"},{"level":3,"text":"Matrix Generator：集群 × 应用 的笛卡尔积","id":"matrix-generator-集群-应用-的笛卡尔积"},{"level":3,"text":"Git Generator：基于 Git 目录结构生成","id":"git-generator-基于-git-目录结构生成"},{"level":2,"text":"Flux 多租户多集群模式","id":"flux-多租户多集群模式"},{"level":2,"text":"集群标签策略","id":"集群标签策略"},{"level":2,"text":"集群升级的 GitOps 策略","id":"集群升级的-gitops-策略"},{"level":2,"text":"多集群的统一可观测性","id":"多集群的统一可观测性"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"漂移检测与自动修复：维护集群配置完整性的系统方法","url":"/l-doc-books/h/cloud-infrastructure/gitops-declarative-delivery/operations/drift-detection-remediation"},"next":{"title":"合规与审计追踪：用 Git 历史构建可验证的变更证明链","url":"/l-doc-books/h/cloud-infrastructure/gitops-declarative-delivery/operations/compliance-audit-trail"}}