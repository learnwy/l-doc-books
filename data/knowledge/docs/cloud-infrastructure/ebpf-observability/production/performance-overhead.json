, DEEP_INSPECT);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> XDP_PASS;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 深度检测程序（仅 5% 触发）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">SEC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"xdp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xdp_deep_inspect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> xdp_md </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 复杂协议解析和规则匹配（~500ns）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"策略四-采样\">策略四：采样</h3><p>对超高频事件使用概率采样：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// 1% 采样——统计上足够准确，开销降 100 倍&#10;SEC(&quot;tracepoint/sched/sched_switch&quot;)&#10;int trace_switches(void *ctx) {&#10;    // 使用 BPF 随机数实现概率采样&#10;    if (bpf_get_prandom_u32() % 100 != 0)&#10;        return 0;  // 99% 直接跳过&#10;&#10;    // 只处理 1% 的事件&#10;    // ...&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1% 采样——统计上足够准确，开销降 100 倍</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">SEC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tracepoint/sched/sched_switch\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> trace_switches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 使用 BPF 随机数实现概率采样</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bpf_get_prandom_u32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 99% 直接跳过</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 只处理 1% 的事件</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"开销测量方法论\">开销测量方法论</h2><h3 id=\"生产环境测量\">生产环境测量</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 方法 1：bpftool prog 运行统计（需 bpf_stats_enabled）&#10;echo 1 &gt; /proc/sys/kernel/bpf_stats_enabled&#10;bpftool prog show --json | jq &#39;.[] | {name, run_cnt, run_time_ns,&#10;    avg_ns: (.run_time_ns / .run_cnt)}&#39;&#10;&#10;# 方法 2：perf stat 对比（加载前/后）&#10;perf stat -a -e cycles,instructions -- sleep 10  # 基线&#10;# 加载 eBPF 程序后&#10;perf stat -a -e cycles,instructions -- sleep 10  # 对比&#10;&#10;# 方法 3：应用层基准测试（真实工作负载）&#10;wrk -t4 -c100 -d30s http://service:8080/api  # 基线&#10;# 加载 eBPF 程序后重复，对比 P50/P99 延迟\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 方法 1：bpftool prog 运行统计（需 bpf_stats_enabled）</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /proc/sys/kernel/bpf_stats_enabled</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bpftool</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> prog</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> show</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --json</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> jq</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '.[] | {name, run_cnt, run_time_ns,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    avg_ns: (.run_time_ns / .run_cnt)}'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 方法 2：perf stat 对比（加载前/后）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">perf</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> stat</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -a</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cycles,instructions</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> sleep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 10</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 基线</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 加载 eBPF 程序后</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">perf</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> stat</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -a</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cycles,instructions</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> sleep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 10</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 对比</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 方法 3：应用层基准测试（真实工作负载）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">wrk</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t4</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c100</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d30s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> http://service:8080/api</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 基线</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 加载 eBPF 程序后重复，对比 P50/P99 延迟</span></span></code></pre></div><h3 id=\"开销预算分配\">开销预算分配</h3><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>可接受总开销</th>\n<th>分配策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>延迟敏感型（交易系统）</td>\n<td>&lt; 1% CPU</td>\n<td>仅 tracepoint + percpu map</td>\n</tr>\n<tr>\n<td>通用 Web 服务</td>\n<td>&lt; 3% CPU</td>\n<td>完整网络观测 + 采样 profiling</td>\n</tr>\n<tr>\n<td>批处理/大数据</td>\n<td>&lt; 5% CPU</td>\n<td>全量追踪 + L7 解析</td>\n</tr>\n<tr>\n<td>安全监控（合规）</td>\n<td>&lt; 3% CPU</td>\n<td>全量 syscall 审计</td>\n</tr>\n<tr>\n<td>开发/测试环境</td>\n<td>&lt; 10% CPU</td>\n<td>全量追踪 + 全量事件</td>\n</tr>\n</tbody></table>\n<h2 id=\"常见性能陷阱\">常见性能陷阱</h2><table>\n<thead>\n<tr>\n<th>陷阱</th>\n<th>症状</th>\n<th>根因</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Map 锁竞争</td>\n<td>CPU 突增、尾延迟飙升</td>\n<td>多 CPU 争用同一 hash bucket</td>\n<td>改用 Per-CPU map</td>\n</tr>\n<tr>\n<td>Ring Buffer 溢出</td>\n<td>事件丢失、监控盲区</td>\n<td>消费端跟不上生产</td>\n<td>增大 buffer 或内核态过滤</td>\n</tr>\n<tr>\n<td>栈展开风暴</td>\n<td>profiling 期间 CPU 10%+</td>\n<td>每个采样都做全栈展开</td>\n<td>降低采样频率或限制栈深</td>\n</tr>\n<tr>\n<td>高频 kprobe</td>\n<td>系统延迟增加</td>\n<td>int3 断点在热路径</td>\n<td>迁移到 fentry 或 tracepoint</td>\n</tr>\n<tr>\n<td>大 value map</td>\n<td>内存爆炸</td>\n<td>percpu map × large value × many CPUs</td>\n<td>减小 value 或使用非 percpu</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>优化策略可归纳为四条，按收益从高到低应用：</p>\n<ol>\n<li><strong>内核态过滤</strong>：只把满足条件的事件传到用户态，从源头削减事件量，是最直接的降开销手段</li>\n<li><strong>内核态聚合</strong>：把高频事件压缩为直方图或 Top-K 结果，压缩比可达数千到十万倍，仅传聚合结果</li>\n<li><strong>尾调用分层</strong>：入口程序快速分类，把复杂逻辑拆到独立程序按条件执行，让多数事件走最短路径</li>\n<li><strong>概率采样</strong>：对超高频事件按比例采样，统计上足够准确而开销成比例下降</li>\n</ol>\n<p>其余关键结论：开销 = 单次执行时间 × 触发频率，因此高频 hook 必须极度精简；map 类型选择（per-CPU 消除锁竞争）与 ring buffer 容量规划同样影响最终开销；生产环境应持续监控 ring buffer 丢弃计数与 <code>bpftool prog show</code> 的运行统计。</p>\n<hr>\n<blockquote>\n<p><strong>相关文档</strong>：<a href=\"ebpf-kubernetes\">eBPF 在 Kubernetes 中的部署</a> 提供部署架构背景；<a href=\"ebpf-ecosystem-future\">eBPF 生态与未来</a> 关注新内核版本带来的性能改进。</p>\n</blockquote>\n","headings":[{"level":1,"text":"性能开销评估与优化","id":"性能开销评估与优化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"开销来源分解","id":"开销来源分解"},{"level":3,"text":"各阶段开销基准","id":"各阶段开销基准"},{"level":2,"text":"程序复杂度量化","id":"程序复杂度量化"},{"level":2,"text":"触发频率的影响","id":"触发频率的影响"},{"level":2,"text":"Map 操作性能","id":"map-操作性能"},{"level":3,"text":"Hash Map 与 Per-CPU 对比","id":"hash-map-与-per-cpu-对比"},{"level":3,"text":"Ring Buffer 吞吐量","id":"ring-buffer-吞吐量"},{"level":2,"text":"优化策略","id":"优化策略"},{"level":3,"text":"策略一：内核态过滤","id":"策略一-内核态过滤"},{"level":3,"text":"策略二：内核态聚合","id":"策略二-内核态聚合"},{"level":3,"text":"策略三：尾调用分层","id":"策略三-尾调用分层"},{"level":3,"text":"策略四：采样","id":"策略四-采样"},{"level":2,"text":"开销测量方法论","id":"开销测量方法论"},{"level":3,"text":"生产环境测量","id":"生产环境测量"},{"level":3,"text":"开销预算分配","id":"开销预算分配"},{"level":2,"text":"常见性能陷阱","id":"常见性能陷阱"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"eBPF 在 Kubernetes 中的部署","url":"/l-doc-books/h/cloud-infrastructure/ebpf-observability/production/ebpf-kubernetes"},"next":{"title":"eBPF 生态系统与未来方向","url":"/l-doc-books/h/cloud-infrastructure/ebpf-observability/production/ebpf-ecosystem-future"}}