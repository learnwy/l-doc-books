span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">allowed) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        // 非白名单端口的外连——可能是数据外泄</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> net_alert alert </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {};</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        alert.pid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_get_current_pid_tgid</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        alert.dport </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dport;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        alert.daddr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx->daddr[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        alert.ts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_ktime_get_ns</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        bpf_get_current_comm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">alert.comm, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(alert.comm));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        bpf_ringbuf_output</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">alerts, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">alert, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(alert), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"网络威胁检测矩阵\">网络威胁检测矩阵</h3><table>\n<thead>\n<tr>\n<th>威胁类别</th>\n<th>检测方法</th>\n<th>eBPF 挂载点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>端口扫描</td>\n<td>短时间内大量 SYN 到不同端口</td>\n<td>tc ingress / XDP</td>\n</tr>\n<tr>\n<td>DNS 隧道</td>\n<td>DNS 查询长度异常、高频 TXT 记录</td>\n<td>tc (UDP:53)</td>\n</tr>\n<tr>\n<td>横向移动</td>\n<td>容器间非预期连接</td>\n<td>sock/inet_sock_set_state</td>\n</tr>\n<tr>\n<td>数据外泄</td>\n<td>大流量外连到非业务 IP</td>\n<td>tc egress</td>\n</tr>\n<tr>\n<td>C2 通信</td>\n<td>周期性小数据量外连</td>\n<td>connect/sendmsg tracepoint</td>\n</tr>\n<tr>\n<td>ARP 欺骗</td>\n<td>同一 IP 映射多个 MAC</td>\n<td>XDP (ARP 包解析)</td>\n</tr>\n</tbody></table>\n<h2 id=\"kubernetes-安全策略\">Kubernetes 安全策略</h2><p>在 Kubernetes 环境中，eBPF 安全策略需要与 Pod 身份绑定。Tetragon 的方式是通过 cgroup ID 关联 Pod metadata：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// 获取当前进程的 cgroup ID（对应 Pod）&#10;u64 cgroup_id = bpf_get_current_cgroup_id();&#10;&#10;// 通过 map 查找 cgroup ID -&gt; Pod 名称的映射&#10;struct pod_info *pod = bpf_map_lookup_elem(&amp;cgroup_pod_map,&#10;                                            &amp;cgroup_id);&#10;if (pod) {&#10;    // 应用 Pod 级别的安全策略&#10;    struct policy *pol = bpf_map_lookup_elem(&amp;pod_policies,&#10;                                              &amp;pod-&gt;policy_id);&#10;    // ...&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 获取当前进程的 cgroup ID（对应 Pod）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">u64 cgroup_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_get_current_cgroup_id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 通过 map 查找 cgroup ID -> Pod 名称的映射</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pod_info </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pod </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_map_lookup_elem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">cgroup_pod_map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                                            &#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">cgroup_id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pod) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 应用 Pod 级别的安全策略</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> policy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pol </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_map_lookup_elem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pod_policies,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                                              &#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pod->policy_id);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>策略层级</th>\n<th>实现方式</th>\n<th>粒度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>集群级</td>\n<td>全节点 eBPF DaemonSet</td>\n<td>所有 Pod</td>\n</tr>\n<tr>\n<td>Namespace 级</td>\n<td>按 namespace 标签过滤</td>\n<td>命名空间内 Pod</td>\n</tr>\n<tr>\n<td>Pod 级</td>\n<td>通过 cgroup ID 匹配</td>\n<td>单个 Pod</td>\n</tr>\n<tr>\n<td>容器级</td>\n<td>通过 PID namespace 匹配</td>\n<td>单个容器</td>\n</tr>\n<tr>\n<td>进程级</td>\n<td>通过 binary hash 匹配</td>\n<td>特定二进制</td>\n</tr>\n</tbody></table>\n<h2 id=\"安全事件关联分析\">安全事件关联分析</h2><p>单一安全事件往往是误报；多事件关联才能识别真实攻击链。eBPF 的优势在于同一个 agent 同时采集进程、网络、文件事件，天然具备关联条件。</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant Attacker as 攻击者&#10;    participant Pod as 目标 Pod&#10;    participant eBPF as eBPF Agent&#10;    participant SIEM as 安全平台&#10;&#10;    Attacker-&gt;&gt;Pod: RCE 漏洞利用&#10;    Pod-&gt;&gt;eBPF: execve(/bin/sh) [进程监控]&#10;    eBPF-&gt;&gt;SIEM: Alert: 容器内启动 shell&#10;&#10;    Pod-&gt;&gt;eBPF: open(/etc/shadow, O_RDONLY) [文件监控]&#10;    eBPF-&gt;&gt;SIEM: Alert: 敏感文件读取&#10;&#10;    Pod-&gt;&gt;eBPF: connect(attacker_ip:4444) [网络监控]&#10;    eBPF-&gt;&gt;SIEM: Alert: 异常外连&#10;&#10;    Note over SIEM: 关联分析: 同一 Pod/时间窗口&lt;br/&gt;shell + 敏感文件 + 外连 = 高置信度入侵&#10;    SIEM-&gt;&gt;eBPF: 触发响应策略&#10;    eBPF-&gt;&gt;Pod: kill 进程 / 隔离网络\">sequenceDiagram\n    participant Attacker as 攻击者\n    participant Pod as 目标 Pod\n    participant eBPF as eBPF Agent\n    participant SIEM as 安全平台\n\n    Attacker-&gt;&gt;Pod: RCE 漏洞利用\n    Pod-&gt;&gt;eBPF: execve(/bin/sh) [进程监控]\n    eBPF-&gt;&gt;SIEM: Alert: 容器内启动 shell\n\n    Pod-&gt;&gt;eBPF: open(/etc/shadow, O_RDONLY) [文件监控]\n    eBPF-&gt;&gt;SIEM: Alert: 敏感文件读取\n\n    Pod-&gt;&gt;eBPF: connect(attacker_ip:4444) [网络监控]\n    eBPF-&gt;&gt;SIEM: Alert: 异常外连\n\n    Note over SIEM: 关联分析: 同一 Pod/时间窗口&lt;br/&gt;shell + 敏感文件 + 外连 = 高置信度入侵\n    SIEM-&gt;&gt;eBPF: 触发响应策略\n    eBPF-&gt;&gt;Pod: kill 进程 / 隔离网络</pre><p><strong>关联规则示例</strong>：</p>\n<ul>\n<li><code>execve(shell) + connect(外部IP)</code> 在 30s 内 = 反弹 Shell（置信度 95%）</li>\n<li><code>open(敏感文件) + sendto(外部IP)</code> 在 60s 内 = 数据外泄（置信度 80%）</li>\n<li><code>setuid(0) + execve(非标准路径)</code> = 提权后执行（置信度 90%）</li>\n</ul>\n<h2 id=\"与传统安全工具对比\">与传统安全工具对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>auditd</th>\n<th>Falco (eBPF)</th>\n<th>Tetragon (eBPF)</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>检测延迟</td>\n<td>秒级（日志解析）</td>\n<td>毫秒级（内核事件）</td>\n<td>微秒级（内核事件）</td>\n</tr>\n<tr>\n<td>阻断能力</td>\n<td>无（仅审计）</td>\n<td>有限（kill 信号）</td>\n<td>完整（LSM 内核拒绝）</td>\n</tr>\n<tr>\n<td>性能开销</td>\n<td>5-15%</td>\n<td>1-3%</td>\n<td>1-3%</td>\n</tr>\n<tr>\n<td>容器感知</td>\n<td>无</td>\n<td>有（cgroup）</td>\n<td>有（cgroup + labels）</td>\n</tr>\n<tr>\n<td>策略语言</td>\n<td>复杂规则文件</td>\n<td>YAML 规则</td>\n<td>CRD (TracingPolicy)</td>\n</tr>\n<tr>\n<td>内核版本要求</td>\n<td>任意</td>\n<td>4.14+</td>\n<td>4.19+（LSM 需 5.7+）</td>\n</tr>\n</tbody></table>\n<h2 id=\"生产部署建议\">生产部署建议</h2><ol>\n<li><strong>分层部署</strong>：观测层（tracepoint）始终开启，阻断层（LSM）按策略逐步启用</li>\n<li><strong>误报管理</strong>：新规则先以 audit 模式运行 7 天，确认无误报后切换为 enforce</li>\n<li><strong>性能监控</strong>：部署安全 eBPF 程序后监控节点 CPU 和 ring buffer 丢弃率</li>\n<li><strong>策略版本化</strong>：安全规则作为 Kubernetes CRD 存储在 Git 中，变更走 PR 审核</li>\n<li><strong>逃逸检测</strong>：监控 <code>bpf()</code> 系统调用本身——攻击者可能尝试加载恶意 eBPF 程序</li>\n</ol>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>范式转变</strong>：eBPF 把安全检测从事后日志审计推进到系统调用路径上的实时检测与阻断，延迟降至微秒级</li>\n<li><strong>能力分层</strong>：观测用 tracepoint/kprobe，阻断用 LSM/seccomp-bpf，网络策略用 XDP/tc，选择取决于是否需要决策权</li>\n<li><strong>三类监控对象</strong>：进程行为（execve 及进程树异常）、文件访问（敏感路径审计与阻断）、网络连接（非白名单外连）</li>\n<li><strong>关联出真相</strong>：单事件多为误报，同一 Pod、时间窗口内的 shell + 敏感文件读取 + 外连组合才构成高置信度入侵</li>\n<li><strong>部署建议</strong>：观测层常开、阻断层逐步启用；新规则先以 audit 模式运行确认无误报再转 enforce；策略以 CRD 版本化</li>\n</ul>\n<hr>\n<blockquote>\n<p><strong>相关文档</strong>：<a href=\"network-observability\">网络可观测性</a> 提供网络层监控的技术细节；<a href=\"system-tracing-profiling\">系统追踪与性能分析</a> 的进程追踪能力是安全监控的基础数据源。</p>\n</blockquote>\n","headings":[{"level":1,"text":"安全监控与运行时检测","id":"安全监控与运行时检测"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"安全监控架构","id":"安全监控架构"},{"level":2,"text":"进程行为监控","id":"进程行为监控"},{"level":3,"text":"异常检测规则","id":"异常检测规则"},{"level":2,"text":"文件访问审计","id":"文件访问审计"},{"level":2,"text":"网络安全监控","id":"网络安全监控"},{"level":3,"text":"网络威胁检测矩阵","id":"网络威胁检测矩阵"},{"level":2,"text":"Kubernetes 安全策略","id":"kubernetes-安全策略"},{"level":2,"text":"安全事件关联分析","id":"安全事件关联分析"},{"level":2,"text":"与传统安全工具对比","id":"与传统安全工具对比"},{"level":2,"text":"生产部署建议","id":"生产部署建议"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"系统追踪与性能分析","url":"/l-doc-books/h/cloud-infrastructure/ebpf-observability/observability/system-tracing-profiling"},"next":{"title":"BCC 与 bpftrace 快速追踪","url":"/l-doc-books/h/cloud-infrastructure/ebpf-observability/toolchain/bcc-bpftrace"}}