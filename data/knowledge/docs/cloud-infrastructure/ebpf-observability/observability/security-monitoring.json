e=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    evt.ppid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BPF_CORE_READ</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(task, real_parent, tgid);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    bpf_get_current_comm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">evt.comm, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(evt.comm));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 获取 UID/GID</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    u64 uid_gid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_get_current_uid_gid</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    evt.uid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (u32)uid_gid;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    evt.gid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uid_gid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    bpf_ringbuf_output</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">events, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">evt, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(evt), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"异常检测规则\">异常检测规则</h3><table>\n<thead>\n<tr>\n<th>检测场景</th>\n<th>检测逻辑</th>\n<th>严重级别</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>容器逃逸尝试</td>\n<td>容器内执行 <code>nsenter</code>、<code>mount</code> namespace 操作</td>\n<td>Critical</td>\n</tr>\n<tr>\n<td>反弹 Shell</td>\n<td>bash/sh 进程的 stdin 关联到 socket fd</td>\n<td>High</td>\n</tr>\n<tr>\n<td>提权操作</td>\n<td><code>setuid(0)</code> 或 capability 变更</td>\n<td>High</td>\n</tr>\n<tr>\n<td>加密矿机</td>\n<td>检测 stratum 协议特征或已知矿池域名</td>\n<td>Medium</td>\n</tr>\n<tr>\n<td>异常二进制执行</td>\n<td>从 /tmp、/dev/shm 执行或执行已删除文件</td>\n<td>Medium</td>\n</tr>\n<tr>\n<td>包管理器运行</td>\n<td>容器运行时执行 apt/yum/apk</td>\n<td>Low</td>\n</tr>\n</tbody></table>\n<h2 id=\"文件访问审计\">文件访问审计</h2><p>监控对敏感文件的访问是合规与入侵检测的基础需求。eBPF LSM 程序可以在文件打开的决策点进行拦截：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// LSM 程序：阻止对敏感路径的写入&#10;SEC(&quot;lsm/file_open&quot;)&#10;int BPF_PROG(audit_file_open, struct file *file, int ret)&#10;{&#10;    if (ret != 0) return ret;&#10;&#10;    // 获取文件路径&#10;    struct dentry *dentry = BPF_CORE_READ(file, f_path.dentry);&#10;    struct dentry *parent = BPF_CORE_READ(dentry, d_parent);&#10;&#10;    unsigned char *name = BPF_CORE_READ(dentry, d_name.name);&#10;    unsigned char *pname = BPF_CORE_READ(parent, d_name.name);&#10;&#10;    // 检查访问模式&#10;    unsigned int flags = BPF_CORE_READ(file, f_flags);&#10;    bool is_write = flags &amp; (O_WRONLY | O_RDWR | O_CREAT | O_TRUNC);&#10;&#10;    if (is_write) {&#10;        // 匹配敏感路径规则表&#10;        u32 key = 0;&#10;        struct policy *pol = bpf_map_lookup_elem(&amp;policies, &amp;key);&#10;        if (pol &amp;&amp; pol-&gt;deny_write) {&#10;            // 输出审计事件&#10;            emit_audit_event(file, &quot;BLOCKED_WRITE&quot;);&#10;            return -EPERM;  // 拒绝操作&#10;        }&#10;    }&#10;    return 0;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// LSM 程序：阻止对敏感路径的写入</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">SEC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"lsm/file_open\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BPF_PROG</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(audit_file_open, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> file </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">file</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> ret</span><span style=\"color:#24292E;--