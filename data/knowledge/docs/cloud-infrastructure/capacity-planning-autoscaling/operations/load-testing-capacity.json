n></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  p99Latency.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(res.timings.duration);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 模拟真实用户行为间隔</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>运行测试并输出到 Prometheus</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 运行测试，结果实时写入 Prometheus（结合 Grafana 可视化）&#10;k6 run --out experimental-prometheus-rw script.js&#10;&#10;# 本地运行并输出 JSON 结果&#10;k6 run --summary-export results.json script.js\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 运行测试，结果实时写入 Prometheus（结合 Grafana 可视化）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">k6</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --out</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> experimental-prometheus-rw</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> script.js</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 本地运行并输出 JSON 结果</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">k6</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --summary-export</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> results.json</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> script.js</span></span></code></pre></div><h3 id=\"locust-python-编写-适合复杂场景\">Locust：Python 编写，适合复杂场景</h3><p><strong>Locust</strong> 用 Python 编写，适合需要复杂业务逻辑（登录、会话管理、条件请求）的测试场景：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from locust import HttpUser, TaskSet, task, between, LoadTestShape&#10;&#10;class UserBehavior(TaskSet):&#10;    def on_start(self):&#10;        &quot;&quot;&quot;用户登录&quot;&quot;&quot;&#10;        resp = self.client.post(&quot;/api/login&quot;, json={&#10;            &quot;username&quot;: &quot;test_user&quot;,&#10;            &quot;password&quot;: &quot;test_pass&quot;&#10;        })&#10;        self.token = resp.json()[&quot;token&quot;]&#10;&#10;    @task(3)  # 权重 3：查询接口调用频率是下单的 3 倍&#10;    def get_products(self):&#10;        self.client.get(&quot;/api/products&quot;,&#10;            headers={&quot;Authorization&quot;: f&quot;Bearer {self.token}&quot;})&#10;&#10;    @task(1)  # 权重 1：下单&#10;    def place_order(self):&#10;        self.client.post(&quot;/api/orders&quot;,&#10;            json={&quot;product_id&quot;: 123, &quot;quantity&quot;: 1},&#10;            headers={&quot;Authorization&quot;: f&quot;Bearer {self.token}&quot;})&#10;&#10;# 自定义负载形状：模拟大促流量曲线&#10;class PromotionLoadShape(LoadTestShape):&#10;    stages = [&#10;        {&quot;duration&quot;: 120, &quot;users&quot;: 100,  &quot;spawn_rate&quot;: 10},&#10;        {&quot;duration&quot;: 300, &quot;users&quot;: 500,  &quot;spawn_rate&quot;: 50},&#10;        {&quot;duration&quot;: 600, &quot;users&quot;: 2000, &quot;spawn_rate&quot;: 100},&#10;        {&quot;duration&quot;: 900, &quot;users&quot;: 2000, &quot;spawn_rate&quot;: 0},&#10;        {&quot;duration&quot;: 1200,&quot;users&quot;: 500,  &quot;spawn_rate&quot;: -50},&#10;    ]&#10;&#10;    def tick(self):&#10;        run_time = self.get_run_time()&#10;        for stage in self.stages:&#10;            if run_time &lt; stage[&quot;duration&quot;]:&#10;                return stage[&quot;users&quot;], stage[&quot;spawn_rate&quot;]&#10;        return None  # 结束测试&#10;&#10;class WebUser(HttpUser):&#10;    tasks = [UserBehavior]&#10;    wait_time = between(0.5, 2)&#10;    host = &quot;https://api.example.com&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> locust </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> HttpUser, TaskSet, task, between, LoadTestShape</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserBehavior</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">TaskSet</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> on_start</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self):</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"\"\"用户登录\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        resp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.client.post(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"/api/login\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">