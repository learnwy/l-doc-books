\"color:#24292E;--shiki-dark:#E1E4E8\">(ctx);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">              /* 按 /24 或 /32 聚合 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bucket </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">b </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_map_lookup_elem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rl, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">key);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    __u64 now </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bpf_ktime_get_ns</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), dt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> now </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b->last_ns;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    __u64 tokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b->tokens_ns </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RATE_NS_PER_SEC </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (tokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> BURST_NS) tokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> BURST_NS;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (tokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> COST_NS) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> XDP_DROP;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* 超限即丢 */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    b->tokens_ns </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tokens </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> COST_NS; b->last_ns </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> now;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> XDP_PASS;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>这段骨架里还有两个工程决策。<strong>键的粒度</strong>：按 <code>/32</code> 最精确但最容易被伪造源打爆，按 <code>/24</code> 或 <code>/64</code> 是带宽放大攻击下的常用折中。<strong>map 满时的默认动作</strong>：<code>bpf_map_lookup_elem()</code> 返回 <code>NULL</code> 时是「新源一律放行」（fail-open，保护业务）还是「新源一律丢弃」（fail-closed，保护自己）？生产做法是二级策略：新源允许少量初始令牌并立即写入 map，同时把 <code>map_full</code> 计入统计，由用户态 agent 提升聚合粒度。</p>\n<h2 id=\"syn-flood-缓解-无状态挑战与-syn-cookies\">SYN Flood 缓解：无状态挑战与 SYN cookies</h2><p>SYN flood 区别于带宽型攻击的地方在于它<strong>不消耗带宽，消耗内核状态</strong>：每个 SYN 让内核分配一个 <code>request_sock</code> 插进半连接队列，等待第三次握手。IETF 的 RFC 4987（&quot;TCP SYN Flooding Attacks and Common Mitigations&quot;，2007）系统整理了这类攻击与缓解手段，其中 <strong>SYN cookie</strong> 是唯一不需要保存每连接状态的方案：服务端把连接参数编码进 <code>SYN-ACK</code> 的初始序列号，收到 <code>ACK</code> 时用同一哈希函数重算校验，通过才建连，因此队列本身不再是攻击面。</p>\n<p>在 XDP 里做 SYN cookie 意味着<strong>完全不进协议栈就完成第一次握手</strong>：识别裸 SYN，构造 <code>SYN-ACK</code>，交换 IP 源目地址与 TCP 源目端口，重算校验和，再 <code>XDP_TX</code> 原路发回。校验和的增量更新是这里最细的坑——改地址与端口后不能整体重算，应当用 <code>bpf_csum_diff()</code> 对新旧字段做差，再 <code>csum_replace_by_diff()</code> 只改 TCP 校验和，否则每包一次全包校验和会吃掉全部收益。</p>\n<p>需要权衡的是<strong>cookie 与内核握手的选择</strong>：现代内核默认 <code>net.ipv4.tcp_syncookies=1</code>，队列溢出时自动降级为 cookie，因此纯 SYN flood 多数场景不必自己写 XDP cookie。XDP 版本真正划算的三个场景是：速率高到内核连「判定溢出、切 cookie」都承受不起；需要在握手前做源地址信誉判定；需要在 SYN-ACK 里编入上游清洗中心的重定向信息。不是这三种时，交给内核 syncookies 更划算。</p>\n<p><code>XDP_TX</code> 本身也有条件：包必须从<strong>接收它的那张网卡</strong>发回，且需要 <code>NETDEV_XDP_ACT_TX</code> 特性位支持（可通过 <code>bpf_xdp_query()</code> 的 <code>feature_flags</code> 探测）；多网卡或非对称路由部署中它可能把回包发到错误的挂载点，此时应改用 <code>XDP_REDIRECT</code> 到目标接口的 <code>devmap</code>（参见 <a href=\"../xdp-afxdp-architecture/xdp-afxdp-redirect-topology\">XDP 与 AF_XDP 重定向拓扑</a>）。</p>\n<h2 id=\"信誉驱动的动态缓解与清洗升级\">信誉驱动的动态缓解与清洗升级</h2><p>静态阈值只能挡住「恒定超限」的流量，挡不住<strong>慢速低频</strong>攻击（每个源都低于阈值，但源的<strong>数量</strong>在增长）。这时需要把 per-IP 限速提升为<strong>按源段聚合 + 动态信誉</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>信号</th>\n<th>判定动作</th>\n<th>更新通道</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单源超过 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>10</mn><mo>×</mo></mrow><annotation encoding=\"application/x-tex\">10\\times</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">10</span><span class=\"mord\">×</span></span></span></span></span> 基线</td>\n<td>该源进入限速桶，令牌容量降为 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mfrac><mn>1</mn><mn>10</mn></mfrac></mrow><annotation encoding=\"application/x-tex\">\\frac{1}{10}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.1901em;vertical-align:-0.345em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">10</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span></td>\n<td>XDP 自更新（无需用户态）</td>\n</tr>\n<tr>\n<td>同 <code>/24</code> 聚合超阈值</td>\n<td>整个前缀进黑名单 map</td>\n<td>用户态 agent 批量写入</td>\n</tr>\n<tr>\n<td>大量「半开」源（SYN 无 ACK）</td>\n<td>提升为 SYN cookie / 全段挑战</td>\n<td>用户态统计 + 内核参数</td>\n</tr>\n<tr>\n<td>进入清洗中心阈值</td>\n<td>上游清洗 + BGP RTBH（RFC 3882）黑洞路由</td>\n<td>路由层，XDP 之外</td>\n</tr>\n<tr>\n<td>误伤投诉上升</td>\n<td>回滚 recent-deny，恢复旧策略版本</td>\n<td>用户态 agent + 版本化 map</td>\n</tr>\n</tbody></table>\n<p>分工原则是：<strong>XDP 做无状态或弱状态的快速判定，用户态做慢速的全局推理</strong>。XDP 里绝不做需要「全表视角」的判断——那要遍历 map，代价不可接受。正确形态是 XDP 把观测（每源计数、被丢包数、map 饱和度）写进 per-CPU 统计 map，用户态 agent 每 100 ms 汇总一次，算出新黑名单/阈值，再通过 <code>bpf_map_update_elem()</code> 或替换 <code>bpf_prog</code> 写回。Cilium 的 DDoS 防护与 Meta 的架构都遵循这个「数据面快判 + 控制面慢决」的模式（eBPF 社区 <a href=\"https://ebpf.io/\">https://ebpf.io/</a> ；Cilium <a href=\"https://docs.cilium.io/）。\">https://docs.cilium.io/）。</a></p>\n<p><strong>升级路径不能忽略</strong>：XDP 只能处理目标是自己机器、且带宽在单机能力内的攻击。规模超过单机上行带宽时，唯一出路是上游清洗（Cloudflare/Akamai 的 scrubbing center）或 BGP RTBH——两者都在 XDP 之外。因此设计文档必须写明「本机 XDP 处理上限」与「升级到清洗的触发阈值」。上限可直接压测得到：用 <code>XDP_DROP</code>-only 程序测出 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msubsup><mi>N</mi><mrow><mi>p</mi><mi>p</mi><mi>s</mi></mrow><mrow><mi>m</mi><mi>a</mi><mi>x</mi></mrow></msubsup></mrow><annotation encoding=\"application/x-tex\">N_{pps}^{max}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0664em;vertical-align:-0.3831em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6644em;\"><span style=\"top:-2.453em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">pp</span><span class=\"mord mathnormal mtight\">s</span></span></span></span><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">ma</span><span class=\"mord mathnormal mtight\">x</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3831em;\"><span></span></span></span></span></span></span></span></span></span></span>，留 30% 余量作阈值。</p>\n<h2 id=\"出方向整形-edt-与-xdp-的边界\">出方向整形：EDT 与 XDP 的边界</h2><p>入方向的令牌桶在出方向会撞上同样的逐包成本，而 Linux 在出方向有一条更省的路：<strong>EDT（Earliest Departure Time）</strong>——不判断「现在能不能发」，而是给每个包打上一个应当发出的时间戳，丢进按时间排序的队列，由队列决定时机。eBPF 用 <code>bpf_skb_set_tstamp()</code> 写 <code>skb-&gt;tstamp</code>，配合 <code>fq</code> qdisc 即可精确整形；Cilium 的 Bandwidth Manager 正是用它实现 Pod 级出方向带宽限制（<a href=\"https://docs.cilium.io/en/stable/network/kubernetes/bandwidth-manager/）。\">https://docs.cilium.io/en/stable/network/kubernetes/bandwidth-manager/）。</a></p>\n<p>边界值得写清：<strong>EDT 依赖 <code>skb-&gt;tstamp</code> 与发送队列语义，XDP 两者都没有</strong>。所以出方向整形落在 <code>clsact</code> egress + <code>fq</code>，XDP 专注入方向丢弃——把 XDP 硬拗成出方向整形器是常见的架构误配。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>缓解点前移是最大杠杆</strong>：被丢弃的包在 <code>alloc_skb()</code> 之前终止，省掉整条协议栈的固定成本。</li>\n<li><strong>状态选择决定可扩展性</strong>：<code>PERCPU_HASH</code> 无锁但放大 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>N</mi><mrow><mi>c</mi><mi>p</mi><mi>u</mi></mrow></msub></mrow><annotation encoding=\"application/x-tex\">N_{cpu}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">c</span><span class=\"mord mathnormal mtight\">p</span><span class=\"mord mathnormal mtight\">u</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span> 倍；<code>LRU_PERCPU_HASH</code> 用有限容量换抗内存耗尽；只有全局硬上限才值得上 <code>bpf_spin_lock</code> 或原子指令。</li>\n<li><strong>SYN flood 要算清成本</strong>：内核 syncookies 已覆盖多数场景，XDP SYN cookie 只在速率高到内核处理不起、或需握手前做信誉判定时才划算。</li>\n<li><strong>无状态快判在 XDP，慢速全局推理在用户态</strong>：XDP 写 per-CPU 统计，用户态 agent 聚合后回写黑名单与阈值。</li>\n<li><strong>必须写明升级阈值</strong>：XDP 是单机防线，超出 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msubsup><mi>N</mi><mrow><mi>p</mi><mi>p</mi><mi>s</mi></mrow><mrow><mi>m</mi><mi>a</mi><mi>x</mi></mrow></msubsup></mrow><annotation encoding=\"application/x-tex\">N_{pps}^{max}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0664em;vertical-align:-0.3831em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6644em;\"><span style=\"top:-2.453em;margin-left:-0.109em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">pp</span><span class=\"mord mathnormal mtight\">s</span></span></span></span><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">ma</span><span class=\"mord mathnormal mtight\">x</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3831em;\"><span></span></span></span></span></span></span></span></span></span></span> 的攻击只能靠上游清洗或 BGP RTBH。</li>\n<li><strong>出方向不走 XDP</strong>：EDT + <code>fq</code> 负责整形，XDP 负责入方向丢弃。</li>\n<li><strong>先读 verifier 约束再写热路径</strong>：校验和增量更新、<code>bpf_csum_diff</code> 用法、helper 可用性都受 verifier 限制，参见 <a href=\"../ebpf-packet-processing/ebpf-verifier-packet-safety\">eBPF verifier 与包内存安全</a>。</li>\n</ul>\n","headings":[{"level":1,"text":"XDP DDoS 缓解与速率限制","id":"xdp-ddos-缓解与速率限制"},{"level":2,"text":"核心概念：缓解点前移与分层代价模型","id":"核心概念-缓解点前移与分层代价模型"},{"level":2,"text":"令牌桶的 eBPF 实现与 per-CPU 无锁化","id":"令牌桶的-ebpf-实现与-per-cpu-无锁化"},{"level":2,"text":"SYN Flood 缓解：无状态挑战与 SYN cookies","id":"syn-flood-缓解-无状态挑战与-syn-cookies"},{"level":2,"text":"信誉驱动的动态缓解与清洗升级","id":"信誉驱动的动态缓解与清洗升级"},{"level":2,"text":"出方向整形：EDT 与 XDP 的边界","id":"出方向整形-edt-与-xdp-的边界"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"XDP 负载均衡与 L4 转发","url":"/l-doc-books/h/cloud-infrastructure/linux-xdp-afxdp-ebpf-fast-datapath/fast-datapath-patterns/xdp-l4-load-balancing"},"next":{"title":"容器与 Kubernetes 数据面加速","url":"/l-doc-books/h/cloud-infrastructure/linux-xdp-afxdp-ebpf-fast-datapath/fast-datapath-patterns/kubernetes-cni-datapath-acceleration"}}