 JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(response.SecretString</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cachedSecret</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handler</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> secrets</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getSecret</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'prod/database-credentials'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dbConnection</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> connect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    host: secrets.host,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    username: secrets.username,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    password: secrets.password,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p><strong>Lambda Powertools Parameters</strong> 提供内置的密钥缓存和 TTL 管理。在 Handler 外部获取并缓存密钥，温启动时直接使用缓存，减少 Secrets Manager API 调用。</p>\n<p><strong>传输加密</strong>：Lambda 与 AWS 服务之间的通信默认使用 TLS 1.2+ 加密。VPC 内的通信通过 VPC Endpoint 的 PrivateLink 加密。外部 API 调用必须验证 TLS 证书。</p>\n<p><strong>静态加密</strong>：Lambda 环境变量支持 KMS 加密。DynamoDB 表支持 AWS 托管密钥或客户管理密钥（CMK）加密。S3 对象支持 SSE-S3、SSE-KMS 和 SSE-C 三种加密方式。</p>\n<table>\n<thead>\n<tr>\n<th>密钥管理方案</th>\n<th>加密方式</th>\n<th>轮换支持</th>\n<th>缓存</th>\n<th>成本</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>环境变量（明文）</td>\n<td>KMS 加密</td>\n<td>需重新部署</td>\n<td>无</td>\n<td>免费</td>\n</tr>\n<tr>\n<td>Secrets Manager</td>\n<td>AES-256</td>\n<td>自动轮换</td>\n<td>Powertools 缓存</td>\n<td>$0.40/密钥/月</td>\n</tr>\n<tr>\n<td>SSM Parameter Store</td>\n<td>AES-256 (SecureString)</td>\n<td>手动</td>\n<td>Powertools 缓存</td>\n<td>免费（标准）</td>\n</tr>\n<tr>\n<td>HashiCorp Vault</td>\n<td>AES-256-GCM</td>\n<td>自动</td>\n<td>客户端缓存</td>\n<td>自建/SaaS</td>\n</tr>\n</tbody></table>\n<h2 id=\"供应链安全与依赖管理\">供应链安全与依赖管理</h2><p>Serverless 函数的依赖包（npm、pip）是攻击面的重要组成部分。供应链攻击（如 npm 包投毒、恶意依赖注入）是近年来增长最快的安全威胁之一。</p>\n<p><strong>依赖扫描</strong>：在 CI/CD 管道中集成 <code>npm audit</code>、Snyk、GitHub Dependabot 或 OWASP Dependency-Check。定期扫描已知漏洞（CVE），阻断含有高危漏洞的部署。</p>\n<p><strong>依赖锁定</strong>：使用 <code>package-lock.json</code>（npm）或 <code>pnpm-lock.yaml</code>（pnpm）锁定精确的依赖版本。禁止在 CI 中使用 <code>npm install</code>（可能更新版本），改用 <code>npm ci</code>（严格遵循 lock 文件）。</p>\n<p><strong>最小依赖原则</strong>：每个函数只打包必需的依赖。使用 esbuild 的 Tree Shaking 消除未使用的代码。定期审查 <code>package.json</code>，移除不再使用的依赖。</p>\n<p><strong>Lambda 代码签名</strong>：AWS 支持对 Lambda 部署包进行代码签名验证。只有经过签名的代码包才能部署，防止未授权的代码变更。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    A[开发者提交代码] --&gt; B[CI/CD Pipeline]&#10;    B --&gt; C[依赖安装 npm ci]&#10;    C --&gt; D[依赖扫描 Snyk/npm audit]&#10;    D --&gt; E{漏洞?}&#10;    E --&gt;|有高危| F[阻断部署]&#10;    E --&gt;|安全| G[代码构建 esbuild]&#10;    G --&gt; H[代码签名]&#10;    H --&gt; I[Lambda 部署]&#10;    I --&gt; J[签名验证]&#10;    J --&gt;|通过| K[部署成功]&#10;    J --&gt;|失败| L[部署拒绝]\">graph TB\n    A[开发者提交代码] --&gt; B[CI/CD Pipeline]\n    B --&gt; C[依赖安装 npm ci]\n    C --&gt; D[依赖扫描 Snyk/npm audit]\n    D --&gt; E{漏洞?}\n    E --&gt;|有高危| F[阻断部署]\n    E --&gt;|安全| G[代码构建 esbuild]\n    G --&gt; H[代码签名]\n    H --&gt; I[Lambda 部署]\n    I --&gt; J[签名验证]\n    J --&gt;|通过| K[部署成功]\n    J --&gt;|失败| L[部署拒绝]</pre><h2 id=\"小结\">小结</h2><ul>\n<li>Serverless 安全聚焦应用层：IAM 权限、输入验证、密钥管理、依赖安全</li>\n<li>IAM 最小权限：每个函数独立角色，权限精确到资源 ARN 和操作</li>\n<li>输入验证：Zod Schema 验证 + API Gateway 请求模型 + WAF 规则三层防护</li>\n<li>密钥管理：Secrets Manager + Powertools 缓存，禁止明文硬编码</li>\n<li>供应链安全：npm ci 锁定版本 + Snyk 扫描 + Lambda 代码签名</li>\n<li>传输加密默认 TLS 1.2+，静态加密使用 KMS 管理密钥</li>\n<li>权限边界和 SCP 提供组织级安全约束</li>\n</ul>\n","headings":[{"level":1,"text":"Serverless 安全实践","id":"serverless-安全实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"IAM 最小权限实践","id":"iam-最小权限实践"},{"level":2,"text":"输入验证与注入防护","id":"输入验证与注入防护"},{"level":2,"text":"密钥管理与加密","id":"密钥管理与加密"},{"level":2,"text":"供应链安全与依赖管理","id":"供应链安全与依赖管理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Serverless 监控与可观测性","url":"/l-doc-books/h/cloud-infrastructure/serverless-architecture/serverless-operations/serverless-monitoring"},"next":{"title":"Serverless 成本优化","url":"/l-doc-books/h/cloud-infrastructure/serverless-architecture/serverless-operations/cost-optimization"}}