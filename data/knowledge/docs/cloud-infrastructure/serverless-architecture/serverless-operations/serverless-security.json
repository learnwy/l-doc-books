le=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">parsed.success) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Invalid event'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, parsed.error.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatten</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(parsed.data);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p><strong>DynamoDB 注入防护</strong>：DynamoDB 的表达式语法支持条件表达式和投影表达式。如果将用户输入直接拼接到表达式中，攻击者可以修改查询逻辑。使用 ExpressionAttributeNames 和 ExpressionAttributeValues 参数化表达式。</p>\n<p><strong>API Gateway 请求验证</strong>：在 API Gateway 层配置请求模型验证（JSON Schema），在请求到达 Lambda 之前拒绝不合规的输入。这减少了无效请求消耗的 Lambda 计算资源。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[客户端请求] --&gt; B[API Gateway]&#10;    B --&gt; C{模型验证}&#10;    C --&gt;|通过| D[WAF规则检查]&#10;    D --&gt; E{WAF通过?}&#10;    E --&gt;|是| F[Lambda函数]&#10;    E --&gt;|否| G[返回403]&#10;    C --&gt;|失败| H[返回400]&#10;    F --&gt; I[Zod Schema验证]&#10;    I --&gt; J[业务逻辑]\">graph LR\n    A[客户端请求] --&gt; B[API Gateway]\n    B --&gt; C{模型验证}\n    C --&gt;|通过| D[WAF规则检查]\n    D --&gt; E{WAF通过?}\n    E --&gt;|是| F[Lambda函数]\n    E --&gt;|否| G[返回403]\n    C --&gt;|失败| H[返回400]\n    F --&gt; I[Zod Schema验证]\n    I --&gt; J[业务逻辑]</pre><h2 id=\"密钥管理与加密\">密钥管理与加密</h2><p>Serverless 函数需要访问数据库密码、API Key、证书等敏感信息。将密钥硬编码在代码或环境变量中是高风险做法。</p>\n<p><strong>AWS Secrets Manager</strong> 是推荐的密钥管理方案。它提供加密存储、自动轮换、审计日志和跨账户共享。Lambda 通过 AWS SDK 在运行时获取密钥，而非在部署时注入。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { SecretsManagerClient, GetSecretValueCommand } from &#39;@aws-sdk/client-secrets-manager&#39;;&#10;&#10;const client = new SecretsManagerClient({});&#10;let cachedSecret: Record&lt;string, string&gt; | null = null;&#10;&#10;const getSecret = async (secretId: string): Promise&lt;Record&lt;string, string&gt;&gt; =&gt; {&#10;  if (cachedSecret) return cachedSecret;&#10;&#10;  const response = await client.send(new GetSecretValueCommand({ SecretId: secretId }));&#10;&#10;  cachedSecret = JSON.parse(response.SecretString!);&#10;  return cachedSecret!;&#10;};&#10;&#10;export const handler = async () =&gt; {&#10;  const secrets = await getSecret(&#39;prod/database-credentials&#39;);&#10;  const dbConnection = await connect({&#10;    host: secrets.host,&#10;    username: secrets.username,&#10;    password: secrets.password,&#10;  });&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { SecretsManagerClient, GetSecretValueCommand } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@aws-sdk/client-secrets-manager'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> client</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SecretsManagerClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cachedSecret</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getSecret</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">secretId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"colo