ine\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(body);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ user }, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">201</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">app.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/users/:id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.req.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">param</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getUserById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(id);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">user) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ error: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'User not found'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">404</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ user });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> handler</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(app);</span></span></code></pre></div><h2 id=\"认证与授权\">认证与授权</h2><p>Serverless API 的认证授权有多种实现方式，选择取决于安全需求和架构复杂度。</p>\n<p><strong>API Gateway 内置 JWT 授权器</strong>（仅 HTTP API）：API Gateway 直接验证 JWT Token，无需调用 Lambda。配置 JWKS URI（如 Cognito 的 /.well-known/jwks.json），Gateway 自动验证 Token 签名和过期时间。延迟最低，但授权逻辑有限。</p>\n<p><strong>Lambda Authorizer</strong>：自定义授权逻辑的 Lambda 函数。支持两种模式：Token-based（从 Authorization Header 提取 Token）和 Request-based（访问完整请求上下文）。返回 IAM Policy 文档决定是否允许访问。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import type { APIGatewayTokenAuthorizerEvent, AuthResponse } from &#39;aws-lambda&#39;;&#10;import { verify } from &#39;jsonwebtoken&#39;;&#10;&#10;export const handler = async (event: APIGatewayTokenAuthorizerEvent): Promise&lt;AuthResponse&gt; =&gt; {&#10;  const token = event.authorizationToken.replace(&#39;Bearer &#39;, &#39;&#39;);&#10;&#10;  try {&#10;    const decoded = verify(token, process.env.JWT_SECRET!) as {&#10;      sub: string;&#10;      role: string;&#10;    };&#10;&#10;    return {&#10;      principalId: decoded.sub,&#10;      policyDocument: {&#10;        Version: &#39;2012-10-17&#39;,&#10;        Statement: [&#10;          {&#10;            Action: &#39;execute-api:Invoke&#39;,&#10;            Effect: &#39;Allow&#39;,&#10;            Resource: event.methodArn,&#10;          },&#10;        ],&#10;      },&#10;      context: { role: decoded.role, userId: decoded.sub },&#10;    };&#10;  } catch {&#10;    throw new Error(&#39;Unauthorized&#39;);&#10;  }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { APIGatewayTokenAuthorizerEvent, AuthResponse } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'aws-lambda'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { verify } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'jsonwebtoken'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handler</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> APIGatewayTokenAuthorizerEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">AuthResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> token</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> event.authorizationToken.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Bearer '</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> decoded</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> verify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(token, process.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JWT_SECRET</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      sub</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      role</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      principalId: decoded.sub,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      policyDocument: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Version: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2012-10-17'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Statement: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            Action: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'execute-api:Invoke'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            Effect: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Allow'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            Resource: event.methodArn,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      context: { role: decoded.role, userId: decoded.sub },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Unauthorized'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p><strong>授权缓存</strong>：Lambda Authorizer 支持结果缓存（TTL 0-3600 秒），避免每次请求都调用授权函数。缓存键基于 Token 值或请求特征。</p>\n<table>\n<thead>\n<tr>\n<th>授权方式</th>\n<th>延迟</th>\n<th>灵活性</th>\n<th>缓存支持</th>\n<th>成本</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>JWT 内置授权器</td>\n<td>~1ms</td>\n<td>低（仅 JWT 验证）</td>\n<td>无</td>\n<td>免费</td>\n</tr>\n<tr>\n<td>Token-based Authorizer</td>\n<td>~50ms</td>\n<td>高</td>\n<td>是（按 Token）</td>\n<td>Lambda 调用费</td>\n</tr>\n<tr>\n<td>Request-based Authorizer</td>\n<td>~50ms</td>\n<td>最高</td>\n<td>是（按请求特征）</td>\n<td>Lambda 调用费</td>\n</tr>\n<tr>\n<td>Cognito User Pools</td>\n<td>~20ms</td>\n<td>中</td>\n<td>是</td>\n<td>Cognito 费用</td>\n</tr>\n</tbody></table>\n<h2 id=\"api-版本管理与文档\">API 版本管理与文档</h2><p>API 版本管理是长期维护 Serverless API 的关键实践。常用策略包括 URL 路径版本化（/v1/users）、HTTP Header 版本化（Accept: application/vnd.api+json;version=1）和查询参数版本化（/users?version=1）。</p>\n<p><strong>URL 路径版本化</strong>是 Serverless API 最推荐的方案，因为 API Gateway 的路由规则天然支持路径匹配。不同版本可以路由到不同的 Lambda 函数或函数别名（Alias），实现版本间的完全隔离。</p>\n<p><strong>Lambda 别名与版本</strong>：每次发布创建一个新的 Lambda 版本（不可变的代码快照），通过别名（v1、v2、prod、staging）引用特定版本。API Gateway 的阶段变量（Stage Variable）可以指向不同别名，实现无需修改 Gateway 配置的版本切换。</p>\n<p><strong>API 文档自动生成</strong>：结合 Zod Schema 定义请求/响应模型，使用 @asteasolutions/zod-to-openapi 自动生成 OpenAPI 3.0 规范。Swagger UI 或 Redoc 渲染交互式文档，部署到 S3 + CloudFront 作为静态站点。</p>\n<p><strong>限流与使用计划</strong>：API Gateway REST API 支持使用计划（Usage Plan），为不同的 API Key 设置请求配额和限流。HTTP API 通过 Lambda Authorizer 或第三方服务（如 AWS WAF）实现限流。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Serverless API 通过 API Gateway + Lambda 构建，HTTP API 延迟更低、成本更低</li>\n<li>函数组织三种模式：微函数、单函数、领域分组，生产环境推荐领域分组</li>\n<li>Hono 框架适合 Serverless API：超轻量、多运行时支持、类型安全</li>\n<li>认证授权优先使用 JWT 内置授权器，复杂逻辑用 Lambda Authorizer + 缓存</li>\n<li>URL 路径版本化配合 Lambda 别名实现版本管理</li>\n<li>Zod + zod-to-openapi 自动生成 API 文档</li>\n<li>限流通过使用计划（REST API）或 WAF（HTTP API）实现</li>\n</ul>\n","headings":[{"level":1,"text":"Serverless API 设计","id":"serverless-api-设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"单函数 vs 多函数架构","id":"单函数-vs-多函数架构"},{"level":2,"text":"认证与授权","id":"认证与授权"},{"level":2,"text":"API 版本管理与文档","id":"api-版本管理与文档"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"事件驱动架构模式","url":"/l-doc-books/h/cloud-infrastructure/serverless-architecture/serverless-patterns/event-driven-patterns"},"next":{"title":"工作流编排与 Step Functions","url":"/l-doc-books/h/cloud-infrastructure/serverless-architecture/serverless-patterns/workflow-orchestration"}}