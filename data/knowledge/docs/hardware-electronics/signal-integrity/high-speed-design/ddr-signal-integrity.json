span><span class=\"mord\">32</span></span></span></span></span>，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>C</mi><mrow><mi>l</mi><mi>o</mi><mi>a</mi><mi>d</mi></mrow></msub><mo>=</mo><mn>3</mn></mrow><annotation encoding=\"application/x-tex\">C_{load} = 3</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">o</span><span class=\"mord mathnormal mtight\">a</span><span class=\"mord mathnormal mtight\">d</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">3</span></span></span></span></span> pF，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>V</mi><mrow><mi>s</mi><mi>w</mi><mi>i</mi><mi>n</mi><mi>g</mi></mrow></msub><mo>=</mo><mn>0.5</mn></mrow><annotation encoding=\"application/x-tex\">V_{swing} = 0.5</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.2222em;\">V</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.2222em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">s</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0269em;\">w</span><span class=\"mord mathnormal mtight\">in</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.5</span></span></span></span></span> V，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>t</mi><mi>r</mi></msub><mo>=</mo><mn>80</mn></mrow><annotation encoding=\"application/x-tex\">t_r = 80</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7651em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">t</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">80</span></span></span></span></span> ps</p>\n<div class=\"math-block\"><span class=\"katex-error\" title=\"ParseError: KaTeX parse error: Can&#x27;t use function &#x27;$&#x27; in math mode at position 122: …})^2} \\approx 6$̲ mV\" style=\"color:#cc0000\">V_{SSN} \\approx 0.8 \\times 10^{-9} \\times 32 \\times 3 \\times 10^{-12} \\times \\frac{0.5}{(80 \\times 10^{-12})^2} \\approx 6$ mV</span></div><p>虽然单次 SSN 看似不大，但多次叠加和 PDN 谐振可将其放大数倍。</p>\n<h2 id=\"ddr5-均衡技术\">DDR5 均衡技术</h2><p>DDR5 首次在内存接口中引入均衡技术，这是应对高速率通道损耗的必要手段。</p>\n<h3 id=\"发送端-ffe\">发送端 FFE</h3><p>DDR5 控制器支持 3-tap 前馈均衡（FFE）：</p>\n<ul>\n<li>Pre-cursor tap：补偿前次码间干扰</li>\n<li>Main cursor：主信号</li>\n<li>Post-cursor tap：补偿后次码间干扰</li>\n</ul>\n<h3 id=\"接收端均衡\">接收端均衡</h3><p>DRAM 接收端支持：</p>\n<ul>\n<li>CTLE（连续时间线性均衡）：增益范围 0–12 dB，步进 1 dB</li>\n<li>DFE（判决反馈均衡）：4-tap，JEDEC 标准要求</li>\n</ul>\n<p>均衡器的训练通过链路初始化时的 Training Sequence 完成，控制器与 DRAM 交互确定最优 tap 权重。</p>\n<h2 id=\"pcb-设计规则总结\">PCB 设计规则总结</h2><p>DDR5 信号完整性设计的关键检查项：</p>\n<table>\n<thead>\n<tr>\n<th>设计项</th>\n<th>要求</th>\n<th>验证方法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>阻抗控制</td>\n<td>40Ω ±10% (SE), 80Ω ±10% (diff)</td>\n<td>TDR 测量</td>\n</tr>\n<tr>\n<td>长度匹配</td>\n<td>DQS-DQ: ±5mm</td>\n<td>布线后 DRC</td>\n</tr>\n<tr>\n<td>串扰</td>\n<td>&lt; 噪声裕量 50%</td>\n<td>SI 仿真</td>\n</tr>\n<tr>\n<td>插入损耗</td>\n<td>&lt; 通道预算</td>\n<td>S 参数仿真</td>\n</tr>\n<tr>\n<td>过孔优化</td>\n<td>Back-drill 或 HDI 盲孔</td>\n<td>TDR 验证</td>\n</tr>\n<tr>\n<td>参考平面完整</td>\n<td>无缝隙、无跨分割</td>\n<td>设计规则检查</td>\n</tr>\n</tbody></table>\n<p>DDR5 的信号完整性设计是系统工程，需要从芯片选型、拓扑规划、叠层设计、布线规则到制造管控的全链路协同。每个环节的裕量消耗都会影响最终系统的可靠性。</p>\n","headings":[{"level":1,"text":"DDR 信号完整性","id":"ddr-信号完整性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"DDR5 架构与信号完整性挑战","id":"ddr5-架构与信号完整性挑战"},{"level":2,"text":"DDR5 拓扑设计","id":"ddr5-拓扑设计"},{"level":3,"text":"点对点拓扑","id":"点对点拓扑"},{"level":3,"text":"阻抗设计","id":"阻抗设计"},{"level":2,"text":"时序分析与裕量预算","id":"时序分析与裕量预算"},{"level":3,"text":"时序预算组成","id":"时序预算组成"},{"level":3,"text":"长度匹配要求","id":"长度匹配要求"},{"level":2,"text":"电源完整性与 DDR5","id":"电源完整性与-ddr5"},{"level":3,"text":"PDN 设计要求","id":"pdn-设计要求"},{"level":3,"text":"同步开关噪声","id":"同步开关噪声"},{"level":2,"text":"DDR5 均衡技术","id":"ddr5-均衡技术"},{"level":3,"text":"发送端 FFE","id":"发送端-ffe"},{"level":3,"text":"接收端均衡","id":"接收端均衡"},{"level":2,"text":"PCB 设计规则总结","id":"pcb-设计规则总结"}],"prev":{"title":"屏蔽与滤波设计","url":"/l-doc-books/h/hardware-electronics/signal-integrity/crosstalk-emi/shielding-filtering-design"},"next":{"title":"SerDes 与高速串行链路","url":"/l-doc-books/h/hardware-electronics/signal-integrity/high-speed-design/serdes-high-speed-serial"}}