e\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  session: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    warmup: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'5 分钟'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      activity: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'各自分享预习中最大的发现和困惑'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    coreWork: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      round1: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        driver: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'A'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'30 分钟'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        focus: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'实现基础的 WebSocket 连接和消息收发'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      round2: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        driver: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'B'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'30 分钟'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        focus: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'实现重连机制和心跳检测'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    cooldown: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'10 分钟'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      activity: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'回顾今天的收获，记录待解决的问题'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  followup: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    reflectionQuestions: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'今天最大的收获是什么？'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'如果重来，会怎么调整结对方式？'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    nextSessionPlan: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'下周继续实现 WebSocket 的错误处理和重连策略'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"衡量结对学习的效果\">衡量结对学习的效果</h2><p>结对学习的效果不仅体现在知识获取上，还体现在多个维度：</p>\n<table>\n<thead>\n<tr>\n<th>衡量维度</th>\n<th>衡量方法</th>\n<th>健康指标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>知识获取</td>\n<td>结对后各自能独立解释概念</td>\n<td>双方都能独立复述核心要点</td>\n</tr>\n<tr>\n<td>信心提升</td>\n<td>自评对主题的信心等级（1-5）</td>\n<td>从结对前到结对后提升 1-2 级</td>\n</tr>\n<tr>\n<td>问题发现</td>\n<td>结对中发现的知识盲区数量</td>\n<td>每次发现 2-3 个待深入的点</td>\n</tr>\n<tr>\n<td>关系质量</td>\n<td>是否期待下次结对</td>\n<td>双方都主动提议继续</td>\n</tr>\n<tr>\n<td>实践应用</td>\n<td>结对学到的知识是否在工作中使用</td>\n<td>一周内至少应用一次</td>\n</tr>\n</tbody></table>\n<h2 id=\"常见反模式与修正\">常见反模式与修正</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>描述</th>\n<th>修正</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>旁观者效应</td>\n<td>一方完全被动，只是看</td>\n<td>强制角色轮换，限定时间</td>\n</tr>\n<tr>\n<td>专家垄断</td>\n<td>技术强的一方完全主导</td>\n<td>让技术弱的一方先驱动</td>\n</tr>\n<tr>\n<td>社交闲聊化</td>\n<td>讨论偏离学习主题</td>\n<td>设定明确的学习目标和时间框</td>\n</tr>\n<tr>\n<td>疲劳硬撑</td>\n<td>结对时间过长导致效率下降</td>\n<td>单次结对不超过 2 小时，中间有休息</td>\n</tr>\n<tr>\n<td>回避冲突</td>\n<td>不好意思指出搭档的错误</td>\n<td>建立&quot;对代码不对人&quot;的文化</td>\n</tr>\n</tbody></table>\n<h2 id=\"成熟度模型\">成熟度模型</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    L1[L1 偶尔结对&lt;br&gt;遇到问题才找人] --&gt; L2[L2 定期结对&lt;br&gt;固定搭档和时间]&#10;    L2 --&gt; L3[L3 策略结对&lt;br&gt;根据学习目标选搭档]&#10;    L3 --&gt; L4[L4 文化融入&lt;br&gt;结对成为团队默认学习方式]&#10;    L4 --&gt; L5[L5 网络扩展&lt;br&gt;跨团队、跨公司结对]\">flowchart LR\n    L1[L1 偶尔结对&lt;br&gt;遇到问题才找人] --&gt; L2[L2 定期结对&lt;br&gt;固定搭档和时间]\n    L2 --&gt; L3[L3 策略结对&lt;br&gt;根据学习目标选搭档]\n    L3 --&gt; L4[L4 文化融入&lt;br&gt;结对成为团队默认学习方式]\n    L4 --&gt; L5[L5 网络扩展&lt;br&gt;跨团队、跨公司结对]</pre><h2 id=\"本节小结\">本节小结</h2><p>结对学习是效率最高的深度学习方式之一，它通过实时的认知互补和持续的出声思考，让两个人的学习效果远超各自独立学习的总和。</p>\n<ul>\n<li>结对学习的核心价值是&quot;实时认知互补&quot;——搭档的视角填补你的盲区</li>\n<li>驾驶员-导航员模型定期轮换，确保双方都有深度参与</li>\n<li>跨技能结对是知识传递最自然的方式——双方同时是老师和学生</li>\n<li>远程结对需要工具支持和注意力管理策略</li>\n</ul>\n<p><strong>关键行动：</strong></p>\n<ol>\n<li>本周找一位同事进行一次 90 分钟的结对编程学习，选择一个你们都想深入的主题</li>\n<li>尝试跨技能结对——找一位不同领域的同事，一起完成一个需要两种技能的任务</li>\n<li>在团队中推广每周至少一次的结对学习时间，写入团队工作协议</li>\n<li>记录 3 次结对学习的收获，对比独自学习的效果差异</li>\n</ol>\n","headings":[{"level":1,"text":"结对学习实践","id":"结对学习实践"},{"level":2,"text":"结对学习的核心概念","id":"结对学习的核心概念"},{"level":2,"text":"结对学习 vs 其他学习方式","id":"结对学习-vs-其他学习方式"},{"level":2,"text":"结对编程作为学习工具","id":"结对编程作为学习工具"},{"level":3,"text":"驾驶员-导航员模型","id":"驾驶员-导航员模型"},{"level":3,"text":"结对编程中的知识传递","id":"结对编程中的知识传递"},{"level":2,"text":"跨技能结对策略","id":"跨技能结对策略"},{"level":2,"text":"远程结对的实践","id":"远程结对的实践"},{"level":2,"text":"结对学习的场景扩展","id":"结对学习的场景扩展"},{"level":2,"text":"结对学习会议的结构化模板","id":"结对学习会议的结构化模板"},{"level":2,"text":"衡量结对学习的效果","id":"衡量结对学习的效果"},{"level":2,"text":"常见反模式与修正","id":"常见反模式与修正"},{"level":2,"text":"成熟度模型","id":"成熟度模型"},{"level":2,"text":"本节小结","id":"本节小结"}],"prev":{"title":"学习小组设计","url":"/l-doc-books/h/management/mentoring-teaching-growth/peer-learning-networks/study-group-design"},"next":{"title":"代码阅读圈","url":"/l-doc-books/h/management/mentoring-teaching-growth/peer-learning-networks/code-reading-circles"}}