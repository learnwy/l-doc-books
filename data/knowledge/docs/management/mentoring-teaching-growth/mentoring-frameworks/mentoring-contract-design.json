dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    exceptions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  review</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    cadence</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    method</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  exitClause</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    normalEnd</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    earlyTermination</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sampleContract</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MentoringContract</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  parties: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mentor: { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'张工'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, role: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'高级架构师'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mentee: { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'李工'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, role: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'中级开发工程师'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  startDate: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2026-04-01'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  endDate: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2026-09-30'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  goals: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    primary: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'具备独立完成中等复杂度系统设计的能力'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    secondary: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'掌握微服务架构设计方法'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'能主导技术方案评审'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'建立技术决策的判断框架'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    measurableOutcomes: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'独立完成 2 个系统设计文档并通过评审'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'主导 1 次技术分享'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'在技术选型中能清晰阐述权衡'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  logistics: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meetingFrequency: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'每两周一次'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meetingDuration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'45 分钟'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meetingFormat: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'灵活'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    primaryChannel: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'飞书'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    responseExpectation: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'工作日 24 小时内回复'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  boundaries: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    inScope: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'技术架构讨论与反馈'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'系统设计方案审查'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'职业发展方向探讨'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'技术选型决策指导'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    outOfScope: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'帮学员写代码或文档'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'替学员做技术决策'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'介入学员与上级的关系问题'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'提供心理咨询'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  confidentiality: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    level: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'完全保密'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    exceptions: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'涉及安全或合规风险的内容除外'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  review: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    cadence: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'每 6 周进行一次正式回顾'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'双方各自准备进展评估，对照目标讨论'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  exitClause: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    normalEnd: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'6 个月期满，双方评估后决定是否续约'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    earlyTermination: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'任一方提前两周通知，无需解释原因'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"目标设定的-smart-原则\">目标设定的 SMART 原则</h2><p>导师协议中的目标设定直接决定了关系的成效。模糊的目标导致模糊的结果。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    S[Specific&lt;br&gt;具体] --&gt; M[Measurable&lt;br&gt;可衡量]&#10;    M --&gt; A[Achievable&lt;br&gt;可达成]&#10;    A --&gt; R[Relevant&lt;br&gt;相关性]&#10;    R --&gt; T[Time-bound&lt;br&gt;有时限]\">flowchart LR\n    S[Specific&lt;br&gt;具体] --&gt; M[Measurable&lt;br&gt;可衡量]\n    M --&gt; A[Achievable&lt;br&gt;可达成]\n    A --&gt; R[Relevant&lt;br&gt;相关性]\n    R --&gt; T[Time-bound&lt;br&gt;有时限]</pre><table>\n<thead>\n<tr>\n<th>目标质量</th>\n<th>差的目标</th>\n<th>好的目标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>模糊 vs 具体</td>\n<td>&quot;提升技术能力&quot;</td>\n<td>&quot;掌握分布式系统的 CAP 权衡和一致性方案&quot;</td>\n</tr>\n<tr>\n<td>不可衡量 vs 可衡量</td>\n<td>&quot;成为更好的工程师&quot;</td>\n<td>&quot;独立完成 3 个系统设计并通过架构评审&quot;</td>\n</tr>\n<tr>\n<td>不切实际 vs 可达成</td>\n<td>&quot;6 个月成为架构师&quot;</td>\n<td>&quot;6 个月内具备主导中等项目技术方案的能力&quot;</td>\n</tr>\n<tr>\n<td>不相关 vs 相关</td>\n<td>&quot;学会机器学习&quot;（后端工程师）</td>\n<td>&quot;掌握后端性能优化的系统方法&quot;</td>\n</tr>\n<tr>\n<td>无期限 vs 有时限</td>\n<td>&quot;未来某天能...&quot;</td>\n<td>&quot;3 个月内完成第一次技术方案主导&quot;</td>\n</tr>\n</tbody></table>\n<h2 id=\"评估与回顾机制\">评估与回顾机制</h2><p>定期评估是导师协议中最容易被忽略但最关键的部分。没有评估，关系很容易在&quot;感觉还行&quot;中逐渐失去价值。</p>\n<h3 id=\"回顾会议的结构\">回顾会议的结构</h3><p>每次回顾会议建议覆盖以下四个问题：</p>\n<ol>\n<li><strong>进展</strong>：上个周期设定的目标完成了哪些？</li>\n<li><strong>收获</strong>：最大的收获和突破是什么？</li>\n<li><strong>障碍</strong>：遇到了哪些障碍？需要调整什么？</li>\n<li><strong>下一步</strong>：下个周期的重点目标是什么？</li>\n</ol>\n<h3 id=\"双向反馈\">双向反馈</h3><p>回顾不仅是导师评估学员，学员也应该给导师反馈：</p>\n<ul>\n<li>&quot;最有帮助的是哪次讨论？为什么？&quot;</li>\n<li>&quot;有没有我需要的支持但还没有得到的？&quot;</li>\n<li>&quot;会面的频率和方式是否需要调整？&quot;</li>\n</ul>\n<h2 id=\"边界管理\">边界管理</h2><p>导师关系中最棘手的问题之一是边界管理。导师不是上级、不是心理咨询师、不是朋友（虽然可能会发展为朋友）。</p>\n<table>\n<thead>\n<tr>\n<th>越界信号</th>\n<th>描述</th>\n<th>应对方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>学员过度依赖</td>\n<td>任何决策都要先问导师</td>\n<td>引导学员先形成自己的判断，再来讨论</td>\n</tr>\n<tr>\n<td>导师过度介入</td>\n<td>开始替学员做决策或解决问题</td>\n<td>回归教练模式，用提问引导而非直接行动</td>\n</tr>\n<tr>\n<td>角色混淆</td>\n<td>导师变成了事实上的&quot;隐形上级&quot;</td>\n<td>明确导师只提供建议，决策权在学员自己</td>\n</tr>\n<tr>\n<td>情感越界</td>\n<td>关系从专业变为过度私人化</td>\n<td>回顾协议中的边界约定，必要时坦诚讨论</td>\n</tr>\n</tbody></table>\n<h2 id=\"优雅退出\">优雅退出</h2><p>导师关系的结束和开始同样重要。好的退出让双方都感到关系是有价值的，并为未来的联系留下空间。</p>\n<p><strong>正常结束</strong>：协议到期，双方进行最终回顾，总结收获，讨论是否续约或转为非正式关系。</p>\n<p><strong>提前结束</strong>：如果关系不再产出价值（目标不匹配、时间冲突、化学反应不对），任一方都可以提出。关键是坦诚而尊重——不要让关系在无声无息中消亡。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[协议到期] --&gt; B[最终回顾]&#10;    B --&gt; C{双方评估}&#10;    C --&gt;|续约| D[更新目标和协议]&#10;    C --&gt;|转型| E[转为非正式关系&lt;br&gt;季度联系]&#10;    C --&gt;|结束| F[感恩总结]&#10;    F --&gt; G[保持联系方式]&#10;    G --&gt; H[未来可能再次合作]\">flowchart TD\n    A[协议到期] --&gt; B[最终回顾]\n    B --&gt; C{双方评估}\n    C --&gt;|续约| D[更新目标和协议]\n    C --&gt;|转型| E[转为非正式关系&lt;br&gt;季度联系]\n    C --&gt;|结束| F[感恩总结]\n    F --&gt; G[保持联系方式]\n    G --&gt; H[未来可能再次合作]</pre><p>退出对话的关键要素：总结关系中的收获和亮点；感谢对方的投入；保持联系方式的开放性；如果有建设性反馈，温和但诚实地分享。</p>\n<h2 id=\"协议的迭代与演进\">协议的迭代与演进</h2><p>导师协议不是一成不变的。随着关系的发展和学员的成长，协议需要不断调整：</p>\n<h3 id=\"典型的协议演进路径\">典型的协议演进路径</h3><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>协议重点</th>\n<th>目标类型</th>\n<th>频率调整</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>初期（1-2 月）</td>\n<td>建立信任和节奏</td>\n<td>短期、具体的学习目标</td>\n<td>每周一次</td>\n</tr>\n<tr>\n<td>中期（3-4 月）</td>\n<td>深入指导</td>\n<td>中期项目目标</td>\n<td>每两周一次</td>\n</tr>\n<tr>\n<td>后期（5-6 月）</td>\n<td>逐步独立</td>\n<td>长期职业方向</td>\n<td>每月一次</td>\n</tr>\n<tr>\n<td>转型期</td>\n<td>平等关系</td>\n<td>互相咨询</td>\n<td>按需</td>\n</tr>\n</tbody></table>\n<p>协议的演进应该在每次回顾中讨论，而不是等到问题出现后才被动调整。</p>\n<h3 id=\"多轮协议的设计\">多轮协议的设计</h3><p>如果双方决定在第一轮协议到期后续约，第二轮的协议应该有明显的升级：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const contractEvolution = {&#10;  round1: {&#10;    focus: &#39;技术能力提升&#39;,&#10;    mentorRole: &#39;指导者和知识提供者&#39;,&#10;    meetingFormat: &#39;导师主导的讨论&#39;,&#10;  },&#10;  round2: {&#10;    focus: &#39;独立决策能力&#39;,&#10;    mentorRole: &#39;挑战者和思考伙伴&#39;,&#10;    meetingFormat: &#39;学员主导的方案讨论&#39;,&#10;  },&#10;  round3: {&#10;    focus: &#39;领导力发展&#39;,&#10;    mentorRole: &#39;同行顾问&#39;,&#10;    meetingFormat: &#39;平等的策略对话&#39;,&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> contractEvolution</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  round1: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    focus: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'技术能力提升'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mentorRole: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'指导者和知识提供者'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meetingFormat: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'导师主导的讨论'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  round2: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    focus: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'独立决策能力'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mentorRole: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'挑战者和思考伙伴'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meetingFormat: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'学员主导的方案讨论'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  round3: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    focus: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'领导力发展'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mentorRole: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'同行顾问'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    meetingFormat: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'平等的策略对话'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"常见设计错误\">常见设计错误</h2><table>\n<thead>\n<tr>\n<th>错误</th>\n<th>后果</th>\n<th>改进</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>目标过多</td>\n<td>精力分散，什么都没深入</td>\n<td>聚焦 1 个主目标 + 2 个辅助目标</td>\n</tr>\n<tr>\n<td>没有退出机制</td>\n<td>关系僵化，不满无法表达</td>\n<td>明确写入提前终止条款</td>\n</tr>\n<tr>\n<td>频率过高</td>\n<td>导师时间压力大，学员依赖加深</td>\n<td>双周一次是多数场景的合理起点</td>\n</tr>\n<tr>\n<td>缺乏评估</td>\n<td>关系惯性持续但不产出价值</td>\n<td>每 6-8 周做一次正式回顾</td>\n</tr>\n</tbody></table>\n<h2 id=\"本节小结\">本节小结</h2><p>导师协议是让导师关系从&quot;随机&quot;走向&quot;系统&quot;的关键工具。它不是官僚流程，而是对双方的尊重和保护。好的协议能让关系更专注、更持久、更有成效。</p>\n<ul>\n<li>导师协议的七大核心要素：目标、时间、沟通、边界、保密、评估、退出</li>\n<li>目标设定遵循 SMART 原则，避免模糊和不切实际</li>\n<li>定期回顾和双向反馈是关系持续健康的保障</li>\n<li>优雅的退出机制让关系善始善终，为未来合作留下可能</li>\n</ul>\n<p><strong>关键行动：</strong></p>\n<ol>\n<li>如果你有在进行的导师关系，用本文的协议模板做一次&quot;补签协议&quot;</li>\n<li>下次建立新的导师关系时，在首次会面中就讨论并记录协议要素</li>\n<li>为当前的导师关系安排一次正式回顾，对照目标评估进展</li>\n<li>准备一份&quot;退出话术&quot;，以便在需要结束关系时能够坦诚而优雅</li>\n</ol>\n","headings":[{"level":1,"text":"导师协议设计","id":"导师协议设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要导师协议","id":"为什么需要导师协议"},{"level":2,"text":"导师协议的核心要素","id":"导师协议的核心要素"},{"level":2,"text":"导师协议模板","id":"导师协议模板"},{"level":2,"text":"目标设定的 SMART 原则","id":"目标设定的-smart-原则"},{"level":2,"text":"评估与回顾机制","id":"评估与回顾机制"},{"level":3,"text":"回顾会议的结构","id":"回顾会议的结构"},{"level":3,"text":"双向反馈","id":"双向反馈"},{"level":2,"text":"边界管理","id":"边界管理"},{"level":2,"text":"优雅退出","id":"优雅退出"},{"level":2,"text":"协议的迭代与演进","id":"协议的迭代与演进"},{"level":3,"text":"典型的协议演进路径","id":"典型的协议演进路径"},{"level":3,"text":"多轮协议的设计","id":"多轮协议的设计"},{"level":2,"text":"常见设计错误","id":"常见设计错误"},{"level":2,"text":"本节小结","id":"本节小结"}],"prev":{"title":"教练 vs 导师","url":"/l-doc-books/h/management/mentoring-teaching-growth/mentoring-frameworks/coaching-vs-mentoring"},"next":{"title":"学习小组设计","url":"/l-doc-books/h/management/mentoring-teaching-growth/peer-learning-networks/study-group-design"}}