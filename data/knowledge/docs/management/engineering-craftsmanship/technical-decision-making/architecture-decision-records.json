 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> f </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'INDEX.md'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nextNum</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(existing.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">padStart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> slug</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> title</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'-'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">a-z0-9-]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> filename</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">nextNum</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">slug</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}.md`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> template</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `# ADR-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">nextNum</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">title</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">## 状态</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">提议</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">## 日期</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toISOString</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">split</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'T'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">## 背景</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">## 决策</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">## 后果</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">### 正面</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">-</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">### 负面</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">-</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">### 风险</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">-</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> filepath</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(adrDir, filename);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> writeFile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(filepath, template);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> filepath;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>ADR 是工程组织知识管理的基石。它不是官僚流程，而是对团队智慧的尊重——每一个经过深思熟虑的决策都值得被记录，每一个未来的同事都值得了解&quot;为什么是这样&quot;。当 ADR 成为团队习惯时，知识不再因人员流动而丢失，决策质量也会随着经验积累而持续提升。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>ADR 的核心价值是保存决策的理由，避免同样的争论反复发生。</li>\n<li>轻量是它的生命力：10–15 分钟可写完，超时说明应先做 RFC。</li>\n<li>状态、背景、决策、后果（含负面与风险）是最小可用结构。</li>\n<li>只在真正重要的决策上写 ADR，否则文档会退化为噪音。</li>\n<li>ADR 是活文档，状态随决策演化而更新。</li>\n<li>避免把 ADR 写成事后合理化总结；记录被放弃的选项与后果才有决策价值。</li>\n</ul>\n","headings":[{"level":1,"text":"架构决策记录","id":"架构决策记录"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"ADR 的价值","id":"adr-的价值"},{"level":2,"text":"ADR 格式标准","id":"adr-格式标准"},{"level":3,"text":"经典模板","id":"经典模板"},{"level":3,"text":"实际 ADR 示例","id":"实际-adr-示例"},{"level":2,"text":"什么时候写 ADR","id":"什么时候写-adr"},{"level":3,"text":"触发条件","id":"触发条件"},{"level":3,"text":"典型的 ADR 候选决策","id":"典型的-adr-候选决策"},{"level":3,"text":"不需要 ADR 的决策","id":"不需要-adr-的决策"},{"level":2,"text":"ADR 作为活文档","id":"adr-作为活文档"},{"level":3,"text":"ADR 的生命周期","id":"adr-的生命周期"},{"level":3,"text":"ADR 的组织方式","id":"adr-的组织方式"},{"level":2,"text":"决策日志的维护","id":"决策日志的维护"},{"level":3,"text":"定期审查","id":"定期审查"},{"level":3,"text":"检查清单","id":"检查清单"},{"level":2,"text":"ADR 的反模式","id":"adr-的反模式"},{"level":2,"text":"快速 ADR 工具","id":"快速-adr-工具"},{"level":3,"text":"命令行创建","id":"命令行创建"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"权衡分析","url":"/l-doc-books/h/management/engineering-craftsmanship/technical-decision-making/trade-off-analysis"},"next":{"title":"可逆与不可逆决策","url":"/l-doc-books/h/management/engineering-craftsmanship/technical-decision-making/reversible-vs-irreversible"}}