: order.items.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">logger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">debug</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`密码是 ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">password</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">logger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">debug</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'用户认证'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { userId, method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'password'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><hr>\n<h2 id=\"日志搜索与分析\">日志搜索与分析</h2><h3 id=\"grep-jq-命令行技巧\">grep/jq 命令行技巧</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"cat app.log | jq &#39;select(.level == &quot;error&quot;)&#39;&#10;&#10;cat app.log | jq &#39;select(.orderId == &quot;12345&quot;)&#39;&#10;&#10;cat app.log | jq &#39;select(.level == &quot;error&quot;) | {time: .timestamp, msg: .message, err: .error.message}&#39;&#10;&#10;cat app.log | jq -s &#39;group_by(.level) | map({level: .[0].level, count: length})&#39;&#10;&#10;cat app.log | jq &#39;select(.timestamp &gt;= &quot;2024-03-15T10:00:00&quot; and .timestamp &lt;= &quot;2024-03-15T11:00:00&quot;)&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> jq</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'select(.level == \"error\")'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> jq</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'select(.orderId == \"12345\")'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> jq</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'select(.level == \"error\") | {time: .timestamp, msg: .message, err: .error.message}'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> jq</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'group_by(.level) | map({level: .[0].level, count: length})'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> jq</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'select(.timestamp >= \"2024-03-15T10:00:00\" and .timestamp &#x3C;= \"2024-03-15T11:00:00\")'</span></span></code></pre></div><h3 id=\"常用搜索模式\">常用搜索模式</h3><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>命令/查询</th>\n<th>目的</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>找特定请求</td>\n<td><code>jq &#39;select(.requestId == &quot;xxx&quot;)&#39;</code></td>\n<td>追踪单个请求全链路</td>\n</tr>\n<tr>\n<td>错误统计</td>\n<td><code>jq -s &#39;map(select(.level==&quot;error&quot;)) | group_by(.error.name)&#39;</code></td>\n<td>发现最频繁的错误类型</td>\n</tr>\n<tr>\n<td>延迟分析</td>\n<td><code>jq &#39;select(.duration &gt; 1000)&#39;</code></td>\n<td>找出慢请求</td>\n</tr>\n<tr>\n<td>时间段过滤</td>\n<td><code>jq &#39;select(.timestamp | . &gt;= &quot;T1&quot; and . &lt;= &quot;T2&quot;)&#39;</code></td>\n<td>故障时间窗口内的日志</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"分布式追踪\">分布式追踪</h2><p>在微服务架构中，一个用户请求可能经过多个服务。分布式追踪通过 Trace ID 将跨服务的日志串联起来。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[用户请求] --&gt; B[API Gateway]&#10;    B --&gt;|traceId: abc123| C[Order Service]&#10;    C --&gt;|traceId: abc123| D[Payment Service]&#10;    C --&gt;|traceId: abc123| E[Inventory Service]&#10;    D --&gt;|traceId: abc123| F[Stripe API]\">graph LR\n    A[用户请求] --&gt; B[API Gateway]\n    B --&gt;|traceId: abc123| C[Order Service]\n    C --&gt;|traceId: abc123| D[Payment Service]\n    C --&gt;|traceId: abc123| E[Inventory Service]\n    D --&gt;|traceId: abc123| F[Stripe API]</pre><h3 id=\"opentelemetry-集成\">OpenTelemetry 集成</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { trace, context, SpanStatusCode } from &#39;@opentelemetry/api&#39;;&#10;&#10;const tracer = trace.getTracer(&#39;order-service&#39;);&#10;&#10;async function processOrder(order: Order): Promise&lt;OrderResult&gt; {&#10;  return tracer.startActiveSpan(&#39;processOrder&#39;, async (span) =&gt; {&#10;    try {&#10;      span.setAttribute(&#39;order.id&#39;, order.id);&#10;      span.setAttribute(&#39;order.itemCount&#39;, order.items.length);&#10;&#10;      const validated = await tracer.startActiveSpan(&#39;validateOrder&#39;, async (childSpan) =&gt; {&#10;        const result = await validateOrder(order);&#10;        childSpan.end();&#10;        return result;&#10;      });&#10;&#10;      const result = await chargeAndFulfill(validated);&#10;      span.setStatus({ code: SpanStatusCode.OK });&#10;      return result;&#10;    } catch (error) {&#10;      span.setStatus({&#10;        code: SpanStatusCode.ERROR,&#10;        message: error instanceof Error ? error.message : &#39;Unknown error&#39;,&#10;      });&#10;      span.recordException(error as Error);&#10;      throw error;&#10;    } finally {&#10;      span.end();&#10;    }&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { trace, context, SpanStatusCode } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@opentelemetry/api'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> tracer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trace.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getTracer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'order-service'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color: