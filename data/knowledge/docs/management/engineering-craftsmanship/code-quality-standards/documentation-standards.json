></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baseRates[tier];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (rate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> undefined</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InvalidTierError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(tier);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bonusRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orderTotal </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100000</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.05</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bonusRate, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"tsdoc-标签速查\">TSDoc 标签速查</h3><table>\n<thead>\n<tr>\n<th>标签</th>\n<th>用途</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>@param</code></td>\n<td>参数说明</td>\n<td><code>@param name - 用户名</code></td>\n</tr>\n<tr>\n<td><code>@returns</code></td>\n<td>返回值说明</td>\n<td><code>@returns 处理后的订单对象</code></td>\n</tr>\n<tr>\n<td><code>@throws</code></td>\n<td>可能抛出的异常</td>\n<td><code>@throws {NotFoundError}</code></td>\n</tr>\n<tr>\n<td><code>@example</code></td>\n<td>使用示例</td>\n<td>包含代码块</td>\n</tr>\n<tr>\n<td><code>@remarks</code></td>\n<td>补充说明</td>\n<td>设计决策、注意事项</td>\n</tr>\n<tr>\n<td><code>@deprecated</code></td>\n<td>废弃标记</td>\n<td><code>@deprecated 使用 v2 API 替代</code></td>\n</tr>\n<tr>\n<td><code>@see</code></td>\n<td>相关引用</td>\n<td><code>@see {@link OtherClass}</code></td>\n</tr>\n<tr>\n<td><code>@internal</code></td>\n<td>内部 API 标记</td>\n<td>不出现在公开文档中</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"readme-写作标准\">README 写作标准</h2><p>README 是项目的门面，决定了一个开源库或内部服务在前 30 秒内能否吸引住读者。</p>\n<h3 id=\"readme-结构模板\">README 结构模板</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[项目名称 + 一句话描述] --&gt; B[徽章行]&#10;    B --&gt; C[核心特性列表]&#10;    C --&gt; D[快速开始]&#10;    D --&gt; E[安装方式]&#10;    E --&gt; F[基本使用示例]&#10;    F --&gt; G[API 概览]&#10;    G --&gt; H[配置选项]&#10;    H --&gt; I[常见问题]&#10;    I --&gt; J[贡献指南]&#10;    J --&gt; K[许可证]\">flowchart TD\n    A[项目名称 + 一句话描述] --&gt; B[徽章行]\n    B --&gt; C[核心特性列表]\n    C --&gt; D[快速开始]\n    D --&gt; E[安装方式]\n    E --&gt; F[基本使用示例]\n    F --&gt; G[API 概览]\n    G --&gt; H[配置选项]\n    H --&gt; I[常见问题]\n    I --&gt; J[贡献指南]\n    J --&gt; K[许可证]</pre><p>一个实际的 README 结构：</p>\n<div class=\"code-block-wrapper\" data-lang=\"markdown\" data-code=\"# 项目名称&#10;&#10;&gt; 一句话描述项目解决的核心问题&#10;&#10;## 核心特性&#10;&#10;- ⚡ 特性一描述&#10;- 🔒 特性二描述&#10;- 📦 特性三描述&#10;&#10;## 快速开始&#10;&#10;### 安装&#10;&#10;（安装命令）&#10;&#10;### 基本使用&#10;&#10;（最小可运行示例）&#10;&#10;## API 参考&#10;&#10;（核心 API 的简要说明和链接）&#10;&#10;## 配置&#10;&#10;（配置选项表格）&#10;&#10;## 许可证&#10;&#10;MIT\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\"># 项目名称</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">> 一句话描述项目解决的核心问题</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 核心特性</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ⚡ 特性一描述</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 🔒 特性二描述</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 📦 特性三描述</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 快速开始</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 安装</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">（安装命令）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 基本使用</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">（最小可运行示例）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## API 参考</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">（核心 API 的简要说明和链接）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 配置</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">（配置选项表格）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 许可证</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">MIT</span></span></code></pre></div><h3 id=\"readme-质量评估\">README 质量评估</h3><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>差</th>\n<th>好</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>第一印象</td>\n<td>只有项目名</td>\n<td>一句话说清楚项目价值</td>\n</tr>\n<tr>\n<td>上手速度</td>\n<td>需要读源码才能使用</td>\n<td>复制粘贴即可运行</td>\n</tr>\n<tr>\n<td>示例质量</td>\n<td>伪代码或不完整代码</td>\n<td>可直接运行的完整示例</td>\n</tr>\n<tr>\n<td>配置说明</td>\n<td>散落在代码注释中</td>\n<td>结构化表格，有默认值</td>\n</tr>\n<tr>\n<td>维护状态</td>\n<td>最后更新一年前</td>\n<td>徽章显示构建状态和版本</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"架构决策记录-adr\">架构决策记录 (ADR)</h2><p>ADR 是记录重要技术决策的轻量级文档。它回答的核心问题是：&quot;一年后，当有人问&#39;为什么用 PostgreSQL 而不是 MongoDB&#39;时，我们能给出清晰的答案吗？&quot;</p>\n<h3 id=\"adr-模板\">ADR 模板</h3><div class=\"code-block-wrapper\" data-lang=\"markdown\" data-code=\"# ADR-042: 采用事件溯源模式处理订单状态&#10;&#10;## 状态&#10;&#10;已接受 (2024-03-15)&#10;&#10;## 背景&#10;&#10;当前订单状态通过直接更新数据库字段来变更。随着业务复杂度增长，出现了以下问题：&#10;&#10;1. 无法追溯订单状态变更的完整历史&#10;2. 多个服务同时修改订单状态导致竞态条件&#10;3. 审计合规要求完整的操作记录&#10;&#10;## 决策&#10;&#10;采用事件溯源 (Event Sourcing) 模式管理订单状态。&#10;&#10;## 后果&#10;&#10;### 正面影响&#10;&#10;- 完整的状态变更审计轨迹&#10;- 消除竞态条件（事件按序追加）&#10;- 支持时间旅行调试&#10;&#10;### 负面影响&#10;&#10;- 查询复杂度增加，需要维护物化视图&#10;- 团队需要学习事件溯源模式&#10;- 存储成本增加约 30%\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\"># ADR-042: 采用事件溯源模式处理订单状态</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 状态</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">已接受 (2024-03-15)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 背景</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">当前订单状态通过直接更新数据库字段来变更。随着业务复杂度增长，出现了以下问题：</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">1.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 无法追溯订单状态变更的完整历史</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">2.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 多个服务同时修改订单状态导致竞态条件</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">3.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 审计合规要求完整的操作记录</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 决策</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">采用事件溯源 (Event Sourcing) 模式管理订单状态。</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## 后果</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 正面影响</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 完整的状态变更审计轨迹</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 消除竞态条件（事件按序追加）</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 支持时间旅行调试</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 负面影响</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 查询复杂度增加，需要维护物化视图</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 团队需要学习事件溯源模式</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 存储成本增加约 30%</span></span></code></pre></div><h3 id=\"何时编写-adr\">何时编写 ADR</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[技术决策] --&gt; B{影响范围?}&#10;    B --&gt;|单个函数/组件| C[不需要 ADR]&#10;    B --&gt;|多个模块| D{可逆性?}&#10;    B --&gt;|整个系统| E[需要 ADR]&#10;    D --&gt;|容易回退| F[可选 ADR]&#10;    D --&gt;|难以回退| E\">flowchart TD\n    A[技术决策] --&gt; B{影响范围?}\n    B --&gt;|单个函数/组件| C[不需要 ADR]\n    B --&gt;|多个模块| D{可逆性?}\n    B --&gt;|整个系统| E[需要 ADR]\n    D --&gt;|容易回退| F[可选 ADR]\n    D --&gt;|难以回退| E</pre><hr>\n<h2 id=\"变更日志-changelog\">变更日志 (CHANGELOG)</h2><p>变更日志面向用户和维护者，记录每个版本的变化：</p>\n<div class=\"code-block-wrapper\" data-lang=\"markdown\" data-code=\"## [2.3.0] - 2024-03-15&#10;&#10;### 新增&#10;&#10;- 支持批量导出订单为 CSV 格式&#10;- 新增订单状态变更的 Webhook 通知&#10;&#10;### 变更&#10;&#10;- 订单列表默认排序改为按创建时间降序&#10;- 提升分页查询性能，P99 延迟从 200ms 降至 50ms&#10;&#10;### 修复&#10;&#10;- 修复在 Safari 中日期选择器无法选择跨月日期的问题&#10;- 修复并发创建订单时可能出现的重复编号&#10;&#10;### 废弃&#10;&#10;- `GET /api/v1/orders` 将在 v3.0 中移除，请使用 v2 API\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">## [</span><span style=\"color:#032F62;--shiki-light-text-decoration:underline;--shiki-dark:#DBEDFF;--shiki-dark-text-decoration:underline\">2.3.0</span><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">] - 2024-03-15</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 新增</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 支持批量导出订单为 CSV 格式</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 新增订单状态变更的 Webhook 通知</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 变更</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 订单列表默认排序改为按创建时间降序</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 提升分页查询性能，P99 延迟从 200ms 降至 50ms</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 修复</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 修复在 Safari 中日期选择器无法选择跨月日期的问题</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 修复并发创建订单时可能出现的重复编号</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-light-font-weight:bold;--shiki-dark:#79B8FF;--shiki-dark-font-weight:bold\">### 废弃</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> `GET /api/v1/orders`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 将在 v3.0 中移除，请使用 v2 API</span></span></code></pre></div><h3 id=\"conventional-commits-与自动生成\">Conventional Commits 与自动生成</h3><p>通过规范化的 Commit Message，可以自动生成 CHANGELOG：</p>\n<table>\n<thead>\n<tr>\n<th>Commit 前缀</th>\n<th>CHANGELOG 分类</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>feat:</code></td>\n<td>新增</td>\n<td><code>feat: 支持批量导出</code></td>\n</tr>\n<tr>\n<td><code>fix:</code></td>\n<td>修复</td>\n<td><code>fix: 修复并发创建重复编号</code></td>\n</tr>\n<tr>\n<td><code>perf:</code></td>\n<td>性能改进</td>\n<td><code>perf: 优化分页查询</code></td>\n</tr>\n<tr>\n<td><code>BREAKING CHANGE:</code></td>\n<td>破坏性变更</td>\n<td>触发主版本号递增</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { execSync } from &#39;node:child_process&#39;;&#10;&#10;interface ConventionalCommit {&#10;  type: string;&#10;  scope: string | null;&#10;  description: string;&#10;  breaking: boolean;&#10;}&#10;&#10;function parseCommitMessage(message: string): ConventionalCommit | null {&#10;  const match = message.match(/^(\\w+)(?:\\(([^)]+)\\))?(!)?:\\s*(.+)/);&#10;  if (!match) return null;&#10;  return {&#10;    type: match[1],&#10;    scope: match[2] ?? null,&#10;    description: match[4],&#10;    breaking: match[3] === &#39;!&#39; || message.includes(&#39;BREAKING CHANGE&#39;),&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { execSync } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'node:child_process'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConventionalCommit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  scope</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  breaking</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> parseCommitMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">message</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConventionalCommit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> match</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> message.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">match</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\w</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)(?:</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\(</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\)</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">(!)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">match) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    type: match[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    scope: match[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    description: match[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    breaking: match[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '!'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> message.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'BREAKING CHANGE'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"文档维护策略\">文档维护策略</h2><p>文档最大的敌人是过时。一份过时的文档比没有文档更危险，因为它传递错误信息。</p>\n<h3 id=\"文档保鲜机制\">文档保鲜机制</h3><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>实施方式</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>文档即代码</td>\n<td>Markdown 存储在仓库中，走 PR 流程</td>\n<td>文档变更有评审保障</td>\n</tr>\n<tr>\n<td>CI 检查</td>\n<td>检测文档中的死链和过时示例</td>\n<td>自动发现问题</td>\n</tr>\n<tr>\n<td>定期审查</td>\n<td>每季度扫描文档最后更新日期</td>\n<td>识别陈旧文档</td>\n</tr>\n<tr>\n<td>代码生成</td>\n<td>API 文档从代码自动生成</td>\n<td>文档与代码始终同步</td>\n</tr>\n<tr>\n<td>所有权标记</td>\n<td>每份文档标注 Owner</td>\n<td>明确谁负责更新</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[代码变更] --&gt; B{涉及 API 变更?}&#10;    B --&gt;|是| C[更新 TSDoc]&#10;    B --&gt;|否| D{涉及架构变更?}&#10;    D --&gt;|是| E[编写新 ADR]&#10;    D --&gt;|否| F{涉及用户行为变更?}&#10;    F --&gt;|是| G[更新 CHANGELOG 和 README]&#10;    F --&gt;|否| H[无需文档更新]&#10;    C --&gt; I[PR 包含文档变更]&#10;    E --&gt; I&#10;    G --&gt; I\">flowchart TD\n    A[代码变更] --&gt; B{涉及 API 变更?}\n    B --&gt;|是| C[更新 TSDoc]\n    B --&gt;|否| D{涉及架构变更?}\n    D --&gt;|是| E[编写新 ADR]\n    D --&gt;|否| F{涉及用户行为变更?}\n    F --&gt;|是| G[更新 CHANGELOG 和 README]\n    F --&gt;|否| H[无需文档更新]\n    C --&gt; I[PR 包含文档变更]\n    E --&gt; I\n    G --&gt; I</pre><p>文档不是项目完成后的附属品，而是工程过程的有机组成部分。最好的文档实践是将文档写作嵌入到日常工作流中——API 变更时更新 TSDoc，架构决策时写 ADR，发版时生成 CHANGELOG。当文档成为工程习惯而非额外任务时，它才能真正发挥知识传承的价值。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>文档的价值在于弥合&quot;代码做了什么&quot;与&quot;为什么这样做&quot;之间的鸿沟。</li>\n<li>适度是文档的第一原则，过度文档化会制造过时信息，同样损害效率。</li>\n<li>分层体系让注释、TSDoc、README、ADR、CHANGELOG 各服务特定读者，避免职责错位。</li>\n<li>注释应解释 Why；复述代码行为的注释是噪音。</li>\n<li>ADR 把架构决策的背景、选项与后果固化，是团队记忆而非个人笔记。</li>\n<li>文档要保鲜：把更新动作嵌入 PR 工作流，才能避免文档随代码腐化。</li>\n</ul>\n","headings":[{"level":1,"text":"文档规范","id":"文档规范"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"文档的定位与哲学","id":"文档的定位与哲学"},{"level":2,"text":"文档分层体系","id":"文档分层体系"},{"level":2,"text":"内联注释的最佳实践","id":"内联注释的最佳实践"},{"level":3,"text":"什么时候写注释","id":"什么时候写注释"},{"level":3,"text":"注释决策矩阵","id":"注释决策矩阵"},{"level":2,"text":"TSDoc / JSDoc 规范","id":"tsdoc-jsdoc-规范"},{"level":3,"text":"TSDoc 标签速查","id":"tsdoc-标签速查"},{"level":2,"text":"README 写作标准","id":"readme-写作标准"},{"level":3,"text":"README 结构模板","id":"readme-结构模板"},{"level":3,"text":"README 质量评估","id":"readme-质量评估"},{"level":2,"text":"架构决策记录 (ADR)","id":"架构决策记录-adr"},{"level":3,"text":"ADR 模板","id":"adr-模板"},{"level":3,"text":"何时编写 ADR","id":"何时编写-adr"},{"level":2,"text":"变更日志 (CHANGELOG)","id":"变更日志-changelog"},{"level":3,"text":"Conventional Commits 与自动生成","id":"conventional-commits-与自动生成"},{"level":2,"text":"文档维护策略","id":"文档维护策略"},{"level":3,"text":"文档保鲜机制","id":"文档保鲜机制"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"代码风格强制","url":"/l-doc-books/h/management/engineering-craftsmanship/code-quality-standards/code-style-enforcement"},"next":{"title":"评审心态与文化","url":"/l-doc-books/h/management/engineering-craftsmanship/code-review-mastery/review-mindset-and-culture"}}