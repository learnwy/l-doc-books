n&quot;,&#10;          &quot;options&quot;: { &quot;maxAllowedComplexity&quot;: 15 }&#10;        }&#10;      },&#10;      &quot;suspicious&quot;: {&#10;        &quot;noExplicitAny&quot;: &quot;error&quot;&#10;      }&#10;    }&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"$schema\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"https://biomejs.dev/schemas/1.9.0/schema.json\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"formatter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"enabled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"indentStyle\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"space\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"indentWidth\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"lineWidth\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"linter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"enabled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"rules\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"recommended\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"complexity\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"noExcessiveCognitiveComplexity\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"level\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"warn\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"options\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"maxAllowedComplexity\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">15</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"suspicious\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"noExplicitAny\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"error\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"prettier-eslint-vs-biome\">Prettier + ESLint vs Biome</h3><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Prettier + ESLint</th>\n<th>Biome</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>性能</td>\n<td>秒级（大项目）</td>\n<td>毫秒级</td>\n</tr>\n<tr>\n<td>配置</td>\n<td>两套配置需协调</td>\n<td>单一配置文件</td>\n</tr>\n<tr>\n<td>生态</td>\n<td>海量插件和规则</td>\n<td>生态仍在成长</td>\n</tr>\n<tr>\n<td>语言覆盖</td>\n<td>极广</td>\n<td>JS/TS/JSON/CSS</td>\n</tr>\n<tr>\n<td>迁移成本</td>\n<td>已有项目零成本</td>\n<td>需要迁移配置和忽略规则</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"预提交检查\">预提交检查</h2><p>格式化和 Lint 应该在代码进入仓库之前就被保证。<code>husky</code> + <code>lint-staged</code> 是 Node.js 生态的标准方案：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;lint-staged&quot;: {&#10;    &quot;*.{ts,tsx}&quot;: [&quot;prettier --write&quot;, &quot;eslint --fix --max-warnings=0&quot;],&#10;    &quot;*.{json,md,yml}&quot;: [&quot;prettier --write&quot;]&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"lint-staged\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"*.{ts,tsx}\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"prettier --write\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"eslint --fix --max-warnings=0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"*.{json,md,yml}\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"prettier --write\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>配合 husky 的 pre-commit 钩子：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"#!/usr/bin/env sh&#10;. &quot;$(dirname -- &quot;$0&quot;)/_/husky.sh&quot;&#10;npx lint-staged\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#!/usr/bin/env sh</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"$(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dirname</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\")/_/husky.sh\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">npx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> lint-staged</span></span></code></pre></div><h3 id=\"预提交检查的决策矩阵\">预提交检查的决策矩阵</h3><table>\n<thead>\n<tr>\n<th>检查类型</th>\n<th>预提交执行</th>\n<th>CI 执行</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>格式化</td>\n<td>✅ 自动修复</td>\n<td>✅ 仅检查</td>\n<td>快速，应在本地解决</td>\n</tr>\n<tr>\n<td>Lint 快速规则</td>\n<td>✅ 自动修复</td>\n<td>✅</td>\n<td>不影响提交速度</td>\n</tr>\n<tr>\n<td>类型检查</td>\n<td>❌</td>\n<td>✅</td>\n<td>太慢，不适合预提交</td>\n</tr>\n<tr>\n<td>单元测试</td>\n<td>❌</td>\n<td>✅</td>\n<td>太慢，不适合预提交</td>\n</tr>\n<tr>\n<td>安全扫描</td>\n<td>❌</td>\n<td>✅</td>\n<td>需要完整上下文</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"ci-集成\">CI 集成</h2><p>CI 是风格检查的最终防线。即使开发者绕过了本地钩子，CI 也能阻止不合规代码合并。</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"name: Code Quality&#10;on: [pull_request]&#10;&#10;jobs:&#10;  lint:&#10;    runs-on: ubuntu-latest&#10;    steps:&#10;      - uses: actions/checkout@v4&#10;      - uses: actions/setup-node@v4&#10;        with:&#10;          node-version: 20&#10;          cache: &#39;pnpm&#39;&#10;      - run: pnpm install --frozen-lockfile&#10;      - run: pnpm run format:check&#10;      - run: pnpm run lint&#10;      - run: pnpm run typecheck\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Code Quality</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pull_request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  lint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/checkout@v4</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/setup-node@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          node-version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          cache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'pnpm'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm install --frozen-lockfile</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm run format:check</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm run lint</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm run typecheck</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[PR 创建] --&gt; B[CI 触发]&#10;    B --&gt; C[格式检查]&#10;    C --&gt; D[Lint 检查]&#10;    D --&gt; E[类型检查]&#10;    E --&gt; F{全部通过?}&#10;    F --&gt;|是| G[✅ 允许合并]&#10;    F --&gt;|否| H[❌ 阻止合并]&#10;    H --&gt; I[开发者修复]&#10;    I --&gt; A\">flowchart LR\n    A[PR 创建] --&gt; B[CI 触发]\n    B --&gt; C[格式检查]\n    C --&gt; D[Lint 检查]\n    D --&gt; E[类型检查]\n    E --&gt; F{全部通过?}\n    F --&gt;|是| G[✅ 允许合并]\n    F --&gt;|否| H[❌ 阻止合并]\n    H --&gt; I[开发者修复]\n    I --&gt; A</pre><hr>\n<h2 id=\"团队风格指南的创建与维护\">团队风格指南的创建与维护</h2><p>工具只是手段，背后需要一份团队认可的风格指南。创建风格指南的推荐流程：</p>\n<table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>行动</th>\n<th>产出</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>调研</td>\n<td>收集现有代码中的风格模式</td>\n<td>现状报告</td>\n</tr>\n<tr>\n<td>提案</td>\n<td>基于业界实践起草初版规范</td>\n<td>RFC 文档</td>\n</tr>\n<tr>\n<td>讨论</td>\n<td>团队评审，限时一周</td>\n<td>修改后的共识版</td>\n</tr>\n<tr>\n<td>固化</td>\n<td>转化为 ESLint/Prettier 配置</td>\n<td>配置文件</td>\n</tr>\n<tr>\n<td>发布</td>\n<td>写入团队文档，配置 CI</td>\n<td>生效的风格检查</td>\n</tr>\n<tr>\n<td>迭代</td>\n<td>每季度回顾，处理新增场景</td>\n<td>更新后的配置</td>\n</tr>\n</tbody></table>\n<p>风格指南的核心原则是<strong>有主见但可讨论</strong>。初始版本应该快速确定，遇到争议时由团队 Tech Lead 拍板。持续迭代比一次完美更重要。</p>\n<h3 id=\"常见争议的快速决策建议\">常见争议的快速决策建议</h3><table>\n<thead>\n<tr>\n<th>争议点</th>\n<th>推荐选择</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>分号还是无分号</td>\n<td>由 Prettier 决定即可</td>\n<td>无实质差异，交给工具</td>\n</tr>\n<tr>\n<td>单引号还是双引号</td>\n<td>单引号</td>\n<td>TypeScript 社区主流</td>\n</tr>\n<tr>\n<td>缩进 2 还是 4</td>\n<td>2 空格</td>\n<td>前端社区主流，节省水平空间</td>\n</tr>\n<tr>\n<td>尾逗号</td>\n<td>总是添加</td>\n<td>减少 git diff 噪音</td>\n</tr>\n<tr>\n<td>命名用 camelCase 还是 snake_case</td>\n<td>camelCase</td>\n<td>TypeScript/JavaScript 惯例</td>\n</tr>\n</tbody></table>\n<p>风格一致性的终极目标是让代码看起来像是&quot;一个人&quot;写的。当团队的每个成员都遵循相同的风格规范时，代码库的认知一致性显著提升，新成员上手速度加快，代码评审也能真正聚焦在业务逻辑和设计质量上。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>风格强制解决的是&quot;自行车棚问题&quot;，把团队注意力从格式争论转移到逻辑与架构。</li>\n<li>工具链分为编辑器、格式化、静态分析、CI 四层，职责不重叠是关键。</li>\n<li>Prettier 负责排版，ESLint/Biome 负责质量，二者分工而非竞争。</li>\n<li>检查前移：预提交钩子拦截大部分问题，CI 兜底防止漏网。</li>\n<li>风格选择优先交给工具决定，团队只在有实质影响的争议上讨论。</li>\n<li>最终收益是认知一致性——代码像一个人写的，评审才能聚焦业务。</li>\n</ul>\n","headings":[{"level":1,"text":"代码风格强制","id":"代码风格强制"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要强制风格","id":"为什么需要强制风格"},{"level":2,"text":"工具链全景","id":"工具链全景"},{"level":2,"text":"EditorConfig 配置","id":"editorconfig-配置"},{"level":2,"text":"Prettier：格式化的终极方案","id":"prettier-格式化的终极方案"},{"level":3,"text":"Prettier vs 手动格式化","id":"prettier-vs-手动格式化"},{"level":3,"text":"Prettier 与 ESLint 的分工","id":"prettier-与-eslint-的分工"},{"level":2,"text":"ESLint 深度配置","id":"eslint-深度配置"},{"level":3,"text":"关键规则分类","id":"关键规则分类"},{"level":2,"text":"Biome：新一代全能工具","id":"biome-新一代全能工具"},{"level":3,"text":"Prettier + ESLint vs Biome","id":"prettier-eslint-vs-biome"},{"level":2,"text":"预提交检查","id":"预提交检查"},{"level":3,"text":"预提交检查的决策矩阵","id":"预提交检查的决策矩阵"},{"level":2,"text":"CI 集成","id":"ci-集成"},{"level":2,"text":"团队风格指南的创建与维护","id":"团队风格指南的创建与维护"},{"level":3,"text":"常见争议的快速决策建议","id":"常见争议的快速决策建议"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"命名与可读性","url":"/l-doc-books/h/management/engineering-craftsmanship/code-quality-standards/naming-and-readability"},"next":{"title":"文档规范","url":"/l-doc-books/h/management/engineering-craftsmanship/code-quality-standards/documentation-standards"}}