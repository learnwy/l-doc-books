-dark:#B392F0\">evaluateCriterion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(criterion, currentOutput),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    results.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      caseId: testCase.id,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      baseline: testCase.expectedOutput </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      current: currentOutput,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      semanticSimilarity: similarity,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      criteriaResults,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      overallPass: criteriaResults.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">every</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.passed),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"统计回归检测\">统计回归检测</h3><p>单次测试结果不可靠。需要多次运行取统计值：</p>\n<table>\n<thead>\n<tr>\n<th>方法</th>\n<th>说明</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>多次运行取平均</td>\n<td>每个用例运行 3-5 次</td>\n<td>检测平均质量变化</td>\n</tr>\n<tr>\n<td>分布对比</td>\n<td>对比两个版本的分数分布</td>\n<td>检测整体趋势变化</td>\n</tr>\n<tr>\n<td>置信区间</td>\n<td>计算评分的置信区间</td>\n<td>确定变化是否显著</td>\n</tr>\n<tr>\n<td>降级告警</td>\n<td>超过阈值自动告警</td>\n<td>持续监控</td>\n</tr>\n</tbody></table>\n<h2 id=\"线上质量监控\">线上质量监控</h2><h3 id=\"监控仪表盘\">监控仪表盘</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[AI 质量监控] --&gt; B[实时指标]&#10;    A --&gt; C[趋势分析]&#10;    A --&gt; D[告警规则]&#10;&#10;    B --&gt; B1[延迟 P50/P95/P99]&#10;    B --&gt; B2[错误率]&#10;    B --&gt; B3[Token 消耗]&#10;    B --&gt; B4[用户反馈率]&#10;&#10;    C --&gt; C1[质量评分趋势]&#10;    C --&gt; C2[使用量趋势]&#10;    C --&gt; C3[成本趋势]&#10;&#10;    D --&gt; D1[质量评分低于阈值]&#10;    D --&gt; D2[错误率突增]&#10;    D --&gt; D3[延迟飙升]&#10;    D --&gt; D4[成本超预算]\">flowchart TD\n    A[AI 质量监控] --&gt; B[实时指标]\n    A --&gt; C[趋势分析]\n    A --&gt; D[告警规则]\n\n    B --&gt; B1[延迟 P50/P95/P99]\n    B --&gt; B2[错误率]\n    B --&gt; B3[Token 消耗]\n    B --&gt; B4[用户反馈率]\n\n    C --&gt; C1[质量评分趋势]\n    C --&gt; C2[使用量趋势]\n    C --&gt; C3[成本趋势]\n\n    D --&gt; D1[质量评分低于阈值]\n    D --&gt; D2[错误率突增]\n    D --&gt; D3[延迟飙升]\n    D --&gt; D4[成本超预算]</pre><h3 id=\"用户反馈闭环\">用户反馈闭环</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[用户反馈\\n👍/👎] --&gt; B[反馈收集]&#10;    B --&gt; C[问题分类]&#10;    C --&gt; D[补充到评估集]&#10;    D --&gt; E[改进系统]&#10;    E --&gt; F[验证改进]&#10;    F --&gt; G[发布更新]&#10;    G --&gt; A\">flowchart LR\n    A[用户反馈\\n👍/👎] --&gt; B[反馈收集]\n    B --&gt; C[问题分类]\n    C --&gt; D[补充到评估集]\n    D --&gt; E[改进系统]\n    E --&gt; F[验证改进]\n    F --&gt; G[发布更新]\n    G --&gt; A</pre><h2 id=\"评估自动化\">评估自动化</h2><h3 id=\"ci-cd-集成\">CI/CD 集成</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"name: ai-eval&#10;on: [pull_request]&#10;jobs:&#10;  evaluate:&#10;    steps:&#10;      - name: 运行评估集&#10;        run: node scripts/run-eval.mjs&#10;        env:&#10;          EVAL_SET: core&#10;&#10;      - name: 对比基准&#10;        run: node scripts/compare-baseline.mjs&#10;&#10;      - name: 质量门禁&#10;        run: |&#10;          if [ $(cat eval-results.json | jq &#39;.overallScore&#39;) -lt 85 ]; then&#10;            echo &quot;AI 质量评分低于 85，阻止合并&quot;&#10;            exit 1&#10;          fi\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ai-eval</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pull_request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  evaluate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">运行评估集</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">node scripts/run-eval.mjs</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        env</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          EVAL_SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">core</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">对比基准</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">node scripts/compare-baseline.mjs</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">质量门禁</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          if [ $(cat eval-results.json | jq '.overallScore') -lt 85 ]; then</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            echo \"AI 质量评分低于 85，阻止合并\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            exit 1</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          fi</span></span></code></pre></div><h2 id=\"实践建议\">实践建议</h2><ol>\n<li><strong>从评估集开始</strong>：任何 AI 功能上线前，至少准备 50 个评估用例</li>\n<li><strong>自动化评估</strong>：将评估集成到 CI/CD，每次变更自动运行</li>\n<li><strong>多维度评估</strong>：不只看准确率，还要看延迟、成本、用户满意度</li>\n<li><strong>持续扩充</strong>：将线上发现的失败案例补充到评估集</li>\n<li><strong>版本管理</strong>：评估集和基准分数都要版本化管理</li>\n</ol>\n<p>测试 AI 系统没有银弹。好的评估体系是在不确定性中建立确定性——你不能保证每次输出都完美，但你可以确保整体质量在可控范围内。</p>\n<h2 id=\"小结\">小结</h2><p>AI 测试与评估要在概率性输出的前提下重建确定性。本文的核心实践是：采用 Eval 驱动开发，先定义包含多条评估用例的评估集与验收标准，再优化系统；按任务类型选择精确匹配、包含检查、语义相似度、LLM 评判或人工评估；从场景覆盖、难度分层、边界与对抗测试四维度构建基准集，并用准确率、相关性、完整性、无害性、延迟 P95、成本六项指标衡量；对非确定性系统用多次运行、分布对比、置信区间与降级告警做回归检测；通过实时指标、趋势分析与告警规则做线上监控，并让用户反馈回流到评估集。落地建议是：上线前至少准备 50 个评估用例，把评估集成到 CI/CD，多维度评估，持续扩充失败案例，并把评估集与基准分数版本化管理。</p>\n","headings":[{"level":1,"text":"AI 测试与评估","id":"ai-测试与评估"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"AI 系统测试的独特挑战","id":"ai-系统测试的独特挑战"},{"level":2,"text":"Eval 驱动开发","id":"eval-驱动开发"},{"level":3,"text":"核心理念","id":"核心理念"},{"level":3,"text":"评估集设计","id":"评估集设计"},{"level":3,"text":"评估方法分类","id":"评估方法分类"},{"level":2,"text":"基准测试设计","id":"基准测试设计"},{"level":3,"text":"基准集构建","id":"基准集构建"},{"level":3,"text":"基准指标体系","id":"基准指标体系"},{"level":2,"text":"A/B 测试 AI 功能","id":"a-b-测试-ai-功能"},{"level":3,"text":"AI A/B 测试的特殊考量","id":"ai-a-b-测试的特殊考量"},{"level":3,"text":"测试设计","id":"测试设计"},{"level":3,"text":"核心测量指标","id":"核心测量指标"},{"level":2,"text":"非确定性系统的回归测试","id":"非确定性系统的回归测试"},{"level":3,"text":"挑战","id":"挑战"},{"level":3,"text":"统计回归检测","id":"统计回归检测"},{"level":2,"text":"线上质量监控","id":"线上质量监控"},{"level":3,"text":"监控仪表盘","id":"监控仪表盘"},{"level":3,"text":"用户反馈闭环","id":"用户反馈闭环"},{"level":2,"text":"评估自动化","id":"评估自动化"},{"level":3,"text":"CI/CD 集成","id":"ci-cd-集成"},{"level":2,"text":"实践建议","id":"实践建议"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"AI 用户体验设计","url":"/l-doc-books/h/management/ai-era-programmer-growth/ai-software-design/ai-ux-design-principles"},"next":{"title":"AI 时代技能地图","url":"/l-doc-books/h/management/ai-era-programmer-growth/ai-career-future/ai-era-skill-map"}}