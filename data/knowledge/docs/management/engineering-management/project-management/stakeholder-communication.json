 'resistant'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  concerns</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  communicationPreference</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    channel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'meeting'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'email'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'slack'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'report'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    frequency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'daily'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'weekly'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'biweekly'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'monthly'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    detailLevel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'executive-summary'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'standard'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'detailed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  strategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> stakeholders</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> StakeholderProfile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'张总'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    role: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'CTO'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    department: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'技术'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    influence: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'high'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    interest: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'medium'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    attitude: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'supporter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    concerns: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'技术风险'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'交付时间'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'团队产能'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    communicationPreference: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      channel: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'meeting'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      frequency: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'biweekly'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      detailLevel: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'executive-summary'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    strategy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'定期汇报关键里程碑和风险，只在需要决策时升级'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'李经理'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    role: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'产品经理'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    department: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'产品'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    influence: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'high'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    interest: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'high'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    attitude: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'supporter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    concerns: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'需求范围'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'用户体验'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'发布日期'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    communicationPreference: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      channel: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'slack'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      frequency: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'daily'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      detailLevel: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'standard'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    strategy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'每日同步进展，及时沟通需求变更影响'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><h3 id=\"权力-利益矩阵-power-interest-grid\">权力-利益矩阵（Power-Interest Grid）</h3><p>这是干系人管理中最经典的分析框架，由 Aubrey Mendelow 提出。根据干系人的<strong>权力</strong>（对项目的影响力）和<strong>利益</strong>（对项目的关注度）两个维度，将干系人划分为四个象限，对应四种不同的管理策略。</p>\n<pre class=\"mermaid\" data-diagram-type=\"quadrantChart\" data-source=\"quadrantChart&#10;    title 权力-利益矩阵&#10;    x-axis &quot;低利益&quot; --&gt; &quot;高利益&quot;&#10;    y-axis &quot;低权力&quot; --&gt; &quot;高权力&quot;&#10;    quadrant-1 &quot;重点管理&quot;&#10;    quadrant-2 &quot;令其满意&quot;&#10;    quadrant-3 &quot;监控即可&quot;&#10;    quadrant-4 &quot;随时告知&quot;\">quadrantChart\n    title 权力-利益矩阵\n    x-axis \"低利益\" --&gt; \"高利益\"\n    y-axis \"低权力\" --&gt; \"高权力\"\n    quadrant-1 \"重点管理\"\n    quadrant-2 \"令其满意\"\n    quadrant-3 \"监控即可\"\n    quadrant-4 \"随时告知\"</pre><table>\n<thead>\n<tr>\n<th>象限</th>\n<th>权力</th>\n<th>利益</th>\n<th>策略</th>\n<th>沟通方式</th>\n<th>典型角色</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>重点管理</td>\n<td>高</td>\n<td>高</td>\n<td>密切合作、积极参与</td>\n<td>频繁、双向、深入</td>\n<td>CTO、产品负责人</td>\n</tr>\n<tr>\n<td>令其满意</td>\n<td>高</td>\n<td>低</td>\n<td>保持满意、定期汇报</td>\n<td>定期、简洁、结果导向</td>\n<td>法务、CFO</td>\n</tr>\n<tr>\n<td>随时告知</td>\n<td>低</td>\n<td>高</td>\n<td>保持信息透明</td>\n<td>定期更新、开放渠道</td>\n<td>开发团队、设计师</td>\n</tr>\n<tr>\n<td>监控即可</td>\n<td>低</td>\n<td>低</td>\n<td>最小化沟通成本</td>\n<td>按需、低频</td>\n<td>间接相关部门</td>\n</tr>\n</tbody></table>\n<h3 id=\"raci-矩阵\">RACI 矩阵</h3><p>对于关键决策和交付物，使用 RACI 矩阵明确各干系人的角色：</p>\n<table>\n<thead>\n<tr>\n<th>交付物/决策</th>\n<th>CTO</th>\n<th>产品经理</th>\n<th>技术负责人</th>\n<th>开发团队</th>\n<th>QA</th>\n<th>运维</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>技术方案选型</td>\n<td>A</td>\n<td>C</td>\n<td>R</td>\n<td>C</td>\n<td>I</td>\n<td>C</td>\n</tr>\n<tr>\n<td>需求优先级排序</td>\n<td>I</td>\n<td>R</td>\n<td>C</td>\n<td>C</td>\n<td>I</td>\n<td>I</td>\n</tr>\n<tr>\n<td>Sprint 计划</td>\n<td>I</td>\n<td>A</td>\n<td>R</td>\n<td>R</td>\n<td>C</td>\n<td>I</td>\n</tr>\n<tr>\n<td>发布决策</td>\n<td>A</td>\n<td>C</td>\n<td>R</td>\n<td>I</td>\n<td>C</td>\n<td>R</td>\n</tr>\n<tr>\n<td>线上事故响应</td>\n<td>I</td>\n<td>I</td>\n<td>A</td>\n<td>R</td>\n<td>C</td>\n<td>R</td>\n</tr>\n<tr>\n<td>架构变更评审</td>\n<td>A</td>\n<td>I</td>\n<td>R</td>\n<td>C</td>\n<td>I</td>\n<td>C</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p>R = Responsible（负责执行）、A = Accountable（最终负责）、C = Consulted（需咨询）、I = Informed（需通知）</p>\n</blockquote>\n<hr>\n<h2 id=\"沟通计划设计\">沟通计划设计</h2><h3 id=\"沟通计划全景\">沟通计划全景</h3><p>一个完整的沟通计划需要回答五个核心问题：<strong>谁</strong>需要知道、<strong>什么</strong>信息、<strong>何时</strong>传递、<strong>如何</strong>传递、<strong>谁</strong>负责。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[Who&lt;br/&gt;谁需要知道] --&gt; B[What&lt;br/&gt;什么信息]&#10;    B --&gt; C[When&lt;br/&gt;何时传递]&#10;    C --&gt; D[How&lt;br/&gt;如何传递]&#10;    D --&gt; E[Owner&lt;br/&gt;谁负责]&#10;    E --&gt; F[Feedback&lt;br/&gt;如何反馈]&#10;    F --&gt;|持续优化| A\">flowchart LR\n    A[Who&lt;br/&gt;谁需要知道] --&gt; B[What&lt;br/&gt;什么信息]\n    B --&gt; C[When&lt;br/&gt;何时传递]\n    C --&gt; D[How&lt;br/&gt;如何传递]\n    D --&gt; E[Owner&lt;br/&gt;谁负责]\n    E --&gt; F[Feedback&lt;br/&gt;如何反馈]\n    F --&gt;|持续优化| A</pre><h3 id=\"分层沟通矩阵\">分层沟通矩阵</h3><table>\n<thead>\n<tr>\n<th>沟通层级</th>\n<th>受众</th>\n<th>内容</th>\n<th>频率</th>\n<th>渠道</th>\n<th>时长</th>\n<th>负责人</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>战略层</td>\n<td>C-Level</td>\n<td>项目健康度、关键风险、资源需求</td>\n<td>每月</td>\n<td>正式会议 + 报告</td>\n<td>30 分钟</td>\n<td>PM</td>\n</tr>\n<tr>\n<td>管理层</td>\n<td>总监/经理</td>\n<td>里程碑进展、预算消耗、团队产能</td>\n<td>每两周</td>\n<td>会议 + 邮件</td>\n<td>45 分钟</td>\n<td>PM</td>\n</tr>\n<tr>\n<td>执行层</td>\n<td>项目组成员</td>\n<td>任务分配、技术决策、阻塞问题</td>\n<td>每日</td>\n<td>站会 + Slack</td>\n<td>15 分钟</td>\n<td>TL</td>\n</tr>\n<tr>\n<td>协作层</td>\n<td>跨团队协作方</td>\n<td>接口约定、联调计划、依赖关系</td>\n<td>每周</td>\n<td>会议 + 文档</td>\n<td>30 分钟</td>\n<td>TL</td>\n</tr>\n<tr>\n<td>信息层</td>\n<td>所有相关方</td>\n<td>项目周报、变更通知</td>\n<td>每周</td>\n<td>邮件 + Wiki</td>\n<td>异步</td>\n<td>PM</td>\n</tr>\n</tbody></table>\n<h3 id=\"沟通渠道选择矩阵\">沟通渠道选择矩阵</h3><p>不同的信息类型适合不同的沟通渠道。选错渠道会导致信息丢失或效率低下。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    A{信息类型?}&#10;    A --&gt;|紧急+复杂| B[面对面/视频会议]&#10;    A --&gt;|紧急+简单| C[即时消息/电话]&#10;    A --&gt;|非紧急+复杂| D[文档+评审会议]&#10;    A --&gt;|非紧急+简单| E[邮件/异步消息]&#10;    A --&gt;|需要记录| F[邮件/Wiki/工单]&#10;    A --&gt;|需要共识| G[会议+纪要]&#10;&#10;    B --&gt; H[例:线上事故协调]&#10;    C --&gt; I[例:部署确认]&#10;    D --&gt; J[例:架构方案评审]&#10;    E --&gt; K[例:项目周报]&#10;    F --&gt; L[例:需求变更记录]&#10;    G --&gt; M[例:技术选型决策]\">flowchart TB\n    A{信息类型?}\n    A --&gt;|紧急+复杂| B[面对面/视频会议]\n    A --&gt;|紧急+简单| C[即时消息/电话]\n    A --&gt;|非紧急+复杂| D[文档+评审会议]\n    A --&gt;|非紧急+简单| E[邮件/异步消息]\n    A --&gt;|需要记录| F[邮件/Wiki/工单]\n    A --&gt;|需要共识| G[会议+纪要]\n\n    B --&gt; H[例:线上事故协调]\n    C --&gt; I[例:部署确认]\n    D --&gt; J[例:架构方案评审]\n    E --&gt; K[例:项目周报]\n    F --&gt; L[例:需求变更记录]\n    G --&gt; M[例:技术选型决策]</pre><table>\n<thead>\n<tr>\n<th>渠道</th>\n<th>信息丰富度</th>\n<th>反馈速度</th>\n<th>可追溯性</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>面对面会议</td>\n<td>★★★★★</td>\n<td>即时</td>\n<td>★★☆☆☆</td>\n<td>敏感话题、复杂讨论</td>\n</tr>\n<tr>\n<td>视频会议</td>\n<td>★★★★☆</td>\n<td>即时</td>\n<td>★★★☆☆</td>\n<td>远程团队日常沟通</td>\n</tr>\n<tr>\n<td>即时消息</td>\n<td>★★☆☆☆</td>\n<td>快速</td>\n<td>★★★☆☆</td>\n<td>快速协调、简单确认</td>\n</tr>\n<tr>\n<td>邮件</td>\n<td>★★★☆☆</td>\n<td>慢</td>\n<td>★★★★★</td>\n<td>正式通知、决策记录</td>\n</tr>\n<tr>\n<td>文档/Wiki</td>\n<td>★★★★☆</td>\n<td>异步</td>\n<td>★★★★★</td>\n<td>知识沉淀、方案评审</td>\n</tr>\n<tr>\n<td>仪表板</td>\n<td>★★★☆☆</td>\n<td>实时</td>\n<td>★★★★☆</td>\n<td>进度透明、数据驱动</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"向上汇报技巧\">向上汇报技巧</h2><h3 id=\"金字塔原理-pyramid-principle\">金字塔原理（Pyramid Principle）</h3><p>向上汇报最忌&quot;流水账&quot;式的报告。Barbara Minto 提出的金字塔原理，核心思想是<strong>结论先行、分层论证</strong>。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    A[核心结论&lt;br/&gt;项目按计划推进,有一个需要决策的风险]&#10;&#10;    A --&gt; B[论点1&lt;br/&gt;进度正常]&#10;    A --&gt; C[论点2&lt;br/&gt;质量达标]&#10;    A --&gt; D[论点3&lt;br/&gt;存在供应商风险]&#10;&#10;    B --&gt; B1[里程碑1 已完成]&#10;    B --&gt; B2[里程碑2 进行中]&#10;&#10;    C --&gt; C1[测试覆盖率 78%]&#10;    C --&gt; C2[零 P0 缺陷]&#10;&#10;    D --&gt; D1[供应商API延迟2周]&#10;    D --&gt; D2[需要决策:等待 or 替代方案]&#10;\">graph TB\n    A[核心结论&lt;br/&gt;项目按计划推进,有一个需要决策的风险]\n\n    A --&gt; B[论点1&lt;br/&gt;进度正常]\n    A --&gt; C[论点2&lt;br/&gt;质量达标]\n    A --&gt; D[论点3&lt;br/&gt;存在供应商风险]\n\n    B --&gt; B1[里程碑1 已完成]\n    B --&gt; B2[里程碑2 进行中]\n\n    C --&gt; C1[测试覆盖率 78%]\n    C --&gt; C2[零 P0 缺陷]\n\n    D --&gt; D1[供应商API延迟2周]\n    D --&gt; D2[需要决策:等待 or 替代方案]\n</pre><h3 id=\"ppp-汇报框架\">PPP 汇报框架</h3><p>PPP（Progress-Plans-Problems）是最实用的状态汇报框架：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PPPReport {&#10;  reportDate: string;&#10;  projectName: string;&#10;  overallStatus: &#39;green&#39; | &#39;yellow&#39; | &#39;red&#39;;&#10;  progress: ProgressItem[];&#10;  plans: PlanItem[];&#10;  problems: ProblemItem[];&#10;}&#10;&#10;interface ProgressItem {&#10;  description: string;&#10;  milestone: string;&#10;  completionRate: number;&#10;}&#10;&#10;interface PlanItem {&#10;  description: string;&#10;  targetDate: string;&#10;  owner: string;&#10;}&#10;&#10;interface ProblemItem {&#10;  description: string;&#10;  severity: &#39;critical&#39; | &#39;major&#39; | &#39;minor&#39;;&#10;  impact: string;&#10;  proposedSolution: string;&#10;  needsDecision: boolean;&#10;}&#10;&#10;const weeklyReport: PPPReport = {&#10;  reportDate: &#39;2024-03-15&#39;,&#10;  projectName: &#39;用户中心重构&#39;,&#10;  overallStatus: &#39;yellow&#39;,&#10;  progress: [&#10;    {&#10;      description: &#39;用户认证模块迁移完成&#39;,&#10;      milestone: &#39;M2&#39;,&#10;      completionRate: 100,&#10;    },&#10;    {&#10;      description: &#39;权限系统重构进行中&#39;,&#10;      milestone: &#39;M3&#39;,&#10;      completionRate: 60,&#10;    },&#10;  ],&#10;  plans: [&#10;    {&#10;      description: &#39;完成权限系统核心逻辑&#39;,&#10;      targetDate: &#39;2024-03-22&#39;,&#10;      owner: &#39;王工&#39;,&#10;    },&#10;    {&#10;      description: &#39;启动集成测试&#39;,&#10;      targetDate: &#39;2024-03-25&#39;,&#10;      owner: &#39;李工&#39;,&#10;    },&#10;  ],&#10;  problems: [&#10;    {&#10;      description: &#39;第三方认证服务迁移方案待确认&#39;,&#10;      severity: &#39;major&#39;,&#10;      impact: &#39;可能影响 M3 里程碑延期 1 周&#39;,&#10;      proposedSolution: &#39;方案A：自建适配层；方案B：等待供应商新版本&#39;,&#10;      needsDecision: true,&#10;    },&#10;  ],&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PPPReport</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  reportDate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  projectName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  overallStatus</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'green'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'yellow'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'red'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  progress</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><sp