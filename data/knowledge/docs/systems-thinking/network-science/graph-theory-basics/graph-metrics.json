ors[i])) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        triangles</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> triangles) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (k </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (k </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> averageClusteringCoefficient</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">V</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">E</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">graph</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Graph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">V</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">E</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> vertices</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> graph.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getVertices</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> total</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vertices.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> clusteringCoefficient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(graph, v), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> total </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vertices.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>聚类系数在不同网络类型中的典型值：</p>\n<table>\n<thead>\n<tr>\n<th>网络类型</th>\n<th>典型聚类系数</th>\n<th>含义</th>\n<th>例子</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>随机网络</td>\n<td>~p（连接概率）</td>\n<td>无显著聚类</td>\n<td>Erdős–Rényi 模型</td>\n</tr>\n<tr>\n<td>规则网格</td>\n<td>0.5-0.75</td>\n<td>高聚类</td>\n<td>晶格结构</td>\n</tr>\n<tr>\n<td>小世界网络</td>\n<td>0.3-0.7</td>\n<td>高聚类 + 短路径</td>\n<td>社交网络</td>\n</tr>\n<tr>\n<td>无标度网络</td>\n<td>0.1-0.5</td>\n<td>层级聚类</td>\n<td>互联网、代码依赖</td>\n</tr>\n<tr>\n<td>树形网络</td>\n<td>0</td>\n<td>无聚类</td>\n<td>严格层级结构</td>\n</tr>\n</tbody></table>\n<h2 id=\"中心性分析\">中心性分析</h2><p>中心性（Centrality）是度量节点在网络中重要程度的一族指标。不同的中心性指标捕捉了&quot;重要性&quot;的不同方面。</p>\n<p><strong>度中心性</strong>是最简单的中心性指标——节点的度越高越重要。在社交网络中，度中心性高的用户有更多的直接联系人。在微服务中，度中心性高的服务有更多的直接依赖方和被依赖方。</p>\n<p><strong>介数中心性</strong>（Betweenness Centrality）度量了一个节点作为&quot;桥梁&quot;的程度——经过该节点的最短路径越多，其介数中心性越高。介数中心性高的节点是网络中的通信枢纽，其移除可能导致网络断裂。</p>\n<p><strong>接近中心性</strong>（Closeness Centrality）度量了节点到网络中所有其他节点的平均距离。接近中心性高的节点可以最快地到达网络中的任何位置，适合作为信息传播的起点。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;  subgraph 中心性对比&#10;    A[度中心性] --&gt; D[谁连接最多?]&#10;    B[介数中心性] --&gt; E[谁是瓶颈?]&#10;    C[接近中心性] --&gt; F[谁能最快触达所有人?]&#10;  end&#10;  subgraph 架构决策&#10;    D --&gt; G[资源分配优先级]&#10;    E --&gt; H[冗余设计重点]&#10;    F --&gt; I[消息广播起点]&#10;  end\">graph TD\n  subgraph 中心性对比\n    A[度中心性] --&gt; D[谁连接最多?]\n    B[介数中心性] --&gt; E[谁是瓶颈?]\n    C[接近中心性] --&gt; F[谁能最快触达所有人?]\n  end\n  subgraph 架构决策\n    D --&gt; G[资源分配优先级]\n    E --&gt; H[冗余设计重点]\n    F --&gt; I[消息广播起点]\n  end</pre><p>在实际的架构治理中，综合使用多种中心性指标可以全面评估每个服务的角色：</p>\n<table>\n<thead>\n<tr>\n<th>中心性组合</th>\n<th>含义</th>\n<th>架构角色</th>\n<th>风险与对策</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>高度 + 高介数</td>\n<td>核心枢纽</td>\n<td>API 网关、共享中间件</td>\n<td>最高优先级容灾</td>\n</tr>\n<tr>\n<td>高度 + 低介数</td>\n<td>叶子节点群</td>\n<td>大量独立的终端服务</td>\n<td>低风险</td>\n</tr>\n<tr>\n<td>低度 + 高介数</td>\n<td>关键桥梁</td>\n<td>连接两个子系统的唯一通道</td>\n<td>最需要冗余</td>\n</tr>\n<tr>\n<td>低度 + 低介数</td>\n<td>边缘节点</td>\n<td>辅助性独立服务</td>\n<td>最低优先级</td>\n</tr>\n</tbody></table>\n<h2 id=\"度量指标的实践应用\">度量指标的实践应用</h2><p>将图度量指标应用于软件架构的持续监控，可以建立架构健康度的定量评估体系。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ArchitectureHealth {&#10;  density: number;&#10;  maxDegree: number;&#10;  avgPathLength: number;&#10;  clusteringCoeff: number;&#10;  topBetweenness: Array&lt;{ service: string; score: number }&gt;;&#10;}&#10;&#10;const assessArchitectureHealth = (&#10;  metrics: ArchitectureHealth,&#10;): Array&lt;{ area: string; status: string; action: string }&gt; =&gt; {&#10;  const findings: Array&lt;{ area: string; status: string; action: string }&gt; = [];&#10;&#10;  if (metrics.density &gt; 0.2) {&#10;    findings.push({&#10;      area: &#39;耦合度&#39;,&#10;      status: &#39;⚠️ 高密度&#39;,&#10;      action: &#39;审查是否有不必要的直接依赖&#39;,&#10;    });&#10;  }&#10;&#10;  if (metrics.maxDegree &gt; 15) {&#10;    findings.push({&#10;      area: &#39;核心服务&#39;,&#10;      status: &#39;⚠️ 度过高&#39;,&#10;      action: &#39;考虑拆分或引入代理层&#39;,&#10;    });&#10;  }&#10;&#10;  if (metrics.topBetweenness[0]?.score &gt; 0.5) {&#10;    findings.push({&#10;      area: &#39;瓶颈风险&#39;,&#10;      status: &#39;🔴 高介数节点&#39;,&#10;      action: &#39;该服务需要冗余部署和熔断保护&#39;,&#10;    });&#10;  }&#10;&#10;  return findings;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ArchitectureHealth</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  density</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  maxDegree</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  avgPathLength</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  clusteringCoeff</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  topBetweenness</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">service</span><span style=\"color:#D73A49