/span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">node</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">neighbors</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> layer1) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> neighbor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> neighbors) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          totalEdges</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (layer2.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(node)?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(neighbor)) sharedEdges</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">layerNames</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">[</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}&#x3C;->${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">layerNames</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">[</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">j</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      coupling.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, totalEdges </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sharedEdges </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalEdges </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> coupling;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>层间耦合的类型和影响：</p>\n<table>\n<thead>\n<tr>\n<th>耦合类型</th>\n<th>描述</th>\n<th>影响</th>\n<th>管理策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>结构耦合</td>\n<td>两层中同一对节点都有边</td>\n<td>一层的变更影响另一层</td>\n<td>解耦设计、适配器模式</td>\n</tr>\n<tr>\n<td>操作耦合</td>\n<td>一层的操作依赖另一层</td>\n<td>一层故障导致另一层失效</td>\n<td>层间隔离、降级策略</td>\n</tr>\n<tr>\n<td>时序耦合</td>\n<td>两层的变化在时间上相关</td>\n<td>需要同步变更</td>\n<td>协调发布、版本管理</td>\n</tr>\n<tr>\n<td>信息耦合</td>\n<td>两层共享信息</td>\n<td>信息不一致风险</td>\n<td>事件溯源、最终一致性</td>\n</tr>\n</tbody></table>\n<h2 id=\"多层网络中的故障传播\">多层网络中的故障传播</h2><p>多层网络中的故障传播比单层网络更复杂。一层中的故障可能通过层间耦合传播到其他层，在不同层之间反复放大。</p>\n<p>经典的例子是电网与通信网络的相互依赖：电网节点的故障导致通信网络的控制节点失电，通信中断又导致电网无法协调恢复，形成恶性循环。在软件系统中，API 调用超时可能导致消息队列积压，消息积压又导致依赖消息的 API 响应变慢，形成跨层的级联效应。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;  subgraph API 层故障传播&#10;    A1[服务 A 超时] --&gt; B1[调用方 B 重试]&#10;    B1 --&gt; C1[A 负载加剧]&#10;  end&#10;  subgraph 消息层连锁反应&#10;    C1 --&gt; A2[A 的消息产生延迟]&#10;    A2 --&gt; B2[消费者 C 积压]&#10;    B2 --&gt; C2[C 的 API 响应变慢]&#10;  end&#10;  subgraph 跨层级联&#10;    C2 --&gt; D1[C 的调用方受影响]&#10;    D1 --&gt; A1&#10;  end\">graph TD\n  subgraph API 层故障传播\n    A1[服务 A 超时] --&gt; B1[调用方 B 重试]\n    B1 --&gt; C1[A 负载加剧]\n  end\n  subgraph 消息层连锁反应\n    C1 --&gt; A2[A 的消息产生延迟]\n    A2 --&gt; B2[消费者 C 积压]\n    B2 --&gt; C2[C 的 API 响应变慢]\n  end\n  subgraph 跨层级联\n    C2 --&gt; D1[C 的调用方受影响]\n    D1 --&gt; A1\n  end</pre><p>Buldyrev 等人在 2010 年证明了一个重要结论：相互依赖网络的渗流阈值远低于单层网络。这意味着多层系统比单层系统更脆弱——单独来看每一层都足够鲁棒，但层间依赖大幅降低了整体韧性。这个发现对软件架构的启示是：不能只评估单个通信层的可靠性，必须评估所有层交互后的整体可靠性。</p>\n<table>\n<thead>\n<tr>\n<th>分析维度</th>\n<th>单层分析</th>\n<th>多层分析</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>故障影响</td>\n<td>仅当前层内传播</td>\n<td>跨层传播和放大</td>\n</tr>\n<tr>\n<td>韧性评估</td>\n<td>可能过度乐观</td>\n<td>更接近真实风险</td>\n</tr>\n<tr>\n<td>关键节点</td>\n<td>层内中心性高</td>\n<td>跨层影响力高</td>\n</tr>\n<tr>\n<td>优化策略</td>\n<td>层内冗余</td>\n<td>层间解耦 + 层内冗余</td>\n</tr>\n</tbody></table>\n<h2 id=\"多层网络的架构应用\">多层网络的架构应用</h2><p>将多层网络分析应用于软件架构，可以从多个维度全面评估系统的健康状态。</p>\n<p><strong>多层依赖分析</strong>。为每种通信方式（同步 API、异步消息、共享数据库、文件系统）构建一个网络层，然后分析：哪些服务在多个层上都高度耦合（高风险点）？哪些层间耦合最强（需要优先解耦的方向）？是否存在只在某一层上可见的隐藏依赖？</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MultiLayerArchitectureAnalysis {&#10;  layers: Array&lt;{&#10;    name: string;&#10;    graph: Map&lt;string, Set&lt;string&gt;&gt;;&#10;    criticalNodes: string[];&#10;  }&gt;;&#10;  crossLayerRisks: Array&lt;{&#10;    service: string;&#10;    appearsInLayers: string[];&#10;    riskLevel: &#39;low&#39; | &#39;medium&#39; | &#39;high&#39;;&#10;  }&gt;;&#10;}&#10;&#10;const identifyCrossLayerRisks = (&#10;  layers: Map&lt;string, Map&lt;string, Set&lt;string&gt;&gt;&gt;,&#10;): Array&lt;{ service: string; layerCount: number; totalDegree: number }&gt; =&gt; {&#10;  const serviceLayerMap = new Map&lt;string, { layers: string[]; totalDegree: number }&gt;();&#10;&#10;  for (const [layerName, graph] of layers) {&#10;    for (const [service, neighbors] of graph) {&#10;      if (!serviceLayerMap.has(service)) {&#10;        serviceLayerMap.set(service, { layers: [], totalDegree: 0 });&#10;      }&#10;      const entry = serviceLayerMap.get(service)!;&#10;      entry.layers.push(layerName);&#10;      entry.totalDegree += neighbors.size;&#10;    }&#10;  }&#10;&#10;  return [...serviceLayerMap.entries()]&#10;    .map(([service, data]) =&gt; ({&#10;      service,&#10;      layerCount: data.layers.length,&#10;      totalDegree: data.totalDegree,&#10;    }))&#10;    .sort((a, b) =&gt; b.layerCount * b.totalDegree - a.layerCount * a.totalDegree);&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MultiLayerArchitectureAnalysis</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  layers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    graph</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    criticalNodes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }>;</span></span>\n<span class=\"line\"><span style=\"c