:#24292E;--shiki-dark:#E1E4E8\">; step </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxSteps; step</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      r </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> st</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> state.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">values</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (st </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'S'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (st </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'I'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    history.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ step, s, i, r });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> newStates</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(state);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">node</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">st</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> state) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (st </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'I'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> neighbor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> graph.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(node) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (state.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(neighbor) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'S'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> beta) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            newStates.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(neighbor, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'I'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gamma) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          newStates.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(node, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'R'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">k</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> newStates) state.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(k, v);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> history;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>不同网络结构对传播模式的影响：</p>\n<table>\n<thead>\n<tr>\n<th>网络类型</th>\n<th>传播阈值</th>\n<th>传播速度</th>\n<th>传播范围</th>\n<th>免疫策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>随机网络</td>\n<td>有限阈值</td>\n<td>均匀</td>\n<td>阈值以上全网扩散</td>\n<td>随机免疫有效</td>\n</tr>\n<tr>\n<td>小世界网络</td>\n<td>较低</td>\n<td>快（捷径加速）</td>\n<td>全网</td>\n<td>删除捷径可阻断</td>\n</tr>\n<tr>\n<td>无标度网络</td>\n<td>接近零</td>\n<td>极快（Hub 加速）</td>\n<td>几乎全网</td>\n<td>必须优先免疫 Hub</td>\n</tr>\n<tr>\n<td>模块化网络</td>\n<td>社区内低，跨社区高</td>\n<td>社区内快，跨域慢</td>\n<td>可限制在社区内</td>\n<td>保护跨域连接</td>\n</tr>\n</tbody></table>\n<p>在无标度网络中一个关键发现是：传播阈值接近零。这意味着即使传播力很弱的&quot;疾病&quot;（或故障）也能在无标度网络中持续存在。在软件系统中，这暗示着低概率的间歇性故障在高度连接的系统中永远不会自行消退——需要主动干预。</p>\n<h2 id=\"影响力最大化\">影响力最大化</h2><p>影响力最大化问题（Influence Maximization）是传播动力学的逆问题：给定网络结构和传播模型，找到 k 个&quot;种子节点&quot;使得最终传播范围最大。这个问题在病毒营销、信息分发和安全加固中都有直接应用。</p>\n<p>Kempe 等人在 2003 年证明影响力最大化是 NP-hard 问题，但贪心算法可以获得 (1-1/e) ≈ 63% 的近似最优解。贪心策略每次选择能带来最大边际传播增量的节点。</p>\n<p>在软件系统中，影响力最大化的对偶问题——<strong>关键节点免疫</strong>——更有实际意义。给定有限的容灾预算（只能为 k 个服务部署高可用方案），哪些服务应该优先保护？</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;  subgraph 影响力最大化&#10;    A[选择 k 个种子] --&gt; B[最大化传播范围]&#10;  end&#10;  subgraph 关键节点免疫&#10;    C[保护 k 个节点] --&gt; D[最小化故障传播]&#10;  end&#10;  subgraph 选择策略&#10;    E[度中心性] --&gt; F[简单但有效]&#10;    G[介数中心性] --&gt; H[识别桥梁节点]&#10;    I[贪心模拟] --&gt; J[最优但耗时]&#10;  end\">graph TD\n  subgraph 影响力最大化\n    A[选择 k 个种子] --&gt; B[最大化传播范围]\n  end\n  subgraph 关键节点免疫\n    C[保护 k 个节点] --&gt; D[最小化故障传播]\n  end\n  subgraph 选择策略\n    E[度中心性] --&gt; F[简单但有效]\n    G[介数中心性] --&gt; H[识别桥梁节点]\n    I[贪心模拟] --&gt; J[最优但耗时]\n  end</pre><table>\n<thead>\n<tr>\n<th>种子选择策略</th>\n<th>原理</th>\n<th>计算成本</th>\n<th>效果</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>度中心性</td>\n<td>选最高度节点</td>\n<td>O(V logV)</td>\n<td>好</td>\n<td>快速近似</td>\n</tr>\n<tr>\n<td>介数中心性</td>\n<td>选最高介数节点</td>\n<td>O(V·E)</td>\n<td>较好</td>\n<td>关注桥梁节点</td>\n</tr>\n<tr>\n<td>贪心模拟</td>\n<td>每次选边际增益最大</td>\n<td>O(k·V·R)</td>\n<td>最优近似</td>\n<td>精确但慢</td>\n</tr>\n<tr>\n<td>折扣度</td>\n<td>已选邻居的度打折</td>\n<td>O(V logV)</td>\n<td>好</td>\n<td>避免选相邻节点</td>\n</tr>\n</tbody></table>\n<h2 id=\"信息传播与谣言模型\">信息传播与谣言模型</h2><p>信息在社交网络中的传播遵循不同于疾病的规则。DK（Daley-Kendall）谣言模型将个体分为三类：Ignorant（不知情者）、Spreader（传播者）和 Stifler（沉默者）。传播者遇到不知情者时传递信息，但传播者遇到另一个传播者或沉默者时会变成沉默者（因为信息已不再&quot;新鲜&quot;）。</p>\n<p>在软件系统中，配置变更的传播类似谣言模型。配置中心推送新配置时，服务实例从&quot;旧配置&quot;变为&quot;新配置&quot;。已经获得新配置的实例不会再次被同一变更&quot;感染&quot;。传播速度取决于配置推送的网络拓扑和推送策略。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface RumorSpread {&#10;  graph: Map&lt;string, Set&lt;string&gt;&gt;;&#10;  ignorants: Set&lt;string&gt;;&#10;  spreaders: Set&lt;string&gt;;&#10;  stiflers: Set&lt;string&gt;;&#10;}&#10;&#10;const simulateRumor = (&#10;  graph: Map&lt;string, Set&lt;string&gt;&gt;,&#10;  initialSpreader: string,&#10;  spreadRate: number,&#10;  stifleRate: number,&#10;  maxSteps: number,&#10;): { finalReached: number; peakSpreaders: number } =&gt; {&#10;  const ignorants = new Set(graph.keys());&#10;  const spreaders = new Set&lt;string&gt;();&#10;  const stiflers = new Set&lt;string&gt;();&#10;&#10;  ignorants.delete(initialSpreader);&#10;  spreaders.add(initialSpreader);&#10;&#10;  let peakSpreaders = 1;&#10;&#10;  for (let step = 0; step &lt; maxSteps; step++) {&#10;    if (spreaders.size === 0) break;&#10;&#10;    const newSpreaders = new Set&lt;string&gt;();&#10;    const newStiflers = new Set&lt;string&gt;();&#10;&#10;    for (const spreader of spreaders) {&#10;      for (const neighbor of graph.get(spreader) ?? []) {&#10;        if (ignorants.has(neighbor) &amp;&amp; Math.random() &lt; spreadRate) {&#10;          ignorants.delete(neighbor);&#10;          newSpreaders.add(neighbor);&#10;        } else if ((spreaders.has(neighbor) || stiflers.has(neighbor)) &amp;&amp; Math.random() &lt; stifleRate) {&#10;          newStiflers.add(spreader);&#10;        }&#10;      }&#10;    }&#10;&#10;    for (const s of newSpreaders) spreaders.add(s);&#10;    for (const s of newStiflers) {&#10;      spreaders.delete(s);&#10;      stiflers.add(s);&#10;    }&#10;&#10;    peakSpreaders = Math.max(peakSpreaders, spreaders.size);&#10;  }&#10;&#10;  return {&#10;    finalReached: stiflers.size + spreaders.size,&#10;    peakSpreaders,&#10;  };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RumorSpread</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  graph</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  ignorants</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  spreaders</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  stiflers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;<