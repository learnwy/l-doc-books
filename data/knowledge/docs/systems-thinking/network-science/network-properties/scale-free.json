yle=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> filtered.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> alpha</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> filtered.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">x</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (xmin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { alpha, xmin };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>常见的度分布模型及其判别：</p>\n<table>\n<thead>\n<tr>\n<th>分布类型</th>\n<th>概率密度函数</th>\n<th>特征</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>纯幂律</td>\n<td>P(k) ~ k^(-γ)</td>\n<td>无限尾部</td>\n<td>理论模型</td>\n</tr>\n<tr>\n<td>截断幂律</td>\n<td>P(k) ~ k^(-γ)·e^(-k/κ)</td>\n<td>有限资源限制尾部</td>\n<td>大部分真实网络</td>\n</tr>\n<tr>\n<td>对数正态</td>\n<td>P(k) ~ (1/k)·exp(-(logk-μ)²/2σ²)</td>\n<td>乘性随机过程</td>\n<td>人际联系数量</td>\n</tr>\n<tr>\n<td>拉伸指数</td>\n<td>P(k) ~ exp(-k^β)</td>\n<td>β&lt;1 时类似幂律</td>\n<td>某些社交网络</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>无标度网络的度分布服从幂律 P(k)~k^(-γ)，少数 Hub 节点度极高</li>\n<li>BA 模型通过增长 + 优先连接两个机制生成无标度网络</li>\n<li>优先连接是正反馈循环的体现（马太效应），在软件生态中普遍存在</li>\n<li>无标度网络对随机故障鲁棒但对 Hub 定向攻击极度脆弱</li>\n<li>Hub 服务需要最高级别的容灾、监控和安全防护</li>\n<li>幂律分布的识别需要严谨的统计方法，不能仅靠目视判断</li>\n</ul>\n","headings":[{"level":1,"text":"无标度网络","id":"无标度网络"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"BA 模型与优先连接","id":"ba-模型与优先连接"},{"level":2,"text":"鲁棒性与脆弱性的双面性","id":"鲁棒性与脆弱性的双面性"},{"level":2,"text":"幂律分布的识别与验证","id":"幂律分布的识别与验证"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"小世界网络","url":"/l-doc-books/h/systems-thinking/network-science/network-properties/small-world"},"next":{"title":"社区结构","url":"/l-doc-books/h/systems-thinking/network-science/network-properties/community-structure"}}