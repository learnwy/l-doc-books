:#24292E;--shiki-dark:#E1E4E8\"> key.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">split</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'|'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> pXY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> jointCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> total;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> pX</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (xFreq.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(x) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> total;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> pY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (yFreq.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(y) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> total;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pXY </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pX </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pY </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      mi </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pXY </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pXY </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pX </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pY));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mi;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>在搜索和推荐系统中，互信息帮助识别最具区分力的特征。例如，在电商搜索排序中，计算每个排序特征（价格、销量、评分、点击率）与最终转化之间的互信息，可以量化每个特征对预测转化的贡献。互信息高的特征优先纳入排序模型。</p>\n<h2 id=\"信息论视角下的系统设计\">信息论视角下的系统设计</h2><p>信息论为系统设计提供了几个深刻的启示：</p>\n<p><strong>最小描述长度原则</strong>（MDL）认为最好的模型是能以最短方式描述数据的模型。在系统设计中，过度复杂的架构就像过度拟合——它可能完美匹配当前需求，但无法简洁地描述系统的核心逻辑。简洁的架构更容易理解、维护和扩展。</p>\n<p><strong>信息瓶颈理论</strong>认为学习过程的本质是找到输入数据的压缩表示，保留与目标相关的信息，丢弃无关的噪声。API 设计遵循同样的原则——好的 API 是输入数据的信息瓶颈，只暴露调用者需要的信息，隐藏内部实现细节。</p>\n<table>\n<thead>\n<tr>\n<th>信息论原则</th>\n<th>系统设计启示</th>\n<th>反模式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>信源编码定理</td>\n<td>数据存储接近理论最小</td>\n<td>存储未压缩的重复数据</td>\n</tr>\n<tr>\n<td>信道编码定理</td>\n<td>合理冗余实现可靠性</td>\n<td>无冗余或过度冗余</td>\n</tr>\n<tr>\n<td>最小描述长度</td>\n<td>选择最简洁的架构</td>\n<td>过度设计</td>\n</tr>\n<tr>\n<td>信息瓶颈</td>\n<td>API 只暴露必要信息</td>\n<td>泄漏内部实现细节</td>\n</tr>\n<tr>\n<td>互信息最大化</td>\n<td>特征选择保留相关性</td>\n<td>使用大量冗余特征</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>信息论将信息定义为不确定性的消除，信息熵量化了平均不确定性</li>\n<li>数据压缩的理论极限由信息熵决定，现代压缩算法在逼近这个极限</li>\n<li>信道编码定理保证了在噪声信道上可靠通信的可能性，冗余是纠错的核心资源</li>\n<li>互信息度量变量间共享的信息，是特征选择和相关性分析的有力工具</li>\n<li>最小描述长度原则和信息瓶颈理论为简洁架构设计提供了理论依据</li>\n<li>日志分析中的熵计算可以识别异常模式和优化日志采集策略</li>\n</ul>\n","headings":[{"level":1,"text":"信息论基础","id":"信息论基础"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"信息熵在软件中的应用","id":"信息熵在软件中的应用"},{"level":2,"text":"信道编码与可靠通信","id":"信道编码与可靠通信"},{"level":2,"text":"互信息与特征选择","id":"互信息与特征选择"},{"level":2,"text":"信息论视角下的系统设计","id":"信息论视角下的系统设计"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"必要多样性定律","url":"/l-doc-books/h/systems-thinking/cybernetics/feedback-and-control/requisite-variety"},"next":{"title":"熵与有序性","url":"/l-doc-books/h/systems-thinking/cybernetics/information-and-communication/entropy-and-order"}}