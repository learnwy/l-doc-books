SVG 渲染图表主体，Canvas 渲染热力/密度图</td>\n<td>地理热力图</td>\n</tr>\n<tr>\n<td>按数据量动态切换</td>\n<td>数据量 &lt; 阈值用 SVG，超过切换 Canvas</td>\n<td>自适应可视化组件</td>\n</tr>\n<tr>\n<td>分层渲染</td>\n<td>不同图层使用不同技术</td>\n<td>多层数据叠加</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface RenderStrategyConfig {&#10;  svgThreshold: number;&#10;  canvasThreshold: number;&#10;  enableMixedMode: boolean;&#10;}&#10;&#10;const selectRenderer = (dataCount: number, config: RenderStrategyConfig): &#39;svg&#39; | &#39;canvas&#39; | &#39;mixed&#39; =&gt; {&#10;  if (dataCount &lt;= config.svgThreshold) return &#39;svg&#39;;&#10;  if (dataCount &gt;= config.canvasThreshold) return &#39;canvas&#39;;&#10;  return config.enableMixedMode ? &#39;mixed&#39; : &#39;canvas&#39;;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RenderStrategyConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  svgThreshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  canvasThreshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  enableMixedMode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> selectRenderer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dataCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RenderStrategyConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'svg'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'canvas'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'mixed'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dataCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.svgThreshold) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'svg'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dataCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.canvasThreshold) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'canvas'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.enableMixedMode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'mixed'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'canvas'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"选型决策框架\">选型决策框架</h2><p>将选型决策系统化为一个可执行的检查流程。</p>\n<table>\n<thead>\n<tr>\n<th>决策因素</th>\n<th>SVG 优先</th>\n<th>Canvas 优先</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>图形元素数量</td>\n<td>&lt; 1,000</td>\n<td>&gt; 5,000</td>\n</tr>\n<tr>\n<td>交互复杂度</td>\n<td>高（每元素交互）</td>\n<td>低（全局交互）</td>\n</tr>\n<tr>\n<td>输出需求</td>\n<td>打印/PDF/矢量</td>\n<td>屏幕显示为主</td>\n</tr>\n<tr>\n<td>动画需求</td>\n<td>CSS 过渡</td>\n<td>60fps 流畅动画</td>\n</tr>\n<tr>\n<td>可访问性</td>\n<td>有要求</td>\n<td>无严格要求</td>\n</tr>\n<tr>\n<td>像素操作</td>\n<td>不需要</td>\n<td>需要（滤镜/图像）</td>\n</tr>\n<tr>\n<td>SEO 需求</td>\n<td>有（内联 SVG）</td>\n<td>无</td>\n</tr>\n<tr>\n<td>开发效率</td>\n<td>优先（DOM 模型熟悉）</td>\n<td>需要更多代码</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((SVG vs Canvas))&#10;    SVG 优势&#10;      DOM 事件原生支持&#10;      CSS 样式集成&#10;      矢量无损缩放&#10;      可访问性&#10;    Canvas 优势&#10;      大数据高性能&#10;      像素级操作&#10;      动画流畅&#10;      内存效率&#10;    混合策略&#10;      分层渲染&#10;      动态切换&#10;      Canvas底层+SVG覆盖&#10;    选型要素&#10;      元素数量&#10;      交互需求&#10;      输出格式&#10;      性能目标\">mindmap\n  root((SVG vs Canvas))\n    SVG 优势\n      DOM 事件原生支持\n      CSS 样式集成\n      矢量无损缩放\n      可访问性\n    Canvas 优势\n      大数据高性能\n      像素级操作\n      动画流畅\n      内存效率\n    混合策略\n      分层渲染\n      动态切换\n      Canvas底层+SVG覆盖\n    选型要素\n      元素数量\n      交互需求\n      输出格式\n      性能目标</pre><ul>\n<li>SVG 和 Canvas 的本质区别在于保留模式 vs 即时模式</li>\n<li>SVG 适合交互密集、元素较少、需要矢量输出的场景</li>\n<li>Canvas 适合大数据量、高帧率动画、像素操作的场景</li>\n<li>混合渲染策略将两者优势结合，是复杂可视化项目的最佳实践</li>\n<li>选型应基于图形元素数量、交互需求和输出格式等因素综合决策</li>\n<li>当不确定时，从 SVG 开始，性能不足时再迁移到 Canvas</li>\n</ul>\n","headings":[{"level":1,"text":"SVG 与 Canvas 对比选型","id":"svg-与-canvas-对比选型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"SVG 的优势场景","id":"svg-的优势场景"},{"level":2,"text":"Canvas 的优势场景","id":"canvas-的优势场景"},{"level":2,"text":"混合渲染策略","id":"混合渲染策略"},{"level":2,"text":"选型决策框架","id":"选型决策框架"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ECharts 实践","url":"/l-doc-books/h/frontend/web3d-visualization/data-visualization/echarts-practice"},"next":{"title":"交互式仪表盘设计","url":"/l-doc-books/h/frontend/web3d-visualization/data-visualization/interactive-dashboard"}}