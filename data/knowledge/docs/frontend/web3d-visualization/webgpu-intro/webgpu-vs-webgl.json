n style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> buffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bindBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(gl.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ARRAY_BUFFER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, buffer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bufferData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(gl.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ARRAY_BUFFER</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, vertices, gl.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">STATIC_DRAW</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> aPosition</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getAttribLocation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(program, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'aPosition'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">enableVertexAttribArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(aPosition);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">vertexAttribPointer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(aPosition, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, gl.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">FLOAT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> aColor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getAttribLocation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(program, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'aColor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">enableVertexAttribArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(aColor);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">vertexAttribPointer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(aColor, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, gl.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">FLOAT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">drawArrays</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(gl.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">TRIANGLES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>WebGPU 实现的关键区别：管线状态预编译、命令录制与提交分离、资源绑定通过 BindGroup。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph WebGL&#10;    A1[设置状态] --&gt; A2[绑定 Buffer]&#10;    A2 --&gt; A3[设置属性]&#10;    A3 --&gt; A4[drawArrays]&#10;    A4 --&gt; A5[驱动验证全部状态]&#10;    end&#10;    subgraph WebGPU&#10;    B1[创建 Pipeline] --&gt; B2[创建 BindGroup]&#10;    B2 --&gt; B3[录制命令]&#10;    B3 --&gt; B4[提交到 Queue]&#10;    B4 --&gt; B5[GPU 直接执行]&#10;    end\">graph TD\n    subgraph WebGL\n    A1[设置状态] --&gt; A2[绑定 Buffer]\n    A2 --&gt; A3[设置属性]\n    A3 --&gt; A4[drawArrays]\n    A4 --&gt; A5[驱动验证全部状态]\n    end\n    subgraph WebGPU\n    B1[创建 Pipeline] --&gt; B2[创建 BindGroup]\n    B2 --&gt; B3[录制命令]\n    B3 --&gt; B4[提交到 Queue]\n    B4 --&gt; B5[GPU 直接执行]\n    end</pre><h2 id=\"性能差异分析\">性能差异分析</h2><p>WebGPU 在多个维度上提供了显著的性能提升。</p>\n<table>\n<thead>\n<tr>\n<th>性能维度</th>\n<th>WebGL</th>\n<th>WebGPU</th>\n<th>提升幅度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Draw Call 开销</td>\n<td>~10μs/call</td>\n<td>~1μs/call</td>\n<td>10x</td>\n</tr>\n<tr>\n<td>状态切换</td>\n<td>每次验证</td>\n<td>预编译管线</td>\n<td>5-20x</td>\n</tr>\n<tr>\n<td>CPU 占用</td>\n<td>高（驱动开销）</td>\n<td>低（薄驱动）</td>\n<td>2-5x</td>\n</tr>\n<tr>\n<td>内存带宽利用</td>\n<td>隐式优化</td>\n<td>显式控制</td>\n<td>1.5-3x</td>\n</tr>\n<tr>\n<td>批处理能力</td>\n<td>手动 instancing</td>\n<td>间接绘制</td>\n<td>3-10x</td>\n</tr>\n<tr>\n<td>计算任务</td>\n<td>不支持/绕行</td>\n<td>原生计算管线</td>\n<td>10-100x</td>\n</tr>\n</tbody></table>\n<p>Draw Call 瓶颈是 WebGL 最大的性能限制。一个典型的 WebGL 应用每帧 draw call 上限约 1000-3000 次，超过后 CPU 成为瓶颈。WebGPU 通过预编译管线和间接绘制，将这一上限提升到 10000-50000 次。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const benchmarkDrawCalls = (api: &#39;webgl&#39; | &#39;webgpu&#39;, objectCount: number) =&gt; {&#10;  const results = {&#10;    webgl: {&#10;      1000: &#39;16ms (60fps)&#39;,&#10;      5000: &#39;45ms (22fps)&#39;,&#10;      10000: &#39;90ms (11fps)&#39;,&#10;    },&#10;    webgpu: {&#10;      1000: &#39;2ms (60fps)&#39;,&#10;      5000: &#39;8ms (60fps)&#39;,&#10;      10000: &#39;16ms (60fps)&#39;,&#10;    },&#10;  };&#10;  return results[api][objectCount as keyof typeof results.webgl];&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> benchmarkDrawCalls</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">api