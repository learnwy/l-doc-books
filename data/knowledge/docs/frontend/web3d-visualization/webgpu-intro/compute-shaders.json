=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(readBuffer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getMappedRange</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  readBuffer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unmap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[创建 Buffer] --&gt; B[创建管线]&#10;    B --&gt; C[创建 BindGroup]&#10;    C --&gt; D[录制命令]&#10;    D --&gt; E[dispatch 分发]&#10;    E --&gt; F[提交执行]&#10;    F --&gt; G[读回结果]\">graph LR\n    A[创建 Buffer] --&gt; B[创建管线]\n    B --&gt; C[创建 BindGroup]\n    C --&gt; D[录制命令]\n    D --&gt; E[dispatch 分发]\n    E --&gt; F[提交执行]\n    F --&gt; G[读回结果]</pre><h2 id=\"工作组与并行模型\">工作组与并行模型</h2><p>理解 WebGPU 的并行执行模型是高效使用计算着色器的关键。</p>\n<table>\n<thead>\n<tr>\n<th>概念</th>\n<th>说明</th>\n<th>类比</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Invocation</td>\n<td>单个着色器实例</td>\n<td>一个线程</td>\n</tr>\n<tr>\n<td>Workgroup</td>\n<td>一组协作的 invocation</td>\n<td>一个线程块</td>\n</tr>\n<tr>\n<td>Dispatch</td>\n<td>启动的工作组总数</td>\n<td>任务分发</td>\n</tr>\n<tr>\n<td>global_invocation_id</td>\n<td>全局唯一线程 ID</td>\n<td>数组下标</td>\n</tr>\n<tr>\n<td>local_invocation_id</td>\n<td>工作组内的线程 ID</td>\n<td>组内下标</td>\n</tr>\n<tr>\n<td>workgroup_id</td>\n<td>工作组 ID</td>\n<td>组号</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const matrixMultiplyShader = `&#10;struct Matrices {&#10;  M: u32,&#10;  N: u32,&#10;  K: u32,&#10;};&#10;&#10;@group(0) @binding(0) var&lt;uniform&gt; dims: Matrices;&#10;@group(0) @binding(1) var&lt;storage, read&gt; matA: array&lt;f32&gt;;&#10;@group(0) @binding(2) var&lt;storage, read&gt; matB: array&lt;f32&gt;;&#10;@group(0) @binding(3) var&lt;storage, read_write&gt; matC: array&lt;f32&gt;;&#10;&#10;@compute @workgroup_size(16, 16)&#10;fn main(@builtin(global_invocation_id) globalId: vec3&lt;u32&gt;) {&#10;  let row = globalId.x;&#10;  let col = globalId.y;&#10;&#10;  if (row &gt;= dims.M || col &gt;= dims.N) {&#10;    return;&#10;  }&#10;&#10;  var sum: f32 = 0.0;&#10;  for (var k: u32 = 0u; k &lt; dims.K; k = k + 1u) {&#10;    sum = sum + matA[row * dims.K + k] * matB[k * dims.N + col];&#10;  }&#10;&#10;  matC[row * dims.N + col] = sum;&#10;}&#10;`;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> matrixMultiplyShader</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">struct Matrices {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  M: u32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  N: u32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  K: u32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(0) var&#x3C;uniform> dims: Matrices;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(1) var&#x3C;storage, read> matA: array&#x3C;f32>;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(2) var&#x3C;storage, read> matB: array&#x3C;f32>;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(3) var&#x3C;storage, read_write> matC: array&#x3C;f32>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@compute @workgroup_size(16, 16)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">fn main(@builtin(global_invocation_id) globalId: vec3&#x3C;u32>) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  let row = globalId.x;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  let col = globalId.y;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  if (row >= dims.M || col >= dims.N) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    return;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  var sum: f32 = 0.0;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  for (var k: u32 = 0u; k &#x3C; dims.K; k = k + 1u) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    sum = sum + matA[row * dims.K + k] * matB[k * dims.N + col];</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  matC[row * dims.N + col] = sum;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p>工作组大小选择的经验法则：</p>\n<ul>\n<li><strong>一维数据处理</strong>（数组操作）：workgroup_size(256) 或 workgroup_size(64)</li>\n<li><strong>二维数据处理</strong>（图像/矩阵）：workgroup_size(16, 16) 或 workgroup_size(8, 8)</li>\n<li><strong>三维数据处理</strong>（体素/体积）：workgroup_size(4, 4, 4)</li>\n<li>总线程数通常保持在 64-256 之间以获得最佳占用率</li>\n</ul>\n<h2 id=\"工作组共享内存\">工作组共享内存</h2><p>共享内存（Shared Memory）是同一工作组内所有线程共享的高速缓存，访问速度比全局内存快 10-100 倍。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const reductionShader = `&#10;var&lt;workgroup&gt; sharedData: array&lt;f32, 256&gt;;&#10;&#10;@group(0) @binding(0) var&lt;storage, read&gt; inputData: array&lt;f32&gt;;&#10;@group(0) @binding(1) var&lt;storage, read_write&gt; outputData: array&lt;f32&gt;;&#10;&#10;@compute @workgroup_size(256)&#10;fn main(&#10;  @builtin(local_invocation_id) localId: vec3&lt;u32&gt;,&#10;  @builtin(workgroup_id) groupId: vec3&lt;u32&gt;,&#10;) {&#10;  let globalIndex = groupId.x * 256u + localId.x;&#10;  sharedData[localId.x] = inputData[globalIndex];&#10;  workgroupBarrier();&#10;&#10;  for (var stride: u32 = 128u; stride &gt; 0u; stride = stride &gt;&gt; 1u) {&#10;    if (localId.x &lt; stride) {&#10;      sharedData[localId.x] = sharedData[localId.x] + sharedData[localId.x + stride];&#10;    }&#10;    workgroupBarrier();&#10;  }&#10;&#10;  if (localId.x == 0u) {&#10;    outputData[groupId.x] = sharedData[0];&#10;  }&#10;}&#10;`;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> reductionShader</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">var&#x3C;workgroup> sharedData: array&#x3C;f32, 256>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(0) var&#x3C;storage, read> inputData: array&#x3C;f32>;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(1) var&#x3C;storage, read_write> outputData: array&#x3C;f32>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@compute @workgroup_size(256)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">fn main(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  @builtin(local_invocation_id) localId: vec3&#x3C;u32>,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  @builtin(workgroup_id) groupId: vec3&#x3C;u32>,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  let globalIndex = groupId.x * 256u + localId.x;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  sharedData[localId.x] = inputData[globalIndex];</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  workgroupBarrier();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  for (var stride: u32 = 128u; stride > 0u; stride = stride >> 1u) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    if (localId.x &#x3C; stride) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      sharedData[localId.x] = sharedData[localId.x] + sharedData[localId.x + stride];</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    workgroupBarrier();</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  if (localId.x == 0u) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    outputData[groupId.x] = sharedData[0];</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><h2 id=\"实际应用场景\">实际应用场景</h2><table>\n<thead>\n<tr>\n<th>应用</th>\n<th>数据规模</th>\n<th>相比 CPU 加速比</th>\n<th>关键技术</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>矩阵乘法</td>\n<td>1024×1024</td>\n<td>10-50x</td>\n<td>分块+共享内存</td>\n</tr>\n<tr>\n<td>粒子系统</td>\n<td>100 万粒子</td>\n<td>100x+</td>\n<td>并行位置更新</td>\n</tr>\n<tr>\n<td>图像模糊</td>\n<td>4K 图像</td>\n<td>20-50x</td>\n<td>分离卷积核</td>\n</tr>\n<tr>\n<td>前缀和</td>\n<td>千万元素</td>\n<td>5-20x</td>\n<td>工作组归约</td>\n</tr>\n<tr>\n<td>排序</td>\n<td>百万元素</td>\n<td>3-10x</td>\n<td>双调排序网络</td>\n</tr>\n<tr>\n<td>神经网络推理</td>\n<td>中型模型</td>\n<td>10-100x</td>\n<td>矩阵运算+激活函数</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((计算着色器))&#10;    编程模型&#10;      工作组&#10;      线程并行&#10;      共享内存&#10;    核心操作&#10;      Buffer 创建&#10;      管线绑定&#10;      Dispatch 分发&#10;    优化策略&#10;      工作组大小&#10;      共享内存利用&#10;      内存合并访问&#10;    应用场景&#10;      矩阵运算&#10;      粒子模拟&#10;      图像处理&#10;      ML 推理\">mindmap\n  root((计算着色器))\n    编程模型\n      工作组\n      线程并行\n      共享内存\n    核心操作\n      Buffer 创建\n      管线绑定\n      Dispatch 分发\n    优化策略\n      工作组大小\n      共享内存利用\n      内存合并访问\n    应用场景\n      矩阵运算\n      粒子模拟\n      图像处理\n      ML 推理</pre><ul>\n<li>计算着色器是 WebGPU 相比 WebGL 最重要的能力提升</li>\n<li>工作组模型将计算任务分解为可协作的线程块</li>\n<li>共享内存提供工作组内的高速数据交换，是性能优化的关键</li>\n<li>工作组大小应根据数据维度和 GPU 架构合理选择</li>\n<li>计算着色器适用于矩阵运算、粒子系统、图像处理和 ML 推理</li>\n<li>GPU 并行计算在数据量达到万级以上时才能体现优势</li>\n</ul>\n","headings":[{"level":1,"text":"计算着色器","id":"计算着色器"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"计算着色器基础","id":"计算着色器基础"},{"level":2,"text":"工作组与并行模型","id":"工作组与并行模型"},{"level":2,"text":"工作组共享内存","id":"工作组共享内存"},{"level":2,"text":"实际应用场景","id":"实际应用场景"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"WebGPU 概览","url":"/l-doc-books/h/frontend/web3d-visualization/webgpu-intro/webgpu-overview"},"next":{"title":"WebGPU 与 WebGL 对比","url":"/l-doc-books/h/frontend/web3d-visualization/webgpu-intro/webgpu-vs-webgl"}}