"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    vertex: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      module: shaderModule,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      entryPoint: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'vs_main'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      buffers: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          arrayStride: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Float32Array.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">BYTES_PER_ELEMENT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          attributes: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            { shaderLocation: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, offset: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, format: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'float32x2'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            { shaderLocation: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, offset: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Float32Array.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">BYTES_PER_ELEMENT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, format: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'float32x3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fragment: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      module: shaderModule,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      entryPoint: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'fs_main'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      targets: [{ format }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    primitive: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      topology: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'triangle-list'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((WebGPU 概览))&#10;    核心特性&#10;      显式资源管理&#10;      管线状态对象&#10;      计算着色器&#10;      多线程渲染&#10;    对象模型&#10;      Adapter → Device&#10;      Buffer/Texture&#10;      Pipeline&#10;      CommandEncoder&#10;    WGSL 着色器&#10;      类型安全&#10;      属性标注&#10;      入口点函数&#10;    与 WebGL 对比&#10;      性能更可预测&#10;      控制更精细&#10;      支持 GPGPU\">mindmap\n  root((WebGPU 概览))\n    核心特性\n      显式资源管理\n      管线状态对象\n      计算着色器\n      多线程渲染\n    对象模型\n      Adapter → Device\n      Buffer/Texture\n      Pipeline\n      CommandEncoder\n    WGSL 着色器\n      类型安全\n      属性标注\n      入口点函数\n    与 WebGL 对比\n      性能更可预测\n      控制更精细\n      支持 GPGPU</pre><ul>\n<li>WebGPU 是下一代 Web 图形和计算 API，基于现代 GPU API 设计理念</li>\n<li>显式控制是核心原则：资源管理、管线状态、命令录制都由开发者显式操作</li>\n<li>WGSL 是 WebGPU 专用着色器语言，类型安全且与 WebGPU 资源模型紧密集成</li>\n<li>渲染管线是不可变的预编译对象，消除了运行时状态变更的性能开销</li>\n<li>WebGPU 原生支持计算着色器，为 GPGPU 应用打开浏览器端大门</li>\n<li>目前 Chrome 和 Edge 已稳定支持，Firefox 处于实验阶段</li>\n</ul>\n","headings":[{"level":1,"text":"WebGPU 概览","id":"webgpu-概览"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心架构与对象模型","id":"核心架构与对象模型"},{"level":2,"text":"WGSL 着色器语言","id":"wgsl-着色器语言"},{"level":2,"text":"渲染管线构建","id":"渲染管线构建"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Canvas 游戏渲染","url":"/l-doc-books/h/frontend/web3d-visualization/canvas-svg-advanced/canvas-game-rendering"},"next":{"title":"计算着色器","url":"/l-doc-books/h/frontend/web3d-visualization/webgpu-intro/compute-shaders"}}