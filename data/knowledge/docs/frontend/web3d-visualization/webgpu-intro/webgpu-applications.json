er = `&#10;struct Particle {&#10;  position: vec2&lt;f32&gt;,&#10;  velocity: vec2&lt;f32&gt;,&#10;  life: f32,&#10;  padding: f32,&#10;};&#10;&#10;struct SimParams {&#10;  deltaTime: f32,&#10;  gravity: f32,&#10;  damping: f32,&#10;  particleCount: u32,&#10;};&#10;&#10;@group(0) @binding(0) var&lt;uniform&gt; params: SimParams;&#10;@group(0) @binding(1) var&lt;storage, read_write&gt; particles: array&lt;Particle&gt;;&#10;&#10;@compute @workgroup_size(256)&#10;fn main(@builtin(global_invocation_id) id: vec3&lt;u32&gt;) {&#10;  let index = id.x;&#10;  if (index &gt;= params.particleCount) { return; }&#10;&#10;  var p = particles[index];&#10;&#10;  p.velocity.y -= params.gravity * params.deltaTime;&#10;  p.velocity *= params.damping;&#10;  p.position += p.velocity * params.deltaTime;&#10;  p.life -= params.deltaTime;&#10;&#10;  if (p.position.y &lt; -1.0) {&#10;    p.position.y = -1.0;&#10;    p.velocity.y *= -0.6;&#10;  }&#10;  if (p.position.x &lt; -1.0 || p.position.x &gt; 1.0) {&#10;    p.velocity.x *= -1.0;&#10;  }&#10;&#10;  particles[index] = p;&#10;}&#10;`;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> particleComputeShader</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">struct Particle {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  position: vec2&#x3C;f32>,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  velocity: vec2&#x3C;f32>,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  life: f32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  padding: f32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">struct SimParams {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  deltaTime: f32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  gravity: f32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  damping: f32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  particleCount: u32,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(0) var&#x3C;uniform> params: SimParams;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(1) var&#x3C;storage, read_write> particles: array&#x3C;Particle>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@compute @workgroup_size(256)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">fn main(@builtin(global_invocation_id) id: vec3&#x3C;u32>) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  let index = id.x;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  if (index >= params.particleCount) { return; }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  var p = particles[index];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  p.velocity.y -= params.gravity * params.deltaTime;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  p.velocity *= params.damping;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  p.position += p.velocity * params.deltaTime;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  p.life -= params.deltaTime;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  if (p.position.y &#x3C; -1.0) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    p.position.y = -1.0;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    p.velocity.y *= -0.6;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  if (p.position.x &#x3C; -1.0 || p.position.x > 1.0) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    p.velocity.x *= -1.0;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  particles[index] = p;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[每帧更新] --&gt; B[计算 Pass]&#10;    B --&gt; C[更新粒子位置]&#10;    B --&gt; D[碰撞检测]&#10;    B --&gt; E[生命周期管理]&#10;    A --&gt; F[渲染 Pass]&#10;    F --&gt; G[读取粒子数据]&#10;    F --&gt; H[点精灵渲染]&#10;    C --&gt; F&#10;    D --&gt; F&#10;    E --&gt; F\">graph LR\n    A[每帧更新] --&gt; B[计算 Pass]\n    B --&gt; C[更新粒子位置]\n    B --&gt; D[碰撞检测]\n    B --&gt; E[生命周期管理]\n    A --&gt; F[渲染 Pass]\n    F --&gt; G[读取粒子数据]\n    F --&gt; H[点精灵渲染]\n    C --&gt; F\n    D --&gt; F\n    E --&gt; F</pre><table>\n<thead>\n<tr>\n<th>粒子规模</th>\n<th>CPU (JS)</th>\n<th>WebGL (hack)</th>\n<th>WebGPU 计算</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>10,000</td>\n<td>16ms ✓</td>\n<td>8ms ✓</td>\n<td>0.5ms ✓</td>\n</tr>\n<tr>\n<td>100,000</td>\n<td>160ms ✗</td>\n<td>40ms ✗</td>\n<td>2ms ✓</td>\n</tr>\n<tr>\n<td>1,000,000</td>\n<td>不可行</td>\n<td>不可行</td>\n<td>8ms ✓</td>\n</tr>\n</tbody></table>\n<h2 id=\"浏览器端-ml-推理\">浏览器端 ML 推理</h2><p>WebGPU 为浏览器端机器学习推理提供了原生加速能力，多个主流框架已支持 WebGPU 后端。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface TensorBuffer {&#10;  buffer: GPUBuffer;&#10;  shape: number[];&#10;  dtype: &#39;float32&#39; | &#39;float16&#39;;&#10;}&#10;&#10;const createTensorBuffer = (device: GPUDevice, data: Float32Array, shape: number[]): TensorBuffer =&gt; {&#10;  const buffer = device.createBuffer({&#10;    size: data.byteLength,&#10;    usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST | GPUBufferUsage.COPY_SRC,&#10;  });&#10;  device.queue.writeBuffer(buffer, 0, data);&#10;  return { buffer, shape, dtype: &#39;float32&#39; };&#10;};&#10;&#10;const reluShader = `&#10;@group(0) @binding(0) var&lt;storage, read_write&gt; data: array&lt;f32&gt;;&#10;&#10;@compute @workgroup_size(256)&#10;fn main(@builtin(global_invocation_id) id: vec3&lt;u32&gt;) {&#10;  let index = id.x;&#10;  if (index &gt;= arrayLength(&amp;data)) { return; }&#10;  data[index] = max(data[index], 0.0);&#10;}&#10;`;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TensorBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  buffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GPUBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  shape</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  dtype</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'float32'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'float16'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createTensorBuffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">device</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GPUDevice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">shape</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TensorBuffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> buffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> device.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    size: data.byteLength,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    usage: GPUBufferUsage.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">STORAGE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GPUBufferUsage.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">COPY_DST</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GPUBufferUsage.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">COPY_SRC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  device.queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">writeBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(buffer, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, data);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { buffer, shape, dtype: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'float32'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> reluShader</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@group(0) @binding(0) var&#x3C;storage, read_write> data: array&#x3C;f32>;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">@compute @workgroup_size(256)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">fn main(@builtin(global_invocation_id) id: vec3&#x3C;u32>) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  let index = id.x;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  if (index >= arrayLength(&#x26;data)) { return; }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  data[index] = max(data[index], 0.0);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p>支持 WebGPU 的 ML 框架：</p>\n<table>\n<thead>\n<tr>\n<th>框架</th>\n<th>WebGPU 支持</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ONNX Runtime Web</td>\n<td>稳定</td>\n<td>通用模型推理</td>\n</tr>\n<tr>\n<td>TensorFlow.js</td>\n<td>稳定</td>\n<td>TF 模型生态</td>\n</tr>\n<tr>\n<td>Transformers.js</td>\n<td>支持</td>\n<td>NLP/LLM 推理</td>\n</tr>\n<tr>\n<td>WebLLM</td>\n<td>原生</td>\n<td>浏览器端 LLM</td>\n</tr>\n</tbody></table>\n<h2 id=\"性能调优实践\">性能调优实践</h2><table>\n<thead>\n<tr>\n<th>优化策略</th>\n<th>效果</th>\n<th>实现要点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>减少 Buffer 拷贝</td>\n<td>降低内存带宽</td>\n<td>GPU 内直接计算，避免 CPU 回读</td>\n</tr>\n<tr>\n<td>管线缓存</td>\n<td>消除重复编译</td>\n<td>预创建并复用 Pipeline 对象</td>\n</tr>\n<tr>\n<td>命令批量提交</td>\n<td>减少提交开销</td>\n<td>合并多个操作到一个 CommandBuffer</td>\n</tr>\n<tr>\n<td>适配工作组大小</td>\n<td>提升 GPU 占用率</td>\n<td>根据 GPU 型号调优</td>\n</tr>\n<tr>\n<td>双缓冲</td>\n<td>消除管线气泡</td>\n<td>计算和渲染交替使用不同 Buffer</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((WebGPU 应用))&#10;    数据可视化&#10;      百万级点渲染&#10;      实时交互&#10;      GPU 聚合&#10;    粒子系统&#10;      百万粒子&#10;      计算着色器&#10;      物理模拟&#10;    ML 推理&#10;      ONNX Runtime&#10;      TensorFlow.js&#10;      浏览器端 LLM&#10;    性能调优&#10;      Buffer 复用&#10;      管线缓存&#10;      命令批量&#10;    生态发展&#10;      Three.js 适配&#10;      框架支持&#10;      标准演进\">mindmap\n  root((WebGPU 应用))\n    数据可视化\n      百万级点渲染\n      实时交互\n      GPU 聚合\n    粒子系统\n      百万粒子\n      计算着色器\n      物理模拟\n    ML 推理\n      ONNX Runtime\n      TensorFlow.js\n      浏览器端 LLM\n    性能调优\n      Buffer 复用\n      管线缓存\n      命令批量\n    生态发展\n      Three.js 适配\n      框架支持\n      标准演进</pre><ul>\n<li>WebGPU 的应用范围从图形渲染扩展到科学计算、ML 推理和大数据处理</li>\n<li>百万级数据可视化是 WebGPU 的标志性应用，远超 WebGL 的能力边界</li>\n<li>GPU 粒子系统通过计算着色器实现百万粒子的实时模拟</li>\n<li>浏览器端 ML 推理借助 WebGPU 获得 10-100 倍加速</li>\n<li>性能调优的核心是减少 CPU-GPU 数据传输和管线状态切换</li>\n<li>WebGPU 正在成为高性能 Web 应用的基础设施</li>\n</ul>\n","headings":[{"level":1,"text":"WebGPU 应用实践","id":"webgpu-应用实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"大规模数据可视化","id":"大规模数据可视化"},{"level":2,"text":"GPU 粒子系统","id":"gpu-粒子系统"},{"level":2,"text":"浏览器端 ML 推理","id":"浏览器端-ml-推理"},{"level":2,"text":"性能调优实践","id":"性能调优实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"WebGPU 与 WebGL 对比","url":"/l-doc-books/h/frontend/web3d-visualization/webgpu-intro/webgpu-vs-webgl"},"next":null}