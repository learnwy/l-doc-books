pan><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (t.id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">t, done: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t)), { id: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, text: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'New todo'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }];</span></span></code></pre></div><h3 id=\"2-immer-推荐\">2. Immer (推荐)</h3><p>Immer 让你用可变的写法，得到不可变的结果。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { produce } from &#39;immer&#39;;&#10;&#10;const state = { count: 0, todos: [] };&#10;&#10;const newState = produce(state, (draft) =&gt; {&#10;  // 可以直接修改 draft！&#10;  draft.count++;&#10;  draft.todos.push({ text: &#39;Learn Immer&#39; });&#10;});&#10;&#10;// state 没变，newState 是新的！&#10;console.log(state.count); // 0&#10;console.log(newState.count); // 1\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { produce } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'immer'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { count: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, todos: [] };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> newState</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> produce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(state, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">draft</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 可以直接修改 draft！</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  draft.count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  draft.todos.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ text: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Learn Immer'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// state 没变，newState 是新的！</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(state.count); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 0</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(newState.count); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1</span></span></code></pre></div><p><strong>优点</strong>:</p>\n<ul>\n<li>代码简洁</li>\n<li>不需要展开操作</li>\n<li>处理嵌套简单</li>\n<li>性能好（结构共享）</li>\n</ul>\n<h3 id=\"3-不可变数据库\">3. 不可变数据库</h3><ul>\n<li><strong>Immer</strong>: 最流行，最简单</li>\n<li><strong>Immutable.js</strong>: Facebook 的库，API 复杂</li>\n<li><strong>Immer</strong> 是目前的最佳选择</li>\n</ul>\n<h2 id=\"redux-与不可变\">Redux 与不可变</h2><p>Redux <strong>要求</strong> reducer 是纯函数，不可变。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// ✅ 好：不可变&#10;function counterReducer(state = { count: 0 }, action) {&#10;  switch (action.type) {&#10;    case &#39;increment&#39;:&#10;      return { ...state, count: state.count + 1 };&#10;    default:&#10;      return state;&#10;  }&#10;}&#10;&#10;// ❌ 坏：可变&#10;function badCounterReducer(state = { count: 0 }, action) {&#10;  switch (action.type) {&#10;    case &#39;increment&#39;:&#10;      state.count++; // ❌ 直接修改！&#10;      return state;&#10;    default:&#10;      return state;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ 好：不可变</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> counterReducer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { count: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  switch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (action.type) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'increment'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">state, count: state.count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> state;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ❌ 坏：可变</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> badCounterReducer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { count: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  switch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (action.type) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'increment'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      state.count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ❌ 直接修改！</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> state;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> state;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"什么时候用哪个\">什么时候用哪个</h2><h3 id=\"优先不可变的场景\">优先不可变的场景</h3><p>✅ <strong>用不可变</strong>:</p>\n<ul>\n<li>React 应用</li>\n<li>Redux/Zustand 等状态管理</li>\n<li>需要时间旅行调试</li>\n<li>团队协作（避免副作用）</li>\n<li>需要可预测性</li>\n</ul>\n<h3 id=\"可以可变的场景\">可以可变的场景</h3><p>✅ <strong>用可变</strong>:</p>\n<ul>\n<li>局部变量，不会泄露</li>\n<li>性能极高的场景（如游戏循环）</li>\n<li>简单的脚本</li>\n<li>使用 Immer（写起来像可变，实际不可变）</li>\n</ul>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((不可变 vs 可变))&#10;    不可变&#10;      创建新对象&#10;      保留历史&#10;      浅比较优化&#10;      Redux / React&#10;    可变&#10;      直接修改&#10;      代码简洁&#10;      需要 Proxy 追踪&#10;      MobX / Valtio&#10;    Immer&#10;      写可变语法&#10;      产出不可变结果&#10;      最佳实践\">mindmap\n  root((不可变 vs 可变))\n    不可变\n      创建新对象\n      保留历史\n      浅比较优化\n      Redux / React\n    可变\n      直接修改\n      代码简洁\n      需要 Proxy 追踪\n      MobX / Valtio\n    Immer\n      写可变语法\n      产出不可变结果\n      最佳实践</pre><ul>\n<li>不可变带来可预测性、可调试性和性能优化</li>\n<li>Immer 是最佳实践：写起来像可变，结果是不可变</li>\n<li>MobX/Valtio 使用 Proxy 让可变也变得可追踪</li>\n</ul>\n<p><strong>核心要点回顾：</strong></p>\n<ul>\n<li>可变直接修改原对象，不可变创建新对象</li>\n<li>不可变让代码更可预测、更易调试</li>\n<li>React 和 Redux 推荐不可变</li>\n<li>Immer 让不可变变得简单</li>\n<li>优先用不可变，特别是在 React 应用中</li>\n</ul>\n","headings":[{"level":1,"text":"不可变 vs 可变","id":"不可变-vs-可变"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"定义","id":"定义"},{"level":3,"text":"可变 (Mutable)","id":"可变-mutable"},{"level":3,"text":"不可变 (Immutable)","id":"不可变-immutable"},{"level":2,"text":"对比","id":"对比"},{"level":3,"text":"代码对比","id":"代码对比"},{"level":4,"text":"可变方式","id":"可变方式"},{"level":4,"text":"不可变方式","id":"不可变方式"},{"level":3,"text":"优缺点对比","id":"优缺点对比"},{"level":2,"text":"不可变的好处","id":"不可变的好处"},{"level":3,"text":"1. 可预测性","id":"1-可预测性"},{"level":3,"text":"2. 时间旅行调试","id":"2-时间旅行调试"},{"level":3,"text":"3. React 性能优化","id":"3-react-性能优化"},{"level":3,"text":"4. 变更追踪简单","id":"4-变更追踪简单"},{"level":2,"text":"不可变的实现方式","id":"不可变的实现方式"},{"level":3,"text":"1. 手动实现（对象展开）","id":"1-手动实现-对象展开"},{"level":3,"text":"2. Immer (推荐)","id":"2-immer-推荐"},{"level":3,"text":"3. 不可变数据库","id":"3-不可变数据库"},{"level":2,"text":"Redux 与不可变","id":"redux-与不可变"},{"level":2,"text":"什么时候用哪个","id":"什么时候用哪个"},{"level":3,"text":"优先不可变的场景","id":"优先不可变的场景"},{"level":3,"text":"可以可变的场景","id":"可以可变的场景"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"响应式模型","url":"/l-doc-books/h/frontend/state-management-patterns/fundamentals/reactivity-models"},"next":{"title":"组件状态模式","url":"/l-doc-books/h/frontend/state-management-patterns/local-state/component-state-patterns"}}