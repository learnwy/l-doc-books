k=&quot;counter.increment&quot;&gt;+&lt;/button&gt;&#10;    &lt;button @click=&quot;counter.decrement&quot;&gt;-&lt;/button&gt;&#10;    &lt;button @click=&quot;counter.reset&quot;&gt;Reset&lt;/button&gt;&#10;  &lt;/div&gt;&#10;&lt;/template&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>&#x3C;script setup lang=\"ts\"></span></span>\n<span class=\"line\"><span>import { useCounterStore } from './store';</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>const counter = useCounterStore();</span></span>\n<span class=\"line\"><span>&#x3C;/script></span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>&#x3C;template></span></span>\n<span class=\"line\"><span>  &#x3C;div></span></span>\n<span class=\"line\"><span>    &#x3C;p>Count: {{ counter.count }}&#x3C;/p></span></span>\n<span class=\"line\"><span>    &#x3C;p>Double: {{ counter.doubleCount }}&#x3C;/p></span></span>\n<span class=\"line\"><span>    &#x3C;p>Double + 1: {{ counter.doubleCountPlusOne }}&#x3C;/p></span></span>\n<span class=\"line\"><span>    &#x3C;button @click=\"counter.increment\">+&#x3C;/button></span></span>\n<span class=\"line\"><span>    &#x3C;button @click=\"counter.decrement\">-&#x3C;/button></span></span>\n<span class=\"line\"><span>    &#x3C;button @click=\"counter.reset\">Reset&#x3C;/button></span></span>\n<span class=\"line\"><span>  &#x3C;/div></span></span>\n<span class=\"line\"><span>&#x3C;/template></span></span></code></pre></div><h2 id=\"setup-store\">Setup Store</h2><h3 id=\"更现代的写法\">更现代的写法</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { defineStore } from &#39;pinia&#39;;&#10;import { ref, computed } from &#39;vue&#39;;&#10;&#10;export const useCounterStore = defineStore(&#39;counter&#39;, () =&gt; {&#10;  const count = ref(0);&#10;  const doubleCount = computed(() =&gt; count.value * 2);&#10;&#10;  function increment() {&#10;    count.value++;&#10;  }&#10;&#10;  function decrement() {&#10;    count.value--;&#10;  }&#10;&#10;  function reset() {&#10;    count.value = 0;&#10;  }&#10;&#10;  return {&#10;    count,&#10;    doubleCount,&#10;    increment,&#10;    decrement,&#10;    reset,&#10;  };&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { defineStore } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pinia'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ref, computed } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vue'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> useCounterStore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineStore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'counter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color: