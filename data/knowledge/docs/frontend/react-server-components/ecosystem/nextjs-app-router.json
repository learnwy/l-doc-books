 &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Pagination current</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{page} total</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{Math.ceil(total / </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"middleware-与请求拦截\">Middleware 与请求拦截</h2><p>Next.js Middleware 在边缘节点执行，在路由处理之前拦截请求。用于认证检查、重定向、请求改写、A/B 测试分桶等：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// middleware.ts（项目根目录）&#10;import { NextResponse } from &#39;next/server&#39;;&#10;import type { NextRequest } from &#39;next/server&#39;;&#10;&#10;export function middleware(request: NextRequest) {&#10;  const session = request.cookies.get(&#39;session&#39;);&#10;&#10;  // 未登录用户访问受保护路由时重定向&#10;  if (request.nextUrl.pathname.startsWith(&#39;/dashboard&#39;) &amp;&amp; !session) {&#10;    return NextResponse.redirect(new URL(&#39;/login&#39;, request.url));&#10;  }&#10;&#10;  // A/B 测试：根据 cookie 决定展示版本&#10;  if (request.nextUrl.pathname === &#39;/pricing&#39;) {&#10;    const variant = request.cookies.get(&#39;ab-pricing&#39;)?.value ?? &#39;control&#39;;&#10;    return NextResponse.rewrite(new URL(`/pricing/${variant}`, request.url));&#10;  }&#10;&#10;  return NextResponse.next();&#10;}&#10;&#10;export const config = {&#10;  matcher: [&#39;/dashboard/:path*&#39;, &#39;/pricing&#39;],&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// middleware.ts（项目根目录）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { NextResponse } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'next/server'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { NextRequest } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'next/server'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> middleware</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">request</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NextRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> session</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> request.cookies.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'session'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 未登录用户访问受保护路由时重定向</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (request.nextUrl.pathname.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">startsWith</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/dashboard'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">session) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NextResponse.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">redirect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> URL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/login'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, request.url));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // A/B 测试：根据 cookie 决定展示版本</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (request.nextUrl.pathname </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '/pricing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> variant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> request.cookies.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ab-pricing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)?.value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'control'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NextResponse.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rewrite</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> URL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`/pricing/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">variant</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, request.url));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NextResponse.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  matcher: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/dashboard/:path*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/pricing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"与-react-router-rsc-方案的对比\">与 React Router RSC 方案的对比</h2><p>2026 年，React Router 推出了实验性 RSC 支持，扩展了 RSC 的框架选择空间：</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Next.js App Router</th>\n<th>React Router RSC (实验性)</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>成熟度</td>\n<td>生产就绪（2+ 年）</td>\n<td>实验性（Breaking Changes 可能）</td>\n</tr>\n<tr>\n<td>路由方式</td>\n<td>文件系统路由</td>\n<td>配置式路由（<code>routes.ts</code>）</td>\n</tr>\n<tr>\n<td>数据获取</td>\n<td>组件内 async/await</td>\n<td>Loader + Server Components</td>\n</tr>\n<tr>\n<td>缓存</td>\n<td>内置多层缓存</td>\n<td>需自行配置</td>\n</tr>\n<tr>\n<td>部署</td>\n<td>Vercel 原生 + 自托管</td>\n<td>框架无关</td>\n</tr>\n<tr>\n<td>Server Actions</td>\n<td>原生支持</td>\n<td>通过 Server Functions 支持</td>\n</tr>\n<tr>\n<td>流式渲染</td>\n<td>自动</td>\n<td>需手动配置 Vite 插件</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>中等（约定多）</td>\n<td>较低（沿用 RR 概念）</td>\n</tr>\n</tbody></table>\n<p>对于新项目，Next.js App Router 仍然是 RSC 最成熟、文档最完善的选择。React Router RSC 适合已有 React Router 项目希望增量引入 RSC 能力的场景。</p>\n<h2 id=\"小结\">小结</h2><p>Next.js App Router 围绕 RSC 架构提供了完整的工程基础设施：文件系统路由定义页面结构、嵌套布局保持跨导航 UI 状态、特殊文件（loading/error/not-found）处理加载和异常、路由组和平行路由组织复杂应用布局。数据获取直接在 Server Components 中 <code>async/await</code>，Middleware 在边缘拦截请求处理鉴权和重定向。App Router 是 2026 年 RSC 落地的首选框架，React Router RSC 作为替代方案适合特定场景。</p>\n<hr>\n<blockquote>\n<p><strong>相关文档</strong>：<a href=\"testing-debugging\">测试与调试策略</a> 讲解如何在 App Router 的 Server/Client 分离环境下设计测试方案</p>\n</blockquote>\n","headings":[{"level":1,"text":"Next.js App Router 架构与实践","id":"next-js-app-router-架构与实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"文件系统路由与特殊文件约定","id":"文件系统路由与特殊文件约定"},{"level":2,"text":"布局嵌套与状态保持","id":"布局嵌套与状态保持"},{"level":2,"text":"路由组与平行路由","id":"路由组与平行路由"},{"level":2,"text":"数据获取模式在 App Router 中的实践","id":"数据获取模式在-app-router-中的实践"},{"level":2,"text":"Middleware 与请求拦截","id":"middleware-与请求拦截"},{"level":2,"text":"与 React Router RSC 方案的对比","id":"与-react-router-rsc-方案的对比"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"边缘渲染与部署拓扑","url":"/l-doc-books/h/frontend/react-server-components/performance/edge-rendering"},"next":{"title":"RSC 测试与调试策略","url":"/l-doc-books/h/frontend/react-server-components/ecosystem/testing-debugging"}}