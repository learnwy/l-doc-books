/span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 动态部分：请求时在边缘渲染，流式注入 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{&#x3C;PriceSkeleton />}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LivePrice productId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{id} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{&#x3C;StockSkeleton />}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">StockStatus productId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{id} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>PPR 的时间线对比：</p>\n<table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>传统动态 SSR</th>\n<th>PPR</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>TTFB</td>\n<td>200-500ms（等待 Origin）</td>\n<td>&lt;50ms（CDN 边缘响应静态壳）</td>\n</tr>\n<tr>\n<td>FCP</td>\n<td>300-800ms</td>\n<td>&lt;100ms（静态内容立即可见）</td>\n</tr>\n<tr>\n<td>动态内容就绪</td>\n<td>200-500ms</td>\n<td>100-300ms（边缘并行获取）</td>\n</tr>\n<tr>\n<td>总感知延迟</td>\n<td>500-1000ms</td>\n<td>&lt;100ms（骨架屏即时，内容快速填充）</td>\n</tr>\n</tbody></table>\n<h2 id=\"边缘数据访问策略\">边缘数据访问策略</h2><p>边缘环境最大的挑战是数据访问——传统数据库通常部署在单一区域，边缘节点访问它需要跨区域网络延迟。以下策略按延迟从低到高排列：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 策略 1：边缘 KV 存储（最快，~1ms）&#10;// 适合：配置、Feature Flags、会话数据&#10;import { kv } from &#39;@vercel/kv&#39;; // 或 Cloudflare KV&#10;&#10;export const runtime = &#39;edge&#39;;&#10;&#10;async function getFeatureFlags(userId: string) {&#10;  const flags = await kv.hgetall(`flags:${userId}`);&#10;  return flags ?? getDefaultFlags();&#10;}&#10;&#10;// 策略 2：全球分布式数据库 HTTP 接口（30-100ms）&#10;// 适合：读密集型应用数据&#10;// Neon Serverless / PlanetScale / Turso 提供 HTTP 查询接口&#10;import { neon } from &#39;@neondatabase/serverless&#39;;&#10;&#10;export const runtime = &#39;edge&#39;;&#10;&#10;async function getProducts(category: string) {&#10;  const sql = neon(process.env.DATABASE_URL!);&#10;  const products = await sql`&#10;    SELECT id, name, price FROM products &#10;    WHERE category = ${category} &#10;    LIMIT 20&#10;  `;&#10;  return products;&#10;}&#10;&#10;// 策略 3：缓存 + 回源（首次 200ms+，后续 &lt;5ms）&#10;// 适合：不频繁变更的数据&#10;async function getCachedContent(slug: string) {&#10;  const cached = await cacheStore.get(`content:${slug}`);&#10;  if (cached) return cached;&#10;&#10;  const fresh = await originApi.getContent(slug);&#10;  await cacheStore.set(`content:${slug}`, fresh, { ttl: 3600 });&#10;  return fresh;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 策略 1：边缘 KV 存储（最快，~1ms）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 适合：配置、Feature Flags、会话数据</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kv } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@vercel/kv'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 或 Cloudflare KV</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> runtime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'edge'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getFeatureFlags</span><span style=\"c