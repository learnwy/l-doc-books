le=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sql</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    SELECT id, name, price FROM products </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    WHERE category = ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">category</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    LIMIT 20</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  `</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> products;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 策略 3：缓存 + 回源（首次 200ms+，后续 &#x3C;5ms）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 适合：不频繁变更的数据</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCachedContent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">slug</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cached</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cacheStore.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`content:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">slug</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (cached) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cached;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> fresh</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> originApi.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getContent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(slug);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cacheStore.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`content:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">slug</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, fresh, { ttl: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3600</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fresh;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"部署拓扑设计\">部署拓扑设计</h2><p>根据应用特征选择合适的部署拓扑：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph &quot;拓扑 A:纯边缘&quot;&#10;        A1[用户] --&gt; B1[边缘节点]&#10;        B1 --&gt; C1[边缘 KV/Cache]&#10;        B1 --&gt; D1[HTTP 数据库]&#10;    end&#10;&#10;    subgraph &quot;拓扑 B:混合(推荐)&quot;&#10;        A2[用户] --&gt; B2[边缘节点 - 静态+轻量动态]&#10;        B2 --&gt; C2[CDN Cache]&#10;        B2 --&gt; D2[Origin Server - 重计算]&#10;        D2 --&gt; E2[数据库集群]&#10;    end&#10;&#10;    subgraph &quot;拓扑 C:多区域 Origin&quot;&#10;        A3[用户] --&gt; B3[最近区域的 Origin]&#10;        B3 --&gt; C3[区域数据库副本]&#10;        C3 -.-&gt;|异步复制| D3[主数据库]&#10;    end\">flowchart TD\n    subgraph \"拓扑 A:纯边缘\"\n        A1[用户] --&gt; B1[边缘节点]\n        B1 --&gt; C1[边缘 KV/Cache]\n        B1 --&gt; D1[HTTP 数据库]\n    end\n\n    subgraph \"拓扑 B:混合(推荐)\"\n        A2[用户] --&gt; B2[边缘节点 - 静态+轻量动态]\n        B2 --&gt; C2[CDN Cache]\n        B2 --&gt; D2[Origin Server - 重计算]\n        D2 --&gt; E2[数据库集群]\n    end\n\n    subgraph \"拓扑 C:多区域 Origin\"\n        A3[用户] --&gt; B3[最近区域的 Origin]\n        B3 --&gt; C3[区域数据库副本]\n        C3 -.-&gt;|异步复制| D3[主数据库]\n    end</pre><table>\n<thead>\n<tr>\n<th>拓扑</th>\n<th>适用场景</th>\n<th>延迟特征</th>\n<th>复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>纯边缘</td>\n<td>内容站、营销页、边缘 API</td>\n<td>全球 &lt;50ms</td>\n<td>低</td>\n</tr>\n<tr>\n<td>混合</td>\n<td>大多数 Web 应用</td>\n<td>静态 &lt;50ms，动态 100-300ms</td>\n<td>中</td>\n</tr>\n<tr>\n<td>多区域 Origin</td>\n<td>数据密集型应用</td>\n<td>全球 50-100ms</td>\n<td>高</td>\n</tr>\n</tbody></table>\n<h2 id=\"边缘渲染的限制与回退\">边缘渲染的限制与回退</h2><p>并非所有 Server Components 都适合在边缘运行。以下场景应保持 Node.js Runtime：</p>\n<ul>\n<li><strong>依赖 Node.js 原生模块的 ORM</strong>（Prisma with binary engine）</li>\n<li><strong>需要文件系统访问</strong>（PDF 生成、图片处理）</li>\n<li><strong>长时间运行的任务</strong>（超过边缘执行时间限制）</li>\n<li><strong>需要大量内存</strong>（处理大文件、复杂计算）</li>\n<li><strong>需要持久化连接池</strong>（WebSocket 网关、数据库连接池）</li>\n</ul>\n<p>正确的策略是按路由粒度选择运行时——让大部分只做数据展示的页面在边缘运行（快速响应），让少数需要完整 Node.js 能力的管理后台或复杂操作在 Origin Server 运行（功能完整）。</p>\n<h2 id=\"小结\">小结</h2><p>边缘渲染将 RSC 的执行推向用户最近的节点，消除物理距离造成的延迟。适合边缘的场景是无状态的内容展示和轻量动态渲染；需要完整 Node.js 能力（原生模块、文件系统、连接池）的操作保留在 Origin。PPR 是 RSC + 边缘的最优形态：静态壳 CDN 即时响应 + 动态部分边缘流式填充。选择混合部署拓扑，按路由的运行时需求分配到 Edge 或 Node.js，是兼顾全球低延迟和功能完整性的务实策略。</p>\n<hr>\n<blockquote>\n<p><strong>相关文档</strong>：<a href=\"bundle-splitting\">Bundle 拆分与代码消除</a> 讲解了客户端层面的性能优化——减少发送到浏览器的代码量</p>\n</blockquote>\n","headings":[{"level":1,"text":"边缘渲染与部署拓扑","id":"边缘渲染与部署拓扑"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"边缘运行时与 Node.js 运行时的差异","id":"边缘运行时与-node-js-运行时的差异"},{"level":2,"text":"Next.js 中的边缘渲染配置","id":"next-js-中的边缘渲染配置"},{"level":2,"text":"Partial Prerendering（PPR）与边缘协作","id":"partial-prerendering-ppr-与边缘协作"},{"level":2,"text":"边缘数据访问策略","id":"边缘数据访问策略"},{"level":2,"text":"部署拓扑设计","id":"部署拓扑设计"},{"level":2,"text":"边缘渲染的限制与回退","id":"边缘渲染的限制与回退"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"缓存策略与再验证机制","url":"/l-doc-books/h/frontend/react-server-components/performance/caching-revalidation"},"next":{"title":"Next.js App Router 架构与实践","url":"/l-doc-books/h/frontend/react-server-components/ecosystem/nextjs-app-router"}}