E1E4E8\">={</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">={</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} />)}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">section</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>&#39;use cache&#39;</code> 与 <code>cacheLife</code> 配合控制缓存生命周期：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { cacheLife } from &#39;next/cache&#39;;&#10;&#10;async function getExchangeRates() {&#10;  &#39;use cache&#39;;&#10;  cacheLife(&#39;minutes&#39;); // 预定义的缓存生命周期配置&#10;&#10;  const rates = await fetch(&#39;https://api.exchange.com/rates&#39;);&#10;  return rates.json();&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { cacheLife } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'next/cache'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getExchangeRates</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'use cache'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  cacheLife</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'minutes'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 预定义的缓存生命周期配置</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rates</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'https://api.exchange.com/rates'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rates.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"再验证策略\">再验证策略</h2><p>缓存的价值在于它最终会被失效。RSC 架构支持两种再验证模式：</p>\n<h3 id=\"基于时间的再验证-time-based-revalidation\">基于时间的再验证（Time-based Revalidation）</h3><p>设置 <code>revalidate</code> 秒数后，缓存在过期后的第一次请求时触发后台重新获取。这遵循 stale-while-revalidate 语义——用户看到稍旧的缓存数据（fast），同时服务端在后台更新缓存（fresh for next visitor）。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 页面级 revalidate&#10;export const revalidate = 60  // 这个页面每 60 秒再验证&#10;&#10;export default async function NewsPage() {&#10;  const news = await fetchLatestNews()  // 继承页面的 revalidate 设置&#10;  return &lt;NewsList items={news} /&gt;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 页面级 revalidate</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> revalidate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 60</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 这个页面每 60 秒再验证</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NewsPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> news</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchLatestNews</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 继承页面的 revalidate 设置</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NewsList</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> items</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">news</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"按需再验证-on-demand-revalidation\">按需再验证（On-demand Revalidation）</h3><p>当数据变更发生时，主动失效相关缓存。通过 <code>revalidatePath</code> 失效路由缓存，通过 <code>revalidateTag</code> 失效标签关联的数据缓存：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"&#39;use server&#39;;&#10;&#10;import { revalidatePath, revalidateTag } from &#39;next/cache&#39;;&#10;&#10;export async function updateProduct(id: string, data: ProductUpdate) {&#10;  await db.product.update({ where: { id }, data });&#10;&#10;  // 失效该产品的数据缓存&#10;  revalidateTag(`product-${id}`);&#10;&#10;  // 失效产品列表页的路由缓存&#10;  revalidatePath(&#39;/products&#39;);&#10;&#10;  // 失效该产品详情页&#10;  revalidatePath(`/products/${id}`);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'use server'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { revalidatePath, revalidateTag } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'next/cache'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> updateProduct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProductUpdate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.product.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">update</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ where: { id }, data });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 失效该产品的数据缓存</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  revalidateTag</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`product-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">id</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 失效产品列表页的路由缓存</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  revalidatePath</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/products'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 失效该产品详情页</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  revalidatePath</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`/products/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">id</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"静态与动态渲染的决策\">静态与动态渲染的决策</h2><p>Next.js App Router 根据路由中使用的 API 自动决定渲染模式：</p>\n<table>\n<thead>\n<tr>\n<th>使用的 API</th>\n<th>渲染模式</th>\n<th>缓存行为</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>无动态 API</td>\n<td>静态（构建时渲染）</td>\n<td>Full Route Cache</td>\n</tr>\n<tr>\n<td><code>cookies()</code> / <code>headers()</code></td>\n<td>动态（请求时渲染）</td>\n<td>不缓存路由</td>\n</tr>\n<tr>\n<td><code>searchParams</code></td>\n<td>动态</td>\n<td>不缓存路由</td>\n</tr>\n<tr>\n<td><code>fetch</code> + <code>cache: &#39;no-store&#39;</code></td>\n<td>动态</td>\n<td>不缓存数据</td>\n</tr>\n<tr>\n<td><code>fetch</code> + <code>next: { revalidate: N }</code></td>\n<td>ISR</td>\n<td>缓存 N 秒</td>\n</tr>\n<tr>\n<td><code>connection()</code> / <code>draftMode()</code></td>\n<td>动态</td>\n<td>不缓存路由</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[路由分析] --&gt; B{使用动态 API？}&#10;    B --&gt;|否| C[静态渲染 - 构建时生成]&#10;    B --&gt;|是| D[动态渲染 - 请求时执行]&#10;    C --&gt; E[HTML + RSC Payload 缓存到 CDN]&#10;    D --&gt; F{有 revalidate 设置？}&#10;    F --&gt;|是| G[ISR - 后台再验证]&#10;    F --&gt;|否| H[每次请求重新渲染]&#10;&#10;    G --&gt; I[Stale-While-Revalidate 语义]&#10;    E --&gt; J[TTFB 接近 0 - CDN 边缘响应]\">flowchart TD\n    A[路由分析] --&gt; B{使用动态 API？}\n    B --&gt;|否| C[静态渲染 - 构建时生成]\n    B --&gt;|是| D[动态渲染 - 请求时执行]\n    C --&gt; E[HTML + RSC Payload 缓存到 CDN]\n    D --&gt; F{有 revalidate 设置？}\n    F --&gt;|是| G[ISR - 后台再验证]\n    F --&gt;|否| H[每次请求重新渲染]\n\n    G --&gt; I[Stale-While-Revalidate 语义]\n    E --&gt; J[TTFB 接近 0 - CDN 边缘响应]</pre><h2 id=\"缓存调试与可观测性\">缓存调试与可观测性</h2><p>缓存相关的 bug 是 RSC 应用中最难调试的问题之一——&quot;为什么我更新了数据但页面没变&quot;是最常见的开发者困惑。</p>\n<p>调试手段：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 1. 开发模式下查看缓存行为&#10;// next.config.ts&#10;const config: NextConfig = {&#10;  logging: {&#10;    fetches: {&#10;      fullUrl: true,  // 显示每个 fetch 的完整 URL 和缓存状态&#10;    },&#10;  },&#10;}&#10;&#10;// 2. 在 Server Component 中添加缓存标记&#10;async function DebugableComponent() {&#10;  const data = await fetch(url, { next: { tags: [&#39;debug-data&#39;] } })&#10;  console.log(&#39;[Cache Debug] Rendered at:&#39;, new Date().toISOString())&#10;  return &lt;div&gt;{/* ... */}&lt;/div&gt;&#10;}&#10;&#10;// 3. 使用 headers 检查响应缓存状态&#10;// x-nextjs-cache: HIT | MISS | STALE\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1. 开发模式下查看缓存行为</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// next.config.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NextConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  logging: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fetches: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      fullUrl: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 显示每个 fetch 的完整 URL 和缓存状态</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 2. 在 Server Component 中添加缓存标记</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DebugableComponent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url, { next: { tags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'debug-data'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] } })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'[Cache Debug] Rendered at:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toISOString</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">div</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 3. 使用 headers 检查响应缓存状态</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// x-nextjs-cache: HIT | MISS | STALE</span></span></code></pre></div><h2 id=\"常见缓存陷阱\">常见缓存陷阱</h2><p><strong>陷阱一：动态路由意外退出缓存</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 这个页面本意是静态的，但 cookies() 让它变成动态渲染&#10;export default async function Page() {&#10;  const theme = (await cookies()).get(&#39;theme&#39;)?.value  // 触发动态渲染！&#10;  const posts = await getCachedPosts()  // 缓存无效，每次重新获取&#10;  return &lt;PostList posts={posts} theme={theme} /&gt;&#10;}&#10;&#10;// 修复：将动态部分隔离到 Client Component&#10;export default async function Page() {&#10;  const posts = await getCachedPosts()  // 正常使用缓存&#10;  return &lt;PostList posts={posts} /&gt;&#10;  // theme 在 Client Component 中通过 cookie 或 context 获取&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 这个页面本意是静态的，但 cookies() 让它变成动态渲染</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> theme</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cookies</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'theme'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)?.value  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 触发动态渲染！</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> posts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCachedPosts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 缓存无效，每次重新获取</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">PostList</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> posts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">posts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">theme</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">theme</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">// 修复：将动态部分隔离到 Client Component</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">export default async function Page() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  const posts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCachedPosts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正常使用缓存</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  return &#x3C;PostList posts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{posts} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // theme 在 Client Component 中通过 cookie 或 context 获取</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>陷阱二：忘记在数据变更后失效缓存</strong></p>\n<p>Server Action 中修改了数据但没有调用 <code>revalidatePath</code> / <code>revalidateTag</code>，用户在下次访问时仍然看到旧数据。每个写操作都应该明确声明它影响的缓存范围。</p>\n<h2 id=\"小结\">小结</h2><p>RSC 缓存是四层体系：Request Memoization（请求内去重）→ Data Cache（跨请求数据缓存）→ Full Route Cache（路由级缓存）→ Router Cache（客户端导航缓存）。Next.js 15+ 默认不缓存 <code>fetch</code>，开发者需显式声明策略。核心操作：<code>revalidate</code> 设时间过期、<code>revalidateTag</code> 做按需失效、<code>&#39;use cache&#39;</code> 做声明式缓存。避免动态 API（如 <code>cookies()</code>）意外触发动态渲染导致缓存失效，以及确保每个 Server Action 都声明它影响的缓存范围。</p>\n<hr>\n<blockquote>\n<p><strong>相关文档</strong>：<a href=\"edge-rendering\">边缘渲染与部署拓扑</a> 讲解如何将缓存策略与 CDN 边缘节点结合，实现全球级的低延迟访问</p>\n</blockquote>\n","headings":[{"level":1,"text":"缓存策略与再验证机制","id":"缓存策略与再验证机制"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"缓存层级全景","id":"缓存层级全景"},{"level":2,"text":"数据获取的缓存控制","id":"数据获取的缓存控制"},{"level":2,"text":"`'use cache'` 指令（Next.js 15.x+）","id":"use-cache-指令-next-js-15-x"},{"level":2,"text":"再验证策略","id":"再验证策略"},{"level":3,"text":"基于时间的再验证（Time-based Revalidation）","id":"基于时间的再验证-time-based-revalidation"},{"level":3,"text":"按需再验证（On-demand Revalidation）","id":"按需再验证-on-demand-revalidation"},{"level":2,"text":"静态与动态渲染的决策","id":"静态与动态渲染的决策"},{"level":2,"text":"缓存调试与可观测性","id":"缓存调试与可观测性"},{"level":2,"text":"常见缓存陷阱","id":"常见缓存陷阱"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Bundle 拆分与代码消除","url":"/l-doc-books/h/frontend/react-server-components/performance/bundle-splitting"},"next":{"title":"边缘渲染与部署拓扑","url":"/l-doc-books/h/frontend/react-server-components/performance/edge-rendering"}}