rk:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result.success) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { error: result.error.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatten</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().fieldErrors };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 2. 执行数据变更</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.product.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ data: result.data });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 3. 失效缓存，触发页面重新获取数据</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  revalidatePath</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/products'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { success: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// components/product-form.tsx&#10;&#39;use client&#39;&#10;&#10;import { useActionState } from &#39;react&#39;&#10;import { createProduct } from &#39;@/app/actions/products&#39;&#10;&#10;export function ProductForm() {&#10;  const [state, formAction, isPending] = useActionState(createProduct, null)&#10;&#10;  return (&#10;    &lt;form action={formAction}&gt;&#10;      &lt;div&gt;&#10;        &lt;label htmlFor=&quot;name&quot;&gt;产品名称&lt;/label&gt;&#10;        &lt;input id=&quot;name&quot; name=&quot;name&quot; required /&gt;&#10;        {state?.error?.name &amp;&amp; (&#10;          &lt;p className=&quot;text-red-500&quot;&gt;{state.error.name[0]}&lt;/p&gt;&#10;        )}&#10;      &lt;/div&gt;&#10;&#10;      &lt;div&gt;&#10;        &lt;label htmlFor=&quot;price&quot;&gt;价格&lt;/label&gt;&#10;        &lt;input id=&quot;price&quot; name=&quot;price&quot; type=&quot;number&quot; step=&quot;0.01&quot; required /&gt;&#10;        {state?.error?.price &amp;&amp; (&#10;          &lt;p className=&quot;text-red-500&quot;&gt;{state.error.price[0]}&lt;/p&gt;&#10;        )}&#10;      &lt;/div&gt;&#10;&#10;      &lt;button type=&quot;submit&quot; disabled={isPending}&gt;&#10;        {isPending ? &#39;提交中...&#39; : &#39;创建产品&#39;}&#10;      &lt;/button&gt;&#10;    &lt;/form&gt;&#10;  )&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// components/product-form.tsx</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'use client'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { useActionState } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECB