><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">div</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">label htmlFor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"name\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">产品名称</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">label</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">input id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> required </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">?.</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">?.</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          &#x3C;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"text-red-500\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{state.error.name[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]}&#x3C;/p></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;/div></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;div></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        &#x3C;label htmlFor=\"price\">价格&#x3C;/label></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        &#x3C;input id=\"price\" name=\"price\" type=\"number\" step=\"0.01\" required /></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {state?.error?.price &#x26;&#x26; (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          &#x3C;p className=\"text-red-500\">{state.error.price[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]}&#x3C;/p></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;/div></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;button type=\"submit\" disabled={isPending}></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {isPending ? '提交中...' : </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'创建产品'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;/</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;/</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"执行流程与底层机制\">执行流程与底层机制</h2><p>当客户端调用一个 Server Action 时，React 的执行流程如下：</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant U as 用户&#10;    participant C as Client Component&#10;    participant R as React Runtime&#10;    participant S as Server&#10;    participant DB as 数据库&#10;&#10;    U-&gt;&gt;C: 提交表单 / 点击按钮&#10;    C-&gt;&gt;R: 调用 Server Action&#10;    R-&gt;&gt;R: 序列化参数为 FormData/JSON&#10;    R-&gt;&gt;S: HTTP POST /_actions/actionId&#10;    S-&gt;&gt;S: 反序列化参数&#10;    S-&gt;&gt;S: 执行 Server Action 函数&#10;    S-&gt;&gt;DB: 数据库写操作&#10;    DB--&gt;&gt;S: 写入成功&#10;    S-&gt;&gt;S: revalidatePath/revalidateTag&#10;    S--&gt;&gt;R: 返回结果 + 新的 RSC Payload&#10;    R-&gt;&gt;C: 更新 UI(保留客户端状态)&#10;    C-&gt;&gt;U: 显示成功/错误反馈\">sequenceDiagram\n    participant U as 用户\n    participant C as Client Component\n    participant R as React Runtime\n    participant S as Server\n    participant DB as 数据库\n\n    U-&gt;&gt;C: 提交表单 / 点击按钮\n    C-&gt;&gt;R: 调用 Server Action\n    R-&gt;&gt;R: 序列化参数为 FormData/JSON\n    R-&gt;&gt;S: HTTP POST /_actions/actionId\n    S-&gt;&gt;S: 反序列化参数\n    S-&gt;&gt;S: 执行 Server Action 函数\n    S-&gt;&gt;DB: 数据库写操作\n    DB--&gt;&gt;S: 写入成功\n    S-&gt;&gt;S: revalidatePath/revalidateTag\n    S--&gt;&gt;R: 返回结果 + 新的 RSC Payload\n    R-&gt;&gt;C: 更新 UI(保留客户端状态)\n    C-&gt;&gt;U: 显示成功/错误反馈</pre><p>关键实现细节：</p>\n<table>\n<thead>\n<tr>\n<th>方面</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>传输协议</td>\n<td>HTTP POST 请求到自动生成的 endpoint</td>\n</tr>\n<tr>\n<td>参数格式</td>\n<td>FormData（表单提交）或 JSON（直接调用）</td>\n</tr>\n<tr>\n<td>返回值</td>\n<td>序列化后通过 RSC Payload 返回</td>\n</tr>\n<tr>\n<td>并发控制</td>\n<td>React 自动队列化同一表单的多次提交</td>\n</tr>\n<tr>\n<td>重定向</td>\n<td>Action 中调用 <code>redirect()</code> 由框架处理</td>\n</tr>\n<tr>\n<td>缓存失效</td>\n<td><code>revalidatePath</code> / <code>revalidateTag</code> 触发重获取</td>\n</tr>\n<tr>\n<td>错误处理</td>\n<td>异常自动传播到最近的 Error Boundary</td>\n</tr>\n</tbody></table>\n<h2 id=\"渐进增强与表单语义\">渐进增强与表单语义</h2><p>Server Actions 与 HTML <code>&lt;form&gt;</code> 的 <code>action</code> 属性原生集成，实现了真正的渐进增强——即使 JavaScript 加载失败或被禁用，表单仍然可以正常提交和处理：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 渐进增强的表单：JS 关闭时仍可工作&#10;export function NewsletterForm() {&#10;  return (&#10;    &lt;form action={subscribeNewsletter}&gt;&#10;      &lt;input name=&quot;email&quot; type=&quot;email&quot; required placeholder=&quot;your@email.com&quot; /&gt;&#10;      &lt;button type=&quot;submit&quot;&gt;订阅&lt;/button&gt;&#10;    &lt;/form&gt;&#10;  )&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 渐进增强的表单：JS 关闭时仍可工作</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NewsletterForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form action</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{subscribeNewsletter}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">input name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"email\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"email\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> required placeholder</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"your@email.com\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"submit\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">订阅</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>当 JavaScript 可用时，React 拦截表单提交，通过 <code>fetch</code> 异步发送请求并更新 UI（无整页刷新）。当 JavaScript 不可用时，浏览器原生表单提交机制接管，发送 POST 请求到服务端处理。</p>\n<h2 id=\"乐观更新-optimistic-updates\">乐观更新（Optimistic Updates）</h2><p>对于用户期望即时反馈的操作（点赞、收藏、状态切换），等待服务端响应会造成感知延迟。React 19 的 <code>useOptimistic</code> hook 允许在 Action 执行期间显示预期结果：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"&#39;use client&#39;&#10;&#10;import { useOptimistic } from &#39;react&#39;&#10;import { toggleLike } from &#39;@/app/actions/likes&#39;&#10;&#10;export function LikeButton({&#10;  articleId,&#10;  initialLiked,&#10;  initialCount&#10;}: {&#10;  articleId: string&#10;  initialLiked: boolean&#10;  initialCount: number&#10;}) {&#10;  const [optimisticState, addOptimistic] = useOptimistic(&#10;    { liked: initialLiked, count: initialCount },&#10;    (current, newLiked: boolean) =&gt; ({&#10;      liked: newLiked,&#10;      count: newLiked ? current.count + 1 : current.count - 1,&#10;    })&#10;  )&#10;&#10;  const handleToggle = async () =&gt; {&#10;    const newLiked = !optimisticState.liked&#10;    addOptimistic(newLiked)  // 立即更新 UI&#10;    await toggleLike(articleId, newLiked)  // 后台执行 Action&#10;    // 如果 Action 失败，React 自动回退到真实状态&#10;  }&#10;&#10;  return (&#10;    &lt;button onClick={handleToggle}&gt;&#10;      {optimisticState.liked ? &#39;♥&#39; : &#39;♡&#39;} {optimisticState.count}&#10;    &lt;/button&gt;&#10;  )&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span c