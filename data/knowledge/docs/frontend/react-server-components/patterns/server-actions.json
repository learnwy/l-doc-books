toggleLike</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(articleId, newLiked)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 后台执行 Action</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 如果 Action 失败，React 自动回退到真实状态</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button onClick</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{handleToggle}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">optimisticState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">liked</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ? </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'♥'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> : </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'♡'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} {</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">optimisticState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"安全性考量\">安全性考量</h2><p>Server Actions 本质上是暴露在网络上的 HTTP endpoint。虽然 React 为它们生成了不可预测的 Action ID，但安全性不能依赖于 URL 的隐蔽性。每个 Server Action 都需要：</p>\n<p><strong>输入校验</strong>：永远不信任客户端传入的数据。使用 Zod 或类似的 schema 验证库在 Action 入口处校验所有输入。</p>\n<p><strong>鉴权检查</strong>：每个 Action 的第一步应该验证调用者的身份和权限，不能假设&quot;因为页面上有这个按钮，所以用户有权限执行这个操作&quot;。</p>\n<p><strong>速率限制</strong>：对公开 Action（如注册、登录、评论）实施速率限制，防止滥用。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"&#39;use server&#39;;&#10;&#10;import { getSession } from &#39;@/lib/auth&#39;;&#10;import { rateLimit } from &#39;@/lib/rate-limit&#39;;&#10;&#10;export async function deleteComment(commentId: string) {&#10;  // 1. 鉴权&#10;  const session = await getSession();&#10;  if (!session) throw new Error(&#39;未登录&#39;);&#10;&#10;  // 2. 权限检查&#10;  const comment = await db.comment.findUnique({ where: { id: commentId } });&#10;  if (!comment) throw new Error(&#39;评论不存在&#39;);&#10;  if (comment.authorId !== session.userId &amp;&amp; session.role !== &#39;admin&#39;) {&#10;    throw new Error(&#39;无权删除他人评论&#39;);&#10;  }&#10;&#10;  // 3. 速率限制&#10;  const { success } = await rateLimit.limit(session.userId);&#10;  if (!success) throw new Error(&#39;操作过于频繁&#39;);&#10;&#10;  // 4. 执行变更&#10;  await db.comment.delete({ where: { id: commentId } });&#10;  revalidatePath(`/articles/${comment.articleId}`);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'use server'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-da