le=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'use cache'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  cacheLife</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'minutes'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> price</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchCurrentPrice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(productId);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">span</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> className</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"price\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>${price}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">span</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>use cache</code> 的行为：</p>\n<ul>\n<li>以函数参数作为缓存键</li>\n<li>缓存存储的是组件的<strong>渲染输出</strong>（RSC Payload 片段）</li>\n<li>同一请求内多次调用自动去重（React <code>cache()</code>）</li>\n<li>跨请求共享缓存（持久化到文件/Redis）</li>\n</ul>\n<h2 id=\"标签式失效-tag-based-invalidation\">标签式失效（Tag-based Invalidation）</h2><p>按标签失效允许精确控制&quot;哪些缓存受到了数据变更的影响&quot;：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { cacheTag, revalidateTag } from &#39;next/cache&#39;;&#10;&#10;// 数据获取时标记标签&#10;async function getProduct(id: string) {&#10;  &#39;use cache&#39;;&#10;  cacheTag(`product-${id}`, &#39;products-list&#39;);&#10;  return await db.products.findById(id);&#10;}&#10;&#10;async function getProductReviews(productId: string) {&#10;  &#39;use cache&#39;;&#10;  cacheTag(`reviews-${productId}`);&#10;  return await db.reviews.findMany({ where: { productId } });&#10;}&#10;&#10;// 数据变更时按标签失效&#10;export async function submitReview(productId: string, review: ReviewData) {&#10;  &#39;use server&#39;;&#10;  await db.reviews.create({ data: { ...review, productId } });&#10;&#10;  // 精确失效：只影响该产品的评论缓存&#10;  revalidateTag(`reviews-${productId}`);&#10;  // 产品列表可能显示评论数，也失效&#10;  revalidateTag(`product-${productId}`);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { cacheTag, revalidateTag } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'next/cache'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 数据获取时标记标签</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getProduct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8