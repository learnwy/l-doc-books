\"vlist\" style=\"height:0.3831em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≈</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">20</span><span class=\"mord mathnormal\">m</span><span class=\"mord mathnormal\">s</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">30</span><span class=\"mord mathnormal\">m</span><span class=\"mord mathnormal\">s</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">50</span><span class=\"mord mathnormal\">m</span><span class=\"mord mathnormal\">s</span></span></span></span></span></div><table>\n<thead>\n<tr>\n<th>渲染策略</th>\n<th>TTFB</th>\n<th>FCP</th>\n<th>LCP</th>\n<th>数据新鲜度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SSG</td>\n<td>~0ms (CDN)</td>\n<td>~50ms</td>\n<td>~50ms</td>\n<td>构建时锁定</td>\n</tr>\n<tr>\n<td>ISR (revalidate: 60)</td>\n<td>~0ms (CDN)</td>\n<td>~50ms</td>\n<td>~50ms</td>\n<td>60s 内可能陈旧</td>\n</tr>\n<tr>\n<td>SSR</td>\n<td>200-800ms</td>\n<td>200-800ms</td>\n<td>200-800ms</td>\n<td>总是最新</td>\n</tr>\n<tr>\n<td>PPR</td>\n<td>~20ms (CDN)</td>\n<td>~50ms</td>\n<td>~50ms (壳)</td>\n<td>动态部分总是最新</td>\n</tr>\n</tbody></table>\n<p>PPR 实现了&quot;SSG 的速度 + SSR 的新鲜度&quot;——这在此前被认为是不可调和的矛盾。</p>\n<h2 id=\"next-js-16-中的-ppr-实现\">Next.js 16 中的 PPR 实现</h2><p>在 Next.js 16 中，PPR 通过 <code>cacheComponents: true</code> 自动启用，不再需要单独的实验标志：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// next.config.ts&#10;const nextConfig = {&#10;  cacheComponents: true, // PPR + use cache + dynamicIO 统一开关&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// next.config.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nextConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  cacheComponents: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// PPR + use cache + dynamicIO 统一开关</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>PPR 的行为规则：</p>\n<ul>\n<li><code>&lt;Suspense&gt;</code> 边界外的内容 → 构建时预渲染，部署到 CDN</li>\n<li><code>&lt;Suspense&gt;</code> 边界内的内容 → 请求时服务端渲染，流式注入</li>\n<li><code>&#39;use cache&#39;</code> 标记的组件 → 即使在 Suspense 内，也缓存其输出</li>\n</ul>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[组件树] --&gt; B{有 Suspense 边界?}&#10;    B --&gt;|外部| C[预渲染为静态壳]&#10;    B --&gt;|内部| D{标记了 use cache?}&#10;    D --&gt;|是| E[请求时从缓存读取]&#10;    D --&gt;|否| F[请求时动态渲染]&#10;    C --&gt; G[部署到 CDN]&#10;    E --&gt; H[流式注入响应]&#10;    F --&gt; H\">graph TD\n    A[组件树] --&gt; B{有 Suspense 边界?}\n    B --&gt;|外部| C[预渲染为静态壳]\n    B --&gt;|内部| D{标记了 use cache?}\n    D --&gt;|是| E[请求时从缓存读取]\n    D --&gt;|否| F[请求时动态渲染]\n    C --&gt; G[部署到 CDN]\n    E --&gt; H[流式注入响应]\n    F --&gt; H</pre><h2 id=\"设计模式-有效的壳设计\">设计模式：有效的壳设计</h2><p><strong>模式一：布局壳 + 内容动态</strong></p>\n<p>适用于需要用户身份的页面（仪表盘、个人中心）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export default function DashboardLayout({ children }) {&#10;  return (&#10;    &lt;div className=&quot;dashboard&quot;&gt;&#10;      {/* 静态壳：侧边栏导航结构 */}&#10;      &lt;Sidebar /&gt;&#10;      &lt;main&gt;&#10;        {/* 动态：用户数据 */}&#10;        &lt;Suspense fallback={&lt;DashboardSkeleton /&gt;}&gt;&#10;          {children}&#10;        &lt;/Suspense&gt;&#10;      &lt;/main&gt;&#10;    &lt;/div&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DashboardLayout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">children</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"dashboard\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 静态壳：侧边栏导航结构 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Sidebar </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 动态：用户数据 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{&#x3C;DashboardSkeleton />}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          {</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">children</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">main</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>模式二：内容壳 + 个性化动态</strong></p>\n<p>适用于电商、新闻等内容页面：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export default async function ArticlePage({ params }) {&#10;  const article = await getCachedArticle(params.slug);&#10;&#10;  return (&#10;    &lt;article&gt;&#10;      {/* 静态壳：文章内容（很少变化） */}&#10;      &lt;h1&gt;{article.title}&lt;/h1&gt;&#10;      &lt;div dangerouslySetInnerHTML={{ __html: article.html }} /&gt;&#10;&#10;      {/* 动态：个性化推荐 */}&#10;      &lt;Suspense fallback={&lt;RelatedSkeleton /&gt;}&gt;&#10;        &lt;PersonalizedRelated articleId={article.id} /&gt;&#10;      &lt;/Suspense&gt;&#10;&#10;      {/* 动态：实时评论 */}&#10;      &lt;Suspense fallback={&lt;CommentsSkeleton /&gt;}&gt;&#10;        &lt;LiveComments articleId={article.id} /&gt;&#10;      &lt;/Suspense&gt;&#10;    &lt;/article&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ArticlePage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">params</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> article</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCachedArticle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(params.slug);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">article</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 静态壳：文章内容（很少变化） */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">h1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{article.title}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">h1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div dangerouslySetInnerHTML</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">__html</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: article.html }} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 动态：个性化推荐 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{&#x3C;RelatedSkeleton />}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PersonalizedRelated articleId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{article.id} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 动态：实时评论 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{&#x3C;CommentsSkeleton />}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LiveComments articleId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{article.id} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">article</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"常见陷阱\">常见陷阱</h2><table>\n<thead>\n<tr>\n<th>陷阱</th>\n<th>症状</th>\n<th>修正</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>壳内使用 cookies()/headers()</td>\n<td>整个页面变为动态</td>\n<td>将依赖请求数据的逻辑移入 Suspense 内</td>\n</tr>\n<tr>\n<td>Suspense 包裹过大</td>\n<td>壳太小，PPR 收益有限</td>\n<td>拆分为多个小的 Suspense 边界</td>\n</tr>\n<tr>\n<td>Skeleton 与真实内容尺寸不匹配</td>\n<td>CLS（布局偏移）增加</td>\n<td>固定容器尺寸或使用准确的骨架屏</td>\n</tr>\n<tr>\n<td>动态部分获取过慢</td>\n<td>用户长时间看到 skeleton</td>\n<td>在服务端层面优化查询/引入缓存</td>\n</tr>\n</tbody></table>\n<h2 id=\"与其他框架的-ppr-等价物\">与其他框架的 PPR 等价物</h2><table>\n<thead>\n<tr>\n<th>框架</th>\n<th>PPR 等价特性</th>\n<th>实现方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Next.js 16</td>\n<td><code>cacheComponents</code> + Suspense</td>\n<td>构建时壳 + 请求时流</td>\n</tr>\n<tr>\n<td>Astro 5</td>\n<td>Server Islands (<code>server:defer</code>)</td>\n<td>静态页面 + 独立动态请求</td>\n</tr>\n<tr>\n<td>Qwik</td>\n<td>Resumability + <code>useResource$</code></td>\n<td>静态 HTML + 按需执行</td>\n</tr>\n<tr>\n<td>SolidStart</td>\n<td>路由级 prerender + streaming</td>\n<td>类似 Next.js 但使用 Solid</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>PPR 把静态/动态的决策从路由级下沉到组件级，一次请求同时得到 SSG 的速度与 SSR 的新鲜度</li>\n<li>实现依赖构建时组件树分析 + 静态壳 CDN 分发 + 请求时流式注入三项能力</li>\n<li>收益完全取决于静态壳覆盖了多少有意义内容：首屏可见且不依赖请求时数据的内容都应在壳内</li>\n<li>在 Next.js 16 中 PPR 由 <code>cacheComponents: true</code> 自动启用，<code>&#39;use cache&#39;</code> 组件即使在 Suspense 内也缓存输出</li>\n<li>常见陷阱：壳内使用 <code>cookies()</code>/<code>headers()</code> 会让整页变动态，Suspense 包裹过大、骨架与真实内容尺寸不匹配</li>\n<li>其他框架的等价物：Astro Server Islands、Qwik Resumability、SolidStart 路由级 prerender</li>\n</ul>\n<p>PPR 代表了&quot;渲染什么时候做&quot;这个维度的最优解。下一篇 <a href=\"edge-rendering-strategies\">边缘渲染策略</a> 探讨正交的另一个维度——&quot;渲染在哪里做&quot;。</p>\n","headings":[{"level":1,"text":"部分预渲染（PPR）","id":"部分预渲染-ppr"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"技术原理","id":"技术原理"},{"level":2,"text":"静态壳与动态区域的划分","id":"静态壳与动态区域的划分"},{"level":2,"text":"时间线对比","id":"时间线对比"},{"level":2,"text":"Next.js 16 中的 PPR 实现","id":"next-js-16-中的-ppr-实现"},{"level":2,"text":"设计模式：有效的壳设计","id":"设计模式-有效的壳设计"},{"level":2,"text":"常见陷阱","id":"常见陷阱"},{"level":2,"text":"与其他框架的 PPR 等价物","id":"与其他框架的-ppr-等价物"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Astro 与 Islands 架构","url":"/l-doc-books/h/frontend/frontend-server-components-ssr/frameworks/astro-islands-architecture"},"next":{"title":"边缘渲染策略","url":"/l-doc-books/h/frontend/frontend-server-components-ssr/optimization/edge-rendering-strategies"}}