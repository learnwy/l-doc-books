color:#24292E;--shiki-dark:#E1E4E8\"> masterTl;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"stagger-算法详解\">stagger 算法详解</h2><h3 id=\"基础-stagger-均匀间隔\">基础 stagger：均匀间隔</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 最简单的 stagger&#10;gsap.from(&#39;.item&#39;, {&#10;  opacity: 0,&#10;  y: 20,&#10;  stagger: 0.05, // 每个元素延迟 0.05s&#10;});&#10;&#10;// 使用 stagger 对象&#10;gsap.from(&#39;.item&#39;, {&#10;  opacity: 0,&#10;  y: 20,&#10;  stagger: {&#10;    each: 0.05, // 每元素间隔 0.05s&#10;    from: &#39;start&#39;, // 从第一个开始（默认）&#10;    ease: &#39;power2.in&#39;, // stagger 间隔本身的缓动（不是元素动画的缓动）&#10;    repeat: -1, // 无限循环&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 最简单的 stagger</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">gsap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'.item'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  opacity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  y: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  stagger: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, 