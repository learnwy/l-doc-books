:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">--rotation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  transition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: --rotation </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> linear</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.spinner.active</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --rotation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">360</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">deg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 渐变角度动画 */</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.gradient-bg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --gradient-angle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">deg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  background</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">linear-gradient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">--gradient-angle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#667eea</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#764ba2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  animation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: rotate-gradient </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> linear</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> infinite</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@keyframes</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> rotate-gradient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    --gradient-angle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">360</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">deg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"property-支持的-syntax-类型\">@property 支持的 syntax 类型</h3><table>\n<thead>\n<tr>\n<th>syntax 值</th>\n<th>描述</th>\n<th>过渡插值方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>&lt;length&gt;</code></td>\n<td><code>px</code>、<code>em</code>、<code>rem</code> 等长度</td>\n<td>数值插值</td>\n</tr>\n<tr>\n<td><code>&lt;number&gt;</code></td>\n<td>无单位数字</td>\n<td>数值插值</td>\n</tr>\n<tr>\n<td><code>&lt;percentage&gt;</code></td>\n<td>百分比</td>\n<td>数值插值</td>\n</tr>\n<tr>\n<td><code>&lt;angle&gt;</code></td>\n<td>角度值</td>\n<td>角度插值</td>\n</tr>\n<tr>\n<td><code>&lt;color&gt;</code></td>\n<td>颜色值</td>\n<td>色彩空间插值</td>\n</tr>\n<tr>\n<td><code>&lt;integer&gt;</code></td>\n<td>整数</td>\n<td>整数步进</td>\n</tr>\n</tbody></table>\n<p><strong><code>@property</code> 的浏览器支持</strong>（截至 2026 年）：Chrome 85+、Edge 85+、Firefox 128+、Safari 16.4+。已可用于生产，但需要考虑 Firefox 128 以下的降级方案。</p>\n<h2 id=\"css-动画的性能边界\">CSS 动画的性能边界</h2><p>CSS 动画并非全部都是高性能的。以下情况会触发 Layout 或 Paint：</p>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\"/* 触发 Layout 的动画（性能差）*/&#10;@keyframes expand {&#10;  from {&#10;    width: 100px;&#10;  }&#10;  to {&#10;    width: 200px;&#10;  }&#10;}&#10;&#10;/* 等效的高性能版本 */&#10;@keyframes expand-good {&#10;  from {&#10;    transform: scaleX(0.5);&#10;    transform-origin: left;&#10;  }&#10;  to {&#10;    transform: scaleX(1);&#10;  }&#10;}&#10;&#10;/* 触发 Paint 的动画（中等性能）*/&#10;@keyframes fade-color {&#10;  from {&#10;    background-color: red;&#10;  }&#10;  to {&#10;    background-color: blue;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 触发 Layout 的动画（性能差）*/</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@keyframes</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> expand</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    width</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    width</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 等效的高性能版本 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@keyframes</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> expand-good</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">scaleX</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    transform-origin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">left</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">scaleX</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 触发 Paint 的动画（中等性能）*/</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@keyframes</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> fade-color</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    background-color</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">red</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    background-color</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">blue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>CSS 动画 vs JavaScript 动画的选择</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐方案</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>简单状态过渡（hover、focus）</td>\n<td>CSS transition</td>\n<td>声明式，浏览器优化好</td>\n</tr>\n<tr>\n<td>固定关键帧序列</td>\n<td>CSS @keyframes</td>\n<td>无需 JS，compositor 运行</td>\n</tr>\n<tr>\n<td>需要 JS 控制（暂停、反转、seek）</td>\n<td>Web Animations API</td>\n<td>CSS 动画控制能力有限</td>\n</tr>\n<tr>\n<td>复杂编排、物理效果</td>\n<td>GSAP / Framer Motion</td>\n<td>生产级动画库</td>\n</tr>\n</tbody></table>\n<h2 id=\"核心概念\">核心概念</h2><ul>\n<li><strong>transition</strong>：声明式过渡，在 CSS 属性值变化时自动补间；仅应指定具名属性，避免 <code>transition: all</code></li>\n<li><strong>@keyframes</strong>：定义动画序列；通过 <code>animation</code> 属性引用；<code>animation-fill-mode</code> 控制动画前后的状态保持</li>\n<li><strong>缓动函数</strong>：<code>cubic-bezier(x1,y1,x2,y2)</code> 描述速度曲线，<code>steps(n)</code> 用于精灵图等离散动画</li>\n<li><strong>@property</strong>：注册 CSS 自定义属性类型，使自定义属性支持过渡和 <code>@keyframes</code> 插值</li>\n<li><strong>animation-fill-mode</strong>：<code>forwards</code> 保留最终帧、<code>backwards</code> 在 delay 期间应用起始帧、<code>both</code> 两者兼顾</li>\n</ul>\n<h2 id=\"小结\">小结</h2><p>CSS 动画系统提供从简单过渡到复杂关键帧序列的声明式方案，<code>@property</code> 进一步扩展了自定义属性的动画能力。选择原则：状态过渡用 <code>transition</code>，固定序列用 <code>@keyframes</code>，需要 JavaScript 精确控制时升级到 Web Animations API。</p>\n<h2 id=\"本章导航\">本章导航</h2><ul>\n<li>上一篇：<a href=\"animation-principles\">Web 动画原理</a> — 渲染流水线与合成层</li>\n<li>下一篇：<a href=\"web-animations-api\">Web Animations API</a> — 命令式动画控制</li>\n<li>章节概览：<a href=\"../foundations/\">动画基础</a></li>\n</ul>\n","headings":[{"level":1,"text":"CSS 过渡与动画：transition、@keyframes 与 @property","id":"css-过渡与动画-transition-keyframes-与-property"},{"level":2,"text":"CSS transition：声明式过渡","id":"css-transition-声明式过渡"},{"level":3,"text":"transition 属性详解","id":"transition-属性详解"},{"level":3,"text":"缓动函数系统","id":"缓动函数系统"},{"level":2,"text":"@keyframes：关键帧动画","id":"keyframes-关键帧动画"},{"level":3,"text":"animation 属性详解","id":"animation-属性详解"},{"level":3,"text":"多关键帧的精确控制","id":"多关键帧的精确控制"},{"level":2,"text":"@property：为自定义属性赋予过渡能力","id":"property-为自定义属性赋予过渡能力"},{"level":3,"text":"@property 支持的 syntax 类型","id":"property-支持的-syntax-类型"},{"level":2,"text":"CSS 动画的性能边界","id":"css-动画的性能边界"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"本章导航","id":"本章导航"}],"prev":{"title":"Web 动画原理：渲染流水线与合成层模型","url":"/l-doc-books/h/frontend/web-animation-engineering/foundations/animation-principles"},"next":{"title":"Web Animations API：命令式动画控制","url":"/l-doc-books/h/frontend/web-animation-engineering/foundations/web-animations-api"}}