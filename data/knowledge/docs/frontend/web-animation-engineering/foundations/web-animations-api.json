dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.animationName </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'fade-in'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h3 id=\"拦截-css-动画\">拦截 CSS 动画</h3><p>WAAPI 可以获取 CSS <code>@keyframes</code> 动画的 <code>Animation</code> 对象，从而用 JavaScript 控制它：</p>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\".element {&#10;  animation: spin 1s linear infinite;&#10;}&#10;&#10;@keyframes spin {&#10;  to {&#10;    transform: rotate(360deg);&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  animation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: spin </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> linear</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> infinite</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@keyframes</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> spin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">rotate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">360</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">deg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 等待 CSS 动画就绪&#10;element.addEventListener(&#39;animationstart&#39;, () =&gt; {&#10;  const [spinAnimation] = element.getAnimations();&#10;  spinAnimation.updatePlaybackRate(0.5); // 减速到 0.5 倍&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 等待 CSS 动画就绪</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">element.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addEventListener</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'animationstart'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">spinAnimation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> element.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getAnimations</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  spinAnimation.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">updatePlaybackRate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 减速到 0.5 倍</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"animationtimeline-与-scrolltimeline\">AnimationTimeline 与 ScrollTimeline</h2><p>WAAPI 支持自定义时间线（Timeline），将动画进度与非时间因素绑定：</p>\n<h3 id=\"documenttimeline-默认\">DocumentTimeline（默认）</h3><p><code>DocumentTimeline</code> 以文档创建时间为起点的时间线，<code>Element.animate()</code> 默认使用它：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const timeline = new DocumentTimeline({ originTime: 500 }); // 延迟 500ms 启动&#10;const animation = element.animate(keyframes, {&#10;  duration: 1000,&#10;  timeline,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> timeline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DocumentTimeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ originTime: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 延迟 500ms 启动</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> animation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> element.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">animate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(keyframes, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  duration: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  timeline,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"scrolltimeline-滚动驱动\">ScrollTimeline（滚动驱动）</h3><p><code>ScrollTimeline</code> 将动画进度与元素滚动位置绑定（详见第三章「滚动驱动动画」）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const timeline = new ScrollTimeline({&#10;  source: document.documentElement,&#10;  axis: &#39;block&#39;, // 垂直滚动&#10;});&#10;&#10;const animation = element.animate([{ opacity: 0 }, { opacity: 1 }], {&#10;  timeline,&#10;  fill: &#39;both&#39;,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> timeline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ScrollTimeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  source: document.documentElement,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  axis: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'block'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 垂直滚动</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> animation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> element.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">animate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([{ opacity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { opacity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }], {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  timeline,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  fill: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'both'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"组合动画效果-keyframeeffect-与-groupeffect\">组合动画效果：KeyframeEffect 与 GroupEffect</h2><p>WAAPI 提供了底层的 <code>KeyframeEffect</code> 类，支持更精细的动画组合：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 直接创建 KeyframeEffect&#10;const effect = new KeyframeEffect(element, [{ transform: &#39;scale(1)&#39; }, { transform: &#39;scale(1.2)&#39; }], { duration: 300 });&#10;&#10;const animation = new Animation(effect, document.timeline);&#10;animation.play();&#10;&#10;// GroupEffect：多个动画同时播放（提案阶段，兼容性有限）&#10;const group = new GroupEffect([&#10;  new KeyframeEffect(element1, keyframes1, timing1),&#10;  new KeyframeEffect(element2, keyframes2, timing2),&#10;]);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 直接创建 KeyframeEffect</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> effect</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> KeyframeEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(element, [{ transform: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'scale(1)'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { transform: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'scale(1.2)'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }], { duration: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> animation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Animation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(effect, document.timeline);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">animation.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">play</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// GroupEffect：多个动画同时播放（提案阶段，兼容性有限）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> group</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GroupEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> KeyframeEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(element1, keyframes1, timing1),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> KeyframeEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(element2, keyframes2, timing2),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span></code></pre></div><h2 id=\"waapi-vs-css-动画的实际选择\">WAAPI vs CSS 动画的实际选择</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A{动画需求} --&gt; B{需要 JS 控制?}&#10;    B --&gt;|否| C{复杂关键帧?}&#10;    C --&gt;|否| D[CSS transition]&#10;    C --&gt;|是| E[CSS @keyframes]&#10;    B --&gt;|是| F{需要 seek/rate 控制?}&#10;    F --&gt;|否| G[&quot;element.animate() 基础用法&quot;]&#10;    F --&gt;|是| H[Animation 对象完整控制]&#10;    H --&gt; I{多元素编排?}&#10;    I --&gt;|是| J[考虑 GSAP timeline]\">graph TD\n    A{动画需求} --&gt; B{需要 JS 控制?}\n    B --&gt;|否| C{复杂关键帧?}\n    C --&gt;|否| D[CSS transition]\n    C --&gt;|是| E[CSS @keyframes]\n    B --&gt;|是| F{需要 seek/rate 控制?}\n    F --&gt;|否| G[\"element.animate() 基础用法\"]\n    F --&gt;|是| H[Animation 对象完整控制]\n    H --&gt; I{多元素编排?}\n    I --&gt;|是| J[考虑 GSAP timeline]</pre><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>CSS 动画</th>\n<th>WAAPI</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>悬停/焦点状态过渡</td>\n<td>推荐</td>\n<td>无需</td>\n</tr>\n<tr>\n<td>入场/退场动画</td>\n<td>可用</td>\n<td>更好（Promise 钩子）</td>\n</tr>\n<tr>\n<td>序列动画</td>\n<td>通过 delay 实现</td>\n<td>async/await 更清晰</td>\n</tr>\n<tr>\n<td>可暂停/seek 的动画</td>\n<td>不支持</td>\n<td>原生支持</td>\n</tr>\n<tr>\n<td>与滚动绑定</td>\n<td>CSS scroll-timeline</td>\n<td>ScrollTimeline</td>\n</tr>\n</tbody></table>\n<h2 id=\"核心概念\">核心概念</h2><ul>\n<li><strong>Element.animate()</strong>：在元素上创建并立即播放 WAAPI 动画，返回 <code>Animation</code> 对象</li>\n<li><strong>Animation 对象</strong>：提供 <code>play()</code>/<code>pause()</code>/<code>reverse()</code>/<code>cancel()</code>/<code>seek</code> 等完整播放控制</li>\n<li><strong>animation.finished</strong>：Promise，在动画完成时 resolve；用于序列动画的 <code>async/await</code> 链</li>\n<li><strong>animation.ready</strong>：Promise，在动画开始播放时 resolve；适合在动画启动后立即执行逻辑</li>\n<li><strong>getAnimations()</strong>：查询元素上所有正在运行的动画（含 CSS 动画和 transition）</li>\n<li><strong>ScrollTimeline / ViewTimeline</strong>：将动画进度绑定到滚动位置或元素可见性，而非时间</li>\n</ul>\n<h2 id=\"小结\">小结</h2><p>Web Animations API 是 CSS 动画的 JavaScript 等价物，增加了 CSS 缺少的精确播放控制和 Promise 钩子。对于需要程序控制的动画（序列、可暂停、动态 seek），WAAPI 是原生的最佳选择；更复杂的编排场景升级到 GSAP。</p>\n<h2 id=\"本章导航\">本章导航</h2><ul>\n<li>上一篇：<a href=\"css-transitions-animations\">CSS 过渡与动画</a> — transition/@keyframes/@property</li>\n<li>章节概览：<a href=\"../foundations/\">动画基础</a></li>\n<li>下一章：<a href=\"../libraries/\">动画库</a> — GSAP、Framer Motion、react-spring</li>\n</ul>\n","headings":[{"level":1,"text":"Web Animations API：命令式动画控制","id":"web-animations-api-命令式动画控制"},{"level":2,"text":"Element.animate()：创建动画","id":"element-animate-创建动画"},{"level":3,"text":"关键帧格式","id":"关键帧格式"},{"level":3,"text":"KeyframeEffect 选项","id":"keyframeeffect-选项"},{"level":2,"text":"Animation 对象：播放控制","id":"animation-对象-播放控制"},{"level":3,"text":"Promise 钩子","id":"promise-钩子"},{"level":2,"text":"getAnimations() 与动画查询","id":"getanimations-与动画查询"},{"level":3,"text":"拦截 CSS 动画","id":"拦截-css-动画"},{"level":2,"text":"AnimationTimeline 与 ScrollTimeline","id":"animationtimeline-与-scrolltimeline"},{"level":3,"text":"DocumentTimeline（默认）","id":"documenttimeline-默认"},{"level":3,"text":"ScrollTimeline（滚动驱动）","id":"scrolltimeline-滚动驱动"},{"level":2,"text":"组合动画效果：KeyframeEffect 与 GroupEffect","id":"组合动画效果-keyframeeffect-与-groupeffect"},{"level":2,"text":"WAAPI vs CSS 动画的实际选择","id":"waapi-vs-css-动画的实际选择"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"本章导航","id":"本章导航"}],"prev":{"title":"CSS 过渡与动画：transition、@keyframes 与 @property","url":"/l-doc-books/h/frontend/web-animation-engineering/foundations/css-transitions-animations"},"next":{"title":"GSAP 工程实践：timeline、ScrollTrigger 与性能优先原则","url":"/l-doc-books/h/frontend/web-animation-engineering/libraries/gsap-engineering"}}