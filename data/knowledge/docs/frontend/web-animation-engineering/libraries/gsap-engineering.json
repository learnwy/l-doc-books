></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Pin：固定元素直到动画完成</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ScrollTrigger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  trigger: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'.sticky-section'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  start: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'top top'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  end: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'+=500'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 再滚动 500px 后释放</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  pin: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  pinSpacing: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"scrolltrigger-调试技巧\">ScrollTrigger 调试技巧</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 可视化 trigger 和 scrub 标记线&#10;ScrollTrigger.create({&#10;  trigger: &#39;.element&#39;,&#10;  start: &#39;top 60%&#39;,&#10;  markers: process.env.NODE_ENV === &#39;development&#39;, // 仅开发环境显示&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 可视化 trigger 和 scrub 标记线</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ScrollTrigger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  trigger: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'.element'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  start: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'top 60%'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  markers: process.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NODE_ENV</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'development'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 仅开发环境显示</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"性能注意事项\">性能注意事项</h2><p><strong>GSAP 内部使用 requestAnimationFrame</strong>，并在内部维护全局 tick 系统，多个动画共享一个 rAF 循环，比手动创建多个 rAF 更高效。</p>\n<p><strong>DOM 操作批量化</strong>：GSAP 会在每个 tick 结束时批量写入 DOM，避免强制同步布局。</p>\n<p><strong>ScrollTrigger 的 ResizeObserver 集成</strong>：ScrollTrigger 监听容器尺寸变化并自动刷新 trigger 位置，但频繁 resize 时可能有性能压力——可用 <code>ScrollTrigger.config({ limitCallbacks: true })</code> 降低频率。</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 组件卸载时清理（React）&#10;useEffect(() =&gt; {&#10;  const ctx = gsap.context(() =&gt; {&#10;    // 所有在这里创建的动画和 ScrollTrigger 都会被 ctx.revert() 清理&#10;    gsap.from(&#39;.element&#39;, { y: 30, opacity: 0 })&#10;    ScrollTrigger.create({ trigger: &#39;.section&#39;, ... })&#10;  }, containerRef)&#10;&#10;  return () =&gt; ctx.revert()&#10;}, [])\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 组件卸载时清理（React）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">useEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ctx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> gsap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 所有在这里创建的动画和 ScrollTrigger 都会被 ctx.revert() 清理</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    gsap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'.element'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { y: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">30</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, opacity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ScrollTrigger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ trigger: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'.section'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }, containerRef)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">revert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}, [])</span></span></code></pre></div><h2 id=\"核心概念\">核心概念</h2><ul>\n<li><strong>gsap.to / from / fromTo</strong>：三个基础补间方法；<code>x</code>/<code>y</code>/<code>rotation</code>/<code>scale</code> 自动映射到 transform，避免属性覆盖问题</li>\n<li><strong>Timeline</strong>：将多个补间组织成有序序列，支持相对/绝对/标签三种时间定位；可嵌套、可控制（play/pause/seek/timeScale）</li>\n<li><strong>stagger</strong>：批量元素交错动画；<code>from</code> 参数控制扩散方向（center/edges/random），<code>grid</code> 支持二维网格</li>\n<li><strong>ScrollTrigger</strong>：滚动触发插件；<code>scrub</code> 实现动画与滚动进度同步，<code>pin</code> 固定元素</li>\n<li><strong>gsap.context()</strong>：React/Vue 等框架中的生命周期管理工具，确保动画在组件卸载时被清理</li>\n</ul>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[&quot;gsap.to/from/fromTo&lt;br/&gt;单次补间&quot;] --&gt; B[&quot;gsap.timeline()&lt;br/&gt;时间轴编排&quot;]&#10;    B --&gt; C[&quot;stagger&lt;br/&gt;批量交错&quot;]&#10;    B --&gt; D[&quot;ScrollTrigger&lt;br/&gt;滚动联动&quot;]&#10;    D --&gt; E[&quot;scrub&lt;br/&gt;滚动同步&quot;]&#10;    D --&gt; F[&quot;pin&lt;br/&gt;固定元素&quot;]\">graph LR\n    A[\"gsap.to/from/fromTo&lt;br/&gt;单次补间\"] --&gt; B[\"gsap.timeline()&lt;br/&gt;时间轴编排\"]\n    B --&gt; C[\"stagger&lt;br/&gt;批量交错\"]\n    B --&gt; D[\"ScrollTrigger&lt;br/&gt;滚动联动\"]\n    D --&gt; E[\"scrub&lt;br/&gt;滚动同步\"]\n    D --&gt; F[\"pin&lt;br/&gt;固定元素\"]</pre><h2 id=\"小结\">小结</h2><p>GSAP 的核心价值是工业级 Timeline 编排和 ScrollTrigger 滚动联动，适合需要精确时序控制的复杂动画序列。在 React 项目中使用 <code>gsap.context()</code> 管理清理，避免内存泄漏。下一篇介绍 Framer Motion 的声明式 React 动画系统。</p>\n<h2 id=\"本章导航\">本章导航</h2><ul>\n<li>下一篇：<a href=\"framer-motion\">Framer Motion</a> — React 声明式动画系统</li>\n<li>章节概览：<a href=\"../libraries/\">动画库</a></li>\n<li>相关：<a href=\"../performance/orchestration-stagger\">编排与交错</a> — 高级 GSAP 编排模式</li>\n</ul>\n","headings":[{"level":1,"text":"GSAP 工程实践：timeline、ScrollTrigger 与性能优先原则","id":"gsap-工程实践-timeline-scrolltrigger-与性能优先原则"},{"level":2,"text":"GSAP 核心 API","id":"gsap-核心-api"},{"level":3,"text":"gsap.to / gsap.from / gsap.fromTo","id":"gsap-to-gsap-from-gsap-fromto"},{"level":3,"text":"GSAP 缓动函数系统","id":"gsap-缓动函数系统"},{"level":2,"text":"GSAP Timeline：时间轴编排","id":"gsap-timeline-时间轴编排"},{"level":3,"text":"Timeline 控制","id":"timeline-控制"},{"level":2,"text":"stagger：批量元素交错","id":"stagger-批量元素交错"},{"level":2,"text":"ScrollTrigger：滚动触发动画","id":"scrolltrigger-滚动触发动画"},{"level":3,"text":"ScrollTrigger 调试技巧","id":"scrolltrigger-调试技巧"},{"level":2,"text":"性能注意事项","id":"性能注意事项"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"本章导航","id":"本章导航"}],"prev":{"title":"Web Animations API：命令式动画控制","url":"/l-doc-books/h/frontend/web-animation-engineering/foundations/web-animations-api"},"next":{"title":"Framer Motion：React 声明式动画系统","url":"/l-doc-books/h/frontend/web-animation-engineering/libraries/framer-motion"}}