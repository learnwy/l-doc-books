pan></span></span>\n<span class=\"line\"><span>COPY package.json pnpm-lock.yaml ./</span></span>\n<span class=\"line\"><span>RUN pnpm install --frozen-lockfile</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>COPY . .</span></span>\n<span class=\"line\"><span>RUN pnpm build</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>FROM nginx:alpine</span></span>\n<span class=\"line\"><span>COPY --from=builder /app/dist /usr/share/nginx/html</span></span>\n<span class=\"line\"><span>COPY nginx.conf /etc/nginx/conf.d/default.conf</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>EXPOSE 80</span></span>\n<span class=\"line\"><span>CMD [\"nginx\", \"-g\", \"daemon off;\"]</span></span></code></pre></div><h3 id=\"版本化部署与回滚\">版本化部署与回滚</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"- name: Deploy with version tag&#10;  run: |&#10;    VERSION=$(git rev-parse --short HEAD)&#10;    aws s3 sync dist/ s3://my-bucket/releases/$VERSION/&#10;    aws s3 sync dist/ s3://my-bucket/latest/\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">- </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Deploy with version tag</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    VERSION=$(git rev-parse --short HEAD)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    aws s3 sync dist/ s3://my-bucket/releases/$VERSION/</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    aws s3 sync dist/ s3://my-bucket/latest/</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>CI/CD 将构建流程自动化：lint → typecheck → test → build → deploy。</li>\n<li>依赖缓存（pnpm store cache）是 CI 性能优化的第一步。</li>\n<li>独立任务并行执行（lint/typecheck/test 并行）缩短总体流水线时间。</li>\n<li>环境变量通过 Secrets/Variables 安全管理，构建时注入。</li>\n<li>部署策略包括静态站点（S3 + CDN）和容器化（Docker + Nginx）。</li>\n<li>版本化部署支持快速回滚。</li>\n</ul>\n","headings":[{"level":1,"text":"CI/CD 集成","id":"ci-cd-集成"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"构建流水线在 CI/CD 中的角色","id":"构建流水线在-ci-cd-中的角色"},{"level":2,"text":"GitHub Actions 配置","id":"github-actions-配置"},{"level":3,"text":"基础 CI 流水线","id":"基础-ci-流水线"},{"level":3,"text":"部署流水线","id":"部署流水线"},{"level":2,"text":"CI 中的依赖缓存","id":"ci-中的依赖缓存"},{"level":2,"text":"并行化 CI 任务","id":"并行化-ci-任务"},{"level":2,"text":"环境变量与密钥管理","id":"环境变量与密钥管理"},{"level":2,"text":"部署策略","id":"部署策略"},{"level":3,"text":"静态站点部署","id":"静态站点部署"},{"level":3,"text":"容器化部署","id":"容器化部署"},{"level":3,"text":"版本化部署与回滚","id":"版本化部署与回滚"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"压缩与压缩","url":"/l-doc-books/h/frontend/build-toolchain/optimization/minification-and-compression"},"next":{"title":"Monorepo 构建策略","url":"/l-doc-books/h/frontend/build-toolchain/pipeline-and-devops/monorepo-build-strategies"}}