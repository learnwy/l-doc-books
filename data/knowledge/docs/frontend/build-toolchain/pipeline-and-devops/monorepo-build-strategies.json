affected</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --target=build</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 只测试受影响的包</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> affected</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --target=test</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 可视化依赖图</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">nx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> graph</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    CHANGE[代码变更&lt;br/&gt;packages/utils/src/format.ts]&#10;    UTILS[packages/utils&lt;br/&gt;直接受影响]&#10;    UI[packages/ui&lt;br/&gt;间接受影响]&#10;    WEB[apps/web&lt;br/&gt;间接受影响]&#10;    ADMIN[apps/admin&lt;br/&gt;间接受影响]&#10;    CONFIG[packages/config&lt;br/&gt;不受影响]&#10;&#10;    CHANGE --&gt; UTILS&#10;    UTILS --&gt; UI&#10;    UI --&gt; WEB&#10;    UI --&gt; ADMIN&#10;    UTILS --&gt; WEB&#10;    UTILS --&gt; ADMIN&#10;\">flowchart TD\n    CHANGE[代码变更&lt;br/&gt;packages/utils/src/format.ts]\n    UTILS[packages/utils&lt;br/&gt;直接受影响]\n    UI[packages/ui&lt;br/&gt;间接受影响]\n    WEB[apps/web&lt;br/&gt;间接受影响]\n    ADMIN[apps/admin&lt;br/&gt;间接受影响]\n    CONFIG[packages/config&lt;br/&gt;不受影响]\n\n    CHANGE --&gt; UTILS\n    UTILS --&gt; UI\n    UI --&gt; WEB\n    UI --&gt; ADMIN\n    UTILS --&gt; WEB\n    UTILS --&gt; ADMIN\n</pre><hr>\n<h2 id=\"turborepo-vs-nx-对比\">Turborepo vs Nx 对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Turborepo</th>\n<th>Nx</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>定位</td>\n<td>轻量级任务编排</td>\n<td>全功能 Monorepo 平台</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>低</td>\n<td>中高</td>\n</tr>\n<tr>\n<td>配置量</td>\n<td>少</td>\n<td>多（但更精细）</td>\n</tr>\n<tr>\n<td>远程缓存</td>\n<td>Vercel Remote Cache</td>\n<td>Nx Cloud</td>\n</tr>\n<tr>\n<td>受影响包分析</td>\n<td>基于 Git diff</td>\n<td>基于项目图分析</td>\n</tr>\n<tr>\n<td>代码生成器</td>\n<td>无</td>\n<td>内置</td>\n</tr>\n<tr>\n<td>IDE 集成</td>\n<td>无</td>\n<td>VS Code 扩展</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>中小型 Monorepo</td>\n<td>大型企业级 Monorepo</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"ci-中的-monorepo-构建\">CI 中的 Monorepo 构建</h2><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# .github/workflows/ci.yml - Turborepo + GitHub Actions&#10;name: CI&#10;&#10;on:&#10;  push:&#10;    branches: [main]&#10;  pull_request:&#10;&#10;jobs:&#10;  build:&#10;    runs-on: ubuntu-latest&#10;    steps:&#10;      - uses: actions/checkout@v4&#10;        with:&#10;          fetch-depth: 2&#10;&#10;      - uses: pnpm/action-setup@v4&#10;      - uses: actions/setup-node@v4&#10;        with:&#10;          node-version: 22&#10;          cache: pnpm&#10;&#10;      - run: pnpm install --frozen-lockfile&#10;&#10;      - name: Build affected packages&#10;        run: turbo build --filter=...[HEAD^1]&#10;        env:&#10;          TURBO_TOKEN: ${{ secrets.TURBO_TOKEN }}&#10;          TURBO_TEAM: ${{ vars.TURBO_TEAM }}&#10;&#10;      - name: Test affected packages&#10;        run: turbo test --filter=...[HEAD^1]\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># .github/workflows/ci.yml - Turborepo + GitHub Actions</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">CI</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    branches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  pull_request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/checkout@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          fetch-depth</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm/action-setup@v4</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/setup-node@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          node-version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">22</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          cache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm install --frozen-lockfile</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Build affected packages</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">turbo build --filter=...[HEAD^1]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        env</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          TURBO_TOKEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ secrets.TURBO_TOKEN }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          TURBO_TEAM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ vars.TURBO_TEAM }}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Test affected packages</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">turbo test --filter=...[HEAD^1]</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Monorepo 的核心挑战是构建编排：依赖顺序、并行执行、变更检测。</li>\n<li>pnpm Workspace 通过符号链接管理包间依赖。</li>\n<li>Turborepo 以任务图为核心，自动推导构建顺序并并行执行。</li>\n<li><code>--filter</code> 语法实现了只构建变更包及其下游消费者。</li>\n<li>Nx 提供更全面的功能（代码生成、可视化依赖图、IDE 集成）。</li>\n<li>CI 中结合 <code>--filter=...[HEAD^1]</code> 和远程缓存，大幅缩短流水线时间。</li>\n</ul>\n","headings":[{"level":1,"text":"Monorepo 构建策略","id":"monorepo-构建策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Monorepo 的构建挑战","id":"monorepo-的构建挑战"},{"level":2,"text":"包管理器的 Workspace 支持","id":"包管理器的-workspace-支持"},{"level":3,"text":"pnpm Workspace","id":"pnpm-workspace"},{"level":2,"text":"Turborepo：任务编排引擎","id":"turborepo-任务编排引擎"},{"level":3,"text":"核心概念","id":"核心概念"},{"level":3,"text":"配置","id":"配置"},{"level":3,"text":"命令使用","id":"命令使用"},{"level":3,"text":"过滤语法","id":"过滤语法"},{"level":2,"text":"Nx：全功能 Monorepo 平台","id":"nx-全功能-monorepo-平台"},{"level":3,"text":"Nx 配置","id":"nx-配置"},{"level":3,"text":"Nx 的受影响包分析","id":"nx-的受影响包分析"},{"level":2,"text":"Turborepo vs Nx 对比","id":"turborepo-vs-nx-对比"},{"level":2,"text":"CI 中的 Monorepo 构建","id":"ci-中的-monorepo-构建"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"CI/CD 集成","url":"/l-doc-books/h/frontend/build-toolchain/pipeline-and-devops/ci-cd-integration"},"next":{"title":"缓存与增量构建","url":"/l-doc-books/h/frontend/build-toolchain/pipeline-and-devops/caching-and-incremental-builds"}}