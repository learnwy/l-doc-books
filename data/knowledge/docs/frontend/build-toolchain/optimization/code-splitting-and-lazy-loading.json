pan style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> vendorGroups</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              'react-vendor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'react'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'react-dom'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'react-router-dom'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              'ui-vendor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'@radix-ui'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'@headlessui'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">              'chart-vendor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'recharts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'d3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">group</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">packages</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">entries</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(vendorGroups)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">              if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (packages.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">some</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pkg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> packageName.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">startsWith</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pkg))) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> group;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">              }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vendor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"分割策略的衡量指标\">分割策略的衡量指标</h2><table>\n<thead>\n<tr>\n<th>指标</th>\n<th>说明</th>\n<th>目标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>首屏 JS 大小</td>\n<td>首次加载需要下载的 JS 总量</td>\n<td>&lt; 200KB (gzipped)</td>\n</tr>\n<tr>\n<td>Chunk 数量</td>\n<td>初始加载的 Chunk 数</td>\n<td>3-6 个</td>\n</tr>\n<tr>\n<td>最大 Chunk</td>\n<td>单个 Chunk 的最大体积</td>\n<td>&lt; 300KB (gzipped)</td>\n</tr>\n<tr>\n<td>缓存命中率</td>\n<td>代码变更后可复用的 Chunk 比例</td>\n<td>&gt; 80%</td>\n</tr>\n<tr>\n<td>瀑布流深度</td>\n<td>异步 Chunk 的级联加载深度</td>\n<td>≤ 2 级</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"避免过度分割\">避免过度分割</h2><p>代码分割不是越多越好。过度分割会导致：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph &quot;适度分割 ✅&quot;&#10;        MAIN_OK[main.js 100KB]&#10;        VENDOR_OK[vendor.js 150KB]&#10;        ROUTE_OK[route-a.js 50KB]&#10;    end&#10;    subgraph &quot;过度分割 ❌&quot;&#10;        CHUNK1[chunk-1.js 5KB]&#10;        CHUNK2[chunk-2.js 3KB]&#10;        CHUNK3[chunk-3.js 8KB]&#10;        CHUNK4[chunk-4.js 2KB]&#10;        CHUNK5[...100 个小 chunk]&#10;    end\">flowchart TD\n    subgraph \"适度分割 ✅\"\n        MAIN_OK[main.js 100KB]\n        VENDOR_OK[vendor.js 150KB]\n        ROUTE_OK[route-a.js 50KB]\n    end\n    subgraph \"过度分割 ❌\"\n        CHUNK1[chunk-1.js 5KB]\n        CHUNK2[chunk-2.js 3KB]\n        CHUNK3[chunk-3.js 8KB]\n        CHUNK4[chunk-4.js 2KB]\n        CHUNK5[...100 个小 chunk]\n    end</pre><ul>\n<li>过多的 HTTP 请求增加网络开销（即使有 HTTP/2 多路复用）</li>\n<li>极小的 Chunk 的 gzip 压缩效率低</li>\n<li>过多的 Chunk 增加浏览器的解析和编译开销</li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>代码分割通过将大 Bundle 拆分为多个小 Chunk，实现按需加载。</li>\n<li>三种核心策略：入口点分割、动态导入、vendor 分离。</li>\n<li>React.lazy + Suspense 是 React 应用的标准懒加载方案。</li>\n<li>预加载（鼠标悬停时触发 import()）可以消除懒加载的感知延迟。</li>\n<li>Vite 的 manualChunks 提供了灵活的分割控制。</li>\n<li>避免过度分割——首屏保持 3-6 个 Chunk，单个 Chunk 不超过 300KB。</li>\n</ul>\n","headings":[{"level":1,"text":"代码分割与懒加载","id":"代码分割与懒加载"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要代码分割","id":"为什么需要代码分割"},{"level":2,"text":"代码分割的三种策略","id":"代码分割的三种策略"},{"level":3,"text":"1. 入口点分割（Multi-Entry）","id":"1-入口点分割-multi-entry"},{"level":3,"text":"2. 动态导入（Dynamic Import）","id":"2-动态导入-dynamic-import"},{"level":3,"text":"3. Vendor 分割","id":"3-vendor-分割"},{"level":2,"text":"React 中的懒加载","id":"react-中的懒加载"},{"level":3,"text":"React.lazy + Suspense","id":"react-lazy-suspense"},{"level":3,"text":"组件级别的懒加载","id":"组件级别的懒加载"},{"level":3,"text":"预加载（Preload）策略","id":"预加载-preload-策略"},{"level":2,"text":"Vite 中的代码分割","id":"vite-中的代码分割"},{"level":3,"text":"基于函数的 manualChunks","id":"基于函数的-manualchunks"},{"level":2,"text":"分割策略的衡量指标","id":"分割策略的衡量指标"},{"level":2,"text":"避免过度分割","id":"避免过度分割"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Tree-shaking 与死代码消除","url":"/l-doc-books/h/frontend/build-toolchain/optimization/tree-shaking-and-dead-code"},"next":{"title":"压缩与压缩","url":"/l-doc-books/h/frontend/build-toolchain/optimization/minification-and-compression"}}