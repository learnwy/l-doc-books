</span></code></pre></div><h3 id=\"基于函数的-manualchunks\">基于函数的 manualChunks</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export default defineConfig({&#10;  build: {&#10;    rollupOptions: {&#10;      output: {&#10;        manualChunks(id) {&#10;          if (id.includes(&#39;node_modules&#39;)) {&#10;            const segments = id.split(&#39;node_modules/&#39;);&#10;            const packageName = segments[segments.length - 1].split(&#39;/&#39;)[0];&#10;&#10;            const vendorGroups = {&#10;              &#39;react-vendor&#39;: [&#39;react&#39;, &#39;react-dom&#39;, &#39;react-router-dom&#39;],&#10;              &#39;ui-vendor&#39;: [&#39;@radix-ui&#39;, &#39;@headlessui&#39;],&#10;              &#39;chart-vendor&#39;: [&#39;recharts&#39;, &#39;d3&#39;],&#10;            };&#10;&#10;            for (const [group, packages] of Object.entries(vendorGroups)) {&#10;              if (packages.some((pkg) =&gt; packageName.startsWith(pkg))) {&#10;                return group;&#10;              }&#10;            }&#10;&#10;            return &#39;vendor&#39;;&#10;          }&#10;        },&#10;      },&#10;    },&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  build: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rollupOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      output: {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--