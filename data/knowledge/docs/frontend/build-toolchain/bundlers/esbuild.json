style=\"color:#24292E;--shiki-dark:#E1E4E8\">      path: args.path,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      namespace: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'env-ns'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    build.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onLoad</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ filter:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, namespace: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'env-ns'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      contents: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(process.env),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      loader: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esbuild.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  entryPoints: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'src/index.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bundle: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  outdir: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dist'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  plugins: [envPlugin],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"插件钩子\">插件钩子</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    RESOLVE[onResolve&lt;br/&gt;拦截模块解析]&#10;    LOAD[onLoad&lt;br/&gt;拦截模块加载]&#10;    START[onStart&lt;br/&gt;构建开始]&#10;    END[onEnd&lt;br/&gt;构建结束]&#10;&#10;    START --&gt; RESOLVE&#10;    RESOLVE --&gt; LOAD&#10;    LOAD --&gt; RESOLVE&#10;    LOAD --&gt; END\">flowchart TD\n    RESOLVE[onResolve&lt;br/&gt;拦截模块解析]\n    LOAD[onLoad&lt;br/&gt;拦截模块加载]\n    START[onStart&lt;br/&gt;构建开始]\n    END[onEnd&lt;br/&gt;构建结束]\n\n    START --&gt; RESOLVE\n    RESOLVE --&gt; LOAD\n    LOAD --&gt; RESOLVE\n    LOAD --&gt; END</pre><hr>\n<h2 id=\"esbuild-的局限性\">esbuild 的局限性</h2><p>尽管 esbuild 极其快速，但它有意识地做出了一些取舍：</p>\n<table>\n<thead>\n<tr>\n<th>限制</th>\n<th>说明</th>\n<th>替代方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>不做类型检查</td>\n<td>esbuild 只剥离类型注解，不验证类型正确性</td>\n<td>并行运行 tsc --noEmit</td>\n</tr>\n<tr>\n<td>不支持某些 TS 特性</td>\n<td>const enum、装饰器元数据等需要类型信息的特性</td>\n<td>使用 SWC 或 tsc</td>\n</tr>\n<tr>\n<td>插件生态较小</td>\n<td>相比 Webpack/Rollup 插件数量有限</td>\n<td>自定义插件或使用上层封装</td>\n</tr>\n<tr>\n<td>CSS Modules 支持有限</td>\n<td>不支持 CSS Modules 的组合（composes）</td>\n<td>PostCSS 预处理</td>\n</tr>\n<tr>\n<td>代码分割能力有限</td>\n<td>仅支持 ESM 格式的代码分割</td>\n<td>使用 Rollup 进行生产构建</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"esbuild-在工具链中的角色\">esbuild 在工具链中的角色</h2><p>esbuild 很少被单独作为应用的最终打包工具使用。它更常见的角色是作为其他工具的底层引擎：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    ESBUILD[esbuild 核心]&#10;    VITE[Vite&lt;br/&gt;依赖预构建]&#10;    TSUP[tsup&lt;br/&gt;TS 库打包]&#10;    TSX_RUNNER[tsx&lt;br/&gt;TS 直接运行]&#10;    VITEST[Vitest&lt;br/&gt;测试转换]&#10;&#10;    ESBUILD --&gt; VITE&#10;    ESBUILD --&gt; TSUP&#10;    ESBUILD --&gt; TSX_RUNNER&#10;    ESBUILD --&gt; VITEST\">graph TB\n    ESBUILD[esbuild 核心]\n    VITE[Vite&lt;br/&gt;依赖预构建]\n    TSUP[tsup&lt;br/&gt;TS 库打包]\n    TSX_RUNNER[tsx&lt;br/&gt;TS 直接运行]\n    VITEST[Vitest&lt;br/&gt;测试转换]\n\n    ESBUILD --&gt; VITE\n    ESBUILD --&gt; TSUP\n    ESBUILD --&gt; TSX_RUNNER\n    ESBUILD --&gt; VITEST</pre><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// tsup - 基于 esbuild 的 TS 库打包工具&#10;// tsup.config.ts&#10;import { defineConfig } from &#39;tsup&#39;;&#10;&#10;export default defineConfig({&#10;  entry: [&#39;src/index.ts&#39;],&#10;  format: [&#39;cjs&#39;, &#39;esm&#39;],&#10;  dts: true,&#10;  splitting: true,&#10;  sourcemap: true,&#10;  clean: true,&#10;  minify: true,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// tsup - 基于 esbuild 的 TS 库打包工具</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// tsup.config.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { defineConfig } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'tsup'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  entry: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'src/index.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  format: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cjs'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  dts: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  splitting: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sourcemap: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  clean: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  minify: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"build-api-vs-transform-api\">Build API vs Transform API</h2><p>esbuild 提供两个核心 API：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"import * as esbuild from &#39;esbuild&#39;;&#10;&#10;// Build API - 完整的打包流程&#10;const buildResult = await esbuild.build({&#10;  entryPoints: [&#39;src/index.ts&#39;],&#10;  bundle: true,&#10;  write: false,&#10;});&#10;console.log(buildResult.outputFiles);&#10;&#10;// Transform API - 单文件转换&#10;const transformResult = await esbuild.transform(&#39;let x: number = 1&#39;, {&#10;  loader: &#39;ts&#39;,&#10;});&#10;console.log(transformResult.code);&#10;&#10;// Context API - 增量构建和 Watch 模式&#10;const ctx = await esbuild.context({&#10;  entryPoints: [&#39;src/index.ts&#39;],&#10;  bundle: true,&#10;  outdir: &#39;dist&#39;,&#10;});&#10;&#10;await ctx.watch();&#10;const { host, port } = await ctx.serve({ servedir: &#39;public&#39; });&#10;console.log(`Serving at http://${host}:${port}`);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esbuild </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'esbuild'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Build API - 完整的打包流程</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> buildResult</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esbuild.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  entryPoints: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'src/index.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bundle: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  write: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(buildResult.outputFiles);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Transform API - 单文件转换</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> transformResult</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esbuild.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'let x: number = 1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  loader: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(transformResult.code);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Context API - 增量构建和 Watch 模式</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ctx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esbuild.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  entryPoints: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'src/index.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bundle: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  outdir: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dist'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">watch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">host</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">serve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ servedir: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'public'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Serving at http://${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">host</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">port</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>esbuild 用 Go 语言编写，构建速度比 JavaScript 工具快 10-100 倍。</li>\n<li>性能优势来自原生编译、自研解析器、充分并行和最小内存分配。</li>\n<li>esbuild 支持打包、转换、压缩和开发服务器。</li>\n<li>有意的取舍：不做类型检查、有限的代码分割、较小的插件生态。</li>\n<li>esbuild 最常见的角色是作为其他工具（Vite、tsup、Vitest）的底层引擎。</li>\n<li>Build API 用于完整打包，Transform API 用于单文件转换，Context API 用于增量构建。</li>\n</ul>\n","headings":[{"level":1,"text":"esbuild 极速构建工具","id":"esbuild-极速构建工具"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"极速构建的先驱","id":"极速构建的先驱"},{"level":2,"text":"为什么这么快？","id":"为什么这么快"},{"level":3,"text":"1. Go 语言的原生性能","id":"1-go-语言的原生性能"},{"level":3,"text":"2. 从零实现的解析器","id":"2-从零实现的解析器"},{"level":3,"text":"3. 充分的并行化","id":"3-充分的并行化"},{"level":3,"text":"4. 最小化内存分配","id":"4-最小化内存分配"},{"level":2,"text":"核心功能","id":"核心功能"},{"level":3,"text":"打包","id":"打包"},{"level":3,"text":"转换（不打包）","id":"转换-不打包"},{"level":3,"text":"CLI 使用","id":"cli-使用"},{"level":2,"text":"配置详解","id":"配置详解"},{"level":3,"text":"入口与输出","id":"入口与输出"},{"level":3,"text":"Loader 配置","id":"loader-配置"},{"level":3,"text":"外部依赖","id":"外部依赖"},{"level":3,"text":"Define 和环境变量","id":"define-和环境变量"},{"level":2,"text":"插件系统","id":"插件系统"},{"level":3,"text":"插件钩子","id":"插件钩子"},{"level":2,"text":"esbuild 的局限性","id":"esbuild-的局限性"},{"level":2,"text":"esbuild 在工具链中的角色","id":"esbuild-在工具链中的角色"},{"level":2,"text":"Build API vs Transform API","id":"build-api-vs-transform-api"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Rollup 与 Rolldown","url":"/l-doc-books/h/frontend/build-toolchain/bundlers/rollup-and-rolldown"},"next":{"title":"tsc 与 TypeScript 编译","url":"/l-doc-books/h/frontend/build-toolchain/compilers-and-transpilers/tsc-and-typescript-compilation"}}