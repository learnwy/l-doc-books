#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          priority: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          reuseExistingChunk: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><hr>\n<h2 id=\"webpack-的编译流程\">Webpack 的编译流程</h2><p>Webpack 的编译过程可以分为三个主要阶段：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph 初始化阶段&#10;        CONFIG[读取配置] --&gt; MERGE[合并默认配置]&#10;        MERGE --&gt; COMPILER[创建 Compiler]&#10;        COMPILER --&gt; PLUGINS[注册 Plugins]&#10;    end&#10;    subgraph 构建阶段&#10;        PLUGINS --&gt; ENTRY_RESOLVE[解析入口]&#10;        ENTRY_RESOLVE --&gt; BUILD_MODULE[构建模块]&#10;        BUILD_MODULE --&gt; LOADER_RUN[执行 Loader 链]&#10;        LOADER_RUN --&gt; PARSE_AST[解析 AST]&#10;        PARSE_AST --&gt; FIND_DEPS[提取依赖]&#10;        FIND_DEPS --&gt; BUILD_MODULE&#10;    end&#10;    subgraph 生成阶段&#10;        FIND_DEPS --&gt; CREATE_CHUNKS[创建 Chunks]&#10;        CREATE_CHUNKS --&gt; OPTIMIZE_CHUNKS[优化 Chunks]&#10;        OPTIMIZE_CHUNKS --&gt; EMIT[输出文件]&#10;    end\">flowchart TD\n    subgraph 初始化阶段\n        CONFIG[读取配置] --&gt; MERGE[合并默认配置]\n        MERGE --&gt; COMPILER[创建 Compiler]\n        COMPILER --&gt; PLUGINS[注册 Plugins]\n    end\n    subgraph 构建阶段\n        PLUGINS --&gt; ENTRY_RESOLVE[解析入口]\n        ENTRY_RESOLVE --&gt; BUILD_MODULE[构建模块]\n        BUILD_MODULE --&gt; LOADER_RUN[执行 Loader 链]\n        LOADER_RUN --&gt; PARSE_AST[解析 AST]\n        PARSE_AST --&gt; FIND_DEPS[提取依赖]\n        FIND_DEPS --&gt; BUILD_MODULE\n    end\n    subgraph 生成阶段\n        FIND_DEPS --&gt; CREATE_CHUNKS[创建 Chunks]\n        CREATE_CHUNKS --&gt; OPTIMIZE_CHUNKS[优化 Chunks]\n        OPTIMIZE_CHUNKS --&gt; EMIT[输出文件]\n    end</pre><hr>\n<h2 id=\"开发服务器与-hmr\">开发服务器与 HMR</h2><p>Webpack Dev Server 提供了开发环境的实时预览和热模块替换：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"export default {&#10;  devServer: {&#10;    port: 3000,&#10;    hot: true,&#10;    historyApiFallback: true,&#10;    proxy: [&#10;      {&#10;        context: [&#39;/api&#39;],&#10;        target: &#39;http://localhost:8080&#39;,&#10;        changeOrigin: true,&#10;      },&#10;    ],&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  devServer: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    port: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    hot: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    historyApiFallback: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    proxy: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        context: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        target: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'http://localhost:8080'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        changeOrigin: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>HMR（Hot Module Replacement）的工作原理：</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant Dev as 开发者&#10;    participant WDS as Webpack Dev Server&#10;    participant Browser as 浏览器&#10;    participant HMR as HMR Runtime&#10;&#10;    Dev-&gt;&gt;WDS: 修改源文件&#10;    WDS-&gt;&gt;WDS: 增量编译变更模块&#10;    WDS-&gt;&gt;Browser: WebSocket 推送更新&#10;    Browser-&gt;&gt;HMR: 检查更新&#10;    HMR-&gt;&gt;WDS: 请求更新的模块&#10;    WDS-&gt;&gt;HMR: 返回新模块代码&#10;    HMR-&gt;&gt;Browser: 替换旧模块,保留状态\">sequenceDiagram\n    participant Dev as 开发者\n    participant WDS as Webpack Dev Server\n    participant Browser as 浏览器\n    participant HMR as HMR Runtime\n\n    Dev-&gt;&gt;WDS: 修改源文件\n    WDS-&gt;&gt;WDS: 增量编译变更模块\n    WDS-&gt;&gt;Browser: WebSocket 推送更新\n    Browser-&gt;&gt;HMR: 检查更新\n    HMR-&gt;&gt;WDS: 请求更新的模块\n    WDS-&gt;&gt;HMR: 返回新模块代码\n    HMR-&gt;&gt;Browser: 替换旧模块,保留状态</pre><hr>\n<h2 id=\"webpack-5-的重要特性\">Webpack 5 的重要特性</h2><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Module Federation</td>\n<td>微前端架构，跨应用共享模块</td>\n</tr>\n<tr>\n<td>持久化缓存</td>\n<td>构建结果写入磁盘，二次构建速度大幅提升</td>\n</tr>\n<tr>\n<td>Asset Modules</td>\n<td>内置资源处理，替代 file-loader/url-loader</td>\n</tr>\n<tr>\n<td>Tree-shaking 增强</td>\n<td>支持嵌套 Tree-shaking 和内部模块优化</td>\n</tr>\n<tr>\n<td>Top-level await</td>\n<td>模块顶层支持 await</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// Module Federation 配置示例&#10;import { ModuleFederationPlugin } from &#39;webpack/container&#39;;&#10;&#10;export default {&#10;  plugins: [&#10;    new ModuleFederationPlugin({&#10;      name: &#39;host&#39;,&#10;      remotes: {&#10;        remoteApp: &#39;remoteApp@http://localhost:3001/remoteEntry.js&#39;,&#10;      },&#10;      shared: {&#10;        react: { singleton: true },&#10;        &#39;react-dom&#39;: { singleton: true },&#10;      },&#10;    }),&#10;  ],&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Module Federation 配置示例</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ModuleFederationPlugin } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'webpack/container'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  plugins: [</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ModuleFederationPlugin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'host'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      remotes: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        remoteApp: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'remoteApp@http://localhost:3001/remoteEntry.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      shared: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        react: { singleton: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'react-dom'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { singleton: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Webpack 的五大核心概念：Entry、Output、Loader、Plugin、Chunk。</li>\n<li>Loader 负责文件级转换，Plugin 介入构建流程的各个阶段。</li>\n<li>Chunk 分割策略直接影响应用的加载性能和缓存效率。</li>\n<li>HMR 通过 WebSocket 实现开发时的即时模块替换。</li>\n<li>Webpack 5 引入了 Module Federation、持久化缓存等重要特性。</li>\n<li>即便 Vite/Rspack 已成为更流行的选择，Webpack 的概念体系仍是理解打包器的基础。</li>\n</ul>\n","headings":[{"level":1,"text":"Webpack 核心概念","id":"webpack-核心概念"},{"level":2,"text":"Webpack 的设计哲学","id":"webpack-的设计哲学"},{"level":2,"text":"五大核心概念","id":"五大核心概念"},{"level":3,"text":"Entry（入口）","id":"entry-入口"},{"level":3,"text":"Output（输出）","id":"output-输出"},{"level":3,"text":"Loader（加载器）","id":"loader-加载器"},{"level":3,"text":"Plugin（插件）","id":"plugin-插件"},{"level":3,"text":"Chunk（代码块）","id":"chunk-代码块"},{"level":2,"text":"Webpack 的编译流程","id":"webpack-的编译流程"},{"level":2,"text":"开发服务器与 HMR","id":"开发服务器与-hmr"},{"level":2,"text":"Webpack 5 的重要特性","id":"webpack-5-的重要特性"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"模块系统与解析","url":"/l-doc-books/h/frontend/build-toolchain/foundations/module-systems-and-resolution"},"next":{"title":"Vite 架构","url":"/l-doc-books/h/frontend/build-toolchain/bundlers/vite-architecture"}}