-shiki-dark:#E1E4E8\">VITE_API_URL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">http://localhost:8080/api</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">VITE_APP_TITLE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">My</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> App</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Dev)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">DB_PASSWORD</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">secret</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 不会暴露给客户端</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 客户端代码中使用&#10;console.log(import.meta.env.VITE_API_URL);&#10;console.log(import.meta.env.MODE);&#10;console.log(import.meta.env.DEV);&#10;console.log(import.meta.env.PROD);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 客户端代码中使用</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">VITE_API_URL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">MODE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DEV</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">PROD</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// env.d.ts - 类型声明&#10;interface ImportMetaEnv {&#10;  readonly VITE_API_URL: string;&#10;  readonly VITE_APP_TITLE: string;&#10;}&#10;&#10;interface ImportMeta {&#10;  readonly env: ImportMetaEnv;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// env.d.ts - 类型声明</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ImportMetaEnv</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> VITE_API_URL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> VITE_APP_TITLE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ImportMeta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> env</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ImportMetaEnv</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"vite-与-webpack-的性能对比\">Vite 与 Webpack 的性能对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Webpack</th>\n<th>Vite</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>冷启动</td>\n<td>需要打包所有模块（慢）</td>\n<td>即时启动（快）</td>\n</tr>\n<tr>\n<td>HMR 速度</td>\n<td>随项目增长变慢</td>\n<td>与项目大小无关（快）</td>\n</tr>\n<tr>\n<td>生产构建</td>\n<td>成熟稳定</td>\n<td>基于 Rollup，Tree-shaking 优秀</td>\n</tr>\n<tr>\n<td>生态插件</td>\n<td>极其丰富</td>\n<td>快速增长，兼容 Rollup 插件</td>\n</tr>\n<tr>\n<td>配置复杂度</td>\n<td>高</td>\n<td>低（约定优于配置）</td>\n</tr>\n<tr>\n<td>SSR 支持</td>\n<td>需要额外配置</td>\n<td>内置支持</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Vite 采用双引擎架构：开发环境用原生 ESM + esbuild，生产环境用 Rollup。</li>\n<li>依赖预构建解决了第三方库的 CJS 兼容和请求数量问题。</li>\n<li>HMR 基于精确的模块依赖图，更新速度与项目大小无关。</li>\n<li>插件系统基于 Rollup 插件接口的超集，同时服务于开发和生产。</li>\n<li>Vite 的&quot;约定优于配置&quot;理念大幅降低了构建工具的使用门槛。</li>\n</ul>\n","headings":[{"level":1,"text":"Vite 架构","id":"vite-架构"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Vite 的设计理念","id":"vite-的设计理念"},{"level":2,"text":"双引擎架构","id":"双引擎架构"},{"level":2,"text":"开发环境：原生 ESM 驱动","id":"开发环境-原生-esm-驱动"},{"level":3,"text":"无打包开发服务器","id":"无打包开发服务器"},{"level":3,"text":"依赖预构建","id":"依赖预构建"},{"level":3,"text":"HMR 实现","id":"hmr-实现"},{"level":2,"text":"生产环境：Rollup 打包","id":"生产环境-rollup-打包"},{"level":2,"text":"插件系统","id":"插件系统"},{"level":3,"text":"插件执行顺序","id":"插件执行顺序"},{"level":3,"text":"常用官方插件","id":"常用官方插件"},{"level":2,"text":"环境变量与模式","id":"环境变量与模式"},{"level":2,"text":"Vite 与 Webpack 的性能对比","id":"vite-与-webpack-的性能对比"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Webpack 核心概念","url":"/l-doc-books/h/frontend/build-toolchain/bundlers/webpack-core-concepts"},"next":{"title":"Rollup 与 Rolldown","url":"/l-doc-books/h/frontend/build-toolchain/bundlers/rollup-and-rolldown"}}