#10;      },&#10;    },&#10;  ],&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  lib: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      format: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      bundle: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      output: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        cssModules: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          localIdentName: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'[local]--[hash:base64:5]'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"rslib-vs-其他库构建工具\">Rslib vs 其他库构建工具</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Rslib</th>\n<th>tsup</th>\n<th>Rollup</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>底层引擎</td>\n<td>Rspack (Rust)</td>\n<td>esbuild (Go)</td>\n<td>Rollup (JS)</td>\n</tr>\n<tr>\n<td>构建速度</td>\n<td>快</td>\n<td>极快</td>\n<td>中等</td>\n</tr>\n<tr>\n<td>CSS 处理</td>\n<td>完整支持</td>\n<td>有限</td>\n<td>需要插件</td>\n</tr>\n<tr>\n<td>DTS 生成</td>\n<td>内置</td>\n<td>内置</td>\n<td>需要插件</td>\n</tr>\n<tr>\n<td>Bundleless</td>\n<td>支持</td>\n<td>不支持</td>\n<td>不支持（需 tsc）</td>\n</tr>\n<tr>\n<td>配置复杂度</td>\n<td>低</td>\n<td>低</td>\n<td>中等</td>\n</tr>\n<tr>\n<td>Webpack 兼容</td>\n<td>部分</td>\n<td>无</td>\n<td>无</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Rslib 是基于 Rsbuild 的库构建专用框架，处理了库构建的常见需求。</li>\n<li>支持 Bundle 和 Bundleless 两种构建模式，适用于不同类型的库。</li>\n<li>autoExternal 自动将 dependencies 和 peerDependencies 排除。</li>\n<li>内置类型声明（.d.ts）生成能力，支持 bundle 和 bundleless 模式。</li>\n<li>对于 React/Vue 组件库，Rslib 的 Bundleless 模式 + CSS Modules 是推荐方案。</li>\n<li>与 tsup 相比，Rslib 在 CSS 处理和 Bundleless 模式上更具优势。</li>\n</ul>\n","headings":[{"level":1,"text":"Rslib 库构建工具","id":"rslib-库构建工具"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"库构建的特殊需求","id":"库构建的特殊需求"},{"level":2,"text":"Rslib 概述","id":"rslib-概述"},{"level":2,"text":"快速开始","id":"快速开始"},{"level":3,"text":"基础配置","id":"基础配置"},{"level":3,"text":"对应的 package.json","id":"对应的-package-json"},{"level":2,"text":"Bundle vs Bundleless 模式","id":"bundle-vs-bundleless-模式"},{"level":2,"text":"外部依赖处理","id":"外部依赖处理"},{"level":2,"text":"类型声明生成","id":"类型声明生成"},{"level":2,"text":"React 组件库构建","id":"react-组件库构建"},{"level":3,"text":"组件库的 CSS 处理","id":"组件库的-css-处理"},{"level":2,"text":"Rslib vs 其他库构建工具","id":"rslib-vs-其他库构建工具"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Rsbuild 构建框架","url":"/l-doc-books/h/frontend/build-toolchain/build-frameworks/rsbuild"},"next":{