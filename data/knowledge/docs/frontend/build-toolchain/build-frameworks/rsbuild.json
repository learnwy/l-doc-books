\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  plugins: [</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pluginReact</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  source: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    alias: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'@'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./src'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"module-federation-支持\">Module Federation 支持</h2><p>Rsbuild 通过 <code>@module-federation/rsbuild-plugin</code> 支持微前端架构：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { defineConfig } from &#39;@rsbuild/core&#39;;&#10;import { pluginModuleFederation } from &#39;@module-federation/rsbuild-plugin&#39;;&#10;&#10;export default defineConfig({&#10;  plugins: [&#10;    pluginModuleFederation({&#10;      name: &#39;host&#39;,&#10;      remotes: {&#10;        remote: &#39;remote@http://localhost:3001/mf-manifest.json&#39;,&#10;      },&#10;      shared: [&#39;react&#39;, &#39;react-dom&#39;],&#10;    }),&#10;  ],&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { defineConfig } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@rsbuild/core'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { pluginModuleFederation } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@module-federation/rsbuild-plugin'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  plugins: [</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    pluginModuleFederation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'host'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      remotes: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        remote: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'remote@http://localhost:3001/mf-manifest.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      shared: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'react'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'react-dom'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Rsbuild 是基于 Rspack 的开箱即用构建框架，构建速度比 Webpack 快 5-10 倍。</li>\n<li>内置 TypeScript、CSS Modules、PostCSS、HMR、代码分割等常用功能。</li>\n<li>插件系统类型安全，官方提供了 React/Vue/Sass/Less 等常用插件。</li>\n<li>支持多环境构建（web + node）和 Module Federation 微前端。</li>\n<li>从 Webpack 迁移路径平滑，大部分配置可直接映射或简化。</li>\n</ul>\n","headings":[{"level":1,"text":"Rsbuild 构建框架","id":"rsbuild-构建框架"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Rsbuild 概述","id":"rsbuild-概述"},{"level":2,"text":"快速开始","id":"快速开始"},{"level":3,"text":"创建项目","id":"创建项目"},{"level":3,"text":"基础配置","id":"基础配置"},{"level":3,"text":"开发和构建","id":"开发和构建"},{"level":2,"text":"核心特性","id":"核心特性"},{"level":3,"text":"开箱即用","id":"开箱即用"},{"level":3,"text":"性能优势","id":"性能优势"},{"level":3,"text":"插件系统","id":"插件系统"},{"level":2,"text":"代理与开发服务器","id":"代理与开发服务器"},{"level":2,"text":"多环境构建","id":"多环境构建"},{"level":2,"text":"从 Webpack 迁移到 Rsbuild","id":"从-webpack-迁移到-rsbuild"},{"level":2,"text":"Module Federation 支持","id":"module-federation-支持"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"PostCSS 与 CSS 处理","url":"/l-doc-books/h/frontend/build-toolchain/compilers-and-transpilers/postcss-and-css-processing"},"next":{"title":"Rslib 库构建工具","url":"/l-doc-books/h/frontend/build-toolchain/build-frameworks/rslib"}}