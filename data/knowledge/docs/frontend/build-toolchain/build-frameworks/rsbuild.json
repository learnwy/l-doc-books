or:#24292E;--shiki-dark:#E1E4E8\">      css: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'static/css'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      image: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'static/image'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    assetPrefix: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  html: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'My App'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    favicon: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./public/favicon.ico'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    template: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./public/index.html'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"开发和构建\">开发和构建</h3><div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;scripts&quot;: {&#10;    &quot;dev&quot;: &quot;rsbuild dev&quot;,&#10;    &quot;build&quot;: &quot;rsbuild build&quot;,&#10;    &quot;preview&quot;: &quot;rsbuild preview&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"scripts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"dev\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rsbuild dev\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"build\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rsbuild build\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"preview\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rsbuild preview\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"核心特性\">核心特性</h2><h3 id=\"开箱即用\">开箱即用</h3><p>Rsbuild 内置了绝大多数常用功能的支持，无需额外配置：</p>\n<table>\n<thead>\n<tr>\n<th>特性</th>\n<th>Rsbuild（内置）</th>\n<th>Webpack（需配置）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>TypeScript</td>\n<td>✅ 自动</td>\n<td>需要 ts-loader/swc-loader</td>\n</tr>\n<tr>\n<td>CSS Modules</td>\n<td>✅ 自动</td>\n<td>需要配置 css-loader</td>\n</tr>\n<tr>\n<td>PostCSS</td>\n<td>✅ 自动</td>\n<td>需要 postcss-loader</td>\n</tr>\n<tr>\n<td>图片/字体资源</td>\n<td>✅ 自动</td>\n<td>需要配置 asset modules</td>\n</tr>\n<tr>\n<td>HMR</td>\n<td>✅ 自动</td>\n<td>需要 webpack-dev-server</td>\n</tr>\n<tr>\n<td>代码分割</td>\n<td>✅ 智能默认</td>\n<td>需要配置 splitChunks</td>\n</tr>\n<tr>\n<td>HTML 生成</td>\n<td>✅ 自动</td>\n<td>需要 html-webpack-plugin</td>\n</tr>\n</tbody></table>\n<h3 id=\"性能优势\">性能优势</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 构建速度对比 - 中型 React 项目&#10;        RSBUILD_DEV[Rsbuild dev&lt;br/&gt;0.3s 启动]&#10;        WEBPACK_DEV[Webpack dev&lt;br/&gt;8s 启动]&#10;        RSBUILD_BUILD[Rsbuild build&lt;br/&gt;3s]&#10;        WEBPACK_BUILD[Webpack build&lt;br/&gt;25s]&#10;    end&#10;\">graph LR\n    subgraph 构建速度对比 - 中型 React 项目\n        RSBUILD_DEV[Rsbuild dev&lt;br/&gt;0.3s 启动]\n        WEBPACK_DEV[Webpack dev&lt;br/&gt;8s 启动]\n        RSBUILD_BUILD[Rsbuild build&lt;br/&gt;3s]\n        WEBPACK_BUILD[Webpack build&lt;br/&gt;25s]\n    end\n</pre><h3 id=\"插件系统\">插件系统</h3><p>Rsbuild 的插件系统灵活且类型安全：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import type { RsbuildPlugin } from &#39;@rsbuild/core&#39;;&#10;&#10;const myPlugin: RsbuildPlugin = {&#10;  name: &#39;plugin-my-feature&#39;,&#10;  setup(api) {&#10;    api.modifyRsbuildConfig((config) =&gt; {&#10;      config.html = config.html || {};&#10;      config.html.title = &#39;Modified Title&#39;;&#10;    });&#10;&#10;    api.modifyRspackConfig((config) =&gt; {&#10;      config.resolve = config.resolve || {};&#10;      config.resolve.extensions = [&#39;.ts&#39;, &#39;.tsx&#39;, &#39;.js&#39;, &#39;.jsx&#39;];&#10;    });&#10;&#10;    api.onAfterBuild(({ stats }) =&gt; {&#10;      console.log(&#39;Build completed:&#39;, stats?.toJson().time, &#39;ms&#39;);&#10;    });&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span s