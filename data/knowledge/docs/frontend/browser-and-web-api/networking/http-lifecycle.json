 1.2/1.3&quot;]&#10;        TCP1[&quot;TCP&quot;]&#10;        IP1[&quot;IP&quot;]&#10;    end&#10;    subgraph QUIC_Stack[&quot;HTTP/3 协议栈&quot;]&#10;        App2[&quot;HTTP/3&quot;]&#10;        QUIC[&quot;QUIC\\n(内含 TLS 1.3)&quot;]&#10;        UDP[&quot;UDP&quot;]&#10;        IP2[&quot;IP&quot;]&#10;    end\">flowchart TB\n    subgraph TCP_Stack[\"传统 HTTP/2 协议栈\"]\n        App1[\"HTTP/2\"]\n        TLS1[\"TLS 1.2/1.3\"]\n        TCP1[\"TCP\"]\n        IP1[\"IP\"]\n    end\n    subgraph QUIC_Stack[\"HTTP/3 协议栈\"]\n        App2[\"HTTP/3\"]\n        QUIC[\"QUIC\\n(内含 TLS 1.3)\"]\n        UDP[\"UDP\"]\n        IP2[\"IP\"]\n    end</pre><p>QUIC 的关键特性：</p>\n<table>\n<thead>\n<tr>\n<th>特性</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>0-RTT 连接恢复</td>\n<td>重复连接无需握手</td>\n</tr>\n<tr>\n<td>独立流多路复用</td>\n<td>单个流的丢包不影响其他流</td>\n</tr>\n<tr>\n<td>连接迁移</td>\n<td>网络切换（Wi-Fi→4G）不断连</td>\n</tr>\n<tr>\n<td>内置加密</td>\n<td>TLS 1.3 集成在协议层</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ConnectionTiming {&#10;  dns: number;&#10;  tcp: number;&#10;  tls: number;&#10;  ttfb: number;&#10;  download: number;&#10;  total: number;&#10;}&#10;&#10;function getConnectionTiming(entry: PerformanceResourceTiming): ConnectionTiming {&#10;  return {&#10;    dns: entry.domainLookupEnd - entry.domainLookupStart,&#10;    tcp: entry.connectEnd - entry.connectStart,&#10;    tls: entry.secureConnectionStart &gt; 0 ? entry.connectEnd - entry.secureConnectionStart : 0,&#10;    ttfb: entry.responseStart - entry.requestStart,&#10;    download: entry.responseEnd - entry.responseStart,&#10;    total: entry.responseEnd - entry.startTime,&#10;  };&#10;}&#10;&#10;const observer = new PerformanceObserver((list) =&gt; {&#10;  for (const entry of list.getEntries() as PerformanceResourceTiming[]) {&#10;    const timing = getConnectionTiming(entry);&#10;    console.log(`${entry.name}:`, timing);&#10;  }&#10;});&#10;observer.observe({ type: &#39;resource&#39;, buffered: true });\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConnectionTiming</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  dns</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  tcp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  tls</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  ttfb</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  download</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  total</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-d