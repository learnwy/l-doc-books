>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  requestAnimationFrame</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(step);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>rAF 与 <code>setTimeout</code> 动画的对比：</p>\n<table>\n<thead>\n<tr>\n<th>特性</th>\n<th><code>requestAnimationFrame</code></th>\n<th><code>setTimeout(fn, 16)</code></th>\n</tr>\n</thead>\n<tbody><tr>\n<td>帧对齐</td>\n<td>自动对齐显示器刷新率</td>\n<td>不保证对齐</td>\n</tr>\n<tr>\n<td>后台标签页</td>\n<td>自动暂停</td>\n<td>继续执行（浪费资源）</td>\n</tr>\n<tr>\n<td>执行时机</td>\n<td>渲染前</td>\n<td>宏任务队列（不确定）</td>\n</tr>\n<tr>\n<td>精度</td>\n<td>高</td>\n<td>受最小间隔限制（~4ms）</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"requestidlecallback\">requestIdleCallback</h2><p><code>requestIdleCallback</code>（rIC）在浏览器空闲时执行低优先级任务，不影响关键渲染和用户交互。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph Frame[&quot;一帧 (~16.67ms)&quot;]&#10;        Task[&quot;宏任务&quot;]&#10;        Micro[&quot;微任务&quot;]&#10;        RAF[&quot;rAF&quot;]&#10;        Render[&quot;渲染&quot;]&#10;        Idle[&quot;空闲时间&quot;]&#10;    end&#10;    Task --&gt; Micro --&gt; RAF --&gt; Render --&gt; Idle\">flowchart LR\n    subgraph Frame[\"一帧 (~16.67ms)\"]\n        Task[\"宏任务\"]\n        Micro[\"微任务\"]\n        RAF[\"rAF\"]\n        Render[\"渲染\"]\n        Idle[\"空闲时间\"]\n    end\n    Task --&gt; Micro --&gt; RAF --&gt; Render --&gt; Idle</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface IdleDeadline {&#10;  didTimeout: boolean;&#10;  timeRemaining(): number;&#10;}&#10;&#10;function processChunk(deadline: IdleDeadline): void {&#10;  while ((deadline.timeRemaining() &gt; 0 || deadline.didTimeout) &amp;&amp; tasks.length &gt; 0) {&#10;    const task = tasks.shift()!;&#10;    task();&#10;  }&#10;&#10;  if (tasks.length &gt; 0) {&#10;    requestIdleCallback(processChunk, { timeout: 2000 });&#10;  }&#10;}&#10;&#10;const tasks: Array&lt;() =&gt; void&gt; = [];&#10;&#10;function scheduleWork(task: () =&gt; void): void {&#10;  tasks.push(task);&#10;  requestIdleCallback(processChunk, { timeout: 2000 });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> IdleDeadline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  didTimeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  timeRemaining</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processChunk</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">deadline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> IdleDeadline</span><span 