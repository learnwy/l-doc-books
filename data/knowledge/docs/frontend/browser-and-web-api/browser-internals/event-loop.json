"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">resolve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'C'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    resolve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  p.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'D'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">resolve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'E'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  requestAnimationFrame</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'F'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'G'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">asyncExample</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'H'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>执行顺序分析：</p>\n<table>\n<thead>\n<tr>\n<th>输出</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>A</td>\n<td>同步执行</td>\n</tr>\n<tr>\n<td>C</td>\n<td>Promise 构造函数同步执行</td>\n</tr>\n<tr>\n<td>H</td>\n<td>同步代码继续</td>\n</tr>\n<tr>\n<td>D</td>\n<td>微任务（Promise.then）</td>\n</tr>\n<tr>\n<td>E</td>\n<td>微任务（await 之后恢复）</td>\n</tr>\n<tr>\n<td>G</td>\n<td>微任务中的同步代码</td>\n</tr>\n<tr>\n<td>F</td>\n<td>rAF（下一帧渲染前）</td>\n</tr>\n<tr>\n<td>B</td>\n<td>宏任务（setTimeout）</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"事件循环与-node-js-的差异\">事件循环与 Node.js 的差异</h2><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>浏览器</th>\n<th>Node.js</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>宏任务队列</td>\n<td>单一队列</td>\n<td>多个阶段（timers, poll, check 等）</td>\n</tr>\n<tr>\n<td>微任务时机</td>\n<td>每个宏任务后清空</td>\n<td>每个阶段切换时清空</td>\n</tr>\n<tr>\n<td><code>setImmediate</code></td>\n<td>不支持</td>\n<td>check 阶段执行</td>\n</tr>\n<tr>\n<td><code>process.nextTick</code></td>\n<td>不支持</td>\n<td>优先于其他微任务</td>\n</tr>\n<tr>\n<td><code>requestAnimationFrame</code></td>\n<td>渲染前执行</td>\n<td>不支持</td>\n</tr>\n<tr>\n<td><code>requestIdleCallback</code></td>\n<td>空闲时执行</td>\n<td>不支持</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>事件循环是 JavaScript 异步编程的核心，协调<strong>调用栈、宏任务队列和微任务队列</strong></li>\n<li>微任务（Promise、queueMicrotask）优先于宏任务（setTimeout、setInterval）执行</li>\n<li>每轮循环的完整顺序：<strong>宏任务 → 微任务 → rAF → 渲染 → rIC</strong></li>\n<li><code>requestAnimationFrame</code> 适合动画，自动对齐帧刷新；<code>requestIdleCallback</code> 适合低优先级后台任务</li>\n<li>理解执行顺序对于调试异步代码、避免竞态条件和性能优化至关重要</li>\n</ul>\n","headings":[{"level":1,"text":"事件循环","id":"事件循环"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"JavaScript 的并发模型","id":"javascript-的并发模型"},{"level":2,"text":"调用栈（Call Stack）","id":"调用栈-call-stack"},{"level":2,"text":"宏任务与微任务","id":"宏任务与微任务"},{"level":2,"text":"事件循环的完整流程","id":"事件循环的完整流程"},{"level":2,"text":"requestAnimationFrame","id":"requestanimationframe"},{"level":2,"text":"requestIdleCallback","id":"requestidlecallback"},{"level":2,"text":"常见异步执行顺序陷阱","id":"常见异步执行顺序陷阱"},{"level":2,"text":"事件循环与 Node.js 的差异","id":"事件循环与-node-js-的差异"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"V8 引擎","url":"/l-doc-books/h/frontend/browser-and-web-api/browser-internals/v8-engine"},"next":{"title":"DOM 树构建","url":"/l-doc-books/h/frontend/browser-and-web-api/dom-and-cssom/dom-tree-construction"}}