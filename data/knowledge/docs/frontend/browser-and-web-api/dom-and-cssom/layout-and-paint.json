class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> body</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> document.body;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getLayoutInfo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(body), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span></code></pre></div><p>布局模式的分类：</p>\n<table>\n<thead>\n<tr>\n<th>布局模式</th>\n<th>触发条件</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>块级布局（Block）</td>\n<td><code>display: block</code></td>\n<td>垂直排列，独占一行</td>\n</tr>\n<tr>\n<td>行内布局（Inline）</td>\n<td><code>display: inline</code></td>\n<td>水平排列，共享行空间</td>\n</tr>\n<tr>\n<td>Flex 布局</td>\n<td><code>display: flex</code></td>\n<td>一维弹性布局</td>\n</tr>\n<tr>\n<td>Grid 布局</td>\n<td><code>display: grid</code></td>\n<td>二维网格布局</td>\n</tr>\n<tr>\n<td>表格布局（Table）</td>\n<td><code>display: table</code></td>\n<td>表格式多轮布局</td>\n</tr>\n<tr>\n<td>定位布局（Positioned）</td>\n<td><code>position: absolute/fixed</code></td>\n<td>脱离文档流</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"绘制记录-paint-records\">绘制记录（Paint Records）</h2><p>布局完成后，浏览器生成一系列<strong>绘制记录（Paint Records）</strong>，描述如何将元素渲染到屏幕上。绘制记录按照特定顺序生成。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    PaintOrder[&quot;绘制顺序&quot;]&#10;    PaintOrder --&gt; BG[&quot;1. 背景色&quot;]&#10;    BG --&gt; BGImg[&quot;2. 背景图片&quot;]&#10;    BGImg --&gt; Border[&quot;3. 边框&quot;]&#10;    Border --&gt; Children[&quot;4. 子元素&quot;]&#10;    Children --&gt; Outline[&quot;5. 轮廓&quot;]&#10;    Outline --&gt; Selection[&quot;6. 选中效果&quot;]\">flowchart TD\n    PaintOrder[\"绘制顺序\"]\n    PaintOrder --&gt; BG[\"1. 背景色\"]\n    BG --&gt; BGImg[\"2. 背景图片\"]\n    BGImg --&gt; Border[\"3. 边框\"]\n    Border --&gt; Children[\"4. 子元素\"]\n    Children --&gt; Outline[\"5. 轮廓\"]\n    Outline --&gt; Selection[\"6. 选中效果\"]</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const canvas = document.createElement(&#39;canvas&#39;);&#10;const ctx = canvas.getContext(&#39;2d&#39;)!;&#10;canvas.width = 400;&#10;canvas.height = 300;&#10;&#10;interface PaintRecord {&#10;  operation: &#39;fillRect&#39; | &#39;strokeRect&#39; | &#39;fillText&#39; | &#39;drawImage&#39;;&#10;  params: Record&lt;string, number | string&gt;;&#10;}&#10;&#10;function simulatePaint(records: PaintRecord[]): void {&#10;  for (const record of records) {&#10;    switch (record.operation) {&#10;      case &#39;fillRect&#39;:&#10;        ctx.fillStyle = record.params.color as string;&#10;        ctx.fillRect(&#10;          record.params.x as number,&#10;          record.params.y as number,&#10;          record.params.width as number,&#10;          record.params.height as number,&#10;        );&#10;        break;&#10;      case &#39;strokeRect&#39;:&#10;        ctx.strokeStyle = record.params.color as string;&#10;        ctx.lineWidth = record.params.lineWidth as number;&#10;        ctx.strokeRect(&#10;          record.params.x as number,&#10;          record.params.y as number,&#10;          record.params.width as number,&#10;          record.params.height as number,&#10;        );&#10;        break;&#10;    }&#10;  }&#10;}&#10;&#10;simulatePaint([&#10;  { operation: &#39;fillRect&#39;, params: { x: 0, y: 0, width: 200, height: 100, color: &#39;#e0f2fe&#39; } },&#10;  { operation: &#39;strokeRect&#39;, params: { x: 0, y: 0, width: 200, height: 100, color: &#39;#0284c7&#39;, lineWidth: 2 } },&#10;]);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> canvas</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> document.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createElement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'canvas'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ctx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> canvas.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2d'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">canvas.width </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC