[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">>]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*?</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lastIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> match</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RegExpExecArray</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ((match </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tagRegex.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(html)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (match.index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lastIndex) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      tokens.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Character'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, data: html.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(lastIndex, match.index) });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    tokens.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      type: match[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">startsWith</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'&#x3C;/'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'EndTag'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'StartTag'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      tagName: match[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    lastIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tagRegex.lastIndex;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tokens.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'EOF'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tokens;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"树构建算法\">树构建算法</h2><p>树构建器维护一个<strong>开放元素栈（Stack of Open Elements）</strong>，根据接收到的 Token 执行相应的操作。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    Token[&quot;接收 Token&quot;]&#10;    Token --&gt; IsStart{&quot;StartTag?&quot;}&#10;    IsStart -- 是 --&gt; CreateElement[&quot;创建 Element 节点&quot;]&#10;    CreateElement --&gt; Push[&quot;压入开放元素栈&quot;]&#10;    Push --&gt; AppendChild[&quot;挂载到当前父节点&quot;]&#10;    IsStart -- 否 --&gt; IsEnd{&quot;EndTag?&quot;}&#10;    IsEnd -- 是 --&gt; Pop[&quot;弹出栈顶匹配元素&quot;]&#10;    IsEnd -- 否 --&gt; IsText{&quot;Character?&quot;}&#10;    IsText -- 是 --&gt; CreateText[&quot;创建 Text 节点&quot;]&#10;    CreateText --&gt; AppendText[&quot;挂载到当前父节点&quot;]\">flowchart TD\n    Token[\"接收 Token\"]\n    Token --&gt; IsStart{\"StartTag?\"}\n    IsStart -- 是 --&gt; CreateElement[\"创建 Element 节点\"]\n    CreateElement --&gt; Push[\"压入开放元素栈\"]\n    Push --&gt; AppendChild[\"挂载到当前父节点\"]\n    IsStart -- 否 --&gt; IsEnd{\"EndTag?\"}\n    IsEnd -- 是 --&gt; Pop[\"弹出栈顶匹配元素\"]\n    IsEnd -- 否 --&gt; IsText{\"Character?\"}\n    IsText -- 是 --&gt; CreateText[\"创建 Text 节点\"]\n    CreateText --&gt; AppendText[\"挂载到当前父节点\"]</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DOMNode {&#10;  type: &#39;element&#39; | &#39;text&#39; | &#39;document&#39;;&#10;  tagName?: string;&#10;  children: DOMNode[];&#10;  textContent?: string;&#10;}&#10;&#10;function buildTree(tokens: Token[]): DOMNode {&#10;  const document: DOMNode = { type: &#39;document&#39;, children: [] };&#10;  const stack: DOMNode[] = [document];&#10;&#10;  for (const token of tokens) {&#10;    const parent = stack[stack.length - 1];&#10;&#10;    switch (token.type) {&#10;      case &#39;StartTag&#39;: {&#10;        const element: DOMNode = {&#10;          type: &#39;element&#39;,&#10;          tagName: token.tagName,&#10;          children: [],&#10;        };&#10;        parent.children.push(element);&#10;        stack.push(element);&#10;        break;&#10;      }&#10;      case &#39;EndTag&#39;:&#10;        stack.pop();&#10;        break;&#10;      case &#39;Character&#39;:&#10;        if (token.data?.trim()) {&#10;          parent.children.push({ type: &#39;text&#39;, textContent: token.data, children: [] });&#10;        }&#10;        break;&#10;    }&#10;  }&#10;&#10;  return document;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface<