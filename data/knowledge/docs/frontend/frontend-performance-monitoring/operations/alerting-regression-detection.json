-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> weeklyP75s.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (weeklyP75s[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> weeklyP75s[i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1.05</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      consecutiveIncrease</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      consecutiveIncrease </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (consecutiveIncrease </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    triggerAlert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gradual-regression'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      metric,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      trend: weeklyP75s,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      message: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">metric</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} P75 连续 ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">consecutiveIncrease</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} 周恶化`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>检测窗口</th>\n<th>目标</th>\n<th>适用回归类型</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>5 分钟滑动</td>\n<td>捕捉发版后的即时退化</td>\n<td>代码变更引入</td>\n</tr>\n<tr>\n<td>1 小时滑动</td>\n<td>捕捉流量模式变化</td>\n<td>高峰期性能差异</td>\n</tr>\n<tr>\n<td>每日 P75</td>\n<td>捕捉跨天趋势</td>\n<td>第三方脚本升级</td>\n</tr>\n<tr>\n<td>每周 P75</td>\n<td>捕捉渐进退化</td>\n<td>技术债累积</td>\n</tr>\n</tbody></table>\n<h2 id=\"告警分发与响应协议\">告警分发与响应协议</h2><p>好的告警不仅要告诉你&quot;什么坏了&quot;，还要告诉你&quot;去哪里看&quot;和&quot;可能是什么原因&quot;：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PerfAlert {&#10;  title: string;&#10;  severity: &#39;warning&#39; | &#39;critical&#39;;&#10;  metric: string;&#10;  currentValue: number;&#10;  threshold: number;&#10;  context: {&#10;    affectedPages: string[]; // 哪些页面&#10;    affectedRelease?: string; // 哪个版本&#10;    timeStarted: string; // 何时开始&#10;    deviceSegment?: string; // 哪类设备&#10;    possibleCause?: string; // 可能原因&#10;  };&#10;  actions: {&#10;    dashboardUrl: string; // 直达 Dashboard&#10;    comparisonUrl: string; // 版本对比链接&#10;    runbookUrl: string; // 处理手册&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PerfAlert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  title</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  severity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'warning'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'critical'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  metric</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  currentValue</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  threshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  context</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    affectedPages</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 哪些页面</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    affectedRelease</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 哪个版本</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    timeStarted</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 何时开始</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    deviceSegment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 哪类设备</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    possibleCause</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 可能原因</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  actions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    dashboardUrl</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 直达 Dashboard</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    comparisonUrl</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 版本对比链接</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    runbookUrl</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 处理手册</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>响应协议：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[告警触发] --&gt; B{严重级别}&#10;    B --&gt;|Critical| C[立即响应&lt;br/&gt;15 分钟内确认]&#10;    B --&gt;|Warning| D[工作时段响应&lt;br/&gt;24 小时内确认]&#10;    C --&gt; E[确认是否为真回归]&#10;    E --&gt;|是| F[回滚或 Hotfix]&#10;    E --&gt;|否| G[调整告警规则&lt;br/&gt;标记为已知]&#10;    D --&gt; H[下一迭代修复&lt;br/&gt;加入 Sprint]\">graph LR\n    A[告警触发] --&gt; B{严重级别}\n    B --&gt;|Critical| C[立即响应&lt;br/&gt;15 分钟内确认]\n    B --&gt;|Warning| D[工作时段响应&lt;br/&gt;24 小时内确认]\n    C --&gt; E[确认是否为真回归]\n    E --&gt;|是| F[回滚或 Hotfix]\n    E --&gt;|否| G[调整告警规则&lt;br/&gt;标记为已知]\n    D --&gt; H[下一迭代修复&lt;br/&gt;加入 Sprint]</pre><h2 id=\"小结\">小结</h2><ul>\n<li>生产告警补充 CI 预算无法覆盖的运行时退化（第三方变更、CDN 漂移等）</li>\n<li>静态阈值 + 相对变化 + 异常检测三种策略组合使用</li>\n<li><code>consecutiveBreaches</code> 和趋势分析是降低误报的关键手段</li>\n<li>Release 版本关联让回归可精确归因到具体发布</li>\n<li>告警应附带上下文（受影响页面/设备/可能原因）和直达链接</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"performance-budgets-ci\">性能预算与 CI 集成</a>——告警体系的上游：合入前的预算门控</li>\n<li><a href=\"../frontend-observability/observability-platforms/alerting-oncall\">前端可观测性 — 告警与 OnCall</a>——告警系统在更广义可观测性场景的设计原则</li>\n</ul>\n","headings":[{"level":1,"text":"告警与回归检测","id":"告警与回归检测"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"实时告警管线架构","id":"实时告警管线架构"},{"level":2,"text":"Release 级别回归检测","id":"release-级别回归检测"},{"level":2,"text":"渐进退化检测","id":"渐进退化检测"},{"level":2,"text":"告警分发与响应协议","id":"告警分发与响应协议"},{"level":2,"t