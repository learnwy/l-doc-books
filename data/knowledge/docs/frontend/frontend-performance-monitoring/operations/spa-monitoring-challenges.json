92E;--shiki-dark:#E1E4E8\">        name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'route-cls'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        value: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.routeCLS,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        page: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.currentRoute,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 重置</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.currentRoute </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> newRoute;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.routeCLS </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>CLS 场景</th>\n<th>问题</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>路由切换动画</td>\n<td>过渡动画产生 Layout Shift</td>\n<td>使用 transform 动画，不改变几何属性</td>\n</tr>\n<tr>\n<td>懒加载内容</td>\n<td>新路由内容异步渲染时产生偏移</td>\n<td>骨架屏预占空间</td>\n</tr>\n<tr>\n<td>第三方组件</td>\n<td>广告/推荐组件在路由变化后重新加载</td>\n<td>固定容器尺寸</td>\n</tr>\n<tr>\n<td>字体加载</td>\n<td>路由切换后新字体 FOUT</td>\n<td>字体缓存 + font-display: optional</td>\n</tr>\n</tbody></table>\n<h2 id=\"水合性能监控\">水合性能监控</h2><p>Server-Side Rendering（SSR）+ 客户端水合（Hydration）是 SPA 性能的另一个关键监控点。页面首次加载时，HTML 已经渲染完成但尚不可交互——水合时间就是&quot;看起来加载完了但点不动&quot;的窗口：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 水合时间测量&#10;performance.mark(&#39;hydration-start&#39;);&#10;&#10;// React 18+ 使用 hydrateRoot&#10;import { hydrateRoot } from &#39;react-dom/client&#39;;&#10;&#10;const root = hydrateRoot(document.getElementById(&#39;root&#39;)!, &lt;App /&gt;, {&#10;  onRecoverableError(error) {&#10;    console.error(&#39;Hydration mismatch:&#39;, error);&#10;  },&#10;});&#10;&#10;// 水合完成后标记&#10;requestIdleCallback(() =&gt; {&#10;  performance.mark(&#39;hydration-end&#39;);&#10;  performance.measure(&#39;hydration-duration&#39;, &#39;hydration-start&#39;, &#39;hydration-end&#39;);&#10;&#10;  const [measure] = performance.getEntriesByName(&#39;hydration-duration&#39;);&#10;  reportMetric({&#10;    name: &#39;hydration-time&#39;,&#10;    value: measure.duration,&#10;    page: location.pathname,&#10;  });&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 水合时间测量</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">mark</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-start'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// React 18+ 使用 hydrateRoot</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hydrateRoot } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'react-dom/client'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> root</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hydrateRoot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(document.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getElementById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'root'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">App</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> />, {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  onRecoverableError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Hydration mismatch:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, error);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 水合完成后标记</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">requestIdleCallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">mark</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-end'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">measure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-duration'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-start'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-end'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">measure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getEntriesByName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-duration'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  reportMetric</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hydration-time'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    value: measure.duration,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    page: location.pathname,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>水合时间 &gt; 500ms 意味着用户在半秒内面对一个&quot;假可交互&quot;的页面——这直接影响 INP（用户在水合期间的点击会排队等待）。</p>\n<h2 id=\"rum-平台的-spa-支持现状\">RUM 平台的 SPA 支持现状</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[RUM SDK 初始化] --&gt; B{检测到路由变化}&#10;    B --&gt; C[结束当前虚拟页面]&#10;    B --&gt; D[开始新虚拟页面]&#10;    C --&gt; E[上报前一页面指标]&#10;    D --&gt; F[重置指标计数器]&#10;    D --&gt; G[开始新的 LCP 和 CLS 测量]\">graph LR\n    A[RUM SDK 初始化] --&gt; B{检测到路由变化}\n    B --&gt; C[结束当前虚拟页面]\n    B --&gt; D[开始新虚拟页面]\n    C --&gt; E[上报前一页面指标]\n    D --&gt; F[重置指标计数器]\n    D --&gt; G[开始新的 LCP 和 CLS 测量]</pre><table>\n<thead>\n<tr>\n<th>平台</th>\n<th>SPA 路由自动检测</th>\n<th>软导航 API 支持</th>\n<th>虚拟页面指标分割</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Sentry</td>\n<td>History API hook</td>\n<td>实验性</td>\n<td>按 transaction 分割</td>\n</tr>\n<tr>\n<td>Datadog RUM</td>\n<td>自动 + 手动 API</td>\n<td>实验性</td>\n<td>View 级别分割</td>\n</tr>\n<tr>\n<td>Grafana Faro</td>\n<td>手动集成</td>\n<td>不支持</td>\n<td>需自定义</td>\n</tr>\n<tr>\n<td>web-vitals</td>\n<td>无（需手动）</td>\n<td>实验性 flag</td>\n<td>无</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>SPA 的客户端路由切换不触发传统性能 API，造成监控盲区</li>\n<li>Soft Navigation API 是 Chrome 推进中的标准，但跨浏览器支持尚不完整</li>\n<li>生产环境需手动 hook 路由变化，自定义&quot;软导航 LCP&quot;和&quot;路由级 CLS&quot;</li>\n<li>水合时间是 SSR+SPA 架构的关键监控指标，直接影响 INP</li>\n<li>主流 RUM 平台均提供 SPA 路由检测，但精度和自动化程度各异</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"alerting-regression-detection\">告警与回归检测</a>——SPA 监控数据如何接入告警体系</li>\n<li><a href=\"../frontend-observability/performance-monitoring/web-vitals\">前端可观测性 — Web Vitals 监控</a>——SPA 场景下 Web Vitals 监控的平台集成实践</li>\n</ul>\n","headings":[{"level":1,"text":"SPA 监控与软导航挑战","id":"spa-监控与软导航挑战"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Soft Navigation API（实验性标准）","id":"soft-navigation-api-实验性标准"},{"level":2,"text":"当前生产方案：手动路由监控","id":"当前生产方案-手动路由监控"},{"level":2,"text":"SPA CLS 的累积问题","id":"spa-cls-的累积问题"},{"level":2,"text":"水合性能监控","id":"水合性能监控"},{"level":2,"text":"RUM 平台的 SPA 支持现状","id":"rum-平台的-spa-支持现状"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"告警与回归检测","url":"/l-doc-books/h/frontend/frontend-performance-monitoring/operations/alerting-regression-detection"},"next":null}