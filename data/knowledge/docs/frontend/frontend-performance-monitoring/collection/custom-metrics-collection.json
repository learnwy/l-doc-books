=\"color:#24292E;--shiki-dark:#E1E4E8\">, buffered: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><h2 id=\"server-timing-全链路透传\">Server Timing 全链路透传</h2><p>后端通过 <code>Server-Timing</code> HTTP 头将各阶段耗时传递给浏览器，前端可通过 Resource Timing / Navigation Timing 的 <code>serverTiming</code> 属性读取：</p>\n<div class=\"code-block-wrapper\" data-lang=\"http\" data-code=\"HTTP/1.1 200 OK&#10;Server-Timing: db;dur=53.2;desc=&quot;Database Query&quot;&#10;Server-Timing: cache;dur=1.3;desc=&quot;Redis Lookup&quot;&#10;Server-Timing: render;dur=22.8;desc=&quot;Template Render&quot;&#10;Server-Timing: total;dur=78.5\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>HTTP/1.1 200 OK</span></span>\n<span class=\"line\"><span>Server-Timing: db;dur=53.2;desc=\"Database Query\"</span></span>\n<span class=\"line\"><span>Server-Timing: cache;dur=1.3;desc=\"Redis Lookup\"</span></span>\n<span class=\"line\"><span>Server-Timing: render;dur=22.8;desc=\"Template Render\"</span></span>\n<span class=\"line\"><span>Server-Timing: total;dur=78.5</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const [navEntry] = performance.getEntriesByType(&#39;navigation&#39;) as PerformanceNavigationTiming[];&#10;&#10;for (const timing of navEntry.serverTiming) {&#10;  console.log(`${timing.name}: ${timing.duration}ms (${timing.description})`);&#10;  // db: 53.2ms (Database Query)&#10;  // cache: 1.3ms (Redis Lookup)&#10;  // render: 22.8ms (Template Render)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">navEntry</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getEntriesByType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'navigation'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PerformanceNavigationTiming</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> timing</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navEntry.serverTiming) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">timing</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">timing</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">duration</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}ms (${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">timing</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">description</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">})`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // db: 53.2ms (Database Query)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // cache: 1.3ms (Redis Lookup)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // render: 22.8ms (Template Render)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>这为前后端联合性能分析提供了桥梁——当 TTFB 过高时，不再需要去后端查日志，直接从前端数据就能看到是数据库慢还是模板渲染慢。</p>\n<h2 id=\"上报链路架构设计\">上报链路架构设计</h2><p>一个可靠的上报链路需要处理三个核心挑战：页面卸载时数据不丢、正常运行时不阻塞用户、海量数据下不压垮后端。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"class MetricsReporter {&#10;  private buffer: object[] = [];&#10;  private readonly MAX_BUFFER = 50;&#10;  private readonly FLUSH_INTERVAL = 10000;&#10;  private timer: ReturnType&lt;typeof setTimeout&gt; | null = null;&#10;&#10;  constructor(private endpoint: string) {&#10;    // 定时刷新&#10;    this.timer = setInterval(() =&gt; this.flush(), this.FLUSH_INTERVAL);&#10;    // 页面隐藏时立即发送&#10;    document.addEventListener(&#39;visibilitychange&#39;, () =&gt; {&#10;      if (document.visibilityState === &#39;hidden&#39;) this.flush();&#10;    });&#10;    // 页面卸载最后机会&#10;    window.addEventListener(&#39;pagehide&#39;, () =&gt; this.flush());&#10;  }&#10;&#10;  report(metric: object) {&#10;    this.buffer.push(metric);&#10;    if (this.buffer.length &gt;= this.MAX_BUFFER) this.flush();&#10;  }&#10;&#10;  private flush() {&#10;    if (this.buffer.length === 0) return;&#10;    const batch = this.buffer.splice(0);&#10;    const payload = JSON.stringify(batch);&#10;&#10;    // 优先 sendBeacon（不受页面卸载影响）&#10;    const sent = navigator.sendBeacon(this.endpoint, payload);&#10;    if (!sent) {&#10;      // 降级到 fetch + keepalive&#10;      fetch(this.endpoint, {&#10;        method: &#39;POST&#39;,&#10;        body: payload,&#10;        keepalive: true,&#10;        headers: { &#39;Content-Type&#39;: &#39;application/json&#39; },&#10;      }).catch(() =&gt; {&#10;        // 最终降级：丢弃或存入 localStorage 下次重发&#10;      });&#10;    }&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MetricsReporter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> buffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> object</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> MAX_BUFFER</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> FLUSH_INTERVAL</s