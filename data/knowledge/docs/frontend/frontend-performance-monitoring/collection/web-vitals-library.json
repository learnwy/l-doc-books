ass=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      onLCP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sendToAnalytics);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      onINP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sendToAnalytics);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      onCLS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sendToAnalytics);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>web-vitals 库是采集 Core Web Vitals 的官方标准方案，~1.5KB 极轻量</li>\n<li>标准 build 用于全量生产采集，attribution build 用于采样调试归因</li>\n<li>每个回调在指标最终值确定时触发，配合 sendBeacon 保证数据不丢失</li>\n<li>归因数据拆解到元素、子阶段、脚本级别，直接支撑性能调试工作流</li>\n<li>生产策略：指标值 100% 全量 + 归因数据 5-10% 采样 + 批量上报</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"custom-metrics-collection\">自定义指标采集与上报链路</a>——超越 Core Web Vitals 的业务自定义指标方案</li>\n<li><a href=\"../web-performance-vitals/foundations/measurement-rum\">Web 性能优化 — RUM 测量</a>——web-vitals 数据在性能优化闭环中的应用</li>\n</ul>\n","headings":[{"level":1,"text":"web-vitals 库与归因采集","id":"web-vitals-库与归因采集"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基础集成","id":"基础集成"},{"level":2,"text":"Attribution Build 深度归因","id":"attribution-build-深度归因"},{"level":2,"text":"报告策略与数据管线","id":"报告策略与数据管线"},{"level":2,"text":"与框架集成","id":"与框架集成"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"PerformanceObserver API 实战","url":"/l-doc-books/h/frontend/frontend-performance-monitoring/collection/performance-observer-api"},"next":{"title":"自定义指标采集与上报链路","url":"/l-doc-books/h/frontend/frontend-performance-monitoring/collection/cu