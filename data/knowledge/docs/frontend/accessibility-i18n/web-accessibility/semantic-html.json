;&#10;      &lt;td&gt;500万&lt;/td&gt;&#10;      &lt;td&gt;15%&lt;/td&gt;&#10;    &lt;/tr&gt;&#10;  &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;!-- 复杂表头：使用 headers 属性 --&gt;&#10;&lt;table&gt;&#10;  &lt;thead&gt;&#10;    &lt;tr&gt;&#10;      &lt;th id=&quot;region&quot; rowspan=&quot;2&quot;&gt;地区&lt;/th&gt;&#10;      &lt;th id=&quot;q1&quot; colspan=&quot;2&quot;&gt;Q1&lt;/th&gt;&#10;      &lt;th id=&quot;q2&quot; colspan=&quot;2&quot;&gt;Q2&lt;/th&gt;&#10;    &lt;/tr&gt;&#10;    &lt;tr&gt;&#10;      &lt;th id=&quot;q1-sales&quot; headers=&quot;q1&quot;&gt;销售额&lt;/th&gt;&#10;      &lt;th id=&quot;q1-growth&quot; headers=&quot;q1&quot;&gt;增长率&lt;/th&gt;&#10;      &lt;th id=&quot;q2-sales&quot; headers=&quot;q2&quot;&gt;销售额&lt;/th&gt;&#10;      &lt;th id=&quot;q2-growth&quot; headers=&quot;q2&quot;&gt;增长率&lt;/th&gt;&#10;    &lt;/tr&gt;&#10;  &lt;/thead&gt;&#10;  &lt;tbody&gt;&#10;    &lt;tr&gt;&#10;      &lt;th headers=&quot;region&quot;&gt;华东&lt;/th&gt;&#10;      &lt;td headers=&quot;q1 q1-sales&quot;&gt;200万&lt;/td&gt;&#10;      &lt;td headers=&quot;q1 q1-growth&quot;&gt;12%&lt;/td&gt;&#10;      &lt;td headers=&quot;q2 q2-sales&quot;&gt;250万&lt;/td&gt;&#10;      &lt;td headers=&quot;q2 q2-growth&quot;&gt;25%&lt;/td&gt;&#10;    &lt;/tr&gt;&#10;  &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;!-- 描述列表：术语定义 --&gt;&#10;&lt;dl&gt;&#10;  &lt;dt&gt;WCAG&lt;/dt&gt;&#10;  &lt;dd&gt;Web Content Accessibility Guidelines&lt;/dd&gt;&#10;  &lt;dt&gt;ARIA&lt;/dt&gt;&#10;  &lt;dd&gt;Accessible Rich Internet Applications&lt;/dd&gt;&#10;&lt;/dl&gt;&#10;`;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> tableSemantics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9E