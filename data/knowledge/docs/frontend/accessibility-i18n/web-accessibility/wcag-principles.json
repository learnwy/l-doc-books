10;  aria-haspopup=&quot;listbox&quot;&#10;  aria-owns=&quot;option-list&quot;&#10;&gt;&#10;  &lt;input aria-autocomplete=&quot;list&quot; aria-controls=&quot;option-list&quot; /&gt;&#10;  &lt;ul id=&quot;option-list&quot; role=&quot;listbox&quot; hidden&gt;&#10;    &lt;li role=&quot;option&quot; aria-selected=&quot;false&quot;&gt;选项 1&lt;/li&gt;&#10;    &lt;li role=&quot;option&quot; aria-selected=&quot;true&quot;&gt;选项 2&lt;/li&gt;&#10;  &lt;/ul&gt;&#10;&lt;/div&gt;&#10;`;&#10;&#10;// 自动化合规检测工具链&#10;const complianceToolchain = {&#10;  development: [&#39;axe-core&#39;, &#39;eslint-plugin-jsx-a11y&#39;],&#10;  testing: [&#39;@axe-core/playwright&#39;, &#39;pa11y&#39;],&#10;  ci: [&#39;lighthouse-ci&#39;, &#39;axe-linter&#39;],&#10;  manual: [&#39;NVDA&#39;, &#39;VoiceOver&#39;, &#39;JAWS&#39;],&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// HTML 验证：确保标记规范</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> robustnessChecks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;!-- 唯一 ID：同一页面不能有重复 ID --></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;!-- 正确的嵌套：标签必须正确闭合和嵌套 --></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;!-- 角色与状态：自定义组件必须声明正确的 ARIA 角色和状态 --></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;!-- 合规的自定义组件 --></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;div </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  role=\"combobox\" </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  aria-expanded=\"false\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  aria-haspopup=\"listbox\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  aria-owns=\"option-list\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  &#x3C;input aria-autocomplete=\"list\" aria-controls=\"option-list\" /></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  &#x3C;ul id=\"option-list\" role=\"listbox\" hidden></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    &#x3C;li role=\"option\" aria-selected=\"false\">选项 1&#x3C;/li></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    &#x3C;li role=\"option\" aria-selected=\"true\">选项 2&#x3C;/li></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  &#x3C;/ul></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;/div></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 自动化合规检测工具链</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> complianceToolchain</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  development: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'axe-core'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'eslint-plugin-jsx-a11y'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  testing: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'@axe-core/playwright'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'pa11y'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ci: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'lighthouse-ci'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'axe-linter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  manual: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'NVDA'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'VoiceOver'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'JAWS'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>WCAG 合规不是一次性工作，而是需要贯穿整个开发生命周期的持续实践。从设计阶段就考虑无障碍性（inclusive design），在开发中使用 linting 工具实时检查，在测试中包含无障碍自动化和手动测试，在部署后持续监控。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>WCAG 基于 POUR 四大原则，每个原则下有具体准则和 A/AA/AAA 三级成功标准</li>\n<li>可感知：所有非文本内容需要替代文本，颜色不能作为唯一信息载体，对比度需满足 4.5:1（AA）</li>\n<li>可操作：所有功能可键盘访问，提供跳过导航链接，避免引发光敏性癫痫的闪烁内容</li>\n<li>可理解：声明页面语言，保持导航一致性，提供清晰的错误识别和修正建议</li>\n<li>鲁棒性：HTML 标记规范，自定义组件正确使用 ARIA 角色和状态</li>\n<li>大多数法规要求达到 AA 级合规，合规检测应贯穿设计→开发→测试→监控全流程</li>\n</ul>\n","headings":[{"level":1,"text":"WCAG 原则与标准","id":"wcag-原则与标准"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"可感知原则","id":"可感知原则"},{"level":2,"text":"可操作原则","id":"可操作原则"},{"level":2,"text":"可理解原则","id":"可理解原则"},{"level":2,"text":"鲁棒性与合规检测","id":"鲁棒性与合规检测"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"语义化 HTML","url":"/l-doc-books/h/frontend/accessibility-i18n/web-accessibility/semantic-html"}}