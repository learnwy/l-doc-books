pan class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(critical).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toEqual</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// React Testing Library 无障碍断言</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { render, screen } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@testing-library/react'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'按钮应有可访问名称'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">IconButton</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> icon</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"delete\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> />)</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByRole</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'button'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'删除'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeInTheDocument</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'表单输入应关联标签'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">LoginForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> />)</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByLabelText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'用户名'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeInTheDocument</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByLabelText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'密码'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeInTheDocument</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span></code></pre></div><h2 id=\"手动测试清单\">手动测试清单</h2><p>自动化工具无法检测的问题需要手动验证。以下是每个 Sprint 应执行的手动测试清单。</p>\n<table>\n<thead>\n<tr>\n<th>测试项</th>\n<th>检查方法</th>\n<th>合格标准</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>键盘导航</td>\n<td>仅用键盘完成所有操作</td>\n<td>所有功能可键盘访问</td>\n</tr>\n<tr>\n<td>焦点可见性</td>\n<td>Tab 遍历所有元素</td>\n<td>焦点指示器始终可见</td>\n</tr>\n<tr>\n<td>焦点顺序</td>\n<td>观察 Tab 顺序</td>\n<td>逻辑合理，无跳跃</td>\n</tr>\n<tr>\n<td>标题结构</td>\n<td>检查 headingsMap</td>\n<td>层级连续，不跳级</td>\n</tr>\n<tr>\n<td>图片 alt</td>\n<td>检查所有图片</td>\n<td>信息性图片有描述性 alt</td>\n</tr>\n<tr>\n<td>表单可用性</td>\n<td>用键盘填写表单</td>\n<td>标签关联、错误可感知</td>\n</tr>\n<tr>\n<td>缩放测试</td>\n<td>浏览器缩放至 200%</td>\n<td>内容不截断不重叠</td>\n</tr>\n<tr>\n<td>对比度</td>\n<td>工具检查前景/背景</td>\n<td>普通文本 ≥ 4.5:1</td>\n</tr>\n<tr>\n<td>动态内容</td>\n<td>屏幕阅读器监听</td>\n<td>变化被 Live Region 播报</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const manualTestProtocol = {&#10;  keyboard: [&#10;    &#39;断开鼠标，仅用键盘完成注册流程&#39;,&#10;    &#39;验证 Tab 顺序与视觉顺序一致&#39;,&#10;    &#39;验证模态框中焦点被正确困住&#39;,&#10;    &#39;验证 Escape 键关闭所有弹出层&#39;,&#10;  ],&#10;  screenReader: [&#10;    &#39;使用 VoiceOver/NVDA 导航首页&#39;,&#10;    &#39;通过标题列表导航到目标内容&#39;,&#10;    &#39;完成搜索和筛选操作&#39;,&#10;    &#39;验证动态加载的内容被播报&#39;,&#10;  ],&#10;  visual: [&#10;    &#39;浏览器缩放到 200% 检查布局&#39;,&#10;    &#39;启用高对比度模式检查可读性&#39;,&#10;    &#39;启用 prefers-reduced-motion 检查动画&#39;,&#10;    &#39;检查文本间距调整后不截断&#39;,&#10;  ],&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> manualTestProtocol</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  keyboard: [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '断开鼠标，仅用键盘完成注册流程'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '验证 Tab 顺序与视觉顺序一致'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '验证模态框中焦点被正确困住'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '验证 Escape 键关闭所有弹出层'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  screenReader: [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '使用 VoiceOver/NVDA 导航首页'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '通过标题列表导航到目标内容'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '完成搜索和筛选操作'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '验证动态加载的内容被播报'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  visual: [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '浏览器缩放到 200% 检查布局'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '启用高对比度模式检查可读性'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '启用 prefers-reduced-motion 检查动画'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '检查文本间距调整后不截断'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"测试报告与修复优先级\">测试报告与修复优先级</h2><p>无障碍问题的修复应按影响程度排列优先级。critical 和 serious 级别的问题应在当前 Sprint 修复。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface A11yIssue {&#10;  rule: string;&#10;  impact: &#39;critical&#39; | &#39;serious&#39; | &#39;moderate&#39; | &#39;minor&#39;;&#10;  description: string;&#10;  element: string;&#10;  fix: string;&#10;}&#10;&#10;const priorityMatrix: Record&lt;string, string&gt; = {&#10;  critical: &#39;当前 Sprint 必须修复&#39;,&#10;  serious: &#39;当前 Sprint 优先修复&#39;,&#10;  moderate: &#39;下个 Sprint 修复&#39;,&#10;  minor: &#39;排入 backlog&#39;,&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A11yIssue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  rule</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  impact</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'critical'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'serious'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'moderate'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'minor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  element</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  fix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> priorityMatrix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  critical: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'当前 Sprint 必须修复'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  serious: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'当前 Sprint 优先修复'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  moderate: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'下个 Sprint 修复'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  minor: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'排入 backlog'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>影响级别</th>\n<th>典型问题</th>\n<th>修复时限</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Critical</td>\n<td>功能完全不可用</td>\n<td>本 Sprint</td>\n<td>表单无法键盘提交</td>\n</tr>\n<tr>\n<td>Serious</td>\n<td>功能严重受限</td>\n<td>本 Sprint</td>\n<td>按钮无可访问名称</td>\n</tr>\n<tr>\n<td>Moderate</td>\n<td>可用但体验差</td>\n<td>下 Sprint</td>\n<td>焦点顺序不合理</td>\n</tr>\n<tr>\n<td>Minor</td>\n<td>轻微不便</td>\n<td>Backlog</td>\n<td>颜色对比度接近阈值</td>\n</tr>\n</tbody></table>\n<p>将无障碍测试集成到 CI/CD 流程中可以防止回归。设置 axe-core 检查为 PR 合并的必需条件，critical/serious 级别问题阻止合并。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>自动化工具可以检测约 30-40% 的 WCAG 问题，剩余需要手动测试</li>\n<li>axe-core 是业界标准引擎，可集成到单元测试、E2E 测试和 CI 流程</li>\n<li>Testing Library 的 getByRole、getByLabelText 等查询方式天然支持无障碍最佳实践</li>\n<li>每个 Sprint 至少执行一次键盘导航 + 屏幕阅读器手动测试</li>\n<li>无障碍问题按 critical → serious → moderate → minor 排列修复优先级</li>\n<li>CI 集成 axe-core 检查，critical/serious 级别阻止 PR 合并</li>\n</ul>\n","headings":[{"level":1,"text":"无障碍测试","id":"无障碍测试"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"自动化检测工具","id":"自动化检测工具"},{"level":2,"text":"手动测试清单","id":"手动测试清单"},{"level":2,"text":"测试报告与修复优先级","id":"测试报告与修复优先级"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ARIA 基础","url":"/l-doc-books/h/frontend/accessibility-i18n/aria-and-testing/aria-fundamentals"},"next":{"title":"无障碍自动化工程","url":"/l-doc-books/h/frontend/accessibility-i18n/aria-and-testing/accessibility-automation"}}