{"seq":1,"slug":"i18n-architecture","title":"i18n 架构设计","url":"/l-doc-books/h/frontend/accessibility-i18n/i18n-fundamentals/i18n-architecture","wordCount":604,"readingTime":3,"html":"<h1 id=\"i18n-架构设计\">i18n 架构设计</h1><h2 id=\"核心概念\">核心概念</h2><p>国际化（i18n, Internationalization）架构是让 Web 应用支持多语言、多地区的系统性工程。i18n 不仅仅是翻译文本——它涉及文本管理、日期/数字格式化、布局适配（RTL）、图片和媒体本地化等多个维度。良好的 i18n 架构应该让开发者在编写功能时无需关心具体语言，而是通过抽象层自动处理本地化需求。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[i18n 架构] --&gt; B[文本管理]&#10;    A --&gt; C[格式化]&#10;    A --&gt; D[布局适配]&#10;    A --&gt; E[资源加载]&#10;&#10;    B --&gt; B1[翻译键值对]&#10;    B --&gt; B2[复数规则]&#10;    B --&gt; B3[上下文翻译]&#10;&#10;    C --&gt; C1[日期/时间]&#10;    C --&gt; C2[数字/货币]&#10;    C --&gt; C3[排序规则]&#10;&#10;    D --&gt; D1[RTL 支持]&#10;    D --&gt; D2[文本长度变化]&#10;    D --&gt; D3[字体回退]&#10;&#10;    E --&gt; E1[按需加载]&#10;    E --&gt; E2[缓存策略]&#10;    E --&gt; E3[回退机制]\">graph TD\n    A[i18n 架构] --&gt; B[文本管理]\n    A --&gt; C[格式化]\n    A --&gt; D[布局适配]\n    A --&gt; E[资源加载]\n\n    B --&gt; B1[翻译键值对]\n    B --&gt; B2[复数规则]\n    B --&gt; B3[上下文翻译]\n\n    C --&gt; C1[日期/时间]\n    C --&gt; C2[数字/货币]\n    C --&gt; C3[排序规则]\n\n    D --&gt; D1[RTL 支持]\n    D --&gt; D2[文本长度变化]\n    D --&gt; D3[字体回退]\n\n    E --&gt; E1[按需加载]\n    E --&gt; E2[缓存策略]\n    E --&gt; E3[回退机制]</pre><table>\n<thead>\n<tr>\n<th>i18n 维度</th>\n<th>内容</th>\n<th>常见工具</th>\n<th>复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>文本翻译</td>\n<td>界面文字的多语言版本</td>\n<td>react-intl, i18next</td>\n<td>中</td>\n</tr>\n<tr>\n<td>格式化</td>\n<td>日期、数字、货币格式</td>\n<td>Intl API</td>\n<td>低</td>\n</tr>\n<tr>\n<td>复数处理</td>\n<td>不同语言的复数规则</td>\n<td>ICU MessageFormat</td>\n<td>高</td>\n</tr>\n<tr>\n<td>RTL 支持</td>\n<td>阿拉伯语等从右到左的布局</td>\n<td>CSS logical properties</td>\n<td>高</td>\n</tr>\n<tr>\n<td>内容协商</td>\n<td>语言检测和切换</td>\n<td>Accept-Language, 用户偏好</td>\n<td>低</td>\n</tr>\n</tbody></table>\n<h2 id=\"翻译资源管理\">翻译资源管理</h2><p>翻译资源通常以 JSON 格式组织，按语言和命名空间分文件。命名空间隔离不同功能模块的翻译，支持按需加载。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 翻译资源结构&#10;// locales/&#10;// ├── zh-CN/&#10;// │   ├── common.json&#10;// │   ├── auth.json&#10;// │   └── product.json&#10;// ├── en-US/&#10;// │   ├── common.json&#10;// │   ├── auth.json&#10;// │   └── product.json&#10;// └── ja-JP/&#10;//     └── ...&#10;&#10;// common.json 示例&#10;const zhCNCommon = {&#10;  app: {&#10;    title: &#39;文档中心&#39;,&#10;    loading: &#39;加载中...&#39;,&#10;    error: &#39;发生错误，请稍后重试&#39;,&#10;  },&#10;  nav: {&#10;    home: &#39;首页&#39;,&#10;    docs: &#39;文档&#39;,&#10;    settings: &#39;设置&#39;,&#10;  },&#10;  actions: {&#10;    save: &#39;保存&#39;,&#10;    cancel: &#39;取消&#39;,&#10;    delete: &#39;删除&#39;,&#10;    confirm: &#39;确认&#39;,&#10;  },&#10;};&#10;&#10;// i18n 初始化配置&#10;import i18n from &#39;i18next&#39;;&#10;import { initReactI18next } from &#39;react-i18next&#39;;&#10;&#10;const i18nConfig = {&#10;  fallbackLng: &#39;en-US&#39;,&#10;  supportedLngs: [&#39;zh-CN&#39;, &#39;en-US&#39;, &#39;ja-JP&#39;],&#10;  ns: [&#39;common&#39;, &#39;auth&#39;, &#39;product&#39;],&#10;  defaultNS: &#39;common&#39;,&#10;  interpolation: {&#10;    escapeValue: false,&#10;  },&#10;  backend: {&#10;    loadPath: &#39;/locales/{{lng}}/{{ns}}.json&#39;,&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 翻译资源结构</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// locales/</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ├── zh-CN/</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// │   ├── common.json</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// │   ├── auth.json</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// │   └── product.json</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ├── en-US/</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// │   ├── common.json</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// │   ├── auth.json</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// │   └── product.json</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// └── ja-JP/</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//     └── ...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// common.json 示例</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> zhCNCommon</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  app: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'文档中心'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    loading: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'加载中...'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    error: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'发生错误，请稍后重试'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  nav: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    home: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'首页'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    docs: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'文档'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    settings: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'设置'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  actions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    save: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'保存'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    cancel: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'取消'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    delete: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'删除'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    confirm: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'确认'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// i18n 初始化配置</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i18n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'i18next'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { initReactI18next } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'react-i18next'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> i18nConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  fallbackLng: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'en-US'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  supportedLngs: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'zh-CN'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'en-US'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ja-JP'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ns: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'common'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'auth'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'product'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  defaultNS: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'common'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  interpolation: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    escapeValue: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  backend: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    loadPath: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/locales/{{lng}}/{{ns}}.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>翻译键的命名规范直接影响维护效率。推荐使用嵌套结构 + 功能语义命名（如 <code>auth.login.title</code>），而非平铺的描述性键名（如 <code>login_page_title_text</code>）。</p>\n<table>\n<thead>\n<tr>\n<th>命名策略</th>\n<th>示例</th>\n<th>优点</th>\n<th>缺点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>嵌套语义</td>\n<td><code>auth.login.title</code></td>\n<td>结构清晰、易维护</td>\n<td>键较长</td>\n</tr>\n<tr>\n<td>平铺描述</td>\n<td><code>login_title</code></td>\n<td>简短</td>\n<td>难以组织、容易冲突</td>\n</tr>\n<tr>\n<td>内容即键</td>\n<td><code>&quot;登录&quot;</code></td>\n<td>无需查找翻译键</td>\n<td>原文修改需同步更新所有翻译</td>\n</tr>\n<tr>\n<td>哈希生成</td>\n<td><code>t_a1b2c3</code></td>\n<td>自动化友好</td>\n<td>不可读、调试困难</td>\n</tr>\n</tbody></table>\n<h2 id=\"语言检测与切换\">语言检测与切换</h2><p>语言检测需要综合多个信号源，按优先级确定用户的首选语言。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const detectLanguage = (): string =&gt; {&#10;  const supported = [&#39;zh-CN&#39;, &#39;en-US&#39;, &#39;ja-JP&#39;];&#10;&#10;  const urlLang = new URLSearchParams(window.location.search).get(&#39;lang&#39;);&#10;  if (urlLang &amp;&amp; supported.includes(urlLang)) return urlLang;&#10;&#10;  const storedLang = localStorage.getItem(&#39;preferred-language&#39;);&#10;  if (storedLang &amp;&amp; supported.includes(storedLang)) return storedLang;&#10;&#10;  const browserLangs = navigator.languages || [navigator.language];&#10;  for (const lang of browserLangs) {&#10;    const match = supported.find((s) =&gt; s === lang || s.startsWith(lang.split(&#39;-&#39;)[0]));&#10;    if (match) return match;&#10;  }&#10;&#10;  return &#39;en-US&#39;;&#10;};&#10;&#10;const switchLanguage = async (lang: string) =&gt; {&#10;  await i18n.changeLanguage(lang);&#10;  localStorage.setItem(&#39;preferred-language&#39;, lang);&#10;  document.documentElement.setAttribute(&#39;lang&#39;, lang);&#10;&#10;  if (isRTL(lang)) {&#10;    document.documentElement.setAttribute(&#39;dir&#39;, &#39;rtl&#39;);&#10;  } else {&#10;    document.documentElement.setAttribute(&#39;dir&#39;, &#39;ltr&#39;);&#10;  }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> detectLanguage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ()</span><span styl