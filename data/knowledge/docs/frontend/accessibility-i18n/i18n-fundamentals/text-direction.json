=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    issue: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'括号不匹配'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    problematic: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'اقرأ الفصل (Chapter 3) الآن'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fix: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'اقرأ الفصل </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\u2066</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(Chapter 3)</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\u2069</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> الآن'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    explanation: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'括号是镜像字符，方向影响配对'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>Unicode 双向算法根据字符类型自动解析混合方向文本的显示顺序</li>\n<li><code>&lt;bdi&gt;</code> 元素是隔离用户生成内容方向的最佳实践，防止方向溢出</li>\n<li>LRI/RLI/PDI 是新一代 Unicode 方向隔离标记，比 LRE/RLE 更安全</li>\n<li>电话号码、文件路径、URL 等混合内容最容易出现方向错误</li>\n<li>CSS 的 <code>unicode-bidi: isolate</code> 是方向隔离的推荐写法</li>\n<li><code>writing-mode</code> 支持中文竖排和蒙古语等特殊书写系统</li>\n</ul>\n","headings":[{"level":1,"text":"文本方向与双向文本","id":"文本方向与双向文本"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Unicode 双向算法","id":"unicode-双向算法"},{"level":2,"text":"HTML 方向控制","id":"html-方向控制"},{"level":2,"text":"CSS direction 与 writing-mode","id":"css-direction-与-writing-mode"},{"level":2,"text":"常见双向文本问题","id":"常见双向文本问题"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"RTL 布局适配","url":"/l-doc-books/h/frontend/accessibility-i18n/i18n-fundamentals/rtl-layout"},"next":{"title":"Unicode 与字符编码","url":"/l-doc-books/h/frontend/accessibility-i18n/i18n-fundamentals/unicode-and-encoding"}}