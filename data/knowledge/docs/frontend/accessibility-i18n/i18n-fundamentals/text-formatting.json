 return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Intl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">RelativeTimeFormat</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(locale, { numeric: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'auto'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">format</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(value, unit);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">formatRelativeTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'day'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'zh-CN'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"昨天\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">formatRelativeTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'day'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'en-US'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"yesterday\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">formatRelativeTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'hour'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'zh-CN'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"3小时后\"</span></span></code></pre></div><h2 id=\"文本方向性处理\">文本方向性处理</h2><p>在混合文本方向（LTR 文本中嵌入 RTL 内容或反之）时，Unicode 双向算法（Bidi Algorithm）可能产生不正确的显示顺序。需要使用方向隔离标记来解决。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const bidiHandling = `&#10;&lt;!-- Unicode 方向隔离 --&gt;&#10;&lt;p&gt;用户 &lt;bdi&gt;محمد&lt;/bdi&gt; 发布了新评论&lt;/p&gt;&#10;&#10;&lt;!-- CSS 逻辑属性（替代物理属性） --&gt;&#10;&lt;style&gt;&#10;  /* 物理属性 — 不适应 RTL */&#10;  .old { margin-left: 16px; padding-right: 8px; text-align: left; }&#10;  &#10;  /* 逻辑属性 — 自动适应文本方向 */&#10;  .new { margin-inline-start: 16px; padding-inline-end: 8px; text-align: start; }&#10;&lt;/style&gt;&#10;`;&#10;&#10;// 文本方向检测&#10;const isRTL = (locale: string): boolean =&gt; {&#10;  const rtlLocales = [&#39;ar&#39;, &#39;he&#39;, &#39;fa&#39;, &#39;ur&#39;];&#10;  return rtlLocales.some((rtl) =&gt; locale.startsWith(rtl));&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bidiHandling</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;!-- Unicode 方向隔离 --></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;p>用户 &#x3C;bdi>محمد&#x3C;/bdi> 发布了新评论&#x3C;/p></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;!-- CSS 逻辑属性（替代物理属性） --></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;style></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  /* 物理属性 — 不适应 RTL */</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  .old { margin-left: 16px; padding-right: 8px; text-align: left; }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  /* 逻辑属性 — 自动适应文本方向 */</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  .new { margin-inline-start: 16px; padding-inline-end: 8px; text-align: start; }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">&#x3C;/style></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 文本方向检测</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> isRTL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">locale</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rtlLocales</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ar'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'he'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'fa'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ur'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rtlLocales.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">some</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rtl</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> locale.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">startsWith</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rtl));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>ICU MessageFormat 是消息格式化的业界标准，支持复数、选择和嵌套格式化</li>\n<li>复数处理需要覆盖目标语言的所有复数类别，阿拉伯语有 6 种复数形式</li>\n<li>数字和货币使用 Intl.NumberFormat，自动处理千分位、小数点和货币符号的地区差异</li>\n<li>日期使用 Intl.DateTimeFormat，支持不同历法和日期顺序</li>\n<li>Intl.RelativeTimeFormat 处理相对时间显示（&quot;昨天&quot;、&quot;3小时后&quot;等）</li>\n<li>混合文本方向使用 <code>&lt;bdi&gt;</code> 元素和 CSS 逻辑属性确保正确的显示顺序</li>\n</ul>\n","headings":[{"level":1,"text":"文本与消息格式化","id":"文本与消息格式化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"复数处理","id":"复数处理"},{"level":2,"text":"数字与货币格式化","id":"数字与货币格式化"},{"level":2,"text":"日期与时间格式化","id":"日期与时间格式化"},{"level":2,"text":"文本方向性处理","id":"文本方向性处理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"本地化测试","url":"/l-doc-books/h/frontend/accessibility-i18n/i18n-fundamentals/l10n-testing"},"next":{"title":"RTL 布局适配","url":"/l-doc-books/h/frontend/accessibility-i18n/i18n-fundamentals/rtl-layout"}}