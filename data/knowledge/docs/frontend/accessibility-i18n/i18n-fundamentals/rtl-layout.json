rder-inline-end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> solid</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">--border</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.nav-item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  margin-inline-end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">rem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  padding-inline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">rem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  padding-block</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">rem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.breadcrumb-separator::after</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  content</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'›'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dir</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'rtl'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.breadcrumb-separator::after</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  content</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'‹'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Flexbox 和 Grid 天然支持逻辑方向——在 RTL 模式下自动反转排列：</p>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\".toolbar {&#10;  display: flex;&#10;  gap: 0.5rem;&#10;}&#10;&#10;.grid-layout {&#10;  display: grid;&#10;  grid-template-columns: 280px 1fr 200px;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.toolbar</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  display</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">flex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  gap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">rem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">.grid-layout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  display</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">grid</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  grid-template-columns</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">280</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">fr</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 200</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const directionAwareStyles = {&#10;  flexExample: `&#10;    /* Flexbox 自动适配 RTL — 无需额外代码 */&#10;    .flex-container {&#10;      display: flex;&#10;      gap: 1rem;&#10;      /* 在 RTL 中，子元素自动从右到左排列 */&#10;    }&#10;    &#10;    /* 只有 row-reverse 需要注意 — 它在 RTL 中会变成从左到右 */&#10;    .flex-reverse {&#10;      flex-direction: row-reverse;&#10;    }&#10;  `,&#10;  gridExample: `&#10;    .grid-layout {&#10;      display: grid;&#10;      grid-template-areas: &quot;sidebar main aside&quot;;&#10;      /* 在 RTL 中：aside 在左，sidebar 在右 */&#10;    }&#10;  `,&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> directionAwareStyles</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  flexExample: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    /* Flexbox 自动适配 RTL — 无需额外代码 */</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    .flex-container {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      display: flex;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      gap: 1rem;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      /* 在 RTL 中，子元素自动从右到左排列 */</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    </span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    /* 只有 row-reverse 需要注意 — 它在 RTL 中会变成从左到右 */</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    .flex-reverse {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      flex-direction: row-reverse;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  `</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  gridExample: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    .grid-layout {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      display: grid;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      grid-template-areas: \"sidebar main aside\";</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      /* 在 RTL 中：aside 在左，sidebar 在右 */</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  `</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>CSS 特性</th>\n<th>RTL 行为</th>\n<th>需要处理</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Flexbox row</td>\n<td>自动反转</td>\n<td>否</td>\n</tr>\n<tr>\n<td>Grid</td>\n<td>自动反转</td>\n<td>否</td>\n</tr>\n<tr>\n<td>position: absolute</td>\n<td>需用逻辑属性</td>\n<td>是</td>\n</tr>\n<tr>\n<td>transform: translateX</td>\n<td>需反转值</td>\n<td>是</td>\n</tr>\n<tr>\n<td>background-position</td>\n<td>需用逻辑值</td>\n<td>是</td>\n</tr>\n<tr>\n<td>box-shadow</td>\n<td>需反转水平偏移</td>\n<td>是</td>\n</tr>\n</tbody></table>\n<h2 id=\"html-方向控制\">HTML 方向控制</h2><p>HTML 的 <code>dir</code> 属性和 CSS 的 <code>direction</code> 属性控制文档的基本方向。正确设置方向是所有 RTL 适配的前提：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import type { FC } from &quot;react&quot;;&#10;&#10;interface DirectionProviderProps {&#10;  locale: string;&#10;  children: React.ReactNode;&#10;}&#10;&#10;const RTL_LOCALES = new Set([&quot;ar&quot;, &quot;he&quot;, &quot;fa&quot;, &quot;ur&quot;, &quot;ps&quot;, &quot;sd&quot;, &quot;yi&quot;]);&#10;&#10;const getDirection = (locale: string): &quot;ltr&quot; | &quot;rtl&quot; =&gt; {&#10;  const lang = locale.split(&quot;-&quot;)[0];&#10;  return RTL_LOCALES.has(lang) ? &quot;rtl&quot; : &quot;ltr&quot;;&#10;};&#10;&#10;const DirectionProvider: FC&lt;DirectionProviderProps&gt; = ({ locale, children }) =&gt; {&#10;  const dir = getDirection(locale);&#10;&#10;  return (&#10;    &lt;div dir={dir} lang={locale} style={{ direction: dir }}&gt;&#10;      {children}&#10;    &lt;/div&gt;&#10;  );&#10;};&#10;&#10;const useDirection = (locale: string) =&gt; {&#10;  const dir = getDirection(locale);&#10;  const isRtl = dir === &quot;rtl&quot;;&#10;&#10;  return {&#10;    dir,&#10;    isRtl,&#10;    startSide: isRtl ? &quot;right&quot; : &quot;left&quot;,&#10;    endSide: isRtl ? &quot;left&quot; : &quot;right&quot;,&#10;  };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { FC } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"react\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface<