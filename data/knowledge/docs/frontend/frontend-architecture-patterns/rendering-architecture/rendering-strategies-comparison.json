">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">post</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    params: { slug: post.slug },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    props: { post },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Astro.props;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">---</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">BlogLayout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">article </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:html</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{post.body} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">BlogLayout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// src/pages/search.astro - SSR (按需)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> prerender</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 标记为 SSR</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">---</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> query</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Astro.url.searchParams.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'q'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> results</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> searchAPI</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">---</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SearchResults results</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{results} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"混合策略的黄金法则\">混合策略的黄金法则</h3><ol>\n<li><p><strong>默认静态，按需动态</strong>：项目中 80% 的页面通常适合 SSG/ISR，仅将真正需要实时数据的页面标记为 SSR。</p>\n</li>\n<li><p><strong>数据新鲜度分层</strong>：在同一页面中将静态内容和动态内容分离。产品描述用 ISR (revalidate: 3600)，库存状态用客户端 fetch。</p>\n</li>\n<li><p><strong>避免全局 SSR</strong>：SSR 意味着每次请求都消耗服务器资源。对于高流量站点，这直接转化为服务器成本。</p>\n</li>\n<li><p><strong>SEO 需求明确化</strong>：如果页面不需要搜索引擎索引（如管理后台），不需要 SSR。CSR 的 TTFB 反而更快。</p>\n</li>\n<li><p><strong>CDN 友好性优先</strong>：SSG 和 ISR 的页面可以直接缓存在边缘节点。设计 cache key 时考虑 URL 参数和 cookie 的影响。</p>\n</li>\n</ol>\n<h3 id=\"常见陷阱\">常见陷阱</h3><table>\n<thead>\n<tr>\n<th>陷阱</th>\n<th>表现</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SSR 瀑布请求</td>\n<td>嵌套组件串行 fetch，TTFB 激增</td>\n<td>并行化数据获取，使用 Suspense 分段流式</td>\n</tr>\n<tr>\n<td>ISR 冷启动</td>\n<td>首个访问者看到旧版本</td>\n<td>部署后预热关键页面，配置 on-demand revalidation</td>\n</tr>\n<tr>\n<td>Hydration 不匹配</td>\n<td>服务端/客户端 HTML 差异导致报错</td>\n<td>使用 <code>suppressHydrationWarning</code>，确保环境判断一致</td>\n</tr>\n<tr>\n<td>CSR 白屏</td>\n<td>JS 加载和执行完成前无内容</td>\n<td>添加骨架屏，使用 <code>loading.tsx</code> 文件</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>框架</th>\n<th>SSG</th>\n<th>SSR</th>\n<th>ISR</th>\n<th>Streaming</th>\n<th>Islands</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Next.js 16</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅ (PPR)</td>\n<td>❌</td>\n</tr>\n<tr>\n<td>Astro 6</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅ (原生)</td>\n</tr>\n<tr>\n<td>SvelteKit 2</td>\n<td>✅</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>❌</td>\n</tr>\n<tr>\n<td>Nuxt 4</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅ (NuxtIsland)</td>\n</tr>\n<tr>\n<td>Remix 3</td>\n<td>❌</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>❌</td>\n</tr>\n</tbody></table>\n<p><strong>性能测量工具</strong>：</p>\n<ul>\n<li>Lighthouse CI：自动化 CI 中的性能审计</li>\n<li>Web Vitals Chrome Extension：实时查看 CWV 指标</li>\n<li>SpeedCurve / Calibre：长期性能趋势监控</li>\n<li><code>next build</code> 输出：显示每个路由的渲染策略标记</li>\n</ul>\n<h2 id=\"总结\">总结</h2><p>渲染策略选型的核心原则是「数据特征决定渲染模式」：静态内容用 SSG，低频更新用 ISR，实时个性化用 SSR，纯交互用 CSR。2026 年的最佳实践是混合渲染——在同一项目中按路由和数据特征组合多种策略，并通过流式传输和 Partial Prerendering 消除策略间的性能断层。选择渲染策略时，始终从 Core Web Vitals 目标值倒推，而非从技术偏好出发。</p>\n","headings":[{"level":1,"text":"渲染策略对比与选型","id":"渲染策略对比与选型"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"四种渲染模式的工作原理","id":"四种渲染模式的工作原理"},{"level":3,"text":"性能指标对比","id":"性能指标对比"},{"level":3,"text":"流式 SSR 与 Partial Prerendering","id":"流式-ssr-与-partial-prerendering"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"基于页面类型的策略选择","id":"基于页面类型的策略选择"},{"level":3,"text":"Next.js 16 混合渲染配置","id":"next-js-16-混合渲染配置"},{"level":3,"text":"Astro 混合渲染配置","id":"astro-混合渲染配置"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"混合策略的黄金法则","id":"混合策略的黄金法则"},{"level":3,"text":"常见陷阱","id":"常见陷阱"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":null,"next":{"title":"Islands Architecture 实践","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/rendering-architecture/islands-architecture"}}