line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { getCollection } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'astro:content'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getStaticPaths</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> posts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCollection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'blog'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, ({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">data.draft);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> posts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">post</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    params: { slug: post.slug },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    props: { post },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Astro.props;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Content</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> post.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">---</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">article</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">h1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{post.data.title}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">h1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Content </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">article</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"islands-粒度设计原则\">Islands 粒度设计原则</h3><ol>\n<li><p><strong>最小化原则</strong>：一个 Island 应该是最小的可交互单元。不要把整个侧边栏做成一个 Island，只 hydrate 其中需要交互的按钮。</p>\n</li>\n<li><p><strong>状态隔离</strong>：每个 Island 应有自己的状态管理。跨 Island 通信使用 <code>nanostores</code>（Astro 推荐的轻量状态库）：</p>\n</li>\n</ol>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// src/stores/cart.ts&#10;import { atom, map } from &#39;nanostores&#39;;&#10;&#10;export const cartItems = map&lt;Record&lt;string, CartItem&gt;&gt;({});&#10;export const cartCount = atom(0);&#10;&#10;export function addToCart(item: CartItem) {&#10;  cartItems.setKey(item.id, item);&#10;  cartCount.set(Object.keys(cartItems.get()).length);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// src/stores/cart.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { atom, map } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'nanostores'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cartItems</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">CartItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>({});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cartCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> atom</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> addToCart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CartItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  cartItems.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setKey</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.id, item);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  cartCount.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">keys</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(cartItems.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><ol start=\"3\">\n<li><p><strong>渐进增强</strong>：Island 加载前页面应该可读可用。搜索表单即使 JS 未加载也应能通过 form action 提交。</p>\n</li>\n<li><p><strong>延迟非关键 Islands</strong>：首屏之外的交互组件全部使用 <code>client:visible</code>，将初始 JS 降到最低。</p>\n</li>\n</ol>\n<h3 id=\"何时不该用-islands-architecture\">何时不该用 Islands Architecture</h3><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>原因</th>\n<th>替代方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>复杂 SPA（Figma/Google Docs）</td>\n<td>全页面都是交互，Islands 无意义</td>\n<td>传统 SPA + Code Splitting</td>\n</tr>\n<tr>\n<td>高度个性化仪表盘</td>\n<td>几乎每个组件都依赖用户数据</td>\n<td>RSC + SSR Streaming</td>\n</tr>\n<tr>\n<td>实时协作应用</td>\n<td>WebSocket 全局状态，组件间强耦合</td>\n<td>传统 SPA</td>\n</tr>\n<tr>\n<td>频繁全局状态更新</td>\n<td>Islands 间通信成本高于全量 hydration</td>\n<td>Next.js 或 SvelteKit</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"支持-islands-模式的框架\">支持 Islands 模式的框架</h3><table>\n<thead>\n<tr>\n<th>框架</th>\n<th>Islands 方式</th>\n<th>多框架支持</th>\n<th>Server Islands</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Astro 6</td>\n<td><code>client:*</code> 指令</td>\n<td>✅ (React/Vue/Svelte/Solid)</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>Fresh (Deno)</td>\n<td>Islands 目录约定</td>\n<td>❌ (Preact only)</td>\n<td>❌</td>\n</tr>\n<tr>\n<td>Îles</td>\n<td>Vue 组件指令</td>\n<td>❌ (Vue only)</td>\n<td>❌</td>\n</tr>\n<tr>\n<td>Nuxt 4</td>\n<td><code>&lt;NuxtIsland&gt;</code></td>\n<td>❌ (Vue only)</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>Marko</td>\n<td>编译时自动拆分</td>\n<td>❌</td>\n<td>❌</td>\n</tr>\n</tbody></table>\n<h3 id=\"部署平台适配\">部署平台适配</h3><ul>\n<li><strong>Cloudflare Pages</strong>：Astro 6 原生适配，构建输出直接部署，全球 CDN 分发。Server Islands 在 Edge Workers 中执行。</li>\n<li><strong>Vercel</strong>：通过 <code>@astrojs/vercel</code> 适配器，支持 Edge Functions 和 Serverless Functions。</li>\n<li><strong>Netlify</strong>：通过 <code>@astrojs/netlify</code> 适配器，支持 Edge Functions。</li>\n<li><strong>静态托管（S3/GH Pages）</strong>：纯 SSG 模式，无 Server Islands 能力。</li>\n</ul>\n<h2 id=\"总结\">总结</h2><p>Islands Architecture 的核心价值在于「默认零 JavaScript，按需渐进增强」。对于内容驱动的站点（博客、文档、营销页、电商列表），它提供了目前最优的性能表现——Lighthouse 接近满分、毫秒级 FCP、极低的托管成本。Astro 6 通过 Server Islands 进一步扩展了该模式的适用范围，让个性化内容也能在不增加客户端 JS 的前提下动态渲染。选择 Islands 架构的关键判断标准是：页面中静态内容占比是否超过 60%——如果是，Islands 几乎总是比传统 SPA 更好的选择。</p>\n","headings":[{"level":1,"text":"Islands Architecture 实践","id":"islands-architecture-实践"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"选择性水合 vs 全量水合","id":"选择性水合-vs-全量水合"},{"level":3,"text":"Client Islands vs Server Islands","id":"client-islands-vs-server-islands"},{"level":3,"text":"加载策略指令","id":"加载策略指令"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"从零搭建 Astro 6 Islands 项目","id":"从零搭建-astro-6-islands-项目"},{"level":3,"text":"多框架混合使用","id":"多框架混合使用"},{"level":3,"text":"性能对比实测数据","id":"性能对比实测数据"},{"level":3,"text":"Content Collections 与类型安全","id":"content-collections-与类型安全"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"Islands 粒度设计原则","id":"islands-粒度设计原则"},{"level":3,"text":"何时不该用 Islands Architecture","id":"何时不该用-islands-architecture"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"支持 Islands 模式的框架","id":"支持-islands-模式的框架"},{"level":3,"text":"部署平台适配","id":"部署平台适配"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"渲染策略对比与选型","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/rendering-architecture/rendering-strategies-comparison"},"next":{"title":"React Server Components 架构原理","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/rendering-architecture/react-server-components"}}