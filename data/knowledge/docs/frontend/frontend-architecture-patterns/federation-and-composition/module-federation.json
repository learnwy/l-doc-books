n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 工具库: 允许多版本共存</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  lodash</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">requiredVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'^4.0.0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 非 singleton</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'date-fns'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { requiredVersion: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'^4.0.0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"构建性能对比\">构建性能对比</h3><table>\n<thead>\n<tr>\n<th>构建工具</th>\n<th>冷启动</th>\n<th>热更新</th>\n<th>MF2 支持</th>\n<th>兼容性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Webpack 5</td>\n<td>慢 (30-60s)</td>\n<td>中 (2-5s)</td>\n<td>✅ 原生</td>\n<td>最高</td>\n</tr>\n<tr>\n<td>Rspack</td>\n<td>快 (3-8s)</td>\n<td>快 (0.5-1s)</td>\n<td>✅ @module-federation/enhanced</td>\n<td>高 (Webpack 兼容)</td>\n</tr>\n<tr>\n<td>Vite</td>\n<td>快 (instant)</td>\n<td>最快 (50ms)</td>\n<td>✅ @module-federation/vite</td>\n<td>中</td>\n</tr>\n</tbody></table>\n<h3 id=\"错误处理与降级\">错误处理与降级</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 远程加载失败的降级处理&#10;import { ErrorBoundary } from &#39;react-error-boundary&#39;;&#10;&#10;function RemoteModuleFallback({ error }: { error: Error }) {&#10;  return (&#10;    &lt;div className=&quot;remote-error&quot;&gt;&#10;      &lt;p&gt;Module temporarily unavailable&lt;/p&gt;&#10;      &lt;button onClick={() =&gt; window.location.reload()}&gt;Retry&lt;/button&gt;&#10;    &lt;/div&gt;&#10;  );&#10;}&#10;&#10;function App() {&#10;  return (&#10;    &lt;ErrorBoundary FallbackComponent={RemoteModuleFallback}&gt;&#10;      &lt;Suspense fallback={&lt;Skeleton /&gt;}&gt;&#10;        &lt;RemoteProductList /&gt;&#10;      &lt;/Suspense&gt;&#10;    &lt;/ErrorBoundary&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 远程加载失败的降级处理</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ErrorBoundary } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'react-error-boundary'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RemoteModuleFallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">error</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"remote-error\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Module temporarily unavailable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">p</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button onClick</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{() => window.location.reload()}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Retry</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> App</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ErrorBoundary FallbackComponent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{RemoteModuleFallback}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{&#x3C;Skeleton />}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">RemoteProductList </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Suspense</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ErrorBoundary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"何时不该用-module-federation\">何时不该用 Module Federation</h3><ul>\n<li><strong>小团队 (1-2 个) 单一部署</strong>：monorepo 的开发体验更好</li>\n<li><strong>原型/MVP 阶段</strong>：增加复杂度无收益</li>\n<li><strong>强一致性需求</strong>：所有模块必须同版本发布时，MF 的独立部署优势消失</li>\n<li><strong>无 CDN 基础设施</strong>：远程模块加载依赖稳定的静态资源托管</li>\n</ul>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n<th>状态</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>@module-federation/enhanced</td>\n<td>核心插件 (Webpack + Rspack)</td>\n<td>✅ 生产稳定</td>\n</tr>\n<tr>\n<td>@module-federation/vite</td>\n<td>Vite 支持</td>\n<td>✅ 稳定</td>\n</tr>\n<tr>\n<td>@module-federation/runtime</td>\n<td>运行时 API</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>MF Chrome DevTools</td>\n<td>依赖可视化和调试</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>Side Effect Scanner</td>\n<td>静态分析远程副作用</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>mf-manifest.json</td>\n<td>部署发现协议</td>\n<td>✅</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>Module Federation 2.0 解决了微前端运行时集成的三大痛点：类型安全（dts）、构建工具锁定（统一 runtime）、版本管理（manifest 协议）。对于 3 个以上团队并行开发的大型应用，MF2 + Rspack 的组合提供了独立部署、运行时共享、5-10 倍构建加速的完整方案。但它不是银弹——对于单团队维护的项目，monorepo + Code Splitting 仍然是更简单、更高效的选择。选择 Module Federation 的核心判断标准是：是否有多个团队需要独立发布各自负责的功能模块。</p>\n","headings":[{"level":1,"text":"Module Federation 实践","id":"module-federation-实践"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"Module Federation 2.0 核心升级","id":"module-federation-2-0-核心升级"},{"level":3,"text":"Host 与 Remote 模型","id":"host-与-remote-模型"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"Rspack + MF2 完整配置","id":"rspack-mf2-完整配置"},{"level":3,"text":"动态远程注册","id":"动态远程注册"},{"level":3,"text":"共享依赖版本策略","id":"共享依赖版本策略"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"构建性能对比","id":"构建性能对比"},{"level":3,"text":"错误处理与降级","id":"错误处理与降级"},{"level":3,"text":"何时不该用 Module Federation","id":"何时不该用-module-federation"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"模块化分层策略","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/application-structure/modular-layering-strategies"},"next":{"title":"微前端运行时集成","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/federation-and-composition/micro-frontend-runtime-integration"}}