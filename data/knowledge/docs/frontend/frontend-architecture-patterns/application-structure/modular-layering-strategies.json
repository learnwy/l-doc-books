span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ 导出类型</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { User, AuthState, LoginCredentials } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> './types'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ❌ 不导出内部实现细节</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// export { authApi } from './api/authApi';</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// export { tokenStorage } from './lib/tokenStorage';</span></span></code></pre></div><h3 id=\"依赖方向管理\">依赖方向管理</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[&quot;apps/web&quot;] --&gt; B[&quot;features/auth&quot;]&#10;    A --&gt; C[&quot;features/products&quot;]&#10;    A --&gt; D[&quot;features/cart&quot;]&#10;    B --&gt; E[&quot;shared/ui&quot;]&#10;    C --&gt; E&#10;    D --&gt; E&#10;    B --&gt; F[&quot;shared/api-client&quot;]&#10;    C --&gt; F&#10;    D --&gt; F&#10;    D --&gt; G[&quot;shared/utils&quot;]\">graph TD\n    A[\"apps/web\"] --&gt; B[\"features/auth\"]\n    A --&gt; C[\"features/products\"]\n    A --&gt; D[\"features/cart\"]\n    B --&gt; E[\"shared/ui\"]\n    C --&gt; E\n    D --&gt; E\n    B --&gt; F[\"shared/api-client\"]\n    C --&gt; F\n    D --&gt; F\n    D --&gt; G[\"shared/utils\"]</pre><p><strong>规则</strong>：依赖图必须是 DAG（有向无环图）。如果两个 feature 需要共享逻辑，提升到 shared 层而非直接互相依赖。</p>\n<h3 id=\"渐进式迁移-checklist\">渐进式迁移 Checklist</h3><ol>\n<li><strong>识别模块候选</strong>：按业务功能（非技术类型）划分模块边界</li>\n<li><strong>创建 barrel exports</strong>：为每个模块添加 <code>index.ts</code>，收敛对外接口</li>\n<li><strong>添加导入规则</strong>：ESLint 或 TypeScript paths 限制跨模块直接导入</li>\n<li><strong>提取 shared</strong>：将跨模块复用的代码移入 shared 包</li>\n<li><strong>独立 package.json</strong>：当模块足够独立时，升级为 monorepo package</li>\n<li><strong>独立 CI job</strong>：按模块变更触发对应的 test/lint/build</li>\n</ol>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>pnpm workspace</td>\n<td>包管理</td>\n<td>硬链接节省空间，workspace 协议</td>\n</tr>\n<tr>\n<td>Turborepo</td>\n<td>构建编排</td>\n<td>增量构建，远程缓存</td>\n</tr>\n<tr>\n<td>Nx</td>\n<td>全套 monorepo</td>\n<td>依赖图分析，受影响项目检测</td>\n</tr>\n<tr>\n<td>tsup</td>\n<td>包构建</td>\n<td>零配置 TypeScript 打包</td>\n</tr>\n<tr>\n<td>changesets</td>\n<td>版本管理</td>\n<td>monorepo 版本发布</td>\n</tr>\n<tr>\n<td>Dependency Cruiser</td>\n<td>依赖可视化</td>\n<td>SVG 依赖图，规则校验</td>\n</tr>\n</tbody></table>\n<h3 id=\"构建性能对比\">构建性能对比</h3><table>\n<thead>\n<tr>\n<th>工具链</th>\n<th>10 包</th>\n<th>50 包</th>\n<th>200 包</th>\n<th>远程缓存</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Turborepo</td>\n<td>12s</td>\n<td>45s</td>\n<td>180s</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>Nx</td>\n<td>10s</td>\n<td>40s</td>\n<td>150s</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>Lerna (legacy)</td>\n<td>30s</td>\n<td>120s</td>\n<td>600s+</td>\n<td>❌</td>\n</tr>\n<tr>\n<td>pnpm --filter</td>\n<td>15s</td>\n<td>60s</td>\n<td>240s</td>\n<td>❌</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>模块化分层的本质是&quot;用构建系统的约束力替代人的纪律性&quot;。小团队可以从目录约定开始，随着项目增长逐步引入 TypeScript 项目引用、ESLint 边界规则，最终演进为完整的 monorepo package 隔离。关键原则是：每次添加约束都应该解决一个已经存在的问题（而非预防假想问题），保持架构复杂度与项目规模匹配。过早引入 monorepo 对 3 人团队是负担，但当团队扩展到 10 人以上时，缺乏包隔离的单体应用将快速陷入&quot;大泥球&quot;困境。</p>\n","headings":[{"level":1,"text":"模块化分层策略","id":"模块化分层策略"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"模块化的三个维度","id":"模块化的三个维度"},{"level":3,"text":"模块边界的强制手段","id":"模块边界的强制手段"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"渐进式分层：从简单到复杂","id":"渐进式分层-从简单到复杂"},{"level":3,"text":"Monorepo 工具链配置","id":"monorepo-工具链配置"},{"level":3,"text":"TypeScript 项目引用","id":"typescript-项目引用"},{"level":3,"text":"ESLint 边界规则","id":"eslint-边界规则"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"模块接口设计","id":"模块接口设计"},{"level":3,"text":"依赖方向管理","id":"依赖方向管理"},{"level":3,"text":"渐进式迁移 Checklist","id":"渐进式迁移-checklist"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"构建性能对比","id":"构建性能对比"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"Clean Architecture 前端实践","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/application-structure/clean-architecture-frontend"},"next":{"title":"Module Federation 实践","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/federation-and-composition/module-federation"}}