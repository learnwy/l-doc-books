#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.pricingService);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// presentation/hooks/useCreateOrder.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { useMutation, useQueryClient } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@tanstack/react-query'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { container } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@/infrastructure/di/container'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useCreateOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> queryClient</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useQueryClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useMutation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    mutationFn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dto</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CreateOrderDTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> container.createOrderUseCase.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(dto),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    onSuccess</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      queryClient.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">invalidateQueries</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ queryKey: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'orders'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"何时使用-clean-architecture\">何时使用 Clean Architecture</h3><table>\n<thead>\n<tr>\n<th>适用场景</th>\n<th>不适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>复杂业务逻辑（电商、金融）</td>\n<td>简单 CRUD 应用</td>\n</tr>\n<tr>\n<td>多团队协作、长期维护</td>\n<td>原型或 MVP 阶段</td>\n</tr>\n<tr>\n<td>可能更换框架/技术栈</td>\n<td>技术栈稳定的小项目</td>\n</tr>\n<tr>\n<td>需要高覆盖率单元测试</td>\n<td>主要是 UI 展示</td>\n</tr>\n<tr>\n<td>领域逻辑需跨平台复用</td>\n<td>单平台简单应用</td>\n</tr>\n</tbody></table>\n<h3 id=\"测试策略的收益\">测试策略的收益</h3><p>Clean Architecture 让测试变得自然：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 单元测试 Use Case - 无需启动 React/浏览器&#10;import { CreateOrderUseCase } from &#39;./CreateOrderUseCase&#39;;&#10;import { InMemoryOrderRepository } from &#39;@/test/mocks/InMemoryOrderRepository&#39;;&#10;import { InMemoryUserRepository } from &#39;@/test/mocks/InMemoryUserRepository&#39;;&#10;&#10;describe(&#39;CreateOrderUseCase&#39;, () =&gt; {&#10;  it(&#39;should create order for active user&#39;, async () =&gt; {&#10;    const orderRepo = new InMemoryOrderRepository();&#10;    const userRepo = new InMemoryUserRepository();&#10;    userRepo.addUser({ id: &#39;1&#39;, isActive: true, tier: &#39;gold&#39; });&#10;&#10;    const useCase = new CreateOrderUseCase(orderRepo, userRepo, new PricingService());&#10;    const order = await useCase.execute({&#10;      userId: &#39;1&#39;,&#10;      items: [{ productId: &#39;p1&#39;, quantity: 2 }],&#10;      address: { city: &#39;Beijing&#39; },&#10;    });&#10;&#10;    expect(order.totalPrice).toBeGreaterThan(0);&#10;    expect(orderRepo.orders).toHaveLength(1);&#10;  });&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 单元测试 Use Case - 无需启动 React/浏览器</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { CreateOrderUseCase } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> './CreateOrderUseCase'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { InMemoryOrderRepository } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@/test/mocks/InMemoryOrderRepository'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { InMemoryUserRepository } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@/test/mocks/InMemoryUserRepository'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">describe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'CreateOrderUseCase'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  it</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'should create order for active user'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> orderRepo</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InMemoryOrderRepository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> userRepo</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InMemoryUserRepository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    userRepo.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, isActive: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, tier: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'gold'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> useCase</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CreateOrderUseCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(orderRepo, userRepo, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PricingService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> order</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> useCase.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      userId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      items: [{ productId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'p1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, quantity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      address: { city: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Beijing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(order.totalPrice).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeGreaterThan</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(orderRepo.orders).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toHaveLength</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"前端适配的务实简化\">前端适配的务实简化</h3><p>完全的 Clean Architecture 在前端会引入过多抽象。务实建议：</p>\n<ol>\n<li><strong>小项目跳过 Use Case 层</strong>：直接在 Hooks 中调用 Repository，当逻辑变复杂时再提取。</li>\n<li><strong>用函数替代类</strong>：TypeScript 中函数式风格更常见，Use Case 可以是函数而非类。</li>\n<li><strong>Repository 接口按需定义</strong>：不需要为每个 Entity 都定义 Repository，仅在有多种实现（测试 mock、缓存代理）时才抽象。</li>\n<li><strong>Domain 层保持纯净</strong>：这是最重要的原则。即使其他层简化，Domain 层绝不依赖框架代码。</li>\n</ol>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n<th>适配性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>TSyringe / Inversify</td>\n<td>依赖注入容器</td>\n<td>重量级，适合大型项目</td>\n</tr>\n<tr>\n<td>手动工厂函数</td>\n<td>简单 DI</td>\n<td>轻量级，适合中小项目</td>\n</tr>\n<tr>\n<td>Dependency Cruiser</td>\n<td>依赖方向检查</td>\n<td>验证层级导入规则</td>\n</tr>\n<tr>\n<td>ESLint import rules</td>\n<td>导入路径限制</td>\n<td>与 FSD 类似的边界检查</td>\n</tr>\n<tr>\n<td>Vitest / Jest</td>\n<td>单元测试</td>\n<td>Domain/Application 层纯逻辑测试</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>Clean Architecture 在前端的核心价值不是文件夹结构本身，而是它强制建立的思维模式：将业务逻辑与技术实现分离。当团队建立了这种思维模式后，即使在不严格遵循四层结构的项目中，也能自然地写出低耦合、易测试的代码。对于中大型前端项目，建议至少实现 Domain 层的独立——让核心业务规则不依赖任何框架或库。这个投入的回报是：业务逻辑的单元测试可以在毫秒级完成、技术栈迁移时核心代码零修改、新团队成员通过阅读 Domain 层即可理解业务全貌。</p>\n","headings":[{"level":1,"text":"Clean Architecture 前端实践","id":"clean-architecture-前端实践"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"同心圆分层模型","id":"同心圆分层模型"},{"level":3,"text":"前端四层架构","id":"前端四层架构"},{"level":3,"text":"依赖反转在前端的实现","id":"依赖反转在前端的实现"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"目录结构","id":"目录结构"},{"level":3,"text":"Use Case 实现","id":"use-case-实现"},{"level":3,"text":"依赖注入与 React Hooks 集成","id":"依赖注入与-react-hooks-集成"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"何时使用 Clean Architecture","id":"何时使用-clean-architecture"},{"level":3,"text":"测试策略的收益","id":"测试策略的收益"},{"level":3,"text":"前端适配的务实简化","id":"前端适配的务实简化"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"Feature Sliced Design 方法论","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/application-structure/feature-sliced-design"},"next":{"title":"模块化分层策略","url":"/l-doc-books/h/frontend/frontend-architecture-patterns/application-structure/modular-layering-strategies"}}