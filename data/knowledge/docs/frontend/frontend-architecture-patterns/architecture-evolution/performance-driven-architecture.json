=\"color:#032F62;--shiki-dark:#9ECBFF\">\"budget\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">80</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"unit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kb\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"compression\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"gzip\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"third-party-js\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"budget\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"unit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kb\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"compression\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"gzip\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"timing\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"ttfb\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"budget\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">600</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"unit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ms\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"fcp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"budget\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1800</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"unit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ms\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"tti\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"budget\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3800</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"unit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ms\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"架构决策的性能代价量化\">架构决策的性能代价量化</h3><table>\n<thead>\n<tr>\n<th>决策</th>\n<th>JS 增量</th>\n<th>LCP 影响</th>\n<th>INP 影响</th>\n<th>代价评估</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>引入 React (CSR)</td>\n<td>+45KB gzip</td>\n<td>+800-1200ms</td>\n<td>+50-100ms</td>\n<td>高</td>\n</tr>\n<tr>\n<td>SSR 替代 CSR</td>\n<td>-20KB (无需 loading state)</td>\n<td>-600-1000ms</td>\n<td>不变</td>\n<td>负代价（收益）</td>\n</tr>\n<tr>\n<td>添加分析 SDK</td>\n<td>+15-30KB</td>\n<td>+200-400ms</td>\n<td>+20-50ms</td>\n<td>中</td>\n</tr>\n<tr>\n<td>CSS-in-JS (Styled Components)</td>\n<td>+12KB runtime</td>\n<td>+100ms</td>\n<td>+30ms (runtime)</td>\n<td>中低</td>\n</tr>\n<tr>\n<td>全量 Tailwind CSS</td>\n<td>+25KB (build) → 3KB (purged)</td>\n<td>可忽略</td>\n<td>无影响</td>\n<td>低</td>\n</tr>\n<tr>\n<td>Islands 替代 Full Hydration</td>\n<td>-80-150KB</td>\n<td>-500-1500ms</td>\n<td>-100-200ms</td>\n<td>负代价（巨大收益）</td>\n</tr>\n</tbody></table>\n<h2 id=\"实战指南\">实战指南</h2><h3 id=\"基于-lcp-的渲染策略选择\">基于 LCP 的渲染策略选择</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 决策框架：根据 LCP 目标反推渲染策略&#10;function chooseRenderingStrategy(page: PageProfile): RenderingStrategy {&#10;  const { lcpTarget, dynamicDataRatio, trafficVolume, seoRequired } = page;&#10;&#10;  // LCP &lt; 1.5s 且不需要个性化 → SSG&#10;  if (lcpTarget &lt; 1500 &amp;&amp; dynamicDataRatio &lt; 0.2 &amp;&amp; !page.needsPersonalization) {&#10;    return &#39;SSG&#39;;&#10;  }&#10;&#10;  // LCP &lt; 2.5s 且需要数据但 SEO 重要 → ISR or SSR + Streaming&#10;  if (lcpTarget &lt; 2500 &amp;&amp; seoRequired) {&#10;    return dynamicDataRatio &lt; 0.5 ? &#39;ISR&#39; : &#39;SSR_STREAMING&#39;;&#10;  }&#10;&#10;  // 纯交互不需要 SEO → CSR (但控制 bundle size)&#10;  if (!seoRequired &amp;&amp; dynamicDataRatio &gt; 0.8) {&#10;    return &#39;CSR_WITH_CODE_SPLITTING&#39;;&#10;  }&#10;&#10;  // 内容为主 + 少量交互 → Islands&#10;  if (dynamicDataRatio &lt; 0.3 &amp;&amp; page.interactiveComponentRatio &lt; 0.2) {&#10;    return &#39;ISLANDS&#39;;&#10;  }&#10;&#10;  return &#39;SSR_STREAMING&#39;; // 默认安全选择&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 决策框架：根据 LCP 目标反推渲染策略</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> chooseRenderingStrategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PageProfile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RenderingStrategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">lcpTarget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dynamicDataRatio</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">trafficVolume</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">seoRequired</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-