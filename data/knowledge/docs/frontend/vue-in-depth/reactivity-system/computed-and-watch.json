an><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    signal: controller.signal,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  userData.value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 手动停止监听</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><h3 id=\"watch-vs-watcheffect\">watch vs watchEffect</h3><table>\n<thead>\n<tr>\n<th>对比</th>\n<th>watch</th>\n<th>watchEffect</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数据源</td>\n<td>显式指定</td>\n<td>自动追踪</td>\n</tr>\n<tr>\n<td>初始执行</td>\n<td>默认不执行</td>\n<td>立即执行</td>\n</tr>\n<tr>\n<td>旧值访问</td>\n<td>✅ 可获取 oldValue</td>\n<td>❌ 无法获取</td>\n</tr>\n<tr>\n<td>精确控制</td>\n<td>✅ 精确监听特定数据</td>\n<td>❌ 追踪所有访问的数据</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>需要对比新旧值</td>\n<td>需要立即执行的副作用</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"清理副作用\">清理副作用</h2><p>当被监听的数据快速变化时（如搜索输入），前一次异步操作可能尚未完成。使用 <code>onCleanup</code> 可以取消过期的操作：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { ref, watch } from &#39;vue&#39;;&#10;&#10;const keyword = ref&lt;string&gt;(&#39;&#39;);&#10;&#10;watch(keyword, (newVal, _oldVal, onCleanup) =&gt; {&#10;  const controller = new AbortController();&#10;  onCleanup(() =&gt; controller.abort());&#10;&#10;  fetch(`/api/search?q=${newVal}`, { signal: controller.signal })&#10;    .then((res) =&gt; res.json())&#10;    .then((data) =&gt; {&#10;      results.value = data;&#10;    })&#10;    .catch((err) =&gt; {&#10;      if (err.name !== &#39;AbortError&#39;) throw err;&#10;    });&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ref, watch } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vue'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> keyword</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ref</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">watch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(keyword, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">newVal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_oldVal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">onCleanup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> controller</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AbortController</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  onCleanup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> controller.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`/api/search?q=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">newVal</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { signal: controller.signal })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">res</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> res.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      results.value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">err</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (err.name </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'AbortError'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant U as 用户输入&#10;    participant W as watch 回调&#10;    participant API as 后端 API&#10;&#10;    U-&gt;&gt;W: 输入 &quot;v&quot;&#10;    W-&gt;&gt;API: 请求 /search?q=v&#10;    U-&gt;&gt;W: 输入 &quot;vu&quot;(触发 cleanup)&#10;    W--&gt;&gt;API: 取消 /search?q=v&#10;    W-&gt;&gt;API: 请求 /search?q=vu&#10;    API--&gt;&gt;W: 返回结果\">sequenceDiagram\n    participant U as 用户输入\n    participant W as watch 回调\n    participant API as 后端 API\n\n    U-&gt;&gt;W: 输入 \"v\"\n    W-&gt;&gt;API: 请求 /search?q=v\n    U-&gt;&gt;W: 输入 \"vu\"(触发 cleanup)\n    W--&gt;&gt;API: 取消 /search?q=v\n    W-&gt;&gt;API: 请求 /search?q=vu\n    API--&gt;&gt;W: 返回结果</pre><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><code>computed</code> 用于派生状态，具有<strong>惰性求值</strong>和<strong>缓存</strong>特性，依赖不变时不重新计算</li>\n<li>可写 <code>computed</code> 通过提供 <code>get</code>/<code>set</code> 实现双向绑定场景</li>\n<li><code>watch</code> 显式监听指定数据源，支持 <code>immediate</code>、<code>deep</code>、<code>flush</code> 等选项精确控制行为</li>\n<li><code>watchEffect</code> 自动追踪依赖并立即执行，适合不需要新旧值对比的副作用场景</li>\n<li><code>onCleanup</code> 用于取消过期的异步操作，防止竞态条件</li>\n<li><code>flush</code> 选项控制回调执行时机：<code>sync</code>（同步）、<code>pre</code>（DOM 更新前）、<code>post</code>（DOM 更新后）</li>\n</ul>\n","headings":[{"level":1,"text":"computed 与 watch","id":"computed-与-watch"},{"level":2,"text":"派生状态与副作用","id":"派生状态与副作用"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"computed 详解","id":"computed-详解"},{"level":3,"text":"基本用法","id":"基本用法"},{"level":3,"text":"可写 computed","id":"可写-computed"},{"level":3,"text":"惰性求值与缓存机制","id":"惰性求值与缓存机制"},{"level":2,"text":"watch 详解","id":"watch-详解"},{"level":3,"text":"基本用法","id":"基本用法"},{"level":3,"text":"监听多个源","id":"监听多个源"},{"level":3,"text":"watch 选项","id":"watch-选项"},{"level":3,"text":"flush 时机","id":"flush-时机"},{"level":2,"text":"watchEffect","id":"watcheffect"},{"level":3,"text":"watch vs watchEffect","id":"watch-vs-watcheffect"},{"level":2,"text":"清理副作用","id":"清理副作用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ref 与 reactive","url":"/l-doc-books/h/frontend/vue-in-depth/reactivity-system/ref-and-reactive"},"next":{"title":"响应式陷阱","url":"/l-doc-books/h/frontend/vue-in-depth/reactivity-system/reactivity-pitfalls"}}