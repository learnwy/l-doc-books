0\">removeItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'auth-token'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sessionStorage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">clear</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { token, logout };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>浏览器提供 <code>localStorage</code>、<code>sessionStorage</code>、<code>IndexedDB</code>、<code>Cookie</code> 四种存储方式，各有适用场景</li>\n<li><code>pinia-plugin-persistedstate</code> 提供声明式持久化，支持多存储后端、字段筛选和自定义序列化</li>\n<li>SSR 场景下的 <strong>Hydration</strong> 将服务端状态传递到客户端，Nuxt 自动处理</li>\n<li>非 Nuxt SSR 应用需手动序列化 <code>pinia.state.value</code> 并在客户端恢复</li>\n<li>最佳实践包括选择性持久化、敏感数据加密和存储版本管理</li>\n</ul>\n","headings":[{"level":1,"text":"状态持久化","id":"状态持久化"},{"level":2,"text":"为什么需要持久化","id":"为什么需要持久化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"存储方式对比","id":"存储方式对比"},{"level":2,"text":"手动实现持久化","id":"手动实现持久化"},{"level":3,"text":"基础方案","id":"基础方案"},{"level":2,"text":"pinia-plugin-persistedstate","id":"pinia-plugin-persistedstate"},{"level":3,"text":"安装和配置","id":"安装和配置"},{"level":3,"text":"基本使用","id":"基本使用"},{"level":3,"text":"高级配置","id":"高级配置"},{"level":3,"text":"自定义序列化","id":"自定义序列化"},{"level":2,"text":"Hydration（状态注水）","id":"hydration-状态注水"},{"level":3,"text":"Nuxt 中的自动 Hydration","id":"nuxt-中的自动-hydration"},{"level":2,"text":"SSR 状态传递","id":"ssr-状态传递"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,