xt":"核心区别","id":"核心区别"},{"level":2,"text":"Composable 适用场景","id":"composable-适用场景"},{"level":3,"text":"可复用的 UI 逻辑","id":"可复用的-ui-逻辑"},{"level":3,"text":"封装浏览器 API","id":"封装浏览器-api"},{"level":2,"text":"Store 适用场景","id":"store-适用场景"},{"level":3,"text":"全局业务状态","id":"全局业务状态"},{"level":2,"text":"混合使用模式","id":"混合使用模式"},{"level":2,"text":"SSR 考量","id":"ssr-考量"},{"level":2,"text":"决策指南","id":"决策指南"},{"level":2,"text":"测试差异","id":"测试差异"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Pinia 进阶模式","url":"/l-doc-books/h/frontend/vue-in-depth/state-management/pinia-advanced-patterns"},"next":{"title":"状态持久化","url":"/l-doc-books/h/frontend/vue-in-depth/state-management/state-persistence"}}