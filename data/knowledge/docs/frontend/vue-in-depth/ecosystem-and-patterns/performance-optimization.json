e\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      brotliSize: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      filename: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dist/stats.html'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"优化清单\">优化清单</h3><table>\n<thead>\n<tr>\n<th>优化项</th>\n<th>方法</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Tree Shaking</td>\n<td>使用 ESM 导入</td>\n<td>移除未使用代码</td>\n</tr>\n<tr>\n<td>代码分割</td>\n<td>路由懒加载、<code>defineAsyncComponent</code></td>\n<td>减小首屏包</td>\n</tr>\n<tr>\n<td>压缩</td>\n<td>Gzip / Brotli</td>\n<td>减小 60-80% 体积</td>\n</tr>\n<tr>\n<td>图片优化</td>\n<td>WebP、懒加载、<code>&lt;NuxtImage&gt;</code></td>\n<td>减少图片请求</td>\n</tr>\n<tr>\n<td>CDN 外部化</td>\n<td><code>build.rollupOptions.external</code></td>\n<td>利用 CDN 缓存</td>\n</tr>\n<tr>\n<td>CSS 精简</td>\n<td>PurgeCSS / Tailwind JIT</td>\n<td>移除未使用 CSS</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"运行时优化技巧\">运行时优化技巧</h2><div class=\"code-block-wrapper\" data-lang=\"vue\" data-code=\"&lt;script setup lang=&quot;ts&quot;&gt;&#10;import { computed, shallowRef } from &#39;vue&#39;;&#10;&#10;const items = shallowRef&lt;Item[]&gt;([]);&#10;&#10;const expensiveComputed = computed(() =&gt; {&#10;  return items.value&#10;    .filter((item) =&gt; item.active)&#10;    .sort((a, b) =&gt; b.score - a.score)&#10;    .slice(0, 100);&#10;});&#10;&lt;/script&gt;&#10;&#10;&lt;template&gt;&#10;  &lt;!-- ✅ 使用 key 帮助 Vue 追踪列表变化 --&gt;&#10;  &lt;TransitionGroup name=&quot;list&quot;&gt;&#10;    &lt;div v-for=&quot;item in expensiveComputed&quot; :key=&quot;item.id&quot;&gt;&#10;      {{ item.name }}&#10;    &lt;/div&gt;&#10;  &lt;/TransitionGroup&gt;&#10;&#10;  &lt;!-- ✅ 大型静态内容使用 v-once --&gt;&#10;  &lt;footer v-once&gt;&#10;    &lt;p&gt;版权所有 © 2026 公司名称&lt;/p&gt;&#10;  &lt;/footer&gt;&#10;&lt;/template&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>&#x3C;script setup lang=\"ts\"></span></span>\n<span class=\"line\"><span>import { computed, shallowRef } from 'vue';</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>const items = shallowRef&#x3C;Item[]>([]);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>const expensiveComputed = computed(() => {</span></span>\n<span class=\"line\"><span>  return items.value</span></span>\n<span class=\"line\"><span>    .filter((item) => item.active)</span></span>\n<span class=\"line\"><span>    .sort((a, b) => b.score - a.score)</span></span>\n<span class=\"line\"><span>    .slice(0, 100);</span></span>\n<span class=\"line\"><span>});</span></span>\n<span class=\"line\"><span>&#x3C;/script></span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>&#x3C;template></span></span>\n<span class=\"line\"><span>  &#x3C;!-- ✅ 使用 key 帮助 Vue 追踪列表变化 --></span></span>\n<span class=\"line\"><span>  &#x3C;TransitionGroup name=\"list\"></span></span>\n<span class=\"line\"><span>    &#x3C;div v-for=\"item in expensiveComputed\" :key=\"item.id\"></span></span>\n<span class=\"line\"><span>      {{ item.name }}</span></span>\n<span class=\"line\"><span>    &#x3C;/div></span></span>\n<span class=\"line\"><span>  &#x3C;/TransitionGroup></span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>  &#x3C;!-- ✅ 大型静态内容使用 v-once --></span></span>\n<span class=\"line\"><span>  &#x3C;footer v-once></span></span>\n<span class=\"line\"><span>    &#x3C;p>版权所有 © 2026 公司名称&#x3C;/p></span></span>\n<span class=\"line\"><span>  &#x3C;/footer></span></span>\n<span class=\"line\"><span>&#x3C;/template></span></span></code></pre></div><hr>\n<h2 id=\"性能指标监控\">性能指标监控</h2><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// plugins/performance.ts&#10;import { createApp } from &#39;vue&#39;;&#10;&#10;const app = createApp(App);&#10;&#10;app.config.performance = import.meta.env.DEV;&#10;&#10;if (import.meta.env.DEV) {&#10;  app.config.warnHandler = (msg, instance, trace) =&gt; {&#10;    console.warn(`[Vue warn]: ${msg}`, trace);&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// plugins/performance.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { createApp } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vue'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> app</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createApp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(App);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">app.config.performance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DEV</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.env.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DEV</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  app.config.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">warnHandler</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">msg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">instance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">trace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">warn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`[Vue warn]: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">msg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, trace);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>指标</th>\n<th>说明</th>\n<th>优化目标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>FCP</td>\n<td>首次内容绘制</td>\n<td>&lt; 1.8s</td>\n</tr>\n<tr>\n<td>LCP</td>\n<td>最大内容绘制</td>\n<td>&lt; 2.5s</td>\n</tr>\n<tr>\n<td>TTI</td>\n<td>可交互时间</td>\n<td>&lt; 3.8s</td>\n</tr>\n<tr>\n<td>CLS</td>\n<td>累积布局偏移</td>\n<td>&lt; 0.1</td>\n</tr>\n<tr>\n<td>FID</td>\n<td>首次输入延迟</td>\n<td>&lt; 100ms</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>虚拟滚动</strong>只渲染可视区域元素，处理超长列表的关键优化</li>\n<li><code>v-memo</code> 根据依赖数组跳过子树更新，适合大型列表中的条件渲染</li>\n<li><code>shallowRef</code> / <code>shallowReactive</code> 避免深层代理，适合大型不常变化的数据</li>\n<li><strong>Lazy Hydration</strong> 延迟非关键组件的激活，加速 SSR 应用的 TTI</li>\n<li>使用 <code>rollup-plugin-visualizer</code> 分析包体积，识别优化机会</li>\n<li>结合路由懒加载、Tree Shaking、压缩和 CDN 多管齐下优化加载性能</li>\n</ul>\n","headings":[{"level":1,"text":"性能优化","id":"性能优化"},{"level":2,"text":"Vue 应用性能全景","id":"vue-应用性能全景"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"虚拟滚动","id":"虚拟滚动"},{"level":2,"text":"v-memo","id":"v-memo"},{"level":2,"text":"shallowRef 与 shallowReactive","id":"shallowref-与-shallowreactive"},{"level":2,"text":"Lazy Hydration","id":"lazy-hydration"},{"level":2,"text":"包体积分析","id":"包体积分析"},{"level":3,"text":"rollup-plugin-visualizer","id":"rollup-plugin-visualizer"},{"level":3,"text":"优化清单","id":"优化清单"},{"level":2,"text":"运行时优化技巧","id":"运行时优化技巧"},{"level":2,"text":"性能指标监控","id":"性能指标监控"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Vue 2 到 Vue 3 迁移","url":"/l-doc-books/h/frontend/vue-in-depth/ecosystem-and-patterns/vue2-to-vue3-migration"},"next":null}