2F62;--shiki-dark:#9ECBFF\">  'onUpdate:modelValue'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    value.value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"jsx-in-vue\">JSX in Vue</h2><p>Vue 支持使用 JSX 语法编写渲染逻辑，需要安装 <code>@vitejs/plugin-vue-jsx</code>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"tsx\" data-code=\"import { defineComponent, ref } from &#39;vue&#39;;&#10;&#10;interface TabItem {&#10;  key: string;&#10;  label: string;&#10;  content: () =&gt; JSX.Element;&#10;}&#10;&#10;export default defineComponent({&#10;  setup() {&#10;    const activeTab = ref&lt;string&gt;(&#39;home&#39;);&#10;    const tabs: TabItem[] = [&#10;      { key: &#39;home&#39;, label: &#39;首页&#39;, content: () =&gt; &lt;p&gt;欢迎回来&lt;/p&gt; },&#10;      { key: &#39;profile&#39;, label: &#39;个人&#39;, content: () =&gt; &lt;p&gt;个人信息&lt;/p&gt; },&#10;      { key: &#39;settings&#39;, label: &#39;设置&#39;, content: () =&gt; &lt;p&gt;系统设置&lt;/p&gt; },&#10;    ];&#10;&#10;    return () =&gt; (&#10;      &lt;div class=&quot;tabs&quot;&gt;&#10;        &lt;nav&gt;&#10;          {tabs.map((tab) =&gt; (&#10;            &lt;button&#10;              key={tab.key}&#10;              class={{ active: activeTab.value === tab.key }}&#10;              onClick={() =&gt; {&#10;                activeTab.value = tab.key;&#10;              }}&#10;            &gt;&#10;              {tab.label}&#10;            &lt;/button&gt;&#10;          ))}&#10;        &lt;/nav&gt;&#10;        &lt;div class=&quot;tab-content&quot;&gt;{tabs.find((t) =&gt; t.key === activeTab.value)?.content()}&lt;/div&gt;&#10;      &lt;/div&gt;&#10;    );&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>import { defineComponent, ref } from 'vue';</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>interface TabItem {</span></span>\n<span class=\"line\"><span>  key: string;</span></span>\n<span class=\"line\"><span>  label: string;</span></span>\n<span class=\"line\"><span>  content: () => JSX.Element;</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>export default defineComponent({</span></span>\n<span class=\"line\"><span>  setup() {</span></span>\n<span class=\"line\"><span>    const activeTab = ref&#x3C;string>('home');</span></span>\n<span class=\"line\"><span>    const tabs: TabItem[] = [</span></span>\n<span class=\"line\"><span>      { key: 'home', label: '首页', content: () => &#x3C;p>欢迎回来&#x3C;/p> },</span></span>\n<span class=\"line\"><span>      { key: 'profile', label: '个人', content: () => &#x3C;p>个人信息&#x3C;/p> },</span></span>\n<span class=\"line\"><span>      { key: 'settings', label: '设置', content: () => &#x3C;p>系统设置&#x3C;/p> },</span></span>\n<span class=\"line\"><span>    ];</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    return () => (</span></span>\n<span class=\"line\"><span>      &#x3C;div class=\"tabs\"></span></span>\n<span class=\"line\"><span>        &#x3C;nav></span></span>\n<span class=\"line\"><span>          {tabs.map((tab) => (</span></span>\n<span class=\"line\"><span>            &#x3C;button</span></span>\n<span class=\"line\"><span>              key={tab.key}</span></span>\n<span class=\"line\"><span>              class={{ active: activeTab.value === tab.key }}</span></span>\n<span class=\"line\"><span>              onClick={() => {</span></span>\n<span class=\"line\"><span>                activeTab.value = tab.key;</span></span>\n<span class=\"line\"><span>              }}</span></span>\n<span class=\"line\"><span>            ></span></span>\n<span class=\"line\"><span>              {tab.label}</span></span>\n<span class=\"line\"><span>            &#x3C;/button></span></span>\n<span class=\"line\"><span>          ))}</span></span>\n<span class=\"line\"><span>        &#x3C;/nav></span></span>\n<span class=\"line\"><span>        &#x3C;div class=\"tab-content\">{tabs.find((t) => t.key === activeTab.value)?.content()}&#x3C;/div></span></span>\n<span class=\"line\"><span>      &#x3C;/div></span></span>\n<span class=\"line\"><span>    );</span></span>\n<span class=\"line\"><span>  },</span></span>\n<span class=\"line\"><span>});</span></span></code></pre></div><hr>\n<h2 id=\"函数式组件\">函数式组件</h2><p>无状态的函数式组件可以直接定义为一个函数：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import type { FunctionalComponent } from &#39;vue&#39;&#10;&#10;interface BadgeProps {&#10;  type: &#39;success&#39; | &#39;warning&#39; | &#39;error&#39;&#10;  text: string&#10;}&#10;&#10;const Badge: FunctionalComponent&lt;BadgeProps&gt; = (props, { slots }) =&gt; {&#10;  return (&#10;    &lt;span class={`badge badge--${props.type}`}&gt;&#10;      {slots.default?.() ?? props.text}&#10;    &lt;/span&gt;&#10;  )&#10;}&#10;&#10;Badge.props = {&#10;  type: { type: String, required: true },&#10;  text: { type: String, default: &#39;&#39; }&#10;}&#10;&#10;export default Badge\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { FunctionalComponent } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vue'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BadgeProps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'success'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'warning'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'error'</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Badge</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FunctionalComponent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">BadgeProps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D