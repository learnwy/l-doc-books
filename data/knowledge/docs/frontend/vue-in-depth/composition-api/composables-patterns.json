;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">countA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useCounter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">countB</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useCounter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// countA 和 countB 互不影响</span></span></code></pre></div><h3 id=\"全局共享状态\">全局共享状态</h3><p>将状态提升到模块作用域实现跨组件共享：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { ref, readonly } from &#39;vue&#39;;&#10;&#10;const globalCount = ref&lt;number&gt;(0);&#10;&#10;export function useSharedCounter() {&#10;  function increment() {&#10;    globalCount.value++;&#10;  }&#10;  function decrement() {&#10;    globalCount.value--;&#10;  }&#10;&#10;  return {&#10;    count: readonly(globalCount),&#10;    increment,&#10;    decrement,&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ref, readonly } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'vue'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> globalCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ref</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useSharedCounter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> increment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    globalCount.value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> decrement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    globalCount.value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">--</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    count: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">readonly</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(globalCount),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    increment,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    decrement,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph Module[&quot;模块作用域&quot;]&#10;        GS[&quot;globalCount (共享状态)&quot;]&#10;    end&#10;    subgraph Comp1[&quot;组件 A&quot;]&#10;        A1[&quot;useSharedCounter()&quot;] --&gt; GS&#10;    end&#10;    subgraph Comp2[&quot;组件 B&quot;]&#10;        B1[&quot;useSharedCounter()&quot;] --&gt; GS&#10;    end\">flowchart TD\n    subgraph Module[\"模块作用域\"]\n        GS[\"globalCount (共享状态)\"]\n    end\n    subgraph Comp1[\"组件 A\"]\n        A1[\"useSharedCounter()\"] --&gt; GS\n    end\n    subgraph Comp2[\"组件 B\"]\n        B1[\"useSharedCounter()\"] --&gt; GS\n    end</pre><hr>\n<h2 id=\"vueuse-生态\">VueUse 生态</h2><p><a href=\"https://vueuse.org\">VueUse</a> 是最流行的 Vue Composition 工具库，提供了 200+ 个即用型 composable：</p>\n<table>\n<thead>\n<tr>\n<th>分类</th>\n<th>常用 Composable</th>\n<th>功能</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>浏览器</td>\n<td><code>useLocalStorage</code>、<code>useClipboard</code></td>\n<td>本地存储、剪贴板</td>\n</tr>\n<tr>\n<td>传感器</td>\n<td><code>useMouse</code>、<code>useScroll</code></td>\n<td>鼠标、滚动位置</td>\n</tr>\n<tr>\n<td>动画</td>\n<td><code>useTransition</code>、<code>useInterval</code></td>\n<td>缓动、定时器</td>\n</tr>\n<tr>\n<td>网络</td>\n<td><code>useFetch</code>、<code>useWebSocket</code></td>\n<td>HTTP 请求、WebSocket</td>\n</tr>\n<tr>\n<td>状态</td>\n<td><code>useToggle</code>、<code>useCounter</code></td>\n<td>常用状态管理</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { useLocalStorage, useDark, useToggle } from &#39;@vueuse/core&#39;;&#10;&#10;const isDark = useDark();&#10;const toggleDark = useToggle(isDark);&#10;&#10;const settings = useLocalStorage(&#39;app-settings&#39;, {&#10;  theme: &#39;auto&#39;,&#10;  lang: &#39;zh-CN&#39;,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { useLocalStorage, useDark, useToggle } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@vueuse/core'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> isDark</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useDark</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> toggleDark</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useToggle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(isDark);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> settings</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useLocalStorage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'app-settings'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  theme: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'auto'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  lang: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'zh-CN'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Composable 是以 <code>use</code> 为前缀、封装有状态逻辑的函数，是 Vue 3 代码复用的核心模式</li>\n<li>使用 <code>MaybeRef</code> 类型接受灵活的参数，支持响应式和普通值</li>\n<li>返回对象中使用 <code>ref</code> 保持解构后的响应性</li>\n<li>模块作用域状态实现全局共享，<code>readonly</code> 保护外部只读访问</li>\n<li>VueUse 生态提供了丰富的即用型 composable，避免重复造轮子</li>\n</ul>\n","headings":[{"level":1,"text":"Composables 模式","id":"composables-模式"},{"level":2,"text":"什么是 Composable","id":"什么是-composable"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"提取 Composable","id":"提取-composable"},{"level":3,"text":"从组件中提取","id":"从组件中提取"},{"level":2,"text":"命名约定","id":"命名约定"},{"level":2,"text":"返回值模式","id":"返回值模式"},{"level":3,"text":"返回对象（推荐）","id":"返回对象-推荐"},{"level":3,"text":"接受响应式参数","id":"接受响应式参数"},{"level":2,"text":"状态共享","id":"状态共享"},{"level":3,"text":"局部状态（默认）","id":"局部状态-默认"},{"level":3,"text":"全局共享状态","id":"全局共享状态"},{"level":2,"text":"VueUse 生态","id":"vueuse-生态"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"setup 与生命周期","url":"/l-doc-books/h/frontend/vue-in-depth/composition-api/setup-and-lifecycle"},"next":{"title":"provide/inject 依赖注入","url":"/l-doc-books/h/frontend/vue-in-depth/composition-api/provide-inject"}}