shiki-dark:#79B8FF\">222.2</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 84</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4.9</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --foreground</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">210</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 40</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 98</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --card</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">222.2</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 84</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4.9</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --card-foreground</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">210</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 40</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 98</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --primary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">210</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 40</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 98</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --primary-foreground</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">222.2</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 47.4</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 11.2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --muted</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">217.2</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 32.6</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 17.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --muted-foreground</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">215</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 20.2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 65.1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>组件代码完全不感知主题：</p>\n<div class=\"code-block-wrapper\" data-lang=\"tsx\" data-code=\"// 组件只引用语义 token，不关心 light/dark&#10;function Card({ children, title }) {&#10;  return (&#10;    &lt;div className=&quot;bg-card text-card-foreground rounded-lg border p-6&quot;&gt;&#10;      &lt;h3 className=&quot;text-lg font-semibold&quot;&gt;{title}&lt;/h3&gt;&#10;      &lt;p className=&quot;text-muted-foreground mt-2&quot;&gt;{children}&lt;/p&gt;&#10;    &lt;/div&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// 组件只引用语义 token，不关心 light/dark</span></span>\n<span class=\"line\"><span>function Card({ children, title }) {</span></span>\n<span class=\"line\"><span>  return (</span></span>\n<span class=\"line\"><span>    &#x3C;div className=\"bg-card text-card-foreground rounded-lg border p-6\"></span></span>\n<span class=\"line\"><span>      &#x3C;h3 className=\"text-lg font-semibold\">{title}&#x3C;/h3></span></span>\n<span class=\"line\"><span>      &#x3C;p className=\"text-muted-foreground mt-2\">{children}&#x3C;/p></span></span>\n<span class=\"line\"><span>    &#x3C;/div></span></span>\n<span class=\"line\"><span>  );</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"主题切换的三种时机\">主题切换的三种时机</h2><table>\n<thead>\n<tr>\n<th>时机</th>\n<th>实现方式</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>系统跟随</td>\n<td><code>prefers-color-scheme</code> 媒体查询</td>\n<td>默认行为</td>\n</tr>\n<tr>\n<td>用户手动</td>\n<td>JavaScript 切换 class/data-attribute</td>\n<td>设置面板</td>\n</tr>\n<tr>\n<td>混合（推荐）</td>\n<td>系统默认 + 用户覆盖 + localStorage 持久化</td>\n<td>通用方案</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// next-themes 的实现模式（2026 行业标准）&#10;type ThemeMode = &#39;light&#39; | &#39;dark&#39; | &#39;system&#39;;&#10;&#10;function resolveTheme(preference: ThemeMode): &#39;light&#39; | &#39;dark&#39; {&#10;  if (preference === &#39;system&#39;) {&#10;    return window.matchMedia(&#39;(prefers-color-scheme: dark)&#39;).matches ? &#39;dark&#39; : &#39;light&#39;;&#10;  }&#10;  return preference;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// next-themes 的实现模式（2026 行业标准）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ThemeMode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'light'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'dark'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'system'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> resolveTheme</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">preference</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ThemeMode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'light'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'dark'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (preference </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'system'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> window.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">matchMedia</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'(prefers-color-scheme: dark)'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).matches </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'dark'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'light'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> preference;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"多品牌的-token-覆盖\">多品牌的 Token 覆盖</h2><p>当同一设计系统服务多个品牌时，通过 CSS 变量的级联覆盖实现品牌切换：</p>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\"/* 默认品牌 */&#10;:root {&#10;  --brand-primary: oklch(0.65 0.25 264);&#10;  --brand-secondary: oklch(0.7 0.15 180);&#10;  --brand-radius: 0.375rem;&#10;}&#10;&#10;/* 品牌 B 覆盖 */&#10;[data-brand=&#39;saas-pro&#39;] {&#10;  --brand-primary: oklch(0.55 0.22 145);&#10;  --brand-secondary: oklch(0.6 0.18 90);&#10;  --brand-radius: 0.75rem;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 默认品牌 */</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">:root</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --brand-primary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">oklch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.65</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.25</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 264</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --brand-secondary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">oklch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.7</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.15</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 180</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --brand-radius</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.375</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">rem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 品牌 B 覆盖 */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">data-brand</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'saas-pro'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --brand-primary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">oklch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.55</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.22</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 145</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --brand-secondary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">oklch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.6</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.18</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 90</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --brand-radius</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.75</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">rem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>构建管线中可以为每个品牌生成独立的 token CSS 文件，运行时按需加载：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    T[tokens.json] --&gt; SD[Style Dictionary]&#10;    SD --&gt; A[brand-a.css]&#10;    SD --&gt; B[brand-b.css]&#10;    SD --&gt; C[brand-c.css]&#10;    A --&gt; RT[运行时按需加载]&#10;    B --&gt; RT&#10;    C --&gt; RT\">graph LR\n    T[tokens.json] --&gt; SD[Style Dictionary]\n    SD --&gt; A[brand-a.css]\n    SD --&gt; B[brand-b.css]\n    SD --&gt; C[brand-c.css]\n    A --&gt; RT[运行时按需加载]\n    B --&gt; RT\n    C --&gt; RT</pre><h2 id=\"cva-高级模式-复合变体\">CVA 高级模式：复合变体</h2><p>当变体组合之间有交叉影响时（如 <code>variant=&quot;outline&quot;</code> + <code>size=&quot;sm&quot;</code> 需要特殊样式），CVA 提供 <code>compoundVariants</code>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const alertVariants = cva(&#39;rounded-lg border p-4&#39;, {&#10;  variants: {&#10;    variant: {&#10;      default: &#39;bg-background text-foreground&#39;,&#10;      destructive: &#39;border-destructive/50 text-destructive&#39;,&#10;      success: &#39;border-green-500/50 text-green-700&#39;,&#10;    },&#10;    size: {&#10;      sm: &#39;p-3 text-sm&#39;,&#10;      default: &#39;p-4&#39;,&#10;      lg: &#39;p-6 text-lg&#39;,&#10;    },&#10;  },&#10;  compoundVariants: [&#10;    {&#10;      variant: &#39;destructive&#39;,&#10;      size: &#39;lg&#39;,&#10;      className: &#39;border-2 font-semibold&#39;, // 大号 destructive 额外加粗边框&#10;    },&#10;  ],&#10;  defaultVariants: { variant: &#39;default&#39;, size: &#39;default&#39; },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> alertVariants</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cva</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'rounded-lg border p-4'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  variants: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    variant: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      default: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'bg-background text-foreground'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      destructive: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'border-destructive/50 text-destructive'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      success: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'border-green-500/50 text-green-700'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    size: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      sm: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'p-3 text-sm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      default: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'p-4'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      lg: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'p-6 text-lg'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  compoundVariants: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      variant: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'destructive'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      size: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'lg'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      className: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'border-2 font-semibold'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 大号 destructive 额外加粗边框</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  defaultVariants: { variant: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'default'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, size: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'default'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>复合变体让 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>N</mi><mo>×</mo><mi>M</mi></mrow><annotation encoding=\"application/x-tex\">N \\times M</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7667em;vertical-align:-0.0833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">N</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.109em;\">M</span></span></span></span></span> 的变体矩阵在特定交叉点拥有专属样式，避免了为每种组合创建独立 class 的爆炸。</p>\n<h2 id=\"高对比度与强制颜色模式\">高对比度与强制颜色模式</h2><p>Windows 高对比度模式（<code>forced-colors: active</code>）会忽略所有自定义颜色，使用系统调色板。设计系统需要确保在此模式下组件仍然可用：</p>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\"@media (forced-colors: active) {&#10;  .button {&#10;    border: 1px solid ButtonText;&#10;    /* 强制颜色模式下，使用系统关键字 */&#10;  }&#10;  .button:focus-visible {&#10;    outline: 2px solid Highlight;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@media</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (forced-colors: active) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  .button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    border</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> solid</span><span style=\"color:#B31D28;--shiki-light-font-style:italic;--shiki-dark:#FDAEB7;--shiki-dark-font-style:italic\"> ButtonText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* 强制颜色模式下，使用系统关键字 */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  .button:focus-visible</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    outline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> solid</span><span style=\"color:#B31D28;--shiki-light-font-style:italic;--shiki-dark:#FDAEB7;--shiki-dark-font-style:italic\"> Highlight</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>系统颜色关键字</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>Canvas</code></td>\n<td>背景色</td>\n</tr>\n<tr>\n<td><code>CanvasText</code></td>\n<td>文本色</td>\n</tr>\n<tr>\n<td><code>LinkText</code></td>\n<td>链接色</td>\n</tr>\n<tr>\n<td><code>ButtonText</code></td>\n<td>按钮文本</td>\n</tr>\n<tr>\n<td><code>Highlight</code></td>\n<td>选中/聚焦高亮</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>变体工程管理全局主题、品牌、组件变体、交互状态四个正交维度</li>\n<li>CSS 变量级联是零开销主题切换的核心机制</li>\n<li>组件代码只引用语义 token，不直接处理 light/dark 逻辑</li>\n<li>多品牌通过 token 文件隔离 + 运行时按需加载实现</li>\n<li>高对比度模式需要 <code>forced-colors</code> 媒体查询兜底</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"token-component-integration\">Token 与组件的集成策略</a> — 变体系统的 token 基础</li>\n<li><a href=\"../../frontend-design-tokens-systems/structure/theming-modes\">主题模式与暗色方案</a> — Token 层的多主题架构</li>\n<li><a href=\"component-api-design\">组件 API 设计与组合模式</a> — 变体如何通过 API 暴露给消费方</li>\n</ul>\n","headings":[{"level":1,"text":"变体与主题工程","id":"变体与主题工程"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"暗色模式的工程实现","id":"暗色模式的工程实现"},{"level":2,"text":"主题切换的三种时机","id":"主题切换的三种时机"},{"level":2,"text":"多品牌的 Token 覆盖","id":"多品牌的-token-覆盖"},{"level":2,"text":"CVA 高级模式：复合变体","id":"cva-高级模式-复合变体"},{"level":2,"text":"高对比度与强制颜色模式","id":"高对比度与强制颜色模式"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"组件 API 设计与组合模式","url":"/l-doc-books/h/frontend/design-systems/implementation/component-api-design"},"next":{"title":"代码分发与 Registry 模式","url":"/l-doc-books/h/frontend/design-systems/patterns/code-distribution-registry"}}