style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // ArrowDown 到下一个</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> component.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">press</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ArrowDown'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(component.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByRole</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'button'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'第二项'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeFocused</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"无障碍自动化测试\">无障碍自动化测试</h2><p>设计系统的每个组件都应通过 WCAG 2.2 AA 级检查。自动化无障碍测试可以捕捉约 30-50% 的无障碍问题：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { checkA11y } from &#39;@storybook/addon-a11y&#39;;&#10;&#10;// Storybook 全局配置：所有 Story 自动运行 axe-core&#10;export const parameters = {&#10;  a11y: {&#10;    config: {&#10;      rules: [&#10;        { id: &#39;color-contrast&#39;, enabled: true },&#10;        { id: &#39;label&#39;, enabled: true },&#10;        { id: &#39;aria-allowed-attr&#39;, enabled: true },&#10;      ],&#10;    },&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { checkA11y } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@storybook/addon-a11y'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Storybook 全局配置：所有 Story 自动运行 axe-core</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> parameters</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  a11y: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    config: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      rules: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'color-contrast'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, enabled: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'label'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, enabled: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'aria-allowed-attr'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, enabled: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>axe-core 规则类别</th>\n<th>检查内容</th>\n<th>典型问题</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>颜色对比度</td>\n<td>文本与背景的对比比</td>\n<td>浅灰文字在白底上</td>\n</tr>\n<tr>\n<td>标签关联</td>\n<td>表单控件的 label</td>\n<td>缺少 aria-label</td>\n</tr>\n<tr>\n<td>键盘可达</td>\n<td>可交互元素的 tabindex</td>\n<td>div 做按钮无 tabindex</td>\n</tr>\n<tr>\n<td>ARIA 有效性</td>\n<td>属性值是否合法</td>\n<td>role 拼写错误</td>\n</tr>\n<tr>\n<td>结构</td>\n<td>标题层级、landmark</td>\n<td>跳过 h2 直接用 h4</td>\n</tr>\n</tbody></table>\n<h2 id=\"测试策略-金字塔与成本效益\">测试策略：金字塔与成本效益</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph 推荐比例&#10;        direction TB&#10;        A[E2E: 5-10%]&#10;        B[交互测试: 20-30%]&#10;        C[视觉回归: 30-40%]&#10;        D[单元 + 无障碍: 40-50%]&#10;    end\">graph TD\n    subgraph 推荐比例\n        direction TB\n        A[E2E: 5-10%]\n        B[交互测试: 20-30%]\n        C[视觉回归: 30-40%]\n        D[单元 + 无障碍: 40-50%]\n    end</pre><p>设计系统测试的特殊性在于<strong>视觉回归测试的占比远高于业务应用</strong>。原因：组件的&quot;正确性&quot;主要体现在视觉表现上，而非业务逻辑上。</p>\n<p>投资优先级：</p>\n<ol>\n<li><strong>首先</strong>：所有组件启用 Autodocs + axe-core 无障碍检查（低成本高收益）</li>\n<li><strong>其次</strong>：核心交互组件（Dialog、Menu、Combobox）添加 play function</li>\n<li><strong>然后</strong>：全量 Story 接入 Chromatic/VRT（中成本高收益）</li>\n<li><strong>最后</strong>：复杂交互流（如多步表单）添加 Playwright E2E</li>\n</ol>\n<h2 id=\"小结\">小结</h2><ul>\n<li>设计系统测试需覆盖视觉、交互、无障碍三个维度</li>\n<li>视觉回归测试是设计系统独有的高价值测试类型</li>\n<li>Storybook play function 适合组件级交互验证</li>\n<li>axe-core 可自动检测 30-50% 的无障碍问题</li>\n<li>投资优先级：无障碍 → 交互测试 → 视觉回归 → E2E</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"storybook-documentation\">Storybook 组件文档化</a> — 测试与文档在 Storybook 中的统一</li>\n<li><a href=\"code-distribution-registry\">代码分发与 Registry 模式</a> — 分发后的质量保证</li>\n<li><a href=\"../../web-accessibility-implementation-testing/testing/ci-accessibility-pipeline\">CI 无障碍管线</a> — 无障碍测试在 CI 中的集成</li>\n</ul>\n","headings":[{"level":1,"text":"组件视觉与行为测试","id":"组件视觉与行为测试"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"视觉回归测试（Visual Regression Testing）","id":"视觉回归测试-visual-regression-testing"},{"level":2,"text":"交互测试：模拟真实用户行为","id":"交互测试-模拟真实用户行为"},{"level":2,"text":"无障碍自动化测试","id":"无障碍自动化测试"},{"level":2,"text":"测试策略：金字塔与成本效益","id":"测试策略-金字塔与成本效益"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"Storybook 组件文档化","url":"/l-doc-books/h/frontend/design-systems/patterns/storybook-documentation"},"next":{"title":"版本策略与发布流程","url":"/l-doc-books/h/frontend/design-systems/operations/versioning-release"}}