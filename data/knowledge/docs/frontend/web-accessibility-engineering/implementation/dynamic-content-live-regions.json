ark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    region.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setAttribute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'aria-busy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'false'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    region.textContent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `加载完成，共 ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">data</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} 条记录`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (err) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    region.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setAttribute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'aria-busy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'false'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    region.textContent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '加载失败，请重试'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>aria-busy=&quot;true&quot;</code> 告知 AT 该区域正在更新，暂时不要朗读其内容，更新完成后再朗读（类似&quot;请稍等&quot;的信号）。</p>\n<h2 id=\"单页应用的路由变化通知\">单页应用的路由变化通知</h2><p>SPA 路由跳转不触发页面重载，AT 用户不知道已导航到新页面：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// React 路由示例：在路由变化后朗读新页面标题&#10;function RouteAnnouncer() {&#10;  const location = useLocation();&#10;  const announcerRef = useRef(null);&#10;&#10;  useEffect(() =&gt; {&#10;    // 短暂延迟确保 DOM 已更新&#10;    const timer = setTimeout(() =&gt; {&#10;      const pageTitle = document.title || &#39;新页面&#39;;&#10;      if (announcerRef.current) {&#10;        announcerRef.current.textContent = &#39;&#39;;&#10;        announcerRef.current.textContent = `已导航到：${pageTitle}`;&#10;      }&#10;    }, 100);&#10;    return () =&gt; clearTimeout(timer);&#10;  }, [location]);&#10;&#10;  return &lt;div ref={announcerRef} aria-live=&quot;polite&quot; aria-atomic=&quot;true&quot; className=&quot;sr-only&quot; /&gt;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// React 路由示例：在路由变化后朗读新页面标题</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RouteAnnouncer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> location</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useLocation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> announcerRef</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useRef</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  useEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 短暂延迟确保 DOM 已更新</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> timer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> pageTitle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> document.title </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '新页面'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (announcerRef.current) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        announcerRef.current.textContent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        announcerRef.current.textContent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `已导航到：${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pageTitle</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> clearTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }, [location]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">div</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ref</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{announcerRef} </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">aria-live</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"polite\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> aria-atomic</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"true\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sr-only\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> />;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"避免过度使用-live-regions\">避免过度使用 Live Regions</h2><p>Live Regions 并非越多越好，滥用会导致 AT 用户被持续打断，体验极差：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    Q[需要通知 AT 用户?] --&gt; Q1{内容变化后需要用户立即知晓?}&#10;    Q1 -- 否 --&gt; NoLive[不需要 Live Region]&#10;    Q1 -- 是 --&gt; Q2{是否可以通过焦点移动传达?}&#10;    Q2 -- 是 --&gt; FocusMove[移动焦点更直观]&#10;    Q2 -- 否 --&gt; Q3{紧急程度?}&#10;    Q3 -- 高 --&gt; Assertive[aria-live assertive / role=alert]&#10;    Q3 -- 低 --&gt; Polite[aria-live polite / role=status]\">flowchart TD\n    Q[需要通知 AT 用户?] --&gt; Q1{内容变化后需要用户立即知晓?}\n    Q1 -- 否 --&gt; NoLive[不需要 Live Region]\n    Q1 -- 是 --&gt; Q2{是否可以通过焦点移动传达?}\n    Q2 -- 是 --&gt; FocusMove[移动焦点更直观]\n    Q2 -- 否 --&gt; Q3{紧急程度?}\n    Q3 -- 高 --&gt; Assertive[aria-live assertive / role=alert]\n    Q3 -- 低 --&gt; Polite[aria-live polite / role=status]</pre><h2 id=\"与相关章节的关系\">与相关章节的关系</h2><p><a href=\"keyboard-focus-management\">键盘与焦点管理</a>介绍了焦点移动作为通知手段的应用；第三章的自动化测试工具文档将介绍如何自动检测 Live Region 配置错误。</p>\n<h2 id=\"小结\">小结</h2><p>Live Regions 的核心使用原则：</p>\n<ul>\n<li>Live Region 容器必须在内容变化前就已存在于 DOM（AT 需要先&quot;订阅&quot;该区域）</li>\n<li>优先使用 <code>polite</code>（礼貌通知），仅紧急错误和重要警告使用 <code>assertive</code></li>\n<li>使用预定义角色（<code>role=&quot;alert&quot;</code> 对应 assertive，<code>role=&quot;status&quot;</code> 对应 polite）比手写 <code>aria-live</code> 更语义清晰</li>\n<li><code>aria-atomic=&quot;true&quot;</code> 确保上下文完整性，适合计数器和状态摘要等场景</li>\n<li>SPA 路由变化需要专门的路由播报组件，否则导航变化对 AT 用户不可感知</li>\n<li>避免 Live Region 泛滥，能用焦点移动传达的信息就不要另外加通知</li>\n</ul>\n","headings":[{"level":1,"text":"动态内容与 Live Regions：实时变化的无障碍通知","id":"动态内容与-live-regions-实时变化的无障碍通知"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Live Region 的基本机制","id":"live-region-的基本机制"},{"level":2,"text":"基本用法","id":"基本用法"},{"level":2,"text":"aria-live 的值与适用场景","id":"aria-live-的值与适用场景"},{"level":2,"text":"aria-atomic 与 aria-relevant","id":"aria-atomic-与-aria-relevant"},{"level":3,"text":"aria-atomic","id":"aria-atomic"},{"level":3,"text":"aria-relevant","id":"aria-relevant"},{"level":2,"text":"预定义 Live Region 角色","id":"预定义-live-region-角色"},{"level":2,"text":"表单验证的 Live Region 实践","id":"表单验证的-live-region-实践"},{"level":2,"text":"加载状态与进度通知","id":"加载状态与进度通知"},{"level":2,"text":"单页应用的路由变化通知","id":"单页应用的路由变化通知"},{"level":2,"text":"避免过度使用 Live Regions","id":"避免过度使用-live-regions"},{"level":2,"text":"与相关章节的关系","id":"与相关章节的关系"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"键盘与焦点管理：让界面对键盘完全可操作","url":"/l-doc-books/h/frontend/web-accessibility-engineering/implementation/keyboard-focus-management"},"next":{"title":"自动化无障碍测试工具：axe-core、Lighthouse 与浏览器扩展","url":"/l-doc-books/h/frontend/web-accessibility-engineering/testing/automated-testing-tools"}}