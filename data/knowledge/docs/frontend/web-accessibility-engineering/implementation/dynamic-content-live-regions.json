\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">&#x3C;!-- 加载状态 --></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">div</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"loading-region\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> aria-live</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"polite\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> aria-busy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"true\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>正在加载...&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">div</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"async function loadData() {&#10;  const region = document.getElementById(&#39;loading-region&#39;);&#10;  region.setAttribute(&#39;aria-busy&#39;, &#39;true&#39;);&#10;  region.textContent = &#39;正在加载数据...&#39;;&#10;&#10;  try {&#10;    const data = await fetchData();&#10;    region.setAttribute(&#39;aria-busy&#39;, &#39;false&#39;);&#10;    region.textContent = `加载完成，共 ${data.length} 条记录`;&#10;  } catch (err) {&#10;    region.setAttribute(&#39;aria-busy&#39;, &#39;false&#39;);&#10;    region.textContent = &#39;加载失败，请重试&#39;;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;