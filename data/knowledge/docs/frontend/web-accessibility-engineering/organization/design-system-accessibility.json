ldren: ReactNode;&#10;  // 内部自动处理：焦点陷阱、Esc 关闭、焦点归还&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ModalProps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  isOpen</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  onClose</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  title</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 必填，作为 dialog 的可访问名称</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  children</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReactNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 内部自动处理：焦点陷阱、Esc 关闭、焦点归还</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"设计-token-的无障碍影响\">设计 Token 的无障碍影响</h2><p>颜色设计 token 需要满足 WCAG 对比度要求：</p>\n<table>\n<thead>\n<tr>\n<th>Token 用途</th>\n<th>最低对比度要求</th>\n<th>测量基准</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>正文文字（vs 背景）</td>\n<td>4.5:1</td>\n<td>WCAG 1.4.3 AA</td>\n</tr>\n<tr>\n<td>大文字（18px+或14px+粗体）</td>\n<td>3:1</td>\n<td>WCAG 1.4.3 AA</td>\n</tr>\n<tr>\n<td>UI 组件边框（vs 背景）</td>\n<td>3:1</td>\n<td>WCAG 1.4.11 AA</td>\n</tr>\n<tr>\n<td>焦点指示器（vs 周围颜色）</td>\n<td>3:1</td>\n<td>WCAG 2.4.11 AA</td>\n</tr>\n<tr>\n<td>错误状态颜色</td>\n<td>不能仅靠颜色传达</td>\n<td>WCAG 1.4.1</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\"/* 设计 token 示例 */&#10;:root {&#10;  /* 文字颜色 - 已验证对比度 */&#10;  --color-text-primary: #1a1a1a; /* vs white: 16.75:1 */&#10;  --color-text-secondary: #595959; /* vs white: 7.0:1 */&#10;  --color-text-disabled: #767676; /* vs white: 4.54:1（刚好 AA）*/&#10;  --color-text-placeholder: #767676; /* 同上，仅用于提示文字 */&#10;&#10;  /* 交互颜色 - 已验证对比度 */&#10;  --color-border-focus: #005fcc; /* vs white: 7.5:1（焦点环颜色）*/&#10;  --color-error: #d32f2f; /* vs white: 5.1:1（错误状态）*/&#10;  --color-border-input: #6b6b6b; /* vs white: 5.9:1（输入框边框）*/&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 设计 token 示例 */</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">:root</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  /* 文字颜色 - 已验证对比度 */</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-text-primary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#1a1a1a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* vs white: 16.75:1 */</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-text-secondary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#595959</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* vs white: 7.0:1 */</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-text-disabled</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#767676</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* vs white: 4.54:1（刚好 AA）*/</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-text-placeholder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#767676</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 同上，仅用于提示文字 */</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  /* 交互颜色 - 已验证对比度 */</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-border-focus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#005fcc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* vs white: 7.5:1（焦点环颜色）*/</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#d32f2f</span><span style=\"color:#24292E;--shiki-dark:#E