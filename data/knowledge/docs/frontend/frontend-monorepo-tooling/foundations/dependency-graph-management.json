9B8FF\"> pkg</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> readFile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(file, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'utf-8'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { name: pkg.name, deps: Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">keys</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pkg.dependencies </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}) };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> internalPackageNames</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(packages.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.name));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> pkg</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> packages) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> internalDeps</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pkg.deps.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> internalPackageNames.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(d));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pkg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} → [${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">internalDeps</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">', '</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}]`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"依赖图的维护与治理\">依赖图的维护与治理</h2><p>随着 Monorepo 规模扩大，依赖图的维护需要主动治理策略。</p>\n<h3 id=\"依赖深度控制\">依赖深度控制</h3><p>定义包的分层级别，禁止跨层直接依赖：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"Layer 0: tooling (ESLint config, TSConfig) - 无业务依赖&#10;Layer 1: packages/types - 纯类型，无运行时依赖&#10;Layer 2: packages/utils - 工具函数，仅依赖 Layer 0-1&#10;Layer 3: packages/ui - UI 组件，仅依赖 Layer 0-2&#10;Layer 4: apps/* - 应用层，可依赖所有下层\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Layer 0: tooling (ESLint config, TSConfig) - 无业务依赖</span></span>\n<span class=\"line\"><span>Layer 1: packages/types - 纯类型，无运行时依赖</span></span>\n<span class=\"line\"><span>Layer 2: packages/utils - 工具函数，仅依赖 Layer 0-1</span></span>\n<span class=\"line\"><span>Layer 3: packages/ui - UI 组件，仅依赖 Layer 0-2</span></span>\n<span class=\"line\"><span>Layer 4: apps/* - 应用层，可依赖所有下层</span></span></code></pre></div><p>通过 Nx 的 <code>project.json</code> 为每个包标记 tag：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;tags&quot;: [&quot;scope:shared&quot;, &quot;type:util&quot;, &quot;layer:2&quot;]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"tags\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"scope:shared\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"type:util\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"layer:2\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>然后在 ESLint 配置中强制约束：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// eslint.config.js（Nx 模块边界规则）&#10;{&#10;  rules: {&#10;    &#39;@nx/enforce-module-boundaries&#39;: [&#39;error&#39;, {&#10;      depConstraints: [&#10;        {&#10;          sourceTag: &#39;layer:4&#39;,&#10;          onlyDependOnLibsWithTags: [&#39;layer:0&#39;, &#39;layer:1&#39;, &#39;layer:2&#39;, &#39;layer:3&#39;, &#39;layer:4&#39;]&#10;        },&#10;        {&#10;          sourceTag: &#39;layer:3&#39;,&#10;          onlyDependOnLibsWithTags: [&#39;layer:0&#39;, &#39;layer:1&#39;, &#39;layer:2&#39;]&#10;        }&#10;      ]&#10;    }]&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// eslint.config.js（Nx 模块边界规则）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  rules</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '@nx/enforce-module-boundaries'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'error'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      depConstraints: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          sourceTag: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:4'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          onlyDependOnLibsWithTags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:2'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:4'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          sourceTag: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          onlyDependOnLibsWithTags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layer:2'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"孤立包检测\">孤立包检测</h3><p>孤立包（没有任何其他包依赖它，且它本身也不是应用）通常是历史遗留代码，应定期清理：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 使用 depcheck 分析未使用的依赖&#10;pnpm dlx depcheck packages/legacy-utils/&#10;&#10;# 检查某包是否被任何其他包引用&#10;grep -r &#39;&quot;@myorg/legacy-utils&quot;&#39; packages/ apps/ --include=&#39;package.json&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 使用 depcheck 分析未使用的依赖</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pnpm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> dlx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> depcheck</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> packages/legacy-utils/</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 检查某包是否被任何其他包引用</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '\"@myorg/legacy-utils\"'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> packages/</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> apps/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'package.json'</span></span></code></pre></div><h2 id=\"小结\">小结</h2><p>依赖图是 Monorepo 工程的隐形骨架，直接影响构建效率和代码治理质量：</p>\n<ul>\n<li><strong>DAG 原则不可违反</strong>：必须保持依赖图是有向无环图，循环依赖会破坏构建顺序和工具链分析</li>\n<li><strong>TypeScript 应同步配置依赖关系</strong>：通过 <code>paths</code> 别名或项目引用，使编译器与包管理器的视图一致</li>\n<li><strong>定期运行循环依赖检测</strong>：将 <code>madge --circular</code> 集成到 CI，早发现早处理</li>\n<li><strong>依赖分层是可维护性的关键</strong>：为包标记 tag 并通过 Nx 模块边界规则约束，防止依赖反转</li>\n<li><strong>可视化工具不可或缺</strong>：复杂 Monorepo 中，<code>nx graph</code> 是理解当前状态的最快方式</li>\n<li><strong>孤立包需定期清理</strong>：历史遗留包增加维护成本，应通过工具定期识别并清除</li>\n</ul>\n<hr>\n<p><strong>本章节相关文档：</strong></p>\n<ul>\n<li><a href=\"monorepo-architecture-patterns\">Monorepo 架构模式</a></li>\n<li><a href=\"package-manager-workspaces\">包管理器 Workspaces</a></li>\n</ul>\n","headings":[{"level":1,"text":"依赖图管理：内部包依赖解析与治理","id":"依赖图管理-内部包依赖解析与治理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"依赖图的概念与重要性","id":"依赖图的概念与重要性"},{"level":2,"text":"依赖解析机制","id":"依赖解析机制"},{"level":3,"text":"workspace 内的模块解析","id":"workspace-内的模块解析"},{"level":3,"text":"TypeScript 路径解析","id":"typescript-路径解析"},{"level":2,"text":"循环依赖检测与处理","id":"循环依赖检测与处理"},{"level":3,"text":"循环依赖的产生场景","id":"循环依赖的产生场景"},{"level":3,"text":"检测工具与配置","id":"检测工具与配置"},{"level":3,"text":"循环依赖的重构策略","id":"循环依赖的重构策略"},{"level":2,"text":"依赖图可视化工具","id":"依赖图可视化工具"},{"level":3,"text":"Nx 项目图","id":"nx-项目图"},{"level":3,"text":"Turborepo 依赖分析","id":"turborepo-依赖分析"},{"level":3,"text":"自定义脚本分析","id":"自定义脚本分析"},{"level":2,"text":"依赖图的维护与治理","id":"依赖图的维护与治理"},{"level":3,"text":"依赖深度控制","id":"依赖深度控制"},{"level":3,"text":"孤立包检测","id":"孤立包检测"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"包管理器 Workspaces：pnpm/npm/yarn 对比与实践","url":"/l-doc-books/h/frontend/frontend-monorepo-tooling/foundations/package-manager-workspaces"},"next":{"title":"Turborepo 工程实践：pipeline、hash 缓存与 remote cache","url":"/l-doc-books/h/frontend/frontend-monorepo-tooling/build-orchestration/turborepo-engineering"}}