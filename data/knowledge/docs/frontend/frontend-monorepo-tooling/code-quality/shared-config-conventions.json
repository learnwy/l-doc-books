/code></pre></div><p>各包的 <code>eslint.config.js</code>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"import { react } from &#39;@myorg/eslint-config/react&#39;;&#10;&#10;export default [&#10;  ...react,&#10;  {&#10;    // 包级别的规则覆盖（仅在必要时使用）&#10;    rules: {&#10;      // 针对这个包的特殊规则&#10;    },&#10;  },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { react } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@myorg/eslint-config/react'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">react,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 包级别的规则覆盖（仅在必要时使用）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rules: {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 针对这个包的特殊规则</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><h2 id=\"共享-prettier-配置\">共享 Prettier 配置</h2><p>Prettier 配置最为简单，通常一个文件即可：</p>\n<p><code>tooling/prettier-config/package.json</code>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;name&quot;: &quot;@myorg/prettier-config&quot;,&#10;  &quot;version&quot;: &quot;0.0.0&quot;,&#10;  &quot;private&quot;: true,&#10;  &quot;main&quot;: &quot;index.js&quot;,&#10;  &quot;exports&quot;: {&#10;    &quot;.&quot;: &quot;./index.js&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"@myorg/prettier-config\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"version\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"0.0.0\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"private\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"main\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"index.js\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"exports\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \".\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./index.js\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>tooling/prettier-config/index.js</code>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"/** @type {import(&quot;prettier&quot;).Config} */&#10;export default {&#10;  semi: false,&#10;  singleQuote: true,&#10;  tabWidth: 2,&#10;  trailingComma: &#39;es5&#39;,&#10;  printWidth: 100,&#10;  bracketSameLine: false,&#10;  plugins: [&#39;prettier-plugin-tailwindcss&#39;],&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/** </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">@type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> {import(\"prettier\").Config}</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  semi: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  singleQuote: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tabWidth: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  trailingComma: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'es5'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  printWidth: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bracketSameLine: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  plugins: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'prettier-plugin-tailwindcss'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>各包在 <code>package.json</code> 中引用（无需独立配置文件）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;prettier&quot;: &quot;@myorg/prettier-config&quot;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"prettier\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"@myorg/prettier-config\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"配置管理的最佳实践\">配置管理的最佳实践</h2><h3 id=\"版本锁定策略\">版本锁定策略</h3><p>所有工具链包的外部依赖（ESLint 插件版本、TypeScript 版本）<strong>应在 tooling 包中集中声明</strong>，各业务包通过 <code>peerDependencies</code> 或不重复声明来使用 hoisting 版本：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;name&quot;: &quot;@myorg/eslint-config&quot;,&#10;  &quot;peerDependencies&quot;: {&#10;    &quot;eslint&quot;: &quot;&gt;=9&quot;,&#10;    &quot;typescript&quot;: &quot;&gt;=5&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"@myorg/eslint-config\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"peerDependencies\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"eslint\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\">=9\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"typescript\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\">=5\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"渐进式规则收紧\">渐进式规则收紧</h3><p>引入共享配置时，应从宽松规则开始，收集各包实际问题后逐步收紧：</p>\n<table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>初始化</td>\n<td>用 <code>warn</code> 而非 <code>error</code>，允许现有违规代码通过</td>\n</tr>\n<tr>\n<td>稳定期</td>\n<td>修复所有 <code>warn</code> 后，将核心规则升级为 <code>error</code></td>\n</tr>\n<tr>\n<td>扩展期</td>\n<td>逐步引入更严格的规则（如 <code>@typescript-eslint/strict</code>）</td>\n</tr>\n</tbody></table>\n<h3 id=\"规则覆盖原则\">规则覆盖原则</h3><p>各包的本地配置<strong>只允许放宽规则，不允许引入新的严格规则</strong>（否则会使规则集碎片化，难以全局理解生效的规则）。</p>\n<h2 id=\"小结\">小结</h2><p>共享配置包是 Monorepo 代码质量保障的基础设施：</p>\n<ul>\n<li><strong>TSConfig 分层</strong>：base → react-library/nextjs/node，减少重复配置</li>\n<li><strong>ESLint flat config</strong>（v9 格式）是未来方向，新项目应直接使用</li>\n<li><strong>Prettier 配置最简单</strong>，通过 <code>package.json</code> 的 <code>prettier</code> 字段一行引用</li>\n<li><strong>所有工具链包应标记 <code>private: true</code></strong>，防止意外发布</li>\n<li><strong>渐进式收紧</strong>：先 warn 后 error，避免引入共享配置时阻断现有 CI</li>\n<li><strong>各包规则覆盖只放宽不收紧</strong>，保持全局规则集的可理解性</li>\n</ul>\n<hr>\n<p><strong>本章节相关文档：</strong></p>\n<ul>\n<li><a href=\"affected-testing\">受影响分析与精准测试</a></li>\n<li><a href=\"versioning-publishing\">版本管理与发布</a></li>\n</ul>\n","headings":[{"level":1,"text":"共享配置与约定：ESLint/TSConfig/Prettier 跨包统一","id":"共享配置与约定-eslint-tsconfig-prettier-跨包统一"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要共享配置","id":"为什么需要共享配置"},{"level":2,"text":"共享 TSConfig 体系","id":"共享-tsconfig-体系"},{"level":3,"text":"基础 TSConfig 包","id":"基础-tsconfig-包"},{"level":3,"text":"各包继承共享 TSConfig","id":"各包继承共享-tsconfig"},{"level":2,"text":"共享 ESLint 配置","id":"共享-eslint-配置"},{"level":3,"text":"ESLint v9 flat config 模式（推荐）","id":"eslint-v9-flat-config-模式-推荐"},{"level":2,"text":"共享 Prettier 配置","id":"共享-prettier-配置"},{"level":2,"text":"配置管理的最佳实践","id":"配置管理的最佳实践"},{"level":3,"text":"版本锁定策略","id":"版本锁定策略"},{"level":3,"text":"渐进式规则收紧","id":"渐进式规则收紧"},{"level":3,"text":"规则覆盖原则","id":"规则覆盖原则"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"任务缓存与远程缓存：本地缓存、Vercel Remote Cache 与 Nx Cloud","url":"/l-doc-books/h/frontend/frontend-monorepo-tooling/build-orchestration/task-caching-remote"},"next":{"title":"受影响分析与精准测试：git diff → task graph → selective run","url":"/l-doc-books/h/frontend/frontend-monorepo-tooling/code-quality/affected-testing"}}