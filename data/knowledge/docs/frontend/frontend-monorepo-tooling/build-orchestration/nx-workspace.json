json\" data-code=\"{&#10;  &quot;tags&quot;: [&quot;scope:shared&quot;, &quot;type:feature&quot;, &quot;domain:auth&quot;]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"tags\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"scope:shared\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"type:feature\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"domain:auth\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"{&#10;  rules: {&#10;    &#39;@nx/enforce-module-boundaries&#39;: [&#39;error&#39;, {&#10;      enforceBuildableLibDependency: true,&#10;      allow: [],&#10;      depConstraints: [&#10;        {&#10;          sourceTag: &#39;scope:app&#39;,&#10;          onlyDependOnLibsWithTags: [&#39;scope:shared&#39;, &#39;scope:app&#39;]&#10;        },&#10;        {&#10;          sourceTag: &#39;domain:auth&#39;,&#10;          notDependOnLibsWithTags: [&#39;domain:payment&#39;]&#10;        }&#10;      ]&#10;    }]&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  rules</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '@nx/enforce-module-boundaries'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'error'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      enforceBuildableLibDependency: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      allow: [],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      depConstraints: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          sourceTag: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'scope:app'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          onlyDependOnLibsWithTags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'scope:shared'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'scope:app'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          sourceTag: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'domain:auth'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          notDependOnLibsWithTags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'domain:payment'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"nx-与-turborepo-能力对比\">Nx 与 Turborepo 能力对比</h2><table>\n<thead>\n<tr>\n<th>能力</th>\n<th>Nx</th>\n<th>Turborepo</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>任务缓存（本地）</td>\n<td>是</td>\n<td>是</td>\n</tr>\n<tr>\n<td>远程缓存</td>\n<td>Nx Cloud / 自建</td>\n<td>Vercel / 自建</td>\n</tr>\n<tr>\n<td>项目图（源码级）</td>\n<td>是</td>\n<td>否（仅 package.json）</td>\n</tr>\n<tr>\n<td>Affected 分析</td>\n<td>是（源码级精确）</td>\n<td>是（文件 hash 级）</td>\n</tr>\n<tr>\n<td>代码生成器</td>\n<td>是（Generators）</td>\n<td>否</td>\n</tr>\n<tr>\n<td>模块边界约束</td>\n<td>是（ESLint 规则）</td>\n<td>否</td>\n</tr>\n<tr>\n<td>分布式任务执行（DTE）</td>\n<td>是（Nx Cloud）</td>\n<td>否</td>\n</tr>\n<tr>\n<td>多语言支持</td>\n<td>是</td>\n<td>否（JS/TS 为主）</td>\n</tr>\n<tr>\n<td>配置复杂度</td>\n<td>中-高</td>\n<td>低</td>\n</tr>\n<tr>\n<td>适合团队规模</td>\n<td>中大型（50+人）</td>\n<td>中小型（10-50人）</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>Nx 是功能最完整的 Monorepo 管理框架，适合需要深度治理的大型项目：</p>\n<ul>\n<li><strong>Project Graph</strong> 是 Nx 的核心优势，源码级精确依赖感知使受影响分析更可靠</li>\n<li><strong>Affected 分析</strong>能在 CI 中实现真正的增量构建，PR 只测试相关包</li>\n<li><strong>Generators</strong> 标准化团队创建包和组件的方式，减少不一致性</li>\n<li><strong>模块边界约束</strong>（<code>@nx/enforce-module-boundaries</code>）是大型团队代码治理的关键工具</li>\n<li><strong>分布式任务执行</strong>（DTE via Nx Cloud）能在多台 CI 机器间分发任务，是超大型 Monorepo 的杀手锏</li>\n<li>Nx 的学习曲线高于 Turborepo，对于 10 人以下的小团队，Turborepo 可能是更合适的选择</li>\n</ul>\n<hr>\n<p><strong>本章节相关文档：</strong></p>\n<ul>\n<li><a href=\"turborepo-engineering\">Turborepo 工程实践</a></li>\n<li><a href=\"task-caching-remote\">任务缓存与远程缓存</a></li>\n</ul>\n","headings":[{"level":1,"text":"Nx 工作空间：项目图、受影响分析与 generators","id":"nx-工作空间-项目图-受影响分析与-generators"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Nx 的定位与核心能力","id":"nx-的定位与核心能力"},{"level":2,"text":"Nx 工作空间初始化","id":"nx-工作空间初始化"},{"level":3,"text":"新建 Nx Monorepo","id":"新建-nx-monorepo"},{"level":3,"text":"工作空间结构","id":"工作空间结构"},{"level":3,"text":"nx.json 核心配置","id":"nx-json-核心配置"},{"level":2,"text":"Project Graph 深度解析","id":"project-graph-深度解析"},{"level":3,"text":"依赖关系的识别来源","id":"依赖关系的识别来源"},{"level":3,"text":"查看和使用项目图","id":"查看和使用项目图"},{"level":2,"text":"Affected 受影响分析","id":"affected-受影响分析"},{"level":3,"text":"工作原理","id":"工作原理"},{"level":3,"text":"Affected 命令用法","id":"affected-命令用法"},{"level":3,"text":"CI 集成策略","id":"ci-集成策略"},{"level":2,"text":"Generators 代码生成","id":"generators-代码生成"},{"level":3,"text":"使用官方 generator","id":"使用官方-generator"},{"level":3,"text":"自定义 Generator","id":"自定义-generator"},{"level":2,"text":"Executors 任务执行器","id":"executors-任务执行器"},{"level":2,"text":"模块边界约束","id":"模块边界约束"},{"level":2,"text":"Nx 与 Turborepo 能力对比","id":"nx-与-turborepo-能力对比"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Turborepo 工程实践：pipeline、hash 缓存与 remote cache","url":"/l-doc-books/h/frontend/frontend-monorepo-tooling/build-orchestration/turborepo-engineering"},"next":{"title":"任务缓存与远程缓存：本地缓存、Vercel Remote Cache 与 Nx Cloud","url":"/l-doc-books/h/frontend/frontend-monorepo-tooling/build-orchestration/task-caching-remote"}}