ki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h3 id=\"性能关键-减少跨边界调用\">性能关键：减少跨边界调用</h3><p>每次 JS → Wasm 或 Wasm → JS 的调用都有开销（通常 50-200ns）。对于循环中的频繁调用，应该批量传递数据而非逐元素调用：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 反模式：逐像素调用&#10;for (let i = 0; i &lt; pixels.length; i++) {&#10;  instance.exports.process_pixel(pixels[i]); // 百万次跨边界调用&#10;}&#10;&#10;// 正确：批量传递&#10;const ptr = instance.exports.alloc(pixels.length * 4);&#10;new Uint8Array(memory.buffer).set(pixels, ptr);&#10;instance.exports.process_batch(ptr, pixels.length); // 一次调用\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 反模式：逐像素调用</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pixels.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  instance.exports.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">process_pixel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pixels[i]); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 百万次跨边界调用</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正确：批量传递</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ptr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> instance.exports.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">alloc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pixels.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Uint8Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(memory.buffer).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pixels, ptr);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">instance.exports.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">process_batch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ptr, pixels.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 一次调用</span></span></code></pre></div><h2 id=\"异步模式与-promise-集成\">异步模式与 Promise 集成</h2><p>Wasm 函数本身是同步的，但可以通过多种模式与异步 JS 世界集成：</p>\n<h3 id=\"模式-1-worker-隔离\">模式 1：Worker 隔离</h3><p>将 Wasm 计算放入 Worker，通过 <code>postMessage</code> 异步通信：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// main.js&#10;const worker = new Worker(&#39;compute-worker.js&#39;);&#10;worker.postMessage({ data: largeArray });&#10;worker.onmessage = (e) =&gt; console.log(e.data.result);&#10;&#10;// compute-worker.js&#10;const { instance } = await WebAssembly.instantiateStreaming(fetch(&#39;/compute.wasm&#39;));&#10;self.onmessage = (e) =&gt; {&#10;  const result = instance.exports.heavy_compute(e.data);&#10;  self.postMessage({ result });&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// main.js</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> worker</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Worker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'compute-worker.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">worker.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">postMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ data: largeArray });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">worker.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onmessage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e.data.result);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// compute-worker.js</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">instance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> WebAssembly.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">instantiateStreaming</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/compute.wasm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">self.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onmessage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> instance.exports.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">heavy_compute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e.data);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  self.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">postMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ result });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h3 id=\"模式-2-asyncify-emscripten\">模式 2：Asyncify（Emscripten）</h3><p>Asyncify 允许 C/C++ 中的同步代码在遇到异步操作时&quot;暂停&quot;，等待 JS Promise 完成后恢复：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// C 代码看起来是同步的&#10;int data = fetch_data(&quot;https://api.example.com/data&quot;);&#10;process(data);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// C 代码看起来是同步的</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch_data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"https://api.example.com/data\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(data);</span></span></code></pre></div><p>Asyncify 在编译时将函数改写为状态机，在 await 点保存/恢复栈状态。代价是约 50% 的代码膨胀。</p>\n<h3 id=\"模式-3-jspi-js-promise-integration\">模式 3：JSPI（JS Promise Integration）</h3><p>2026 年进入标准化的 JSPI 提案让 Wasm 可以原生 suspend/resume：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const instance = await WebAssembly.instantiate(module, {&#10;  env: {&#10;    fetch_data: new WebAssembly.Suspending(async (url_ptr, url_len) =&gt; {&#10;      const url = readString(url_ptr, url_len);&#10;      const response = await fetch(url);&#10;      return await response.arrayBuffer();&#10;    }),&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> instance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> WebAssembly.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">instantiate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">module</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  env: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fetch_data: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> WebAssembly.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Suspending</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">url_ptr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">url_len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> url</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> readString</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url_ptr, url_len);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> response</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">arrayBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>JSPI 比 Asyncify 更高效（无代码膨胀），是未来的方向。</p>\n<h2 id=\"externref-宿主对象的零拷贝引用\">externref：宿主对象的零拷贝引用</h2><p>Reference Types 提案引入的 <code>externref</code> 让 Wasm 可以持有 JS 对象的不透明引用，无需序列化：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// JS 侧&#10;const canvas = document.getElementById(&#39;canvas&#39;);&#10;instance.exports.render(canvas);  // 直接传 DOM 对象&#10;&#10;// Wasm 侧（WAT）&#10;(func $render (param $canvas externref)&#10;  ;; 将 canvas 传给导入的 JS 绘制函数&#10;  local.get $canvas&#10;  call $js_draw)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// JS 侧</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> canvas</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> document.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getElementById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'canvas'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">instance.exports.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(canvas);  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 直接传 DOM 对象</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Wasm 侧（WAT）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(func </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">$render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (param $canvas externref)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ;; 将 canvas 传给导入的 </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> 绘制函数</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  local.get $canvas</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  call $js_draw)</span></span></code></pre></div><p>externref 对 Wasm 是不透明的——不能解引用、不能查看内部结构，只能原样传递给其他导入函数。这保证了安全性。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li><code>instantiateStreaming</code> 是加载 Wasm 的最佳方式（边下载边编译）</li>\n<li>内存交互通过 TypedArray 视图，<code>memory.grow</code> 后必须重建视图</li>\n<li>减少跨边界调用次数是性能优化的第一法则（批量传递数据）</li>\n<li>Worker 隔离、Asyncify 和 JSPI 三种方式解决异步集成</li>\n<li>externref 实现宿主对象的零拷贝安全引用</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"threading-and-workers\">Wasm 线程与 Web Workers</a>：SharedArrayBuffer 驱动的真正多线程</li>\n<li><a href=\"../../frontend-web-workers-parallelism/messaging/message-passing\">消息传递机制</a>：Worker 通信的 postMessage/Transferable 模式</li>\n</ul>\n","headings":[{"level":1,"text":"JavaScript 与 WebAssembly 互操作","id":"javascript-与-webassembly-互操作"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"WebAssembly JavaScript API","id":"webassembly-javascript-api"},{"level":3,"text":"核心对象","id":"核心对象"},{"level":3,"text":"加载与实例化","id":"加载与实例化"},{"level":2,"text":"内存交互模式","id":"内存交互模式"},{"level":3,"text":"内存管理的三种模式","id":"内存管理的三种模式"},{"level":3,"text":"重要陷阱：memory.grow 使 TypedArray 失效","id":"重要陷阱-memory-grow-使-typedarray-失效"},{"level":2,"text":"Import 对象设计模式","id":"import-对象设计模式"},{"level":3,"text":"性能关键：减少跨边界调用","id":"性能关键-减少跨边界调用"},{"level":2,"text":"异步模式与 Promise 集成","id":"异步模式与-promise-集成"},{"level":3,"text":"模式 1：Worker 隔离","id":"模式-1-worker-隔离"},{"level":3,"text":"模式 2：Asyncify（Emscripten）","id":"模式-2-asyncify-emscripten"},{"level":3,"text":"模式 3：JSPI（JS Promise Integration）","id":"模式-3-jspi-js-promise-integration"},{"level":2,"text":"externref：宿主对象的零拷贝引用","id":"externref-宿主对象的零拷贝引用"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"WebAssembly 优化与调试","url":"/l-doc-books/h/frontend/webassembly-toolchains-platforms/toolchains/optimization-and-debugging"},"next":{"title":"Wasm 线程与 Web Workers 协作","url":"/l-doc-books/h/frontend/webassembly-toolchains-platforms/web-integration/threading-and-workers"}}