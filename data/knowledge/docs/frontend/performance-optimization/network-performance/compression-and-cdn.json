yle=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    `Gzip:     ${</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">totalGzip</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1024</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} KB (${</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalGzip</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalOriginal</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}% saved)`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    `Brotli:   ${</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">totalBrotli</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1024</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} KB (${</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalBrotli</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalOriginal</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}% saved)`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">preCompress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dist/**/*.{js,css,html,json,svg}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><hr>\n<h2 id=\"cdn-内容分发网络\">CDN（内容分发网络）</h2><p>CDN 通过在全球部署边缘节点，将静态资源缓存到离用户最近的位置，减少网络延迟。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph 无 CDN&#10;        U1[用户: 上海] --&gt;|200ms| S[源站: 美国]&#10;        U2[用户: 东京] --&gt;|150ms| S&#10;        U3[用户: 伦敦] --&gt;|100ms| S&#10;    end&#10;    subgraph 有 CDN&#10;        U4[用户: 上海] --&gt;|10ms| E1[CDN: 上海节点]&#10;        U5[用户: 东京] --&gt;|10ms| E2[CDN: 东京节点]&#10;        U6[用户: 伦敦] --&gt;|10ms| E3[CDN: 伦敦节点]&#10;        E1 -.-&gt;|回源| S2[源站]&#10;        E2 -.-&gt;|回源| S2&#10;        E3 -.-&gt;|回源| S2&#10;    end\">graph TD\n    subgraph 无 CDN\n        U1[用户: 上海] --&gt;|200ms| S[源站: 美国]\n        U2[用户: 东京] --&gt;|150ms| S\n        U3[用户: 伦敦] --&gt;|100ms| S\n    end\n    subgraph 有 CDN\n        U4[用户: 上海] --&gt;|10ms| E1[CDN: 上海节点]\n        U5[用户: 东京] --&gt;|10ms| E2[CDN: 东京节点]\n        U6[用户: 伦敦] --&gt;|10ms| E3[CDN: 伦敦节点]\n        E1 -.-&gt;|回源| S2[源站]\n        E2 -.-&gt;|回源| S2\n        E3 -.-&gt;|回源| S2\n    end</pre><h3 id=\"cdn-缓存策略\">CDN 缓存策略</h3><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>配置</th>\n<th>适用资源</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>长期缓存</td>\n<td>Cache-Control: public, max-age=31536000</td>\n<td>带哈希的 JS/CSS/图片</td>\n</tr>\n<tr>\n<td>短期缓存</td>\n<td>Cache-Control: public, max-age=3600</td>\n<td>频繁更新的资源</td>\n</tr>\n<tr>\n<td>不缓存</td>\n<td>Cache-Control: no-store</td>\n<td>私有敏感数据</td>\n</tr>\n<tr>\n<td>验证缓存</td>\n<td>Cache-Control: public, no-cache</td>\n<td>HTML 入口</td>\n</tr>\n</tbody></table>\n<h3 id=\"cdn-与版本化部署\">CDN 与版本化部署</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 部署流程&#10;        A[构建产物] --&gt; B[&quot;上传到 CDN&lt;br&gt;app.a1b2c3.js&quot;]&#10;        B --&gt; C[&quot;更新 HTML 引用&quot;]&#10;        C --&gt; D[&quot;部署 HTML (no-cache)&quot;]&#10;    end&#10;    subgraph 用户请求&#10;        E[请求 HTML] --&gt; F[&quot;获取最新 HTML (no-cache)&quot;]&#10;        F --&gt; G[&quot;请求 app.a1b2c3.js&quot;]&#10;        G --&gt; H[&quot;CDN 缓存命中 (immutable)&quot;]&#10;    end\">graph LR\n    subgraph 部署流程\n        A[构建产物] --&gt; B[\"上传到 CDN&lt;br&gt;app.a1b2c3.js\"]\n        B --&gt; C[\"更新 HTML 引用\"]\n        C --&gt; D[\"部署 HTML (no-cache)\"]\n    end\n    subgraph 用户请求\n        E[请求 HTML] --&gt; F[\"获取最新 HTML (no-cache)\"]\n        F --&gt; G[\"请求 app.a1b2c3.js\"]\n        G --&gt; H[\"CDN 缓存命中 (immutable)\"]\n    end</pre><hr>\n<h2 id=\"http-2-与-http-3\">HTTP/2 与 HTTP/3</h2><h3 id=\"http-2-多路复用\">HTTP/2 多路复用</h3><p>HTTP/2 通过单一连接上的多路复用解决了 HTTP/1.1 的队头阻塞问题。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph &quot;HTTP/1.1&quot;&#10;        A1[&quot;连接 1: style.css&quot;] --&gt; A2[&quot;连接 2: app.js&quot;]&#10;        A2 --&gt; A3[&quot;连接 3: image.webp&quot;]&#10;        A3 --&gt; A4[&quot;连接 4: font.woff2&quot;]&#10;        A4 --&gt; A5[&quot;连接 5: data.json&quot;]&#10;        A5 --&gt; A6[&quot;连接 6: icon.svg&quot;]&#10;        Note1[&quot;最多 6 个并发连接&quot;]&#10;    end&#10;    subgraph &quot;HTTP/2&quot;&#10;        B1[&quot;单一连接: 所有资源并行传输&quot;]&#10;        B1 --&gt; B2[style.css]&#10;        B1 --&gt; B3[app.js]&#10;        B1 --&gt; B4[image.webp]&#10;        B1 --&gt; B5[font.woff2]&#10;        B1 --&gt; B6[data.json]&#10;        B1 --&gt; B7[icon.svg]&#10;        Note2[&quot;无并发限制&quot;]&#10;    end\">graph TD\n    subgraph \"HTTP/1.1\"\n        A1[\"连接 1: style.css\"] --&gt; A2[\"连接 2: app.js\"]\n        A2 --&gt; A3[\"连接 3: image.webp\"]\n        A3 --&gt; A4[\"连接 4: font.woff2\"]\n        A4 --&gt; A5[\"连接 5: data.json\"]\n        A5 --&gt; A6[\"连接 6: icon.svg\"]\n        Note1[\"最多 6 个并发连接\"]\n    end\n    subgraph \"HTTP/2\"\n        B1[\"单一连接: 所有资源并行传输\"]\n        B1 --&gt; B2[style.css]\n        B1 --&gt; B3[app.js]\n        B1 --&gt; B4[image.webp]\n        B1 --&gt; B5[font.woff2]\n        B1 --&gt; B6[data.json]\n        B1 --&gt; B7[icon.svg]\n        Note2[\"无并发限制\"]\n    end</pre><h3 id=\"http-2-对优化策略的影响\">HTTP/2 对优化策略的影响</h3><table>\n<thead>\n<tr>\n<th>优化策略</th>\n<th>HTTP/1.1</th>\n<th>HTTP/2</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>域名分片</td>\n<td>有效</td>\n<td>不再需要</td>\n</tr>\n<tr>\n<td>资源合并</td>\n<td>必要（减少请求数）</td>\n<td>不太必要</td>\n</tr>\n<tr>\n<td>内联小资源</td>\n<td>有效</td>\n<td>Server Push 更优</td>\n</tr>\n<tr>\n<td>代码分割</td>\n<td>增加请求数的风险</td>\n<td>可以更细粒度分割</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"资源优化检查清单\">资源优化检查清单</h2><table>\n<thead>\n<tr>\n<th>优化项</th>\n<th>影响</th>\n<th>实施难度</th>\n<th>优先级</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>启用 Brotli 压缩</td>\n<td>高</td>\n<td>低</td>\n<td>P0</td>\n</tr>\n<tr>\n<td>启用 CDN</td>\n<td>高</td>\n<td>中</td>\n<td>P0</td>\n</tr>\n<tr>\n<td>配置长期缓存</td>\n<td>高</td>\n<td>低</td>\n<td>P0</td>\n</tr>\n<tr>\n<td>HTML no-cache</td>\n<td>中</td>\n<td>低</td>\n<td>P0</td>\n</tr>\n<tr>\n<td>升级 HTTP/2</td>\n<td>中</td>\n<td>低</td>\n<td>P1</td>\n</tr>\n<tr>\n<td>构建时预压缩</td>\n<td>中</td>\n<td>中</td>\n<td>P1</td>\n</tr>\n<tr>\n<td>stale-while-revalidate</td>\n<td>中</td>\n<td>低</td>\n<td>P1</td>\n</tr>\n<tr>\n<td>Service Worker 缓存</td>\n<td>中</td>\n<td>高</td>\n<td>P2</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Brotli 比 Gzip 多节省约 15-20% 的传输体积，优先使用 Brotli。</li>\n<li>构建时预压缩避免服务器运行时的 CPU 开销。</li>\n<li>CDN 将静态资源分发到离用户最近的边缘节点，典型减少 80-90% 的网络延迟。</li>\n<li>带哈希指纹的资源配合 CDN 长期缓存 + HTML no-cache 是最佳部署模式。</li>\n<li>HTTP/2 多路复用消除了 HTTP/1.1 时代的域名分片和资源合并需求。</li>\n</ul>\n","headings":[{"level":1,"text":"压缩与 CDN","id":"压缩与-cdn"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"传输压缩","id":"传输压缩"},{"level":3,"text":"Gzip vs Brotli","id":"gzip-vs-brotli"},{"level":3,"text":"压缩协商流程","id":"压缩协商流程"},{"level":3,"text":"Nginx 压缩配置","id":"nginx-压缩配置"},{"level":3,"text":"构建时预压缩","id":"构建时预压缩"},{"level":2,"text":"CDN（内容分发网络）","id":"cdn-内容分发网络"},{"level":3,"text":"CDN 缓存策略","id":"cdn-缓存策略"},{"level":3,"text":"CDN 与版本化部署","id":"cdn-与版本化部署"},{"level":2,"text":"HTTP/2 与 HTTP/3","id":"http-2-与-http-3"},{"level":3,"text":"HTTP/2 多路复用","id":"http-2-多路复用"},{"level":3,"text":"HTTP/2 对优化策略的影响","id":"http-2-对优化策略的影响"},{"level":2,"text":"资源优化检查清单","id":"资源优化检查清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"HTTP 缓存策略","url":"/l-doc-books/h/frontend/performance-optimization/network-performance/http-caching-strategies"},"next":{"title":"API 优化","url":"/l-doc-books/h/frontend/performance-optimization/network-performance/api-optimization"}}