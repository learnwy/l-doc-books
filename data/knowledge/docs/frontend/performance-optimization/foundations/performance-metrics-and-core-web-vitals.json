0;  } else {&#10;    fetch(&#39;/api/metrics&#39;, {&#10;      method: &#39;POST&#39;,&#10;      body: payload,&#10;      keepalive: true,&#10;    });&#10;  }&#10;}&#10;&#10;function collectAndReport(): void {&#10;  const metrics: Partial&lt;PerformanceMetrics&gt; = {&#10;    url: window.location.href,&#10;    timestamp: Date.now(),&#10;    connectionType: (navigator as any).connection?.effectiveType ?? &#39;unknown&#39;,&#10;    deviceMemory: (navigator as any).deviceMemory ?? 0,&#10;  };&#10;&#10;  new PerformanceObserver((list) =&gt; {&#10;    const entry = list.getEntries().at(-1);&#10;    if (entry) {&#10;      metrics.lcp = entry.startTime;&#10;      reportMetrics(metrics as PerformanceMetrics);&#10;    }&#10;  }).observe({ type: &#39;largest-contentful-paint&#39;, buffered: true });&#10;&#10;  new PerformanceObserver((list) =&gt; {&#10;    let cls = 0;&#10;    for (const entry of list.getEntries()) {&#10;      if (!(entry as any).hadRecentInput) cls += (entry as any).value;&#10;    }&#10;    metrics.cls = cls;&#10;  }).observe({ type: &#39;layout-shift&#39;, buffered: true });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PerformanceMetrics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  lcp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  inp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><s