yle=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Cumulative CLS:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, clsScore);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">observer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">observe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layout-shift'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, buffered: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><hr>\n<h2 id=\"其他重要性能指标\">其他重要性能指标</h2><p>除了 Core Web Vitals，以下指标在性能分析中同样不可或缺：</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>全称</th>\n<th>含义</th>\n<th>目标值</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>TTFB</td>\n<td>Time to First Byte</td>\n<td>接收到第一个字节的时间</td>\n<td>&lt; 800ms</td>\n</tr>\n<tr>\n<td>FCP</td>\n<td>First Contentful Paint</td>\n<td>第一次绘制有意义内容</td>\n<td>&lt; 1.8s</td>\n</tr>\n<tr>\n<td>TBT</td>\n<td>Total Blocking Time</td>\n<td>主线程阻塞总时间</td>\n<td>&lt; 200ms</td>\n</tr>\n<tr>\n<td>TTI</td>\n<td>Time to Interactive</td>\n<td>页面完全可交互的时间</td>\n<td>&lt; 3.8s</td>\n</tr>\n<tr>\n<td>SI</td>\n<td>Speed Index</td>\n<td>内容可视化填充速度</td>\n<td>&lt; 3.4s</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const navigationEntry = performance.getEntriesByType(&#39;navigation&#39;)[0] as PerformanceNavigationTiming;&#10;&#10;const metrics = {&#10;  ttfb: navigationEntry.responseStart - navigationEntry.requestStart,&#10;  domContentLoaded: navigationEntry.domContentLoadedEventEnd - navigationEntry.startTime,&#10;  loadComplete: navigationEntry.loadEventEnd - navigationEntry.startTime,&#10;  domInteractive: navigationEntry.domInteractive - navigationEntry.startTime,&#10;  dnsLookup: navigationEntry.domainLookupEnd - navigationEntry.domainLookupStart,&#10;  tcpConnect: navigationEntry.connectEnd - navigationEntry.connectStart,&#10;  tlsNegotiation: navigationEntry.requestStart - navigationEntry.secureConnectionStart,&#10;};&#10;&#10;console.table(metrics);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> navigationEntry</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getEntriesByType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'navigation'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PerformanceNavigationTiming</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> metrics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ttfb: navigationEntry.responseStart </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEntry.requestStart,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  domContentLoaded: navigationEntry.domContentLoadedEventEnd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEntry.startTime,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  loadComplete: navigationEntry.loadEventEnd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEntry.startTime,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  domInteractive: navigationEntry.domInteractive </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEntry.startTime,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  dnsLookup: navigationEntry.domainLookupEnd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEntry.domainLookupStart,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tcpConnect: navigationEntry.connectEnd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEntry.connectStart,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tlsNegotiation: navigationEntry.requestStart </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigationEn