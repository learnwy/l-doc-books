"color:#005CC5;--shiki-dark:#79B8FF\"> any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).hadRecentInput) cls </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (entry </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).value;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    metrics.cls </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cls;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">observe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'layout-shift'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, buffered: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Core Web Vitals 包含 LCP（加载）、INP（交互）、CLS（稳定性）三个核心指标，是以用户为中心的性能度量标准。</li>\n<li>LCP 目标 ≤ 2.5s，影响因素包括服务器响应、资源加载延迟、客户端渲染。</li>\n<li>INP 目标 ≤ 200ms，涵盖输入延迟、事件处理和呈现延迟三个阶段。</li>\n<li>CLS 目标 ≤ 0.1，需要为动态内容预留空间并避免意外的布局偏移。</li>\n<li>使用 PerformanceObserver API 可以精确采集各项性能指标，结合 sendBeacon 实现可靠的数据上报。</li>\n</ul>\n","headings":[{"level":1,"text":"性能指标与 Core Web Vitals","id":"性能指标与-core-web-vitals"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要以用户为中心的性能指标","id":"为什么需要以用户为中心的性能指标"},{"level":2,"text":"Core Web Vitals 三大核心指标","id":"core-web-vitals-三大核心指标"},{"level":3,"text":"LCP — Largest Contentful Paint（最大内容绘制）","id":"lcp-largest-contentful-paint-最大内容绘制"},{"level":3,"text":"INP — Interaction to Next Paint（交互到下次绘制）","id":"inp-interaction-to-next-paint-交互到下次绘制"},{"level":3,"text":"CLS — Cumulative Layout Shift（累积布局偏移）","id":"cls-cumulative-layout-shift-累积布局偏移"},{"level":2,"text":"其他重要性能指标","id":"其他重要性能指标"},{"level":2,"text":"指标采集架构","id":"指标采集架构"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"浏览器渲染管线","url":"/l-doc-books/h/frontend/performance-optimization/foundations/browser-rendering-pipeline"}}