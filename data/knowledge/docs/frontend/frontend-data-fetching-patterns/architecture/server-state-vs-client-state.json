4292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>表单是最常见的灰色地带——初始值来自服务端，但编辑过程中是纯客户端状态：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const { data: user } = useQuery(userQueries.detail(userId));&#10;const [formData, setFormData] = useState&lt;UserForm | null&gt;(null);&#10;&#10;// 服务端数据加载后初始化表单（只做一次）&#10;useEffect(() =&gt; {&#10;  if (user &amp;&amp; !formData) {&#10;    setFormData({ name: user.name, email: user.email });&#10;  }&#10;}, [user, formData]);&#10;&#10;// 之后 formData 是纯客户端状态，不再跟踪服务端变化\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userQueries.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">detail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userId));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">formData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setFormData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useState</span><span style=\"color:#2429