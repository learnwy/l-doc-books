F\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  theme: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'system'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  toggleSidebar</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({ sidebarOpen: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">s.sidebarOpen })),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}));</span></span></code></pre></div><h3 id=\"模式二-feature-内聚\">模式二：Feature 内聚</h3><p>每个 feature 目录内部同时包含查询定义和本地状态，但两者使用不同的机制：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"features/&#10;  projects/&#10;    queries.ts     → queryOptions (服务端状态)&#10;    store.ts       → zustand/jotai (客户端状态)&#10;    components/    → 消费两者\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>features/</span></span>\n<span class=\"line\"><span>  projects/</span></span>\n<span class=\"line\"><span>    queries.ts     → queryOptions (服务端状态)</span></span>\n<span class=\"line\"><span>    store.ts       → zustand/jotai (客户端状态)</span></span>\n<span class=\"line\"><span>    components/    → 消费两者</span></span></code></pre></div><h3 id=\"模式三-url-作为状态源\">模式三：URL 作为状态源</h3><p>将可共享的客户端状态（筛选、排序、分页）放入 URL 而非内存 store：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// URL 状态：用户可以分享、书签、前进后退&#10;const [searchParams, setSearchParams] = useSearchParams();&#10;const page = Number(searchParams.get(&#39;page&#39;) ?? &#39;1&#39;);&#10;const sort = searchParams.get(&#39;sort&#39;) ?? &#39;created_at&#39;;&#10;&#10;// 查询直接使用 URL 参数&#10;const { data } = useQuery({&#10;  queryKey: [&#39;products&#39;, { page, sort }],&#10;  queryFn: () =&gt; fetchProducts({ page, sort }),&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// URL 状态：用户可以分享、书签、前进后退</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">searchParams</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setSearchParams</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useSearchParams</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(searchParams.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'page'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sort</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> searchParams.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sort'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'created_at'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 查询直接使用 URL 参数</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  queryKey: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'products'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { page, sort }],</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  queryFn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchProducts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ page, sort }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"状态选型决策树\">状态选型决策树</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[一个新状态需求] --&gt; B{数据来自服务端?}&#10;    B --&gt;|是| C{需要缓存/同步?}&#10;    C --&gt;|是| D[TanStack Query / SWR / RTK Query]&#10;    C --&gt;|否| E[useState / useRef]&#10;    B --&gt;|否| F{需要跨组件共享?}&#10;    F --&gt;|否| G[useState]&#10;    F --&gt;|是| H{需要持久化/可分享?}&#10;    H --&gt;|是| I[URL searchParams]&#10;    H --&gt;|否| J{状态复杂度?}&#10;    J --&gt;|简单| K[Context / Jotai atom]&#10;    J --&gt;|复杂| L[Zustand / Redux slice]\">flowchart TD\n    A[一个新状态需求] --&gt; B{数据来自服务端?}\n    B --&gt;|是| C{需要缓存/同步?}\n    C --&gt;|是| D[TanStack Query / SWR / RTK Query]\n    C --&gt;|否| E[useState / useRef]\n    B --&gt;|否| F{需要跨组件共享?}\n    F --&gt;|否| G[useState]\n    F --&gt;|是| H{需要持久化/可分享?}\n    H --&gt;|是| I[URL searchParams]\n    H --&gt;|否| J{状态复杂度?}\n    J --&gt;|简单| K[Context / Jotai atom]\n    J --&gt;|复杂| L[Zustand / Redux slice]</pre><h2 id=\"迁移策略-从混合-store-到分离架构\">迁移策略：从混合 store 到分离架构</h2><p>对于已经将服务端数据存入 Redux 的遗留项目，迁移应该渐进式进行：</p>\n<table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>动作</th>\n<th>风险</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>1. 新功能用 TanStack Query</td>\n<td>新代码直接使用数据请求库</td>\n<td>零——不影响已有代码</td>\n</tr>\n<tr>\n<td>2. 标识可迁移的 slice</td>\n<td>找出纯&quot;获取→存储→展示&quot;的 slice</td>\n<td>仅分析</td>\n</tr>\n<tr>\n<td>3. 逐个替换</td>\n<td>用 useQuery 替换 thunk + slice</td>\n<td>中——需要回归测试</td>\n</tr>\n<tr>\n<td>4. 清理 store</td>\n<td>移除已空的 slice</td>\n<td>低——已经不被引用</td>\n</tr>\n</tbody></table>\n<p>RTK Query 为这种迁移提供了独特优势——它可以与现有的 Redux slice 共存于同一个 store 中，允许逐步将 <code>createAsyncThunk</code> + slice 模式替换为 <code>createApi</code> 端点。</p>\n<h2 id=\"性能影响\">性能影响</h2><p>状态分离不仅是架构整洁性的追求——它直接影响运行时性能：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 反模式：整个 Redux store 更新触发全局 re-render&#10;// 一个 API 响应更新了 store → 所有 useSelector 重新计算&#10;&#10;// 正确：TanStack Query 的细粒度通知&#10;// 仅订阅了特定 queryKey 的组件才 re-render&#10;// structural sharing 确保引用稳定性\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 反模式：整个 Redux store 更新触发全局 re-render</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 一个 API 响应更新了 store → 所有 useSelector 重新计算</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正确：TanStack Query 的细粒度通知</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 仅订阅了特定 queryKey 的组件才 re-render</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// structural sharing 确保引用稳定性</span></span></code></pre></div><p>TanStack Query 的 structural sharing 和 SWR 的引用相等性检查意味着：即使服务端返回了相同的数据，组件也不会重渲染——因为缓存层已经判断出&quot;数据未变化&quot;。这比 Redux 的 selector + shallowEqual 模式更加自动化。</p>\n<h2 id=\"小结\">小结</h2><p>状态分离是整个 hub 知识体系的收束点。回顾学习路径：<a href=\"../fundamentals/fetch-lifecycle-patterns\">请求生命周期</a>建立了基础词汇，缓存和错误处理完善了机制理解，三大库提供了工具选择，高级模式解决了复杂场景，预取和瀑布流优化了性能——而状态分离则为这一切提供了统一的架构视角：<strong>让专门的工具管理专门的状态类型</strong>。</p>\n","headings":[{"level":1,"text":"服务端状态与客户端状态分离","id":"服务端状态与客户端状态分离"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"两种状态的本质区别","id":"两种状态的本质区别"},{"level":2,"text":"为什么要分离","id":"为什么要分离"},{"level":2,"text":"灰色地带：派生状态与混合状态","id":"灰色地带-派生状态与混合状态"},{"level":2,"text":"状态分离的架构模式","id":"状态分离的架构模式"},{"level":3,"text":"模式一：按层分治","id":"模式一-按层分治"},{"level":3,"text":"模式二：Feature 内聚","id":"模式二-feature-内聚"},{"level":3,"text":"模式三：URL 作为状态源","id":"模式三-url-作为状态源"},{"level":2,"text":"状态选型决策树","id":"状态选型决策树"},{"level":2,"text":"迁移策略：从混合 store 到分离架构","id":"迁移策略-从混合-store-到分离架构"},{"level":2,"text":"性能影响","id":"性能影响"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"请求瀑布流优化","url":"/l-doc-books/h/frontend/frontend-data-fetching-patterns/architecture/request-waterfall-optimization"},"next":null}