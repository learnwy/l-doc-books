:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { SWRConfig } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'swr'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> swrConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  fetcher</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">url</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  revalidateOnFocus: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  revalidateOnReconnect: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  shouldRetryOnError: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  errorRetryCount: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  dedupingInterval: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SWRConfig value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{swrConfig}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">App </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SWRConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><p>嵌套的 <code>SWRConfig</code> 会合并配置，子级覆盖父级——适合为特定模块设置不同的缓存策略。</p>\n<h2 id=\"无限加载\">无限加载</h2><p><code>useSWRInfinite</code> 为分页和无限滚动提供专用支持：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import useSWRInfinite from &#39;swr/infinite&#39;;&#10;&#10;const getKey = (pageIndex: number, previousPageData: Page | null) =&gt; {&#10;  if (previousPageData &amp;&amp; !previousPageData.hasMore) return null; // 到底了&#10;  return `/api/posts?page=${pageIndex}&amp;limit=20`;&#10;};&#10;&#10;const { data, size, setSize, isValidating } = useSWRInfinite(getKey, fetcher);&#10;&#10;// data 是页面数组：Page[]&#10;const allPosts = data?.flatMap((page) =&gt; page.items) ?? [];&#10;const isLoadingMore = size &gt; 0 &amp;&amp; typeof data?.[size - 1] === &#39;undefined&#39;;&#10;const hasMore = data?.[data.length - 1]?.hasMore ?? true;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> useSWRInfinite </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'swr/infinite'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getKey</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pageIndex</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">previousPageData</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (previousPageData </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">previousPageData.hasMore) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 到底了</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `/api/posts?page=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pageIndex</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}&#x26;limit=20`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">size</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setSize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">isValidating</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useSWRInfinite</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(getKey, fetcher);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// data 是页面数组：Page[]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> allPosts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.items) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> isLoadingMore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> typeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data?.[size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'undefined'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hasMore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data?.[data.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]?.hasMore </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p><code>getKey</code> 函数接收页码和上一页数据，返回 <code>null</code> 表示没有更多页。这种设计比 TanStack Query 的 <code>getNextPageParam</code> 更灵活——它可以基于任意逻辑决定下一页的 key。</p>\n<h2 id=\"预加载与中间件\">预加载与中间件</h2><p>SWR v2 引入了 <code>preload</code> 函数和中间件系统：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { preload } from &#39;swr&#39;&#10;&#10;// 路由切换前预加载&#10;preload(&#39;/api/user&#39;, fetcher)&#10;&#10;// 鼠标悬停预加载&#10;&lt;Link&#10;  href=&quot;/dashboard&quot;&#10;  onMouseEnter={() =&gt; preload(&#39;/api/dashboard&#39;, fetcher)}&#10;&gt;&#10;  Dashboard&#10;&lt;/Link&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { preload } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'swr'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 路由切换前预加载</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">preload</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/user'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, fetcher)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 鼠标悬停预加载</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Link</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  href</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"/dashboard\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  onMouseEnter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{() => </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">preload</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/dashboard'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">fetcher</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  Dashboard</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Link</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><p>中间件系统允许增强 <code>useSWR</code> 的行为：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import useSWR, { SWRConfig } from &#39;swr&#39;&#10;&#10;// 日志中间件&#10;const logger = (useSWRNext) =&gt; (key, fetcher, config) =&gt; {&#10;  const swr = useSWRNext(key, fetcher, config)&#10;&#10;  useEffect(() =&gt; {&#10;    console.log(&#39;SWR:&#39;, key, swr.data)&#10;  }, [swr.data])&#10;&#10;  return swr&#10;}&#10;&#10;&lt;SWRConfig value={{ use: [logger] }}&gt;&#10;  &lt;App /&gt;&#10;&lt;/SWRConfig&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> useSWR, { SWRConfig } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'swr'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 日志中间件</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> logger</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">useSWRNext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">fetcher</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">config</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> swr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useSWRNext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, fetcher, config)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  useEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'SWR:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, key, swr.data)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }, [swr.data])</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> swr</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SWRConfig value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">use</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [logger] }}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">App </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SWRConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><h2 id=\"swr-vs-tanstack-query-选型决策\">SWR vs TanStack Query 选型决策</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>SWR</th>\n<th>TanStack Query</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>包大小</td>\n<td>~4.2KB gzip</td>\n<td>~13KB gzip</td>\n</tr>\n<tr>\n<td>API 复杂度</td>\n<td>1 个核心 hook + 少量辅助</td>\n<td>10+ hooks + QueryClient API</td>\n</tr>\n<tr>\n<td>DevTools</td>\n<td>无官方 DevTools</td>\n<td>功能丰富的 DevTools</td>\n</tr>\n<tr>\n<td>Suspense</td>\n<td>支持但非一等</td>\n<td>useSuspenseQuery 一等支持</td>\n</tr>\n<tr>\n<td>离线模式</td>\n<td>基础支持</td>\n<td>完整离线队列</td>\n</tr>\n<tr>\n<td>框架支持</td>\n<td>仅 React</td>\n<td>React, Vue, Solid, Svelte, Angular</td>\n</tr>\n<tr>\n<td>Next.js 集成</td>\n<td>深度集成（同团队）</td>\n<td>良好但需手动配置</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>30 分钟</td>\n<td>2-4 小时</td>\n</tr>\n</tbody></table>\n<p>选择 SWR 的典型场景：Next.js 项目、中小型应用、团队偏好极简 API、不需要复杂的缓存控制。选择 TanStack Query 的典型场景：复杂缓存需求、需要离线支持、非 React 框架、团队需要 DevTools 辅助调试。</p>\n<h2 id=\"小结\">小结</h2><p>SWR 的极简哲学——一个核心 hook、key 即参数、自动重验证——让它成为中小型 React 项目和 Next.js 生态中数据获取的理想选择。对于已有 Redux 基础设施的大型应用，还有第三个选择——<a href=\"rtk-query-redux\">RTK Query</a>——它与 Redux store 的深度集成提供了独特的优势。</p>\n","headings":[{"level":1,"text":"SWR 模式与最佳实践","id":"swr-模式与最佳实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心设计哲学","id":"核心设计哲学"},{"level":2,"text":"缓存与重验证机制","id":"缓存与重验证机制"},{"level":2,"text":"条件请求与依赖获取","id":"条件请求与依赖获取"},{"level":2,"text":"Mutation 与乐观更新","id":"mutation-与乐观更新"},{"level":2,"text":"全局配置与 Provider","id":"全局配置与-provider"},{"level":2,"text":"无限加载","id":"无限加载"},{"level":2,"text":"预加载与中间件","id":"预加载与中间件"},{"level":2,"text":"SWR vs TanStack Query 选型决策","id":"swr-vs-tanstack-query-选型决策"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"TanStack Query 深度实践","url":"/l-doc-books/h/frontend/frontend-data-fetching-patterns/libraries/tanstack-query-deep"},"next":{"title":"RTK Query 与 Redux 集成","url":"/l-doc-books/h/frontend/frontend-data-fetching-patterns/libraries/rtk-query-redux"}}