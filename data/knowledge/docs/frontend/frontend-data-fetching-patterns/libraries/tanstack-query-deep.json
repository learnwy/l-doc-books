span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">signal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchPosts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ cursor: pageParam, signal }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  initialPageParam: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getNextPageParam</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">lastPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lastPage.nextCursor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  maxPages: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// v5 新增：限制内存中保留的页数</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p><code>maxPages</code> 是 v5 的重要新增——它解决了无限滚动场景下内存持续增长的问题。当页数超过限制时，最早的页会被丢弃，但用户向上滚动时可以重新获取。</p>\n<h2 id=\"预取与-ssr-集成\">预取与 SSR 集成</h2><p>预取将请求提前到用户行为之前，消除交互延迟：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 路由级预取&#10;const router = createBrowserRouter([{&#10;  path: &#39;/users/:id&#39;,&#10;  loader: ({ params }) =&gt; {&#10;    queryClient.prefetchQuery(userQueries.detail(params.id!))&#10;    return null&#10;  },&#10;  element: &lt;UserPage /&gt;,&#10;}])&#10;&#10;// 交互级预取——鼠标悬停时&#10;&lt;Link&#10;  to={`/users/${user.id}`}&#10;  onMouseEnter={() =&gt; queryClient.prefetchQuery(userQueries.detail(user.id))}&#10;&gt;&#10;  {user.name}&#10;&lt;/Link&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 路由级预取</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> router</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createBrowserRouter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  path: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/users/:id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  loader</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: ({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">params</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    queryClient.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">prefetchQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userQueries.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">detail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(params.id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  element: &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">UserPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> />,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}])</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 交互级预取——鼠标悬停时</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Link</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  to</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`/users/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">user</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">id</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  onMouseEnter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{() => queryClient.prefetchQuery(userQueries.detail(user.id))}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {user.name}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Link</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><p>SSR 场景使用 <code>HydrationBoundary</code>（v5 替代了 v4 的 <code>Hydrate</code> 组件）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 服务端&#10;const queryClient = new QueryClient()&#10;await queryClient.prefetchQuery(userQueries.detail(userId))&#10;const dehydratedState = dehydrate(queryClient)&#10;&#10;// 客户端&#10;&lt;HydrationBoundary state={dehydratedState}&gt;&#10;  &lt;UserProfile /&gt;&#10;&lt;/HydrationBoundary&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 服务端</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> queryClient</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QueryClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> queryClient.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">prefetchQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userQueries.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">detail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userId))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dehydratedState</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dehydrate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(queryClient)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 客户端</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">HydrationBoundary state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{dehydratedState}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">UserProfile </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">HydrationBoundary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><h2 id=\"devtools-与调试\">DevTools 与调试</h2><p>v5 的新 DevTools 提供了更强大的缓存可视化——包括查询状态时间线、缓存条目的实时观察和手动触发重验证：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { ReactQueryDevtools } from &#39;@tanstack/react-query-devtools&#39;&#10;&#10;&lt;QueryClientProvider client={queryClient}&gt;&#10;  &lt;App /&gt;&#10;  &lt;ReactQueryDevtools initialIsOpen={false} /&gt;&#10;&lt;/QueryClientProvider&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ReactQueryDevtools } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@tanstack/react-query-devtools'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">QueryClientProvider client</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{queryClient}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">App </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ReactQueryDevtools initialIsOpen</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{false} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">QueryClientProvider</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><p>DevTools 在开发模式中帮助诊断：为什么某个查询不停地重新获取（通常是 queryKey 不稳定）、为什么数据没有被缓存命中（key 结构不匹配）、以及缓存条目的生命周期是否符合预期。</p>\n<h2 id=\"性能优化清单\">性能优化清单</h2><table>\n<thead>\n<tr>\n<th>优化项</th>\n<th>配置</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>设置合理 staleTime</td>\n<td><code>staleTime: 5 * 60 * 1000</code></td>\n<td>减少后台请求数</td>\n</tr>\n<tr>\n<td>使用 select 提取子集</td>\n<td><code>select: (data) =&gt; data.name</code></td>\n<td>减少无关重渲染</td>\n</tr>\n<tr>\n<td>placeholderData 快速展示</td>\n<td><code>placeholderData: keepPreviousData</code></td>\n<td>分页切换无闪烁</td>\n</tr>\n<tr>\n<td>批量失效而非逐个</td>\n<td><code>invalidateQueries({ queryKey: [&#39;users&#39;] })</code></td>\n<td>一次通知多个查询</td>\n</tr>\n<tr>\n<td>限制 maxPages</td>\n<td><code>maxPages: 10</code></td>\n<td>控制无限列表内存</td>\n</tr>\n<tr>\n<td>notifyOnChangeProps</td>\n<td><code>notifyOnChangeProps: [&#39;data&#39;]</code></td>\n<td>仅关心数据变化时通知</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>TanStack Query 的设计哲学——声明式数据依赖、自动化缓存管理、可组合的查询选项——代表了 2026 年前端数据层的最佳实践。但它并非唯一选择；对于追求极简 API 的项目，<a href=\"swr-vercel-patterns\">SWR</a> 提供了另一种优雅的方案。</p>\n","headings":[{"level":1,"text":"TanStack Query 深度实践","id":"tanstack-query-深度实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心架构与数据流","id":"核心架构与数据流"},{"level":2,"text":"Query Options 工厂模式","id":"query-options-工厂模式"},{"level":2,"text":"Suspense 模式与 useSuspenseQuery","id":"suspense-模式与-usesuspensequery"},{"level":2,"text":"并行查询与依赖查询","id":"并行查询与依赖查询"},{"level":2,"text":"Mutation 与缓存同步","id":"mutation-与缓存同步"},{"level":2,"text":"无限查询","id":"无限查询"},{"level":2,"text":"预取与 SSR 集成","id":"预取与-ssr-集成"},{"level":2,"text":"DevTools 与调试","id":"devtools-与调试"},{"level":2,"text":"性能优化清单","id":"性能优化清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"错误处理与重试策略","url":"/l-doc-books/h/frontend/frontend-data-fetching-patterns/fundamentals/error-retry-resilience"},"next":{"title":"SWR 模式与最佳实践","url":"/l-doc-books/h/frontend/frontend-data-fetching-patterns/libraries/swr-vercel-patterns"}}