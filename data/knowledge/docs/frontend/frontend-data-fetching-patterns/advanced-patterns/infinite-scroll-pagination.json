shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}, [virtualizer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getVirtualItems</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()]);</span></span></code></pre></div><h2 id=\"分页切换的平滑体验\">分页切换的平滑体验</h2><p>传统分页在切换页码时的常见问题是&quot;白屏闪烁&quot;。使用 <code>placeholderData</code> 保持前一页数据直到新页加载完成：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { keepPreviousData } from &#39;@tanstack/react-query&#39;&#10;&#10;const { data, isPlaceholderData } = useQuery({&#10;  queryKey: [&#39;posts&#39;, { page }],&#10;  queryFn: () =&gt; fetchPosts({ page }),&#10;  placeholderData: keepPreviousData, // v5 替代了 keepPreviousData 选项&#10;})&#10;&#10;// UI 中用 isPlaceholderData 区分&quot;展示旧页数据&quot;&#10;&lt;div className={isPlaceholderData ? &#39;opacity-60&#39; : &#39;&#39;}&gt;&#10;  {data?.items.map(item =&gt; &lt;Row key={item.id} item={item} /&gt;)}&#10;&lt;/div&gt;&#10;&#10;// 预取下一页&#10;useEffect(() =&gt; {&#10;  if (data?.hasMore) {&#10;    queryClient.prefetchQuery({&#10;      queryKey: [&#39;posts&#39;, { page: page + 1 }],&#10;      queryFn: () =&gt; fetchPosts({ page: page + 1 }),&#10;    })&#10;  }&#10;}, [data, page])\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { keepPreviousData } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@tanstack/react-query'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dat