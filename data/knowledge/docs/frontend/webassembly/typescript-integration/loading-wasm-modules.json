k:#B392F0\">compute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(inputData);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    APP[&quot;应用启动&quot;] --&gt; JS_BUNDLE[&quot;加载 JS Bundle&quot;]&#10;    JS_BUNDLE --&gt; RENDER[&quot;渲染 UI&quot;]&#10;    RENDER --&gt; USER_ACTION[&quot;用户触发操作&quot;]&#10;    USER_ACTION --&gt;|&quot;动态 import()&quot;| WASM_LOAD[&quot;加载 WASM 模块&quot;]&#10;    WASM_LOAD --&gt; INIT[&quot;初始化&quot;]&#10;    INIT --&gt; COMPUTE[&quot;执行计算&quot;]&#10;    COMPUTE --&gt; RESULT[&quot;返回结果&quot;]\">graph TD\n    APP[\"应用启动\"] --&gt; JS_BUNDLE[\"加载 JS Bundle\"]\n    JS_BUNDLE --&gt; RENDER[\"渲染 UI\"]\n    RENDER --&gt; USER_ACTION[\"用户触发操作\"]\n    USER_ACTION --&gt;|\"动态 import()\"| WASM_LOAD[\"加载 WASM 模块\"]\n    WASM_LOAD --&gt; INIT[\"初始化\"]\n    INIT --&gt; COMPUTE[\"执行计算\"]\n    COMPUTE --&gt; RESULT[\"返回结果\"]</pre><table>\n<thead>\n<tr>\n<th>加载策略</th>\n<th>实现方式</th>\n<th>首屏影响</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>静态导入</td>\n<td><code>import {} from &#39;...&#39;</code></td>\n<td>增加体积</td>\n<td>核心功能</td>\n</tr>\n<tr>\n<td>动态导入</td>\n<td><code>import(&#39;...&#39;)</code></td>\n<td>无影响</td>\n<td>非核心功能</td>\n</tr>\n<tr>\n<td>预加载</td>\n<td><code>&lt;link rel=&quot;preload&quot;&gt;</code></td>\n<td>提前下载</td>\n<td>预期很快会用到</td>\n</tr>\n<tr>\n<td>Service Worker</td>\n<td>SW 缓存 + 离线</td>\n<td>无影响</td>\n<td>重复访问优化</td>\n</tr>\n<tr>\n<td>CDN 边缘缓存</td>\n<td>CDN + Cache-Control</td>\n<td>减少延迟</td>\n<td>全球分发</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"if (&#39;connection&#39; in navigator) {&#10;  const conn = (navigator as any).connection;&#10;  if (conn.effectiveType === &#39;4g&#39;) {&#10;    import(&#39;./pkg/heavy_compute.js&#39;);&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'connection'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigator) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> conn</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (navigator </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).connection;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (conn.effectiveType </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '4g'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./pkg/heavy_compute.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 对于频繁使用的 WASM 模块，浏览器的编译缓存（Compiled Module Cache）会自动生效。第二次加载同一个 WASM 文件时，浏览器直接使用缓存的编译结果，跳过编译阶段。</p>\n</blockquote>\n<hr>\n<h2 id=\"多模块协作\">多模块协作</h2><p>大型项目可能包含多个 WASM 模块，需要合理管理它们的加载和通信。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"async function registerModule(name: string, loader: () =&gt; Promise&lt;any&gt;) {&#10;  const mod = await loader();&#10;  await mod.default();&#10;  registry[name] = { init: mod.default, exports: mod };&#10;}&#10;&#10;await Promise.all([&#10;  registerModule(&#39;image&#39;, () =&gt; import(&#39;./pkg/image_wasm.js&#39;)),&#10;  registerModule(&#39;crypto&#39;, () =&gt; import(&#39;./pkg/crypto_wasm.js&#39;)),&#10;]);&#10;&#10;const sharedMemory = new WebAssembly.Memory({&#10;  initial: 256,&#10;  maximum: 1024,&#10;  shared: true,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> registerModule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">loader</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> mod</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> loader</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mod.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  registry[name] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { init: mod.default, exports: mod };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">all</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  registerModule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'image'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./pkg/image_wasm.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  registerModule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'crypto'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./pkg/crypto_wasm.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sharedMemory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> WebAssembly.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Memory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  initial: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">256</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  maximum: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1024</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  shared: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    APP[&quot;应用&quot;] --&gt; REGISTRY[&quot;模块注册表&quot;]&#10;    REGISTRY --&gt; IMAGE[&quot;image-wasm&lt;br/&gt;图像处理&quot;]&#10;    REGISTRY --&gt; CRYPTO[&quot;crypto-wasm&lt;br/&gt;加密运算&quot;]&#10;    REGISTRY --&gt; COMPRESS[&quot;compress-wasm&lt;br/&gt;数据压缩&quot;]&#10;    IMAGE --&gt;|&quot;SharedMemory&quot;| SHARED[&quot;共享线性内存&quot;]&#10;    CRYPTO --&gt; SHARED&#10;    COMPRESS --&gt; SHARED\">graph TD\n    APP[\"应用\"] --&gt; REGISTRY[\"模块注册表\"]\n    REGISTRY --&gt; IMAGE[\"image-wasm&lt;br/&gt;图像处理\"]\n    REGISTRY --&gt; CRYPTO[\"crypto-wasm&lt;br/&gt;加密运算\"]\n    REGISTRY --&gt; COMPRESS[\"compress-wasm&lt;br/&gt;数据压缩\"]\n    IMAGE --&gt;|\"SharedMemory\"| SHARED[\"共享线性内存\"]\n    CRYPTO --&gt; SHARED\n    COMPRESS --&gt; SHARED</pre><table>\n<thead>\n<tr>\n<th>协作模式</th>\n<th>数据传递方式</th>\n<th>复杂度</th>\n<th>性能</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>独立内存</td>\n<td>JS 中转拷贝</td>\n<td>低</td>\n<td>一般</td>\n</tr>\n<tr>\n<td>共享内存</td>\n<td>SharedArrayBuffer</td>\n<td>高</td>\n<td>最佳</td>\n</tr>\n<tr>\n<td>消息传递</td>\n<td>postMessage</td>\n<td>中</td>\n<td>一般</td>\n</tr>\n<tr>\n<td>模块链接</td>\n<td>Module Linking 提案</td>\n<td>中</td>\n<td>优秀</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((加载 WASM 模块))&#10;    加载 API&#10;      instantiateStreaming&#10;      流式编译&#10;      MIME 类型要求&#10;    Vite 集成&#10;      vite-plugin-wasm&#10;      多种导入方式&#10;      开箱即用&#10;    webpack 支持&#10;      asyncWebAssembly&#10;      独立 chunk&#10;      wasm-pack-plugin&#10;    动态导入&#10;      按需加载&#10;      预加载策略&#10;      Service Worker 缓存&#10;    多模块协作&#10;      模块注册表&#10;      共享内存&#10;      并行加载\">mindmap\n  root((加载 WASM 模块))\n    加载 API\n      instantiateStreaming\n      流式编译\n      MIME 类型要求\n    Vite 集成\n      vite-plugin-wasm\n      多种导入方式\n      开箱即用\n    webpack 支持\n      asyncWebAssembly\n      独立 chunk\n      wasm-pack-plugin\n    动态导入\n      按需加载\n      预加载策略\n      Service Worker 缓存\n    多模块协作\n      模块注册表\n      共享内存\n      并行加载</pre><ul>\n<li>始终优先使用 <code>instantiateStreaming</code>，它支持<strong>流式编译</strong>和浏览器编译缓存。</li>\n<li>Vite 通过 <code>vite-plugin-wasm</code> 提供开箱即用的 WASM 支持，支持 <code>?init</code>/<code>?url</code> 等多种导入方式。</li>\n<li>webpack 5 通过 <code>asyncWebAssembly</code> 实验性配置支持异步 WASM 加载。</li>\n<li>大型应用应采用<strong>动态导入</strong>模式，结合预加载和 Service Worker 缓存优化加载体验。</li>\n<li>多模块场景可通过共享内存或模块注册表实现高效协作。</li>\n</ul>\n","headings":[{"level":1,"text":"加载 WASM 模块","id":"加载-wasm-模块"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"WebAssembly.instantiate vs instantiateStreaming","id":"webassembly-instantiate-vs-instantiatestreaming"},{"level":2,"text":"Vite WASM 插件","id":"vite-wasm-插件"},{"level":2,"text":"webpack WASM 支持","id":"webpack-wasm-支持"},{"level":2,"text":"动态导入模式","id":"动态导入模式"},{"level":2,"text":"多模块协作","id":"多模块协作"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"调试 WASM","url":"/l-doc-books/h/frontend/webassembly/rust-to-wasm/debugging-wasm"},"next":{"title":"类型安全 WASM 接口","url":"/l-doc-books/h/frontend/webassembly/typescript-integration/typed-wasm-interfaces"}}