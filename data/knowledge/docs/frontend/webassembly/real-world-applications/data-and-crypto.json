:#005CC5;--shiki-dark:#79B8FF\"> SQL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Database</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> sql.js 的数据库完全在内存中运行，刷新页面后数据会丢失。使用 OPFS（Origin Private File System）可以实现持久化存储，但需要在安全上下文（HTTPS）中使用。</p>\n</blockquote>\n<hr>\n<h2 id=\"duckdb-wasm\">DuckDB WASM</h2><p>DuckDB 是一个面向分析的嵌入式数据库，编译到 WASM 后可以在浏览器中处理 GB 级数据分析。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import * as duckdb from &#39;@duckdb/duckdb-wasm&#39;;&#10;&#10;async function analyzeData() {&#10;  const JSDELIVR_BUNDLES = duckdb.getJsDelivrBundles();&#10;  const bundle = await duckdb.selectBundle(JSDELIVR_BUNDLES);&#10;  const worker = new Worker(bundle.mainWorker!);&#10;  const db = new duckdb.AsyncDuckDB(new duckdb.ConsoleLogger(), worker);&#10;  await db.instantiate(bundle.mainModule, bundle.pthreadWorker);&#10;  const conn = await db.connect();&#10;&#10;  await conn.query(`&#10;    CREATE TABLE sales AS SELECT * FROM read_csv_auto(&#39;https://example.com/sales.csv&#39;)&#10;  `);&#10;&#10;  const result = await conn.query(`&#10;    SELECT region, SUM(revenue) AS total_revenue, COUNT(*) AS orders&#10;    FROM sales WHERE date &gt;= &#39;2025-01-01&#39;&#10;    GROUP BY region ORDER BY total_revenue DESC LIMIT 10&#10;  `);&#10;&#10;  console.table(result.toArray());&#10;  await conn.close();&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> duckdb </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@duckdb/duckdb-wasm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> analyzeData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> JSDELIVR_BUNDLES</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> duckdb.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getJsDelivrBundles</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bundle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> duckdb.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">selectBundle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSDELIVR_BUNDLES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> worker</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Worker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(bundle.mainWorker</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> duckdb.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">AsyncDuckDB</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> duckdb.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ConsoleLogger</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), worker);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">instantiate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(bundle.mainModule, bundle.pthreadWorker);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> conn</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">connect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    CREATE TABLE sales AS SELECT * FROM read_csv_auto('https://example.com/sales.csv')</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  `</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    SELECT region, SUM(revenue) AS total_revenue, COUNT(*) AS orders</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    FROM sales WHERE date >= '2025-01-01'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    GROUP BY region ORDER BY total_revenue DESC LIMIT 10</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  `</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">table</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>对比维度</th>\n<th>DuckDB WASM</th>\n<th>sql.js</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>定位</td>\n<td>OLAP 分析</td>\n<td>OLTP 事务</td>\n</tr>\n<tr>\n<td>数据处理量</td>\n<td>GB 级</td>\n<td>MB 级</td>\n</tr>\n<tr>\n<td>列式存储</td>\n<td>✅ 是</td>\n<td>❌ 行式</td>\n</tr>\n<tr>\n<td>Parquet 支持</td>\n<td>✅ 原生</td>\n<td>❌ 不支持</td>\n</tr>\n<tr>\n<td>CSV 导入</td>\n<td>✅ 自动推断</td>\n<td>❌ 需手动</td>\n</tr>\n<tr>\n<td>HTTP 远程查询</td>\n<td>✅ 支持</td>\n<td>❌ 不支持</td>\n</tr>\n<tr>\n<td>WASM 大小</td>\n<td>~8 MB</td>\n<td>~1.2 MB</td>\n</tr>\n<tr>\n<td>窗口函数</td>\n<td>✅ 完整</td>\n<td>✅ 基本</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    SOURCES[&quot;数据源&quot;] --&gt; DUCKDB[&quot;DuckDB WASM&quot;]&#10;    SOURCES --&gt; CSV[&quot;CSV 文件&quot;]&#10;    SOURCES --&gt; PARQUET[&quot;Parquet 文件&quot;]&#10;    SOURCES --&gt; JSON_DATA[&quot;JSON 数据&quot;]&#10;    SOURCES --&gt; HTTP[&quot;远程 HTTP&quot;]&#10;    DUCKDB --&gt; ANALYSIS[&quot;分析查询&quot;]&#10;    ANALYSIS --&gt; CHART[&quot;图表可视化&quot;]&#10;    ANALYSIS --&gt; EXPORT_DATA[&quot;导出结果&quot;]\">graph LR\n    SOURCES[\"数据源\"] --&gt; DUCKDB[\"DuckDB WASM\"]\n    SOURCES --&gt; CSV[\"CSV 文件\"]\n    SOURCES --&gt; PARQUET[\"Parquet 文件\"]\n    SOURCES --&gt; JSON_DATA[\"JSON 数据\"]\n    SOURCES --&gt; HTTP[\"远程 HTTP\"]\n    DUCKDB --&gt; ANALYSIS[\"分析查询\"]\n    ANALYSIS --&gt; CHART[\"图表可视化\"]\n    ANALYSIS --&gt; EXPORT_DATA[\"导出结果\"]</pre><blockquote>\n<p><strong>提示：</strong> DuckDB WASM 支持直接查询远程 Parquet 文件（通过 HTTP range requests），无需将整个文件下载到本地。这使得浏览器可以查询存储在 S3/GCS 上的 TB 级数据集的子集。</p>\n</blockquote>\n<hr>\n<h2 id=\"加密运算\">加密运算</h2><p>将加密算法编译到 WASM 可以获得比纯 JS 实现更好的性能，同时避免了 Web Crypto API 的异步限制。</p>\n<div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"use wasm_bindgen::prelude::*;&#10;use sha2::{Sha256, Digest};&#10;use aes_gcm::{aead::{Aead, KeyInit}, Aes256Gcm, Nonce};&#10;&#10;#[wasm_bindgen]&#10;pub fn sha256_hash(data: &amp;[u8]) -&gt; Vec&lt;u8&gt; {&#10;    let mut hasher = Sha256::new();&#10;    hasher.update(data);&#10;    hasher.finalize().to_vec()&#10;}&#10;&#10;#[wasm_bindgen]&#10;pub fn aes_encrypt(key: &amp;[u8], nonce: &amp;[u8], plaintext: &amp;[u8]) -&gt; Result&lt;Vec&lt;u8&gt;, JsValue&gt; {&#10;    let cipher = Aes256Gcm::new_from_slice(key)&#10;        .map_err(|e| JsValue::from_str(&amp;e.to_string()))?;&#10;    cipher.encrypt(Nonce::from_slice(nonce), plaintext)&#10;        .map_err(|e| JsValue::from_str(&amp;e.to_string()))&#10;}&#10;&#10;#[wasm_bindgen]&#10;pub fn aes_decrypt(key: &amp;[u8], nonce: &amp;[u8], ciphertext: &amp;[u8]) -&gt; Result&lt;Vec&lt;u8&gt;, JsValue&gt; {&#10;    let cipher = Aes256Gcm::new_from_slice(key)&#10;        .map_err(|e| JsValue::from_str(&amp;e.to_string()))?;&#10;    cipher.decrypt(Nonce::from_slice(nonce), ciphertext)&#10;        .map_err(|e| JsValue::from_str(&amp;e.to_string()))&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>use wasm_bindgen::prelude::*;</span></span>\n<span class=\"line\"><span>use sha2::{Sha256, Digest};</span></span>\n<span class=\"line\"><span>use aes_gcm::{aead::{Aead, KeyInit}, Aes256Gcm, Nonce};</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[wasm_bindgen]</span></span>\n<span class=\"line\"><span>pub fn sha256_hash(data: &#x26;[u8]) -> Vec&#x3C;u8> {</span></span>\n<span class=\"line\"><span>    let mut hasher = Sha256::new();</span></span>\n<span class=\"line\"><span>    hasher.update(data);</span></span>\n<span class=\"line\"><span>    hasher.finalize().to_vec()</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[wasm_bindgen]</span></span>\n<span class=\"line\"><span>pub fn aes_encrypt(key: &#x26;[u8], nonce: &#x26;[u8], plaintext: &#x26;[u8]) -> Result&#x3C;Vec&#x3C;u8>, JsValue> {</span></span>\n<span class=\"line\"><span>    let cipher = Aes256Gcm::new_from_slice(key)</span></span>\n<span class=\"line\"><span>        .map_err(|e| JsValue::from_str(&#x26;e.to_string()))?;</span></span>\n<span class=\"line\"><span>    cipher.encrypt(Nonce::from_slice(nonce), plaintext)</span></span>\n<span class=\"line\"><span>        .map_err(|e| JsValue::from_str(&#x26;e.to_string()))</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[wasm_bindgen]</span></span>\n<span class=\"line\"><span>pub fn aes_decrypt(key: &#x26;[u8], nonce: &#x26;[u8], ciphertext: &#x26;[u8]) -> Result&#x3C;Vec&#x3C;u8>, JsValue> {</span></span>\n<span class=\"line\"><span>    let cipher = Aes256Gcm::new_from_slice(key)</span></span>\n<span class=\"line\"><span>        .map_err(|e| JsValue::from_str(&#x26;e.to_string()))?;</span></span>\n<span class=\"line\"><span>    cipher.decrypt(Nonce::from_slice(nonce), ciphertext)</span></span>\n<span class=\"line\"><span>        .map_err(|e| JsValue::from_str(&#x26;e.to_string()))</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>算法</th>\n<th>Web Crypto</th>\n<th>WASM (Rust)</th>\n<th>对比</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SHA-256</td>\n<td>异步，快</td>\n<td>同步，快</td>\n<td>相当</td>\n</tr>\n<tr>\n<td>AES-GCM</td>\n<td>异步，快</td>\n<td>同步，快</td>\n<td>相当</td>\n</tr>\n<tr>\n<td>Argon2</td>\n<td>❌ 不支持</td>\n<td>✅ 同步</td>\n<td>WASM 独有</td>\n</tr>\n<tr>\n<td>Ed25519</td>\n<td>❌ 不支持</td>\n<td>✅ 同步</td>\n<td>WASM 独有</td>\n</tr>\n<tr>\n<td>ChaCha20-Poly1305</td>\n<td>❌ 不支持</td>\n<td>✅ 同步</td>\n<td>WASM 独有</td>\n</tr>\n<tr>\n<td>PBKDF2</td>\n<td>异步</td>\n<td>同步</td>\n<td>WASM 更灵活</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { sha256_hash, aes_encrypt, aes_decrypt } from &#39;./pkg/crypto_wasm.js&#39;;&#10;&#10;const data = new TextEncoder().encode(&#39;敏感数据&#39;);&#10;const hash = sha256_hash(data);&#10;console.log(&#10;  &#39;SHA-256:&#39;,&#10;  Array.from(hash)&#10;    .map((b) =&gt; b.toString(16).padStart(2, &#39;0&#39;))&#10;    .join(&#39;&#39;),&#10;);&#10;&#10;const key = crypto.getRandomValues(new Uint8Array(32));&#10;const nonce = crypto.getRandomValues(new Uint8Array(12));&#10;const encrypted = aes_encrypt(key, nonce, data);&#10;const decrypted = aes_decrypt(key, nonce, encrypted);&#10;console.log(&#39;解密:&#39;, new TextDecoder().decode(decrypted));\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { sha256_hash, aes_encrypt, aes_decrypt } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> './pkg/crypto_wasm.js'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TextEncoder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">encode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'敏感数据'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hash</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sha256_hash</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(data);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'SHA-256:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  Array.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(hash)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toString</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">padStart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> crypto.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getRandomValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Uint8Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nonce</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> crypto.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getRandomValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Uint8Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> encrypted</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> aes_encrypt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, nonce, data);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> decrypted</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> aes_decrypt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, nonce, encrypted);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'解密:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TextDecoder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">decode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(decrypted));</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> WASM 加密实现的一个重要优势是<strong>同步执行</strong>。Web Crypto API 的所有操作都是异步的，在需要大量小数据块加密的场景（如逐帧加密），WASM 的同步调用避免了 Promise 调度开销。</p>\n</blockquote>\n<hr>\n<h2 id=\"protobuf-flatbuffers-in-wasm\">Protobuf / FlatBuffers in WASM</h2><p>高效的序列化格式编译到 WASM，可以在浏览器中实现零拷贝数据访问和高速序列化。</p>\n<div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"use wasm_bindgen::prelude::*;&#10;use prost::Message;&#10;&#10;#[derive(Clone, PartialEq, Message)]&#10;pub struct UserEvent {&#10;    #[prost(string, tag = &quot;1&quot;)]&#10;    pub user_id: String,&#10;    #[prost(string, tag = &quot;2&quot;)]&#10;    pub event_type: String,&#10;    #[prost(int64, tag = &quot;3&quot;)]&#10;    pub timestamp: i64,&#10;}&#10;&#10;#[wasm_bindgen]&#10;pub fn encode_event(user_id: &amp;str, event_type: &amp;str, timestamp: f64) -&gt; Vec&lt;u8&gt; {&#10;    let event = UserEvent {&#10;        user_id: user_id.to_string(),&#10;        event_type: event_type.to_string(),&#10;        timestamp: timestamp as i64,&#10;    };&#10;    event.encode_to_vec()&#10;}&#10;&#10;#[wasm_bindgen]&#10;pub fn decode_event(data: &amp;[u8]) -&gt; JsValue {&#10;    match UserEvent::decode(data) {&#10;        Ok(event) =&gt; {&#10;            let obj = js_sys::Object::new();&#10;            js_sys::Reflect::set(&amp;obj, &amp;&quot;userId&quot;.into(), &amp;event.user_id.into()).unwrap();&#10;            js_sys::Reflect::set(&amp;obj, &amp;&quot;eventType&quot;.into(), &amp;event.event_type.into()).unwrap();&#10;            obj.into()&#10;        }&#10;        Err(e) =&gt; JsValue::from_str(&amp;e.to_string()),&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>use wasm_bindgen::prelude::*;</span></span>\n<span class=\"line\"><span>use prost::Message;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[derive(Clone, PartialEq, Message)]</span></span>\n<span class=\"line\"><span>pub struct UserEvent {</span></span>\n<span class=\"line\"><span>    #[prost(string, tag = \"1\")]</span></span>\n<span class=\"line\"><span>    pub user_id: String,</span></span>\n<span class=\"line\"><span>    #[prost(string, tag = \"2\")]</span></span>\n<span class=\"line\"><span>    pub event_type: String,</span></span>\n<span class=\"line\"><span>    #[prost(int64, tag = \"3\")]</span></span>\n<span class=\"line\"><span>    pub timestamp: i64,</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[wasm_bindgen]</span></span>\n<span class=\"line\"><span>pub fn encode_event(user_id: &#x26;str, event_type: &#x26;str, timestamp: f64) -> Vec&#x3C;u8> {</span></span>\n<span class=\"line\"><span>    let event = UserEvent {</span></span>\n<span class=\"line\"><span>        user_id: user_id.to_string(),</span></span>\n<span class=\"line\"><span>        event_type: event_type.to_string(),</span></span>\n<span class=\"line\"><span>        timestamp: timestamp as i64,</span></span>\n<span class=\"line\"><span>    };</span></span>\n<span class=\"line\"><span>    event.encode_to_vec()</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[wasm_bindgen]</span></span>\n<span class=\"line\"><span>pub fn decode_event(data: &#x26;[u8]) -> JsValue {</span></span>\n<span class=\"line\"><span>    match UserEvent::decode(data) {</span></span>\n<span class=\"line\"><span>        Ok(event) => {</span></span>\n<span class=\"line\"><span>            let obj = js_sys::Object::new();</span></span>\n<span class=\"line\"><span>            js_sys::Reflect::set(&#x26;obj, &#x26;\"userId\".into(), &#x26;event.user_id.into()).unwrap();</span></span>\n<span class=\"line\"><span>            js_sys::Reflect::set(&#x26;obj, &#x26;\"eventType\".into(), &#x26;event.event_type.into()).unwrap();</span></span>\n<span class=\"line\"><span>            obj.into()</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>        Err(e) => JsValue::from_str(&#x26;e.to_string()),</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>格式</th>\n<th>序列化速度</th>\n<th>反序列化速度</th>\n<th>体积</th>\n<th>零拷贝</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>JSON</td>\n<td>慢</td>\n<td>慢</td>\n<td>大</td>\n<td>❌ 否</td>\n</tr>\n<tr>\n<td>Protobuf</td>\n<td>快</td>\n<td>快</td>\n<td>小</td>\n<td>❌ 否</td>\n</tr>\n<tr>\n<td>FlatBuffers</td>\n<td>极快</td>\n<td>极快</td>\n<td>中</td>\n<td>✅ 是</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 序列化方案对比&#10;        JSON_FLOW[&quot;JSON&lt;br/&gt;encode → 字符串 → decode&quot;]&#10;        PROTO_FLOW[&quot;Protobuf&lt;br/&gt;encode → 二进制 → decode&quot;]&#10;        FLAT_FLOW[&quot;FlatBuffers&lt;br/&gt;build → 二进制 → 直接访问&quot;]&#10;    end&#10;    JSON_FLOW --&gt;|&quot;慢/大&quot;| RESULT1[&quot;结果&quot;]&#10;    PROTO_FLOW --&gt;|&quot;快/小&quot;| RESULT2[&quot;结果&quot;]&#10;    FLAT_FLOW --&gt;|&quot;最快/零拷贝&quot;| RESULT3[&quot;结果&quot;]\">graph LR\n    subgraph 序列化方案对比\n        JSON_FLOW[\"JSON&lt;br/&gt;encode → 字符串 → decode\"]\n        PROTO_FLOW[\"Protobuf&lt;br/&gt;encode → 二进制 → decode\"]\n        FLAT_FLOW[\"FlatBuffers&lt;br/&gt;build → 二进制 → 直接访问\"]\n    end\n    JSON_FLOW --&gt;|\"慢/大\"| RESULT1[\"结果\"]\n    PROTO_FLOW --&gt;|\"快/小\"| RESULT2[\"结果\"]\n    FLAT_FLOW --&gt;|\"最快/零拷贝\"| RESULT3[\"结果\"]</pre><blockquote>\n<p><strong>提示：</strong> FlatBuffers 的核心优势是<strong>零拷贝反序列化</strong>——数据不需要解析到内存对象中，而是直接在二进制缓冲区上访问字段。配合 WASM 的共享线性内存，可以实现 JS 和 WASM 之间的零拷贝数据交换。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((数据与加密))&#10;    SQLite WASM&#10;      完整 SQL 支持&#10;      OPFS 持久化&#10;      ~1.2 MB 体积&#10;    DuckDB WASM&#10;      OLAP 分析&#10;      Parquet 原生&#10;      远程查询&#10;    加密运算&#10;      同步执行&#10;      Argon2/Ed25519&#10;      Web Crypto 补充&#10;    序列化&#10;      Protobuf 高效编码&#10;      FlatBuffers 零拷贝&#10;      替代 JSON\">mindmap\n  root((数据与加密))\n    SQLite WASM\n      完整 SQL 支持\n      OPFS 持久化\n      ~1.2 MB 体积\n    DuckDB WASM\n      OLAP 分析\n      Parquet 原生\n      远程查询\n    加密运算\n      同步执行\n      Argon2/Ed25519\n      Web Crypto 补充\n    序列化\n      Protobuf 高效编码\n      FlatBuffers 零拷贝\n      替代 JSON</pre><ul>\n<li><strong>sql.js</strong> 将完整 SQLite 编译到 WASM（~1.2MB），支持 SQL 查询、JOIN、事务，配合 OPFS 实现持久化。</li>\n<li><strong>DuckDB WASM</strong> 面向 OLAP 分析，支持 Parquet 原生读取和远程 HTTP 查询 TB 级数据。</li>\n<li>WASM 加密实现提供 <strong>同步执行</strong>和 Web Crypto 不支持的算法（Argon2、Ed25519、ChaCha20）。</li>\n<li><strong>Protobuf</strong> 提供高效的二进制序列化，<strong>FlatBuffers</strong> 实现零拷贝反序列化。</li>\n<li>在浏览器中运行数据库和加密引擎，实现了<strong>完全离线</strong>和<strong>数据不出端</strong>的隐私保护架构。</li>\n</ul>\n","headings":[{"level":1,"text":"数据与加密","id":"数据与加密"},{"level":2,"text":"数据与加密","id":"数据与加密"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"SQLite WASM (sql.js)","id":"sqlite-wasm-sql-js"},{"level":2,"text":"DuckDB WASM","id":"duckdb-wasm"},{"level":2,"text":"加密运算","id":"加密运算"},{"level":2,"text":"Protobuf / FlatBuffers in WASM","id":"protobuf-flatbuffers-in-wasm"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"游戏与创意应用","url":"/l-doc-books/h/frontend/webassembly/real-world-applications/game-and-creative"},"next":null}