LJS --&gt; MEMORY[&quot;内存数据库&quot;]&#10;    SQLJS --&gt; OPFS[&quot;OPFS 持久化&quot;]&#10;    SQLJS --&gt; EXPORT[&quot;导出 .db 文件&quot;]&#10;&#10;    subgraph 存储选项&#10;        MEMORY&#10;        OPFS[&quot;Origin Private File System&quot;]&#10;        IDB[&quot;IndexedDB 备份&quot;]&#10;        DOWNLOAD[&quot;用户下载&quot;]&#10;    end\">graph TD\n    APP[\"Web 应用\"] --&gt; SQLJS[\"sql.js&lt;br/&gt;(SQLite WASM)\"]\n    SQLJS --&gt; MEMORY[\"内存数据库\"]\n    SQLJS --&gt; OPFS[\"OPFS 持久化\"]\n    SQLJS --&gt; EXPORT[\"导出 .db 文件\"]\n\n    subgraph 存储选项\n        MEMORY\n        OPFS[\"Origin Private File System\"]\n        IDB[\"IndexedDB 备份\"]\n        DOWNLOAD[\"用户下载\"]\n    end</pre><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>sql.js</th>\n<th>IndexedDB</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>查询语言</td>\n<td>完整 SQL</td>\n<td>游标 API</td>\n</tr>\n<tr>\n<td>JOIN 支持</td>\n<td>✅ 完整</td>\n<td>❌ 不支持</td>\n</tr>\n<tr>\n<td>聚合函数</td>\n<td>✅ COUNT/SUM/AVG...</td>\n<td>❌ 手动计算</td>\n</tr>\n<tr>\n<td>索引</td>\n<td>✅ B-Tree 索引</td>\n<td>✅ 基本索引</td>\n</tr>\n<tr>\n<td>事务</td>\n<td>✅ ACID</td>\n<td>✅ 基本事务</td>\n</tr>\n<tr>\n<td>WASM 大小</td>\n<td>~1.2 MB</td>\n<td>浏览器内置</td>\n</tr>\n<tr>\n<td>数据持久化</td>\n<td>需要手动（OPFS/IDB）</td>\n<td>自动持久化</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"async function persistDatabase(db: Database): Promise&lt;void&gt; {&#10;  const data = db.export();&#10;  const root = await navigator.storage.getDirectory();&#10;  const handle = await root.getFileHandle(&#39;app.db&#39;, { create: true });&#10;  const writable = await handle.createWritable();&#10;  await writable.write(data);&#10;  await writable.close();&#10;}&#10;&#10;async function loadDatabase(SQL: any): Promise&lt;Database&gt; {&#10;  const root = await navigator.storage.getDirectory();&#10;  try {&#10;    const handle = await root.getFileHandle(&#39;app.db&#39;);&#10;    const file = await handle.getFile();&#10;    const buffer = await file.arrayBuffer();&#10;    return new SQL.Database(new Uint8Array(buffer));&#10;  } catch {&#10;    return new SQL.Database();&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> persistDatabase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Database</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">export</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> root</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigator.storage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getDirectory</span><span style=\"color:#24292E;--s