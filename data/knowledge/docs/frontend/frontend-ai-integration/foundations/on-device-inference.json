--shiki-dark:#E1E4E8\"> stream) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> delta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chunk.choices[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]?.delta?.content </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (delta) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        self.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">postMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'token'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, payload: delta });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    self.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">postMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ type: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'done'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>主线程侧使用 <code>SharedArrayBuffer</code> + <code>Atomics</code> 或 <code>MessageChannel</code> 与 Worker 通信。对于流式输出，推荐 Worker 每 token 发一条 <code>postMessage</code>，主线程批量积累再渲染（配合 <code>requestAnimationFrame</code>，参见 <a href=\"llm-api-streaming-patterns\">LLM API 流式接入模式</a> 中的渲染节流方案）。</p>\n<h2 id=\"模型加载-进度展示与缓存策略\">模型加载：进度展示与缓存策略</h2><p>首次加载是浏览器端推理最大的用户体验挑战——2 GB 的下载等待如果没有清晰的进度反馈，用户会认为页面崩溃了。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function ModelLoadingProgress({ progress, text }: {&#10;  progress: number;&#10;  text: string;&#10;}) {&#10;  const percent = Math.round(progress * 100);&#10;&#10;  return (&#10;    &lt;div className=&quot;model-loading&quot;&gt;&#10;      &lt;div className=&quot;progress-bar&quot;&gt;&#10;        &lt;div&#10;          className=&quot;progress-fill&quot;&#10;          style={{ width: `${percent}%` }}&#10;        /&gt;&#10;      &lt;/div&gt;&#10;      &lt;p&gt;{text}&lt;/p&gt;&#10;      &lt;p&gt;{percent}% — 首次加载后将缓存到本地，下次秒开&lt;/p&gt;&#10;    &lt;/div&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ModelLoadingProgress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">progress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  progress</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> percent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(progress </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"model-loading\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"progress-bar\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        &#x3C;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">div</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"progress-fill\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          style</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">width</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">percent</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}%`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        /></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{text}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">p</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{percent}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> — 首次加载后将缓存到本地，下次秒开</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">p</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>WebLLM 使用浏览器的 <strong>Cache API</strong> 缓存模型文件，后续加载无需重新下载。Transformers.js 通过 <code>env.cacheDir</code> 配置 <strong>Origin Private File System（OPFS）</strong> 缓存目录，同样实现一次下载多次复用。</p>\n<h2 id=\"场景判断-何时使用浏览器端推理\">场景判断：何时使用浏览器端推理</h2><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐方案</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>隐私敏感数据处理（医疗、法律、个人日记）</td>\n<td>浏览器端推理</td>\n<td>数据零出端，架构层面的隐私保证</td>\n</tr>\n<tr>\n<td>高频低复杂度任务（语法检查、简单分类）</td>\n<td>浏览器端推理</td>\n<td>消除每次 API 调用费用，低延迟</td>\n</tr>\n<tr>\n<td>离线 PWA</td>\n<td>浏览器端推理</td>\n<td>网络不可用时仍可使用 AI 功能</td>\n</tr>\n<tr>\n<td>需要 GPT-4 级别推理质量</td>\n<td>云端 API</td>\n<td>小型量化模型无法匹敌旗舰模型质量</td>\n</tr>\n<tr>\n<td>面向企业用户（老旧硬件）</td>\n<td>云端 API</td>\n<td>无法保证所有用户硬件支持 WebGPU</td>\n</tr>\n<tr>\n<td>首次使用需要即时响应</td>\n<td>云端 API</td>\n<td>2 GB 下载等待不可接受</td>\n</tr>\n</tbody></table>\n<p><strong>混合架构</strong>是生产应用的最佳实践：检测 WebGPU 支持 → 用户选择启用本地模式 → 成功加载后在本地处理，失败则透明降级到云端 API。这样用户在支持的设备上享受本地隐私与低延迟，在不支持的设备上不受影响。</p>\n<h2 id=\"小结\">小结</h2><p>浏览器端推理在 2026 年已经具备生产落地的条件，但需要清醒认识其约束：</p>\n<ul>\n<li><strong>WebGPU</strong> 是技术基础，需要在应用入口检测支持情况并准备云端降级方案</li>\n<li><strong>WebLLM</strong> 是当前 LLM 推理的最成熟选项，提供 OpenAI 兼容 API，适合直接集成</li>\n<li><strong>Transformers.js</strong> 覆盖更广泛的任务类型（分类、NLP、音频），适合专用模型场景</li>\n<li><strong>Web Worker 隔离</strong>是必选架构，推理不能运行在主线程，否则 UI 必然卡顿</li>\n<li><strong>OPFS 缓存</strong>解决了&quot;每次重新下载&quot;的用户体验问题，首次下载后可以秒开</li>\n<li><strong>混合架构</strong>（本地优先 + 云端降级）是生产应用的正确起点，而非纯本地或纯云端</li>\n</ul>\n<p>关于如何在不支持 WebGPU 的场景下优雅降级到云端 API，参见 <a href=\"ai-sdk-landscape\">AI SDK 生态与选型</a> 和 <a href=\"llm-api-streaming-patterns\">LLM API 流式接入模式</a>。</p>\n","headings":[{"level":1,"text":"浏览器端推理与 WebLLM","id":"浏览器端推理与-webllm"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"技术基础：WebGPU 是一切的底层","id":"技术基础-webgpu-是一切的底层"},{"level":2,"text":"主流框架对比","id":"主流框架对比"},{"level":3,"text":"WebLLM：生产级 LLM 推理","id":"webllm-生产级-llm-推理"},{"level":3,"text":"Transformers.js：Hugging Face 生态的浏览器版","id":"transformers-js-hugging-face-生态的浏览器版"},{"level":3,"text":"ONNX Runtime Web：自定义模型部署","id":"onnx-runtime-web-自定义模型部署"},{"level":2,"text":"Web Worker 隔离：推理不能阻塞主线程","id":"web-worker-隔离-推理不能阻塞主线程"},{"level":2,"text":"模型加载：进度展示与缓存策略","id":"模型加载-进度展示与缓存策略"},{"level":2,"text":"场景判断：何时使用浏览器端推理","id":"场景判断-何时使用浏览器端推理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"LLM API 流式接入模式","url":"/l-doc-books/h/frontend/frontend-ai-integration/foundations/llm-api-streaming-patterns"},"next":{"title":"AI SDK 生态与选型","url":"/l-doc-books/h/frontend/frontend-ai-integration/foundations/ai-sdk-landscape"}}