nt.data;&#10;&#10;  if (type === &#39;init&#39;) {&#10;    engine = new webllm.MLCEngine();&#10;    await engine.reload(payload.modelId, {&#10;      initProgressCallback: (report) =&gt; {&#10;        self.postMessage({ type: &#39;progress&#39;, payload: report });&#10;      },&#10;    });&#10;    self.postMessage({ type: &#39;ready&#39; });&#10;  }&#10;&#10;  if (type === &#39;generate&#39;) {&#10;    const stream = await engine!.chat.completions.create({&#10;      messages: payload.messages,&#10;      stream: true,&#10;    });&#10;    for await (const chunk of stream) {&#10;      const delta = chunk.choices[0]?.delta?.content ?? &#39;&#39;;&#10;      if (delta) {&#10;        self.postMessage({ type: &#39;token&#39;, payload: delta });&#10;      }&#10;    }&#10;    self.postMessage({ type: &#39;done&#39; });&#10;  }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ai.worker.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> webllm </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@mlc-ai/web-llm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> engine</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> webllm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">