lor:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1440</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  .container</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    max-width</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1200</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">px</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"常用断点\">常用断点</h3><table>\n<thead>\n<tr>\n<th>名称</th>\n<th>断点</th>\n<th>典型设备</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>xs</td>\n<td>&lt; 640px</td>\n<td>小手机</td>\n</tr>\n<tr>\n<td>sm</td>\n<td>≥ 640px</td>\n<td>大手机</td>\n</tr>\n<tr>\n<td>md</td>\n<td>≥ 768px</td>\n<td>平板</td>\n</tr>\n<tr>\n<td>lg</td>\n<td>≥ 1024px</td>\n<td>笔记本</td>\n</tr>\n<tr>\n<td>xl</td>\n<td>≥ 1280px</td>\n<td>桌面</td>\n</tr>\n<tr>\n<td>2xl</td>\n<td>≥ 1536px</td>\n<td>大屏</td>\n</tr>\n</tbody></table>\n<h3 id=\"现代媒体查询语法\">现代媒体查询语法</h3><div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\"/* 范围语法（Media Queries Level 4） */&#10;@media (width &gt;= 768px) {&#10;  .sidebar {&#10;    display: block;&#10;  }&#10;}&#10;&#10;@media (768px &lt;= width &lt; 1024px) {&#10;  .sidebar {&#10;    width: 200px;&#10;  }&#10;}&#10;&#10;/* 偏好查询 */&#10;@media (prefers-color-scheme: dark) {&#10;  :root {&#10;    --bg: #0f172a;&#10;  }&#10;}&#10;&#10;@media (prefers-reduced-motion: reduce) {&#10;  * {&#10;    animation-duration: 0.01ms !important;&#10;  }&#10;}&#10;&#10;@media (hover: 