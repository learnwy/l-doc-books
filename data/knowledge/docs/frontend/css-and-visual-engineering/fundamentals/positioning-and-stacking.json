&#10;        L3[&quot;3. 块级非定位元素&quot;]&#10;        L4[&quot;4. 浮动元素&quot;]&#10;        L5[&quot;5. 行内非定位元素&quot;]&#10;        L6[&quot;6. z-index: 0 / auto 的定位元素&quot;]&#10;        L7[&quot;7. z-index &gt; 0 的定位元素&quot;]&#10;        L1 --&gt; L2 --&gt; L3 --&gt; L4 --&gt; L5 --&gt; L6 --&gt; L7&#10;    end\">flowchart TB\n    subgraph \"层叠顺序(从后到前)\"\n        direction TB\n        L1[\"1. 背景和边框(层叠上下文创建者)\"]\n        L2[\"2. z-index &lt; 0 的定位元素\"]\n        L3[\"3. 块级非定位元素\"]\n        L4[\"4. 浮动元素\"]\n        L5[\"5. 行内非定位元素\"]\n        L6[\"6. z-index: 0 / auto 的定位元素\"]\n        L7[\"7. z-index &gt; 0 的定位元素\"]\n        L1 --&gt; L2 --&gt; L3 --&gt; L4 --&gt; L5 --&gt; L6 --&gt; L7\n    end</pre><hr>\n<h2 id=\"z-index-管理策略\">z-index 管理策略</h2><p>大型项目中 z-index 容易失控。推荐使用 CSS 变量建立统一的层级体系：</p>\n<div class=\"code-block-wrapper\" data-lang=\"css\" data-code=\":root {&#10;  --z-dropdown: 100;&#10;  --z-sticky: 200;&#10;  --z-overlay: 300;&#10;  --z-modal: 400;&#10;  --z-toast: 500;&#10;  --z-tooltip: 600;&#10;}&#10;&#10;.dropdown-menu {&#10;  z-index: var(--z-dropdown);&#10;}&#10;&#10;.sticky-header {&#10;  z-index: var(--z-sticky);&#10;}&#10;&#10;.modal-overlay {&#10;  z-index: var(--z-overlay);&#10;}&#10;&#10;.modal {&#10;  z-index: var(--z-modal);&#10;}&#10;&#10;.toast {&#10;  z-index: var(--z-toast);&#10;}&#10;&#10;.tooltip {&#10;  z-index: var(--z-tooltip);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">:root</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --z-dropdown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span clas