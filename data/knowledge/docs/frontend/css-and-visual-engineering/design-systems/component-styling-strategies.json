名切换）</td>\n</tr>\n<tr>\n<td>包体积</td>\n<td>最小</td>\n<td>+12kB</td>\n<td>最小</td>\n<td>取决于 purge</td>\n</tr>\n<tr>\n<td>SSR 支持</td>\n<td>原生</td>\n<td>需配置</td>\n<td>原生</td>\n<td>原生</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>低</td>\n<td>低</td>\n<td>中</td>\n<td>低</td>\n</tr>\n<tr>\n<td>共存能力</td>\n<td>容易</td>\n<td>容易</td>\n<td>需工具链</td>\n<td>容易</td>\n</tr>\n<tr>\n<td>主题系统</td>\n<td>CSS 变量</td>\n<td>ThemeProvider</td>\n<td>createTheme</td>\n<td>config</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    Q1{&quot;需要强动态样式?&quot;} --&gt;|是| SC[&quot;styled-components&quot;]&#10;    Q1 --&gt;|否| Q2{&quot;需要类型安全?&quot;}&#10;    Q2 --&gt;|是| VE[&quot;Vanilla Extract&quot;]&#10;    Q2 --&gt;|否| Q3{&quot;偏好原子化?&quot;}&#10;    Q3 --&gt;|是| TW[&quot;Tailwind CSS&quot;]&#10;    Q3 --&gt;|否| CM[&quot;CSS Modules&quot;]\">flowchart TD\n    Q1{\"需要强动态样式?\"} --&gt;|是| SC[\"styled-components\"]\n    Q1 --&gt;|否| Q2{\"需要类型安全?\"}\n    Q2 --&gt;|是| VE[\"Vanilla Extract\"]\n    Q2 --&gt;|否| Q3{\"偏好原子化?\"}\n    Q3 --&gt;|是| TW[\"Tailwind CSS\"]\n    Q3 --&gt;|否| CM[\"CSS Modules\"]</pre><hr>\n<h2 id=\"混合策略\">混合策略</h2><p>实际项目中常常混合使用多种方案：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 使用 CSS Modules 做基础布局&#10;import layout from &#39;./Layout.module.css&#39;;&#10;&#10;// 使用 Tailwind 做工具类&#10;&lt;div className={`${layout.container} flex items-center gap-4`}&gt;&#10;&#10;// 使用 CSS 变量做主题&#10;&lt;div style={{ &#39;--card-bg&#39;: token.bgSubtle } as React.CSSProperties}&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用 CSS Modules 做基础布局</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> layout </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> './Layout.module.css'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用 Tailwind 做工具类</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">layout</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">container</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} flex items-center gap-4`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用 CSS 变量做主题</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div style</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'--card-bg'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: token.bgSubtle } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> React</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">CSSProperties</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 混合策略的关键是明确每种方案的职责边界——全局令牌用 CSS 变量，组件作用域用 CSS Modules 或 Vanilla Extract，快速原型用 Tailwind。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>CSS Modules</strong> 零开销、易迁移，适合不需要复杂动态样式的项目</li>\n<li><strong>styled-components</strong> 动态样式最强，但有运行时开销和 SSR 复杂性</li>\n<li><strong>Vanilla Extract</strong> 零运行时 + 完整类型安全，是类型安全偏好团队的首选</li>\n<li><strong>Tailwind</strong> 原子化思路，快速开发，详见专门章节</li>\n<li>选择方案时重点考量：运行时性能、类型安全、SSR 支持和团队熟悉度</li>\n<li>大型项目常采用<strong>混合策略</strong>，明确每种方案的职责边界</li>\n</ul>\n","headings":[{"level":1,"text":"组件样式策略","id":"组件样式策略"},{"level":2,"text":"问题背景","id":"问题背景"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"CSS Modules","id":"css-modules"},{"level":2,"text":"styled-components","id":"styled-components"},{"level":2,"text":"Vanilla Extract","id":"vanilla-extract"},{"level":2,"text":"四种方案对比","id":"四种方案对比"},{"level":2,"text":"混合策略","id":"混合策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"设计令牌","url":"/l-doc-books/h/frontend/css-and-visual-engineering/design-systems/design-tokens"},"next":{"title":"Tailwind 架构","url":"/l-doc-books/h/frontend/css-and-visual-engineering/design-systems/tailwind-architecture"}}