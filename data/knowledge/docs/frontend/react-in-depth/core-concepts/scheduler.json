;&#10;    }&#10;&#10;    advanceTimers(currentTime);&#10;    currentTask = peek(taskQueue);&#10;  }&#10;&#10;  return currentTask !== null;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> workLoop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">initialTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> initialTime;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  advanceTimers</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(currentTime);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> peek</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(taskQueue);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentTask.expirationTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> shouldYieldToHost</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> callback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTask.callback;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (callback </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      currentTask.callback </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> didUserCallbackTimeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTask.expirationTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTime;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> continuationCallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> callback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(didUserCallbackTimeout);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">typeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> continuationCallback </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'function'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        currentTask.callback </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> continuationCallback;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (currentTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> peek</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(taskQueue)) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        pop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(taskQueue);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      pop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(taskQueue);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    advanceTimers</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(currentTime);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    currentTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> peek</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(taskQueue);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[进入 workLoop] --&gt; B[advanceTimers: 迁移到期任务]&#10;    B --&gt; C[取出 taskQueue 顶部任务]&#10;    C --&gt; D{任务是否存在?}&#10;    D -- 否 --&gt; E[返回 false: 无更多工作]&#10;    D -- 是 --&gt; F{任务未过期 且 应让出?}&#10;    F -- 是 --&gt; G[返回 true: 还有工作]&#10;    F -- 否 --&gt; H[执行任务回调]&#10;    H --&gt; I{回调返回继续函数?}&#10;    I -- 是 --&gt; J[更新任务回调, 返回 true]&#10;    I -- 否 --&gt; K[从队列移除任务]&#10;    K --&gt; B\">flowchart TD\n    A[进入 workLoop] --&gt; B[advanceTimers: 迁移到期任务]\n    B --&gt; C[取出 taskQueue 顶部任务]\n    C --&gt; D{任务是否存在?}\n    D -- 否 --&gt; E[返回 false: 无更多工作]\n    D -- 是 --&gt; F{任务未过期 且 应让出?}\n    F -- 是 --&gt; G[返回 true: 还有工作]\n    F -- 否 --&gt; H[执行任务回调]\n    H --&gt; I{回调返回继续函数?}\n    I -- 是 --&gt; J[更新任务回调, 返回 true]\n    I -- 否 --&gt; K[从队列移除任务]\n    K --&gt; B</pre><blockquote>\n<p><strong>提示：</strong> 当任务回调返回一个函数时（continuation），说明任务尚未完成，Scheduler 会在下一个时间切片继续执行。这正是 React Render 阶段被中断后能够恢复的原因。</p>\n</blockquote>\n<hr>\n<h2 id=\"scheduler-与浏览器的协作\">Scheduler 与浏览器的协作</h2><p>整个调度过程可以看作 Scheduler 和浏览器事件循环的协作：</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant User as 用户&#10;    participant Browser as 浏览器&#10;    participant Scheduler as Scheduler&#10;    participant React as React Reconciler&#10;&#10;    User-&gt;&gt;Browser: 点击按钮&#10;    Browser-&gt;&gt;React: 触发事件回调&#10;    React-&gt;&gt;Scheduler: scheduleCallback(NormalPriority, renderTask)&#10;    Scheduler-&gt;&gt;Scheduler: 插入 taskQueue&#10;    Scheduler-&gt;&gt;Browser: port.postMessage(null)&#10;    Browser-&gt;&gt;Browser: 处理当前宏任务&#10;    Browser-&gt;&gt;Browser: 微任务队列清空&#10;    Browser-&gt;&gt;Browser: Layout &amp; Paint&#10;    Browser-&gt;&gt;Scheduler: MessageChannel onmessage&#10;    Scheduler-&gt;&gt;React: 执行 renderTask(5ms 切片)&#10;    React--&gt;&gt;Scheduler: 返回 continuation&#10;    Scheduler-&gt;&gt;Browser: port.postMessage(null)&#10;    Browser-&gt;&gt;Browser: Layout &amp; Paint&#10;    Browser-&gt;&gt;Scheduler: 继续执行\">sequenceDiagram\n    participant User as 用户\n    participant Browser as 浏览器\n    participant Scheduler as Scheduler\n    participant React as React Reconciler\n\n    User-&gt;&gt;Browser: 点击按钮\n    Browser-&gt;&gt;React: 触发事件回调\n    React-&gt;&gt;Scheduler: scheduleCallback(NormalPriority, renderTask)\n    Scheduler-&gt;&gt;Scheduler: 插入 taskQueue\n    Scheduler-&gt;&gt;Browser: port.postMessage(null)\n    Browser-&gt;&gt;Browser: 处理当前宏任务\n    Browser-&gt;&gt;Browser: 微任务队列清空\n    Browser-&gt;&gt;Browser: Layout &amp; Paint\n    Browser-&gt;&gt;Scheduler: MessageChannel onmessage\n    Scheduler-&gt;&gt;React: 执行 renderTask(5ms 切片)\n    React--&gt;&gt;Scheduler: 返回 continuation\n    Scheduler-&gt;&gt;Browser: port.postMessage(null)\n    Browser-&gt;&gt;Browser: Layout &amp; Paint\n    Browser-&gt;&gt;Scheduler: 继续执行</pre><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>Scheduler</strong> 是 React 的独立调度包，负责任务的优先级排序和时间切片执行</li>\n<li>5 个优先级级别通过超时时间控制任务的紧迫程度，过期任务会被强制执行以避免饥饿</li>\n<li>使用两个<strong>最小堆</strong>队列分别管理延迟任务和就绪任务</li>\n<li>选择 <strong>MessageChannel</strong> 而非 <code>setTimeout</code> 或 <code>rAF</code>，因为它没有最小延迟且在宏任务中执行</li>\n<li>任务回调可以返回 continuation 函数，使得被中断的工作能够在下一个时间切片恢复</li>\n</ul>\n","headings":[{"level":1,"text":"调度器","id":"调度器"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Scheduler 的角色","id":"scheduler-的角色"},{"level":2,"text":"Task Priority 任务优先级","id":"task-priority-任务优先级"},{"level":2,"text":"任务队列实现","id":"任务队列实现"},{"level":2,"text":"MessageChannel 与宿主回调","id":"messagechannel-与宿主回调"},{"level":3,"text":"为什么选择 MessageChannel","id":"为什么选择-messagechannel"},{"level":2,"text":"Work Loop 调度流程","id":"work-loop-调度流程"},{"level":2,"text":"Scheduler 与浏览器的协作","id":"scheduler-与浏览器的协作"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"并发模式","url":"/l-doc-books/h/frontend/react-in-depth/core-concepts/concurrent-mode"},"next":{"title":"Hooks 内部机制","url":"/l-doc-books/h/frontend/react-in-depth/hooks-mastery/hooks-internals"}}