pan style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      failureThreshold: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.01</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      failureThresholdType: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'percent'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config;</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    STORY[Storybook Stories] --&gt; RENDER[渲染每个 Story]&#10;    RENDER --&gt; SCREENSHOT[截图]&#10;    SCREENSHOT --&gt; COMPARE[对比基准截图]&#10;    COMPARE --&gt;|一致| PASS[✅ 通过]&#10;    COMPARE --&gt;|不一致| DIFF[生成 Diff 图片]&#10;    DIFF --&gt; REVIEW[人工审查]&#10;    REVIEW --&gt;|确认变更| UPDATE[更新基准截图]&#10;    REVIEW --&gt;|发现问题| FIX[修复代码]\">flowchart LR\n    STORY[Storybook Stories] --&gt; RENDER[渲染每个 Story]\n    RENDER --&gt; SCREENSHOT[截图]\n    SCREENSHOT --&gt; COMPARE[对比基准截图]\n    COMPARE --&gt;|一致| PASS[✅ 通过]\n    COMPARE --&gt;|不一致| DIFF[生成 Diff 图片]\n    DIFF --&gt; REVIEW[人工审查]\n    REVIEW --&gt;|确认变更| UPDATE[更新基准截图]\n    REVIEW --&gt;|发现问题| FIX[修复代码]</pre><hr>\n<h2 id=\"chromatic-云端视觉测试\">Chromatic 云端视觉测试</h2><p>Chromatic 是 Storybook 官方团队开发的云端视觉测试服务，提供跨浏览器截图、自动基线管理和团队协作审查功能。</p>\n<h3 id=\"集成配置\">集成配置</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"name: Chromatic&#10;on:&#10;  push:&#10;    branches: [main]&#10;  pull_request:&#10;    branches: [main]&#10;&#10;jobs:&#10;  chromatic:&#10;    runs-on: ubuntu-latest&#10;    steps:&#10;      - uses: actions/checkout@v4&#10;        with:&#10;          fetch-depth: 0&#10;      - uses: pnpm/action-setup@v4&#10;      - uses: actions/setup-node@v4&#10;        with:&#10;          node-version: 20&#10;          cache: &#39;pnpm&#39;&#10;      - run: pnpm install --frozen-lockfile&#10;      - uses: chromaui/action@latest&#10;        with:&#10;          projectToken: ${{ secrets.CHROMATIC_PROJECT_TOKEN }}&#10;          buildScriptName: &#39;build-storybook&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Chromatic</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    branches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  pull_request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    branches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  chromatic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/checkout@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          fetch-depth</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm/action-setup@v4</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/setup-node@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          node-version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          cache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'pnpm'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm install --frozen-lockfile</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">chromaui/action@latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          projectToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ secrets.CHROMATIC_PROJECT_TOKEN }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          buildScriptName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'build-storybook'</span></span></code></pre></div><h3 id=\"工作流\">工作流</h3><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant DEV as 开发者&#10;    participant GH as GitHub&#10;    participant CH as Chromatic&#10;&#10;    DEV-&gt;&gt;GH: 推送代码 / 创建 PR&#10;    GH-&gt;&gt;CH: 触发 Chromatic 构建&#10;    CH-&gt;&gt;CH: 构建 Storybook&#10;    CH-&gt;&gt;CH: 截取所有 Story 截图&#10;    CH-&gt;&gt;CH: 与基线对比&#10;    alt 无变化&#10;        CH-&gt;&gt;GH: ✅ 检查通过&#10;    else 发现差异&#10;        CH-&gt;&gt;GH: ⚠️ 需要审查&#10;        CH-&gt;&gt;DEV: 通知 Review&#10;        DEV-&gt;&gt;CH: 审查 Diff&#10;        alt 确认变更&#10;            DEV-&gt;&gt;CH: 接受新基线&#10;            CH-&gt;&gt;GH: ✅ 检查通过&#10;        else 发现问题&#10;            DEV-&gt;&gt;GH: 修复代码&#10;        end&#10;    end\">sequenceDiagram\n    participant DEV as 开发者\n    participant GH as GitHub\n    participant CH as Chromatic\n\n    DEV-&gt;&gt;GH: 推送代码 / 创建 PR\n    GH-&gt;&gt;CH: 触发 Chromatic 构建\n    CH-&gt;&gt;CH: 构建 Storybook\n    CH-&gt;&gt;CH: 截取所有 Story 截图\n    CH-&gt;&gt;CH: 与基线对比\n    alt 无变化\n        CH-&gt;&gt;GH: ✅ 检查通过\n    else 发现差异\n        CH-&gt;&gt;GH: ⚠️ 需要审查\n        CH-&gt;&gt;DEV: 通知 Review\n        DEV-&gt;&gt;CH: 审查 Diff\n        alt 确认变更\n            DEV-&gt;&gt;CH: 接受新基线\n            CH-&gt;&gt;GH: ✅ 检查通过\n        else 发现问题\n            DEV-&gt;&gt;GH: 修复代码\n        end\n    end</pre><hr>\n<h2 id=\"视觉测试的最佳实践\">视觉测试的最佳实践</h2><h3 id=\"减少快照噪音\">减少快照噪音</h3><p>视觉测试中最大的挑战是&quot;假阳性&quot;——非代码变更导致的截图差异（如动画、随机数据、时间戳等）。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 禁用动画&#10;await page.emulateMedia({ reducedMotion: &#39;reduce&#39; });&#10;&#10;// 固定时间&#10;await page.clock.setFixedTime(new Date(&#39;2026-03-30T12:00:00Z&#39;));&#10;&#10;// 隐藏动态元素&#10;await page.evaluate(() =&gt; {&#10;  document.querySelectorAll(&quot;[data-testid=&#39;avatar&#39;]&quot;).forEach((el) =&gt; {&#10;    (el as HTMLElement).style.visibility = &#39;hidden&#39;;&#10;  });&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 禁用动画</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">emulateMedia</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ reducedMotion: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'reduce'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 固定时间</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.clock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setFixedTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2026-03-30T12:00:00Z'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 隐藏动态元素</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">evaluate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  document.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">querySelectorAll</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"[data-testid='avatar']\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">forEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">el</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    (el </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HTMLElement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).style.visibility </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'hidden'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"分层策略\">分层策略</h3><table>\n<thead>\n<tr>\n<th>层级</th>\n<th>工具</th>\n<th>范围</th>\n<th>频率</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>组件级</td>\n<td>Storybook + 截图</td>\n<td>单个组件各状态</td>\n<td>每次 PR</td>\n</tr>\n<tr>\n<td>页面级</td>\n<td>Playwright 截图</td>\n<td>关键页面完整渲染</td>\n<td>每次 PR</td>\n</tr>\n<tr>\n<td>跨浏览器</td>\n<td>Chromatic</td>\n<td>所有 Story 多浏览器</td>\n<td>每次 PR</td>\n</tr>\n<tr>\n<td>全站回归</td>\n<td>Playwright 全站</td>\n<td>所有页面所有断点</td>\n<td>发布前</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>视觉回归测试弥补功能测试无法覆盖的 UI 外观验证。</li>\n<li>Playwright 内置截图对比功能，适合页面级和组件级视觉测试。</li>\n<li>Storybook 为组件提供隔离的渲染环境，是视觉测试的理想载体。</li>\n<li>Chromatic 提供云端跨浏览器视觉测试和团队协作审查能力。</li>\n<li>减少快照噪音（禁用动画、固定数据、隐藏动态元素）是视觉测试成功的关键。</li>\n</ul>\n","headings":[{"level":1,"text":"视觉回归测试","id":"视觉回归测试"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基于 Playwright 的视觉测试","id":"基于-playwright-的视觉测试"},{"level":3,"text":"配置","id":"配置"},{"level":3,"text":"页面级截图测试","id":"页面级截图测试"},{"level":3,"text":"组件级截图测试","id":"组件级截图测试"},{"level":2,"text":"Storybook 与视觉测试","id":"storybook-与视觉测试"},{"level":3,"text":"Storybook Test Runner","id":"storybook-test-runner"},{"level":2,"text":"Chromatic 云端视觉测试","id":"chromatic-云端视觉测试"},{"level":3,"text":"集成配置","id":"集成配置"},{"level":3,"text":"工作流","id":"工作流"},{"level":2,"text":"视觉测试的最佳实践","id":"视觉测试的最佳实践"},{"level":3,"text":"减少快照噪音","id":"减少快照噪音"},{"level":3,"text":"分层策略","id":"分层策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"集成测试与端到端测试","url":"/l-doc-books/h/frontend/frontend-engineering/testing-strategy/integration-and-e2e-testing"},"next":{"title":"Design System 基础","url":"/l-doc-books/h/frontend/frontend-engineering/component-engineering/design-system-foundations"}}