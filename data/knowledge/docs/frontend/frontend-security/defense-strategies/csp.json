97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">script key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{src} src</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{src} nonce</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{nonce} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ))}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">body</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">html</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"常见陷阱与解决方案\">常见陷阱与解决方案</h2><p>CSP 部署中经常遇到的问题及解决方案：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 问题1: 第三方脚本（Google Analytics, Sentry 等）&#10;// 解决: 使用 strict-dynamic + nonce&#10;const thirdPartyFriendlyCsp = [&#10;  &quot;default-src &#39;self&#39;&quot;,&#10;  &quot;script-src &#39;nonce-${nonce}&#39; &#39;strict-dynamic&#39; https:&quot;,&#10;  &quot;style-src &#39;self&#39; &#39;unsafe-inline&#39;&quot;, // 许多库需要内联样式&#10;  `connect-src &#39;self&#39; https://www.google-analytics.com https://sentry.io`,&#10;].join(&#39;; &#39;);&#10;&#10;// 问题2: 内联事件处理器（onclick 等）被 CSP 阻止&#10;// 解决: 使用 addEventListener 替代内联事件&#10;// 错误: &lt;button onclick=&quot;handleClick()&quot;&gt;&#10;// 正确: document.querySelector(&#39;button&#39;).addEventListener(&#39;click&#39;, handleClick)&#10;&#10;// 问题3: eval() 和 new Function() 被阻止&#10;// 解决: 重构代码避免动态代码执行&#10;// 如果确实需要（如某些模板引擎），添加 &#39;unsafe-eval&#39;（不推荐）&#10;&#10;// 问题4: CSS-in-JS 库需要 unsafe-inline&#10;// 解决: 使用支持 nonce 的 CSS-in-JS 库&#10;// Emotion: &lt;CacheProvider value={createCache({ key: &#39;css&#39;, nonce })} /&gt;&#10;// styled-components: &lt;StyleSheetManager nonce={nonce} /&gt;&#10;&#10;// 问题5: Web Worker 和 Service Worker&#10;const workerCsp = [&#10;  &quot;default-src &#39;self&#39;&quot;,&#10;  &quot;worker-src &#39;self&#39; blob:&quot;, // 允许 blob URL 创建 Worker&#10;  &quot;child-src &#39;self&#39; blob:&quot;,&#10;].join(&#39;; &#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 问题1: 第三方脚本（Google Analytics, Sentry 等）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 解决: 使用 strict-dynamic + nonce</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> thirdPartyFriendlyCsp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"default-src 'self'\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"script-src 'nonce-${nonce}' 'strict-dynamic' https:\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"style-src 'self' 'unsafe-inline'\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 许多库需要内联样式</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  `connect-src 'self' https://www.google-analytics.com https://sentry.io`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'; '</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 问题2: 内联事件处理器（onclick 等）被 CSP 阻止</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 解决: 使用 addEventListener 替代内联事件</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 错误: &#x3C;button onclick=\"handleClick()\"></span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正确: document.querySelector('button').addEventListener('click', handleClick)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 问题3: eval() 和 new Function() 被阻止</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 解决: 重构代码避免动态代码执行</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 如果确实需要（如某些模板引擎），添加 'unsafe-eval'（不推荐）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 问题4: CSS-in-JS 库需要 unsafe-inline</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 解决: 使用支持 nonce 的 CSS-in-JS 库</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Emotion: &#x3C;CacheProvider value={createCache({ key: 'css', nonce })} /></span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// styled-components: &#x3C;StyleSheetManager nonce={nonce} /></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 问题5: Web Worker 和 Service Worker</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> workerCsp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"default-src 'self'\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"worker-src 'self' blob:\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 允许 blob URL 创建 Worker</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  \"child-src 'self' blob:\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'; '</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"渐进式部署策略\">渐进式部署策略</h2><p>在现有项目中部署 CSP 应采用渐进式策略：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 阶段1: 仅报告模式（不阻止，只收集违规）&#10;const phase1 = {&#10;  header: &#39;Content-Security-Policy-Report-Only&#39;,&#10;  policy: &quot;default-src &#39;self&#39;; script-src &#39;self&#39; &#39;unsafe-inline&#39; &#39;unsafe-eval&#39;; report-uri /csp-report&quot;,&#10;};&#10;&#10;// 阶段2: 收紧策略，移除 unsafe-eval&#10;const phase2 = {&#10;  header: &#39;Content-Security-Policy-Report-Only&#39;,&#10;  policy: &quot;default-src &#39;self&#39;; script-src &#39;self&#39; &#39;unsafe-inline&#39;; report-uri /csp-report&quot;,&#10;};&#10;&#10;// 阶段3: 引入 nonce，移除 unsafe-inline&#10;const phase3 = {&#10;  header: &#39;Content-Security-Policy-Report-Only&#39;,&#10;  policy: &quot;default-src &#39;self&#39;; script-src &#39;self&#39; &#39;nonce-xxx&#39; &#39;strict-dynamic&#39;; report-uri /csp-report&quot;,&#10;};&#10;&#10;// 阶段4: 切换到强制模式&#10;const phase4 = {&#10;  header: &#39;Content-Security-Policy&#39;,&#10;  policy: &quot;default-src &#39;self&#39;; script-src &#39;self&#39; &#39;nonce-xxx&#39; &#39;strict-dynamic&#39;; report-uri /csp-report&quot;,&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阶段1: 仅报告模式（不阻止，只收集违规）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> phase1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  header: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Content-Security-Policy-Report-Only'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  policy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; report-uri /csp-report\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阶段2: 收紧策略，移除 unsafe-eval</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> phase2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  header: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Content-Security-Policy-Report-Only'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  policy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"default-src 'self'; script-src 'self' 'unsafe-inline'; report-uri /csp-report\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阶段3: 引入 nonce，移除 unsafe-inline</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> phase3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  header: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Content-Security-Policy-Report-Only'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  policy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"default-src 'self'; script-src 'self' 'nonce-xxx' 'strict-dynamic'; report-uri /csp-report\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阶段4: 切换到强制模式</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> phase4</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  header: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Content-Security-Policy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  policy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"default-src 'self'; script-src 'self' 'nonce-xxx' 'strict-dynamic'; report-uri /csp-report\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>CSP 是浏览器级别的资源加载白名单机制，是 XSS 防御的最后一道防线</li>\n<li><code>script-src</code> 是最关键的指令，推荐使用 nonce + strict-dynamic 方案</li>\n<li>避免 <code>unsafe-inline</code> 和 <code>unsafe-eval</code>——它们极大削弱 CSP 的防护能力</li>\n<li>渐进式部署：Report-Only → 收紧策略 → 强制模式，通过 CSP 报告逐步修复违规</li>\n<li><code>strict-dynamic</code> 实现信任传递——被信任脚本加载的子脚本自动获得信任</li>\n<li>第三方脚本（分析、监控等）需要在 CSP 策略中明确允许其来源</li>\n<li>CSP 报告端点用于收集线上违规数据，是持续优化策略的重要数据源</li>\n<li>Nonce 每次请求都需要重新生成，确保不可预测性</li>\n</ul>\n","headings":[{"level":1,"text":"内容安全策略 CSP","id":"内容安全策略-csp"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"策略配置实践","id":"策略配置实践"},{"level":2,"text":"Nonce 与 Hash 机制","id":"nonce-与-hash-机制"},{"level":2,"text":"常见陷阱与解决方案","id":"常见陷阱与解决方案"},{"level":2,"text":"渐进式部署策略","id":"渐进式部署策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"注入攻击","url":"/l-doc-books/h/frontend/frontend-security/attack-vectors/injection-attacks"},"next":{"title":"输入验证与净化","url":"/l-doc-books/h/frontend/frontend-security/defense-strategies/input-validation"}}