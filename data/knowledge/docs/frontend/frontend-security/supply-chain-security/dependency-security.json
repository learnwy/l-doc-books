--shiki-dark:#79B8FF\"> checks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    weeklyDownloads: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    lastPublish: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    maintainerCount: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    knownVulnerabilities: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    licenseCompatible: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    noPostInstallScripts: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    typescriptSupport: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    bundleSize: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { name: packageName, checks };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>前端项目的依赖链构成了庞大的供应链攻击面，需要系统性的安全管理</li>\n<li><code>npm audit</code> / Snyk 是漏洞扫描的基础工具，应集成到 CI 流程中</li>\n<li>lockfile 确保依赖一致性，CI 中始终使用 <code>--frozen-lockfile</code> 安装</li>\n<li>版本策略：核心框架精确版本，重要库 tilde，一般依赖 caret</li>\n<li>Renovate 或 Dependabot 实现自动化依赖更新，安全补丁应即时合并</li>\n<li>新增依赖前应进行安全审查：下载量、维护活跃度、已知漏洞、许可证兼容性</li>\n<li><code>pnpm.overrides</code> 可以强制修复传递依赖中的已知漏洞</li>\n<li>使用 <code>@scope</code> 前缀防止依赖混淆攻击</li>\n</ul>\n","headings":[{"level":1,"text":"依赖安全","id":"依赖安全"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"漏洞扫描与管理","id":"漏洞扫描与管理"},{"level":2,"text":"依赖锁定与版本策略","id":"依赖锁定与版本策略"},{"level":2,"text":"自动化依赖更新","id":"自动化依赖更新"},{"level":2,"text":"依赖审查清单","id":"依赖审查清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"认证安全","url":"/l-doc-books/h/frontend/frontend-security/defense-strategies/authentication-security"},"next":{"title":"npm 安全","url":"/l-doc-books/h/frontend/frontend-security/supply-chain-security/npm-security"}}