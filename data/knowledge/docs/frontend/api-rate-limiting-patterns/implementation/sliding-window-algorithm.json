:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> now </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.bucketMs;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      pipeline.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getBucketKey</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, ts));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> counts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pipeline.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> total</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> counts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(c) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (total </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.limit) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> redis.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">incr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getBucketKey</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, now));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"精确度对比实验\">精确度对比实验</h2><p>以下是在 60s 窗口、100 req/min 限制下，不同实现在边界场景的表现：</p>\n<table>\n<thead>\n<tr>\n<th>时刻</th>\n<th>精确实现</th>\n<th>近似计数器（误差）</th>\n<th>固定窗口（无优化）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>t=59s, 发送100请求</td>\n<td>通过 100 个</td>\n<td>通过 100 个（0% 误差）</td>\n<td>通过 100 个</td>\n</tr>\n<tr>\n<td>t=61s, 再发100请求</td>\n<td>拒绝（59-61s内有100个）</td>\n<td>拒绝（估算97个，&lt;100，允许3个）</td>\n<td>通过 100 个（边界突刺！）</td>\n</tr>\n</tbody></table>\n<p>近似计数器在最坏情况下允许约 5% 的额外请求，但消除了固定窗口 100% 的边界突刺问题。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>精确滑动窗口用 ZSET 存时间戳，保证无误差但内存随请求数增长</li>\n<li>近似滑动窗口用双计数器加权，O(1) 空间，误差约 5%，是 Nginx/Redis 默认选择</li>\n<li>时间戳压缩（秒级聚合）和分桶策略可将精确实现的内存降低 10-100 倍</li>\n<li>安全敏感场景（如登录防爆破）用精确实现；高并发场景（如 API 通用限流）用近似实现</li>\n</ul>\n<blockquote>\n<p>兄弟文档：<a href=\"distributed-rate-limiting\">分布式限流</a> 讲解多实例场景下如何保证计数器的一致性；<a href=\"../fundamentals/token-bucket-leaky-bucket\">令牌桶与漏桶</a> 的 Redis Lua 实现与本章思路互补。</p>\n</blockquote>\n","headings":[{"level":1,"text":"滑动窗口算法：精确限流的完整实现","id":"滑动窗口算法-精确限流的完整实现"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"两种实现策略","id":"两种实现策略"},{"level":2,"text":"精确实现：基于有序集合","id":"精确实现-基于有序集合"},{"level":3,"text":"核心思路","id":"核心思路"},{"level":3,"text":"Node.js 封装","id":"node-js-封装"},{"level":2,"text":"近似实现：双计数器加权法","id":"近似实现-双计数器加权法"},{"level":3,"text":"核心思路","id":"核心思路"},{"level":3,"text":"Redis 实现","id":"redis-实现"},{"level":2,"text":"内存优化：时间戳压缩","id":"内存优化-时间戳压缩"},{"level":3,"text":"降精度存储","id":"降精度存储"},{"level":3,"text":"分桶策略","id":"分桶策略"},{"level":2,"text":"精确度对比实验","id":"精确度对比实验"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"令牌桶与漏桶：两种经典算法的深度实现","url":"/l-doc-books/h/frontend/api-rate-limiting-patterns/fundamentals/token-bucket-leaky-bucket"},"next":{"title":"分布式限流：多实例环境下的一致性挑战","url":"/l-doc-books/h/frontend/api-rate-limiting-patterns/implementation/distributed-rate-limiting"}}