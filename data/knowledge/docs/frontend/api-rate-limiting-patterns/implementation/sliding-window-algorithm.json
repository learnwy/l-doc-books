le=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> now</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> reqId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">now</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Math</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toString</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">36</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.redis.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">eval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(script, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      keys: [key],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      arguments: [</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.windowMs), </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.limit), </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(now), reqId],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      allowed: result[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      retryAfterMs: result[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 查询当前使用量（精确）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      remaining: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.limit </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.redis.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">zCard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"近似实现-双计数器加权法\">近似实现：双计数器加权法</h2><h3 id=\"核心思路\">核心思路</h3><p>维护两个相邻的固定窗口计数器，通过当前时刻在当前窗口中的位置，估算滑动窗口内的请求数：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"estimated = prev_count × (1 - progress) + curr_count\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>estimated = prev_count × (1 - progress) + curr_count</span></span></code></pre></div><p>其中 <code>progress = (now - curr_window_start) / window_duration</code>。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 上一窗口 prev&#10;        P[count=80]&#10;    end&#10;    subgraph 当前窗口 curr&#10;        C[count=30]&#10;    end&#10;    T[当前时刻&lt;br/&gt;progress=0.4]&#10;    T -- &quot;80 × 0.6 = 48&quot; --&gt; P&#10;    T -- &quot;+ 30&quot; --&gt; C&#10;    E[估算值: 78]&#10;    P --&gt; E&#10;    C --&gt; E\">graph LR\n    subgraph 上一窗口 prev\n        P[count=80]\n    end\n    subgraph 当前窗口 curr\n        C[count=30]\n    end\n    T[当前时刻&lt;br/&gt;progress=0.4]\n    T -- \"80 × 0.6 = 48\" --&gt; P\n    T -- \"+ 30\" --&gt; C\n    E[估算值: 78]\n    P --&gt; E\n    C --&gt; E</pre><h3 id=\"redis-实现\">Redis 实现</h3><div class=\"code-block-wrapper\" data-lang=\"lua\" data-code=\"-- sliding_window_counter.lua&#10;local key = KEYS[1]&#10;local window_ms = tonumber(ARGV[1])&#10;local limit = tonumber(ARGV[2])&#10;local now = tonumber(ARGV[3])&#10;&#10;local curr_window = math.floor(now / window_ms) * window_ms&#10;local prev_window = curr_window - window_ms&#10;local progress = (now - curr_window) / window_ms&#10;&#10;local curr_key = key .. &#39;:&#39; .. curr_window&#10;local prev_key = key .. &#39;:&#39; .. prev_window&#10;&#10;local curr_count = tonumber(redis.call(&#39;GET&#39;, curr_key)) or 0&#10;local prev_count = tonumber(redis.call(&#39;GET&#39;, prev_key)) or 0&#10;&#10;local estimated = prev_count * (1 - progress) + curr_count&#10;&#10;if estimated &gt;= limit then&#10;  return {0, math.ceil((1 - progress) * window_ms)}&#10;end&#10;&#10;redis.call(&#39;INCR&#39;, curr_key)&#10;redis.call(&#39;PEXPIRE&#39;, curr_key, window_ms * 2)&#10;return {1, 0}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>-- sliding_window_counter.lua</span></span>\n<span class=\"line\"><span>local key = KEYS[1]</span></span>\n<span class=\"line\"><span>local window_ms = tonumber(ARGV[1])</span></span>\n<span class=\"line\"><span>local limit = tonumber(ARGV[2])</span></span>\n<span class=\"line\"><span>local now = tonumber(ARGV[3])</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>local curr_window = math.floor(now / window_ms) * window_ms</span></span>\n<span class=\"line\"><span>local prev_window = curr_window - window_ms</span></span>\n<span class=\"line\"><span>local progress = (now - curr_window) / window_ms</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>local curr_key = key .. ':' .. curr_window</span></span>\n<span class=\"line\"><span>local prev_key = key .. ':' .. prev_window</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>local curr_count = tonumber(redis.call('GET', curr_key)) or 0</span></span>\n<span class=\"line\"><span>local prev_count = tonumber(redis.call('GET', prev_key)) or 0</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>local estimated = prev_count * (1 - progress) + curr_count</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>if estimated >= limit then</span></span>\n<span class=\"line\"><span>  return {0, math.ceil((1 - progress) * window_ms)}</span></span>\n<span class=\"line\"><span>end</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>redis.call('INCR', curr_key)</span></span>\n<span class=\"line\"><span>redis.call('PEXPIRE', curr_key, window_ms * 2)</span></span>\n<span class=\"line\"><span>return {1, 0}</span></span></code></pre></div><h2 id=\"内存优化-时间戳压缩\">内存优化：时间戳压缩</h2><p>精确实现的内存开销与请求数成正比。当 limit=10000 时，每个用户最多需要存储 10000 条时间戳。两种优化策略：</p>\n<h3 id=\"降精度存储\">降精度存储</h3><p>将毫秒时间戳降到秒级，相同秒内的请求用计数器合并：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 不存储 1720080001234，而是存储 &quot;1720080001&quot; -&gt; count&#10;async function addRequest(key, now) {&#10;  const secondKey = Math.floor(now / 1000);&#10;  await redis&#10;    .multi()&#10;    .hIncrBy(key, String(secondKey), 1)&#10;    .expire(key, windowSeconds * 2)&#10;    .exec();&#10;}&#10;&#10;async function countInWindow(key, now, windowSeconds) {&#10;  const startSecond = Math.floor(now / 1000) - windowSeconds;&#10;  const counts = await redis.hGetAll(key);&#10;  return Object.entries(counts)&#10;    .filter(([ts]) =&gt; Number(ts) &gt; startSecond)&#10;    .reduce((sum, [, count]) =&gt; sum + Number(count), 0);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 不存储 1720080001234，而是存储 \"1720080001\" -> count</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> addRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> secondKey</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">floor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(now </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> redis</span></span>\n<span class=\"line\"><spa