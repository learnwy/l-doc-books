>内容寻址去重</h2><p>对于文件上传等内容驱动的操作，用内容哈希作为天然的去重键：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"async function uploadFile(file) {&#10;  // 计算文件哈希（内容不变，哈希不变）&#10;  const buffer = await file.arrayBuffer();&#10;  const hashBuffer = await crypto.subtle.digest(&#39;SHA-256&#39;, buffer);&#10;  const hashHex = Array.from(new Uint8Array(hashBuffer))&#10;    .map((b) =&gt; b.toString(16).padStart(2, &#39;0&#39;))&#10;    .join(&#39;&#39;);&#10;&#10;  // 先检查文件是否已上传（内容寻址）&#10;  const existing = await fetch(`/api/files/${hashHex}`);&#10;  if (existing.ok) {&#10;    return existing.json(); // 直接返回已有文件信息&#10;  }&#10;&#10;  // 上传新文件，使用哈希作为幂等键&#10;  return fetch(&#39;/api/files&#39;, {&#10;    method: &#39;POST&#39;,&#10;    headers: { &#39;Idempotency-Key&#39;: hashHex },&#10;    body: file,&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> uploadFile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">file</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 计算文件哈希（内容不变，哈希不变）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> buffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> file.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">arrayBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hashBuffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> crypto.subtle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">digest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'SHA-256'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, buffer);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hashHex</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Array.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Uint8Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(hashBuffer))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toString</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">padStart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 先检查文件是否已上传（内容寻址）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> existing</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`/api/files/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hashHex</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (existing.ok) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> existing.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 直接返回已有文件信息</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 上传新文件，使用哈希作为幂等键</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/files'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'POST'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    headers: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Idempotency-Key'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: hashHex },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    body: file,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>幂等性是「重试安全」的基础：GET/PUT/DELETE 天然幂等，POST 需要通过幂等键模式实现</li>\n<li>客户端生成幂等键并在 Header 中携带，服务端缓存响应并在重复请求时直接返回</li>\n<li>前端防重复提交用状态机（idle → submitting → done），禁用按钮防止双击</li>\n<li>去重窗口根据业务场景设置：支付用 24h，实时操作用 30s</li>\n<li>内容寻址去重（哈希作为键）是文件上传等内容驱动操作的最自然方案</li>\n</ul>\n<blockquote>\n<p>兄弟文档：<a href=\"retry-backoff-patterns\">重试与退避模式</a> 讲解重试策略——去重是重试安全的前提；<a href=\"user-tier-quota\">用户分级配额</a> 中配额检查本身也需要幂等设计。</p>\n</blockquote>\n","headings":[{"level":1,"text":"请求去重：幂等设计与重复提交防护","id":"请求去重-幂等设计与重复提交防护"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"幂等性基础","id":"幂等性基础"},{"level":3,"text":"幂等的定义","id":"幂等的定义"},{"level":2,"text":"幂等键模式","id":"幂等键模式"},{"level":3,"text":"客户端生成幂等键","id":"客户端生成幂等键"},{"level":3,"text":"服务端去重实现","id":"服务端去重实现"},{"level":2,"text":"前端防重复提交","id":"前端防重复提交"},{"level":3,"text":"基于状态机的按钮防重","id":"基于状态机的按钮防重"},{"level":3,"text":"去抖动（Debounce）防止高频触发","id":"去抖动-debounce-防止高频触发"},{"level":2,"text":"去重窗口设计","id":"去重窗口设计"},{"level":2,"text":"内容寻址去重","id":"内容寻址去重"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"重试与退避模式：指数退避、抖动算法与重试预算","url":"/l-doc-books/h/frontend/api-rate-limiting-patterns/patterns/retry-backoff-patterns"},"next":{"title":"客户端限流策略：请求队列、节流与优先级调度","url":"/l-doc-books/h/frontend/api-rate-limiting-patterns/frontend/client-rate-limiting"}}