</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"button\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> onClick</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{() => </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">email</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      添加联系人</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>v8 的 Breaking Change：<code>field.id</code> 重命名为 <code>field.key</code>，<code>keyName</code> prop 被移除。此外 v8 支持扁平字段数组（<code>string[]</code> 而非 <code>{ value: string }[]</code>），简化了标签列表等场景。</p>\n<h2 id=\"性能优化模式\">性能优化模式</h2><h3 id=\"隔离重渲染\">隔离重渲染</h3><p><code>useWatch</code> 创建一个订阅——使用它的组件会在被监听字段变化时重渲染。关键原则：<strong>将 useWatch 下推到最小的子组件中</strong>。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 错误：在父组件中 useWatch 导致整个表单重渲染&#10;function Form() {&#10;  const email = useWatch({ name: &#39;email&#39;, control })&#10;  return &lt;&gt;{/* 50 个字段 */}&lt;/&gt;&#10;}&#10;&#10;// 正确：隔离到独立子组件&#10;function EmailPreview({ control }: { control: Control }) {&#10;  const email = useWatch({ name: &#39;email&#39;, control })&#10;  return &lt;span&gt;将发送至：{email}&lt;/span&gt;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 错误：在父组件中 useWatch 导致整个表单重渲染</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> email</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useWatch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'email'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, control })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;>{</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 50 个字段 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正确：隔离到独立子组件</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EmailPreview</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">control</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">control</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Control</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> email</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useWatch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'email'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, control })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">span</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>将发送至：{email}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">span</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"formprovider-与-useformcontext\">FormProvider 与 useFormContext</h3><p>深层嵌套组件访问 form 实例无需逐层 prop drilling：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"&lt;FormProvider {...form}&gt;&#10;  &lt;Step1Fields /&gt;&#10;  &lt;Step2Fields /&gt;&#10;  &lt;SubmitButton /&gt;&#10;&lt;/FormProvider&gt;&#10;&#10;function SubmitButton() {&#10;  const { formState: { isSubmitting } } = useFormContext()&#10;  return &lt;button disabled={isSubmitting}&gt;提交&lt;/button&gt;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">FormProvider {</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Step1Fields </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Step2Fields </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SubmitButton </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">FormProvider</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SubmitButton</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">formState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">isSubmitting</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useFormContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">button</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> disabled</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">={</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">isSubmitting</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}>提交</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>但 <code>useFormContext</code> 的每个消费者都会在 formState 变化时重渲染——应配合 <code>formState</code> 的 Proxy 特性（仅读取的属性才建立订阅）控制范围。</p>\n<h2 id=\"devtools-集成\">DevTools 集成</h2><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { DevTool } from &#39;@hookform/devtools&#39;&#10;&#10;function App() {&#10;  const form = useForm()&#10;  return (&#10;    &lt;&gt;&#10;      &lt;form&gt;{/* ... */}&lt;/form&gt;&#10;      &lt;DevTool control={form.control} /&gt;&#10;    &lt;/&gt;&#10;  )&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { DevTool } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@hookform/devtools'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> App</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">DevTool control</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{form.control} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>DevTools 面板可视化展示：所有字段的当前值、touched/dirty 状态、校验错误、重渲染次数。在 100+ 字段的复杂表单中，它是定位性能瓶颈的核心工具。</p>\n<h2 id=\"与-server-actions-集成\">与 Server Actions 集成</h2><p>RHF 的 <code>handleSubmit</code> 需要包装 Server Action：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const action = async (formData: FormData) =&gt; {&#10;  &#39;use server&#39;&#10;  const result = schema.safeParse(Object.fromEntries(formData))&#10;  if (!result.success) return { errors: result.error.flatten().fieldErrors }&#10;  await db.users.create(result.data)&#10;}&#10;&#10;function Form() {&#10;  const { handleSubmit, setError } = useForm()&#10;&#10;  async function onSubmit(data: FormValues) {&#10;    const result = await action(new FormData(/* ... */))&#10;    if (result?.errors) {&#10;      Object.entries(result.errors).forEach(([field, messages]) =&gt; {&#10;        setError(field as keyof FormValues, { message: messages[0] })&#10;      })&#10;    }&#10;  }&#10;&#10;  return &lt;form onSubmit={handleSubmit(onSubmit)}&gt;{/* ... */}&lt;/form&gt;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> action</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">formData</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FormData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'use server'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> schema.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">safeParse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fromEntries</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(formData))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result.success) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { errors: result.error.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatten</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().fieldErrors }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.users.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result.data)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">handleSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> onSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FormValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FormData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result?.errors) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">entries</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result.errors).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">forEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(([</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">field</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">messages</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        setError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(field </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> keyof</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FormValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { message: messages[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">form</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> onSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">={</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">handleSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">onSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)}>{</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>对于纯 Server-First 场景（无客户端校验需求），<a href=\"formik-final-form\">Formik 与 Final Form</a> 中介绍的 Conform 库可能是更自然的选择。</p>\n<h2 id=\"v7-v8-迁移清单\">v7 → v8 迁移清单</h2><table>\n<thead>\n<tr>\n<th>变更</th>\n<th>v7</th>\n<th>v8</th>\n<th>影响范围</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Field Array key</td>\n<td><code>field.id</code></td>\n<td><code>field.key</code></td>\n<td>所有 useFieldArray 使用处</td>\n</tr>\n<tr>\n<td>keyName prop</td>\n<td>可自定义</td>\n<td>移除</td>\n<td>useFieldArray 配置</td>\n</tr>\n<tr>\n<td>Watch 组件</td>\n<td><code>&lt;Watch names={[...]}/&gt;</code></td>\n<td><code>&lt;Watch name={[...]}/&gt;</code></td>\n<td>属性名变化</td>\n</tr>\n<tr>\n<td>watch 回调</td>\n<td><code>watch((v) =&gt; ...)</code></td>\n<td><code>subscribe(...)</code></td>\n<td>响应式监听</td>\n</tr>\n<tr>\n<td>setValue → fieldArray</td>\n<td>直接更新</td>\n<td>需用 <code>replace()</code></td>\n<td>批量设值逻辑</td>\n</tr>\n<tr>\n<td>React Compiler</td>\n<td>需手动配置</td>\n<td>原生兼容</td>\n<td>无需操作</td>\n</tr>\n<tr>\n<td>Input ref</td>\n<td>传 partial object</td>\n<td>传实际 ref</td>\n<td>register 内部行为</td>\n</tr>\n</tbody></table>\n<p>迁移建议：先锁定 v7 最新版（7.71.x），待 v8 正式发布后再升级。beta 阶段适合新项目试用。<a href=\"zod-schema-validation\">Zod 模式校验集成</a> 中的 zodResolver 已同时兼容 v7 和 v8。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>RHF 把表单状态移出 React 渲染树，靠内部 Store + 发布-订阅实现接近零重渲染，这是它能支撑 100+ 字段表单的根本原因。</li>\n<li><code>register</code> 用于原生 HTML 元素（ref 注入，零重渲染），<code>Controller</code> 用于不暴露 ref 的第三方组件（单字段局部受控）。</li>\n<li><code>useForm</code> 的关键配置是 <code>mode: &#39;onTouched&#39;</code> + <code>reValidateMode: &#39;onChange&#39;</code>，以及必须显式提供 <code>defaultValues</code>。</li>\n<li>性能优化主线是缩小订阅范围：把 <code>useWatch</code> 下推到最小子组件，谨慎使用 <code>useFormContext</code>。</li>\n<li>v8 的破坏性变更集中在 <code>field.id → field.key</code>、<code>watch</code> 回调改为 <code>subscribe</code>、数组批量设值需用 <code>replace()</code>；迁移建议先锁定 v7 稳定版。</li>\n</ul>\n","headings":[{"level":1,"text":"React Hook Form 深度实践","id":"react-hook-form-深度实践"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"架构原理","id":"架构原理"},{"level":2,"text":"useForm 配置全景","id":"useform-配置全景"},{"level":2,"text":"register 与 Controller 的取舍","id":"register-与-controller-的取舍"},{"level":2,"text":"subscribe API（v8 新增）","id":"subscribe-api-v8-新增"},{"level":2,"text":"useFieldArray：动态列表","id":"usefieldarray-动态列表"},{"level":2,"text":"性能优化模式","id":"性能优化模式"},{"level":3,"text":"隔离重渲染","id":"隔离重渲染"},{"level":3,"text":"FormProvider 与 useFormContext","id":"formprovider-与-useformcontext"},{"level":2,"text":"DevTools 集成","id":"devtools-集成"},{"level":2,"text":"与 Server Actions 集成","id":"与-server-actions-集成"},{"level":2,"text":"v7 → v8 迁移清单","id":"v7-v8-迁移清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"受控与非受控组件","url":"/l-doc-books/h/frontend/react-form-engineering/fundamentals/controlled-uncontrolled"},"next":{"title":"Formik 与 Final Form","url":"/l-doc-books/h/frontend/react-form-engineering/libraries/formik-final-form"}}