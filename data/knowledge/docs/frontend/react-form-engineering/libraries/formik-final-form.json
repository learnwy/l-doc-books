E8\">>{meta.error}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">span</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">              &#x3C;/div></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            )}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          /></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          &#x3C;button disabled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{submitting || pristine}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">提交</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">button</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        &#x3C;/form></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      )}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    /></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关键区别在 <code>subscription</code> prop——组件只订阅它需要的状态切片。email Field 只在 <code>value/error/touched</code> 变化时重渲染，password 字段变化不影响它。</p>\n<h3 id=\"订阅模式的优势\">订阅模式的优势</h3><div class=\"math-block\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>重渲染次数</mtext><mo>=</mo><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mn mathvariant=\"double-struck\">1</mn><mo stretchy=\"false\">[</mo><msub><mtext>field</mtext><mi>i</mi></msub><mtext> 的已订阅切片变化</mtext><mo stretchy=\"false\">]</mo></mrow><annotation encoding=\"application/x-tex\">\\text{重渲染次数} = \\sum_{i=1}^{n} \\mathbb{1}[\\text{field}_i \\text{ 的已订阅切片变化}]</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">重渲染次数</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.9291em;vertical-align:-1.2777em;\"></span><span class=\"mop op-limits\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.6514em;\"><span style=\"top:-1.8723em;margin-left:0em;\"><span class=\"pstrut\" style=\"height:3.05em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">i</span><span class=\"mrel mtight\">=</span><span class=\"mord mtight\">1</span></span></span></span><span style=\"top:-3.05em;\"><span class=\"pstrut\" style=\"height:3.05em;\"></span><span><span class=\"mop op-symbol large-op\">∑</span></span></span><span style=\"top:-4.3em;margin-left:0em;\"><span class=\"pstrut\" style=\"height:3.05em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">n</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.2777em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mopen\">[</span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">field</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord cjk_fallback\">的已订阅切片变化</span></span><span class=\"mclose\">]</span></span></span></span></span></div><p>相比 Formik 的 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>O</mi><mo stretchy=\"false\">(</mo><mi>n</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">O(n)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">n</span><span class=\"mclose\">)</span></span></span></span></span>（所有字段都重渲染），Final Form 实现了 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>O</mi><mo stretchy=\"false\">(</mo><mi>k</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">O(k)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mclose\">)</span></span></span></span></span>（仅相关字段重渲染，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding=\"application/x-tex\">k \\leq n</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8304em;vertical-align:-0.136em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≤</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">n</span></span></span></span></span>）。</p>\n<h3 id=\"final-form-的设计取舍\">Final Form 的设计取舍</h3><table>\n<thead>\n<tr>\n<th>优势</th>\n<th>劣势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>订阅粒度极细</td>\n<td>API 复杂度高——subscription 配置容易遗漏</td>\n</tr>\n<tr>\n<td>框架无关核心</td>\n<td>React 适配层文档较少</td>\n</tr>\n<tr>\n<td>内建表单级校验</td>\n<td>社区生态小于 RHF</td>\n</tr>\n<tr>\n<td>支持字段级异步校验</td>\n<td>维护者精力有限（个人项目）</td>\n</tr>\n<tr>\n<td>Bundle 小（3.3KB core）</td>\n<td>TypeScript 类型不如 RHF 完整</td>\n</tr>\n</tbody></table>\n<h2 id=\"conform-server-first-的新范式\">Conform：Server-First 的新范式</h2><p>2026 年表单库版图的第三极是 Conform——它不是 Formik/Final Form 的改良，而是基于完全不同的哲学构建：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { useForm } from &#39;@conform-to/react&#39;&#10;import { parseWithZod } from &#39;@conform-to/zod&#39;&#10;&#10;function SignupForm() {&#10;  const [form, fields] = useForm({&#10;    onValidate({ formData }) {&#10;      return parseWithZod(formData, { schema })&#10;    },&#10;    shouldValidate: &#39;onBlur&#39;,&#10;  })&#10;&#10;  return (&#10;    &lt;form id={form.id} onSubmit={form.onSubmit} action={serverAction}&gt;&#10;      &lt;input name={fields.email.name} id={fields.email.id} /&gt;&#10;      &lt;div id={fields.email.errorId}&gt;{fields.email.errors}&lt;/div&gt;&#10;    &lt;/form&gt;&#10;  )&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { useForm } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@conform-to/react'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { parseWithZod } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@conform-to/zod'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SignupForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">fields</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    onValidate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">formData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> parseWithZod</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(formData, { schema })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    shouldValidate: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'onBlur'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  })</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{form.id} onSubmit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{form.onSubmit} action</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{serverAction}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">input name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{fields.email.name} id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{fields.email.id} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{fields.email.errorId}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{fields.email.errors}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">div</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Conform 的核心特征：</p>\n<ul>\n<li><strong>渐进增强</strong>：无 JS 也能提交和校验（通过 Server Action）</li>\n<li><strong>无障碍自动化</strong>：自动生成 <code>id</code>、<code>aria-describedby</code>、<code>aria-invalid</code></li>\n<li><strong>FormData 原生</strong>：不维护 JavaScript 对象状态，直接操作 FormData</li>\n</ul>\n<h2 id=\"库选型决策\">库选型决策</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Formik</th>\n<th>Final Form</th>\n<th>RHF</th>\n<th>Conform</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>周下载量（2026）</td>\n<td>7M</td>\n<td>400K</td>\n<td>12M</td>\n<td>300K</td>\n</tr>\n<tr>\n<td>性能模型</td>\n<td>受控全渲染</td>\n<td>订阅按需渲染</td>\n<td>非受控零渲染</td>\n<td>非受控 + 服务端</td>\n</tr>\n<tr>\n<td>TypeScript</td>\n<td>一般</td>\n<td>一般</td>\n<td>优秀</td>\n<td>优秀</td>\n</tr>\n<tr>\n<td>Server Actions</td>\n<td>需适配</td>\n<td>不支持</td>\n<td>需包装</td>\n<td>原生设计</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>低</td>\n<td>中</td>\n<td>中</td>\n<td>中</td>\n</tr>\n<tr>\n<td>新项目推荐</td>\n<td>否</td>\n<td>否</td>\n<td>是（客户端）</td>\n<td>是（服务端优先）</td>\n</tr>\n</tbody></table>\n<h2 id=\"从-formik-迁移到-rhf\">从 Formik 迁移到 RHF</h2><p>迁移不必一次性完成——可以逐表单渐进替换：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 迁移前（Formik）&#10;&lt;Formik initialValues={init} onSubmit={submit}&gt;&#10;  {({ values }) =&gt; (&#10;    &lt;Form&gt;&#10;      &lt;Field name=&quot;email&quot; /&gt;&#10;    &lt;/Form&gt;&#10;  )}&#10;&lt;/Formik&gt;&#10;&#10;// 迁移后（RHF）&#10;const { register, handleSubmit } = useForm({ defaultValues: init })&#10;return (&#10;  &lt;form onSubmit={handleSubmit(submit)}&gt;&#10;    &lt;input {...register(&#39;email&#39;)} /&gt;&#10;  &lt;/form&gt;&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 迁移前（Formik）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Formik initialValues</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{init} onSubmit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{submit}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">values</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Field name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"email\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Formik</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 迁移后（RHF）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">register</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">handleSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useForm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ defaultValues: init })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form onSubmit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">handleSubmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">input {</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">register</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">('</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">email</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">')} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">form</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>迁移检查清单：</p>\n<ol>\n<li>用 <code>defaultValues</code> 替换 <code>initialValues</code></li>\n<li>用 <code>register</code> 替换 <code>&lt;Field&gt;</code></li>\n<li>用 <code>zodResolver</code> 替换 <code>validationSchema</code>（同时从 Yup 迁到 Zod）</li>\n<li>用 <code>useWatch</code> 替换 render prop 中对 <code>values</code> 的直接读取</li>\n<li>用 <code>useFieldArray</code> 替换手动的 <code>FieldArray</code></li>\n</ol>\n<p><a href=\"react-hook-form\">React Hook Form 深度实践</a> 覆盖了 RHF 的完整 API。<a href=\"zod-schema-validation\">Zod 模式校验集成</a> 详细讨论从 Yup 到 Zod 的 schema 迁移策略。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Formik 把整个表单状态放进单一 Context，任何字段变化都触发全部 Consumer 重渲染（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>O</mi><mo stretchy=\"false\">(</mo><mi>n</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">O(n)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">n</span><span class=\"mclose\">)</span></span></span></span></span>），这是它的根本性能瓶颈；<code>FastField</code> 只能局部缓解，无法处理跨字段依赖。</li>\n<li>React Final Form 用 <code>subscription</code> 实现细粒度订阅，重渲染降为 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>O</mi><mo stretchy=\"false\">(</mo><mi>k</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">O(k)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">O</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mclose\">)</span></span></span></span></span>，代价是 API 更复杂、生态更小、文档更少。</li>\n<li>Conform 走 Server-First 路线：不维护 JS 对象状态，直接操作 <code>FormData</code>，原生支持无 JS 的渐进增强与无障碍属性。</li>\n<li>选型结论：客户端高性能场景用 RHF，服务端优先场景用 Conform，Formik 与 Final Form 仅适用于存量系统的维护。</li>\n<li>从 Formik 迁移到 RHF 可逐表单渐进替换，五步清单是 <code>defaultValues</code>、<code>register</code>、<code>zodResolver</code>、<code>useWatch</code>、<code>useFieldArray</code> 的对应替换。</li>\n</ul>\n","headings":[{"level":1,"text":"Formik 与 Final Form","id":"formik-与-final-form"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Formik：受控组件的极致","id":"formik-受控组件的极致"},{"level":3,"text":"核心架构","id":"核心架构"},{"level":3,"text":"Formik 的 API 模式","id":"formik-的-api-模式"},{"level":3,"text":"Formik 的已知痛点","id":"formik-的已知痛点"},{"level":3,"text":"FastField：局部优化尝试","id":"fastfield-局部优化尝试"},{"level":2,"text":"React Final Form：订阅模型","id":"react-final-form-订阅模型"},{"level":3,"text":"核心架构","id":"核心架构"},{"level":3,"text":"订阅模式的优势","id":"订阅模式的优势"},{"level":3,"text":"Final Form 的设计取舍","id":"final-form-的设计取舍"},{"level":2,"text":"Conform：Server-First 的新范式","id":"conform-server-first-的新范式"},{"level":2,"text":"库选型决策","id":"库选型决策"},{"level":2,"text":"从 Formik 迁移到 RHF","id":"从-formik-迁移到-rhf"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"React Hook Form 深度实践","url":"/l-doc-books/h/frontend/react-form-engineering/libraries/react-hook-form"},"next":{"title":"Zod 模式校验集成","url":"/l-doc-books/h/frontend/react-form-engineering/libraries/zod-schema-validation"}}