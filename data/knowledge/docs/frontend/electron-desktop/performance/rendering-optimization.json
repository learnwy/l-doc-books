ipt\" data-code=\"const offscreenWin = new BrowserWindow({&#10;  show: false,&#10;  webPreferences: {&#10;    offscreen: true,&#10;  },&#10;});&#10;&#10;offscreenWin.webContents.on(&#39;paint&#39;, (_event, _dirty, image) =&gt; {&#10;  // image 是 NativeImage，可转为 PNG/JPEG&#10;  fs.writeFileSync(&#39;screenshot.png&#39;, image.toPNG());&#10;});&#10;&#10;offscreenWin.webContents.setFrameRate(1); // 每秒一帧即够\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> offscreenWin</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BrowserWindow</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  show: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  webPreferences: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    offscreen: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">offscreenWin.webContents.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"colo