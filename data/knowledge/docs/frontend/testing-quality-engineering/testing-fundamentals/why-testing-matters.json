D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'new@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        password: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'secret'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user.role).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'VIEWER'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>阅读这组测试，任何新加入的开发者都能快速了解：密码会被哈希存储、邮箱必须唯一、默认角色是 VIEWER。这比任何文字文档都精确。</p>\n<h3 id=\"价值四-设计驱动\">价值四：设计驱动</h3><p>TDD（测试驱动开发）揭示了一个深刻的道理：<strong>如果一段代码很难测试，那它的设计一定有问题。</strong></p>\n<table>\n<thead>\n<tr>\n<th>测试困难的信号</th>\n<th>背后的设计问题</th>\n<th>改进方向</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>需要 mock 大量依赖</td>\n<td>类/函数耦合度过高</td>\n<td>依赖注入、接口抽象</td>\n</tr>\n<tr>\n<td>测试需要复杂的初始化</td>\n<td>对象职责过多</td>\n<td>拆分为更小的组件</td>\n</tr>\n<tr>\n<td>无法隔离测试某个行为</td>\n<td>副作用与业务逻辑混合</td>\n<td>分离纯函数与副作用</td>\n</tr>\n<tr>\n<td>测试结果不确定</td>\n<td>依赖全局状态或时间</td>\n<td>显式传入依赖</td>\n</tr>\n<tr>\n<td>需要访问私有方法</td>\n<td>封装边界不合理</td>\n<td>重新划分公共接口</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"class OrderService {&#10;  constructor(&#10;    private readonly priceCalculator: PriceCalculator,&#10;    private readonly inventory: InventoryChecker,&#10;    private readonly paymentGateway: PaymentGateway,&#10;    private readonly notifier: OrderNotifier,&#10;  ) {}&#10;&#10;  async placeOrder(order: Order): Promise&lt;OrderResult&gt; {&#10;    const price = this.priceCalculator.calculate(order.items);&#10;    const available = await this.inventory.checkAll(order.items);&#10;    if (!available) {&#10;      return { status: &#39;OUT_OF_STOCK&#39; };&#10;    }&#10;    const payment = await this.paymentGateway.charge(order.userId, price);&#10;    if (!payment.success) {&#10;      return { status: &#39;PAYMENT_FAILED&#39; };&#10;    }&#10;    await this.notifier.send(order.userId, payment.transactionId);&#10;    return { status: &#39;SUCCESS&#39;, transactionId: payment.transactionId };&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  constructor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> priceCalculator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PriceCalculator</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> inventory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InventoryChecker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> paymentGateway</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PaymentGateway</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> notifier</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderNotifier</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> placeOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">order</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">OrderResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> price</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.priceCalculator.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">calculate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(order.items);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> available</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.inventory.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">checkAll</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(order.items);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">available) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'OUT_OF_STOCK'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> payment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.paymentGateway.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">charge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(order.userId, price);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">payment.success) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'PAYMENT_FAILED'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.notifier.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(order.userId, payment.transactionId);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'SUCCESS'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, transactionId: payment.transactionId };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>通过依赖注入，每个协作者都可以独立 mock，测试变得简单直接。这就是测试驱动出来的好设计。</p>\n<hr>\n<h2 id=\"不测试的成本-bug-成本曲线\">不测试的成本：Bug 成本曲线</h2><h3 id=\"缺陷修复成本随阶段指数增长\">缺陷修复成本随阶段指数增长</h3><p>软件工程领域有一个经典结论：<strong>缺陷越晚被发现，修复成本越高。</strong> 这个规律被称为&quot;Bug 成本曲线&quot;（Cost of Defect Curve），最早由 Barry Boehm 在 1981 年的研究中系统化提出，后续被 IBM、NASA 等机构的数据反复验证。</p>\n<pre class=\"mermaid\" data-diagram-type=\"xychart\" data-source=\"xychart-beta&#10;    title &quot;缺陷修复成本随阶段变化(相对倍数)&quot;&#10;    x-axis [&quot;需求&quot;, &quot;设计&quot;, &quot;编码&quot;, &quot;测试&quot;, &quot;发布&quot;, &quot;生产&quot;]&#10;    y-axis &quot;相对成本倍数&quot; 0 --&gt; 150&#10;    bar [1, 5, 10, 20, 50, 150]\">xychart-beta\n    title \"缺陷修复成本随阶段变化(相对倍数)\"\n    x-axis [\"需求\", \"设计\", \"编码\", \"测试\", \"发布\", \"生产\"]\n    y-axis \"相对成本倍数\" 0 --&gt; 150\n    bar [1, 5, 10, 20, 50, 150]</pre><table>\n<thead>\n<tr>\n<th>发现阶段</th>\n<th>相对成本倍数</th>\n<th>典型场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>需求阶段</td>\n<td>1×</td>\n<td>需求评审发现逻辑矛盾</td>\n</tr>\n<tr>\n<td>设计阶段</td>\n<td>5×</td>\n<td>架构评审发现扩展性问题</td>\n</tr>\n<tr>\n<td>编码阶段</td>\n<td>10×</td>\n<td>单元测试捕获边界错误</td>\n</tr>\n<tr>\n<td>测试阶段</td>\n<td>20×</td>\n<td>集成测试发现接口不兼容</td>\n</tr>\n<tr>\n<td>发布阶段</td>\n<td>50×</td>\n<td>UAT 发现业务流程缺失</td>\n</tr>\n<tr>\n<td>生产环境</td>\n<td>150×</td>\n<td>线上故障导致数据丢失</td>\n</tr>\n</tbody></table>\n<h3 id=\"隐性成本\">隐性成本</h3><p>除了直接修复成本，不测试还会产生大量隐性成本：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    A[缺陷进入生产] --&gt; B[用户投诉]&#10;    A --&gt; C[紧急修复]&#10;    A --&gt; D[品牌受损]&#10;    B --&gt; E[客服成本增加]&#10;    C --&gt; F[开发者被打断]&#10;    C --&gt; G[加班赶工]&#10;    D --&gt; H[用户流失]&#10;    F --&gt; I[其他需求延期]&#10;    G --&gt; J[团队倦怠]&#10;    H --&gt; K[营收下降]&#10;    I --&gt; L[项目计划混乱]&#10;    J --&gt; M[人员流失]\">flowchart TB\n    A[缺陷进入生产] --&gt; B[用户投诉]\n    A --&gt; C[紧急修复]\n    A --&gt; D[品牌受损]\n    B --&gt; E[客服成本增加]\n    C --&gt; F[开发者被打断]\n    C --&gt; G[加班赶工]\n    D --&gt; H[用户流失]\n    F --&gt; I[其他需求延期]\n    G --&gt; J[团队倦怠]\n    H --&gt; K[营收下降]\n    I --&gt; L[项目计划混乱]\n    J --&gt; M[人员流失]</pre><hr>\n<h2 id=\"测试-roi-分析\">测试 ROI 分析</h2><h3 id=\"量化-roi-模型\">量化 ROI 模型</h3><p>测试的投资回报率可以用以下公式估算：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"ROI = (避免的缺陷成本 - 测试投入成本) / 测试投入成本 × 100%\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>ROI = (避免的缺陷成本 - 测试投入成本) / 测试投入成本 × 100%</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph 测试投入&#10;        A[编写测试时间]&#10;        B[维护测试时间]&#10;        C[CI/CD 基础设施]&#10;        D[测试工具许可]&#10;    end&#10;&#10;    subgraph 测试收益&#10;        E[减少生产缺陷]&#10;        F[降低修复成本]&#10;        G[加速开发速度]&#10;        H[减少回归风险]&#10;        I[提升部署频率]&#10;    end&#10;&#10;    A --&gt; J{ROI 计算}&#10;    B --&gt; J&#10;    C --&gt; J&#10;    D --&gt; J&#10;    E --&gt; J&#10;    F --&gt; J&#10;    G --&gt; J&#10;    H --&gt; J&#10;    I --&gt; J&#10;    J --&gt; K[典型 ROI: 300-800%]\">flowchart LR\n    subgraph 测试投入\n        A[编写测试时间]\n        B[维护测试时间]\n        C[CI/CD 基础设施]\n        D[测试工具许可]\n    end\n\n    subgraph 测试收益\n        E[减少生产缺陷]\n        F[降低修复成本]\n        G[加速开发速度]\n        H[减少回归风险]\n        I[提升部署频率]\n    end\n\n    A --&gt; J{ROI 计算}\n    B --&gt; J\n    C --&gt; J\n    D --&gt; J\n    E --&gt; J\n    F --&gt; J\n    G --&gt; J\n    H --&gt; J\n    I --&gt; J\n    J --&gt; K[典型 ROI: 300-800%]</pre><h3 id=\"不同测试类型的-roi-对比\">不同测试类型的 ROI 对比</h3><table>\n<thead>\n<tr>\n<th>测试类型</th>\n<th>编写成本</th>\n<th>维护成本</th>\n<th>发现缺陷能力</th>\n<th>反馈速度</th>\n<th>综合 ROI</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单元测试</td>\n<td>低</td>\n<td>低</td>\n<td>中（逻辑错误）</td>\n<td>秒级</td>\n<td>★★★★★</td>\n</tr>\n<tr>\n<td>集成测试</td>\n<td>中</td>\n<td>中</td>\n<td>高（接口问题）</td>\n<td>分钟级</td>\n<td>★★★★☆</td>\n</tr>\n<tr>\n<td>E2E 测试</td>\n<td>高</td>\n<td>高</td>\n<td>高（流程问题）</td>\n<td>分钟级</td>\n<td>★★★☆☆</td>\n</tr>\n<tr>\n<td>性能测试</td>\n<td>高</td>\n<td>中</td>\n<td>中（性能瓶颈）</td>\n<td>分钟-小时</td>\n<td>★★★☆☆</td>\n</tr>\n<tr>\n<td>安全测试</td>\n<td>高</td>\n<td>中</td>\n<td>高（安全漏洞）</td>\n<td>分钟-小时</td>\n<td>★★★★☆</td>\n</tr>\n</tbody></table>\n<h3 id=\"实际数据参考\">实际数据参考</h3><p>根据 Microsoft Research（2009）和 IBM System Sciences Institute 的研究数据：</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>无测试团队</th>\n<th>有测试团队</th>\n<th>差异</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>平均缺陷密度</td>\n<td>25 缺陷/千行</td>\n<td>3 缺陷/千行</td>\n<td>-88%</td>\n</tr>\n<tr>\n<td>生产环境事故频率</td>\n<td>每月 4-8 次</td>\n<td>每月 0-1 次</td>\n<td>-90%</td>\n</tr>\n<tr>\n<td>平均修复时间</td>\n<td>8-16 小时</td>\n<td>1-2 小时</td>\n<td>-87%</td>\n</tr>\n<tr>\n<td>部署频率</td>\n<td>每月 1-2 次</td>\n<td>每日多次</td>\n<td>+10×</td>\n</tr>\n<tr>\n<td>开发者满意度</td>\n<td>低</td>\n<td>高</td>\n<td>显著提升</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>核心要点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>质量保障</td>\n<td>测试用例是质量契约，防止回归缺陷</td>\n</tr>\n<tr>\n<td>重构信心</td>\n<td>测试是安全网，让重构从冒险变为常规</td>\n</tr>\n<tr>\n<td>文档作用</td>\n<td>测试是唯一不会过期的行为文档</td>\n</tr>\n<tr>\n<td>设计驱动</td>\n<td>难测试的代码 = 设计有问题</td>\n</tr>\n<tr>\n<td>成本曲线</td>\n<td>缺陷越晚发现，修复成本指数增长</td>\n</tr>\n<tr>\n<td>ROI</td>\n<td>典型测试 ROI 为 300-800%</td>\n</tr>\n</tbody></table>\n<p>测试不是成本，是投资。不是负担，是杠杆。每一行测试代码都在为未来的你和你的团队购买保险。当团队已经认同&quot;为何要测&quot;之后，下一个问题就是&quot;用什么结构去测&quot;——测试金字塔、测试类型划分与 TDD/BDD 实践，构成了本 hub 后续几篇的主题。</p>\n","headings":[{"level":1,"text":"为什么测试至关重要","id":"为什么测试至关重要"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"测试的四重价值","id":"测试的四重价值"},{"level":3,"text":"价值一：质量保障","id":"价值一-质量保障"},{"level":3,"text":"价值二：重构信心","id":"价值二-重构信心"},{"level":3,"text":"价值三：文档作用","id":"价值三-文档作用"},{"level":3,"text":"价值四：设计驱动","id":"价值四-设计驱动"},{"level":2,"text":"不测试的成本：Bug 成本曲线","id":"不测试的成本-bug-成本曲线"},{"level":3,"text":"缺陷修复成本随阶段指数增长","id":"缺陷修复成本随阶段指数增长"},{"level":3,"text":"隐性成本","id":"隐性成本"},{"level":2,"text":"测试 ROI 分析","id":"测试-roi-分析"},{"level":3,"text":"量化 ROI 模型","id":"量化-roi-模型"},{"level":3,"text":"不同测试类型的 ROI 对比","id":"不同测试类型的-roi-对比"},{"level":3,"text":"实际数据参考","id":"实际数据参考"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"测试成熟度与团队实践","url":"/l-doc-books/h/frontend/testing-quality-engineering/testing-fundamentals/testing-maturity-and-team-practice"}}