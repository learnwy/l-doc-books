span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Enter your email'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeInTheDocument</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span></code></pre></div><h3 id=\"查询类型\">查询类型</h3><table>\n<thead>\n<tr>\n<th>查询类型</th>\n<th>说明</th>\n<th>失败处理</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>getBy*</td>\n<td>找到返回元素，没找到报错</td>\n<td>抛出错误</td>\n</tr>\n<tr>\n<td>queryBy*</td>\n<td>找到返回元素，没找到返回 null</td>\n<td>返回 null</td>\n</tr>\n<tr>\n<td>findBy*</td>\n<td>异步查询，返回 Promise</td>\n<td>抛出错误</td>\n</tr>\n</tbody></table>\n<h2 id=\"交互测试\">交互测试</h2><h3 id=\"点击事件\">点击事件</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { render, screen, fireEvent } from &#39;@testing-library/react&#39;&#10;import Counter from &#39;./Counter&#39;&#10;&#10;test(&#39;counter increments&#39;, () =&gt; {&#10;  render(&lt;Counter /&gt;)&#10;&#10;  const button = screen.getByText(&#39;Increment&#39;)&#10;  const count = screen.getByText(&#39;Count: 0&#39;)&#10;&#10;  fireEvent.click(button)&#10;&#10;  expect(screen.getByText(&#39;Count: 1&#39;)).toBeInTheDocument()&#10;})\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { render, screen, fireEvent } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@testing-library/react'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1