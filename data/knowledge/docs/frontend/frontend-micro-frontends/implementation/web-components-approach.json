</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.mountPoint </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> get</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> observedAttributes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'category'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  attributeChangedCallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_old</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">newVal</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 属性变化时通知内部 Vue 应用</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dispatchEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CustomEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'attr-change'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        detail: { [name]: newVal },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">customElements.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">define</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'product-app'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, ProductElement);</span></span></code></pre></div><h3 id=\"在-shell-中使用\">在 Shell 中使用</h3><div class=\"code-block-wrapper\" data-lang=\"html\" data-code=\"&lt;!-- Shell HTML — 零框架依赖 --&gt;&#10;&lt;product-app category=&quot;electronics&quot;&gt;&lt;/product-app&gt;&#10;&lt;cart-widget user-id=&quot;12345&quot;&gt;&lt;/cart-widget&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">&#x3C;!-- Shell HTML — 零框架依赖 --></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">product-app</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> category</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"electronics\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">product-app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">cart-widget</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> user-id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"12345\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">cart-widget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><h2 id=\"与其他方案的对比\">与其他方案的对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Web Components</th>\n<th>Module Federation</th>\n<th>Single-SPA</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>框架依赖</td>\n<td>无（浏览器标准）</td>\n<td>打包器插件</td>\n<td>最小（纯 JS router）</td>\n</tr>\n<tr>\n<td>隔离强度</td>\n<td>强（Shadow DOM）</td>\n<td>无内置隔离</td>\n<td>无内置隔离</td>\n</tr>\n<tr>\n<td>粒度</td>\n<td>组件级</td>\n<td>模块级</td>\n<td>应用级</td>\n</tr>\n<tr>\n<td>通信方式</td>\n<td>Attributes + Events</td>\n<td>Import</td>\n<td>Props + Events</td>\n</tr>\n<tr>\n<td>共享依赖</td>\n<td>无内置机制</td>\n<td>shared 协议</td>\n<td>Import Maps</td>\n</tr>\n<tr>\n<td>SSR 支持</td>\n<td>Declarative Shadow DOM</td>\n<td>Modern.js</td>\n<td>无官方方案</td>\n</tr>\n<tr>\n<td>类型安全</td>\n<td>需手动定义</td>\n<td>自动 .d.ts</td>\n<td>需手动定义</td>\n</tr>\n</tbody></table>\n<h2 id=\"边缘组合-edge-composition\">边缘组合（Edge Composition）</h2><p>边缘组合是将微前端的「拼装」逻辑从浏览器移到 CDN 边缘节点。每个子应用独立部署为可寻址的 HTML 片段，边缘 Worker 根据请求路由将它们拼装成完整页面后返回：</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant User as 用户&#10;    participant Edge as CDN Edge Worker&#10;    participant Shell as Shell 服务&#10;    participant ProdApp as Product 服务&#10;    participant CartApp as Cart 服务&#10;&#10;    User-&gt;&gt;Edge: GET /product/123&#10;    Edge-&gt;&gt;Shell: 获取 Shell HTML&#10;    Edge-&gt;&gt;ProdApp: 获取 Product Fragment&#10;    Edge-&gt;&gt;CartApp: 获取 Cart Fragment&#10;    Edge-&gt;&gt;Edge: HTMLRewriter 拼装&#10;    Edge-&gt;&gt;User: 返回完整页面(流式)\">sequenceDiagram\n    participant User as 用户\n    participant Edge as CDN Edge Worker\n    participant Shell as Shell 服务\n    participant ProdApp as Product 服务\n    participant CartApp as Cart 服务\n\n    User-&gt;&gt;Edge: GET /product/123\n    Edge-&gt;&gt;Shell: 获取 Shell HTML\n    Edge-&gt;&gt;ProdApp: 获取 Product Fragment\n    Edge-&gt;&gt;CartApp: 获取 Cart Fragment\n    Edge-&gt;&gt;Edge: HTMLRewriter 拼装\n    Edge-&gt;&gt;User: 返回完整页面(流式)</pre><h3 id=\"cloudflare-workers-htmlrewriter-示例\">Cloudflare Workers HTMLRewriter 示例</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// edge-worker/src/index.ts&#10;export default {&#10;  async fetch(request: Request): Promise&lt;Response&gt; {&#10;    const shellResponse = await fetch(&#39;https://shell.example.com&#39;);&#10;&#10;    return new HTMLRewriter()&#10;      .on(&#39;#product-slot&#39;, {&#10;        async element(el) {&#10;          const productHtml = await fetch(&#39;https://product.example.com/fragment&#39;);&#10;          el.setInnerContent(await productHtml.text(), { html: true });&#10;        },&#10;      })&#10;      .on(&#39;#cart-slot&#39;, {&#10;        async element(el) {&#10;          const cartHtml = await fetch(&#39;https://cart.example.com/fragment&#39;);&#10;          el.setInnerContent(await cartHtml.text(), { html: true });&#10;        },&#10;      })&#10;      .transform(shellResponse);&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// edge-worker/src/index.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">request</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Response</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> shellResponse</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'https://shell.example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HTMLRewriter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'#product-slot'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">el</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> productHtml</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'https://product.example.com/fragment'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          el.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setInnerContent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> productHtml.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), { html: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'#cart-slot'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">el</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cartHtml</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'https://cart.example.com/fragment'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          el.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setInnerContent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cartHtml.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), { html: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(shellResponse);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h3 id=\"边缘组合的适用场景\">边缘组合的适用场景</h3><ul>\n<li><strong>SEO 敏感页面</strong>：搜索引擎爬虫直接获得完整 HTML</li>\n<li><strong>首屏性能极致要求</strong>：无需等待 JS 执行即可看到内容</li>\n<li><strong>CDN 缓存友好</strong>：每个片段可独立设置缓存策略</li>\n<li><strong>渐进式迁移</strong>：老系统的 HTML 片段可以直接嵌入</li>\n</ul>\n<h3 id=\"边缘组合的局限\">边缘组合的局限</h3><ul>\n<li>交互性依赖客户端 hydration</li>\n<li>片段间通信只能通过 DOM/URL</li>\n<li>调试困难（组合逻辑在边缘节点）</li>\n<li>不适合高度交互的 SPA 场景</li>\n</ul>\n<h2 id=\"fragment-piercing-增量迁移模式\">Fragment Piercing：增量迁移模式</h2><p>Fragment Piercing 是一种混合模式——在遗留单体中「插入」新架构的微前端片段，由旧应用和新片段通过约定的 DOM 槽位协调：</p>\n<ol>\n<li>遗留应用保持原样运行</li>\n<li>特定区域用 <code>&lt;div id=&quot;new-feature-slot&quot;&gt;</code> 标记</li>\n<li>新的微前端 JS 挂载到这些槽位</li>\n<li>渐进替换，直到所有区域迁移完毕</li>\n</ol>\n<p>这种模式特别适合「不能停机重写」的大型遗留系统。</p>\n<h2 id=\"micro-app-的-web-components-化实现\">micro-app 的 Web Components 化实现</h2><p>京东开源的 micro-app 将 Web Components 理念应用于微前端框架设计——子应用通过 <code>&lt;micro-app&gt;</code> 标签接入，内部使用 CustomElement + Proxy 沙箱：</p>\n<div class=\"code-block-wrapper\" data-lang=\"html\" data-code=\"&lt;!-- 主应用中 --&gt;&#10;&lt;micro-app name=&quot;product&quot; url=&quot;https://product.example.com&quot; baseroute=&quot;/product&quot;&gt;&lt;/micro-app&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">&#x3C;!-- 主应用中 --></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">micro-app</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"product\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> url</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"https://product.example.com\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> baseroute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"/product\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">micro-app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><p>这种设计兼顾了 Web Components 的声明式接入体验与运行时沙箱隔离的安全性。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Web Components 提供框架无关的标准化微前端接口</li>\n<li>Shadow DOM 是最强的浏览器原生隔离方案</li>\n<li>边缘组合适合 SEO 敏感和首屏性能极致的场景</li>\n<li>Fragment Piercing 是遗留系统增量迁移的实用模式</li>\n<li>micro-app 将 Web Components 标签式体验与沙箱机制融合</li>\n</ul>\n<pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((微前端组合方式))&#10;    客户端组合&#10;      Module Federation&#10;      Single-SPA&#10;      Web Components&#10;    服务端组合&#10;      SSI/ESI&#10;      Node.js BFF&#10;    边缘组合&#10;      Cloudflare Workers&#10;      Vercel Edge&#10;      Fastly Compute\">mindmap\n  root((微前端组合方式))\n    客户端组合\n      Module Federation\n      Single-SPA\n      Web Components\n    服务端组合\n      SSI/ESI\n      Node.js BFF\n    边缘组合\n      Cloudflare Workers\n      Vercel Edge\n      Fastly Compute</pre><h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>本 hub 前一篇：<a href=\"single-spa-framework\">Single-SPA 与运行时编排</a> — 运行时编排方案的详细实现</li>\n<li>跨 hub 参考：<a href=\"../webassembly-toolchains-platforms/web-integration/js-wasm-interop\">WebAssembly hub — JS-Wasm 互操作</a> — Web Components 内部集成 Wasm 模块的模式</li>\n</ul>\n","headings":[{"level":1,"text":"Web Components 与边缘组合","id":"web-components-与边缘组合"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Web Components 作为微前端接口","id":"web-components-作为微前端接口"},{"level":3,"text":"定义子应用为 Custom Element","id":"定义子应用为-custom-element"},{"level":3,"text":"在 Shell 中使用","id":"在-shell-中使用"},{"level":2,"text":"与其他方案的对比","id":"与其他方案的对比"},{"level":2,"text":"边缘组合（Edge Composition）","id":"边缘组合-edge-composition"},{"level":3,"text":"Cloudflare Workers HTMLRewriter 示例","id":"cloudflare-workers-htmlrewriter-示例"},{"level":3,"text":"边缘组合的适用场景","id":"边缘组合的适用场景"},{"level":3,"text":"边缘组合的局限","id":"边缘组合的局限"},{"level":2,"text":"Fragment Piercing：增量迁移模式","id":"fragment-piercing-增量迁移模式"},{"level":2,"text":"micro-app 的 Web Components 化实现","id":"micro-app-的-web-components-化实现"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"Single-SPA 与运行时编排","url":"/l-doc-books/h/frontend/frontend-micro-frontends/implementation/single-spa-framework"},"next":{"title":"共享依赖管理","url":"/l-doc-books/h/frontend/frontend-micro-frontends/engineering/shared-dependencies"}}