<span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventName)) listeners.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventName, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      listeners.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventName)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(handler </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EventContract</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> listeners.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventName)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(handler </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EventContract</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>版本管理策略确保接口变更不破坏现有集成。语义化版本号（SemVer）应用于每个契约——主版本号变更表示不兼容的接口变更，次版本号表示向后兼容的功能添加。消费方应声明它依赖的契约版本范围。</p>\n<table>\n<thead>\n<tr>\n<th>变更类型</th>\n<th>版本变化</th>\n<th>影响</th>\n<th>处理方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>新增字段</td>\n<td>Minor</td>\n<td>向后兼容</td>\n<td>消费方按需采用</td>\n</tr>\n<tr>\n<td>字段重命名</td>\n<td>Major</td>\n<td>不兼容</td>\n<td>过渡期两字段并存</td>\n</tr>\n<tr>\n<td>删除字段</td>\n<td>Major</td>\n<td>不兼容</td>\n<td>提前废弃通知</td>\n</tr>\n<tr>\n<td>类型变更</td>\n<td>Major</td>\n<td>不兼容</td>\n<td>新版本号 + 迁移指南</td>\n</tr>\n</tbody></table>\n<h2 id=\"故障隔离与弹性设计\">故障隔离与弹性设计</h2><p>故障隔离确保单个子应用的崩溃不会导致整个页面不可用。这是微前端相比单体应用的一个核心优势——在单体应用中，一个组件的 JavaScript 错误可能导致整个应用白屏。</p>\n<p>实现故障隔离的关键技术包括错误边界（Error Boundary）——捕获子应用的渲染错误并展示降级 UI；超时保护——加载子应用设置合理的超时时间，超时后展示占位内容；健康检查——定期检测子应用的可用性，不可用时自动切换到缓存版本或降级方案。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface FaultTolerance {&#10;  loadWithFallback(app: MicroFrontendApp): Promise&lt;LoadResult&gt;;&#10;  healthCheck(app: MicroFrontendApp): Promise&lt;boolean&gt;;&#10;}&#10;&#10;interface LoadResult {&#10;  readonly success: boolean;&#10;  readonly app?: MicroFrontendApp;&#10;  readonly fallbackUsed: boolean;&#10;  readonly error?: string;&#10;}&#10;&#10;const createFaultTolerantLoader = (timeout: number, fallbackUI: string): FaultTolerance =&gt; ({&#10;  loadWithFallback: async (app) =&gt; {&#10;    try {&#10;      const result = await Promise.race([&#10;        loadApp(app),&#10;        new Promise&lt;never&gt;((_, reject) =&gt; setTimeout(() =&gt; reject(new Error(&#39;加载超时&#39;)), timeout)),&#10;      ]);&#10;      return { success: true, app: result, fallbackUsed: false };&#10;    } catch (error) {&#10;      renderFallback(app.container, fallbackUI);&#10;      return { success: false, fallbackUsed: true, error: String(error) };&#10;    }&#10;  },&#10;  healthCheck: async (app) =&gt; {&#10;    try {&#10;      const response = await fetch(`${app.entry}/health`, { method: &#39;HEAD&#39; });&#10;      return response.ok;&#10;    } catch {&#10;      return false;&#10;    }&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FaultTolerance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  loadWithFallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">app</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MicroFrontendApp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">LoadResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  healthCheck</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">app</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MicroFrontendApp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LoadResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> success</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> app</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MicroFrontendApp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> fallbackUsed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> error</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createFaultTolerantLoader</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">timeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">fallbackUI</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FaultTolerance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  loadWithFallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">race</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        loadApp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(app),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        new</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">never</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">reject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> reject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'加载超时'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)), timeout)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { success: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, app: result, fallbackUsed: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      renderFallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(app.container, fallbackUI);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { success: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, fallbackUsed: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, error: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(error) };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  healthCheck</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> response</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">app</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">entry</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}/health`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'HEAD'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response.ok;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"性能预算与约束\">性能预算与约束</h2><p>微前端架构中，每个子应用的性能影响会累积到整体用户体验上。性能预算为每个子应用设定资源使用上限，防止某个子应用「吃掉」过多的网络带宽或内存。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 性能预算分配&#10;        T[总预算 300KB JS] --&gt; M[主应用 100KB]&#10;        T --&gt; S1[子应用 A 80KB]&#10;        T --&gt; S2[子应用 B 60KB]&#10;        T --&gt; S3[子应用 C 60KB]&#10;    end\">graph LR\n    subgraph 性能预算分配\n        T[总预算 300KB JS] --&gt; M[主应用 100KB]\n        T --&gt; S1[子应用 A 80KB]\n        T --&gt; S2[子应用 B 60KB]\n        T --&gt; S3[子应用 C 60KB]\n    end</pre><table>\n<thead>\n<tr>\n<th>资源类型</th>\n<th>子应用预算</th>\n<th>共享预算</th>\n<th>监控方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>JS Bundle</td>\n<td>≤100KB gzip</td>\n<td>≤150KB</td>\n<td>CI 构建检查</td>\n</tr>\n<tr>\n<td>CSS</td>\n<td>≤30KB gzip</td>\n<td>≤50KB</td>\n<td>CI 构建检查</td>\n</tr>\n<tr>\n<td>首屏 API 调用</td>\n<td>≤3 个</td>\n<td>N/A</td>\n<td>运行时监控</td>\n</tr>\n<tr>\n<td>内存占用</td>\n<td>≤50MB</td>\n<td>≤100MB</td>\n<td>运行时监控</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>团队自治是微前端的第一原则，垂直切分（按业务域）是实现自治的正确方式</li>\n<li>接口契约通过事件、API 和路由三种类型定义子应用之间的交互规范</li>\n<li>语义化版本号管理契约变更，不兼容变更需要过渡期和迁移指南</li>\n<li>故障隔离通过错误边界、超时保护和健康检查确保子应用崩溃不影响全局</li>\n<li>性能预算为每个子应用设定资源上限，通过 CI 检查和运行时监控确保执行</li>\n<li>设计原则的落地需要工具支撑——契约测试、性能监控和自动化验证</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li>本 hub 兄弟篇：<a href=\"mfe-overview\">微前端概述</a>——回到核心概念与适用场景判断。</li>\n<li>本 hub 兄弟篇：<a href=\"../mfe-engineering/cross-app-communication\">跨应用通信</a>——「接口契约与版本管理」原则在通信层的落地。</li>\n<li>跨学科：<a href=\"../../../cs-fundamentals/distributed-systems/fundamentals/fault-models\">故障模型与容错</a>——「故障隔离与弹性设计」原则的理论基础，理解分区/降级/熔断在前端的对应。</li>\n<li>跨学科：<a href=\"../../frontend-architecture-patterns/application-structure/feature-sliced-design\">Feature Sliced Design 方法论</a>——团队自治与垂直切分在应用内部结构层面的延续。</li>\n</ul>\n","headings":[{"level":1,"text":"微前端设计原则","id":"微前端设计原则"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"团队自治与垂直切分","id":"团队自治与垂直切分"},{"level":2,"text":"接口契约与版本管理","id":"接口契约与版本管理"},{"level":2,"text":"故障隔离与弹性设计","id":"故障隔离与弹性设计"},{"level":2,"text":"性能预算与约束","id":"性能预算与约束"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"微前端概述","url":"/l-doc-books/h/frontend/micro-frontends/mfe-concepts/mfe-overview"},"next":{"title":"微前端与单体架构对比","url":"/l-doc-books/h/frontend/micro-frontends/mfe-concepts/mfe-vs-monolith"}}