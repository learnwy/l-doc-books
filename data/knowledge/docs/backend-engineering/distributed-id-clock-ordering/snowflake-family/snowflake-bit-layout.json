--shiki-dark:#79B8FF\"> ts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BigInt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(nowMs) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> EPOCH</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (ts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'clock before epoch'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (ts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">MACHINE_BITS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SEQ_BITS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (m </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SEQ_BITS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BigInt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(seq);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> decompose</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> seq</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MAX_SEQ</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> machineId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SEQ_BITS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MAX_MACHINE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">MACHINE_BITS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SEQ_BITS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> EPOCH</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { ts: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ts), machineId: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(machineId), seq: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(seq) };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>自检方法：写一个测试，对随机生成的 <code>(nowMs, machineId, seq)</code> 组合做 <code>decompose(compose(x))</code> 应得到原三元组；再断言「<code>nowMs</code> 更大的 ID 一定更大」这一单调性，以及「同一毫秒内 <code>seq</code> 递增则 ID 递增」。这两条断言覆盖了布局错误的绝大多数表现。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Snowflake 用 63 位承载三段信息，数值序等于时间优先的字典序，这正是它索引友好的根本原因。</li>\n<li>时间位存的是「与自定义 epoch 的差值」，41 位毫秒约 69.7 年；epoch 是协议的一部分，必须全局统一且永不修改。</li>\n<li>机器位决定可同时使用的实例数，真正约束是编号回收策略而非 1024 上限。</li>\n<li>序列位决定单机单毫秒吞吐，按毫秒重置是正确行为，忘记归零是自研实现的经典 bug。</li>\n<li>三段总位数固定为 63，加宽任一段都必须重新验算寿命、实例数、吞吐三条不等式。</li>\n<li>位布局错误在反解时最容易暴露，写生成/反解的往返测试与单调性断言是最小验证手段。</li>\n</ul>\n","headings":[{"level":1,"text":"Snowflake 位布局与容量计算","id":"snowflake-位布局与容量计算"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"时间位：epoch 与寿命","id":"时间位-epoch-与寿命"},{"level":2,"text":"机器位：1024 个实例够不够","id":"机器位-1024-个实例够不够"},{"level":2,"text":"序列位：同毫秒内的吞吐上限","id":"序列位-同毫秒内的吞吐上限"},{"level":2,"text":"用代码验证布局与反解","id":"用代码验证布局与反解"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"业务 ID、消息 ID 与幂等键的区别","url":"/l-doc-books/h/backend-engineering/distributed-id-clock-ordering/id-requirements/id-classification"},"next":{"title":"workerId 分配、冲突与中心化注册","url":"/l-doc-books/h/backend-engineering/distributed-id-clock-ordering/snowflake-family/worker-id-allocation"}}