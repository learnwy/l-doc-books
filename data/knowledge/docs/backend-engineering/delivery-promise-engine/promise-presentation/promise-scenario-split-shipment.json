8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dates</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> l.promiseDate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">options.groupByDate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dates.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'single'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, promiseDate: dates[dates.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> groups</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dates.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    from: d,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    to: d,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    lineNos: lines.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> l.promiseDate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">l</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> l.lineNo),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'grouped'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, groups };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"三个必须显式处理的输出分支\">三个必须显式处理的输出分支</h3><p><code>[...new Set(...)]</code> 的去重是必要的：多个包裹落在同一天时应当合并成一组，否则用户会看到「3 个包裹，都在 10 月 5 日到」这样冗余的表述。<code>options.includePresale</code> 让结账页（需要简洁契约，传 <code>false</code>，把预售行单独说明）与订单详情页（需要完整，传 <code>true</code>）共享同一个函数。</p>\n<p><code>kind: &#39;none&#39;</code> 的处理必须显式：所有行都不可承诺时，展示层不能显示「承诺：无」，而应显示「暂不支持配送」并引导用户修改地址或移除商品。这个分支在跨境场景下比国内常见得多——某个目的国临时停收就会让大量订单落到这一分支。</p>\n<h2 id=\"与库存和履约的边界\">与库存和履约的边界</h2><h3 id=\"四个下游依赖的归属\">四个下游依赖的归属</h3><p>聚合承诺涉及三个下游依赖，边界要划清：</p>\n<p><strong>库存</strong>：<code>qty_promisable</code> 来自 ATP 的批量查询，本 hub 只消费其结果。ATP 的时间桶结构见 <a href=\"../atp-ctp-compute/available-to-promise\">可承诺量（ATP）计算</a>。当一行被判定为 <code>partial</code> 时，剩余数量的处理（是否产生一条 backorder 记录、是否通知用户）属于订单与库存系统的职责。</p>\n<p><strong>拆单</strong>：发货单元的分组会影响实际的履约作业。承诺层做出拆单决策后，必须以<strong>明确的发货单元标识</strong>传递给履约系统，而不是让履约系统自行决定怎么拆——否则承诺与履约会分叉。传递机制见 <a href=\"promise-to-fulfillment-handoff\">承诺到履约的传递与锁定</a>。</p>\n<p><strong>预售</strong>：预售商品的 <code>expected_ship_from</code> 依赖入库计划，这与 ATP 在途入库的建模同源（见 <a href=\"../atp-ctp-compute/available-to-promise\">可承诺量（ATP）计算</a> 中关于在途合并的讨论）。预售承诺的履约能力还涉及采购与供应商侧的到货准确性，那属于采购与供应商协同的范围。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>承诺在内部按<strong>发货单元</strong>计算，对外按<strong>订单</strong>表达；两层之间的聚合规则决定用户看到什么。</li>\n<li>推荐组合：结账页用「最慢行」给单一契约日，订单详情页分列展示，购物车按行数在分列与分组之间切换。</li>\n<li>「最慢行」会被预售拖累：预售行应从契约中摘出、单独承诺发货时间，并在结账页显式说明分开发货。</li>\n<li>拆单是成本与时效的显式权衡（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">Δ</mi><mi>t</mi><mo>&gt;</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><annotation encoding=\"application/x-tex\">\\Delta t &gt; \\theta_t</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7224em;vertical-align:-0.0391em;\"></span><span class=\"mord\">Δ</span><span class=\"mord mathnormal\">t</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&gt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">θ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2806em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">t</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 且 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">Δ</mi><mi>c</mi><mo>&lt;</mo><msub><mi>θ</mi><mi>c</mi></msub></mrow><annotation encoding=\"application/x-tex\">\\Delta c &lt; \\theta_c</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7224em;vertical-align:-0.0391em;\"></span><span class=\"mord\">Δ</span><span class=\"mord mathnormal\">c</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">θ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">c</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span>），阈值应按目的国与品类差异化；跨境要计入清关次数翻倍的成本。</li>\n<li>拆单决策必须与承诺计算同时、同输入做出，且必须显式传递给履约；否则承诺与履约会分叉。</li>\n<li>「缺货」有三个语义：完全缺货（不承诺）、部分可满足（改量/拆单延后/整单拒绝）、等待入库（承诺更晚的日期并显式表达为发货时间）。</li>\n<li><code>order_line_promise</code> 是订单承诺的真相源，<code>promise_state</code> 与 <code>promise_date</code> 的组合约束应写进 schema；聚合逻辑应是可测试的纯函数，<code>kind:&#39;none&#39;</code> 分支必须有专门的展示处理。</li>\n</ul>\n<p>承诺在展示层达成一致后，最后一步是把它锁定并交给履约——这是承诺从「一句话」变成「一份契约」的时刻。</p>\n","headings":[{"level":1,"text":"拆单/合单/缺货场景承诺","id":"拆单-合单-缺货场景承诺"},{"level":2,"text":"核心概念：包裹承诺与订单承诺是两个层次","id":"核心概念-包裹承诺与订单承诺是两个层次"},{"level":2,"text":"拆单：什么时候该拆","id":"拆单-什么时候该拆"},{"level":3,"text":"拆单上限","id":"拆单上限"},{"level":3,"text":"拆单上限","id":"拆单上限"},{"level":2,"text":"缺货：三种不同的语义","id":"缺货-三种不同的语义"},{"level":3,"text":"三个语义的边界","id":"三个语义的边界"},{"level":3,"text":"真相源的 schema 约束","id":"真相源的-schema-约束"},{"level":2,"text":"聚合展示的实现","id":"聚合展示的实现"},{"level":3,"text":"无副作用的聚合函数","id":"无副作用的聚合函数"},{"level":3,"text":"三个必须显式处理的输出分支","id":"三个必须显式处理的输出分支"},{"level":2,"text":"与库存和履约的边界","id":"与库存和履约的边界"},{"level":3,"text":"四个下游依赖的归属","id":"四个下游依赖的归属"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"购物车/结账/详情页承诺展示","url":"/l-doc-books/h/backend-engineering/delivery-promise-engine/promise-presentation/promise-cart-checkout-display"},"next":{"title":"承诺到履约的传递与锁定","url":"/l-doc-books/h/backend-engineering/delivery-promise-engine/promise-presentation/promise-to-fulfillment-handoff"}}