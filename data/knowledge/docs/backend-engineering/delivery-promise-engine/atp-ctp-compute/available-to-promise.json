i-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"promiseDateFrom\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-02\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"promiseDateTo\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-06\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"atp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">18</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"promiseDateFrom\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-07\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"promiseDateTo\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-15\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"atp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">220</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"promiseDateFrom\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-16\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"promiseDateTo\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-11-30\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"atp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">640</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"inboundPlan\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"expectedArrival\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-02\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"qty\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"confirmed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"expectedArrival\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-14\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"qty\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tentative\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"modelVersion\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"atp-v19\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>三个细节值得注意。第一，第一个桶的 ATP 是 0 而第二个桶有 18——这 18 件很可能来自一个「今天能补上」的小额调拨，而不是在库现量；桶的边界因此必须与 <strong>CTP 推算出的承诺日区间</strong>对齐，否则调用方无法正确消费。第二，<code>inboundPlan</code> 的 <code>status</code> 区分 <code>confirmed</code> 与 <code>tentative</code>：把 tentative 的量足额计入 ATP 是常见的乐观偏差来源，正确做法是按状态打折（例如 <code>confirmed</code> 计 100%、<code>tentative</code> 计 0%），并把折扣率作为一个可监控的参数。第三，<code>asOfUtc</code> 是必需的：ATP 是一个时间点上的快照，脱离计算时刻的 ATP 是没有意义的数字。</p>\n<h3 id=\"桶的粒度选择\">桶的粒度选择</h3><p>桶粒度是一个权衡。太粗（例如「本周 / 下周 / 之后」）会让承诺日在桶边界附近的订单得到错误的可承诺结论；太细（按自然日分桶、每个 SKU 每个仓一份）会让存储与计算成本爆炸。</p>\n<p>实用的策略是<strong>分层粒度</strong>：近期（未来 14 天）按自然日分桶，因为这一段用户对日期最敏感、CTP 的分辨率也是天；中期（15-60 天）按周分桶；远期（60 天以上）用一个桶。这个策略的存储量约为「按日全期分桶」的 1/5，而在用户能感知到差异的区间保持了完整分辨率。</p>\n<h3 id=\"在途与在库的合并规则\">在途与在库的合并规则</h3><p>把在途入库并进 ATP 需要两个条件同时成立：<strong>预计到货日 ≤ 承诺日</strong>，且<strong>该到货计划的可信度达标</strong>。第一个条件是时间维度，第二个是状态维度。</p>\n<p>到货日不是一个点而是一个分布——供应商发货延迟是常态。工程上应当给每个到货计划维护一个到货日分布（或至少一个保守偏移），并用分位数参与 ATP：把「预计到货日 + P90 延迟」与承诺日比较，而不是用「预计到货日」本身。这与在途时长的处理思路完全一致（见 <a href=\"../promise-data-calendar/transit-time-sla-data\">在途时长与承运 SLA 数据</a>）：<strong>任何用于承诺的未来事件都应用分位数而非点估计</strong>，否则 ATP 会系统性高估。</p>\n<h2 id=\"atp-的写入与扣减\">ATP 的写入与扣减</h2><p>ATP 的正确性风险全部集中在写路径。它是「读多写少、读必须快、写不能丢」的典型形态，但比一般的缓存数字更严格——写丢了就等于超卖。</p>\n<h3 id=\"软预占的时机\">软预占的时机</h3><p>软预占在什么时刻发生，决定了 ATP 承担的并发压力。三种选择：</p>\n<table>\n<thead>\n<tr>\n<th>时机</th>\n<th>软预占时点</th>\n<th>优点</th>\n<th>风险</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>详情页展示</td>\n<td>不预占，只展示</td>\n<td>无写压力</td>\n<td>高并发下展示与实际不符</td>\n</tr>\n<tr>\n<td>加入购物车</td>\n<td>加购时预占</td>\n<td>提前暴露竞争</td>\n<td>加购转化率低，大量无用预占</td>\n</tr>\n<tr>\n<td>创建订单</td>\n<td>下单时预占</td>\n<td>预占与实际意图一致</td>\n<td>结算瞬间并发峰值集中</td>\n</tr>\n</tbody></table>\n<p>主流的折中是<strong>下单时软预占 + 短 TTL</strong>：创建订单时在 ATP 上做一次条件扣减，写入一条带过期时间的软预占记录；支付成功后转为硬预占（交给库存系统的预占机制），超时未支付则由 TTL 自动释放或由定时任务回收。这个模型把「下单」当成唯一的竞争点，避免了加购阶段的无效占用，代价是结算并发峰值全部落在这一刻。</p>\n<h3 id=\"软预占的三态生命周期\">软预占的三态生命周期</h3><p>软预占记录有三个状态，状态之间的迁移必须互斥且幂等：</p>\n<pre class=\"mermaid\" data-diagram-type=\"stateDiagram-v2\" data-source=\"stateDiagram-v2&#10;    [*] --&gt; held: 创建订单&lt;br/&gt;ATP 条件扣减成功&#10;    held --&gt; committed: 支付成功回调&lt;br/&gt;转库存硬预占&#10;    held --&gt; released: 超过 expires_at&lt;br/&gt;回收任务归还 ATP&#10;    committed --&gt; [*]&#10;    released --&gt; [*]\">stateDiagram-v2\n    [*] --&gt; held: 创建订单&lt;br/&gt;ATP 条件扣减成功\n    held --&gt; committed: 支付成功回调&lt;br/&gt;转库存硬预占\n    held --&gt; released: 超过 expires_at&lt;br/&gt;回收任务归还 ATP\n    committed --&gt; [*]\n    released --&gt; [*]</pre><p><code>held → committed</code> 与 <code>held → released</code> 是竞态关系：支付回调与回收任务可能在同一毫秒发生。两者都用 <code>WHERE state=&#39;held&#39;</code> 的条件更新，因此只有一个能成功，额度既不会被重复归还也不会被重复占用。<code>committed</code> 之后 ATP 不再归还——这批额度已经转成库存层的硬预占，ATP 只需在下次重算时不再计入它。</p>\n<h3 id=\"ttl-的取值\">TTL 的取值</h3><p>TTL 的长度是一个业务参数：太短会让正常支付流程中的订单丢失预占（用户付款成功却发现额度被释放），太长会让未支付订单长期占用额度。跨境场景下支付链路更长（多币种、第三方支付、3DS 验证），因此 TTL 需要相应放大，并应针对不同支付方式设置不同的值——支付链路的失败与恢复形态差异很大。</p>\n<h3 id=\"原子扣减的实现\">原子扣减的实现</h3><p>ATP 扣减必须是原子的条件更新。数据库侧的标准形式是条件 UPDATE：</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"UPDATE atp_bucket&#10;SET atp        = atp - :qty,&#10;    version    = version + 1,&#10;    updated_at = UTC_TIMESTAMP()&#10;WHERE sku_id       = :sku&#10;  AND warehouse_id = :wh&#10;  AND bucket_from &lt;= :promise_date&#10;  AND bucket_to   &gt;= :promise_date&#10;  AND atp         &gt;= :qty;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> atp_bucket</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> atp        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> atp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :qty,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">    =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    updated_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UTC_TIMESTAMP()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sku_id       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :sku</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> warehouse_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :wh</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bucket_from </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :promise_date</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bucket_to   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :promise_date</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> atp         </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> :qty;</span></span></code></pre></div><p>判断是否成功的依据是<strong>受影响行数</strong>：<code>rows_affected = 1</code> 表示扣减成功，<code>0</code> 表示额度不足（或桶不存在）。这个模式不需要悲观锁，也不需要在应用层做「先查后写」，因此不存在经典的读写竞态。它的代价是行锁竞争：同一 SKU 同一仓的并发扣减会串行化在同一行上。</p>\n<p>热点 SKU 的竞争缓解需要把单行拆成多行（分桶），这与库存扣减的做法同源，分桶与合并的完整讨论见 <a href=\"multi-node-promise-optimize\">多仓多承运选路求最早/最低成本</a>。这里只强调一点：<strong>ATP 分桶实际上比库存分桶更自然</strong>，因为 ATP 本来就是按承诺日分桶的——只要把「同一个承诺日桶」再按 SKU 的哈希拆成 N 个子行，就能在不改变语义的前提下把单行竞争降到 1/N。</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE atp_bucket (&#10;  sku_id       BIGINT      NOT NULL,&#10;  warehouse_id INT         NOT NULL,&#10;  bucket_from  DATE        NOT NULL,&#10;  bucket_to    DATE        NOT NULL,&#10;  shard_id     TINYINT     NOT NULL DEFAULT 0,&#10;  atp          INT         NOT NULL,&#10;  version      BIGINT      NOT NULL DEFAULT 1,&#10;  updated_at   DATETIME    NOT NULL,&#10;  PRIMARY KEY (sku_id, warehouse_id, bucket_from, shard_id),&#10;  KEY idx_wh_bucket (warehouse_id, bucket_from, bucket_to)&#10;) ENGINE=InnoDB;&#10;&#10;CREATE TABLE atp_soft_reservation (&#10;  reservation_id  BIGINT       NOT NULL AUTO_INCREMENT,&#10;  order_no        VARCHAR(48)  NOT NULL,&#10;  sku_id          BIGINT       NOT NULL,&#10;  warehouse_id    INT          NOT NULL,&#10;  bucket_from     DATE         NOT NULL,&#10;  shard_id        TINYINT      NOT NULL,&#10;  qty             INT          NOT NULL,&#10;  state           ENUM(&#39;held&#39;,&#39;committed&#39;,&#39;released&#39;) NOT NULL,&#10;  promise_date    DATE         NOT NULL,&#10;  expires_at_utc  DATETIME     NOT NULL,&#10;  created_at_utc  DATETIME     NOT NULL,&#10;  PRIMARY KEY (reservation_id),&#10;  UNIQUE KEY uk_order_sku (order_no, sku_id, warehouse_id),&#10;  KEY idx_expire (state, expires_at_utc)&#10;) ENGINE=InnoDB;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> atp_bucket</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sku_id       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  warehouse_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">         NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bucket_from  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">        NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bucket_to    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">        NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  shard_id     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TINYINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">     NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  atp          </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">         NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  updated_at   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATETIME</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">    NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (sku_id, warehouse_id, bucket_from, shard_id),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> idx_wh_bucket (warehouse_id, bucket_from, bucket_to)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) ENGINE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">InnoDB;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> atp_soft_reservation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  reservation_id  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">       NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> AUTO_INCREMENT,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  order_no        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">48</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sku_id          </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">       NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  warehouse_id    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">          NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bucket_from     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">         NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  shard_id        </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TINYINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">      NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  qty             </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">          NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">           ENUM(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'held'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'committed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'released'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  promise_date    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">         NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  expires_at_utc  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATETIME</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">     NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  created_at_utc  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DATETIME</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">     NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (reservation_id),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  UNIQUE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> uk_order_sku (order_no, sku_id, warehouse_id),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> idx_expire (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, expires_at_utc)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) ENGINE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">InnoDB;</span></span></code></pre></div><p><code>uk_order_sku</code> 这个唯一键承担了<strong>幂等</strong>职责：重试的下单请求不会产生两条软预占。<code>idx_expire</code> 支撑超时回收扫描——回收任务按 <code>(state, expires_at_utc)</code> 扫描过期未提交的记录，把 <code>atp</code> 加回去并置为 <code>released</code>。回收与提交的竞态用条件更新解决：提交时 <code>UPDATE ... SET state=&#39;committed&#39; WHERE reservation_id=? AND state=&#39;held&#39;</code>，回收只处理仍为 <code>held</code> 的行，两者中必有一个失败，因此额度只会被回收一次。</p>\n<h3 id=\"缓存与可售量缓存的分工\">缓存与可售量缓存的分工</h3><p>ATP 也需要缓存，但它与可售量缓存的角色不同。可售量缓存服务于展示（软约束），ATP 缓存的角色是<strong>粗筛</strong>：详情页需要知道「大概还有没有」，用缓存；下单需要精确扣减，走数据库条件更新。两者是同一套「展示用缓存、交易用真值」的原则，但它在这里的具体形式是：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>数据源</th>\n<th>一致性要求</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>详情页「有货/无货」徽标</td>\n<td>ATP 缓存（秒级延迟）</td>\n<td>低</td>\n</tr>\n<tr>\n<td>加购时可承诺提示</td>\n<td>ATP 缓存</td>\n<td>低</td>\n</tr>\n<tr>\n<td>下单扣减</td>\n<td><code>atp_bucket</code> 条件更新</td>\n<td>零容忍</td>\n</tr>\n<tr>\n<td>ATP 告警与补货建议</td>\n<td>离线快照</td>\n<td>低</td>\n</tr>\n</tbody></table>\n<p>缓存的写路径用「扣减成功后删除缓存」而不是「更新缓存」，理由是 ATP 的值由多次并发扣减共同决定，缓存更新会引入丢失更新的窗口；删除缓存让下一次读回源，代价是一次穿透，用单飞（singleflight）合并即可。</p>\n<h3 id=\"读路径的降级\">读路径的降级</h3><p>ATP 读路径不可用时的降级策略必须显式选择，因为它直接决定商业损失的方向：</p>\n<ul>\n<li><strong>返回 0（保守）</strong>：用户看到无货，损失转化，但不产生超卖。</li>\n<li><strong>返回缓存旧值（中性）</strong>：可能超卖，超卖量受缓存的陈旧程度限制。</li>\n<li><strong>返回「无承诺」（降级表达）</strong>：可以卖但承诺写成「送达时间待确认」，实际上是交给后端人工处理。</li>\n</ul>\n<p>三种都不是免费的。工程上推荐按 SKU 价值分层：高价值/低库存风险的 SKU 用中性策略，低价值/高竞争风险的用保守策略，并在订单上标记「降级承诺」以便事后统计这部分订单的违约率——降级策略的效果必须被测量，否则它只是一个没人验证的假设。</p>\n<h2 id=\"atp-与库存系统的边界\">ATP 与库存系统的边界</h2><h3 id=\"两本账必须能对账\">两本账必须能对账</h3><p>最后必须把一件事说清楚：<strong>ATP 不是库存，它是库存的承诺视图</strong>。库存系统拥有物理数量与预占状态，ATP 拥有「可以对新用户承诺多少」这个派生的、带时间窗的额度。两者的关系是：</p>\n<ul>\n<li>库存的预占/确认/释放是<strong>真值变更</strong>，ATP 从中派生。</li>\n<li>ATP 的软预占是<strong>承诺层的账</strong>，支付成功后必须转成库存层的硬预占，否则两本账会分叉。</li>\n<li>对账必须能回答：任意时刻，<code>sum(软预占 held) + sum(已转硬预占)</code> 是否与实际订单一致。</li>\n</ul>\n<p>两本账的分叉是这类系统最隐蔽的故障——它平时表现为「偶发超卖」或「偶发无货」，难以复现，直到大促才集中爆发。因此交接点的设计（下单时写软预占、支付回调时转硬预占、超时回收）必须有幂等键与对账任务。购买了哪些量、从哪个仓发，是下一层的决策，见 <a href=\"capable-to-promise-date\">可承诺交货期（CTP）推算</a>。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>ATP 是<strong>面向未来时间窗的承诺额度</strong>，与可售库存的三处差异是：扣软预占、加未来入库、扣安全水位与已知未来需求。</li>\n<li>ATP 必须按承诺日分桶，不能是标量；桶的边界要与 CTP 输出的承诺日区间对齐，粒度宜分层（近期按日、中期按周、远期合并）。</li>\n<li>在途入库并入 ATP 需要两个条件：到货日（用分位数而非点估计）+ 可信状态；<code>tentative</code> 计划的折扣率是一个可监控参数。</li>\n<li>写路径是唯一的风险集中点：软预占取「下单时 + 短 TTL」，扣减用条件 UPDATE 并依据受影响行数判定，超时回收与支付提交通过条件更新互斥，唯一键提供幂等。</li>\n<li>读路径用缓存做粗筛、数据库条件更新做真值；缓存用删除而非更新以消除丢失更新窗口；降级策略必须按 SKU 分层并被事后测量。</li>\n<li>ATP 与库存是两本账，交接点（软预占 → 硬预占）必须有幂等与对账，否则会表现为难以复现的偶发超卖。</li>\n</ul>\n<p>量算清了，接下来算期：假设现在下单、从哪个仓发、走哪家承运商，最早哪天能到。</p>\n","headings":[{"level":1,"text":"可承诺量（ATP）计算","id":"可承诺量-atp-计算"},{"level":2,"text":"核心概念：ATP 与可售量的三处差异","id":"核心概念-atp-与可售量的三处差异"},{"level":2,"text":"ATP 的时间桶结构","id":"atp-的时间桶结构"},{"level":3,"text":"为什么必须分桶而非标量","id":"为什么必须分桶而非标量"},{"level":3,"text":"桶的粒度选择","id":"桶的粒度选择"},{"level":3,"text":"在途与在库的合并规则","id":"在途与在库的合并规则"},{"level":2,"text":"ATP 的写入与扣减","id":"atp-的写入与扣减"},{"level":3,"text":"软预占的时机","id":"软预占的时机"},{"level":3,"text":"软预占的三态生命周期","id":"软预占的三态生命周期"},{"level":3,"text":"TTL 的取值","id":"ttl-的取值"},{"level":3,"text":"原子扣减的实现","id":"原子扣减的实现"},{"level":3,"text":"缓存与可售量缓存的分工","id":"缓存与可售量缓存的分工"},{"level":3,"text":"读路径的降级","id":"读路径的降级"},{"level":2,"text":"ATP 与库存系统的边界","id":"atp-与库存系统的边界"},{"level":3,"text":"两本账必须能对账","id":"两本账必须能对账"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"在途时长与承运 SLA 数据","url":"/l-doc-books/h/backend-engineering/delivery-promise-engine/promise-data-calendar/transit-time-sla-data"},"next":{"title":"可承诺交货期（CTP）推算","url":"/l-doc-books/h/backend-engineering/delivery-promise-engine/atp-ctp-compute/capable-to-promise-date"}}