\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"reconcile_confirmed_absent\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"accepted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"in_flight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"guard\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"network_ack\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"accepted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"returned\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"guard\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"return_code_present\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"in_flight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"settled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"guard\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"settlement_confirmed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"in_flight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"returned\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"guard\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"return_code_present\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"returned\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"resolved\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"guard\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"reversal_posted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"terminal\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"settled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rejected\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"resolved\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"forbidden\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"settled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"created\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rejected\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"accepted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"resolved\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"in_flight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"timeout_policy\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"submitting\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"after\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"PT2M\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"unknown\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"accepted\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"after\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"P3D\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"action\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"escalate_ops\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"not_to_state\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"in_flight\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"after\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"P7D\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"action\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"escalate_ops\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"not_to_state\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>两处细节很重要。<strong><code>timeout_policy</code> 对 <code>accepted</code> 与 <code>in_flight</code> 只升级不转移状态</strong>——「三天没动」是一个需要人工关注的信号，但把它自动推进到某个终态（无论 <code>settled</code> 还是 <code>rejected</code>）都是错的，因为我们对外部世界的认知没有变化。这正是「不能把超时当失败」这条原则的具体落地。<strong><code>forbidden</code> 列表是防御性的</strong>，它防止了那些看似合理但语义错误的转移（例如一笔已结算的出款被误置回创建态）。</p>\n<h2 id=\"状态版本与并发推进\">状态版本与并发推进</h2><h3 id=\"条件更新与乐观锁\">条件更新与乐观锁</h3><p>状态机的并发问题是真实存在的：webhook 回调、轮询任务、人工操作、超时扫描器可能同时尝试推进同一个 item。用乐观锁 + 状态版本号是标准解法：</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"UPDATE payout_item&#10;   SET status = $new_status,&#10;       status_version = status_version + 1,&#10;       updated_at = now()&#10; WHERE payout_item_id = $id&#10;   AND status = $expected_from&#10;   AND status_version = $expected_version;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> payout_item</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">   SET</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $new_status,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">       status_version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> status_version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">       updated_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> payout_item_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">   AND</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $expected_from</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">   AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> status_version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $expected_version;</span></span></code></pre></div><p>受影响行数为 0 表示转移失败（状态已被其他写者推进），此时应当<strong>重新读取当前状态并判断是否仍需推进</strong>，而不是重试同一次转移。这个「读-判-写」的循环是幂等消费的核心模式。</p>\n<h2 id=\"调和-把-unknown-收敛为确定\">调和：把 unknown 收敛为确定</h2><h3 id=\"调和的三个信息源\">调和的三个信息源</h3><p><code>unknown</code> 状态的收敛只能靠外部证据，而证据有三个来源，它们的可靠性与时效不同：</p>\n<p><strong>主动查询（pull）</strong>：调用合作方的状态查询接口。最快（秒级），但依赖合作方提供该接口，且状态可能滞后——合作方自己也可能还没从网络收到确认。</p>\n<p><strong>被动回调（push）</strong>：合作方主动推送状态变更。最及时（如果对方实现得好），但可能丢失（网络问题、回调服务重启），因此不能作为唯一来源。</p>\n<p><strong>对账文件（reconcile file）</strong>：日终的批量对账文件，包含所有当日处理明细的最终状态。最权威、最慢，它是兜底。</p>\n<p>三者的正确用法是<strong>分层收敛</strong>：先用查询快速收敛大部分 <code>unknown</code>（多数情况下是网络抖动，查询一次就有结果）；剩余的等回调；最后靠日终对账文件强制收敛，并把仍无法收敛的升级为人工差错单。这个分层的意义在于它把「快速的乐观收敛」与「慢速但权威的兜底」结合，既不让人工介入每次都发生，也不让任何一笔无限悬空。</p>\n<h3 id=\"调和必须是只读的\">调和必须是只读的</h3><p>一个必须强调的设计原则：<strong>调和动作本身不得产生新的资金移动</strong>。调和只做两件事——更新本地状态、以及在「确认已受理」时补齐缺失的 <code>external_ref</code>。它绝不重新提交。这条原则的动机很实际：如果调和逻辑里包含「查不到就重发」，那么在最坏情况下（合作方查询接口故障但提交接口正常）会产生大量重复付款。重发只能由人在确认「第一次确实没受理」之后显式触发，且必须走一个新的 <code>attempt</code>。</p>\n<h3 id=\"调和作业的调度\">调和作业的调度</h3><p>调和作业需要按状态分层调度：</p>\n<table>\n<thead>\n<tr>\n<th>状态</th>\n<th>调度间隔</th>\n<th>收敛手段</th>\n<th>升级策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>submitting</td>\n<td>秒级</td>\n<td>状态查询</td>\n<td>2 分钟后转 unknown</td>\n</tr>\n<tr>\n<td>unknown</td>\n<td>分钟级（退避）</td>\n<td>查询 → 回调 → 对账</td>\n<td>24 小时未收敛转人工</td>\n</tr>\n<tr>\n<td>accepted</td>\n<td>小时级</td>\n<td>回调 → 对账</td>\n<td>3 天未推进通知运营</td>\n</tr>\n<tr>\n<td>in_flight</td>\n<td>小时级</td>\n<td>回调 → 对账</td>\n<td>7 天未推进通知运营</td>\n</tr>\n<tr>\n<td>returned</td>\n<td>日级</td>\n<td>冲正完成检查</td>\n<td>冲正失败转人工</td>\n</tr>\n</tbody></table>\n<p>「退避」在 <code>unknown</code> 的查询上是必需的：一笔刚进入 <code>unknown</code> 的出款可能在被高频查询，如果每次都按固定间隔请求，会给合作方接口造成压力。用指数退避（例如 30 秒、1 分钟、2 分钟、5 分钟、15 分钟，封顶 1 小时）既保证早期快速收敛，又避免长期悬空的条目持续占用配额。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>幂等键的语义是「同一次出款意图」，应由收款人、币种、净额、结算期、用途与尝试序号构成；随机请求 ID 或「卖家 + 账期」都会在合理业务变化下失效。</li>\n<li>过程性字段（失败原因、时间戳、随机数）必须排除在幂等键之外，否则「同一意图的两次尝试」会变成两个键。</li>\n<li><code>unknown</code> 状态必须独立存在；把超时当 <code>rejected</code> 会漏付、当 <code>accepted</code> 会无凭证推进，两者都是错的。</li>\n<li>状态转移应当是显式的数据表（含守卫与禁止列表），不是散落的 if；<code>accepted</code>/<code>in_flight</code> 的超时只升级不转移状态。</li>\n<li>并发推进用状态版本 + 条件更新（受影响行数为 0 表示竞争失败），失败后重新读判而不是重试同一转移。</li>\n<li>调和有三个信息源（查询、回调、对账文件）并分层收敛；调和本身必须<strong>只读</strong>——绝不包含「查不到就重发」，重发只能由人在确认未受理后显式触发且走新 attempt。</li>\n<li>调和调度按状态分层并带指数退避，避免长期悬空条目持续打合作方接口。</li>\n<li>状态推进到 <code>accepted</code> 时必须同步完成资金冻结（见 <a href=\"balance-hold-release\">资金冻结与释放</a>），而 <code>returned</code> 的冲回与原因码分类是下一章的主题（见 <a href=\"../status-return-reconcile/return-reversal-chargeback\">退回、拒付与冲正</a>）。</li>\n</ul>\n","headings":[{"level":1,"text":"出款幂等与状态机","id":"出款幂等与状态机"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"幂等键的设计：标识「出款意图」而非「请求」","id":"幂等键的设计-标识-出款意图-而非-请求"},{"level":3,"text":"状态集合的设计","id":"状态集合的设计"},{"level":3,"text":"状态转移必须显式、有向、且带守卫","id":"状态转移必须显式-有向-且带守卫"},{"level":2,"text":"状态版本与并发推进","id":"状态版本与并发推进"},{"level":3,"text":"条件更新与乐观锁","id":"条件更新与乐观锁"},{"level":2,"text":"调和：把 unknown 收敛为确定","id":"调和-把-unknown-收敛为确定"},{"level":3,"text":"调和的三个信息源","id":"调和的三个信息源"},{"level":3,"text":"调和必须是只读的","id":"调和必须是只读的"},{"level":3,"text":"调和作业的调度","id":"调和作业的调度"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"出款批次构建与提交","url":"/l-doc-books/h/backend-engineering/global-seller-payout-orchestration/batch-payout-execution/payout-batch-build"},"next":{"title":"资金冻结与释放","url":"/l-doc-books/h/backend-engineering/global-seller-payout-orchestration/batch-payout-execution/balance-hold-release"}}