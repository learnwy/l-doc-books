4292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">channel_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">channel_id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> m</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">raw_code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">   =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">raw_code</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> m</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">effective_from</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">m</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">effective_to</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> OR</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> m</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">effective_to</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'declined'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">created_at</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> >=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> INTERVAL </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'7 days'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> m</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">raw_code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">channel_id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">raw_code</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">HAVING</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> COUNT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 20</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><p><code>confidence</code> 字段表达映射的可信度——1.000 表示规范明确规定的码，低于 1 表示是基于统计归因推断的映射。低可信度映射的处置应当更保守（不重试），且要进入定期复核。<code>evidence_ref</code> 指向归因报告，让每个非规范映射都能被追溯。</p>\n<p><code>effective_from</code> / <code>effective_to</code> 是时间有效性，它的价值在历史分析时体现：用今天的映射去解读半年前的数据可能得出错误结论，如果通道的语义在那期间变了。需要按「交易发生时的映射版本」来解读历史数据，这也是为什么 <code>map_version</code> 是主键的一部分。</p>\n<h2 id=\"从归因到行动\">从归因到行动</h2><p>归因结论的用途有三个，且都要落到具体动作上。</p>\n<h3 id=\"三个用途\">三个用途</h3><p><strong>用途一：修正重试策略。</strong> 语义类别决定了是否重试、是否换通道（见 <a href=\"../authentication-optimization/decline-salvage-retry\">Decline salvage 智能重试</a>）。归因不准会直接导致重试策略错误——把技术性问题当硬拒绝会少救回交易，把硬拒绝当技术性问题会浪费请求并损害信誉。</p>\n<p><strong>用途二：反馈到路由。</strong> 某通道在某语义类别上系统性表现差（例如频繁返回风控拒绝），是路由降权的依据之一。但要注意区分「通道差」与「发卡行对这个通道差」——同一个发卡行在不同通道上的风控拒绝率不同，说明是通道与发卡行的关系问题，而不是通道本身的问题。这类区分会影响是降权还是调整路由的匹配度因子，见 <a href=\"../psp-acquirer-routing/routing-decision-factors\">路由决策因子</a>。</p>\n<p><strong>用途三：通道质量对账。</strong> 与通道方沟通时，「你在 X 语义类别上的码与原因不符，偏差是 Y」比「你的批准率低」有力得多，因为它指明了具体的问题。这也是建立映射层的组织价值。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>响应码有三类问题：未定义码、语义漂移、码与原因不符；直接用原始码做决策会得出错误结论。</li>\n<li>三层结构（原始码 / 语义类别 / 处置动作）解耦了通道变化与策略逻辑；新通道只需补 L1→L2 映射。</li>\n<li>未定义码按硬拒绝保守处理（成本不对称），但必须记录并进入统计归因，不能静默丢弃。</li>\n<li>跨通道换通道重试成功率是判断码语义的关键量；为避免循环论证，需要影子重试来校准。</li>\n<li>码与原因不符用三种方法检测：结果一致性、伴随特征、时间序列突变。</li>\n<li>映射表要支持通道级覆盖、版本化、生效时间区间、可信度与证据引用；历史数据必须按当时的映射版本解读。</li>\n<li>归因结论有三个用途：修正重试策略、反馈路由权重、与通道方对账。</li>\n</ul>\n<p>相关篇目：归因结果如何进入重试决策见 <a href=\"../authentication-optimization/decline-salvage-retry\">Decline salvage 智能重试</a>；失败分类在指标体系中的落位见 <a href=\"auth-approval-rate-analytics\">授权成功率分渠道分析</a>；归因结论如何被实验验证见 <a href=\"routing-ab-test\">路由策略 A/B 实验</a>。</p>\n","headings":[{"level":1,"text":"拒付码归因与映射","id":"拒付码归因与映射"},{"level":2,"text":"核心概念：三层结构","id":"核心概念-三层结构"},{"level":3,"text":"为什么要有中间层","id":"为什么要有中间层"},{"level":2,"text":"未定义码的处理","id":"未定义码的处理"},{"level":3,"text":"保守默认的依据","id":"保守默认的依据"},{"level":2,"text":"码与原因不符的检测","id":"码与原因不符的检测"},{"level":3,"text":"三种检测方法","id":"三种检测方法"},{"level":2,"text":"映射表的数据模型","id":"映射表的数据模型"},{"level":2,"text":"从归因到行动","id":"从归因到行动"},{"level":3,"text":"三个用途","id":"三个用途"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"授权成功率分渠道分析","url":"/l-doc-books/h/backend-engineering/acquiring-smart-routing-auth/auth-analytics-ops/auth-approval-rate-analytics"},"next":{"title":"路由策略 A/B 实验","url":"/l-doc-books/h/backend-engineering/acquiring-smart-routing-auth/auth-analytics-ops/routing-ab-test"}}