><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pick</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tiers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> t.mime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> type);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> avif</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'image/avif'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> webp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'image/webp'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> format</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> avif </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'avif'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> webp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'webp'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'jpeg'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">format</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">saveData</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'on'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'lite'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'full'}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>这个函数的输出（形如 <code>avif:full</code>）是一个小集合中的值，可以直接作为缓存键的一部分，从而把分桶数从&quot;各种 <code>Accept</code> 取值&quot;降到&quot;格式 × 省流状态&quot;（通常 3 × 2 = 6 种）。注意它同时过滤了 <code>q=0</code> 的条目——这是前文规则二的落地。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>尺寸选择只能由客户端做（<code>srcset</code>/<code>sizes</code>），格式选择可由服务端或客户端做；因此尺寸进 URL、格式走协商是自然的架构。</li>\n<li><code>Accept</code> 的 <code>q</code> 值最多三位小数、<code>q=0</code> 表示禁止；服务端应按 <code>q</code> 降序选择，而非硬编码偏好顺序。</li>\n<li>服务端协商必须配 <code>Vary: Accept</code>，否则会把 AVIF 错发给只认 JPEG 的客户端；代价是缓存条目数乘以上述分桶数，可通过边缘归一化降到小集合。</li>\n<li><code>w</code> 描述符除以 <code>sizes</code> 得到有效密度；<code>sizes</code> 缺省为 <code>100vw</code>；媒体条件描述的是视口而非图像；<code>sizes=&quot;auto&quot;</code> 仅与 <code>loading=&quot;lazy&quot;</code> 配合有效，回退到默认 300×150。</li>\n<li><code>Save-Data</code> 是低熵提示（无需 <code>Accept-CH</code> 即可发送），也必须进 <code>Vary</code>，否则省流模式切换后用户会持续拿到轻量响应。</li>\n</ul>\n<p>分发策略的效果需要被量化才能优化，见 <a href=\"media-cost-format-metric\">媒体成本与质量指标监控</a>。</p>\n","headings":[{"level":1,"text":"多端响应式分发（srcset/Accept）","id":"多端响应式分发-srcset-accept"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Accept 头的精确语义","id":"accept-头的精确语义"},{"level":3,"text":"服务端协商的三条规则","id":"服务端协商的三条规则"},{"level":2,"text":"Vary 与缓存分桶","id":"vary-与缓存分桶"},{"level":3,"text":"Vary 的代价必须被正视","id":"vary-的代价必须被正视"},{"level":2,"text":"srcset 与 sizes 的精确规则","id":"srcset-与-sizes-的精确规则"},{"level":3,"text":"x 描述符与 w 描述符的服务端含义","id":"x-描述符与-w-描述符的服务端含义"},{"level":3,"text":"服务端应当产出多少档","id":"服务端应当产出多少档"},{"level":3,"text":"服务端产出的档位与 DPR 的关系","id":"服务端产出的档位与-dpr-的关系"},{"level":3,"text":"auto 与懒加载","id":"auto-与懒加载"},{"level":3,"text":"客户端选择的确定性并非绝对","id":"客户端选择的确定性并非绝对"},{"level":2,"text":"Save-Data 与降级交付","id":"save-data-与降级交付"},{"level":3,"text":"省流模式该降什么","id":"省流模式该降什么"},{"level":3,"text":"这条头也必须进 Vary","id":"这条头也必须进-vary"},{"level":2,"text":"阶段小结：三条协商路径的一致性","id":"阶段小结-三条协商路径的一致性"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"CDN 刷新与媒体版本化","url":"/l-doc-books/h/backend-engineering/media-asset-processing-service/cdn-delivery-ops/cdn-invalidation-version"},"next":{"title":"媒体成本与质量指标监控","url":"/l-doc-books/h/backend-engineering/media-asset-processing-service/cdn-delivery-ops/media-cost-format-metric"}}