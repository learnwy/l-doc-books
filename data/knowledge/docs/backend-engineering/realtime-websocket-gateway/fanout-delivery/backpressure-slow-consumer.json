k:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'coalesce'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn.queue.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> latest</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn.queue[conn.queue.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    conn.queue </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [latest];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    conn.pendingBytes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> latest.frame.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    metrics.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">inc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ws_frames_coalesced_total'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 交由独立的收割任务断开，避免在事件循环里做重活</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (conn.policy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'disconnect'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) shedQueue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(conn.id);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> reapStalledConnections</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 每 5 秒运行一次</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> conn</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> connections) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> head</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn.queue[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (head </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> nowMs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> head.at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> STALL_MS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      conn.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1013</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'server_busy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Try Again Later</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>上面实现里有一个刻意的设计：<strong>标记慢消费者与处置慢消费者被分开了</strong>。热路径（<code>onEnqueue</code>）只做常数时间的标记，重活（批量弹出、断开连接）放到独立的扫描任务。原因是热路径的调用频率是每秒数十万次，任何在其中引入的循环或系统调用都会成为瓶颈。</p>\n<h2 id=\"全局背压-当问题不是某个消费者\">全局背压：当问题不是某个消费者</h2><p>除了单个慢消费者，还有一类背压问题是<strong>全局性的</strong>：所有连接都健康，但整体流量超过了节点的处理能力。典型触发场景是热点事件（一条重大新闻推送给所有用户）、上游消息源突发洪水、或节点启动时的大量重连。</p>\n<p>这时针对单个连接的所有策略都无效，必须在<strong>入口处</strong>做全局背压。可用的手段包括：限制入口队列长度并在超限时拒绝上游（让上游感知到需要降速）；按业务优先级丢弃（低优先级的房间消息在过载时优先丢）；以及对节点间转发做流控，避免压力在集群内部无序传播。</p>\n<p>一个重要判据是<strong>区分&quot;负载压力&quot;与&quot;容量不足&quot;</strong>：如果积压是短暂的（几分钟内自行恢复），说明是负载压力，靠丢弃或降级可解；如果积压持续增长且不收敛，说明容量真的不足，必须扩容。<strong>把容量不足误判为负载压力，会导致持续丢弃而非扩容，用户体验长期受损</strong>。因此在监控上必须区分&quot;丢弃速率&quot;与&quot;入口队列深度趋势&quot;这两个指标。</p>\n<h3 id=\"四类场景的判据\">四类场景的判据</h3><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>特征</th>\n<th>正确应对</th>\n<th>错误应对</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>个别慢消费者</td>\n<td>少量连接队列深，其他正常</td>\n<td>按连接处置（丢弃/合并/断开）</td>\n<td>全局扩容（浪费且无效）</td>\n</tr>\n<tr>\n<td>热点事件突发</td>\n<td>所有连接队列均匀增长，几分钟后回落</td>\n<td>入口限流 + 低优先级丢弃</td>\n<td>无限缓冲（OOM）</td>\n</tr>\n<tr>\n<td>容量真不足</td>\n<td>入口队列持续增长不收敛</td>\n<td>扩容 + 入口限流争取时间</td>\n<td>只丢弃不扩容（长期体验受损）</td>\n</tr>\n<tr>\n<td>上游洪水</td>\n<td>节点入口队列暴涨，网络出口饱和</td>\n<td>断流上游 + 告警</td>\n<td>逐连接处置（来不及）</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>背压是<strong>链路上的传播现象</strong>，不是局部问题；设计它的本质是决定&quot;在哪一层、以何种规则、牺牲什么&quot;。</li>\n<li><strong>TCP 接收窗口（<code>rwnd</code>，RFC 9293）是免费的、精确的第一道背压</strong>；非阻塞 socket 的 <code>EAGAIN</code> 是通知而非错误，把它当错误处理就会转化为用户态无限队列。</li>\n<li>慢消费者识别有三层信号：队列深度（快、易误判）、队首停留时长（准、成本略高）、可写事件触发频率（区分突发与持续阻塞）。应用层 ACK 缺失率最贴近业务语义。</li>\n<li>处理策略四选一：无限缓冲<strong>必须排除</strong>（一个慢消费者可 OOM 整进程，牺牲几万健康连接）；丢弃（<code>1013</code> 语义上佳但需业务允许）；断开（压力归零但增加重连压力，应发 <code>1013</code> 让客户端退避）；合并/快照化（适用于可合并的消息类型）。</li>\n<li><strong>热路径只做常数时间的标记</strong>，批量清理与断开交由独立扫描任务，避免高频路径上的循环与系统调用。</li>\n<li>全局背压必须在<strong>入口</strong>处理（限流、按优先级丢弃、节点间流控）；必须区分&quot;负载压力&quot;（可自愈，靠降级）与&quot;容量不足&quot;（需扩容），监控上后者看入口队列深度趋势而非丢弃速率。</li>\n</ul>\n<p>背压回答了&quot;发不出去怎么办&quot;，但&quot;发出去有没有到&quot;是另一个问题。投递语义的定义与重传机制见 <a href=\"reliable-delivery-qos-ack\">ACK/重传与 QoS 语义</a>。若你还没确定消息在集群内的扩散方式，那会直接决定背压发生在哪一层，见 <a href=\"broadcast-fanout-topology\">广播/扇出拓扑</a>。</p>\n","headings":[{"level":1,"text":"背压与慢消费者处理","id":"背压与慢消费者处理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"TCP 已经提供了第一道背压","id":"tcp-已经提供了第一道背压"},{"level":2,"text":"慢消费者的识别","id":"慢消费者的识别"},{"level":3,"text":"四种识别信号的取舍","id":"四种识别信号的取舍"},{"level":2,"text":"慢消费者的处理策略","id":"慢消费者的处理策略"},{"level":3,"text":"参考实现","id":"参考实现"},{"level":2,"text":"全局背压：当问题不是某个消费者","id":"全局背压-当问题不是某个消费者"},{"level":3,"text":"四类场景的判据","id":"四类场景的判据"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"广播/扇出拓扑","url":"/l-doc-books/h/backend-engineering/realtime-websocket-gateway/fanout-delivery/broadcast-fanout-topology"},"next":{"title":"ACK/重传与 QoS 语义","url":"/l-doc-books/h/backend-engineering/realtime-websocket-gateway/fanout-delivery/reliable-delivery-qos-ack"}}