ki-dark:#E1E4E8\">, connId);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (removed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> publishPresenceIfTransition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userId);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 状态转换判定必须原子化，不能在应用层用两步读写</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 否则并发断开/连接会同时看到旧值而漏发或重发广播</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> publishPresenceIfTransition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">userId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> size</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> redis.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">scard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`presence:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">userId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> wasOnline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> redis.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`presence:state:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">userId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> isOnline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '1'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '0'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (wasOnline </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> isOnline) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ok</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> redis.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`presence:state:${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">userId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, isOnline, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'XX'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'GET'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (ok </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> wasOnline) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bus.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">publish</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'presence.changed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { userId, online: isOnline </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>用<strong>集合</strong>（<code>SADD</code>/<code>SREM</code>）而不是整数计数器，是一种简单而有效的幂等化手段：重复删除同一个 <code>connId</code> 是无效果的（<code>SREM</code> 返回 0），重复添加也是无效果的（返回 0）。这让断开路径可以被安全地重试、被多个信号源同时触发，而不必担心计数漂移。Redis 的集合原语语义在<a href=\"https://redis.io/docs/latest/commands/srem/\">官方命令文档</a>中有明确定义：不存在的成员被移除时不会改变集合内容。</p>\n<h2 id=\"状态转换的原子性\">状态转换的原子性</h2><p>上面代码中最微妙的部分是 <code>publishPresenceIfTransition</code>。它要解决的是<strong>重复广播</strong>与<strong>漏广播</strong>两个相反的问题。</p>\n<p>若不做原子判定，两个连接在同一毫秒内建立，两个处理线程都可能读到&quot;之前无连接&quot;，于是各自广播一次&quot;用户上线&quot;——订阅者收到两条相同的上线事件，若订阅者据此做计费、做未读数计算、做通知去重，就会出错。反过来，若判定逻辑与状态写入之间存在窗口，又可能因为交叉执行而漏掉一次转换广播。</p>\n<p>正确处理需要<strong>原子化的比较并设置（compare-and-set）<strong>语义。Redis 提供了几种实现手段：用 Lua 脚本把&quot;读旧值 + 判断 + 写新值 + 决定是否返回&quot;封装成一次原子执行；或用 <code>SET key value XX GET</code> 这类带条件的原语；再或用带版本号的乐观锁。无论选哪种，原则是：</strong>&quot;是否发生状态转换&quot;这个判断与&quot;记录新状态&quot;这个写入必须在一次原子操作内完成</strong>。</p>\n<p>这个原则不限于 Redis。任何承担 Presence 存储的系统（etcd、ZooKeeper、数据库）都需要提供等价的 CAS 能力，否则就必须把同一用户的 Presence 更新串行化到单一处理点（例如按 userId 分区到固定的单线程），用架构约束换取原子性。</p>\n<table>\n<thead>\n<tr>\n<th>状态转换</th>\n<th>触发条件</th>\n<th>应广播的事件</th>\n<th>若重复广播的后果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>离线 → 在线</td>\n<td>第一个连接建立</td>\n<td><code>presence.changed{online:true}</code></td>\n<td>订阅者重复计数、重复发&quot;上线提醒&quot;</td>\n</tr>\n<tr>\n<td>在线 → 离线</td>\n<td>最后一个连接断开或心跳失效</td>\n<td><code>presence.changed{online:false}</code></td>\n<td>重复发&quot;离线提醒&quot;、重复清理临时状态</td>\n</tr>\n<tr>\n<td>在线 → 在线</td>\n<td>第二端登录</td>\n<td><strong>不广播</strong>（或广播独立的&quot;多端登录&quot;事件）</td>\n<td>误判为上线，覆盖最后活跃时间</td>\n</tr>\n<tr>\n<td>分端状态变更</td>\n<td>某一端断开但仍有其他端</td>\n<td>通常不广播全局离线</td>\n<td>用户在网页上看到好友&quot;闪现离线&quot;</td>\n</tr>\n</tbody></table>\n<h2 id=\"故障时刻的误差窗口\">故障时刻的误差窗口</h2><p>Presence 与现实之间的误差在故障时达到最大，而这个误差的大小是可计算的，应该写进产品需求而不是留给工程师猜测。</p>\n<p><strong>节点崩溃导致的误差</strong>：节点崩溃后，其上的连接全部失效，但 Presence 中的记录不会立即消失。清理依赖两条路径——TTL 过期（最长一个 TTL 周期，例如 5 分钟）与集群节点失联检测（通常是秒级到十几秒）。因此在节点崩溃后的<strong>十几秒到几分钟内，用户会显示为在线但实际收不到消息</strong>。</p>\n<p><strong>心跳超时导致的误差</strong>：客户端网络中断到心跳判定失效之间，存在一个必然的延迟窗口，等于&quot;心跳间隔 × 判定次数&quot;（例如 25 秒 × 3 = 75 秒）。这段时间内 Presence 显示在线，实际已不可达。</p>\n<p><strong>重连竞态导致的误差</strong>：客户端断线后立即重连成功，但旧连接的断开事件可能晚于新连接的建立事件到达。若实现不严谨（例如用计数器而非集合），会出现&quot;新连接建立后计数被旧断开递减到 0&quot;的瞬时误判。</p>\n<h3 id=\"三类误差窗口的对比\">三类误差窗口的对比</h3><p>这三个误差窗口都无法消除，只能缩短或补偿。缩短的手段是调小 TTL、加快失联检测、减小心跳间隔；补偿的手段是在依赖 Presence 的下游做<strong>二次确认</strong>——例如发送重要消息前，先做一次轻量的存活探测，若失败则走离线通道。<strong>关键是在需求层面明确：Presence 是一个有秒级模糊性的近似值，不能当作精确的在线判定使用</strong>。</p>\n<table>\n<thead>\n<tr>\n<th>误差来源</th>\n<th>典型窗口</th>\n<th>缩短手段</th>\n<th>代价</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>节点崩溃 + TTL 兜底</td>\n<td>十几秒 – 数分钟</td>\n<td>调小 TTL、加节点失联检测</td>\n<td>TTL 过小会误清理活跃连接</td>\n</tr>\n<tr>\n<td>心跳超时判定</td>\n<td>心跳间隔 × 判定次数</td>\n<td>缩短间隔、减少判定次数</td>\n<td>弱网误杀率上升、心跳流量上升</td>\n</tr>\n<tr>\n<td>重连竞态</td>\n<td>通常 &lt; 1 秒</td>\n<td>用集合而非计数器 + 事件排序</td>\n<td>实现复杂度略增</td>\n</tr>\n<tr>\n<td>时钟不同步</td>\n<td>取决于 NTP</td>\n<td>用单调时钟记时长、用逻辑时钟排序</td>\n<td>需要改造时间来源</td>\n</tr>\n</tbody></table>\n<h2 id=\"presence-的读取路径\">Presence 的读取路径</h2><p>Presence 的写入路径在上面已经清楚，读取路径同样需要设计，因为它通常处于<strong>扇出热路径</strong>上：一个用户打开好友列表，客户端要显示 200 个好友的在线状态；一次群消息推送，服务端要判断 500 个成员里谁在线。</p>\n<p>逐条查询（200 次 <code>SCARD</code>）在延迟上不可接受，也不必要。常见做法是<strong>批量接口 + 本地缓存</strong>：提供一个批量查询接口（<code>MGET</code> 语义或管道批量），一次取回一批用户的状态；网关侧对结果做短 TTL（如 1–5 秒）的本地缓存，抵消同一批查询的重复。1–5 秒的缓存造成的额外误差是可接受的，因为它与前面讨论的固有误差窗口处于同一量级。</p>\n<h3 id=\"不要把-presence-当订阅源\">不要把 Presence 当订阅源</h3><p>另一个重要设计点是<strong>不要把 Presence 当作订阅源滥用</strong>。有些实现在用户&quot;看到&quot;好友列表时，让客户端订阅所有好友的 Presence 变更事件。当好友数量为数百、在线用户为百万时，事件发布量会呈相乘关系爆炸。正确做法是客户端仅在好友列表<strong>可见时</strong>短期订阅，或由服务端做增量推送（只在好友状态变化且该用户正在查看时才推送）。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Presence 有四种常见含义（活跃连接、最近交互、可推送、可见在线），<strong>必须明确本系统实现的是哪一种</strong>，混用是主要返工来源。</li>\n<li>多端登录下必须用<strong>连接集合/计数</strong>（<code>count &gt; 0</code> 才在线），布尔值会导致&quot;任一端断开即误判离线&quot;。</li>\n<li>用<strong>集合结构</strong>（<code>SADD</code>/<code>SREM</code>）实现天然幂等，规避多信号源重复递减导致的计数漂移——这是最难排查的一类缺陷。</li>\n<li>状态转换判定与状态写入<strong>必须在一次原子操作内完成</strong>（Lua 脚本、CAS 原语、或按 userId 串行化），否则会重复广播或漏广播。</li>\n<li>Presence 与现实存在<strong>固有误差窗口</strong>：节点崩溃（十几秒至数分钟）、心跳超时（心跳间隔 × 判定次数）、重连竞态（通常亚秒）。这些必须在需求层面被承认为近似值。</li>\n<li>读取路径应在<strong>扇出热路径</strong>上做批量查询 + 秒级本地缓存；不要把 Presence 变更做成全量订阅源，否则事件量会爆炸。</li>\n</ul>\n<p>至此路由与状态层已经完备：连接知道自己在哪、消息知道该去哪、状态知道谁在线。下一步是让一条消息真正变成 N 条送达，见 <a href=\"../fanout-delivery/broadcast-fanout-topology\">广播/扇出拓扑</a>。若你需要重新审视路由表本身的键设计，见 <a href=\"session-room-routing\">会话/房间到连接节点的路由</a>。</p>\n","headings":[{"level":1,"text":"在线状态与 Presence","id":"在线状态与-presence"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"多端登录：为什么必须是计数而非布尔","id":"多端登录-为什么必须是计数而非布尔"},{"level":3,"text":"重复信号的三个来源","id":"重复信号的三个来源"},{"level":2,"text":"状态转换的原子性","id":"状态转换的原子性"},{"level":2,"text":"故障时刻的误差窗口","id":"故障时刻的误差窗口"},{"level":3,"text":"三类误差窗口的对比","id":"三类误差窗口的对比"},{"level":2,"text":"Presence 的读取路径","id":"presence-的读取路径"},{"level":3,"text":"不要把 Presence 当订阅源","id":"不要把-presence-当订阅源"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"一致性哈希与扩缩容迁移","url":"/l-doc-books/h/backend-engineering/realtime-websocket-gateway/connection-routing-scale/consistent-hash-rebalance"},"next":{"title":"广播/扇出拓扑","url":"/l-doc-books/h/backend-engineering/realtime-websocket-gateway/fanout-delivery/broadcast-fanout-topology"}}