-dark:#B392F0\"> DeductionRecord</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 摊到本行的所有减免</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    linePayable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }>;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  orderLevel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    itemsSubtotal</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 商品合计（活动价 × 数量）</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    promoDeduction</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    couponDeduction</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    payDeduction</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    shippingFee</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    payable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Money</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 最终实付</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  trace</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 每阶段的判定轨迹</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>payable</code> 必须等于 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mtext>itemsSubtotal</mtext><mo>−</mo><mtext>promoDeduction</mtext><mo>−</mo><mtext>couponDeduction</mtext><mo>−</mo><mtext>payDeduction</mtext><mo>+</mo><mtext>shippingFee</mtext></mrow><annotation encoding=\"application/x-tex\">\\text{itemsSubtotal} - \\text{promoDeduction} - \\text{couponDeduction} - \\text{payDeduction} + \\text{shippingFee}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.0833em;\"></span><span class=\"mord text\"><span class=\"mord\">itemsSubtotal</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">promoDeduction</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">couponDeduction</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">payDeduction</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">shippingFee</span></span></span></span></span></span>，且 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">\\ge 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7719em;vertical-align:-0.136em;\"></span><span class=\"mrel\">≥</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span>。这条恒等式应作为一个断言写在流水线出口——它是&quot;算价没算错&quot;的最便宜的守卫。任何一次线上事故，第一个该看的数字就是这条等式两边是否相等。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>算价是一条<strong>顺序固定的六阶段流水线</strong>：定价 → 活动价 → 促销 → 券 → 运费 → 支付优惠；每笔金额变化只归属一个阶段。</li>\n<li>每个 stage 遵守同一契约：<strong>纯函数 + 注入上下文</strong>，返回 <code>{state, deductions, notes}</code>，失败即整体失败。</li>\n<li><code>version</code>（规则快照版本）随流水线全程传递并落库，是退款重算与线上一致的前提。</li>\n<li>每一笔订单级减免都必须<strong>同时算出行级分摊</strong>；比例分摊用&quot;最大余额法&quot;消尾差，保证分摊合计严格等于减免额。</li>\n<li>运费与支付优惠是独立阶段：运费不影响门槛判定但影响实付；支付优惠只做预估，以支付回调为准。</li>\n<li>出口断言 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mtext>payable</mtext><mo>=</mo><mtext>subtotal</mtext><mo>−</mo><mo>∑</mo><mi>d</mi><mo>+</mo><mtext>shipping</mtext><mo>≥</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">\\text{payable} = \\text{subtotal} - \\sum d + \\text{shipping} \\ge 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">payable</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.0833em;\"></span><span class=\"mord text\"><span class=\"mord\">subtotal</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop op-symbol small-op\" style=\"position:relative;top:0em;\">∑</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">d</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">shipping</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≥</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span> 是最便宜的算价正确性守卫。</li>\n</ul>\n","headings":[{"level":1,"text":"商品价→活动→券→实付的阶段","id":"商品价-活动-券-实付的阶段"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"阶段契约：统一签名与可组合","id":"阶段契约-统一签名与可组合"},{"level":2,"text":"行级分摊：一条减免怎么落到商品上","id":"行级分摊-一条减免怎么落到商品上"},{"level":2,"text":"运费与支付优惠：两个常被忽略的阶段","id":"运费与支付优惠-两个常被忽略的阶段"},{"level":2,"text":"输出结构：PriceBreakdown","id":"输出结构-pricebreakdown"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"叠加与互斥规则表达","url":"/l-doc-books/h/backend-engineering/promotion-pricing-engine/promotion-model/stacking-exclusion"},"next":{"title":"多券最优组合求解与剪枝","url":"/l-doc-books/h/backend-engineering/promotion-pricing-engine/pricing-pipeline/best-combo-solver"}}