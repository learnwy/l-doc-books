shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promotion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> p</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> candidates) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">p.stack.exclusiveGroup) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      free.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> list</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> byGroup.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.stack.exclusiveGroup) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    list.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    byGroup.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.stack.exclusiveGroup, list);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> winners</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> free.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">concat</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">byGroup.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">values</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">list</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pickBest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(list, ctx)), </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 组内选一</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> enforceTypeLimits</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(winners, ctx); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 类型上限</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pickBest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">list</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promotion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PricingContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promotion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">list].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.stack.priority </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.stack.priority </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.promotionId.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">localeCompare</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(b.promotionId))[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>注意 <code>pickBest</code> 里用 <code>||</code> 做平手裁断：先比 <code>priority</code> 降序，相等时比 <code>promotionId</code> 升序。这个双键排序保证了结果是全序（total order）的，也就保证了可复现。顺带一提，<code>Array.prototype.sort</code> 自 ECMAScript 2019 起被规范要求为<strong>稳定排序</strong>（比较相等的元素保持原相对次序），但在比较器里显式补上第二键仍然更稳妥——它把&quot;结果只取决于数据本身&quot;这件事写进了代码，而不是依赖运行时的排序实现（来源：MDN Array.prototype.sort，<a href=\"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/sort\">https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/sort</a> ）。</p>\n<h2 id=\"计算顺序-优先级如何影响最终金额\">计算顺序：优先级如何影响最终金额</h2><p>选出子集之后，还有一个比&quot;谁能用&quot;更隐蔽的问题：<strong>先算谁</strong>。因为后算的活动看到的&quot;命中金额&quot;是前一个活动减完之后的余额，顺序会改变最终实付。</p>\n<p>举例：订单 250 元，活动 A 是&quot;8 折&quot;（减 50），活动 B 是&quot;满 200 减 30&quot;。若 A 先算，命中额变成 200，B 的门槛恰好满足，共减 80，实付 170。若 B 先算，命中额变成 220，A 打 8 折减 44，共减 74，实付 176。差了 6 元。</p>\n<p>所以 <code>priority</code> 不只是&quot;冲突时谁赢&quot;，还是<strong>计算次序</strong>。约定成&quot;按 <code>priority</code> 降序依次计算&quot;，并明确每个 <code>benefit</code> 读取的命中金额是&quot;当前剩余金额&quot;还是&quot;原始金额&quot;（即<a href=\"eligibility-rule\">适用门槛、人群与商品范围</a>中提到的 <code>thresholdBase</code>）。一个常见且安全的默认是：</p>\n<div class=\"math-block\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msubsup><mi>A</mi><mrow><mi>e</mi><mi>l</mi><mi>i</mi><mi>g</mi><mi>i</mi><mi>b</mi><mi>l</mi><mi>e</mi></mrow><mrow><mo stretchy=\"false\">(</mo><mi>k</mi><mo stretchy=\"false\">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>A</mi><mrow><mi>e</mi><mi>l</mi><mi>i</mi><mi>g</mi><mi>i</mi><mi>b</mi><mi>l</mi><mi>e</mi></mrow><mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mrow></msubsup><mo>−</mo><munder><mo>∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>k</mi></mrow></munder><msub><mi>d</mi><mi>j</mi></msub></mrow><annotation encoding=\"application/x-tex\">A^{(k)}_{eligible} = A^{(0)}_{eligible} - \\sum_{j&lt;k} d_j</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.4822em;vertical-align:-0.4374em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">A</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0448em;\"><span style=\"top:-2.3987em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">e</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">i</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span><span class=\"mord mathnormal mtight\">ib</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">e</span></span></span></span><span style=\"top:-3.2198em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mopen mtight\">(</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span><span class=\"mclose mtight\">)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4374em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.4822em;vertical-align:-0.4374em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">A</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0448em;\"><span style=\"top:-2.3987em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">e</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">i</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span><span class=\"mord mathnormal mtight\">ib</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">e</span></span></span></span><span style=\"top:-3.2198em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mopen mtight\">(</span><span class=\"mord mtight\">0</span><span class=\"mclose mtight\">)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4374em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.4882em;vertical-align:-1.4382em;\"></span><span class=\"mop op-limits\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.05em;\"><span style=\"top:-1.8479em;margin-left:0em;\"><span class=\"pstrut\" style=\"height:3.05em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span><span class=\"mrel mtight\">&lt;</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span><span style=\"top:-3.05em;\"><span class=\"pstrut\" style=\"height:3.05em;\"></span><span><span class=\"mop op-symbol large-op\">∑</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.4382em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span></span></div><p>即每一步都在剩余金额上工作。这样能天然防止&quot;两个活动各自基于原价减，加起来超过订单金额&quot;。但折扣类活动若也按剩余金额算，会在券之后变得几乎无感，因此实务上常把&quot;打折类&quot;固定在&quot;券之前算、基于原价或活动价&quot;，把这一点写进配置模板而不是散落在代码里。</p>\n<table>\n<thead>\n<tr>\n<th>活动类型</th>\n<th>建议次序</th>\n<th>命中金额基准</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单品特价 / 秒杀</td>\n<td>最先</td>\n<td>原价</td>\n<td>底价必须最先确定</td>\n</tr>\n<tr>\n<td>折扣（品类/全场）</td>\n<td>次之</td>\n<td>秒杀后价</td>\n<td>折扣作用在已确定的底价上</td>\n</tr>\n<tr>\n<td>满减 / 满折</td>\n<td>再次</td>\n<td>折扣后价</td>\n<td>门槛比价用折后价更符合用户直觉</td>\n</tr>\n<tr>\n<td>券 / 代金券</td>\n<td>最后</td>\n<td>满减后价</td>\n<td>券是最后的&quot;现金抵扣&quot;</td>\n</tr>\n<tr>\n<td>赠品</td>\n<td>不计次序</td>\n<td>—</td>\n<td>只加成本，不减价</td>\n</tr>\n</tbody></table>\n<h2 id=\"可叠加矩阵-从-两两枚举-退到-组间默认\">可叠加矩阵：从&quot;两两枚举&quot;退到&quot;组间默认&quot;</h2><p>有些诉求无法用单一互斥组表达，比如&quot;平台券可以和品类券叠，但不能和品牌券叠&quot;。若为此引入任意两两关系，配置复杂度会失控。务实的做法是<strong>分层</strong>：</p>\n<ol>\n<li><strong>组内互斥</strong>（必须）：同 <code>exclusiveGroup</code> 最多一个。</li>\n<li><strong>组间默认可叠</strong>（默认）：不同组之间默认允许叠加。</li>\n<li><strong>例外用白/黑名单</strong>（少量）：<code>canStackWith</code> / <code>cannotStackWith</code> 只用于真正例外的少数对。</li>\n</ol>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function stackable(a: Promotion, b: Promotion): boolean {&#10;  if (a.stack.exclusiveGroup &amp;&amp; a.stack.exclusiveGroup === b.stack.exclusiveGroup) return false;&#10;  if (a.stack.cannotStackWith?.includes(b.stack.exclusiveGroup ?? b.type)) return false;&#10;  if (b.stack.cannotStackWith?.includes(a.stack.exclusiveGroup ?? a.type)) return false;&#10;  if (b.stack.canStackWith &amp;&amp; !b.stack.canStackWith.includes(a.stack.exclusiveGroup ?? a.type)) return false;&#10;  return true;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> stackable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promotion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promotion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (a.stack.exclusiveGroup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.stack.exclusiveGroup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.stack.exclusiveGroup) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (a.stack.cannotStackWith?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(b.stack.exclusiveGroup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.type)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (b.stack.cannotStackWith?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(a.stack.exclusiveGroup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.type)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (b.stack.canStackWith </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">b.stack.canStackWith.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(a.stack.exclusiveGroup </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.type)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>要给出<strong>总减免上限</strong>这个兜底：<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>∑</mo><msub><mi>d</mi><mi>j</mi></msub><mo>≤</mo><msubsup><mi>A</mi><mrow><mi>e</mi><mi>l</mi><mi>i</mi><mi>g</mi><mi>i</mi><mi>b</mi><mi>l</mi><mi>e</mi></mrow><mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mrow></msubsup><mo>+</mo><mtext>shipping</mtext></mrow><annotation encoding=\"application/x-tex\">\\sum d_j \\le A^{(0)}_{eligible} + \\text{shipping}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0361em;vertical-align:-0.2861em;\"></span><span class=\"mop op-symbol small-op\" style=\"position:relative;top:0em;\">∑</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≤</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.4822em;vertical-align:-0.4374em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">A</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0448em;\"><span style=\"top:-2.3987em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">e</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">i</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">g</span><span class=\"mord mathnormal mtight\">ib</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal mtight\">e</span></span></span></span><span style=\"top:-3.2198em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mopen mtight\">(</span><span class=\"mord mtight\">0</span><span class=\"mclose mtight\">)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4374em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">shipping</span></span></span></span></span></span>，且实付 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>=</mo><mi>max</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo separator=\"true\">,</mo><mtext>应付</mtext><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">= \\max(0, \\text{应付})</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.3669em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\">max</span><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">应付</span></span><span class=\"mclose\">)</span></span></span></span></span>。不管叠加配置多离谱，这条不变式保证平台不会倒贴。上限是否用&quot;订单金额&quot;作基，取决于是否允许&quot;券抵运费&quot;，这应是平台级配置。</p>\n<h2 id=\"冲突检测-在发布时而非算价时暴露问题\">冲突检测：在发布时而非算价时暴露问题</h2><p>叠加配置错了，最坏的发现时机是大促当天用户在群里晒 0 元单。所以在活动<strong>发布</strong>时就要做静态检测：</p>\n<table>\n<thead>\n<tr>\n<th>检测项</th>\n<th>规则</th>\n<th>处置</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>自相矛盾</td>\n<td>同一活动既在 <code>canStackWith</code> 又在 <code>cannotStackWith</code> 出现某组</td>\n<td>拒绝发布</td>\n</tr>\n<tr>\n<td>全互斥冲突</td>\n<td>两个组都声明&quot;不可与任何组叠加&quot;</td>\n<td>拒绝发布</td>\n</tr>\n<tr>\n<td>组合超额</td>\n<td>最大可能叠加额 &gt; 订单金额 × 阈值（如 90%）</td>\n<td>告警，人工确认</td>\n</tr>\n<tr>\n<td>平手重复</td>\n<td>同组内 <code>priority</code> 完全相同的活动数 &gt; 1</td>\n<td>告警（依赖平手规则兜底）</td>\n</tr>\n<tr>\n<td>时间窗重叠检查</td>\n<td>高优先级活动与低优先级活动时间几乎全重合</td>\n<td>提示运营，可能后者永远不生效</td>\n</tr>\n</tbody></table>\n<p>最后一项特别值得做：如果活动 A 的 <code>priority</code> 高于 B、<code>exclusiveGroup</code> 相同、时间窗又被 A 完全覆盖，那么 B 实际上<strong>永远不会生效</strong>——运营花了预算配了个死活动。这个检测成本很低（区间包含判断），收益是直接避免无效投放。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>叠加约束分三层：<strong>硬互斥（组）</strong>、<strong>类型上限</strong>、<strong>优先级（含计算次序）</strong>；组比两两枚举少一个数量级的规则量。</li>\n<li><code>exclusiveGroup</code> 表达&quot;同组最多生效一个&quot;，未声明组的活动默认可与所有组叠加。</li>\n<li><code>priority</code> 双职责：冲突时决定谁生效、计算时决定谁先算；必须定义稳定平手规则（<code>priority</code> 降序 + <code>promotionId</code> 升序）以保证结果可复现。</li>\n<li>计算次序改变最终金额，推荐次序&quot;底价 → 折扣 → 满减 → 券 → 赠品&quot;，并显式配置每类读原始价还是剩余价。</li>\n<li>组间默认可叠，例外才用 <code>canStackWith</code>/<code>cannotStackWith</code>，并设<strong>总减免上限</strong>兜底：实付不低于 0。</li>\n<li>冲突在<strong>发布时</strong>静态检测（含&quot;永远不生效的死活动&quot;），而不是等大促当天由用户发现。</li>\n</ul>\n","headings":[{"level":1,"text":"叠加与互斥规则表达","id":"叠加与互斥规则表达"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"互斥组：把\"不能同用\"变成一维划分","id":"互斥组-把-不能同用-变成一维划分"},{"level":2,"text":"计算顺序：优先级如何影响最终金额","id":"计算顺序-优先级如何影响最终金额"},{"level":2,"text":"可叠加矩阵：从\"两两枚举\"退到\"组间默认\"","id":"可叠加矩阵-从-两两枚举-退到-组间默认"},{"level":2,"text":"冲突检测：在发布时而非算价时暴露问题","id":"冲突检测-在发布时而非算价时暴露问题"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"适用门槛、人群与商品范围","url":"/l-doc-books/h/backend-engineering/promotion-pricing-engine/promotion-model/eligibility-rule"},"next":{"title":"商品价→活动→券→实付的阶段","url":"/l-doc-books/h/backend-engineering/promotion-pricing-engine/pricing-pipeline/pricing-stages"}}