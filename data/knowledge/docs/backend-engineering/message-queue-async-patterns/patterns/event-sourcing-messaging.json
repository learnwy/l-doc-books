E1E4E8\"> r.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">insertOutbox</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(tx, e); err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Outbox 轮询器再将 outbox 表中的事件异步发布到 Kafka/RabbitMQ，与<a href=\"../engineering/backpressure-flow-control\">背压与流量控制</a>中的发布速率控制结合。</p>\n<h2 id=\"小结\">小结</h2><p>事件溯源将系统状态的持久化从「保存最新值」转变为「保存变化历史」，赋予系统完整的审计轨迹和时间穿越能力。结合 CQRS 和消息队列，可以构建读写完全解耦、多模型并存的高弹性架构。核心约束是事件不可变性与投影幂等性，快照用于优化长流重建性能。</p>\n","headings":[{"level":1,"text":"事件溯源与消息系统集成","id":"事件溯源与消息系统集成"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"事件溯源工作流","id":"事件溯源工作流"},{"level":2,"text":"聚合根与事件重建","id":"聚合根与事件重建"},{"level":2,"text":"与 CQRS 的结合","id":"与-cqrs-的结合"},{"level":2,"text":"快照优化","id":"快照优化"},{"level":2,"text":"事件版本演进","id":"事件版本演进"},{"level":2,"text":"常见反模式","id":"常见反模式"},{"level":2,"text":"与消息队列集成的技术要点","id":"与消息队列集成的技术要点"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Saga 模式：分布式事务的编排与协作","url":"/l-doc-books/h/backend-engineering/message-queue-async-patterns/patterns/saga-choreography"},"next":{"title":"死信队列与消息错误处理","url":"/l-doc