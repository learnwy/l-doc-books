pan style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"e2e_latency\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Since</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(publishedAt)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h2 id=\"消息流水线可视化\">消息流水线可视化</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    P[生产者发布] --&gt;|记录 published_at| K[(Kafka)]&#10;    K --&gt;|Consumer Poll| C[消费者处理]&#10;    C --&gt;|处理成功| S[ACK + 记录 processed_at]&#10;    C --&gt;|处理失败| R[重试队列]&#10;    R --&gt;|超出重试次数| D[DLQ]&#10;    D --&gt;|告警| A[监控告警]&#10;&#10;    S --&gt; M[Prometheus 指标\\ne2e_latency / success_rate]&#10;    D --&gt; M2[DLQ 深度指标\\ndlq_depth]\">flowchart TD\n    P[生产者发布] --&gt;|记录 published_at| K[(Kafka)]\n    K --&gt;|Consumer Poll| C[消费者处理]\n    C --&gt;|处理成功| S[ACK + 记录 processed_at]\n    C --&gt;|处理失败| R[重试队列]\n    R --&gt;|超出重试次数| D[DLQ]\n    D --&gt;|告警| A[监控告警]\n\n    S --&gt; M[Prometheus 指标\\ne2e_latency / success_rate]\n    D --&gt; M2[DLQ 深度指标\\ndlq_depth]</pre><h2 id=\"端到端延迟追踪\">端到端延迟追踪</h2><p>通过在消息 payload 或 header 中嵌入生产时间戳，消费者可以计算精确的端到端延迟：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"// 消息 Header 中写入生产时间&#10;kafka.Header{&#10;    Key:   &quot;x-published-at&quot;,&#10;    Value: []byte(strconv.FormatInt(time.Now().UnixMilli(), 10)),&#10;}&#10;&#10;// 消费者计算 E2E 延迟&#10;publishedAt := extractPublishedAt(msg.Headers)&#10;e2eLatency := time.Since(publishedAt)&#10;messageLatency.WithLabelValues(msg.Topic, consumerGroup).Observe(e2eLatency.Seconds())&#10;&#10;if e2eLatency &gt; 30*time.Second {&#10;    logger.Warn(&quot;消息处理延迟超过 30 秒&quot;,&#10;        zap.Duration(&quot;e2e_latency&quot;, e2eLatency),&#10;        zap.String(&quot;message_id&quot;, extractMsgID(msg.Headers)),&#10;    )&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 消息 Header 中写入生产时间</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kafka</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Header</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Key:   </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"x-published-at\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Value: []</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">byte</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(strconv.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">FormatInt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">UnixMilli</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 消费者计算 E2E 延迟</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">publishedAt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> extractPublishedAt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(msg.Headers)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">e2eLatency </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Since</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(publishedAt)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">messageLatency.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithLabelValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(msg.Topic, consumerGroup).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Observe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e2eLatency.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Seconds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e2eLatency </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 30</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">time.Second {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    logger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Warn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"消息处理延迟超过 30 秒\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        zap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Duration</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"e2e_latency\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, e2eLatency),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        zap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"message_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extractMsgID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(msg.Headers)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"告警规则配置\">告警规则配置</h2><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"groups:&#10;  - name: async_system_alerts&#10;    rules:&#10;      - alert: KafkaConsumerLagHigh&#10;        expr: kafka_consumer_group_lag &gt; 10000&#10;        for: 5m&#10;        labels:&#10;          severity: warning&#10;&#10;      - alert: DLQHasMessages&#10;        expr: kafka_consumer_group_lag{topic=~&quot;.*\\\\.dlq&quot;} &gt; 0&#10;        for: 1m&#10;        labels:&#10;          severity: critical&#10;&#10;      - alert: MessageE2ELatencyHigh&#10;        expr: histogram_quantile(0.99, message_e2e_latency_seconds_bucket) &gt; 30&#10;        for: 5m&#10;        labels:&#10;          severity: warning\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">groups</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">async_system_alerts</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    rules</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">alert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">KafkaConsumerLagHigh</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        expr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">kafka_consumer_group_lag > 10000</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">5m</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        labels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          severity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">warning</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">alert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">DLQHasMessages</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        expr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">kafka_consumer_group_lag{topic=~\".*\\\\.dlq\"} > 0</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">1m</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        labels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          severity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">critical</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">alert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">MessageE2ELatencyHigh</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        expr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">histogram_quantile(0.99, message_e2e_latency_seconds_bucket) > 30</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">5m</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        labels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          severity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">warning</span></span></code></pre></div><p>与<a href=\"backpressure-flow-control\">背压与流量控制</a>的 Lag 监控联动，构建完整的可观测性体系；与<a href=\"../patterns/dead-letter-queue\">死信队列与错误处理</a>中的 DLQ 监控对接。</p>\n<h2 id=\"小结\">小结</h2><p>异步系统可观测性的核心是三件事：Trace 上下文随消息传播（让链路可追踪）、关键指标全面覆盖（Lag/DLQ/E2E 延迟）、结构化日志用 message_id 串联。这三者共同将异步系统从黑盒变为透明管道，是快速定位问题的前提。</p>\n","headings":[{"level":1,"text":"异步系统可观测性","id":"异步系统可观测性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"可观测性三支柱在异步系统中的挑战","id":"可观测性三支柱在异步系统中的挑战"},{"level":2,"text":"分布式追踪与消息传播","id":"分布式追踪与消息传播"},{"level":2,"text":"关键消息指标","id":"关键消息指标"},{"level":2,"text":"结构化消息日志","id":"结构化消息日志"},{"level":2,"text":"消息流水线可视化","id":"消息流水线可视化"},{"level":2,"text":"端到端延迟追踪","id":"端到端延迟追踪"},{"level":2,"text":"告警规则配置","id":"告警规则配置"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"消息 Schema 演进策略","url":"/l-doc-books/h/backend-engineering/message-queue-async-patterns/engineering/message-schema-evolution"},"next":null}