color:#E36209;--shiki-dark:#FFAB70\">span</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Span</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> tenant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCurrentTenant</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (tenant) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      span.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setAttribute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'tenant.id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, tenant.tenantId);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"按租户采样策略\">按租户采样策略</h3><p>全量追踪在高流量下成本过高。按租户差异化采样：</p>\n<table>\n<thead>\n<tr>\n<th>租户类型</th>\n<th>采样率</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Enterprise 客户</td>\n<td>100%</td>\n<td>SLA 承诺需要完整追踪</td>\n</tr>\n<tr>\n<td>Business 客户</td>\n<td>10%</td>\n<td>足够诊断常见问题</td>\n</tr>\n<tr>\n<td>Free 用户</td>\n<td>1%</td>\n<td>仅用于整体趋势</td>\n</tr>\n<tr>\n<td>出错请求</td>\n<td>100%（所有租户）</td>\n<td>错误必须可追踪</td>\n</tr>\n<tr>\n<td>慢请求（&gt;P95）</td>\n<td>100%（所有租户）</td>\n<td>性能问题必须可诊断</td>\n</tr>\n</tbody></table>\n<h2 id=\"租户健康度仪表盘\">租户健康度仪表盘</h2><p>综合指标计算每个租户的实时健康分数：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    M1[错误率&lt;br/&gt;权重 30%] --&gt; SCORE[健康分数&lt;br/&gt;0-100]&#10;    M2[延迟 P99&lt;br/&gt;权重 25%] --&gt; SCORE&#10;    M3[配额使用率&lt;br/&gt;权重 20%] --&gt; SCORE&#10;    M4[可用性&lt;br/&gt;权重 25%] --&gt; SCORE&#10;&#10;    SCORE --&gt;|&gt; 90| GREEN[健康]&#10;    SCORE --&gt;|70-90| YELLOW[关注]&#10;    SCORE --&gt;|&lt; 70| RED[异常&lt;br/&gt;自动触发诊断]\">graph LR\n    M1[错误率&lt;br/&gt;权重 30%] --&gt; SCORE[健康分数&lt;br/&gt;0-100]\n    M2[延迟 P99&lt;br/&gt;权重 25%] --&gt; SCORE\n    M3[配额使用率&lt;br/&gt;权重 20%] --&gt; SCORE\n    M4[可用性&lt;br/&gt;权重 25%] --&gt; SCORE\n\n    SCORE --&gt;|&gt; 90| GREEN[健康]\n    SCORE --&gt;|70-90| YELLOW[关注]\n    SCORE --&gt;|&lt; 70| RED[异常&lt;br/&gt;自动触发诊断]</pre><p>健康分数低于阈值时自动触发的动作：</p>\n<table>\n<thead>\n<tr>\n<th>健康分数</th>\n<th>自动动作</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>&lt; 70</td>\n<td>创建告警工单 + 通知值班 SRE</td>\n</tr>\n<tr>\n<td>&lt; 50</td>\n<td>自动扩容该租户关联的资源</td>\n</tr>\n<tr>\n<td>&lt; 30</td>\n<td>触发降级策略（关闭非核心功能）</td>\n</tr>\n<tr>\n<td>= 0</td>\n<td>判定为故障，进入 incident 流程</td>\n</tr>\n</tbody></table>\n<h2 id=\"成本分摊与可视化\">成本分摊与可视化</h2><p>多租户平台需要回答「每个租户到底消耗了多少成本」，用于定价优化和内部成本核算：</p>\n<table>\n<thead>\n<tr>\n<th>资源维度</th>\n<th>计量方式</th>\n<th>分摊模型</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>计算（CPU 时间）</td>\n<td>按请求处理耗时加权</td>\n<td>按比例分摊到租户</td>\n</tr>\n<tr>\n<td>存储（磁盘空间）</td>\n<td>定时扫描租户数据量</td>\n<td>直接归属</td>\n</tr>\n<tr>\n<td>网络（出入带宽）</td>\n<td>按请求/响应字节数</td>\n<td>直接归属</td>\n</tr>\n<tr>\n<td>缓存（内存占用）</td>\n<td>按 key 前缀统计</td>\n<td>按比例分摊</td>\n</tr>\n<tr>\n<td>第三方 API</td>\n<td>按调用次数</td>\n<td>直接归属</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface TenantCostReport {&#10;  tenantId: string;&#10;  period: { start: Date; end: Date };&#10;  breakdown: {&#10;    compute: { units: number; cost: number };&#10;    storage: { bytes: number; cost: number };&#10;    network: { bytesIn: number; bytesOut: number; cost: number };&#10;    thirdParty: { calls: number; cost: number };&#10;  };&#10;  totalCost: number;&#10;  revenue: number; // 该租户的付费金额&#10;  margin: number; // revenue - totalCost&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TenantCostReport</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  tenantId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  period</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">start</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">end</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  breakdown</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    compute</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><s