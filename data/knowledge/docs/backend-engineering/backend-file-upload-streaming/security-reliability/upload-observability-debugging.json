span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tracer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">startActiveSpan</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'upload.store'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">storeSpan</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> storeToS3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(file);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          storeSpan.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setAttribute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'storage.key'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, result.key);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          storeSpan.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        span.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ code: SpanStatusCode.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">OK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (err) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        span.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ code: SpanStatusCode.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ERROR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, message: err.message });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        span.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">recordException</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(err);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">finally</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        span.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"客户端-trace-关联\">客户端 Trace 关联</h3><p>要实现端到端追踪，客户端需要在上传请求中传递 trace context：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 客户端&#10;const traceId = generateTraceId();&#10;await fetch(&#39;/api/upload&#39;, {&#10;  method: &#39;POST&#39;,&#10;  headers: {&#10;    traceparent: `00-${traceId}-${spanId}-01`,&#10;  },&#10;  body: formData,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 客户端</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> traceId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateTraceId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/upload'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'POST'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  headers: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    traceparent: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`00-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">traceId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}-${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">spanId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}-01`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  body: formData,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"告警策略\">告警策略</h2><table>\n<thead>\n<tr>\n<th>告警规则</th>\n<th>条件</th>\n<th>严重度</th>\n<th>响应</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>上传成功率下降</td>\n<td>success_rate &lt; 95% for 5min</td>\n<td>P1</td>\n<td>立即排查</td>\n</tr>\n<tr>\n<td>P99 延迟飙升</td>\n<td>p99_latency &gt; 30s for 5min</td>\n<td>P2</td>\n<td>检查网络/存储</td>\n</tr>\n<tr>\n<td>存储写入错误</td>\n<td>s3_errors &gt; 10/min</td>\n<td>P1</td>\n<td>检查 S3 状态</td>\n</tr>\n<tr>\n<td>磁盘空间不足</td>\n<td>tmp_disk_usage &gt; 85%</td>\n<td>P2</td>\n<td>扩容/清理</td>\n</tr>\n<tr>\n<td>并发上传达上限</td>\n<td>active_uploads &gt; 90% capacity</td>\n<td>P3</td>\n<td>准备扩容</td>\n</tr>\n<tr>\n<td>异常大文件</td>\n<td>file_size &gt; 1GB &amp;&amp; user=free</td>\n<td>P3</td>\n<td>检查限流</td>\n</tr>\n</tbody></table>\n<h2 id=\"常见问题排查指南\">常见问题排查指南</h2><h3 id=\"问题-上传超时但服务端无日志\">问题：上传超时但服务端无日志</h3><p>排查路径：</p>\n<ol>\n<li>检查负载均衡超时配置（<code>proxy_read_timeout</code>）</li>\n<li>确认 Nginx <code>client_body_timeout</code> 足够大</li>\n<li>查看 CDN/WAF 层是否有请求体大小限制</li>\n<li>检查客户端网络质量（通过 traceId 关联 CDN 日志）</li>\n</ol>\n<h3 id=\"问题-上传成功但文件损坏\">问题：上传成功但文件损坏</h3><p>排查路径：</p>\n<ol>\n<li>比对上传侧与存储侧的 checksum</li>\n<li>检查 multipart 解析是否正确处理 binary content-type</li>\n<li>确认中间代理未对 body 做 charset 转换</li>\n<li>检查分片合并顺序是否正确</li>\n</ol>\n<h3 id=\"问题-间歇性-5xx-错误\">问题：间歇性 5xx 错误</h3><p>排查路径：</p>\n<ol>\n<li>关联 traceId 定位具体失败 span</li>\n<li>检查 S3/GCS 对应时间段的服务状态</li>\n<li>查看是否触发了限流（429 被误分类为 5xx）</li>\n<li>检查临时存储磁盘是否间歇性满</li>\n</ol>\n<h2 id=\"运维仪表盘\">运维仪表盘</h2><p>推荐构建的仪表盘面板：</p>\n<table>\n<thead>\n<tr>\n<th>面板</th>\n<th>包含指标</th>\n<th>刷新间隔</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>概览</td>\n<td>成功率、总请求数、P50/P99 延迟</td>\n<td>10s</td>\n</tr>\n<tr>\n<td>容量</td>\n<td>活跃上传数、带宽利用率、磁盘使用</td>\n<td>10s</td>\n</tr>\n<tr>\n<td>错误</td>\n<td>按错误码分布、Top 10 失败用户</td>\n<td>30s</td>\n</tr>\n<tr>\n<td>存储</td>\n<td>S3 操作延迟、重试率、限流计数</td>\n<td>30s</td>\n</tr>\n<tr>\n<td>安全</td>\n<td>拒绝请求数、病毒检出数、异常 IP</td>\n<td>1min</td>\n</tr>\n</tbody></table>\n<p>关于具体如何实施限流以保护上传服务容量，参见 <a href=\"upload-rate-limiting-quota\">上传限流与配额管理</a>。关于上传入口的安全校验如何产生可观测事件，参见 <a href=\"upload-validation-scanning\">上传校验与病毒扫描</a>。</p>\n<h2 id=\"小结\">小结</h2><p>上传可观测性的核心是「让每次上传的完整生命周期可追踪」。三大支柱中，指标提供实时健康信号和告警依据，结构化日志支撑事后排查，分布式追踪实现跨组件根因定位。关键实践：按阶段拆分延迟指标定位瓶颈、对失败/慢/大文件上传 100% 采样、通过 traceparent 头实现客户端到存储端的 trace 关联、构建分层告警策略（P1 成功率下降→P2 延迟飙升→P3 容量预警）。</p>\n","headings":[{"level":1,"text":"上传可观测性与问题排查","id":"上传可观测性与问题排查"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"可观测性三支柱","id":"可观测性三支柱"},{"level":2,"text":"关键指标设计","id":"关键指标设计"},{"level":3,"text":"上传服务 RED 指标","id":"上传服务-red-指标"},{"level":3,"text":"分阶段延迟拆分","id":"分阶段延迟拆分"},{"level":2,"text":"结构化日志","id":"结构化日志"},{"level":3,"text":"上传事件日志 Schema","id":"上传事件日志-schema"},{"level":3,"text":"关键日志事件","id":"关键日志事件"},{"level":3,"text":"日志采样策略","id":"日志采样策略"},{"level":2,"text":"分布式链路追踪","id":"分布式链路追踪"},{"level":3,"text":"Span 结构设计","id":"span-结构设计"},{"level":3,"text":"客户端 Trace 关联","id":"客户端-trace-关联"},{"level":2,"text":"告警策略","id":"告警策略"},{"level":2,"text":"常见问题排查指南","id":"常见问题排查指南"},{"level":3,"text":"问题：上传超时但服务端无日志","id":"问题-上传超时但服务端无日志"},{"level":3,"text":"问题：上传成功但文件损坏","id":"问题-上传成功但文件损坏"},{"level":3,"text":"问题：间歇性 5xx 错误","id":"问题-间歇性-5xx-错误"},{"level":2,"text":"运维仪表盘","id":"运维仪表盘"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"上传限流与配额管理","url":"/l-doc-books/h/backend-engineering/backend-file-upload-streaming/security-reliability/upload-rate-limiting-quota"},"next":null}