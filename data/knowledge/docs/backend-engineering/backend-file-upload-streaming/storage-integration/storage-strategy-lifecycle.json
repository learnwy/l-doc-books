k:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"ID\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"CleanupTempFiles\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Enabled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Filter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"Prefix\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tmp/\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Expiration\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"Days\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"ID\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"AbortIncompleteUploads\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Enabled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Filter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {},</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"AbortIncompleteMultipartUpload\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"DaysAfterInitiation\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"ID\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"CleanupOldVersions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Enabled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"Filter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {},</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"NoncurrentVersionExpiration\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"NoncurrentDays\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">30</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"NoncurrentVersionTransitions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [{ </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"NoncurrentDays\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"StorageClass\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"STANDARD_IA\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"关键规则设计\">关键规则设计</h3><table>\n<thead>\n<tr>\n<th>规则类型</th>\n<th>作用</th>\n<th>推荐配置</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Transition</td>\n<td>自动降级存储类别</td>\n<td>30d→IA, 90d→Glacier</td>\n</tr>\n<tr>\n<td>Expiration</td>\n<td>自动删除过期对象</td>\n<td>tmp/ 前缀 7 天过期</td>\n</tr>\n<tr>\n<td>AbortIncompleteMultipartUpload</td>\n<td>清理未完成分片</td>\n<td>3 天后自动清理</td>\n</tr>\n<tr>\n<td>NoncurrentVersionExpiration</td>\n<td>删除旧版本</td>\n<td>30 天后删除非当前版本</td>\n</tr>\n<tr>\n<td>ExpiredObjectDeleteMarker</td>\n<td>清理删除标记</td>\n<td>启用（减少 LIST 开销）</td>\n</tr>\n</tbody></table>\n<h2 id=\"版本管理策略\">版本管理策略</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    Put1[PUT v1] --&gt; Current[当前版本 v3]&#10;    Put2[PUT v2] --&gt; NC1[非当前版本 v2]&#10;    Put3[PUT v3] --&gt; Current&#10;    NC1 --&gt; |30天后| IA[Standard-IA]&#10;    NC1 --&gt; |90天后| Del[永久删除]&#10;    Delete[DELETE 请求] --&gt; DM[删除标记]&#10;    DM --&gt; |7天后| Purge[清理标记]\">graph TD\n    Put1[PUT v1] --&gt; Current[当前版本 v3]\n    Put2[PUT v2] --&gt; NC1[非当前版本 v2]\n    Put3[PUT v3] --&gt; Current\n    NC1 --&gt; |30天后| IA[Standard-IA]\n    NC1 --&gt; |90天后| Del[永久删除]\n    Delete[DELETE 请求] --&gt; DM[删除标记]\n    DM --&gt; |7天后| Purge[清理标记]</pre><p>版本控制的三种策略：</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>适用场景</th>\n<th>配置</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>全量保留</td>\n<td>合规要求、审计追溯</td>\n<td>不设 NoncurrentVersionExpiration</td>\n</tr>\n<tr>\n<td>有限保留</td>\n<td>一般业务（误删恢复）</td>\n<td>保留 3-5 个版本或 30 天</td>\n</tr>\n<tr>\n<td>仅当前版本</td>\n<td>临时文件、缓存</td>\n<td>不启用版本控制</td>\n</tr>\n</tbody></table>\n<h2 id=\"intelligent-tiering-自动分层\">Intelligent-Tiering 自动分层</h2><p>AWS S3 Intelligent-Tiering 根据对象的访问模式自动在存储层间迁移，无需手动编写规则：</p>\n<table>\n<thead>\n<tr>\n<th>访问层</th>\n<th>触发条件</th>\n<th>对象首字节延迟</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Frequent Access</td>\n<td>默认/被访问</td>\n<td>毫秒</td>\n</tr>\n<tr>\n<td>Infrequent Access</td>\n<td>30 天未访问</td>\n<td>毫秒</td>\n</tr>\n<tr>\n<td>Archive Instant Access</td>\n<td>90 天未访问</td>\n<td>毫秒</td>\n</tr>\n<tr>\n<td>Archive Access</td>\n<td>90 天未访问（opt-in）</td>\n<td>3-5 小时</td>\n</tr>\n<tr>\n<td>Deep Archive Access</td>\n<td>180 天未访问（opt-in）</td>\n<td>12-48 小时</td>\n</tr>\n</tbody></table>\n<p>监控费为 $0.0025/千对象/月。对于访问模式不可预测的工作负载（如用户上传的文件），Intelligent-Tiering 可以替代手动 Lifecycle 规则，平均节省 40-60% 存储成本。</p>\n<h2 id=\"不完整上传清理\">不完整上传清理</h2><p>分片上传的不完整碎片是存储浪费的重大来源。一个中断的 10 GB 上传可能留下数百 MB 的孤立分片，且不会出现在 ListObjects 结果中。</p>\n<h3 id=\"发现孤立分片\">发现孤立分片</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"aws s3api list-multipart-uploads --bucket my-bucket\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">aws</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> s3api</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> list-multipart-uploads</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --bucket</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> my-bucket</span></span></code></pre></div><h3 id=\"自动清理-生命周期规则\">自动清理（生命周期规则）</h3><p>如上文 <code>AbortIncompleteMultipartUpload</code> 配置所示，建议对所有 Bucket 设置 3-7 天的自动清理策略。</p>\n<h3 id=\"主动清理-应用层\">主动清理（应用层）</h3><p>应用服务器在上传超时后主动调用 AbortMultipartUpload：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"async function cleanupStaledUploads(bucket: string, maxAge: number) {&#10;  const { Uploads } = await s3.send(new ListMultipartUploadsCommand({ Bucket: bucket }));&#10;&#10;  const staleUploads = (Uploads ?? []).filter((u) =&gt; Date.now() - u.Initiated!.getTime() &gt; maxAge);&#10;&#10;  await Promise.all(&#10;    staleUploads.map((u) =&gt;&#10;      s3.send(&#10;        new AbortMultipartUploadCommand({&#10;          Bucket: bucket,&#10;          Key: u.Key!,&#10;          UploadId: u.UploadId!,&#10;        }),&#10;      ),&#10;    ),&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cleanupStaledUploads</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">bucket</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">maxAge</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Uploads</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s3.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ListMultipartUploadsCommand</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ Bucket: bucket }));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> staleUploads</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Uploads </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> u.Initiated</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxAge);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">all</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    staleUploads.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      s3.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AbortMultipartUploadCommand</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          Bucket: bucket,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          Key: u.Key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          UploadId: u.UploadId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关于分片上传的完整协议细节，参见 <a href=\"../upload-fundamentals/chunked-resumable-upload\">分片与断点续传</a>。</p>\n<h2 id=\"成本监控与优化\">成本监控与优化</h2><h3 id=\"s3-storage-lens\">S3 Storage Lens</h3><p>S3 Storage Lens 提供跨 Bucket、跨区域的存储使用分析仪表盘。关注指标：</p>\n<ul>\n<li><strong>存储利用率</strong>：各 Bucket 的对象数量与总大小趋势</li>\n<li><strong>不完整分片占比</strong>：高比例表示应用层清理机制不健全</li>\n<li><strong>非当前版本占比</strong>：高比例表示版本策略过于宽松</li>\n<li><strong>存储类别分布</strong>：Hot 占比高可能意味着 Lifecycle 规则缺失</li>\n</ul>\n<h3 id=\"成本分配标签\">成本分配标签</h3><p>通过标签实现成本归属到业务线/项目：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"await s3.send(&#10;  new PutObjectCommand({&#10;    Bucket: BUCKET,&#10;    Key: key,&#10;    Body: body,&#10;    Tagging: &#39;team=avatar&amp;project=user-profile&amp;env=prod&#39;,&#10;  }),&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s3.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PutObjectCommand</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Bucket: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">BUCKET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Key: key,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Body: body,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Tagging: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'team=avatar&#x26;project=user-profile&#x26;env=prod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"数据保护与合规\">数据保护与合规</h2><h3 id=\"object-lock-worm\">Object Lock（WORM）</h3><p>对于合规要求不可删改的数据（如金融凭证、医疗记录），使用 Object Lock：</p>\n<table>\n<thead>\n<tr>\n<th>模式</th>\n<th>特性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Governance</td>\n<td>特权用户可覆盖</td>\n</tr>\n<tr>\n<td>Compliance</td>\n<td>任何人都不可删改，直到保留期到</td>\n</tr>\n</tbody></table>\n<h3 id=\"服务端加密\">服务端加密</h3><table>\n<thead>\n<tr>\n<th>方案</th>\n<th>密钥管理</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SSE-S3</td>\n<td>AWS 托管</td>\n<td>默认选择</td>\n</tr>\n<tr>\n<td>SSE-KMS</td>\n<td>AWS KMS 托管，可审计</td>\n<td>合规需求</td>\n</tr>\n<tr>\n<td>SSE-C</td>\n<td>客户提供密钥</td>\n<td>完全控制</td>\n</tr>\n<tr>\n<td>客户端加密</td>\n<td>应用层管理</td>\n<td>零信任架构</td>\n</tr>\n</tbody></table>\n<p>关于 CDN 如何与存储策略协作实现全球分发，参见 <a href=\"cdn-origin-optimization\">CDN 回源与分发优化</a>。</p>\n<h2 id=\"小结\">小结</h2><p>存储策略与生命周期管理是控制长期存储成本的核心杠杆。关键实践包括：为所有 Bucket 设置 AbortIncompleteMultipartUpload 规则清理孤立分片、按访问模式选择存储类别或启用 Intelligent-Tiering、控制版本保留数量避免存储膨胀、通过 Storage Lens 持续监控成本分布。对于访问模式不可预测的用户上传文件，Intelligent-Tiering 是比手动 Lifecycle 更省心的选择。</p>\n","headings":[{"level":1,"text":"存储策略与生命周期管理","id":"存储策略与生命周期管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"存储类别体系","id":"存储类别体系"},{"level":2,"text":"生命周期规则","id":"生命周期规则"},{"level":3,"text":"S3 Lifecycle Configuration","id":"s3-lifecycle-configuration"},{"level":3,"text":"关键规则设计","id":"关键规则设计"},{"level":2,"text":"版本管理策略","id":"版本管理策略"},{"level":2,"text":"Intelligent-Tiering 自动分层","id":"intelligent-tiering-自动分层"},{"level":2,"text":"不完整上传清理","id":"不完整上传清理"},{"level":3,"text":"发现孤立分片","id":"发现孤立分片"},{"level":3,"text":"自动清理（生命周期规则）","id":"自动清理-生命周期规则"},{"level":3,"text":"主动清理（应用层）","id":"主动清理-应用层"},{"level":2,"text":"成本监控与优化","id":"成本监控与优化"},{"level":3,"text":"S3 Storage Lens","id":"s3-storage-lens"},{"level":3,"text":"成本分配标签","id":"成本分配标签"},{"level":2,"text":"数据保护与合规","id":"数据保护与合规"},{"level":3,"text":"Object Lock（WORM）","id":"object-lock-worm"},{"level":3,"text":"服务端加密","id":"服务端加密"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"对象存储集成（S3/GCS/OSS）","url":"/l-doc-books/h/backend-engineering/backend-file-upload-streaming/storage-integration/object-storage-s3-gcs"},"next":{"title":"CDN 回源与分发优化","url":"/l-doc-books/h/backend-engineering/backend-file-upload-streaming/storage-integration/cdn-origin-optimization"}}