209;--shiki-dark:#FFAB70\">parts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PartResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    App[业务代码] --&gt; Interface[ObjectStorage 接口]&#10;    Interface --&gt; S3Impl[S3 实现]&#10;    Interface --&gt; GCSImpl[GCS 实现]&#10;    Interface --&gt; OSSImpl[OSS 实现]&#10;    Interface --&gt; LocalImpl[本地文件系统实现 - 开发环境]\">graph TD\n    App[业务代码] --&gt; Interface[ObjectStorage 接口]\n    Interface --&gt; S3Impl[S3 实现]\n    Interface --&gt; GCSImpl[GCS 实现]\n    Interface --&gt; OSSImpl[OSS 实现]\n    Interface --&gt; LocalImpl[本地文件系统实现 - 开发环境]</pre><h3 id=\"aws-s3-sdk-v3-最佳实践\">AWS S3 SDK v3 最佳实践</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { S3Client, PutObjectCommand } from &#39;@aws-sdk/client-s3&#39;;&#10;import { Upload } from &#39;@aws-sdk/lib-storage&#39;;&#10;&#10;const s3 = new S3Client({&#10;  region: &#39;us-east-1&#39;,&#10;  // 连接池配置&#10;  requestHandler: new NodeHttpHandler({&#10;    connectionTimeout: 5000,&#10;    socketTimeout: 30000,&#10;    maxSockets: 50,&#10;  }),&#10;});&#10;&#10;// 小文件（&lt; 5GB）：单次 PutObject&#10;async function putSmallObject(key: string, body: Readable, size: number) {&#10;  await s3.send(&#10;    new PutObjectCommand({&#10;      Bucket: BUCKET,&#10;      Key: key,&#10;      Body: body,&#10;      ContentLength: size,&#10;      ChecksumAlgorithm: &#39;CRC32&#39;, // 启用校验&#10;    }),&#10;  );&#10;}&#10;&#10;// 大文件：lib-storage 自动分片&#10;async function putLargeObject(key: string, body: Readable) {&#10;  const upload = new Upload({&#10;    client: s3,&#10;    params: { Bucket: BUCKET, Key: key, Body: body },&#10;    queueSize: 4, // 并发上传 4 个分片&#10;    partSize: 16 * 1024 * 1024, // 16 MB 分片&#10;    leavePartsOnError: false,&#10;  });&#10;&#10;  upload.on(&#39;httpUploadProgress&#39;, (progress) =&gt; {&#10;    console.log(`${progress.loaded}/${progress.total}`);&#10;  });&#10;&#10;  await upload.done();&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { S3Client, PutObjectCommand } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@aws-sdk/client-s3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Upload } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@aws-sdk/lib-storage'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> s3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> S3Client</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  region: </span><span style=\"c