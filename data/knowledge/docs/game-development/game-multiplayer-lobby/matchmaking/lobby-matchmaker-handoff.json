strings.Split(serverAddr, &quot;:&quot;)[0],&#10;        ServerPort: parsePort(serverAddr),&#10;        JoinToken:  joinToken,           // 游戏服务器验证用的一次性 Token&#10;        MatchID:    assignment.GetExtensions().GetMatchID(),&#10;    })&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ls </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">LobbyService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onMatchFound</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">room</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Room</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">assignment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pb</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Assignment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 解析服务器地址</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    serverAddr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> assignment.Connection </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"10.0.1.5:7777\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    joinToken </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> extractJoinToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(assignment.Extensions)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 更新房间状态</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    room.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">transition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(RoomStateInProgress, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"match_found\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    room.ServerAddress </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> serverAddr</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 通知所有玩家连接游戏服务器</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    room.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">broadcast</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GameServerAssignedEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ServerIP:   strings.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Split</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(serverAddr, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\":\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ServerPort: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parsePort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(serverAddr),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        JoinToken:  joinToken,           </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 游戏服务器验证用的一次性 Token</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        MatchID:    assignment.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GetExtensions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GetMatchID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"join-token-的安全设计\">Join Token 的安全设计</h3><p>Join Token 防止非大厅玩家随意连接游戏服务器：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"type GameServerJoinToken struct {&#10;    MatchID    string&#10;    PlayerID   string&#10;    ServerAddr string&#10;    IssuedAt   time.Time&#10;    ExpiresAt  time.Time  // 通常 30 秒，足够客户端建立连接&#10;    Nonce      string     // 防止重放&#10;}&#10;&#10;// 大厅服务用共享密钥（与游戏服务器共享）签名 Token&#10;func issueJoinToken(matchID, playerID, serverAddr string) string {&#10;    token := GameServerJoinToken{&#10;        MatchID:    matchID,&#10;        PlayerID:   playerID,&#10;        ServerAddr: serverAddr,&#10;        IssuedAt:   time.Now(),&#10;        ExpiresAt:  time.Now().Add(30 * time.Second),&#10;        Nonce:      generateNonce(),&#10;    }&#10;    return signJWT(token, sharedSecret)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GameServerJoinToken</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    MatchID    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    PlayerID   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ServerAddr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    IssuedAt   </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">time</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Time</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ExpiresAt  </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">time</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Time</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 通常 30 秒，足够客户端建立连接</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Nonce      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">     // 防止重放</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 大厅服务用共享密钥（与游戏服务器共享）签名 Token</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> issueJoinToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">matchID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">playerID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">serverAddr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    token </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GameServerJoinToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        MatchID:    matchID,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        PlayerID:   playerID,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ServerAddr: serverAddr,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        IssuedAt:   time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ExpiresAt:  time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">30</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.Second),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Nonce:      </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">generateNonce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> signJWT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(token, sharedSecret)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>游戏服务器收到连接请求时验证 Token 有效性（签名正确、未过期、PlayerID 在 MatchID 的参与者列表中）。</p>\n<h2 id=\"服务器分配失败的回退处理\">服务器分配失败的回退处理</h2><p>服务器分配可能失败（Agones Fleet 无可用服务器，需要扩容时间）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"分配失败&#10;    ↓&#10;等待 5 秒 → 重试分配（最多 3 次）&#10;    ↓（仍失败）&#10;取消倒计时，广播&quot;服务器分配失败&quot;通知&#10;    ↓&#10;Room 回退到 WAITING 状态&#10;    ↓&#10;大厅服务通知运维系统（告警）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>分配失败</span></span>\n<span class=\"line\"><span>    ↓</span></span>\n<span class=\"line\"><span>等待 5 秒 → 重试分配（最多 3 次）</span></span>\n<span class=\"line\"><span>    ↓（仍失败）</span></span>\n<span class=\"line\"><span>取消倒计时，广播\"服务器分配失败\"通知</span></span>\n<span class=\"line\"><span>    ↓</span></span>\n<span class=\"line\"><span>Room 回退到 WAITING 状态</span></span>\n<span class=\"line\"><span>    ↓</span></span>\n<span class=\"line\"><span>大厅服务通知运维系统（告警）</span></span></code></pre></div><p>重试间隔应使用指数退避：5s、10s、20s，避免 Agones 扩容期间的惊群效应。</p>\n<h2 id=\"大厅-匹配-服务器分配完整流程图\">大厅→匹配→服务器分配完整流程图</h2><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant L as Lobby Service&#10;    participant OM as Open Match Frontend&#10;    participant Dir as OM Director&#10;    participant Agones as Agones API&#10;    participant GS as Game Server&#10;&#10;    L-&gt;&gt;OM: CreateTicket(players, constraints)&#10;    OM--&gt;&gt;L: ticket_id&#10;&#10;    loop 每 2 秒轮询&#10;        L-&gt;&gt;OM: GetTicket(ticket_id)&#10;        OM--&gt;&gt;L: {status: pending}&#10;    end&#10;&#10;    Dir-&gt;&gt;OM: FetchMatches (Match Function)&#10;    OM--&gt;&gt;Dir: Match {tickets, ...}&#10;    Dir-&gt;&gt;Agones: GameServerAllocation&#10;    Agones--&gt;&gt;Dir: {ip: &quot;10.0.1.5&quot;, port: 7777}&#10;    Dir-&gt;&gt;OM: Assignment(connection, extensions)&#10;&#10;    L-&gt;&gt;OM: GetTicket(ticket_id)&#10;    OM--&gt;&gt;L: {assignment: {connection: &quot;10.0.1.5:7777&quot;}}&#10;&#10;    L-&gt;&gt;L: transition STARTING → IN_PROGRESS&#10;    L-&gt;&gt;GS: (players connect with JoinToken)\">sequenceDiagram\n    participant L as Lobby Service\n    participant OM as Open Match Frontend\n    participant Dir as OM Director\n    participant Agones as Agones API\n    participant GS as Game Server\n\n    L-&gt;&gt;OM: CreateTicket(players, constraints)\n    OM--&gt;&gt;L: ticket_id\n\n    loop 每 2 秒轮询\n        L-&gt;&gt;OM: GetTicket(ticket_id)\n        OM--&gt;&gt;L: {status: pending}\n    end\n\n    Dir-&gt;&gt;OM: FetchMatches (Match Function)\n    OM--&gt;&gt;Dir: Match {tickets, ...}\n    Dir-&gt;&gt;Agones: GameServerAllocation\n    Agones--&gt;&gt;Dir: {ip: \"10.0.1.5\", port: 7777}\n    Dir-&gt;&gt;OM: Assignment(connection, extensions)\n\n    L-&gt;&gt;OM: GetTicket(ticket_id)\n    OM--&gt;&gt;L: {assignment: {connection: \"10.0.1.5:7777\"}}\n\n    L-&gt;&gt;L: transition STARTING → IN_PROGRESS\n    L-&gt;&gt;GS: (players connect with JoinToken)</pre><h2 id=\"小结\">小结</h2><p>大厅与匹配系统的握手通过<strong>标准化 Match Ticket</strong> 完成：大厅提交票据（携带玩家 MMR、地区、约束），轮询状态（每 2 秒，最多 10 分钟），收到 Assignment 后通知玩家连接游戏服务器。Open Match 提供了工业级的票据管理框架，而 Agones 负责游戏服务器的原子分配。Join Token 作为安全凭证，防止非大厅玩家随意连接游戏服务器。服务器分配失败时使用指数退避重试（最多 3 次），超限后房间回退到 WAITING 状态，给玩家重新发起匹配的机会。</p>\n","headings":[{"level":1,"text":"大厅与匹配衔接：票据提交、状态轮询与服务器分配","id":"大厅与匹配衔接-票据提交-状态轮询与服务器分配"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"大厅与匹配系统的职责边界","id":"大厅与匹配系统的职责边界"},{"level":2,"text":"匹配票据（Match Ticket）设计","id":"匹配票据-match-ticket-设计"},{"level":2,"text":"票据提交与状态轮询","id":"票据提交与状态轮询"},{"level":3,"text":"Open Match（Google 开源匹配框架）集成","id":"open-match-google-开源匹配框架-集成"},{"level":3,"text":"取消匹配","id":"取消匹配"},{"level":2,"text":"游戏服务器分配","id":"游戏服务器分配"},{"level":3,"text":"Join Token 的安全设计","id":"join-token-的安全设计"},{"level":2,"text":"服务器分配失败的回退处理","id":"服务器分配失败的回退处理"},{"level":2,"text":"大厅→匹配→服务器分配完整流程图","id":"大厅-匹配-服务器分配完整流程图"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"聊天与语音集成：WebSocket 消息协议、Vivox/Agora/WebRTC SFU","url":"/l-doc-books/h/game-development/game-multiplayer-lobby/features/chat-voice-integration"},"next":{"title":"自定义游戏模式：房主设置、规则校验与密码房间","url":"/l-doc-books/h/game-development/game-multiplayer-lobby/matchmaking/custom-game-modes"}}