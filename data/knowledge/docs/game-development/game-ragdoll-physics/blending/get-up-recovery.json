67-1.833-13.5-5.5S337 184 337 178c0-12.667 15.667-32.333 47-59\nH213l-171-1c-8.667-6-13-12.333-13-19 0-4.667 4.333-11.333 13-20h359\nc-16-25.333-24-45-24-59z\"/></svg></span></span></span></span></span></span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8991em;\"><span style=\"top:-2.453em;margin-left:-0.0359em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">⊤</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.247em;\"><span></span></span></span></span></span></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0785em;\">I</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0785em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.714em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">ω</span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.2355em;\"><span class=\"overlay\" style=\"height:0.714em;width:0.471em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.471em\" height=\"0.714em\" style=\"width:0.471em\" viewBox=\"0 0 471 714\" preserveAspectRatio=\"xMinYMin\"><path d=\"M377 20c0-5.333 1.833-10 5.5-14S391 0 397 0c4.667 0 8.667 1.667 12 5\n3.333 2.667 6.667 9 10 19 6.667 24.667 20.333 43.667 41 57 7.333 4.667 11\n10.667 11 18 0 6-1 10-3 12s-6.667 5-14 9c-28.667 14.667-53.667 35.667-75 63\n-1.333 1.333-3.167 3.5-5.5 6.5s-4 4.833-5 5.5c-1 .667-2.5 1.333-4.5 2s-4.333 1\n-7 1c-4.667 0-9.167-1.833-13.5-5.5S337 184 337 178c0-12.667 15.667-32.333 47-59\nH213l-171-1c-8.667-6-13-12.333-13-19 0-4.667 4.333-11.333 13-20h359\nc-16-25.333-24-45-24-59z\"/></svg></span></span></span></span></span></span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0359em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">)</span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord mathnormal\">ϵ</span><span class=\"mspace\" style=\"margin-right:1em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">持续</span><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">T</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.1389em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">se</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">ttl</span><span class=\"mord mathnormal mtight\">e</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span></div><p>只看瞬时速度不够——布娃娃可能在某一帧恰好速度很低但下一帧又被地形弹起。所以要求低能量<strong>持续</strong>若干帧（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>T</mi><mrow><mi>s</mi><mi>e</mi><mi>t</mi><mi>t</mi><mi>l</mi><mi>e</mi></mrow></msub></mrow><annotation encoding=\"application/x-tex\">T_{settle}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">T</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.1389em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">se</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0197em;\">ttl</span><span class=\"mord mathnormal mtight\">e</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span></span> 常取 0.3–0.5 秒）才判定停稳。许多引擎的刚体&quot;休眠&quot;（sleep）机制本身就基于类似判据，可以直接复用：当整具布娃娃进入休眠，即视为停稳。休眠机制的性能意义在 <a href=\"../practice/ragdoll-performance\">性能与 LOD</a> 详述，这里借用它做停稳信号。</p>\n<h2 id=\"第二步-判断朝向-挑对起身动画\">第二步：判断朝向、挑对起身动画</h2><p>停稳后，角色可能面朝下（趴着）或面朝上（仰躺），两者的起身动作完全不同——趴着要撑地俯身起，仰躺要翻身或直接坐起。所以必须先读出躯干朝向：取骨盆或脊柱刚体的世界变换，看其&quot;背部法线&quot;与世界上方向的夹角。</p>\n<div class=\"math-block\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mover accent=\"true\"><mi>n</mi><mo>⃗</mo></mover><mrow><mi>b</mi><mi>a</mi><mi>c</mi><mi>k</mi></mrow></msub><mo>⋅</mo><mover accent=\"true\"><mrow><mi>u</mi><mi>p</mi></mrow><mo>⃗</mo></mover><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mrow><mo fence=\"true\">{</mo><mtable rowspacing=\"0.36em\" columnalign=\"left left\" columnspacing=\"1em\"><mtr><mtd><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mrow><mi>d</mi><mo>&gt;</mo><mn>0</mn></mrow></mstyle></mtd><mtd><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mtext>仰躺 → 选 getup_back</mtext></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mrow><mi>d</mi><mo>&lt;</mo><mn>0</mn></mrow></mstyle></mtd><mtd><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mtext>面朝下 → 选 getup_front</mtext></mstyle></mtd></mtr></mtable></mrow></mrow><annotation encoding=\"application/x-tex\">d = \\vec{n}_{back} \\cdot \\vec{up}, \\qquad \\begin{cases} d &gt; 0 &amp; \\text{仰躺 → 选 getup\\_back} \\\\ d &lt; 0 &amp; \\text{面朝下 → 选 getup\\_front} \\end{cases}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\">d</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.864em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.714em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\">n</span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.2355em;\"><span class=\"overlay\" style=\"height:0.714em;width:0.471em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.471em\" height=\"0.714em\" style=\"width:0.471em\" viewBox=\"0 0 471 714\" preserveAspectRatio=\"xMinYMin\"><path d=\"M377 20c0-5.333 1.833-10 5.5-14S391 0 397 0c4.667 0 8.667 1.667 12 5\n3.333 2.667 6.667 9 10 19 6.667 24.667 20.333 43.667 41 57 7.333 4.667 11\n10.667 11 18 0 6-1 10-3 12s-6.667 5-14 9c-28.667 14.667-53.667 35.667-75 63\n-1.333 1.333-3.167 3.5-5.5 6.5s-4 4.833-5 5.5c-1 .667-2.5 1.333-4.5 2s-4.333 1\n-7 1c-4.667 0-9.167-1.833-13.5-5.5S337 184 337 178c0-12.667 15.667-32.333 47-59\nH213l-171-1c-8.667-6-13-12.333-13-19 0-4.667 4.333-11.333 13-20h359\nc-16-25.333-24-45-24-59z\"/></svg></span></span></span></span></span></span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">ba</span><span class=\"mord mathnormal mtight\">c</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0315em;\">k</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⋅</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:3em;vertical-align:-1.25em;\"></span><span class=\"mord accent\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.714em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"mord mathnormal\">p</span></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.2355em;\"><span class=\"overlay\" style=\"height:0.714em;width:0.471em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.471em\" height=\"0.714em\" style=\"width:0.471em\" viewBox=\"0 0 471 714\" preserveAspectRatio=\"xMinYMin\"><path d=\"M377 20c0-5.333 1.833-10 5.5-14S391 0 397 0c4.667 0 8.667 1.667 12 5\n3.333 2.667 6.667 9 10 19 6.667 24.667 20.333 43.667 41 57 7.333 4.667 11\n10.667 11 18 0 6-1 10-3 12s-6.667 5-14 9c-28.667 14.667-53.667 35.667-75 63\n-1.333 1.333-3.167 3.5-5.5 6.5s-4 4.833-5 5.5c-1 .667-2.5 1.333-4.5 2s-4.333 1\n-7 1c-4.667 0-9.167-1.833-13.5-5.5S337 184 337 178c0-12.667 15.667-32.333 47-59\nH213l-171-1c-8.667-6-13-12.333-13-19 0-4.667 4.333-11.333 13-20h359\nc-16-25.333-24-45-24-59z\"/></svg></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1944em;\"><span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:2em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size4\">{</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.69em;\"><span style=\"top:-3.69em;\"><span class=\"pstrut\" style=\"height:3.008em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&gt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-2.25em;\"><span class=\"pstrut\" style=\"height:3.008em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.19em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:1em;\"></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.69em;\"><span style=\"top:-3.69em;\"><span class=\"pstrut\" style=\"height:3.008em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord cjk_fallback\">仰躺</span><span class=\"mord\"> → </span><span class=\"mord cjk_fallback\">选</span><span class=\"mord\"> getup_back</span></span></span></span><span style=\"top:-2.25em;\"><span class=\"pstrut\" style=\"height:3.008em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord cjk_fallback\">面朝下</span><span class=\"mord\"> → </span><span class=\"mord cjk_fallback\">选</span><span class=\"mord\"> getup_front</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.19em;\"><span></span></span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span></div><p>同时要读出躯干在水平面的朝向，好让起身后角色面向合理方向。这两个量共同决定从起身动画库里挑哪一段、以及起身完成后角色的落位朝向。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;  A[布娃娃模拟中] --&gt; B{动能持续低于阈值?}&#10;  B --&gt;|否| A&#10;  B --&gt;|是, 判定停稳| C[读骨盆朝向&lt;br/&gt;背法线·up]&#10;  C --&gt; D{朝上还是朝下?}&#10;  D --&gt;|仰躺| E[选 getup_back 动画]&#10;  D --&gt;|面朝下| F[选 getup_front 动画]&#10;  E --&gt; G[对齐: 动画根节点&lt;br/&gt;移到物理骨盆位姿]&#10;  F --&gt; G&#10;  G --&gt; H[姿势匹配淡出&lt;br/&gt;物理→动画 alpha:1→0]&#10;  H --&gt; I[交还动画状态机&lt;br/&gt;角色恢复可控]\">flowchart TD\n  A[布娃娃模拟中] --&gt; B{动能持续低于阈值?}\n  B --&gt;|否| A\n  B --&gt;|是, 判定停稳| C[读骨盆朝向&lt;br/&gt;背法线·up]\n  C --&gt; D{朝上还是朝下?}\n  D --&gt;|仰躺| E[选 getup_back 动画]\n  D --&gt;|面朝下| F[选 getup_front 动画]\n  E --&gt; G[对齐: 动画根节点&lt;br/&gt;移到物理骨盆位姿]\n  F --&gt; G\n  G --&gt; H[姿势匹配淡出&lt;br/&gt;物理→动画 alpha:1→0]\n  H --&gt; I[交还动画状态机&lt;br/&gt;角色恢复可控]</pre><h2 id=\"第三步-根节点对齐-消除-瞬移\">第三步：根节点对齐，消除&quot;瞬移&quot;</h2><p>这是起身最容易穿帮的一步。布娃娃停在世界某个位置、某个朝向，而角色的逻辑根节点（capsule / actor transform）在触发布娃娃时可能停留在原地。若直接播放起身动画，动画会从根节点当前位置放，导致角色&quot;唰&quot;地从地上位置瞬移回根节点位置。</p>\n<p>正确做法是先把<strong>逻辑根节点搬到物理骨盆的位置与水平朝向</strong>，再放起身动画。这样动画的第一帧就恰好贴合布娃娃当前姿态，视觉上连续。搬移时通常只取骨盆的水平位置与偏航角（yaw），忽略俯仰翻滚，因为角色站起后应当竖直。</p>\n<h2 id=\"第四步-姿势匹配的淡出\">第四步：姿势匹配的淡出</h2><p>即便根节点对齐了，起身动画的第一帧姿势也几乎不可能与布娃娃停下时的乱七八糟姿势完全一致。若硬切，角色四肢会瞬间&quot;啪&quot;地弹到动画姿势。解法与淡入对称：用一个从 1 降到 0 的物理权重，让姿势在 0.2–0.4 秒内从&quot;物理停下的姿势&quot;平滑滑向&quot;起身动画第一帧&quot;。更讲究的做法是<strong>姿势匹配</strong>（pose matching）——在起身动画里挑一帧与当前物理姿势最接近的作为起点，减小需要弥合的差距。</p>\n<table>\n<thead>\n<tr>\n<th>恢复环节</th>\n<th>关键量</th>\n<th>常见取值</th>\n<th>失败症状</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>停稳检测</td>\n<td>动能阈值 + 持续时间</td>\n<td>0.3–0.5s</td>\n<td>翻滚中误触发起身</td>\n</tr>\n<tr>\n<td>朝向判断</td>\n<td>背法线·up</td>\n<td>符号</td>\n<td>趴着却放仰起动画</td>\n</tr>\n<tr>\n<td>根节点对齐</td>\n<td>骨盆水平位姿</td>\n<td>yaw only</td>\n<td>起身瞬移</td>\n</tr>\n<tr>\n<td>姿势匹配淡出</td>\n<td>淡出时长 α:1→0</td>\n<td>0.2–0.4s</td>\n<td>起身瞬间四肢弹跳</td>\n</tr>\n</tbody></table>\n<h2 id=\"与主动布娃娃的分工\">与主动布娃娃的分工</h2><p>如果项目用的是 <a href=\"powered-ragdoll\">主动布娃娃</a>，起身可以更优雅：角色本就一直被马达驱向动画姿势，&quot;起身&quot;只是把参考动画从&quot;瘫倒&quot;切到&quot;起身&quot;，马达自然把身体拉起来，物理全程连续，无需显式的停稳-对齐-淡出四步。这也是主动布娃娃在手感上的一大优势。而被动布娃娃因为起身时刻要从&quot;纯物理&quot;跳回&quot;纯动画&quot;，才需要本篇这套精细的交接流程。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>起身是布娃娃闭环的收尾：把停稳的物理躯体平滑交还动画状态机，做砸会导致瞬移或弹跳，前功尽弃。</li>\n<li>停稳检测要求全身动能持续低于阈值若干帧，可直接复用引擎的刚体休眠机制。</li>\n<li>按骨盆背法线与 up 的夹角判断仰躺/趴地，挑对起身动画并决定落位朝向。</li>\n<li>根节点对齐（把逻辑根搬到物理骨盆的水平位姿）消除起身瞬移，是最易穿帮的一步。</li>\n<li>姿势匹配淡出用 α:1→0 让物理姿势滑向起身动画首帧；主动布娃娃则只需切换参考动画，无需这套四步流程。</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>淡入的对称机制：<a href=\"animation-to-ragdoll\">动画到物理过渡</a></li>\n<li>主动布娃娃如何免去显式起身：<a href=\"powered-ragdoll\">主动布娃娃</a></li>\n<li>停稳所依赖的休眠机制的性能意义：<a href=\"../practice/ragdoll-performance\">性能与 LOD</a></li>\n<li>起身落位与足部对齐（跨库）：<a href=\"../../game-procedural-animation/ik/foot-placement\">程序化动画 · 足部放置</a></li>\n</ul>\n","headings":[{"level":1,"text":"起身与恢复：从物理躺回动画站","id":"起身与恢复-从物理躺回动画站"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"第一步：判断\"停稳了\"","id":"第一步-判断-停稳了"},{"level":2,"text":"第二步：判断朝向、挑对起身动画","id":"第二步-判断朝向-挑对起身动画"},{"level":2,"text":"第三步：根节点对齐，消除\"瞬移\"","id":"第三步-根节点对齐-消除-瞬移"},{"level":2,"text":"第四步：姿势匹配的淡出","id":"第四步-姿势匹配的淡出"},{"level":2,"text":"与主动布娃娃的分工","id":"与主动布娃娃的分工"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"主动布娃娃：既活在物理里，又想保持姿势","url":"/l-doc-books/h/game-development/game-ragdoll-physics/blending/powered-ragdoll"},"next":{"title":"稳定性调校：驯服一具发神经的布娃娃","url":"/l-doc-books/h/game-development/game-ragdoll-physics/practice/stability-tuning"}}