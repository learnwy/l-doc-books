</span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (node.isLeaf </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">shouldSubdivide</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(node, cam, lodDistanceScale)) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        visible.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push_back</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">node);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 作为一个 LOD 块渲染</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 否则递归细分四个子节点</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">auto&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> child : node.children) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (child) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">traverseQuadtree</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">child, cam, visible, lodDistanceScale);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"cdlod-morphing-消除-lod-弹出\">CDLOD Morphing：消除 LOD 弹出</h2><p>CDLOD 的关键创新是<strong>顶点插值（Morphing）</strong>：在 LOD 切换区域，顶点在精细版和粗糙版之间平滑插值，消除级别切换时的突变（弹出）。</p>\n<p>在顶点着色器中，根据顶点到相机的距离，将高 LOD 的顶点向低 LOD 的&quot;父格点&quot;插值：</p>\n<div class=\"code-block-wrapper\" data-lang=\"glsl\" data-code=\"// Vertex Shader — CDLOD Morphing&#10;uniform sampler2D u_heightmap;&#10;uniform float u_patchSize;        // 本 Patch 的世界空间大小&#10;uniform vec3  u_cameraPos;&#10;uniform float u_morphRange;       // Morphing 开始的距离比例（如 0.5）&#10;uniform float u_lodLevel;&#10;&#10;layout(location = 0) in vec2 a_localPos;  // [0, patchGridSize-1] 的格点坐标&#10;&#10;vec2 morphVertex(vec2 gridPos, float morphK) {&#10;    // 将奇数格点（高 LOD 专有）插值到偶数格点（低 LOD 共享）&#10;    vec2 fracPos = fract(gridPos * 0.5) * 2.0; // 0 或 1&#10;    return gridPos - fracPos * morphK;&#10;}&#10;&#10;void main() {&#10;    // 计算世界坐标（未变形）&#10;    vec2 worldXZ = ... ; // patchOrigin + a_localPos * cellSize&#10;&#10;    // 到相机的距离&#10;    float dist = length(u_cameraPos.xz - worldXZ);&#10;    // 计算 morph factor：在 [morphStart, morphEnd] 区间内从 0 到 1&#10;    float morphStart = u_patchSize * (1.0 - u_morphRange);&#10;    float morphEnd   = u_patchSize;&#10;    float morphK = clamp((dist - morphStart) / (morphEnd - morphStart), 0.0, 1.0);&#10;&#10;    // 变形格点坐标&#10;    vec2 morphed = morphVertex(a_localPos, morphK);&#10;&#10;    // 采样高度图&#10;    vec2 uv = (patchOrigin + morphed * cellSize) / worldSize;&#10;    float h = texture(u_heightmap, uv).r * u_worldHeight;&#10;&#10;    gl_Position = MVP * vec4(worldXZ.x, h, worldXZ.y, 1.0);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// Vertex Shader — CDLOD Morphing</span></span>\n<span class=\"line\"><span>uniform sampler2D u_heightmap;</span></span>\n<span class=\"line\"><span>uniform float u_patchSize;        // 本 Patch 的世界空间大小</span></span>\n<span class=\"line\"><span>uniform vec3  u_cameraPos;</span></span>\n<span class=\"line\"><span>uniform float u_morphRange;       // Morphing 开始的距离比例（如 0.5）</span></span>\n<span class=\"line\"><span>uniform float u_lodLevel;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>layout(location = 0) in vec2 a_localPos;  // [0, patchGridSize-1] 的格点坐标</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>vec2 morphVertex(vec2 gridPos, float morphK) {</span></span>\n<span class=\"line\"><span>    // 将奇数格点（高 LOD 专有）插值到偶数格点（低 LOD 共享）</span></span>\n<span class=\"line\"><span>    vec2 fracPos = fract(gridPos * 0.5) * 2.0; // 0 或 1</span></span>\n<span class=\"line\"><span>    return gridPos - fracPos * morphK;</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>void main() {</span></span>\n<span class=\"line\"><span>    // 计算世界坐标（未变形）</span></span>\n<span class=\"line\"><span>    vec2 worldXZ = ... ; // patchOrigin + a_localPos * cellSize</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    // 到相机的距离</span></span>\n<span class=\"line\"><span>    float dist = length(u_cameraPos.xz - worldXZ);</span></span>\n<span class=\"line\"><span>    // 计算 morph factor：在 [morphStart, morphEnd] 区间内从 0 到 1</span></span>\n<span class=\"line\"><span>    float morphStart = u_patchSize * (1.0 - u_morphRange);</span></span>\n<span class=\"line\"><span>    float morphEnd   = u_patchSize;</span></span>\n<span class=\"line\"><span>    float morphK = clamp((dist - morphStart) / (morphEnd - morphStart), 0.0, 1.0);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    // 变形格点坐标</span></span>\n<span class=\"line\"><span>    vec2 morphed = morphVertex(a_localPos, morphK);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    // 采样高度图</span></span>\n<span class=\"line\"><span>    vec2 uv = (patchOrigin + morphed * cellSize) / worldSize;</span></span>\n<span class=\"line\"><span>    float h = texture(u_heightmap, uv).r * u_worldHeight;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    gl_Position = MVP * vec4(worldXZ.x, h, worldXZ.y, 1.0);</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><p>Morphing 系数 <code>morphK = 0</code> 时完全使用精细格点，<code>morphK = 1</code> 时完全使用粗糙格点——在过渡区间内渐变，视觉上完全感知不到 LOD 切换。</p>\n<h2 id=\"缝合问题处理\">缝合问题处理</h2><p>即使使用 CDLOD Morphing，相邻 LOD 块在极端视角下仍可能出现微小裂缝（T-junction 问题）。工业级解决方案有两种：</p>\n<h3 id=\"方案一-skirt-裙边\">方案一：Skirt（裙边）</h3><p>在每个 LOD 块的四条边上添加向下延伸的&quot;裙边&quot;网格，裙边向下延伸足够多的距离，使任何裂缝被遮挡：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"void addSkirt(std::vector&lt;float&gt;&amp; vertices, int patchSize, float skirtDepth) {&#10;    // 对每条边的每个顶点，复制一个向下偏移版本&#10;    // 形成封闭的侧面裙边，遮挡 T-junction 裂缝&#10;    for (int i = 0; i &lt; patchSize; i++) {&#10;        auto&amp; [x, h, z] = getEdgeVertex(vertices, i);&#10;        vertices.push_back(x);&#10;        vertices.push_back(h - skirtDepth); // 向下延伸&#10;        vertices.push_back(z);&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> addSkirt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">vector</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> vertices</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> patchSize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">float</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> skirtDepth</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 对每条边的每个顶点，复制一个向下偏移版本</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 形成封闭的侧面裙边，遮挡 T-junction 裂缝</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> patchSize; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        auto&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [x, h, z] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getEdgeVertex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(vertices, i);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        vertices.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push_back</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(x);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        vertices.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push_back</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(h </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> skirtDepth);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 向下延伸</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        vertices.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push_back</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(z);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Skirt 方案的成本是额外顶点（约 4×patchSize 个），在 patchSize=64 时仅增加 256 个顶点，可忽略不计。UE 和 Unity 都使用 Skirt 方案。</p>\n<h3 id=\"方案二-stitch-顶点-拼缝精细化\">方案二：Stitch 顶点（拼缝精细化）</h3><p>检测相邻块的 LOD 差异，在精细块的边缘移除&quot;多余&quot;顶点，使其与粗糙块的顶点对齐，彻底消除 T-junction。这需要在四叉树遍历时传递邻居 LOD 信息，实现更复杂。</p>\n<h2 id=\"地形渲染流程\">地形渲染流程</h2><p>完整的地形渲染流程：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"每帧渲染：&#10;1. CPU：四叉树遍历 → 生成可见 Patch 列表 + LOD 信息&#10;2. CPU→GPU：上传 Patch 变换矩阵和 LOD 参数（Uniform 或 SSBO）&#10;3. GPU（Vertex Shader）：&#10;   a. 采样高度图 → 计算顶点高度&#10;   b. 计算 MorphK → 变形顶点&#10;   c. 变换到裁剪空间&#10;4. GPU（Fragment Shader）：&#10;   a. 纹理混合（见 texture-blending.md）&#10;   b. 法线计算（从高度图差分）&#10;   c. 光照计算（PBR）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>每帧渲染：</span></span>\n<span class=\"line\"><span>1. CPU：四叉树遍历 → 生成可见 Patch 列表 + LOD 信息</span></span>\n<span class=\"line\"><span>2. CPU→GPU：上传 Patch 变换矩阵和 LOD 参数（Uniform 或 SSBO）</span></span>\n<span class=\"line\"><span>3. GPU（Vertex Shader）：</span></span>\n<span class=\"line\"><span>   a. 采样高度图 → 计算顶点高度</span></span>\n<span class=\"line\"><span>   b. 计算 MorphK → 变形顶点</span></span>\n<span class=\"line\"><span>   c. 变换到裁剪空间</span></span>\n<span class=\"line\"><span>4. GPU（Fragment Shader）：</span></span>\n<span class=\"line\"><span>   a. 纹理混合（见 texture-blending.md）</span></span>\n<span class=\"line\"><span>   b. 法线计算（从高度图差分）</span></span>\n<span class=\"line\"><span>   c. 光照计算（PBR）</span></span></code></pre></div><p>在 GTX 1080 级别 GPU 上，渲染 1 平方公里的高精度地形（LOD0 = 64×64 块）通常消耗约 0.5ms（含纹理采样），整个可见范围（5×5 公里）约 3-4ms，是现代游戏预算（16ms/帧）中合理的比例。</p>\n<h2 id=\"gpu-驱动的地形渲染\">GPU 驱动的地形渲染</h2><p>在 DX12/Vulkan 和 Compute Shader 环境下，可以将四叉树遍历搬到 GPU，实现完全的 GPU 驱动渲染（Indirect Draw）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"glsl\" data-code=\"// Compute Shader：GPU 端四叉树遍历&#10;// 生成 DrawIndirect 命令缓冲&#10;layout(local_size_x = 64) in;&#10;&#10;layout(std430, binding = 0) buffer PatchBuffer {&#10;    PatchData patches[]; // 输出：可见 Patch 列表&#10;};&#10;layout(atomic_uint, binding = 1) uint visibleCount;&#10;&#10;void main() {&#10;    // 每个线程处理一个四叉树叶节点&#10;    // 做视锥体剔除和 LOD 判断&#10;    // 通过原子计数写入可见列表&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// Compute Shader：GPU 端四叉树遍历</span></span>\n<span class=\"line\"><span>// 生成 DrawIndirect 命令缓冲</span></span>\n<span class=\"line\"><span>layout(local_size_x = 64) in;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>layout(std430, binding = 0) buffer PatchBuffer {</span></span>\n<span class=\"line\"><span>    PatchData patches[]; // 输出：可见 Patch 列表</span></span>\n<span class=\"line\"><span>};</span></span>\n<span class=\"line\"><span>layout(atomic_uint, binding = 1) uint visibleCount;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>void main() {</span></span>\n<span class=\"line\"><span>    // 每个线程处理一个四叉树叶节点</span></span>\n<span class=\"line\"><span>    // 做视锥体剔除和 LOD 判断</span></span>\n<span class=\"line\"><span>    // 通过原子计数写入可见列表</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><p>GPU 驱动渲染将 CPU-GPU 同步开销降低约 70%，在拥有大量 Patch（数万个）的超大世界中尤为重要。</p>\n<h2 id=\"小结\">小结</h2><p>CDLOD 是现代地形 LOD 的行业主流方案：四叉树按相机距离选择 LOD 级别，视锥体剔除跳过不可见节点，Morphing 技术在顶点着色器中平滑插值消除弹出感，Skirt 裙边低成本修复相邻 LOD 之间的裂缝。GPU 驱动模式（Indirect Draw）将遍历和剔除移至 Compute Shader，消除 CPU 提交瓶颈，在超大世界（数万 Patch）中性能提升尤为明显。LOD 层级数量通常取决于地形规模：4-8 层可覆盖 100m 到 16km 的可见距离，每层精度减半，远处三角形数量以指数级缩减。</p>\n","headings":[{"level":1,"text":"地形 LOD 系统","id":"地形-lod-系统"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"LOD 架构选型","id":"lod-架构选型"},{"level":2,"text":"CDLOD：四叉树架构","id":"cdlod-四叉树架构"},{"level":3,"text":"四叉树节点","id":"四叉树节点"},{"level":3,"text":"可见性剔除与 LOD 选择","id":"可见性剔除与-lod-选择"},{"level":2,"text":"CDLOD Morphing：消除 LOD 弹出","id":"cdlod-morphing-消除-lod-弹出"},{"level":2,"text":"缝合问题处理","id":"缝合问题处理"},{"level":3,"text":"方案一：Skirt（裙边）","id":"方案一-skirt-裙边"},{"level":3,"text":"方案二：Stitch 顶点（拼缝精细化）","id":"方案二-stitch-顶点-拼缝精细化"},{"level":2,"text":"地形渲染流程","id":"地形渲染流程"},{"level":2,"text":"GPU 驱动的地形渲染","id":"gpu-驱动的地形渲染"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"地形特征生成","url":"/l-doc-books/h/game-development/game-procedural-terrain/techniques/terrain-features"},"next":{"title":"纹理混合系统","url":"/l-doc-books/h/game-development/game-procedural-terrain/rendering/texture-blending"}}