coder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setPipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(lightVolumePipeline);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    encoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setBindGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, gBufferBindGroup);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    encoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setBindGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, cameraBindGroup);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    encoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setVertexBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, sphereMesh.vertexBuffer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    encoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setIndexBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sphereMesh.indexBuffer, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'uint16'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> light</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lights) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> lightData</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Float32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">light.position, light.radius, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">light.color, light.intensity]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      encoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setBindGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createLightBindGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(device, lightData));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      encoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">drawIndexed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sphereMesh.indexCount);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>光源体积渲染需要注意背面剔除的设置：当相机在光源体积外部时使用背面剔除，当相机进入光源体积内部时需要切换为正面剔除并反转深度测试。</p>\n<h2 id=\"tiled-与-clustered-延迟渲染\">Tiled 与 Clustered 延迟渲染</h2><p>传统延迟渲染在光源数量极多时仍有性能问题，因为每个光源体积 Pass 都需要读取 G-Buffer。Tiled Deferred 和 Clustered Deferred 是更高级的方案。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[屏幕空间] --&gt; B[划分 Tile / Cluster]&#10;    B --&gt; C[Compute Shader 光源分配]&#10;    C --&gt; D[每 Tile 光源列表]&#10;    D --&gt; E[单 Pass 光照计算]\">graph LR\n    A[屏幕空间] --&gt; B[划分 Tile / Cluster]\n    B --&gt; C[Compute Shader 光源分配]\n    C --&gt; D[每 Tile 光源列表]\n    D --&gt; E[单 Pass 光照计算]</pre><table>\n<thead>\n<tr>\n<th>方案</th>\n<th>空间划分</th>\n<th>光源复杂度</th>\n<th>深度利用</th>\n<th>实现复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>传统延迟</td>\n<td>无</td>\n<td>O(光源数 × 屏幕像素)</td>\n<td>无</td>\n<td>低</td>\n</tr>\n<tr>\n<td>Tiled Deferred</td>\n<td>2D Tile</td>\n<td>O(Tile 数 × 平均光源/Tile)</td>\n<td>仅 Min/Max</td>\n<td>中</td>\n</tr>\n<tr>\n<td>Clustered Deferred</td>\n<td>3D Cluster</td>\n<td>O(Cluster 数 × 平均光源/Cluster)</td>\n<td>深度切片</td>\n<td>高</td>\n</tr>\n</tbody></table>\n<p>Clustered Deferred 将视锥体在深度方向上进一步切分，形成三维网格（Cluster）。每个 Cluster 只包含真正影响该空间区域的光源，进一步减少无效光照计算。这也是 Unreal Engine 和 Unity 等主流引擎的默认方案。</p>\n<p>在 Forward+ 管线中，同样的 Tile/Cluster 光源分配机制也可应用于前向渲染。WebGPU 的 Compute Shader 使这种实现变得可行：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const lightCullingPipeline = device.createComputePipeline({&#10;  layout: cullingPipelineLayout,&#10;  compute: {&#10;    module: device.createShaderModule({ code: lightCullingShader }),&#10;    entryPoint: &#39;main&#39;,&#10;  },&#10;});&#10;&#10;const tileCountX = Math.ceil(canvas.width / 16);&#10;const tileCountY = Math.ceil(canvas.height / 16);&#10;&#10;const computePass = commandEncoder.beginComputePass();&#10;computePass.setPipeline(lightCullingPipeline);&#10;computePass.setBindGroup(0, cullingBindGroup);&#10;computePass.dispatchWorkgroups(tileCountX, tileCountY, 1);&#10;computePass.end();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> lightCullingPipeline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> device.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createComputePipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  layout: cullingPipelineLayout,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  compute: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    module: device.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createShaderModule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ code: lightCullingShader }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    entryPoint: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'main'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> tileCountX</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ceil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(canvas.width </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> tileCountY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ceil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(canvas.height </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> computePass</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> commandEncoder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">beginComputePass</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">computePass.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setPipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(lightCullingPipeline);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">computePass.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setBindGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, cullingBindGroup);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">computePass.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dispatchWorkgroups</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(tileCountX, tileCountY, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">computePass.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((渲染架构))&#10;    前向渲染&#10;      直观简单&#10;      MSAA 友好&#10;      Forward+&#10;    延迟渲染&#10;      G-Buffer&#10;      光照 Pass&#10;      光源体积&#10;    高级方案&#10;      Tiled Deferred&#10;      Clustered Deferred&#10;      混合管线&#10;    优化技术&#10;      法线压缩&#10;      Z-Prepass&#10;      Tile 光源裁剪\">mindmap\n  root((渲染架构))\n    前向渲染\n      直观简单\n      MSAA 友好\n      Forward+\n    延迟渲染\n      G-Buffer\n      光照 Pass\n      光源体积\n    高级方案\n      Tiled Deferred\n      Clustered Deferred\n      混合管线\n    优化技术\n      法线压缩\n      Z-Prepass\n      Tile 光源裁剪</pre><ul>\n<li>前向渲染直观简单但光源扩展性差，延迟渲染通过 G-Buffer 解耦几何与光照</li>\n<li>G-Buffer 设计需平衡信息完整性与带宽，八面体编码是法线压缩的最佳选择</li>\n<li>光源体积将局部光源的计算限制在其影响范围内，减少无效着色</li>\n<li>Tiled/Clustered 方案将屏幕空间划分后分配光源，支撑数百个动态光源</li>\n<li>Forward+ 将 Tiled 思想应用于前向渲染，兼具前向渲染的材质灵活性和延迟渲染的光源扩展性</li>\n<li>现代引擎多采用混合方案：不透明物体走延迟管线，半透明物体走前向管线</li>\n</ul>\n","headings":[{"level":1,"text":"延迟渲染与前向渲染","id":"延迟渲染与前向渲染"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"前向渲染管线","id":"前向渲染管线"},{"level":2,"text":"G-Buffer 设计与几何 Pass","id":"g-buffer-设计与几何-pass"},{"level":2,"text":"光照 Pass 与光源体积","id":"光照-pass-与光源体积"},{"level":2,"text":"Tiled 与 Clustered 延迟渲染","id":"tiled-与-clustered-延迟渲染"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"光栅化与片段处理","url":"/l-doc-books/h/game-development/game-graphics/rendering-pipeline/rasterization-and-fragment"},"next":{"title":"光照模型","url":"/l-doc-books/h/game-development/game-graphics/lighting-and-shadow/lighting-models"}}