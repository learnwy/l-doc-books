 float distanceToListener;&#10;    bool isCritical;       // 剧情关键音效，不可截断&#10;    float requestTime;&#10;};&#10;&#10;class PriorityVoiceQueue {&#10;    std::vector&lt;SoundRequest&gt; activeVoices;&#10;    int maxVoices = 64;&#10;&#10;    float computeFinalPriority(const SoundRequest&amp; req) {&#10;        if (req.isCritical) return 10000.0f;&#10;&#10;        float distancePenalty = req.distanceToListener * 0.5f;&#10;        return req.priority - distancePenalty;&#10;    }&#10;&#10;public:&#10;    bool canAllocateVoice(const SoundRequest&amp; newReq) {&#10;        if ((int)activeVoices.size() &lt; maxVoices) return true;&#10;&#10;        // 找最低优先级的当前声音&#10;        auto lowestIt = std::min_element(activeVoices.begin(), activeVoices.end(),&#10;            [this](const auto&amp; a, const auto&amp; b) {&#10;                return computeFinalPriority(a) &lt; computeFinalPriority(b);&#10;            });&#10;&#10;        // 如果新声音优先级更高，截断最低优先级的声音&#10;        if (computeFinalPriority(newReq) &gt; computeFinalPriority(*lowestIt)) {&#10;            stopSound(*lowestIt);&#10;            activeVoices.erase(lowestIt);&#10;            return true;&#10;        }&#10;&#10;        return false;  // 新声音优先级不够，丢弃&#10;    }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SoundRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::string eventName;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> priority;</span><span style=\"color:#6A737D;--shiki-dark:#6A