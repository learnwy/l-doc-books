<td>视野内敌人数量</td>\n<td>高</td>\n<td>每个+10</td>\n<td>直接战斗压力</td>\n</tr>\n<tr>\n<td>玩家 HP 百分比</td>\n<td>中</td>\n<td>低HP时+20</td>\n<td>紧张感</td>\n</tr>\n<tr>\n<td>距离最近敌人</td>\n<td>中</td>\n<td>近距离+15</td>\n<td>危险感知</td>\n</tr>\n<tr>\n<td>时间压力（倒计时）</td>\n<td>中</td>\n<td>剩余时间短+20</td>\n<td>紧迫感</td>\n</tr>\n<tr>\n<td>剧情脚本标记</td>\n<td>高</td>\n<td>可覆盖所有值</td>\n<td>设计师控制</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"float GameAudioManager::computeMusicIntensity() {&#10;    float intensity = 0.0f;&#10;&#10;    // 战斗相关&#10;    int enemiesInView = getEnemiesInPlayerView();&#10;    intensity += std::min(enemiesInView * 10.0f, 40.0f);&#10;&#10;    // HP 压力&#10;    float hp = player.getHealthPercent();&#10;    if (hp &lt; 0.3f) intensity += 20.0f * (1.0f - hp / 0.3f);&#10;&#10;    // 距离压力&#10;    float nearestEnemyDist = getNearestEnemyDistance();&#10;    if (nearestEnemyDist &lt; 10.0f) {&#10;        intensity += 15.0f * (1.0f - nearestEnemyDist / 10.0f);&#10;    }&#10;&#10;    // 脚本覆盖&#10;    if (scriptIntensityOverride &gt;= 0.0f) {&#10;        return scriptIntensityOverride;&#10;    }&#10;&#10;    return std::clamp(intensity, 0.0f, 100.0f);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">float</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GameAudioManager</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">computeMusicIntensity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> intensity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#7