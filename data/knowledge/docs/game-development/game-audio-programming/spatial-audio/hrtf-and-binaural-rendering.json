split --&gt; convR[卷积 R\\nFFT-based]\n    leftFilter --&gt; convL\n    rightFilter --&gt; convR\n    convL --&gt; mix[混合多声源]\n    convR --&gt; mix\n    mix --&gt; headphones[耳机输出\\n左/右声道]</pre><p><strong>卷积实现</strong>：HRTF 应用本质是信号与脉冲响应的卷积。对于实时应用，使用**分段卷积（Overlap-Add/Overlap-Save）**避免延迟：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"// 快速卷积（重叠相加法）&#10;class OverlapAddConvolver {&#10;    int irLength;       // 脉冲响应长度（如 256 样本）&#10;    int blockSize;      // 处理块大小（如 512 样本）&#10;    int fftSize;        // FFT 长度 = irLength + blockSize - 1（取下一个2的幂）&#10;&#10;    std::vector&lt;std::complex&lt;float&gt;&gt; irFFT;  // 预计算的 IR 频域&#10;    std::vector&lt;float&gt; overlap;              // 上一块的尾部&#10;&#10;public:&#10;    void setIR(const std::vector&lt;float&gt;&amp; ir) {&#10;        // 预计算 IR 的 FFT（只需做一次）&#10;        irFFT = fftForward(zeroPad(ir, fftSize));&#10;    }&#10;&#10;    std::vector&lt;float&gt; process(const std::vector&lt;float&gt;&amp; input) {&#10;        // 1. 输入补零到 fftSize&#10;        auto inputFFT = fftForward(zeroPad(input, fftSize));&#10;&#10;        // 2. 频域相乘&#10;        auto resultFFT = complexMultiply(inputFFT, irFFT);&#10;&#10;        // 3. IFFT 回时域&#10;        auto result = fftInverse(resultFFT);&#10;&#10;        // 4. 重叠相加&#10;        for (int i = 0; i &lt; overlap.size(); ++i) {&#10;            result[i] += overlap[i];&#10;        }&#10;&#10;        // 5. 保存尾部用于下一块&#10;        overlap = std::vector&lt;float&gt;(result.begin() + blockSize, result.end());&#10;&#10;        return std::vector&lt;float&gt;(result.begin(), result.begin() + blockSize);&#10;    }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 快速卷积（重叠相加法）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style