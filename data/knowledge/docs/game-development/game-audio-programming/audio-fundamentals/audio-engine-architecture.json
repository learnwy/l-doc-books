><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 语音截断：当 Voice 满时，驱逐最低优先级</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">SoundInstance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SoundPool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stealLowestPriority</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Vector3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> listenerPos</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    auto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> worst </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max_element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(instances.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">begin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), instances.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">end</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">](</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SoundInstance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SoundInstance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computePriority</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(a, listenerPos) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computePriority</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(b, listenerPos);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">worst);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"资源生命周期管理\">资源生命周期管理</h2><p>音频资产的加载/卸载必须与场景/关卡生命周期对齐：</p>\n<table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>操作</th>\n<th>注意事项</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>场景加载前</td>\n<td>预加载 SoundBank / Bank</td>\n<td>在加载屏幕阶段执行，不占游戏帧</td>\n</tr>\n<tr>\n<td>场景运行中</td>\n<td>热加载动态 Bank</td>\n<td>异步加载，避免主线程停顿</td>\n</tr>\n<tr>\n<td>场景卸载</td>\n<td>等待所有实例停止后卸载 Bank</td>\n<td>立即卸载可能导致播放中音效崩溃</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"// 安全卸载：等待实例完成&#10;void AudioManager::unloadBank(const std::string&amp; bankName) {&#10;    // 先停止所有使用该 Bank 的实例&#10;    for (auto&amp; inst : soundPool.instances) {&#10;        if (inst.bankName == bankName) {&#10;            inst.fadeOutAndStop(0.5f);  // 0.5秒淡出&#10;        }&#10;    }&#10;&#10;    // 异步等待淡出完成后卸载&#10;    scheduler.scheduleAfterSeconds(0.6f, [this, bankName] {&#10;        bankManager.unload(bankName);&#10;    });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 安全卸载：等待实例完成</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AudioManager</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unloadBank</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">string</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> bankName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 先停止所有使用该 Bank 的实例</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">auto&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> inst : soundPool.instances) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (inst.bankName </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bankName) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            inst.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fadeOutAndStop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 0.5秒淡出</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 异步等待淡出完成后卸载</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    scheduler.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">scheduleAfterSeconds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.6</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">bankName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        bankManager.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unload</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(bankName);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><p>游戏音频引擎分为游戏逻辑、音频管理、中间件、平台 API 四层。Wwise 以事件驱动与 RTPC/Switch 为核心，FMOD 以时间轴参数化为特色，两者都提供 SoundBank 管理、Voice 池和跨平台 API 抽象。自研方案需要实现声音优先级截断、资源生命周期管理和双缓冲音频回调等核心机制。</p>\n<p><strong>同章节其他内容</strong>：</p>\n<ul>\n<li><a href=\"digital-audio-fundamentals\">数字音频基础</a> — 采样率、位深和缓冲模型：本 Hub 的数学基础</li>\n<li><a href=\"audio-graph-and-mixing\">音频图与混音</a> — Mixer Graph 和 Bus Hierarchy 如何将多个声音混合为最终输出</li>\n</ul>\n","headings":[{"level":1,"text":"音频引擎架构：Wwise、FMOD 与 Audio Manager 模式","id":"音频引擎架构-wwise-fmod-与-audio-manager-模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"音频引擎的职责分层","id":"音频引擎的职责分层"},{"level":2,"text":"Wwise 架构深度解析","id":"wwise-架构深度解析"},{"level":3,"text":"核心对象层级","id":"核心对象层级"},{"level":3,"text":"Wwise 内存与流式系统","id":"wwise-内存与流式系统"},{"level":2,"text":"FMOD 架构解析","id":"fmod-架构解析"},{"level":2,"text":"自研 Audio Manager 模式","id":"自研-audio-manager-模式"},{"level":3,"text":"声音优先级与截断策略","id":"声音优先级与截断策略"},{"level":2,"text":"资源生命周期管理","id":"资源生命周期管理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数字音频基础：采样率、位深与缓冲模型","url":"/l-doc-books/h/game-development/game-audio-programming/audio-fundamentals/digital-audio-fundamentals"},"next":{"title":"音频图与混音：Mixer Graph、Bus Hierarchy 与路由设计","url":"/l-doc-books/h/game-development/game-audio-programming/audio-fundamentals/audio-graph-and-mixing"}}