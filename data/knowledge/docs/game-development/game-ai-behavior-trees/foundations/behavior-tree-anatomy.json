r:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> onKeyChanged</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 标记本节点需要重新评估</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.dirty </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  onExit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">blackboard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Blackboard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> observer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.observers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">values</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      observer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unsubscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.observers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">clear</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>Abort（中止）机制</strong>是事件驱动 BT 的核心组件：当高优先级子树的 Condition 从 FAILURE 变为 SUCCESS 时，需要中止当前正在 RUNNING 的低优先级子树：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"AbortType:&#10;  NONE     — 不允许中止（默认）&#10;  SELF     — 本节点的 Condition 变为 Failure 时中止自身&#10;  LOWER_PRIORITY — 本节点变为 Success 时中止优先级更低的兄弟节点&#10;  BOTH     — SELF + LOWER_PRIORITY\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>AbortType:</span></span>\n<span class=\"line\"><span>  NONE     — 不允许中止（默认）</span></span>\n<span class=\"line\"><span>  SELF     — 本节点的 Condition 变为 Failure 时中止自身</span></span>\n<span class=\"line\"><span>  LOWER_PRIORITY — 本节点变为 Success 时中止优先级更低的兄弟节点</span></span>\n<span class=\"line\"><span>  BOTH     — SELF + LOWER_PRIORITY</span></span></code></pre></div><h2 id=\"bt-的-tick-频率设计\">BT 的 tick 频率设计</h2><p>不是所有 AI 都需要每帧 tick。常见的分频策略：</p>\n<table>\n<thead>\n<tr>\n<th>AI 类型</th>\n<th>tick 频率</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>玩家附近主要敌人</td>\n<td>每帧（60 Hz）</td>\n<td>需要即时响应</td>\n</tr>\n<tr>\n<td>中距离敌人</td>\n<td>每 3-5 帧</td>\n<td>允许轻微延迟</td>\n</tr>\n<tr>\n<td>远距离/背景 AI</td>\n<td>每 10-30 帧</td>\n<td>几乎不影响游戏性</td>\n</tr>\n<tr>\n<td>关卡管理器 AI</td>\n<td>每秒 1-2 次</td>\n<td>宏观决策，低频即可</td>\n</tr>\n</tbody></table>\n<p>LOD（Level of Detail）系统可以根据 AI 与玩家的距离动态调整 tick 频率，是大型开放世界游戏（如《GTA》系列）的标准优化手段。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>tick 是 BT 的核心操作：每次 tick 从根节点深度优先遍历，节点返回 SUCCESS/FAILURE/RUNNING</li>\n<li>RUNNING 状态表示异步执行中，需要维护执行上下文并实现 <code>onAbort()</code> 清理</li>\n<li>两种主流 tick 策略：每帧完整遍历（简单）vs 记录 RUNNING 节点（高效）</li>\n<li>事件驱动 BT 通过 Observer + Abort 机制减少不必要的遍历开销</li>\n<li>Abort 类型（SELF/LOWER_PRIORITY/BOTH）控制高优先级行为如何抢占低优先级行为</li>\n<li>tick 频率 LOD 是大规模 AI 场景的重要性能优化手段</li>\n</ul>\n","headings":[{"level":1,"text":"行为树解剖：tick 机制与数据流","id":"行为树解剖-tick-机制与数据流"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"树遍历算法与时序","id":"树遍历算法与时序"},{"level":2,"text":"tick 数据流与 Blackboard 交互","id":"tick-数据流与-blackboard-交互"},{"level":2,"text":"事件驱动行为树","id":"事件驱动行为树"},{"level":2,"text":"BT 的 tick 频率设计","id":"bt-的-tick-频率设计"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"游戏 AI 范式对比与选型","url":"/l-doc-books/h/game-development/game-ai-behavior-trees/foundations/ai-paradigm-comparison"},"next":{"title":"Blackboard 通信架构","url":"/l-doc-books/h/game-development/game-ai-behavior-trees/foundations/blackboard-architecture"}}