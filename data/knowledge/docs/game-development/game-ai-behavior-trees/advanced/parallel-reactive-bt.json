:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> observer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conditionObservers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">values</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      observer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unsubscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conditionObservers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">clear</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"响应式-bt-的完整实现示例\">响应式 BT 的完整实现示例</h2><p>以下是一个完整的响应式警卫 AI，展示 Observer、Abort 和 Parallel 的协同工作：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function buildGuardBT(): BTNode {&#10;  return new ReactiveSelectorNode([&#10;    // 优先级 1：看到敌人 → 战斗（AbortType=BOTH）&#10;    new SequenceNode([&#10;      new ConditionNode(Keys.IS_ENEMY_VISIBLE, { abortType: AbortType.BOTH }),&#10;      new ParallelNode(&#10;        [&#10;          new ActionMoveTo(&#39;attack_position&#39;),&#10;          new ServiceUpdateEnemyPosition(0.1), // 0.1 秒更新一次目标位置&#10;        ],&#10;        ParallelPolicy.REQUIRE_ALL,&#10;        ParallelPolicy.REQUIRE_ONE,&#10;      ),&#10;      new ActionAttack(),&#10;    ]),&#10;&#10;    // 优先级 2：听到声音 → 搜索（AbortType=LOWER_PRIORITY）&#10;    new SequenceNode([&#10;      new ConditionNode(Keys.HEARD_NOISE, { abortType: AbortType.LOWER_PRIORITY }),&#10;      new TimeLimitDecorator(&#10;        new ActionSearchForSource(),&#10;        10, // 搜索超过 10 秒放弃&#10;      ),&#10;    ]),&#10;&#10;    // 优先级 3：默认巡逻&#10;    new RepeaterDecorator(new ActionPatrol(), -1), // 无限循环巡逻&#10;  ]);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildGuardBT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BTNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReactiveSelectorNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 优先级 1：看到敌人 → 战斗（AbortType=BOTH）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SequenceNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConditionNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Keys.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">IS_ENEMY_VISIBLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { abortType: AbortType.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">BOTH</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ParallelNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        [</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ActionMoveTo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'attack_position'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ServiceUpdateEnemyPosition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 0.1 秒更新一次目标位置</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ParallelPolicy.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">REQUIRE_ALL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ParallelPolicy.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">REQUIRE_ONE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ActionAttack</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]),</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 优先级 2：听到声音 → 搜索（AbortType=LOWER_PRIORITY）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SequenceNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConditionNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Keys.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">HEARD_NOISE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { abortType: AbortType.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">LOWER_PRIORITY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TimeLimitDecorator</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ActionSearchForSource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 搜索超过 10 秒放弃</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]),</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 优先级 3：默认巡逻</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RepeaterDecorator</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ActionPatrol</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 无限循环巡逻</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>关键时序</strong>：</p>\n<ol>\n<li>警卫正在巡逻（优先级 3 RUNNING）</li>\n<li>感知系统将 <code>IS_ENEMY_VISIBLE</code> 设为 true</li>\n<li>优先级 1 的 ConditionNode Observer 触发，AbortType=BOTH → 中止巡逻（调用 <code>onAbort()</code>）</li>\n<li>ReactiveSelectorNode 重置 <code>currentIndex=0</code>，下帧从战斗序列开始 tick</li>\n</ol>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Parallel Policy 矩阵（SuccessPolicy × FailurePolicy）控制并行节点的聚合语义</li>\n<li>三种经典 Parallel 用法：守护条件、同步点、后台监控</li>\n<li>Abort 类型（NONE/SELF/LOWER_PRIORITY/BOTH）控制 Condition 变化时是否中止其他节点</li>\n<li>响应式 BT = Observer 注册 + 条件变化时触发 Abort + 重新从高优先级节点开始 tick</li>\n<li>Observer 必须在节点退出时注销，否则 AI 销毁后仍会触发中止逻辑</li>\n<li>响应式 BT 的调试难点：Abort 触发时机难以在编辑器中直接观察，需要专用日志</li>\n</ul>\n","headings":[{"level":1,"text":"并行与响应式行为树","id":"并行与响应式行为树"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Parallel 的三种经典用法","id":"parallel-的三种经典用法"},{"level":2,"text":"Abort 机制：响应式行为抢占","id":"abort-机制-响应式行为抢占"},{"level":2,"text":"响应式 BT 的完整实现示例","id":"响应式-bt-的完整实现示例"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"叶节点：Action、Condition 与 Service","url":"/l-doc-books/h/game-development/game-ai-behavior-trees/node-types/leaf-nodes"},"next":{"title":"行为树与 GOAP 混合架构","url":"/l-doc-books/h/game-development/game-ai-behavior-trees/advanced/bt-goap-hybrid"}}