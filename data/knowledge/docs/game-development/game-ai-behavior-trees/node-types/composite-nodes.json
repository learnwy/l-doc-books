case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">RUNNING</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">RUNNING</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.currentIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">FAILURE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 全部失败</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>典型使用模式</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"Selector [攻击方式选择]&#10;  ├── Sequence [远程攻击]&#10;  │     ├── Condition: HasRangedWeapon&#10;  │     └── Action: RangedAttack&#10;  ├── Sequence [近战攻击]&#10;  │     ├── Condition: IsAdjacentToEnemy&#10;  │     └── Action: MeleeAttack&#10;  └── Action: Flee  // 没有任何攻击选项时逃跑\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Selector [攻击方式选择]</span></span>\n<span class=\"line\"><span>  ├── Sequence [远程攻击]</span></span>\n<span class=\"line\"><span>  │     ├── Condition: HasRangedWeapon</span></span>\n<span class=\"line\"><span>  │     └── Action: RangedAttack</span></span>\n<span class=\"line\"><span>  ├── Sequence [近战攻击]</span></span>\n<span class=\"line\"><span>  │     ├── Condition: IsAdjacentToEnemy</span></span>\n<span class=\"line\"><span>  │     └── Action: MeleeAttack</span></span>\n<span class=\"line\"><span>  └── Action: Flee  // 没有任何攻击选项时逃跑</span></span></code></pre></div><h2 id=\"sequence-与-selector-的嵌套组合\">Sequence 与 Selector 的嵌套组合</h2><p>BT 的表达能力来自两种节点的嵌套组合。理解它们的互补关系：</p>\n<ul>\n<li><strong>Selector 的子节点通常是 Sequence</strong>：每个 Sequence 代表一个「前提 + 行动」的行为块</li>\n<li><strong>Sequence 内用 Selector 处理可选路径</strong>：某个步骤有多种实现方式时</li>\n</ul>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"Selector [警卫 AI]&#10;  ├── Sequence [战斗]          ← 有敌人时战斗（最高优先级）&#10;  │     ├── Condition: EnemyVisible&#10;  │     └── Selector [攻击方式]&#10;  │           ├── Sequence [狙击]&#10;  │           └── Sequence [近战]&#10;  ├── Sequence [搜索]          ← 听到声音时搜索（中优先级）&#10;  │     ├── Condition: HeardNoise&#10;  │     └── Action: InvestigateNoise&#10;  └── Action: Patrol           ← 默认巡逻（最低优先级）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Selector [警卫 AI]</span></span>\n<span class=\"line\"><span>  ├── Sequence [战斗]          ← 有敌人时战斗（最高优先级）</span></span>\n<span class=\"line\"><span>  │     ├── Condition: EnemyVisible</span></span>\n<span class=\"line\"><span>  │     └── Selector [攻击方式]</span></span>\n<span class=\"line\"><span>  │           ├── Sequence [狙击]</span></span>\n<span class=\"line\"><span>  │           └── Sequence [近战]</span></span>\n<span class=\"line\"><span>  ├── Sequence [搜索]          ← 听到声音时搜索（中优先级）</span></span>\n<span class=\"line\"><span>  │     ├── Condition: HeardNoise</span></span>\n<span class=\"line\"><span>  │     └── Action: InvestigateNoise</span></span>\n<span class=\"line\"><span>  └── Action: Patrol           ← 默认巡逻（最低优先级）</span></span></code></pre></div><h2 id=\"parallel-节点-伪并行执行\">Parallel 节点：伪并行执行</h2><p>Parallel 节点同时 tick 所有子节点（在同一帧内顺序执行），根据 Policy 决定整体返回值：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"enum ParallelPolicy {&#10;  REQUIRE_ONE, // 任意一个子节点 SUCCESS =&gt; SUCCESS&#10;  REQUIRE_ALL, // 所有子节点 SUCCESS =&gt; SUCCESS&#10;}&#10;&#10;class ParallelNode implements CompositeNode {&#10;  constructor(&#10;    private readonly successPolicy: ParallelPolicy,&#10;    private readonly failurePolicy: ParallelPolicy,&#10;  ) {}&#10;&#10;  tick(blackboard: Blackboard): NodeStatus {&#10;    let successCount = 0;&#10;    let failureCount = 0;&#10;&#10;    for (const child of this.children) {&#10;      const status = child.tick(blackboard);&#10;      if (status === NodeStatus.SUCCESS) successCount++;&#10;      else if (status === NodeStatus.FAILURE) failureCount++;&#10;    }&#10;&#10;    // 检查成功条件&#10;    if (this.successPolicy === ParallelPolicy.REQUIRE_ONE &amp;&amp; successCount &gt; 0) {&#10;      return NodeStatus.SUCCESS;&#10;    }&#10;    if (this.successPolicy === ParallelPolicy.REQUIRE_ALL &amp;&amp; successCount === this.children.length) {&#10;      return NodeStatus.SUCCESS;&#10;    }&#10;&#10;    // 检查失败条件&#10;    if (this.failurePolicy === ParallelPolicy.REQUIRE_ONE &amp;&amp; failureCount &gt; 0) {&#10;      return NodeStatus.FAILURE;&#10;    }&#10;    if (this.failurePolicy === ParallelPolicy.REQUIRE_ALL &amp;&amp; failureCount === this.children.length) {&#10;      return NodeStatus.FAILURE;&#10;    }&#10;&#10;    return NodeStatus.RUNNING;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">enum</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ParallelPolicy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  REQUIRE_ONE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 任意一个子节点 SUCCESS => SUCCESS</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  REQUIRE_ALL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 所有子节点 SUCCESS => SUCCESS</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ParallelNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> implements</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CompositeNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  constructor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> successPolicy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ParallelPolicy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> failurePolicy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ParallelPolicy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  tick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">blackboard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Blackboard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NodeStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> successCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> failureCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span>