ts DecoratorNode {&#10;  constructor(private readonly child: BTNode) {}&#10;&#10;  tick(blackboard: Blackboard): NodeStatus {&#10;    const status = this.child.tick(blackboard);&#10;    return status === NodeStatus.FAILURE ? NodeStatus.SUCCESS : status;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ForceSuccessDecorator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> implements</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DecoratorNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  constructor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> child</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BTNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  tick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">blackboard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Blackboard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NodeStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.child.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(blackboard);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">FAILURE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">SUCCESS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> status;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>典型用途</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"Sequence [战斗行为]&#10;  ├── Action: MoveToAttackPosition&#10;  ├── ForceSuccess                  ← 动画可选，播放失败也不阻断攻击&#10;  │     └── Action: PlayAttackAnimation&#10;  └── Action: DealDamage\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Sequence [战斗行为]</span></span>\n<span class=\"line\"><span>  ├── Action: MoveToAttackPosition</span></span>\n<span class=\"line\"><span>  ├── ForceSuccess                  ← 动画可选，播放失败也不阻断攻击</span></span>\n<span class=\"line\"><span>  │     └── Action: PlayAttackAnimation</span></span>\n<span class=\"line\"><span>  └── Action: DealDamage</span></span></code></pre></div><p>等价于「必须移动到位，最好播放动画，然后造成伤害」。</p>\n<h2 id=\"timelimit-防止无限-running\">TimeLimit：防止无限 RUNNING</h2><p>TimeLimit 为子节点设置执行时间上限，超时后中止子节点并返回 FAILURE：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"class TimeLimitDecorator implements DecoratorNode {&#10;  private startTime: number | null = null;&#10;&#10;  constructor(&#10;    private readonly child: BTNode,&#10;    private readonly limitSeconds: number,&#10;  ) {}&#10;&#10;  tick(blackboard: Blackboard): NodeStatus {&#10;    if (this.startTime === null) {&#10;      this.startTime = performance.now() / 1000;&#10;    }&#10;&#10;    const elapsed = performance.now() / 1000 - this.startTime;&#10;    if (elapsed &gt;= this.limitSeconds) {&#10;      this.child.onAbort?.();&#10;      this.startTime = null;&#10;      return NodeStatus.FAILURE;&#10;    }&#10;&#10;    const status = this.child.tick(blackboard);&#10;    if (status !== NodeStatus.RUNNING) {&#10;      this.startTime = null;&#10;    }&#10;    return status;&#10;  }&#10;&#10;  onAbort(): void {&#10;    this.child.onAbort?.();&#10;    this.startTime = null;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TimeLimitDecorator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> implements</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DecoratorNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> startTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  constructor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> child</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BTNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> limitSeconds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  tick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">blackboard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Blackboard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NodeStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.startTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.startTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> elapsed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> performance.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.startTime;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (elapsed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.limitSeconds) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.child.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onAbort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">?.();</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.startTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">FAILURE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.child.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(blackboard);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NodeStatus.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">RUNNING</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.startTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> status;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  onAbort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.child.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onAbort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">?.();</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.startTime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>典型用途</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"TimeLimit (5 秒)              ← 搜索超过 5 秒则放弃&#10;  └── Action: SearchForEnemy\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>TimeLimit (5 秒)              ← 搜索超过 5 秒则放弃</span></span>\n<span class=\"line\"><span>  └── Action: SearchForEnemy</span></span></code></pre></div><p>没有 TimeLimit，搜索行为可能因路径问题永远 RUNNING，整棵 BT 卡死。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>装饰节点的核心价值：在不修改叶节点实现的情况下改变行为语义</li>\n<li>Inverter 是最高频使用的装饰节点，让 Condition 节点具备反向语义</li>\n<li>Repeater 驱动循环行为，注意配合子节点的 <code>reset()</code> 方法避免状态残留</li>\n<li>Cooldown 是控制 AI 技能频率的标准手段，冷却时间应存储在 Blackboard 以支持外部修改</li>\n<li>ForceSuccess 将行为变为「可选的」——失败了也不影响后续步骤</li>\n<li>TimeLimit 是防御性必备装饰节点，防止异步行为无限 RUNNING 导致 BT 卡死</li>\n<li>装饰节点可以嵌套（TimeLimit 包裹 Repeater 包裹 Action），构成复合修改</li>\n</ul>\n","headings":[{"level":1,"text":"装饰节点：修改行为语义","id":"装饰节点-修改行为语义"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Inverter：条件取反","id":"inverter-条件取反"},{"level":2,"text":"Repeater：循环执行","id":"repeater-循环执行"},{"level":2,"text":"Cooldown：行为冷却","id":"cooldown-行为冷却"},{"level":2,"text":"ForceSuccess：使行为变为可选","id":"forcesuccess-使行为变为可选"},{"level":2,"text":"TimeLimit：防止无限 RUNNING","id":"timelimit-防止无限-running"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"组合节点：Sequence、Selector 与 Parallel","url":"/l-doc-books/h/game-development/game-ai-behavior-trees/node-types/composite-nodes"},"next":{"title":"叶节点：Action、Condition 与 Service","url":"/l-doc-books/h/game-development/game-ai-behavior-trees/node-types/leaf-nodes"}}