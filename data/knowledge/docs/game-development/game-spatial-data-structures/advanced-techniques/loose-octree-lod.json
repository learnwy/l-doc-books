\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><hr>\n<h2 id=\"查询-松散区域的影响\">查询：松散区域的影响</h2><p>查询时，由于节点的松散区域比严格区域大，需要检测<strong>当前层及所有祖先层</strong>的对象——它们的严格区域可能不覆盖查询点，但松散区域可能覆盖：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"void sphereQuery(LooseOctreeNode* node, const Vec3&amp; queryCenter, float queryRadius,&#10;                 std::vector&lt;int&gt;&amp; results) {&#10;    // 当前节点中的对象可能在松散区域内，均需测试&#10;    for (int objId : node-&gt;objects) {&#10;        BoundingSphere s = getObjectSphere(objId);&#10;        if (distance(queryCenter, s.center) &lt;= queryRadius + s.radius) {&#10;            results.push_back(objId);&#10;        }&#10;    }&#10;&#10;    if (node-&gt;isLeaf()) return;&#10;&#10;    // 确定哪些子节点需要访问&#10;    // 需要访问松散区域与查询球相交的所有子节点&#10;    for (int i = 0; i &lt; 8; i++) {&#10;        if (node-&gt;children[i]) {&#10;            float childLooseSize = node-&gt;children[i]-&gt;looseHalfSize();&#10;            // 子节点松散 AABB 与查询球的相交测试&#10;            if (sphereLooseAABBIntersect(queryCenter, queryRadius,&#10;                                         node-&gt;children[i]-&gt;strictCenter,&#10;                                         childLooseSize)) {&#10;                sphereQuery(node-&gt;children[i], queryCenter, queryRadius, results);&#10;            }&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sphereQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">LooseOctreeNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span st