>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> totalXpNeeded</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.xpPerLevel.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">xp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> xp, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> daysRemaining</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.seasonDuration </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">floor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 86400000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> xpPerDayNeeded</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (totalXpNeeded </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currentXp) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> daysRemaining;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    currentLevel: level,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    totalProgress: currentXp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalXpNeeded,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    onTrack: level </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.maxLevel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> daysRemaining </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.seasonDuration),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    xpPerDayNeeded,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>战斗通行证的平衡要点：</p>\n<p><strong>完成难度校准</strong>——普通玩家（每天游玩 30-60 分钟）应该能在赛季结束前完成约 80% 的等级。100% 完成需要额外投入或购买等级加速。</p>\n<p><strong>奖励节奏设计</strong>——早期等级的间距小且奖励频繁，保持新玩家的正反馈。中后期间距逐渐增大，但奖励品质提升。最后几级放置最吸引人的独占奖励作为终极目标。</p>\n<p><strong>追赶机制</strong>——赛季中后期加入的玩家需要追赶机制（如双倍经验周、追赶任务），否则他们会因为&quot;来不及完成&quot;而拒绝购买。</p>\n<h2 id=\"内购系统与付费点设计\">内购系统与付费点设计</h2><p>内购系统（In-App Purchase，IAP）是 F2P 游戏的核心商业引擎。付费点设计（Monetization Touch Point）决定了&quot;在什么时机向玩家展示什么商品&quot;——这是行为经济学在游戏中的直接应用。</p>\n<p>付费点设计的三层模型：</p>\n<p><strong>需求创造层</strong>——游戏机制自然产生资源需求。例如体力耗尽、强化失败、库存不足等场景自然触发玩家对付费道具的需求。</p>\n<p><strong>展示推荐层</strong>——在合适的时机展示合适的商品。当玩家 Boss 战失败时推荐复活药，当库存满时推荐扩容包。关键是&quot;解决当前问题&quot;而非&quot;强推无关商品&quot;。</p>\n<p><strong>决策促进层</strong>——通过限时折扣、捆绑优惠和社交对比等方式降低付费决策门槛。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PurchaseOffer {&#10;  id: string;&#10;  products: Product[];&#10;  trigger: TriggerCondition;&#10;  displayDuration: number;&#10;  discount: number;&#10;  limitPerPlayer: number;&#10;}&#10;&#10;interface TriggerCondition {&#10;  event: string;&#10;  minPlayerLevel: number;&#10;  maxPurchaseHistory: number;&#10;  cooldownAfterLastOffer: number;&#10;}&#10;&#10;interface Product {&#10;  type: &#39;currency&#39; | &#39;item&#39; | &#39;subscription&#39; | &#39;cosmetic&#39;;&#10;  basePrice: number;&#10;  perceivedValue: number;&#10;}&#10;&#10;function shouldShowOffer(offer: PurchaseOffer, playerState: PlayerState): boolean {&#10;  const { trigger } = offer;&#10;&#10;  if (playerState.level &lt; trigger.minPlayerLevel) return false;&#10;  if (playerState.totalPurchases &gt; trigger.maxPurchaseHistory) return false;&#10;&#10;  const lastOfferTime = playerState.lastOfferShown.get(offer.id) ?? 0;&#10;  const timeSinceLastOffer = Date.now() - lastOfferTime;&#10;  if (timeSinceLastOffer &lt; trigger.cooldownAfterLastOffer) return false;&#10;&#10;  return true;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PurchaseOffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  products</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Product</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  trigger</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TriggerCondition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  displayDuration</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#242