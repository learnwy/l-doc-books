:#E36209;--shiki-dark:#FFAB70\">target</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }>> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> graph</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">target</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }>>();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rule</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rules) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> edges</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> graph.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rule.from.resourceId) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    edges.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      target: rule.to.resourceId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      rate: (rule.to.amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rule.from.amount) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rule.fee),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    graph.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rule.from.resourceId, edges);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> graph;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>价值链设计的原则是&quot;单向价值提升&quot;——原材料→半成品→成品的加工链路应当在每一步都不可逆地增加价值。玩家投入时间和资源进行加工，获得更高价值的产出。逆向分解可以存在，但应该有显著的价值损耗（通常回收 30-50% 的原始价值）。</p>\n<h2 id=\"经济仪表盘与监控\">经济仪表盘与监控</h2><p>运营中的虚拟经济需要实时监控系统来检测异常并辅助决策。经济仪表盘（Economy Dashboard）是运营团队的核心工具，它追踪关键经济指标并在偏离正常范围时发出预警。</p>\n<p>核心监控指标：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[经济仪表盘] --&gt; B[货币总量]&#10;    A --&gt; C[物价指数]&#10;    A --&gt; D[基尼系数]&#10;    A --&gt; E[流通速度]&#10;    B --&gt; F{总量趋势}&#10;    C --&gt; G{价格波动}&#10;    D --&gt; H{贫富差距}&#10;    E --&gt; I{交易活跃}&#10;    F --&gt;|持续上升| J[通胀预警]&#10;    G --&gt;|剧烈波动| K[市场异常]&#10;    H --&gt;|过大| L[公平性危机]&#10;    I --&gt;|骤降| M[活跃度危机]\">graph TD\n    A[经济仪表盘] --&gt; B[货币总量]\n    A --&gt; C[物价指数]\n    A --&gt; D[基尼系数]\n    A --&gt; E[流通速度]\n    B --&gt; F{总量趋势}\n    C --&gt; G{价格波动}\n    D --&gt; H{贫富差距}\n    E --&gt; I{交易活跃}\n    F --&gt;|持续上升| J[通胀预警]\n    G --&gt;|剧烈波动| K[市场异常]\n    H --&gt;|过大| L[公平性危机]\n    I --&gt;|骤降| M[活跃度危机]</pre><table>\n<thead>\n<tr>\n<th>指标</th>\n<th>健康范围</th>\n<th>预警阈值</th>\n<th>干预手段</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>货币总量增速</td>\n<td>2-5%/周</td>\n<td>&gt;10%/周</td>\n<td>增加消耗活动</td>\n</tr>\n<tr>\n<td>CPI 变化率</td>\n<td>±3%/周</td>\n<td>&gt;±8%/周</td>\n<td>价格调控</td>\n</tr>\n<tr>\n<td>基尼系数</td>\n<td>0.3-0.5</td>\n<td>&gt;0.7</td>\n<td>新手补助</td>\n</tr>\n<tr>\n<td>日均交易额</td>\n<td>稳定波动</td>\n<td>骤降50%</td>\n<td>活动刺激</td>\n</tr>\n</tbody></table>\n<p>经济数据分析不仅用于发现问题，更应用于预测趋势。通过历史数据建立经济模型，可以在新内容上线前预测其对经济的影响，提前调整参数避免上线后的紧急修复。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((资源流动与循环))&#10;    水龙头模型&#10;      可预测产出&#10;      技能产出&#10;      随机产出&#10;    排水口架构&#10;      必要消耗&#10;      优化消耗&#10;      展示消耗&#10;      竞争消耗&#10;    资源转化&#10;      价值链设计&#10;      套利检测&#10;      单向增值&#10;    经济监控&#10;      货币总量&#10;      物价指数&#10;      基尼系数&#10;      流通速度\">mindmap\n  root((资源流动与循环))\n    水龙头模型\n      可预测产出\n      技能产出\n      随机产出\n    排水口架构\n      必要消耗\n      优化消耗\n      展示消耗\n      竞争消耗\n    资源转化\n      价值链设计\n      套利检测\n      单向增值\n    经济监控\n      货币总量\n      物价指数\n      基尼系数\n      流通速度</pre><ul>\n<li>资源流动遵循&quot;水龙头-水池-排水口&quot;模型，三者动态平衡维持经济健康</li>\n<li>产出渠道按可预测、技能和随机分类，可预测产出应占 50-60%</li>\n<li>消耗设计分为必要、优化、展示和竞争四层，在&quot;不得不花&quot;与&quot;想要花&quot;间平衡</li>\n<li>资源转化必须检测套利环路，价值链遵循单向增值原则</li>\n<li>经济仪表盘监控货币总量、物价指数、基尼系数和流通速度四个核心指标</li>\n<li>运营经济是持续过程，需要实时监控、预测建模和动态调控三位一体</li>\n</ul>\n","headings":[{"level":1,"text":"资源流动与循环","id":"资源流动与循环"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"产出设计与水龙头调控","id":"产出设计与水龙头调控"},{"level":2,"text":"消耗设计与排水口架构","id":"消耗设计与排水口架构"},{"level":2,"text":"资源转化与价值链","id":"资源转化与价值链"},{"level":2,"text":"经济仪表盘与监控","id":"经济仪表盘与监控"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"虚拟经济体系","url":"/l-doc-books/h/game-development/game-design/game-economy/virtual-economy"},"next":{"title":"商业化模式设计","url":"/l-doc-books/h/game-development/game-design/game-economy/monetization"}}