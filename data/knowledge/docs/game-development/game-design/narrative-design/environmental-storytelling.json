\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    elementDiscoveryRates: discoveryRates,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    overallComprehension: storyComprehension,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    blindSpots: discoveryRates</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.discoveryRate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'hidden_narrative'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.elementId),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 叙事层次金字塔&#10;        L1[第一层 世界基调] --&gt; L2[第二层 事件痕迹]&#10;        L2 --&gt; L3[第三层 个人故事]&#10;        L3 --&gt; L4[第四层 隐藏叙事]&#10;    end&#10;    L1 --&gt;|100%玩家感知| P1[即时沉浸]&#10;    L2 --&gt;|70-80%玩家感知| P2[事件理解]&#10;    L3 --&gt;|40-60%玩家感知| P3[情感共鸣]&#10;    L4 --&gt;|10-20%玩家发现| P4[深度满足]\">graph LR\n    subgraph 叙事层次金字塔\n        L1[第一层 世界基调] --&gt; L2[第二层 事件痕迹]\n        L2 --&gt; L3[第三层 个人故事]\n        L3 --&gt; L4[第四层 隐藏叙事]\n    end\n    L1 --&gt;|100%玩家感知| P1[即时沉浸]\n    L2 --&gt;|70-80%玩家感知| P2[事件理解]\n    L3 --&gt;|40-60%玩家感知| P3[情感共鸣]\n    L4 --&gt;|10-20%玩家发现| P4[深度满足]</pre><h2 id=\"视觉叙事语言\">视觉叙事语言</h2><p>视觉叙事语言（Visual Narrative Language）是环境叙事的核心工具集。设计者通过色彩、光影、构图、比例和材质等视觉元素传达叙事信息，就像文字叙事中的修辞手法一样。</p>\n<p><strong>色彩叙事</strong>——色彩是最直接的情感触发器。暖色调传递温暖、安全和生机，冷色调传递忧郁、危险和死寂。色彩的转变可以标记叙事转折点——当玩家从温暖的回忆闪回进入冰冷的现实时，色调的骤变放大了情感冲击。</p>\n<p><strong>光影叙事</strong>——光线的方向、强度和颜色都携带叙事信息。顶光创造审判感，侧光创造戏剧性，逆光创造神秘感。黑暗中的一束光既是引导手段也是希望的隐喻。</p>\n<p><strong>空间比例叙事</strong>——空间的大小与角色的关系传递权力和情感信息。巨大的雕像和空旷的大厅让角色显得渺小，传递敬畏或压迫；温馨的小屋和精致的装饰让角色感到安全。</p>\n<table>\n<thead>\n<tr>\n<th>视觉元素</th>\n<th>叙事功能</th>\n<th>情感效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>暖色调</td>\n<td>安全/过去/温馨</td>\n<td>怀旧/安心</td>\n</tr>\n<tr>\n<td>冷色调</td>\n<td>危险/现在/孤寂</td>\n<td>不安/紧张</td>\n</tr>\n<tr>\n<td>高对比光</td>\n<td>冲突/选择/转折</td>\n<td>戏剧性</td>\n</tr>\n<tr>\n<td>低对比光</td>\n<td>平静/日常/过渡</td>\n<td>安宁</td>\n</tr>\n<tr>\n<td>对称构图</td>\n<td>秩序/权威/宗教</td>\n<td>庄严</td>\n</tr>\n<tr>\n<td>不对称构图</td>\n<td>混乱/冲突/动态</td>\n<td>不安</td>\n</tr>\n<tr>\n<td>垂直比例</td>\n<td>权力/神圣/压迫</td>\n<td>敬畏</td>\n</tr>\n<tr>\n<td>水平比例</td>\n<td>广阔/自由/孤独</td>\n<td>渺小感</td>\n</tr>\n</tbody></table>\n<h2 id=\"物件叙事与场景搭建\">物件叙事与场景搭建</h2><p>物件叙事（Prop Storytelling）是环境叙事中信息密度最高的手法。一个精心摆放的物件可以在几秒内传达复杂的叙事信息。设计者需要像侦探小说家一样思考——每个物件都是一条线索，多条线索交织构成完整的故事。</p>\n<p>物件叙事的核心原则：</p>\n<p><strong>位置即信息</strong>——物件的摆放位置暗示使用情境。工作台上的工具说明有人正在工作，地上散落的工具说明工作被突然中断。</p>\n<p><strong>状态即时间</strong>——物件的损坏程度暗示时间线。新鲜的血迹说明事件刚刚发生，干涸的血迹说明已经过去很久。生锈的武器和崭新的子弹说明有人最近来过这里。</p>\n<p><strong>数量即规模</strong>——物件的数量暗示事件规模。一具尸体是个人悲剧，成排的尸体是战争。一个空酒瓶是偶尔饮酒，一堆空酒瓶是酗酒问题。</p>\n<p><strong>对比即冲突</strong>——不协调的物件组合创造最强的叙事张力。儿童的玩具旁边放着武器，暗示了战争对平民的影响。精美的餐具上覆盖着灰尘，暗示了主人的突然离去。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface NarrativeProp {&#10;  id: string;&#10;  assetName: string;&#10;  state: &#39;pristine&#39; | &#39;worn&#39; | &#39;damaged&#39; | &#39;destroyed&#39;;&#10;  placement: PropPlacement;&#10;  narrativeFunction: &#39;character_trait&#39; | &#39;event_evidence&#39; | &#39;timeline_marker&#39; | &#39;contrast&#39;;&#10;  storyContribution: string;&#10;  relatedProps: string[];&#10;}&#10;&#10;interface PropPlacement {&#10;  surface: &#39;floor&#39; | &#39;table&#39; | &#39;wall&#39; | &#39;shelf&#39; | &#39;hidden&#39;;&#10;  orientation: &#39;upright&#39; | &#39;fallen&#39; | &#39;scattered&#39; | &#39;deliberately_placed&#39;;&#10;  lighting: &#39;highlighted&#39; | &#39;ambient&#39; | &#39;shadow&#39;;&#10;}&#10;&#10;interface NarrativeScene {&#10;  props: NarrativeProp[];&#10;  intendedStory: string;&#10;  emotionalGoal: string;&#10;  minDiscoveryForComprehension: number;&#10;}&#10;&#10;function arrangeNarrativeScene(scene: NarrativeScene): ArrangementPlan {&#10;  const criticalProps = scene.props.filter((p) =&gt; p.narrativeFunction === &#39;event_evidence&#39;);&#10;  const detailProps = scene.props.filter((p) =&gt; p.narrativeFunction === &#39;character_trait&#39;);&#10;  const contrastProps = scene.props.filter((p) =&gt; p.narrativeFunction === &#39;contrast&#39;);&#10;&#10;  return {&#10;    immediateLayer: criticalProps.map((p) =&gt; ({&#10;      ...p,&#10;      placement: { ...p.placement, lighting: &#39;highlighted&#39; },&#10;    })),&#10;    explorationLayer: detailProps.map((p) =&gt; ({&#10;      ...p,&#10;      placement: { ...p.placement, lighting: &#39;ambient&#39; },&#10;    })),&#10;    hiddenLayer: contrastProps.map((p) =&gt; ({&#10;      ...p,&#10;      placement: { ...p.placement, lighting: &#39;shadow&#39; },&#10;    })),&#10;    narrativeCompleteness: criticalProps.length / scene.minDiscoveryForComprehension,&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NarrativeProp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  assetName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pristine'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'worn'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'damaged'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'destroyed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<spa