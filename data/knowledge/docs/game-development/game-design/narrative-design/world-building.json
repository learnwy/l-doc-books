-dark:#FFAB70\">  sharedInterests</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  coreConflicts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateFactionConflict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">factionA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Faction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">factionB</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Faction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConflictSeed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ideologyGap</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(factionA.ideology.primaryAxis.position </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> factionB.ideology.primaryAxis.position);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sharedInterests</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> factionA.interests.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> factionB.interests.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> competingResources</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sharedInterests.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    type: ideologyGap </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 60</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ideological'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'resource'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    intensity: ideologyGap </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.6</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (competingResources </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 30</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    flashpoints: sharedInterests,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    narrativePotential: ideologyGap </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 40</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> competingResources </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'high'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'medium'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>阵营间的关系网络构成了游戏世界的政治生态。设计者需要确保这个网络中存在足够的张力和动态变化的可能性——如果所有阵营关系固定不变，世界就缺乏戏剧性。</p>\n<h2 id=\"世界圣经与设定管理\">世界圣经与设定管理</h2><p>世界圣经（World Bible）是世界观的权威参考文档，记录了所有已确定的设定细节。在大型团队中，世界圣经确保美术、设计、叙事和音频等不同部门对世界的理解一致。</p>\n<p>世界圣经的组织结构通常包含：</p>\n<p><strong>核心层</strong>——不可变更的基础设定。宇宙法则、大历史框架、核心文化特征。这些设定一旦确定就不能随意修改，因为大量后续内容依赖于它们。</p>\n<p><strong>扩展层</strong>——可在框架内扩展的设定。具体地区的历史、次要角色的背景、日常生活细节。这些内容随开发进展持续补充。</p>\n<p><strong>临时层</strong>——尚未最终确定的设定。标记为&quot;草案&quot;或&quot;待确认&quot;，随时可能调整。</p>\n<table>\n<thead>\n<tr>\n<th>文档类型</th>\n<th>内容</th>\n<th>更新频率</th>\n<th>访问权限</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>核心设定</td>\n<td>宇宙法则、大事年表</td>\n<td>极少修改</td>\n<td>全团队</td>\n</tr>\n<tr>\n<td>地区指南</td>\n<td>每个区域的详细设定</td>\n<td>按需更新</td>\n<td>相关部门</td>\n</tr>\n<tr>\n<td>角色档案</td>\n<td>角色背景、性格、关系</td>\n<td>频繁更新</td>\n<td>叙事+设计</td>\n</tr>\n<tr>\n<td>视觉指南</td>\n<td>美术风格、配色、符号</td>\n<td>版本迭代</td>\n<td>美术+设计</td>\n</tr>\n<tr>\n<td>术语表</td>\n<td>专有名词和释义</td>\n<td>持续追加</td>\n<td>全团队+本地化</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[世界圣经] --&gt; B[核心层]&#10;    A --&gt; C[扩展层]&#10;    A --&gt; D[临时层]&#10;    B --&gt; E[宇宙法则]&#10;    B --&gt; F[大历史框架]&#10;    B --&gt; G[核心文化]&#10;    C --&gt; H[地区设定]&#10;    C --&gt; I[角色档案]&#10;    C --&gt; J[任务背景]&#10;    D --&gt; K[待确认设定]&#10;    D --&gt; L[替代方案]\">graph TD\n    A[世界圣经] --&gt; B[核心层]\n    A --&gt; C[扩展层]\n    A --&gt; D[临时层]\n    B --&gt; E[宇宙法则]\n    B --&gt; F[大历史框架]\n    B --&gt; G[核心文化]\n    C --&gt; H[地区设定]\n    C --&gt; I[角色档案]\n    C --&gt; J[任务背景]\n    D --&gt; K[待确认设定]\n    D --&gt; L[替代方案]</pre><p>管理世界圣经的关键实践是<strong>版本控制和变更流程</strong>。每次设定变更都应记录变更原因、影响范围和审批人。特别是核心层的变更，必须评估其对已有内容的连锁影响。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((世界观构建))&#10;    构建方法&#10;      自上而下&#10;      自下而上&#10;      混合使用&#10;    魔法体系&#10;      桑德森三定律&#10;      硬vs软魔法&#10;      规则与限制&#10;    阵营设计&#10;      四维模型&#10;      关系网络&#10;      冲突生成&#10;    世界圣经&#10;      核心层&#10;      扩展层&#10;      版本控制\">mindmap\n  root((世界观构建))\n    构建方法\n      自上而下\n      自下而上\n      混合使用\n    魔法体系\n      桑德森三定律\n      硬vs软魔法\n      规则与限制\n    阵营设计\n      四维模型\n      关系网络\n      冲突生成\n    世界圣经\n      核心层\n      扩展层\n      版本控制</pre><ul>\n<li>世界观构建以&quot;自洽性优先&quot;为核心原则，所有设定必须在自身规则内保持一致</li>\n<li>自上而下保证全局一致，自下而上贴合开发节奏，实践中两者结合使用</li>\n<li>魔法/科技体系遵循桑德森三定律，限制比能力更有趣</li>\n<li>阵营设计通过意识形态、利益诉求、组织形式和文化特征四个维度构建</li>\n<li>世界圣经是团队对世界理解一致的保证，分核心层、扩展层和临时层管理</li>\n<li>设定变更需要版本控制和影响评估流程，核心层变更尤需谨慎</li>\n</ul>\n","headings":[{"level":1,"text":"世界观构建","id":"世界观构建"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"自上而下与自下而上","id":"自上而下与自下而上"},{"level":2,"text":"魔法/科技体系设计","id":"魔法-科技体系设计"},{"level":2,"text":"阵营与文明设计","id":"阵营与文明设计"},{"level":2,"text":"世界圣经与设定管理","id":"世界圣经与设定管理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"对话系统设计","url":"/l-doc-books/h/game-development/game-design/narrative-design/dialogue-systems"},"next":{"title":"环境叙事","url":"/l-doc-books/h/game-development/game-design/narrative-design/environmental-storytelling"}}