83\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'critical'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> explorationRatio</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sideContent.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> criticalEdges.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    criticalPathTime: totalTime,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    averageDifficulty: avgDifficulty,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    explorationRatio,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    secretCount: network.nodes.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n.type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'secret'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"空间节奏与压缩-释放\">空间节奏与压缩-释放</h2><p>空间节奏（Spatial Rhythm）是通过空间形态的变化来创造情感韵律。最基本的空间节奏模式是&quot;压缩-释放&quot;（Compression-Release）——从狭窄封闭的空间进入开阔明亮的空间时，产生一种强烈的解放感和发现感。</p>\n<p>这种技法在建筑学中被称为&quot;序列空间&quot;（Spatial Sequence），安藤忠雄的&quot;光之教堂&quot;就是其极致表达——狭长昏暗的入口通道突然转入十字光芒的礼堂，产生震撼的精神体验。</p>\n<p>在游戏中，空间节奏的编排原则：</p>\n<table>\n<thead>\n<tr>\n<th>空间序列</th>\n<th>情感效果</th>\n<th>游戏应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>窄→宽</td>\n<td>释放感、发现感</td>\n<td>Boss 战前的走廊→竞技场</td>\n</tr>\n<tr>\n<td>宽→窄</td>\n<td>压迫感、紧张感</td>\n<td>安全区→危险地带</td>\n</tr>\n<tr>\n<td>暗→明</td>\n<td>希望感、解脱感</td>\n<td>地下城出口</td>\n</tr>\n<tr>\n<td>明→暗</td>\n<td>不安感、未知感</td>\n<td>进入洞穴/废墟</td>\n</tr>\n<tr>\n<td>低→高</td>\n<td>成就感、壮阔感</td>\n<td>攀爬至山顶</td>\n</tr>\n<tr>\n<td>高→低</td>\n<td>失落感、下沉感</td>\n<td>坠入深渊</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[入口走廊] --&gt;|压缩| B[狭窄通道]&#10;    B --&gt;|释放| C[中央大厅]&#10;    C --&gt;|再压缩| D[侧翼走廊]&#10;    D --&gt;|高潮释放| E[Boss 竞技场]&#10;    E --&gt;|缓冲| F[宝箱房/存档点]\">graph LR\n    A[入口走廊] --&gt;|压缩| B[狭窄通道]\n    B --&gt;|释放| C[中央大厅]\n    C --&gt;|再压缩| D[侧翼走廊]\n    D --&gt;|高潮释放| E[Boss 竞技场]\n    E --&gt;|缓冲| F[宝箱房/存档点]</pre><p>空间压缩不仅影响水平维度，垂直维度同样重要。低矮的天花板制造压迫，挑高的穹顶传递庄严。在同一关卡中交替使用不同层高，可以在不改变地面布局的情况下创造丰富的空间体验变化。</p>\n<h2 id=\"度量设计与人体工学\">度量设计与人体工学</h2><p>游戏空间的度量（Metrics）设计需要以角色的运动能力为基础。每个空间元素的尺寸——平台宽度、跳跃间距、通道高度、掩体大小——都应与角色的物理参数严格匹配。</p>\n<p>度量表（Metrics Sheet）是关卡设计师的基本工具，它记录了角色在各种状态下的精确运动参数：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface CharacterMetrics {&#10;  standing: {&#10;    height: number;&#10;    width: number;&#10;    eyeHeight: number;&#10;  };&#10;  movement: {&#10;    walkSpeed: number;&#10;    runSpeed: number;&#10;    sprintSpeed: number;&#10;    acceleration: number;&#10;  };&#10;  jump: {&#10;    maxHeight: number;&#10;    maxDistance: number;&#10;    hangTime: number;&#10;    minPlatformWidth: number;&#10;  };&#10;  combat: {&#10;    meleeRange: number;&#10;    coverHeight: number;&#10;    vaultHeight: number;&#10;    slideDistance: number;&#10;  };&#10;}&#10;&#10;function calculatePlatformGap(metrics: CharacterMetrics, difficultyFactor: number): number {&#10;  const maxSafe = metrics.jump.maxDistance * 0.85;&#10;  const minChallenge = metrics.jump.maxDistance * 0.5;&#10;  return minChallenge + (maxSafe - minChallenge) * (1 - difficultyFactor);&#10;}&#10;&#10;function validateCoverPlacement(metrics: CharacterMetrics, coverHeight: number, spacing: number): boolean {&#10;  const canHideBehind = coverHeight &gt;= metrics.standing.height * 0.6;&#10;  const canVaultOver = coverHeight &lt;= metrics.combat.vaultHeight;&#10;  const hasMovementSpace = spacing &gt;= metrics.standing.width * 2.5;&#10;  return canHideBehind &amp;&amp; canVaultOver &amp;&amp; hasMovementSpace;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CharacterMetrics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  standing</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    height</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    width</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    eyeHeight</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  movement</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    walkSpeed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    runSpeed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    sprintSpeed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    acceleration</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\