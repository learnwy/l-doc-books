ki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> maxSafe</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics.jump.maxDistance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.85</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> minChallenge</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics.jump.maxDistance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> minChallenge </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (maxSafe </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> minChallenge) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> difficultyFactor);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> validateCoverPlacement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">metrics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CharacterMetrics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">coverHeight</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">spacing</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> canHideBehind</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> coverHeight </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics.standing.height </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> canVaultOver</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> coverHeight </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics.combat.vaultHeight;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hasMovementSpace</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> spacing </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics.standing.width </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> canHideBehind </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> canVaultOver </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hasMovementSpace;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>度量设计的黄金法则是&quot;70% 规则&quot;——关键跳跃距离应设置为角色最大跳跃距离的 70% 左右。这个比例既提供了一定的挑战感，又留有足够的容错空间，避免由于轻微操作失误导致的不公平死亡。在难度更高的区域可以逐步推至 80%-90%，在教学区域则应降至 50%-60%。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((空间构成与引导))&#10;    视线控制&#10;      维斯塔技法&#10;      主次补焦点&#10;      视觉优先级&#10;    路径设计&#10;      主路径&#10;      旁路与隐藏路径&#10;      捷径系统&#10;    空间节奏&#10;      压缩-释放&#10;      垂直维度变化&#10;      序列空间&#10;    度量设计&#10;      角色参数表&#10;      70%安全法则&#10;      掩体验证\">mindmap\n  root((空间构成与引导))\n    视线控制\n      维斯塔技法\n      主次补焦点\n      视觉优先级\n    路径设计\n      主路径\n      旁路与隐藏路径\n      捷径系统\n    空间节奏\n      压缩-释放\n      垂直维度变化\n      序列空间\n    度量设计\n      角色参数表\n      70%安全法则\n      掩体验证</pre><ul>\n<li>空间构成通过形态、比例和视线编排塑造玩家的行动路径和情感体验</li>\n<li>视线控制是最强大的空间引导工具，运用维斯塔技法和三级焦点层次引导注视</li>\n<li>路径设计创造有意义的选择，主路径清晰可见，旁路和隐藏路径奖励探索</li>\n<li>压缩-释放是空间节奏的基本模式，通过宽窄、明暗和高低的对比创造情感韵律</li>\n<li>度量设计以角色运动参数为基础，&quot;70% 法则&quot;平衡了挑战性和公平性</li>\n<li>空间本身是叙事的载体，每一种空间形态都传递特定的情感信号</li>\n</ul>\n","headings":[{"level":1,"text":"空间构成与引导","id":"空间构成与引导"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"视线控制与视觉焦点","id":"视线控制与视觉焦点"},{"level":2,"text":"路径设计与流动编排","id":"路径设计与流动编排"},{"level":2,"text":"空间节奏与压缩-释放","id":"空间节奏与压缩-释放"},{"level":2,"text":"度量设计与人体工学","id":"度量设计与人体工学"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"关卡设计原则","url":"/l-doc-books/h/game-development/game-design/level-design/level-design-principles"},"next":{"title":"难度曲线设计","url":"/l-doc-books/h/game-development/game-design/level-design/difficulty-curve"}}