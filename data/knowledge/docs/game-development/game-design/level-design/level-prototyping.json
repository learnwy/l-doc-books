dark:#FFAB70\">z</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> z.id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> proto.criticalPath[i])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(prevZone.intensity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currZone.intensity) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      issues.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`intensity_spike_at_${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">currZone</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">id</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { valid: issues.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, issues };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>纸面原型的工具选择取决于项目规模。小型独立团队用方格纸就足够，大型项目则可以使用 Miro 或 Figma 进行协作式的空间规划，方便与关卡设计组和美术团队共享和讨论。</p>\n<h2 id=\"灰盒构建与度量验证\">灰盒构建与度量验证</h2><p>灰盒原型（Greybox）是用最简单的几何体（方块、圆柱、斜面）在游戏引擎中搭建的可运行关卡。它是关卡设计中最重要的阶段——在灰盒中发现的问题修复成本最低，而遗漏到后期的问题修复成本则呈指数增长。</p>\n<p>灰盒构建的核心原则是&quot;只用基础形状&quot;。禁止使用任何美术资源——没有纹理、没有模型、没有特效。这种&quot;丑陋&quot;的视觉确保评审时所有人都聚焦于设计本身而非视觉表现。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[灰盒构建] --&gt; B[度量验证]&#10;    B --&gt; C[移动测试]&#10;    B --&gt; D[视线测试]&#10;    B --&gt; E[节奏测试]&#10;    C --&gt; F{角色能正常通过?}&#10;    D --&gt; G{视觉引导有效?}&#10;    E --&gt; H{节奏舒适?}&#10;    F --&gt;|否| I[调整尺寸]&#10;    G --&gt;|否| J[调整布局]&#10;    H --&gt;|否| K[调整间距]&#10;    I --&gt; A&#10;    J --&gt; A&#10;    K --&gt; A&#10;    F --&gt;|是| L[通过]&#10;    G --&gt;|是| L&#10;    H --&gt;|是| L&#10;    L --&gt; M[进入白盒]\">graph TD\n    A[灰盒构建] --&gt; B[度量验证]\n    B --&gt; C[移动测试]\n    B --&gt; D[视线测试]\n    B --&gt; E[节奏测试]\n    C --&gt; F{角色能正常通过?}\n    D --&gt; G{视觉引导有效?}\n    E --&gt; H{节奏舒适?}\n    F --&gt;|否| I[调整尺寸]\n    G --&gt;|否| J[调整布局]\n    H --&gt;|否| K[调整间距]\n    I --&gt; A\n    J --&gt; A\n    K --&gt; A\n    F --&gt;|是| L[通过]\n    G --&gt;|是| L\n    H --&gt;|是| L\n    L --&gt; M[进入白盒]</pre><p>灰盒阶段的验证清单：</p>\n<table>\n<thead>\n<tr>\n<th>验证项</th>\n<th>检查内容</th>\n<th>通过标准</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>主路径可达</td>\n<td>从起点到终点无阻断</td>\n<td>100% 可完成</td>\n</tr>\n<tr>\n<td>跳跃度量</td>\n<td>所有跳跃间距在安全范围内</td>\n<td>≤ 最大距离 85%</td>\n</tr>\n<tr>\n<td>掩体覆盖</td>\n<td>战斗区域有足够的掩体</td>\n<td>每 10 米至少 1 个</td>\n</tr>\n<tr>\n<td>视线引导</td>\n<td>关键岔路口有明确方向暗示</td>\n<td>测试者 80% 选对</td>\n</tr>\n<tr>\n<td>节奏感</td>\n<td>无连续 3 分钟无变化的区域</td>\n<td>强度每 90 秒有波动</td>\n</tr>\n<tr>\n<td>回溯友好</td>\n<td>有捷径或快速回溯机制</td>\n<td>回溯时间 ≤ 首次的 50%</td>\n</tr>\n</tbody></table>\n<p>灰盒的另一个关键实践是&quot;度量验证&quot;——将角色放入空间中，实际测量每个跳跃间距、掩体高度和视线距离是否与度量表匹配。这种测量应该系统化，而非凭感觉判断。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface GreyboxMetricsTest {&#10;  testPoints: Array&lt;{&#10;    position: Vector3;&#10;    type: &#39;jump_gap&#39; | &#39;cover_height&#39; | &#39;sight_distance&#39; | &#39;ceiling_height&#39;;&#10;    measuredValue: number;&#10;    expectedRange: [number, number];&#10;  }&gt;;&#10;}&#10;&#10;function runMetricsValidation(test: GreyboxMetricsTest): MetricsReport {&#10;  const results = test.testPoints.map((point) =&gt; ({&#10;    ...point,&#10;    passed: point.measuredValue &gt;= point.expectedRange[0] &amp;&amp; point.measuredValue &lt;= point.expectedRange[1],&#10;    deviation:&#10;      point.measuredValue &lt; point.expectedRange[0]&#10;        ? point.measuredValue - point.expectedRange[0]&#10;        : point.measuredValue &gt; point.expectedRange[1]&#10;          ? point.measuredValue - point.expectedRange[1]&#10;          : 0,&#10;  }));&#10;&#10;  return {&#10;    totalTests: results.length,&#10;    passed: results.filter((r) =&gt; r.passed).length,&#10;    failed: results.filter((r) =&gt; !r.passed),&#10;    passRate: results.filter((r) =&gt; r.passed).length / results.length,&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GreyboxMetricsTest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  testPoints</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    position</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Vector3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'jump_gap'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'cover_height'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'sight_distance'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ceiling_height'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    measuredValue</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    expectedRange</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292