">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> samples; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> t</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> samples;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> smoothed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        beat.type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'climax'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> beat.intensity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">PI</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> beat.intensity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.8</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">PI</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      curve.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(smoothed);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> curve;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"空间叙事与环境线索\">空间叙事与环境线索</h2><p>关卡空间本身就是叙事的载体。环境叙事（Environmental Storytelling）通过空间布置、物品摆放和痕迹暗示来讲述故事，而非依赖文字或对话。这种叙事方式尊重玩家的主动性——故事不是被动接收的，而是被主动发现的。</p>\n<p>环境叙事的四种层次：</p>\n<p><strong>场景设定层</strong>——整体环境传达的宏观信息。一座废弃的城市告诉玩家这里发生过灾难，而不需要任何文字说明。</p>\n<p><strong>物品摆放层</strong>——物品的位置和状态暗示具体事件。桌上翻倒的椅子、半杯未饮的咖啡暗示主人匆忙离去。</p>\n<p><strong>痕迹叙事层</strong>——墙上的弹孔、地上的血迹、门上的抓痕都是故事的片段。</p>\n<p><strong>交互发现层</strong>——需要玩家主动交互才能获取的深层信息，如日记、录音带、电子邮件。</p>\n<p>关卡空间的功能分区也影响叙事节奏。公共空间（大厅、广场）传递宏观叙事，私密空间（卧室、办公室）传递个人故事，过渡空间（走廊、楼梯）则用于节奏调节和预兆暗示。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface SpaceZone {&#10;  type: &#39;public&#39; | &#39;private&#39; | &#39;transition&#39; | &#39;hidden&#39;;&#10;  narrativeFunction: string;&#10;  intensityRange: [number, number];&#10;  explorationDensity: number;&#10;}&#10;&#10;const levelZones: SpaceZone[] = [&#10;  {&#10;    type: &#39;public&#39;,&#10;    narrativeFunction: &#39;establish_setting&#39;,&#10;    intensityRange: [1, 3],&#10;    explorationDensity: 0.3,&#10;  },&#10;  {&#10;    type: &#39;transition&#39;,&#10;    narrativeFunction: &#39;build_tension&#39;,&#10;    intensityRange: [2, 5],&#10;    explorationDensity: 0.1,&#10;  },&#10;  {&#10;    type: &#39;private&#39;,&#10;    narrativeFunction: &#39;reveal_personal_story&#39;,&#10;    intensityRange: [3, 6],&#10;    explorationDensity: 0.8,&#10;  },&#10;  {&#10;    type: &#39;hidden&#39;,&#10;    narrativeFunction: &#39;reward_exploration&#39;,&#10;    intensityRange: [1, 2],&#10;    explorationDensity: 1.0,&#10;  },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SpaceZone</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  type</span><span style=\"co