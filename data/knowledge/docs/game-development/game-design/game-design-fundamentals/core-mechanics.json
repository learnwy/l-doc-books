E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    handlers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(handler);</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.listeners.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(eventType, handlers);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> idx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> handlers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">indexOf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(handler);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) handlers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">splice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(idx, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>规则耦合</strong>——系统间通过共享规则直接交织。例如塞尔达中火焰既是战斗手段也是解谜工具，还能影响环境物理。这种耦合产生最强涌现，但也最难调试和平衡。</p>\n<p>设计者需要有意识地选择耦合层级，在涌现性和可控性之间找到平衡。一个实用的原则是&quot;核心循环内高耦合，外围系统低耦合&quot;。</p>\n<h2 id=\"迭代与原型验证\">迭代与原型验证</h2><p>核心机制的设计不是一次性完成的，而是通过快速原型和迭代测试逐步打磨的过程。一个常见的误区是在纸面上过度设计机制细节，然而许多机制的手感（Game Feel）只有在实际操作中才能评估。</p>\n<p>原型验证的流程遵循&quot;灰盒测试法&quot;：</p>\n<p>第一阶段是<strong>纸面原型</strong>，用最简单的方式验证规则逻辑。卡牌游戏和回合制策略可以直接用纸牌测试，动作游戏则用流程图模拟状态转换。</p>\n<p>第二阶段是<strong>数字灰盒</strong>，用最少的美术资源实现核心交互。此阶段关注三个指标——操作响应延迟（是否低于 100 毫秒）、状态转换是否直觉化、基础循环是否产生重复游玩欲望。</p>\n<p>第三阶段是<strong>参数调优</strong>，通过数据驱动的方式微调机制参数。以下是一个参数化设计的示例：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MechanicsConfig {&#10;  jump: {&#10;    height: number;&#10;    duration: number;&#10;    coyoteTime: number;&#10;    bufferTime: number;&#10;    gravity: number;&#10;    fallGravityMultiplier: number;&#10;  };&#10;  dash: {&#10;    distance: number;&#10;    duration: number;&#10;    cooldown: number;&#10;    invincibleFrames: number;&#10;  };&#10;  combat: {&#10;    lightAttackDamage: number;&#10;    heavyAttackDamage: number;&#10;    comboWindow: number;&#10;    hitStunDuration: number;&#10;  };&#10;}&#10;&#10;function applyConfig(config: MechanicsConfig, entity: GameEntity): void {&#10;  entity.jumpForce = calculateJumpForce(config.jump.height, config.jump.duration);&#10;  entity.gravityScale = config.jump.gravity;&#10;  entity.dashSpeed = config.dash.distance / config.dash.duration;&#10;  entity.attackData = {&#10;    light: { damage: config.combat.lightAttackDamage },&#10;    heavy: { damage: config.combat.heavyAttackDamage },&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MechanicsConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  jump</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    height</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    duration</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    coyoteTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    bufferTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    gravity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    fallGravityMultiplier</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"