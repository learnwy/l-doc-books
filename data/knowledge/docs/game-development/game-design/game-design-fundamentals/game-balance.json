class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> divisiveModel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DamageFormula</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">attack</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">defense</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((attack </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attack) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (attack </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> defense)));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AttributeScaling</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  base</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  perLevel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  curve</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'linear'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'quadratic'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'logarithmic'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> calculateAttribute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">scaling</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AttributeScaling</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">level</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  switch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (scaling.curve) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'linear'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scaling.base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scaling.perLevel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> level;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'quadratic'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scaling.base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scaling.perLevel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> level </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> level </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.02</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'logarithmic'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scaling.base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scaling.perLevel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(level </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>属性成长曲线的选择直接影响游戏节奏。线性成长提供稳定的提升感，适合短周期游戏。二次曲线在后期加速成长，适合需要&quot;爆发感&quot;的 RPG。对数曲线则让前期快速成长、后期趋缓，适合长期运营的在线游戏。</p>\n<table>\n<thead>\n<tr>\n<th>成长曲线</th>\n<th>前期感受</th>\n<th>中期感受</th>\n<th>后期感受</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>线性</td>\n<td>稳定</td>\n<td>稳定</td>\n<td>稳定</td>\n<td>竞技平衡型</td>\n</tr>\n<tr>\n<td>二次</td>\n<td>缓慢</td>\n<td>适中</td>\n<td>爆发</td>\n<td>单机 RPG</td>\n</tr>\n<tr>\n<td>对数</td>\n<td>快速</td>\n<td>放缓</td>\n<td>趋平</td>\n<td>长线运营</td>\n</tr>\n<tr>\n<td>S 型</td>\n<td>缓慢</td>\n<td>快速</td>\n<td>趋平</td>\n<td>多人 RPG</td>\n</tr>\n</tbody></table>\n<h2 id=\"非对称平衡设计\">非对称平衡设计</h2><p>非对称平衡是现代竞技游戏的核心挑战。在 MOBA、格斗游戏和 RTS 中，不同角色/阵营拥有截然不同的能力组合，却需要在对抗中达到大致平等的胜率。</p>\n<p>非对称平衡的关键原则是<strong>补偿性设计</strong>：每个角色的优势必须伴随明确的劣势，玩家在选择时需要做出有意义的取舍。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 角色设计空间&#10;        T[坦克] --&gt;|高生存 低输出| B[平衡点]&#10;        D[刺客] --&gt;|高爆发 低耐久| B&#10;        S[辅助] --&gt;|高增益 低独立| B&#10;        M[法师] --&gt;|高范围 低机动| B&#10;        R[射手] --&gt;|高持续 低防御| B&#10;    end\">graph LR\n    subgraph 角色设计空间\n        T[坦克] --&gt;|高生存 低输出| B[平衡点]\n        D[刺客] --&gt;|高爆发 低耐久| B\n        S[辅助] --&gt;|高增益 低独立| B\n        M[法师] --&gt;|高范围 低机动| B\n        R[射手] --&gt;|高持续 低防御| B\n    end</pre><p>角色平衡的量化评估需要综合多个维度：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface CharacterProfile {&#10;  name: string;&#10;  survability: number;&#10;  damage: number;&#10;  mobility: number;&#10;  utility: number;&#10;  difficulty: number;&#10;}&#10;&#10;interface BalanceMetrics {&#10;  winRate: number;&#10;  pickRate: number;&#10;  banRate: number;&#10;  averageKDA: number;&#10;}&#10;&#10;function calculatePowerBudget(profile: CharacterProfile): number {&#10;  const weights = {&#10;    survability: 1.0,&#10;    damage: 1.2,&#10;    mobility: 0.8,&#10;    utility: 0.9,&#10;    difficulty: -0.3,&#10;  };&#10;&#10;  return (&#10;    profile.survability * weights.survability +&#10;    profile.damage * weights.damage +&#10;    profile.mobility * weights.mobility +&#10;    profile.utility * weights.utility +&#10;    profile.difficulty * weights.difficulty&#10;  );&#10;}&#10;&#10;function detectImbalance(metrics: Map&lt;string, BalanceMetrics&gt;, threshold: number): string[] {&#10;  const avgWinRate = 0.5;&#10;  const imbalanced: string[] = [];&#10;&#10;  for (const [name, data] of metrics) {&#10;    const deviation = Math.abs(data.winRate - avgWinRate);&#10;    if (deviation &gt; threshold) {&#10;      imbalanced.push(name);&#10;    }&#10;  }&#10;&#10;  return imbalanced;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CharacterProfile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  survability</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  damage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  mobility</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  utility</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  difficulty</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark: