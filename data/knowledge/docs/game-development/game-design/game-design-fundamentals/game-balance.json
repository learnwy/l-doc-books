#E36209;--shiki-dark:#FFAB70\">metrics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">BalanceMetrics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">threshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> avgWinRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> imbalanced</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> metrics) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> deviation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(data.winRate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> avgWinRate);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (deviation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> threshold) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      imbalanced.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(name);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> imbalanced;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>&quot;能力预算&quot;（Power Budget）是非对称平衡的核心工具。每个角色拥有相同的总预算点数，但分配在不同维度上。坦克将大量预算投入生存力，牺牲了输出和机动性；刺客则将预算集中在爆发伤害和机动性上，生存力极低。</p>\n<p>当某个角色的实际能力超出预算时，需要通过&quot;数值剪刀&quot;进行修剪——削弱其过强维度或增加操作难度作为平衡成本。</p>\n<h2 id=\"经济系统平衡\">经济系统平衡</h2><p>游戏内经济系统的平衡与战斗平衡同样重要。经济失衡会导致通货膨胀（货币贬值）、资源堆积（玩家无消耗动力）或资源饥荒（进度受阻）。</p>\n<p>经济平衡的核心是<strong>水龙头-水池-排水口</strong>模型：</p>\n<p>资源产出（水龙头）的速率必须与资源消耗（排水口）匹配，而玩家持有量（水池）应维持在一个让玩家既有安全感又有追求动力的区间内。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface EconomyState {&#10;  currency: number;&#10;  inflowRate: number;&#10;  outflowRate: number;&#10;  targetReserve: number;&#10;}&#10;&#10;function simulateEconomy(initial: EconomyState, days: number): EconomyState[] {&#10;  const history: EconomyState[] = [initial];&#10;&#10;  for (let day = 1; day &lt;= days; day++) {&#10;    const prev = history[day - 1];&#10;    const surplus = prev.currency - prev.targetReserve;&#10;&#10;    const adjustedOutflow =&#10;      surplus &gt; 0 ? prev.outflowRate * (1 + (surplus / prev.targetReserve) * 0.1) : prev.outflowRate;&#10;&#10;    const newCurrency = prev.currency + prev.inflowRate - adjustedOutflow;&#10;&#10;    history.push({&#10;      currency: Math.max(0, newCurrency),&#10;      inflowRate: prev.inflowRate,&#10;      outflowRate: adjustedOutflow,&#10;      targetReserve: prev.targetReserve,&#10;    });&#10;  }&#10;&#10;  return history;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EconomyState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  currency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  inflowRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  outflowRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  targetReserve</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> simulateEconomy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">initial</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EconomyState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">days</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EconomyState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> history</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EconomyState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [initial];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> day </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; day </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> days; day</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> prev</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> history[day </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> surplus</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.currency </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.targetReserve;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> adjustedOutflow</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      surplus </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.outflowRate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (surplus </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.targetReserve) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.outflowRate;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> newCurrency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.currency </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prev.inflowRate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> adjustedOutflow;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    history.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      currency: Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, newCurrency),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      inflowRate: prev.inflowRate,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      outflowRate: adjustedOutflow,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      targetReserve: prev.targetReserve,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> history;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>长线运营游戏需要设计多层经济体系——基础货币（金币）、高级货币（钻石）和时间货币（体力）各自承担不同功能。它们之间的兑换率和获取途径构成了经济系统的&quot;汇率体系&quot;，需要严格控制以防止套利行为。</p>\n<h2 id=\"自动化测试与数据驱动平衡\">自动化测试与数据驱动平衡</h2><p>现代游戏的复杂度使得人工测试难以覆盖所有平衡场景。自动化仿真和数据驱动决策是大规模平衡的必要手段。</p>\n<p>蒙特卡洛模拟可以在短时间内模拟数万场对局，评估角色间的胜率矩阵。将模拟结果与实际对局数据交叉验证，可以更准确地定位失衡点：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[设计假设] --&gt; B[数值建模]&#10;    B --&gt; C[蒙特卡洛仿真]&#10;    C --&gt; D[胜率矩阵]&#10;    D --&gt; E{偏差可接受?}&#10;    E --&gt;|否| F[调整参数]&#10;    F --&gt; B&#10;    E --&gt;|是| G[上线测试]&#10;    G --&gt; H[实际数据采集]&#10;    H --&gt; I[模型校准]&#10;    I --&gt; B\">graph TD\n    A[设计假设] --&gt; B[数值建模]\n    B --&gt; C[蒙特卡洛仿真]\n    C --&gt; D[胜率矩阵]\n    D --&gt; E{偏差可接受?}\n    E --&gt;|否| F[调整参数]\n    F --&gt; B\n    E --&gt;|是| G[上线测试]\n    G --&gt; H[实际数据采集]\n    H --&gt; I[模型校准]\n    I --&gt; B</pre><p>关键是建立&quot;平衡仪表盘&quot;——一个实时展示核心平衡指标的监控系统。当某个角色的胜率偏离目标区间（通常是 48%-52%）时自动触发预警，让设计团队能够快速响应。</p>\n<p>数据驱动平衡的陷阱在于过度依赖数据而忽视玩家感受。某些角色的胜率可能&quot;平衡&quot;，但操作体验极度不健康——比如一个简单无脑但胜率正好50%的角色，其存在可能大幅降低对手的游戏体验。因此数据分析必须结合社区反馈和设计直觉。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((游戏平衡性设计))&#10;    数值框架&#10;      伤害公式&#10;      属性成长曲线&#10;      等级缩放&#10;    非对称平衡&#10;      能力预算&#10;      补偿性设计&#10;      数值剪刀&#10;    经济平衡&#10;      水龙头-水池-排水口&#10;      多层货币体系&#10;      防套利设计&#10;    自动化验证&#10;      蒙特卡洛仿真&#10;      胜率矩阵&#10;      平衡仪表盘\">mindmap\n  root((游戏平衡性设计))\n    数值框架\n      伤害公式\n      属性成长曲线\n      等级缩放\n    非对称平衡\n      能力预算\n      补偿性设计\n      数值剪刀\n    经济平衡\n      水龙头-水池-排水口\n      多层货币体系\n      防套利设计\n    自动化验证\n      蒙特卡洛仿真\n      胜率矩阵\n      平衡仪表盘</pre><ul>\n<li>平衡不等于对称，而是确保每种有意义的选择都有存在价值</li>\n<li>伤害计算的三种模型（减法、乘法、除法）各有取舍，除法模型是当前主流</li>\n<li>非对称平衡的核心工具是能力预算，通过补偿性设计确保取舍有意义</li>\n<li>经济平衡遵循水龙头-水池-排水口模型，多层货币体系需严格控制兑换率</li>\n<li>自动化仿真和数据驱动是大规模平衡的必要手段，但不能替代设计直觉</li>\n<li>平衡是持续过程而非一次性工作，需要仿真、上线数据和社区反馈的三重验证</li>\n</ul>\n","headings":[{"level":1,"text":"游戏平衡性设计","id":"游戏平衡性设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"数值框架与战斗公式","id":"数值框架与战斗公式"},{"level":2,"text":"非对称平衡设计","id":"非对称平衡设计"},{"level":2,"text":"经济系统平衡","id":"经济系统平衡"},{"level":2,"text":"自动化测试与数据驱动平衡","id":"自动化测试与数据驱动平衡"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"玩家体验与心流","url":"/l-doc-books/h/game-development/game-design/game-design-fundamentals/player-experience"},"next":{"title":"反馈系统与奖励机制","url":"/l-doc-books/h/game-development/game-design/game-design-fundamentals/feedback-systems"}}