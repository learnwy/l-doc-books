><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      count: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">randomRange</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(guaranteed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.minCount, guaranteed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.maxCount),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      wasPity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> totalWeight</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> table.items.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> item.weight, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> roll </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalWeight;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> item</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> table.items) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    roll </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> item.weight;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (roll </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        item,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        count: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">randomRange</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.minCount, item.maxCount),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        wasPity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    item: table.items[table.items.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    count: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    wasPity: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"进度系统与里程碑\">进度系统与里程碑</h2><p>进度系统（Progression System）是长期反馈的核心骨架，它给予玩家明确的方向感和成长感。良好的进度系统如同一条精心设计的登山步道——每走一段距离都有观景台（里程碑），远处的山顶清晰可见（最终目标），而脚下的路径提供持续的小奖励（即时反馈）。</p>\n<p>进度反馈的层次结构包含三个时间尺度：</p>\n<p><strong>微观进度</strong>（秒级）——每次行动都有可见的进展，如经验条的细微增长、资源数字的跳动、连击计数器的累加。</p>\n<p><strong>中观进度</strong>（分钟-小时级）——阶段性的成就达成，如升级、解锁新技能、完成关卡、获得装备。</p>\n<p><strong>宏观进度</strong>（天-周级）——战略层面的推进，如赛季等级、收藏完成度、剧情进展、成就百分比。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[宏观目标] --&gt; B[赛季等级系统]&#10;    A --&gt; C[收藏完成度]&#10;    A --&gt; D[主线剧情进度]&#10;    B --&gt; E[中观里程碑]&#10;    C --&gt; E&#10;    D --&gt; E&#10;    E --&gt; F[技能解锁]&#10;    E --&gt; G[区域开放]&#10;    E --&gt; H[装备获取]&#10;    F --&gt; I[微观反馈]&#10;    G --&gt; I&#10;    H --&gt; I&#10;    I --&gt; J[经验条增长]&#10;    I --&gt; K[资源累积]&#10;    I --&gt; L[连击计数]\">graph TD\n    A[宏观目标] --&gt; B[赛季等级系统]\n    A --&gt; C[收藏完成度]\n    A --&gt; D[主线剧情进度]\n    B --&gt; E[中观里程碑]\n    C --&gt; E\n    D --&gt; E\n    E --&gt; F[技能解锁]\n    E --&gt; G[区域开放]\n    E --&gt; H[装备获取]\n    F --&gt; I[微观反馈]\n    G --&gt; I\n    H --&gt; I\n    I --&gt; J[经验条增长]\n    I --&gt; K[资源累积]\n    I --&gt; L[连击计数]</pre><p>里程碑设计的黄金法则是&quot;承诺-进度-回报&quot;循环。在玩家投入努力之前，系统先明确展示奖励（承诺）；在努力过程中，持续展示进度（进度条、百分比）；达成后立即给予丰厚回报并即刻展示下一个承诺。</p>\n<p>断裂的进度感知是玩家流失的主要原因之一。当玩家无法清晰感知自己&quot;在哪里&quot;以及&quot;下一步去哪&quot;时，动力就会迅速消退。设计者需要确保在任何时间点，玩家至少能看到一个近期可达的里程碑。</p>\n<h2 id=\"负反馈与惩罚设计\">负反馈与惩罚设计</h2><p>负反馈（Negative Feedback）是奖励系统中被低估但极其重要的组成部分。没有风险的奖励毫无价值——正是失败的可能性赋予了成功以意义。</p>\n<p>惩罚设计的核心原则是&quot;可恢复性&quot;。玩家可以接受失败，但难以接受不可逆的损失。惩罚的严重程度应与玩家的投入时间成正比——刚开始的损失应当微小且快速恢复，后期的惩罚可以更严厉但必须提供明确的恢复路径。</p>\n<table>\n<thead>\n<tr>\n<th>惩罚等级</th>\n<th>损失类型</th>\n<th>恢复难度</th>\n<th>情感效果</th>\n<th>应用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>轻微</td>\n<td>时间回退（重试本关）</td>\n<td>极低</td>\n<td>轻微挫败</td>\n<td>平台跳跃</td>\n</tr>\n<tr>\n<td>中等</td>\n<td>资源损失（金币/道具）</td>\n<td>低-中</td>\n<td>谨慎感</td>\n<td>RPG 死亡惩罚</td>\n</tr>\n<tr>\n<td>严重</td>\n<td>进度回退（降级/掉段）</td>\n<td>中-高</td>\n<td>紧张感</td>\n<td>竞技匹配</td>\n</tr>\n<tr>\n<td>极端</td>\n<td>永久死亡（角色删除）</td>\n<td>不可恢复</td>\n<td>极度紧张</td>\n<td>Roguelike</td>\n</tr>\n</tbody></table>\n<p>负反馈循环（Negative Feedback Loop）在竞技平衡中也扮演重要角色。马里奥赛车的蓝龟壳就是经典的负反馈设计——领先者会遭受更强的阻碍，缩小与后方选手的差距，保持比赛的紧张感和不确定性。</p>\n<p>设计者需要区分&quot;惩罚&quot;和&quot;代价&quot;。惩罚是对错误行为的直接后果（死亡掉金币），代价是策略选择的机会成本（升级A技能意味着暂时无法升级B技能）。代价不产生负面情绪，因为它是玩家主动选择的结果。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((反馈系统与奖励机制))&#10;    即时反馈&#10;      输入响应延迟&#10;      击中顿帧&#10;      镜头震动&#10;      手感五层模型&#10;    奖励计划&#10;      固定比率&#10;      变动比率&#10;      保底机制&#10;      行为塑造&#10;    进度系统&#10;      微观进度&#10;      中观里程碑&#10;      宏观目标&#10;      承诺-进度-回报&#10;    负反馈&#10;      可恢复性原则&#10;      负反馈循环&#10;      惩罚与代价区分\">mindmap\n  root((反馈系统与奖励机制))\n    即时反馈\n      输入响应延迟\n      击中顿帧\n      镜头震动\n      手感五层模型\n    奖励计划\n      固定比率\n      变动比率\n      保底机制\n      行为塑造\n    进度系统\n      微观进度\n      中观里程碑\n      宏观目标\n      承诺-进度-回报\n    负反馈\n      可恢复性原则\n      负反馈循环\n      惩罚与代价区分</pre><ul>\n<li>反馈系统是游戏与玩家的对话通道，通过正反馈和负反馈塑造玩家行为</li>\n<li>即时反馈的手感打磨包含五个层次，击中顿帧是打击感的灵魂</li>\n<li>变动比率奖励计划是最强行为驱动力，但必须配合保底机制防止挫败</li>\n<li>进度系统在三个时间尺度上提供反馈，里程碑设计遵循&quot;承诺-进度-回报&quot;循环</li>\n<li>负反馈赋予成功以意义，惩罚设计的核心原则是可恢复性</li>\n<li>区分惩罚（错误后果）和代价（策略取舍）有助于避免不必要的负面情绪</li>\n</ul>\n","headings":[{"level":1,"text":"反馈系统与奖励机制","id":"反馈系统与奖励机制"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"即时反馈与手感打磨","id":"即时反馈与手感打磨"},{"level":2,"text":"奖励计划与行为塑造","id":"奖励计划与行为塑造"},{"level":2,"text":"进度系统与里程碑","id":"进度系统与里程碑"},{"level":2,"text":"负反馈与惩罚设计","id":"负反馈与惩罚设计"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"游戏平衡性设计","url":"/l-doc-books/h/game-development/game-design/game-design-fundamentals/game-balance"},"next":{"title":"关卡设计原则","url":"/l-doc-books/h/game-development/game-design/level-design/level-design-principles"}}