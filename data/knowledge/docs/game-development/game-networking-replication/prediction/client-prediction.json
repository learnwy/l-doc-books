tateUpdate(state: EntityState, serverTime: number): void {&#10;    this.lastKnownState = state;&#10;    this.lastUpdateTime = serverTime;&#10;  }&#10;&#10;  // 给定当前时间，外推实体位置&#10;  extrapolate(currentTime: number): EntityState {&#10;    const dt = (currentTime - this.lastUpdateTime) / 1000; // 秒&#10;    const { position, velocity, acceleration } = this.lastKnownState;&#10;&#10;    // 匀加速运动模型（一阶 DR）&#10;    const predictedPosition = {&#10;      x: position.x + velocity.x * dt + 0.5 * acceleration.x * dt * dt,&#10;      y: position.y + velocity.y * dt + 0.5 * acceleration.y * dt * dt,&#10;      z: position.z + velocity.z * dt + 0.5 * acceleration.z * dt * dt,&#10;    };&#10;&#10;    return { ...this.lastKnownState, position: predictedPosition };&#10;  }&#10;}&#10;&#10;// 高阶 DR：Hermite 插值（三次曲线，利用位置+速度）&#10;function hermiteInterpolate(p0: Vec3, v0: Vec3, p1: Vec3, v1: Vec3, t: number): Vec3 {&#10;  const t2 = t * t,&#10;    t3 = t2 * t;&#10;  const h00 = 2 * t3 - 3 * t2 + 1;&#10;  const h10 = t3 - 2 * t2 + t;&#10;  const h01 = -2 * t3 + 3 * t2;&#10;  const h11 = t3 - t2;&#10;  return {&#10;    x: h00 * p0.x + h10 * v0.x + h01 * p1.x + h11 * v1.x,&#10;    y: h00 * p0.y + h10 * v0.y + h01 * p1.y + h11 * v1.y,&#10;    z: h00 * p0.z + h10 * v0.z + h01 * p1.z + h11 * v1.z,&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DeadReckoning</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> lastKnownState</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EntityState</span><span style=\