color:#005CC5;--shiki-dark:#79B8FF\">\"condition\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"CanSeePlayer\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"priority\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Alert\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Patrol\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"condition\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"AlertTimeout\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"priority\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"from\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Chase\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"to\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Attack\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"condition\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"InAttackRange\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"priority\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"协程式策略\">协程式策略</h2><p>利用语言的协程（coroutine）特性，将每个状态写为一个异步函数，状态的进入/更新/退出逻辑按时序自然流淌，特别适合有明确时序的状态逻辑。</p>\n<div class=\"code-block-wrapper\" data-lang=\"csharp\" data-code=\"// Unity C# 协程式状态机&#10;public class DialogueCharacter : MonoBehaviour&#10;{&#10;    private Coroutine currentStateCoroutine;&#10;&#10;    private void Start()&#10;    {&#10;        EnterState(IdleStateCoroutine());&#10;    }&#10;&#10;    private void EnterState(IEnumerator newState)&#10;    {&#10;        if (currentStateCoroutine != null)&#10;            StopCoroutine(currentStateCoroutine);&#10;        currentStateCoroutine = StartCoroutine(newState);&#10;    }&#10;&#10;    private IEnumerator IdleStateCoroutine()&#10;    {&#10;        // OnEnter&#10;        animator.SetBool(&quot;IsTalking&quot;, false);&#10;        yield return null;&#10;&#10;        // OnUpdate&#10;        while (true)&#10;        {&#10;            if (dialogueSystem.IsPlayerNearby)&#10;            {&#10;                EnterState(TalkingStateCoroutine());&#10;                yield break; // 退出此协程&#10;            }&#10;            yield return null; // 等待下一帧&#10;        }&#10;    }&#10;&#10;    private IEnumerator TalkingStateCoroutine()&#10;    {&#10;        // OnEnter&#10;        animator.SetBool(&quot;IsTalking&quot;, true);&#10;&#10;        // 按顺序执行对话序列（协程的时序优势）&#10;        foreach (var line in currentDialogue.Lines)&#10;        {&#10;            dialogueUI.ShowText(line.Text);&#10;            yield return new WaitForSeconds(line.Duration);&#10;            dialogueUI.ClearText();&#10;            yield return new WaitForSeconds(0.5f);&#10;        }&#10;&#10;        // OnExit（自然的时序结束）&#10;        animator.SetBool(&quot;IsTalking&quot;, false);&#10;        EnterState(IdleStateCoroutine());&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// Unity C# 协程式状态机</span></span>\n<span class=\"line\"><span>public class DialogueCharacter : MonoBehaviour</span></span>\n<span class=\"line\"><span>{</span></span>\n<span class=\"line\"><span>    private Coroutine currentStateCoroutine;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    private void Start()</span></span>\n<span class=\"line\"><span>    {</span></span>\n<span class=\"line\"><span>        EnterState(IdleStateCoroutine());</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    private void EnterState(IEnumerator newState)</span></span>\n<span class=\"line\"><span>    {</span></span>\n<span class=\"line\"><span>        if (currentStateCoroutine != null)</span></span>\n<span class=\"line\"><span>            StopCoroutine(currentStateCoroutine);</span></span>\n<span class=\"line\"><span>        currentStateCoroutine = StartCoroutine(newState);</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    private IEnumerator IdleStateCoroutine()</span></span>\n<span class=\"line\"><span>    {</span></span>\n<span class=\"line\"><span>        // OnEnter</span></span>\n<span class=\"line\"><span>        animator.SetBool(\"IsTalking\", false);</span></span>\n<span class=\"line\"><span>        yield return null;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        // OnUpdate</span></span>\n<span class=\"line\"><span>        while (true)</span></span>\n<span class=\"line\"><span>        {</span></span>\n<span class=\"line\"><span>            if (dialogueSystem.IsPlayerNearby)</span></span>\n<span class=\"line\"><span>            {</span></span>\n<span class=\"line\"><span>                EnterState(TalkingStateCoroutine());</span></span>\n<span class=\"line\"><span>                yield break; // 退出此协程</span></span>\n<span class=\"line\"><span>            }</span></span>\n<span class=\"line\"><span>            yield return null; // 等待下一帧</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    private IEnumerator TalkingStateCoroutine()</span></span>\n<span class=\"line\"><span>    {</span></span>\n<span class=\"line\"><span>        // OnEnter</span></span>\n<span class=\"line\"><span>        animator.SetBool(\"IsTalking\", true);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        // 按顺序执行对话序列（协程的时序优势）</span></span>\n<span class=\"line\"><span>        foreach (var line in currentDialogue.Lines)</span></span>\n<span class=\"line\"><span>        {</span></span>\n<span class=\"line\"><span>            dialogueUI.ShowText(line.Text);</span></span>\n<span class=\"line\"><span>            yield return new WaitForSeconds(line.Duration);</span></span>\n<span class=\"line\"><span>            dialogueUI.ClearText();</span></span>\n<span class=\"line\"><span>            yield return new WaitForSeconds(0.5f);</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        // OnExit（自然的时序结束）</span></span>\n<span class=\"line\"><span>        animator.SetBool(\"IsTalking\", false);</span></span>\n<span class=\"line\"><span>        EnterState(IdleStateCoroutine());</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><p>协程式的独特优势是<strong>时序逻辑的自然表达</strong>：上面的对话系统用普通 FSM 实现需要管理行索引、计时器等多个变量，而协程只需线性地写出对话流程。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[EnterState 调用] --&gt; B[停止旧协程]&#10;    B --&gt; C[启动新协程]&#10;    C --&gt; D[OnEnter 逻辑]&#10;    D --&gt; E{OnUpdate 循环}&#10;    E --&gt; |条件满足| F[EnterState 新状态]&#10;    E --&gt; |继续| E&#10;    F --&gt; G[yield break 退出]\">flowchart LR\n    A[EnterState 调用] --&gt; B[停止旧协程]\n    B --&gt; C[启动新协程]\n    C --&gt; D[OnEnter 逻辑]\n    D --&gt; E{OnUpdate 循环}\n    E --&gt; |条件满足| F[EnterState 新状态]\n    E --&gt; |继续| E\n    F --&gt; G[yield break 退出]</pre><p><strong>局限</strong>：协程式难以在外部查询当前状态，缺少清晰的状态枚举，调试器中状态不可见。适用于逻辑简单但时序重要的场景，不适合需要大量状态查询的复杂系统。</p>\n<h2 id=\"策略选择决策树\">策略选择决策树</h2><div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"项目处于原型阶段？&#10;├── 是 → 状态 ≤5？&#10;│   ├── 是 → switch-case（快速够用）&#10;│   └── 否 → State Pattern（保留扩展空间）&#10;└── 否 → 需要设计师/策划配置状态？&#10;    ├── 是 → 表驱动（分离数据与逻辑）&#10;    └── 否 → 状态有复杂时序逻辑？&#10;        ├── 是 → 协程式（对话/动画序列）&#10;        └── 否 → State Pattern（标准方案）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>项目处于原型阶段？</span></span>\n<span class=\"line\"><span>├── 是 → 状态 ≤5？</span></span>\n<span class=\"line\"><span>│   ├── 是 → switch-case（快速够用）</span></span>\n<span class=\"line\"><span>│   └── 否 → State Pattern（保留扩展空间）</span></span>\n<span class=\"line\"><span>└── 否 → 需要设计师/策划配置状态？</span></span>\n<span class=\"line\"><span>    ├── 是 → 表驱动（分离数据与逻辑）</span></span>\n<span class=\"line\"><span>    └── 否 → 状态有复杂时序逻辑？</span></span>\n<span class=\"line\"><span>        ├── 是 → 协程式（对话/动画序列）</span></span>\n<span class=\"line\"><span>        └── 否 → State Pattern（标准方案）</span></span></code></pre></div><h2 id=\"混合使用\">混合使用</h2><p>实际项目中常混合多种策略：</p>\n<ul>\n<li><strong>State Pattern + 表驱动</strong>：状态逻辑用 State Pattern 封装，转换关系用表驱动配置，兼顾代码质量和可配置性</li>\n<li><strong>State Pattern + 协程</strong>：每个 State 类的 OnUpdate 内部用协程处理时序逻辑</li>\n<li><strong>HFSM + 表驱动</strong>：超状态结构用 State Pattern 实现，转换规则用 JSON 配置</li>\n</ul>\n<h2 id=\"小结\">小结</h2><p>没有「最好」的状态机实现策略，只有「最适合当前场景」的选择。switch-case 适合快速原型，State Pattern 是中大型项目的标准选择，表驱动适合需要数据分离的系统，协程式适合时序敏感的逻辑。理解各策略的本质权衡，按需选择或混合使用。</p>\n<p><strong>同章节其他内容</strong>：</p>\n<ul>\n<li><a href=\"fsm-design-patterns\">有限状态机设计模式</a> — 状态机的三元组概念基础</li>\n<li><a href=\"hierarchical-state-machines\">层次状态机</a> — 以上策略在层次结构中的应用扩展</li>\n</ul>\n","headings":[{"level":1,"text":"状态机实现策略","id":"状态机实现策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"四种策略总览","id":"四种策略总览"},{"level":2,"text":"switch-case 策略","id":"switch-case-策略"},{"level":2,"text":"State Pattern 策略","id":"state-pattern-策略"},{"level":2,"text":"表驱动策略","id":"表驱动策略"},{"level":2,"text":"协程式策略","id":"协程式策略"},{"level":2,"text":"策略选择决策树","id":"策略选择决策树"},{"level":2,"text":"混合使用","id":"混合使用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"层次状态机","url":"/l-doc-books/h/game-development/game-state-machines/fundamentals/hierarchical-state-machines"},"next":{"title":"行为树","url":"/l-doc-books/h/game-development/game-state-machines/behavior-patterns/behavior-trees"}}