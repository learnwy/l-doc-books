n style=\"color:#24292E;--shiki-dark:#E1E4E8\">(errors[i])) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(a) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(predicted[i]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1e-10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      n) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> naiveErrors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trainSeries.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">abs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trainSeries[i]));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> naiveMae</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> naiveErrors.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> naiveErrors.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> mase</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mae </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(naiveMae, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1e-10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { mae, rmse, mape, smape, mase };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>MASE（Mean Absolute Scaled Error）</strong> 是 M 竞赛推荐的标准指标。它将 MAE 除以朴素预测（naive forecast，即&quot;明天和今天一样&quot;）的 MAE，得到一个无量纲的相对指标。MASE &lt; 1 表示模型优于朴素预测，MASE &gt; 1 表示模型不如朴素预测。MASE 的优势在于它既不受数据尺度影响，也不在零值附近失效。</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>公式特征</th>\n<th>对大误差惩罚</th>\n<th>零值安全</th>\n<th>可跨序列比较</th>\n<th>推荐场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>MAE</td>\n<td>绝对值均值</td>\n<td>等权</td>\n<td>是</td>\n<td>否</td>\n<td>通用基线</td>\n</tr>\n<tr>\n<td>RMSE</td>\n<td>平方均值开方</td>\n<td>高惩罚</td>\n<td>是</td>\n<td>否</td>\n<td>大误差敏感</td>\n</tr>\n<tr>\n<td>MAPE</td>\n<td>百分比化</td>\n<td>等权</td>\n<td>否</td>\n<td>是</td>\n<td>管理层报告</td>\n</tr>\n<tr>\n<td>SMAPE</td>\n<td>对称百分比</td>\n<td>等权</td>\n<td>近似</td>\n<td>是</td>\n<td>MAPE 替代</td>\n</tr>\n<tr>\n<td>MASE</td>\n<td>相对朴素预测</td>\n<td>等权</td>\n<td>是</td>\n<td>是</td>\n<td>学术/竞赛</td>\n</tr>\n</tbody></table>\n<h2 id=\"时间序列交叉验证\">时间序列交叉验证</h2><p>时间序列的验证策略必须严格遵循时间顺序，不能使用标准的 K 折交叉验证（这会导致用未来数据训练模型，造成数据泄露）。时间序列交叉验证的三种主要策略是：固定窗口、滑动窗口和扩展窗口。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type WindowStrategy = &#39;fixed&#39; | &#39;sliding&#39; | &#39;expanding&#39;;&#10;&#10;interface TSCVConfig {&#10;  strategy: WindowStrategy;&#10;  minTrainSize: number;&#10;  testSize: number;&#10;  step: number;&#10;  maxFolds?: number;&#10;}&#10;&#10;interface CVFold {&#10;  trainStart: number;&#10;  trainEnd: number;&#10;  testStart: number;&#10;  testEnd: number;&#10;}&#10;&#10;function generateCVFolds(dataLength: number, config: TSCVConfig): CVFold[] {&#10;  const folds: CVFold[] = [];&#10;  let trainEnd = config.minTrainSize;&#10;&#10;  while (trainEnd + config.testSize &lt;= dataLength) {&#10;    const testStart = trainEnd;&#10;    const testEnd = testStart + config.testSize;&#10;&#10;    let trainStart: number;&#10;    switch (config.strategy) {&#10;      case &#39;expanding&#39;:&#10;        trainStart = 0;&#10;        break;&#10;      case &#39;sliding&#39;:&#10;        trainStart = Math.max(0, trainEnd - config.minTrainSize);&#10;        break;&#10;      case &#39;fixed&#39;:&#10;        trainStart = 0;&#10;        break;&#10;    }&#10;&#10;    folds.push({ trainStart, trainEnd, testStart, testEnd });&#10;    trainEnd += config.step;&#10;&#10;    if (config.maxFolds &amp;&amp; folds.length &gt;= config.maxFolds) break;&#10;  }&#10;&#10;  return folds;&#10;}&#10;&#10;function runTimeSeriesCV(&#10;  data: number[],&#10;  config: TSCVConfig,&#10;  trainAndPredict: (train: number[], horizon: number) =&gt; number[],&#10;): { foldMetrics: ForecastMetrics[]; avgMetrics: ForecastMetrics } {&#10;  const folds = generateCVFolds(data.length, config);&#10;  const foldMetrics: ForecastMetrics[] = [];&#10;&#10;  for (const fold of folds) {&#10;    const train = data.slice(fold.trainStart, fold.trainEnd);&#10;    const test = data.slice(fold.testStart, fold.testEnd);&#10;    const predicted = trainAndPredict(train, test.length);&#10;    foldMetrics.push(computeMetrics(test, predicted, train));&#10;  }&#10;&#10;  const avgMetrics = {&#10;    mae: foldMetrics.reduce((s, m) =&gt; s + m.mae, 0) / foldMetrics.length,&#10;    rmse: foldMetrics.reduce((s, m) =&gt; s + m.rmse, 0) / foldMetrics.length,&#10;    mape: foldMetrics.reduce((s, m) =&gt; s + m.mape, 0) / foldMetrics.length,&#10;    smape: foldMetrics.reduce((s, m) =&gt; s + m.smape, 0) / foldMetrics.length,&#10;    mase: foldMetrics.reduce((s, m) =&gt; s + m.mase, 0) / foldMetrics.length,&#10;  };&#10;&#10;  return { foldMetrics, avgMetrics };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> WindowStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'fixed'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'sliding'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'expanding'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TSCVConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  strategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> WindowStrategy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  minTrainSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  testSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-da