:#E1E4E8\"> sid</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> future </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> futures:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> future.result(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">timeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    results.append(result)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                except</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Exception</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    sid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> futures[future]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    results.append({</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                        'series_id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: sid,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                        'model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'timeout_fallback'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                        'forecast'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: np.full(horizon, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">                        'error'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                    })</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results</span></span></code></pre></div><p>全局模型（Global Model）是大规模预测的另一种范式。与为每条序列独立建模不同，全局模型使用所有序列的数据共同训练一个模型（如 LightGBM 或深度学习模型），通过序列标识符和序列特征区分不同序列。全局模型的优势在于能够从跨序列的模式中学习（如所有商品的节假日效应），且在短序列和新序列（冷启动）场景下表现更好。</p>\n<table>\n<thead>\n<tr>\n<th>建模范式</th>\n<th>模型数量</th>\n<th>数据利用</th>\n<th>冷启动</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>局部模型</td>\n<td>N 个（每序列一个）</td>\n<td>仅自身序列</td>\n<td>❌ 无法处理</td>\n<td>长序列、异质性大</td>\n</tr>\n<tr>\n<td>全局模型</td>\n<td>1 个</td>\n<td>所有序列</td>\n<td>✅ 可处理</td>\n<td>序列多、短序列</td>\n</tr>\n<tr>\n<td>聚类模型</td>\n<td>K 个（每簇一个）</td>\n<td>同簇序列</td>\n<td>部分</td>\n<td>中等异质性</td>\n</tr>\n<tr>\n<td>混合模型</td>\n<td>N+1 个</td>\n<td>全局+局部调整</td>\n<td>✅</td>\n<td>通用最优</td>\n</tr>\n</tbody></table>\n<h2 id=\"预测监控与漂移检测\">预测监控与漂移检测</h2><p>预测系统上线后必须持续监控预测质量。预测性能可能因数据分布漂移、外部事件冲击或上游数据质量问题而退化。有效的监控系统需要能够快速检测性能退化并触发应对措施。</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from collections import deque&#10;from datetime import datetime&#10;&#10;class ForecastMonitor:&#10;    def __init__(self, window_size=30, alert_threshold=1.5):&#10;        self.window_size = window_size&#10;        self.alert_threshold = alert_threshold&#10;        self.error_history: Dict[str, deque] = {}&#10;        self.baseline_mase: Dict[str, float] = {}&#10;&#10;    def set_baseline(self, series_id: str, baseline_mase: float):&#10;        self.baseline_mase[series_id] = baseline_mase&#10;        self.error_history[series_id] = deque(maxlen=self.window_size)&#10;&#10;    def record_error(self, series_id: str, actual: float,&#10;                      predicted: float, naive: float):&#10;        ae = abs(actual - predicted)&#10;        naive_ae = abs(actual - naive)&#10;        mase = ae / max(naive_ae, 1e-8)&#10;&#10;        if series_id not in self.error_history:&#10;            self.error_history[series_id] = deque(maxlen=self.window_size)&#10;        self.error_history[series_id].append(mase)&#10;&#10;        return self._check_alert(series_id)&#10;&#10;    def _check_alert(self, series_id: str) -&gt; dict:&#10;        history = self.error_history.get(series_id)&#10;        baseline = self.baseline_mase.get(series_id, 1.0)&#10;&#10;        if not history or len(history) &lt; 5:&#10;            return {&#39;status&#39;: &#39;insufficient_data&#39;}&#10;&#10;        current_mase = np.mean(list(history)[-7:])&#10;        ratio = current_mase / max(baseline, 1e-8)&#10;&#10;        if ratio &gt; self.alert_threshold * 2:&#10;            level = &#39;critical&#39;&#10;        elif ratio &gt; self.alert_threshold:&#10;            level = &#39;warning&#39;&#10;        else:&#10;            level = &#39;normal&#39;&#10;&#10;        return {&#10;            &#39;series_id&#39;: series_id,&#10;            &#39;current_mase&#39;: current_mase,&#10;            &#39;baseline_mase&#39;: baseline,&#10;            &#39;degradation_ratio&#39;: ratio,&#10;            &#39;alert_level&#39;: level,&#10;            &#39;timestamp&#39;: datetime.now()&#10;        }&#10;&#10;    def get_system_health(self) -&gt; dict:&#10;        alerts = {}&#10;        for sid in self.error_history:&#10;            result = self._check_alert(sid)&#10;            if result.get(&#39;alert_level&#39;) in [&#39;warning&#39;, &#39;critical&#39;]:&#10;                alerts[sid] = result&#10;&#10;        total = len(self.error_history)&#10;        n_alerts = len(alerts)&#10;&#10;        return {&#10;            &#39;total_series&#39;: total,&#10;            &#39;alerting_series&#39;: n_alerts,&#10;            &#39;alert_rate&#39;: n_alerts / max(total, 1),&#10;            &#39;system_status&#39;: &#39;healthy&#39; if n_alerts / max(total, 1) &lt; 0.1 else &#39;degraded&#39;,&#10;            &#39;alerts&#39;: alerts&#10;        }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> collections </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deque</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datetime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datetime</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ForecastMonitor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"li