an><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'路'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'街'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'街'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        '弄'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'弄'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'巷'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'巷'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'里'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'里'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    province_pattern </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">^(</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">北京</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">上海</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">天津</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">重庆</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[\\u4e00-\\u9fa5]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2,3}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(?:</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">省</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">自治区</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">))</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    city_pattern </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">([\\u4e00-\\u9fa5]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2,4}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(?:</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">市</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">州</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">盟</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">))</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    district_pattern </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">([\\u4e00-\\u9fa5]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2,6}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(?:</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">区</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">县</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">旗</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">市</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">))</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    street_pattern </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">([\\u4e00-\\u9fa5]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2,10}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(?:</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">路</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">街</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">道</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">巷</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">弄</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">里</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">))</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    number_pattern </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">号</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    components </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'province'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: re.search(province_pattern, addr),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'city'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: re.search(city_pattern, addr),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'district'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: re.search(district_pattern, addr),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'street'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: re.search(street_pattern, addr),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'number'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: re.search(number_pattern, addr),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {k: v.group() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> k, v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> components.items()}</span></span></code></pre></div><h3 id=\"地址匹配策略\">地址匹配策略</h3><table>\n<thead>\n<tr>\n<th>匹配策略</th>\n<th>精度</th>\n<th>召回率</th>\n<th>速度</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>精确匹配</td>\n<td>最高</td>\n<td>低</td>\n<td>最快</td>\n<td>标准化地址</td>\n</tr>\n<tr>\n<td>前缀匹配</td>\n<td>高</td>\n<td>中</td>\n<td>快</td>\n<td>自动补全</td>\n</tr>\n<tr>\n<td>编辑距离</td>\n<td>中</td>\n<td>高</td>\n<td>慢</td>\n<td>拼写纠错</td>\n</tr>\n<tr>\n<td>分词+倒排索引</td>\n<td>中-高</td>\n<td>高</td>\n<td>快</td>\n<td>通用搜索</td>\n</tr>\n<tr>\n<td>语义匹配</td>\n<td>中</td>\n<td>最高</td>\n<td>中</td>\n<td>复杂地址</td>\n</tr>\n</tbody></table>\n<h2 id=\"地理编码服务\">地理编码服务</h2><h3 id=\"主流服务对比\">主流服务对比</h3><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# 使用高德地图地理编码 API&#10;import requests&#10;&#10;def geocode_gaode(address, key):&#10;    url = &quot;https://restapi.amap.com/v3/geocode/geo&quot;&#10;    params = {&#10;        &quot;key&quot;: key,&#10;        &quot;address&quot;: address,&#10;        &quot;output&quot;: &quot;json&quot;&#10;    }&#10;    response = requests.get(url, params=params).json()&#10;    if response[&quot;status&quot;] == &quot;1&quot; and response[&quot;geocodes&quot;]:&#10;        loc = response[&quot;geocodes&quot;][0][&quot;location&quot;].split(&quot;,&quot;)&#10;        return {&quot;lng&quot;: float(loc[0]), &quot;lat&quot;: float(loc[1]),&#10;                &quot;level&quot;: response[&quot;geocodes&quot;][0][&quot;level&quot;]}&#10;    return None&#10;&#10;# 批量地理编码&#10;def batch_geocode(addresses, key, batch_size=10):&#10;    results = []&#10;    for addr in addresses:&#10;        result = geocode_gaode(addr, key)&#10;        results.append({&quot;address&quot;: addr, &quot;result&quot;: result})&#10;    return results\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 使用高德地图地理编码 API</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requests</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> geocode_gaode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(address, key):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    url </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"https://restapi.amap.com/v3/geocode/geo\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    params </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"key\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: key,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"address\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: address,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"output\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"json\"</span></span>\n<span class=\"line\"><span