">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">col</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">_std_</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">r</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                values[idx].std() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(idx) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i, idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> enumerate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indices)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> features</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>空间特征类型</th>\n<th>计算方式</th>\n<th>信息含量</th>\n<th>计算开销</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>距离特征</td>\n<td>到关键点的距离</td>\n<td>中</td>\n<td>低</td>\n</tr>\n<tr>\n<td>邻域统计</td>\n<td>缓冲区内均值/方差</td>\n<td>高</td>\n<td>中</td>\n</tr>\n<tr>\n<td>密度特征</td>\n<td>KDE 或计数</td>\n<td>中</td>\n<td>中</td>\n</tr>\n<tr>\n<td>空间滞后</td>\n<td>邻居目标值加权</td>\n<td>极高（小心泄漏）</td>\n<td>低</td>\n</tr>\n<tr>\n<td>H3/S2 聚合</td>\n<td>网格单元统计</td>\n<td>中-高</td>\n<td>低</td>\n</tr>\n</tbody></table>\n<h2 id=\"空间交叉验证\">空间交叉验证</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from sklearn.model_selection import GroupKFold&#10;import numpy as np&#10;&#10;def spatial_block_cv(coords, n_splits=5):&#10;    x_edges = np.linspace(coords[:, 0].min(), coords[:, 0].max(), n_splits + 1)&#10;    y_edges = np.linspace(coords[:, 1].min(), coords[:, 1].max(), n_splits + 1)&#10;&#10;    blocks = np.zeros(len(coords), dtype=int)&#10;    for i, (x, y) in enumerate(coords):&#10;        x_idx = min(np.searchsorted(x_edges[1:], x), n_splits - 1)&#10;        y_idx = min(np.searchsorted(y_edges[1:], y), n_splits - 1)&#10;        blocks[i] = (x_idx + y_idx) % n_splits&#10;&#10;    cv = GroupKFold(n_splits=n_splits)&#10;    return list(cv.split(coords, groups=blocks))\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GroupKFold</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> spatial_block_cv</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(coords, n_splits</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    x_edges </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.linspace(coords[:, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].min(), coords[:, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].max(), n_splits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    y_edges </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.linspace(coords[:, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].min(), coords[:, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].max(), n_splits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    blocks </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.zeros(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(coords), </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dtype</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i, (x, y) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> enumerate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(coords):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x_idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(np.searchsorted(x_edges[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:], x), n_splits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        y_idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(np.searchsorted(y_edges[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:], y), n_splits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        blocks[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (x_idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> y_idx) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n_splits</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    cv </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GroupKFold(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_splits</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">n_splits)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> list</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(cv.split(coords, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">groups</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">blocks))</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>CV 方法</th>\n<th>空间泄漏</th>\n<th>评估偏差</th>\n<th>实现复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>随机 K-Fold</td>\n<td>严重</td>\n<td>过度乐观</td>\n<td>低</td>\n</tr>\n<tr>\n<td>空间分块</td>\n<td>显著减少</td>\n<td>接近真实</td>\n<td>中</td>\n</tr>\n<tr>\n<td>缓冲区 CV</td>\n<td>最小</td>\n<td>保守</td>\n<td>高</td>\n</tr>\n<tr>\n<td>Leave-Location-Out</td>\n<td>无</td>\n<td>最接近真实</td>\n<td>高</td>\n</tr>\n</tbody></table>\n<h2 id=\"图神经网络与空间\">图神经网络与空间</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import torch&#10;from torch_geometric.data import Data&#10;from torch_geometric.nn import GCNConv&#10;&#10;class SpatialGNN(torch.nn.Module):&#10;    def __init__(self, in_channels, hidden_channels, out_channels):&#10;        super().__init__()&#10;        self.conv1 = GCNConv(in_channels, hidden_channels)&#10;        self.conv2 = GCNConv(hidden_channels, out_channels)&#10;&#10;    def forward(self, x, edge_index):&#10;        x = self.conv1(x, edge_index).relu()&#10;        x = self.conv2(x, edge_index)&#10;        return x&#10;&#10;def build_spatial_graph(coords, k=5):&#10;    from sklearn.neighbors import NearestNeighbors&#10;    nn = NearestNeighbors(n_neighbors=k + 1)&#10;    nn.fit(coords)&#10;    distances, indices = nn.kneighbors(coords)&#10;&#10;    edges = []&#10;    for i, neighbors in enumerate(indices[:, 1:]):&#10;        for j in neighbors:&#10;            edges.append([i, j])&#10;    return torch.tensor(edges, dtype=torch.long).t()\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch_geometric.data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Data</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch_geometric.nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GCNConv</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SpatialGNN</span><span style=\"col