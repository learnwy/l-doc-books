A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv1(x, edge_index).relu()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.conv2(x, edge_index)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> build_spatial_graph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(coords, k</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.neighbors </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NearestNeighbors</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    nn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NearestNeighbors(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_neighbors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">k </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    nn.fit(coords)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    distances, indices </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nn.kneighbors(coords)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    edges </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i, neighbors </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> enumerate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(indices[:, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:]):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> neighbors:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            edges.append([i, j])</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> torch.tensor(edges, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">dtype</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">torch.long).t()</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>空间 ML 模型</th>\n<th>空间感知方式</th>\n<th>优势</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>随机森林 + 空间特征</td>\n<td>显式特征</td>\n<td>简单有效</td>\n<td>通用预测</td>\n</tr>\n<tr>\n<td>GWR-ML</td>\n<td>局部加权</td>\n<td>捕捉异质性</td>\n<td>系数空间变化</td>\n</tr>\n<tr>\n<td>图神经网络</td>\n<td>图结构建模</td>\n<td>端到端空间</td>\n<td>复杂空间关系</td>\n</tr>\n<tr>\n<td>空间卷积网络</td>\n<td>栅格卷积</td>\n<td>像素级预测</td>\n<td>遥感分类</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>空间机器学习的核心挑战是处理空间自相关导致的数据非独立性</li>\n<li>空间交叉验证（分块 CV、缓冲区 CV）是评估空间预测模型泛化能力的必要方法</li>\n<li>空间特征工程（邻域统计、距离特征、密度特征）是提升空间预测精度的有效手段</li>\n<li>图神经网络是建模复杂空间关系的前沿方法，将空间邻近关系编码为图结构</li>\n<li>使用空间 ML 时必须检查残差的空间自相关，确保模型已充分捕捉空间结构</li>\n</ul>\n","headings":[{"level":1,"text":"空间机器学习","id":"空间机器学习"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"空间特征工程","id":"空间特征工程"},{"level":2,"text":"空间交叉验证","id":"空间交叉验证"},{"level":2,"text":"图神经网络与空间","id":"图神经网络与空间"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"遥感数据分析基础","url":"/l-doc-books/h/data-science/geospatial-data-analysis/applied-geospatial/remote-sensing-basics"},"next":{"title":"空间自相关分析","url":"/l-doc-books/h/data-science/geospatial-data-analysis/spatial-statistics/spatial-autocorrelation"}}