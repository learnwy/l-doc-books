span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> points.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dist</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> haversineDistance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(points[i].lat, points[i].lng, points[j].lat, points[j].lng);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dist </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> distThreshold) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> duration</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> points[j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].timestamp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> points[i].timestamp;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (duration </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> timeThreshold) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      stayPoints.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        lat: points.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i, j).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.lat, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        lng: points.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i, j).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.lng, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        arrivalTime: points[i].timestamp,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        departureTime: points[j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].timestamp,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        duration,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        radius: distThreshold,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stayPoints;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>停留点检测（Stay Point Detection）是轨迹语义分析的入口。停留点是轨迹中移动对象在一定空间范围内停留超过一定时间的区域。停留点对应着真实世界中的有意义行为——在餐厅吃饭、在办公室工作、在商场购物。经典的停留点检测算法使用距离阈值和时间阈值两个参数：如果连续的轨迹点在距离阈值内且总时间超过时间阈值，则识别为一个停留点。</p>\n<p>轨迹分段（Trajectory Segmentation）将一条长轨迹拆分为多个有意义的子轨迹。分段依据可以是时间间隔（两点之间时间差超过阈值则断开）、交通模式变化（从驾车变为步行）或语义事件（到达目的地后开始新的出行）。</p>\n<h2 id=\"轨迹模式挖掘\">轨迹模式挖掘</h2><p>轨迹模式挖掘的目标是从大量个体轨迹中发现群体级别的移动规律。这些规律对交通规划、城市治理和商业决策有直接价值。</p>\n<p>频繁路径挖掘识别最多人选择的移动路线。将轨迹映射到道路网络后，使用序列模式挖掘算法（如 PrefixSpan）可以找到频繁出现的路段序列。频繁路径不仅反映了城市的主要通勤走廊，还可以用于导航推荐——「这条路线是大多数人的选择」。</p>\n<table>\n<thead>\n<tr>\n<th>模式类型</th>\n<th>描述</th>\n<th>挖掘方法</th>\n<th>应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>频繁路径</td>\n<td>最多人走的路线</td>\n<td>序列模式挖掘</td>\n<td>导航推荐/道路规划</td>\n</tr>\n<tr>\n<td>时空聚类</td>\n<td>同时同地的聚集</td>\n<td>ST-DBSCAN</td>\n<td>事件检测/人群监控</td>\n</tr>\n<tr>\n<td>周期模式</td>\n<td>重复出现的移动</td>\n<td>周期检测算法</td>\n<td>通勤模式/习惯分析</td>\n</tr>\n<tr>\n<td>异常轨迹</td>\n<td>偏离正常的移动</td>\n<td>孤立森林/距离度量</td>\n<td>欺诈检测/安全监控</td>\n</tr>\n<tr>\n<td>伴随模式</td>\n<td>经常一起移动的对象</td>\n<td>共现分析</td>\n<td>社交关系推断</td>\n</tr>\n</tbody></table>\n<p>OD（Origin-Destination）分析是宏观交通分析的基础。将每条轨迹的起点和终点提取出来，构建城市级别的出行 OD 矩阵——从区域 A 到区域 B 有多少出行，峰值在什么时间。OD 矩阵是交通规划、公交路线设计和共享出行供需匹配的核心数据输入。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[原始轨迹集] --&gt; B[OD 提取]&#10;    B --&gt; C[OD 矩阵]&#10;    C --&gt; D[出行模式可视化]&#10;    C --&gt; E[通勤走廊识别]&#10;    C --&gt; F[交通需求建模]&#10;    D --&gt; G[弧线流量图]&#10;    D --&gt; H[热力矩阵]&#10;    E --&gt; I[公交规划]&#10;    F --&gt; J[需求预测]\">graph LR\n    A[原始轨迹集] --&gt; B[OD 提取]\n    B --&gt; C[OD 矩阵]\n    C --&gt; D[出行模式可视化]\n    C --&gt; E[通勤走廊识别]\n    C --&gt; F[交通需求建模]\n    D --&gt; G[弧线流量图]\n    D --&gt; H[热力矩阵]\n    E --&gt; I[公交规划]\n    F --&gt; J[需求预测]</pre><p>异常轨迹检测在安全和监管领域有重要应用。出租车绕路检测（轨迹与最短路径偏差过大）、船舶违规捕捞检测（进入禁渔区的轨迹）、物流配送效率监控（配送轨迹的时间和距离异常）都属于异常轨迹检测的范畴。检测方法通常基于轨迹的统计特征（总距离、平均速度、轨迹形状）或与参考轨迹的偏差度量。</p>\n<h2 id=\"轨迹可视化与交互\">轨迹可视化与交互</h2><p>轨迹数据的可视化比静态空间数据更具挑战性，因为需要同时表达空间和时间两个维度。</p>\n<p>静态轨迹图将所有轨迹叠加在地图上，用颜色编码时间或速度。密集区域会形成「道路热力图」效果。这种可视化简单直观，但在轨迹数量多时会产生严重的视觉遮挡。</p>\n<p>动画轨迹是展示轨迹时间维度最直观的方式。移动对象在地图上随时间移动，观众可以直观地感受到移动速度、方向变化和停留行为。deck.gl 的 TripsLayer 专门为轨迹动画设计，支持百万级轨迹点的流畅动画。</p>\n<p>时空立方体（Space-Time Cube）是同时展示空间和时间的三维可视化方法。水平面表示地理空间，垂直轴表示时间。一条轨迹在时空立方体中呈现为一条三维曲线——水平移动表示空间位移，垂直上升表示时间流逝，水平段（垂直线）表示停留。时空立方体特别适合展示少量轨迹的详细时空结构。</p>\n<p>隐私保护是轨迹数据分析的重要伦理考量。个体轨迹数据是高度敏感的个人信息——从轨迹中可以推断出一个人的家庭地址、工作地点、社交关系、健康状况。在分析和发布轨迹数据时，必须采取隐私保护措施：空间模糊化（降低坐标精度）、时间扰动（随机偏移时间戳）、K-匿名化（确保每条轨迹至少与 K-1 条其他轨迹相似）。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>轨迹数据同时具有空间和时间维度，需要时空联合分析方法</li>\n<li>轨迹预处理包括噪声过滤、地图匹配、停留点检测和轨迹分段</li>\n<li>地图匹配将 GPS 点对齐到道路网络，赋予轨迹道路语义</li>\n<li>停留点对应真实世界的有意义行为，是轨迹语义分析的入口</li>\n<li>OD 矩阵是宏观交通分析的核心数据，驱动公交规划和需求预测</li>\n<li>异常轨迹检测用于绕路检测、违规监控和配送效率分析</li>\n<li>动画轨迹和时空立方体是展示轨迹时间维度的两种核心方法</li>\n<li>轨迹数据高度敏感，分析发布时必须采取隐私保护措施</li>\n</ul>\n","headings":[{"level":1,"text":"轨迹数据分析","id":"轨迹数据分析"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"轨迹预处理","id":"轨迹预处理"},{"level":2,"text":"轨迹模式挖掘","id":"轨迹模式挖掘"},{"level":2,"text":"轨迹可视化与交互","id":"轨迹可视化与交互"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"位置智能与商业分析","url":"/l-doc-books/h/data-science/geospatial-data-analysis/geospatial-applications/location-intelligence"},"next":{"title":"空间机器学习","url":"/l-doc-books/h/data-science/geospatial-data-analysis/geospatial-applications/spatial-machine-learning"}}