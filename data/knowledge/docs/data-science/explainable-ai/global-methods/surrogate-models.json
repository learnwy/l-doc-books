;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">g</span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\">x</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span><span class=\"mord\"><span class=\"mord\"><span class=\"delimsizing size1\">)</span></span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.054em;\"><span style=\"top:-3.3029em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3347em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span></div><p>其中 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mover accent=\"true\"><mi>f</mi><mo>^</mo></mover></mrow><annotation encoding=\"application/x-tex\">\\hat{f}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.1523em;vertical-align:-0.1944em;\"></span><span class=\"mord accent\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9579em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1076em;\">f</span></span><span style=\"top:-3.2634em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.0833em;\"><span class=\"mord\">^</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1944em;\"><span></span></span></span></span></span></span></span></span></span> 是黑箱、<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>g</mi></mrow><annotation encoding=\"application/x-tex\">g</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">g</span></span></span></span></span> 是代理、<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mover accent=\"true\"><mover accent=\"true\"><mi>f</mi><mo>^</mo></mover><mo>ˉ</mo></mover></mrow><annotation encoding=\"application/x-tex\">\\bar{\\hat{f}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.2891em;vertical-align:-0.1944em;\"></span><span class=\"mord accent\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0947em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord accent\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9579em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1076em;\">f</span></span><span style=\"top:-3.2634em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.0833em;\"><span class=\"mord\">^</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1944em;\"><span></span></span></span></span></span></span><span style=\"top:-3.5269em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˉ</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1944em;\"><span></span></span></span></span></span></span></span></span></span> 是黑箱预测的均值。<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msup><mi>R</mi><mn>2</mn></msup></mrow><annotation encoding=\"application/x-tex\">R^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8141em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span></span> 越接近 1，说明代理越忠实地复现了黑箱。对分类任务，则看代理与黑箱预测标签的一致率。</p>\n<p>保真度低时，代理给出的任何「解释」都不可信——它讲的是它自己的故事，不是黑箱的。这与<a href=\"../local-methods/\">局部方法</a>里 <a href=\"../local-methods/lime\">LIME</a> 的局部保真度概念完全一致，区别只在 LIME 只要求在单个样本邻域内忠实，全局代理要求在整个分布上忠实——后者难得多，这也是全局代理的根本局限。</p>\n<h2 id=\"全局代理-vs-局部代理\">全局代理 vs 局部代理</h2><p>理解了全局代理，就更容易理解它和 LIME 的关系：二者本质是同一思想在不同范围上的应用。</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>全局代理</th>\n<th>局部代理（LIME）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>逼近范围</td>\n<td>整个数据分布</td>\n<td>单个样本的邻域</td>\n</tr>\n<tr>\n<td>代理模型</td>\n<td>浅树/线性/规则</td>\n<td>加权线性模型</td>\n</tr>\n<tr>\n<td>学习目标</td>\n<td>像黑箱（整体）</td>\n<td>像黑箱（局部）</td>\n</tr>\n<tr>\n<td>保真度衡量</td>\n<td>全局 R²/一致率</td>\n<td>邻域内加权拟合优度</td>\n</tr>\n<tr>\n<td>输出解释</td>\n<td>全局规则结构</td>\n<td>单样本特征权重</td>\n</tr>\n<tr>\n<td>主要风险</td>\n<td>全局保真度往往不够</td>\n<td>邻域定义敏感</td>\n</tr>\n</tbody></table>\n<p>简言之，把 LIME 的逼近范围从「一个点附近」放大到「整个空间」，就得到全局代理。范围越大，单个简单模型越难忠实逼近——这是为什么全局代理常常保真度不足，而 LIME 反而更实用。</p>\n<h2 id=\"模型蒸馏与代理的边界\">模型蒸馏与代理的边界</h2><p>代理模型的思想和<strong>知识蒸馏（distillation）<strong>是近亲：都用一个简单模型去学复杂模型的输出。区别在目的——蒸馏是为了</strong>部署</strong>一个又小又快、精度接近的学生模型，可解释性代理是为了<strong>理解</strong>，所以学生模型必须是可解释的（浅树而非小型网络）。同一套「学软标签」的机制，目标不同，对学生模型的约束就不同。</p>\n<p>还有一类「可解释蒸馏」介于两者之间：把黑箱蒸馏成一个 <a href=\"../foundations/intrinsic-vs-posthoc\">GAM/EBM</a>，既保留可读的形状函数，保真度又通常高于浅树。当浅树代理保真度不够、但你仍想要一个全局可解释的产物时，这是值得一试的折中。</p>\n<h2 id=\"什么时候用-什么时候别用\">什么时候用、什么时候别用</h2><p>代理模型适合：你已经有一个必须保留的黑箱（精度原因或历史包袱），又想要一份对它整体逻辑的可读概括，用于团队沟通、文档化或初步审计。一棵保真度 0.9 以上的浅树，是极好的沟通工具。</p>\n<p>不适合：保真度上不去时（复杂黑箱在高维数据上常如此），别硬用——一个保真度 0.6 的代理会给你一个看似清晰、实则错误的模型心智图，比没有解释更糟。这种「用低保真代理自欺」的风险，是<a href=\"../practice/pitfalls\">陷阱与误读</a>里点名的典型坑。另外，如果你本可以一开始就用<a href=\"../foundations/intrinsic-vs-posthoc\">内在可解释模型</a>，那就根本不需要「黑箱 + 全局代理」这套两层结构——直接用透明模型，保真度问题自动消失。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>全局代理用可解释模型（多为浅决策树）去拟合黑箱的预测，读代理结构当全局解释。</li>\n<li>代理学的是黑箱行为而非真实标签，会忠实复现黑箱的错误——这正是解释模型该有的样子。</li>\n<li>唯一关键指标是保真度（对黑箱的逼近度，如 R²），不是对真实标签的准确率。</li>\n<li>全局代理与 LIME 是同一思想的不同范围：范围越大越难忠实，故全局代理常保真度不足。</li>\n<li>保真度不够时别硬用，低保真代理给出的清晰心智图反而误导；能用内在模型就别搭两层结构。</li>\n</ul>\n","headings":[{"level":1,"text":"代理模型","id":"代理模型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"全局代理的基本流程","id":"全局代理的基本流程"},{"level":2,"text":"保真度：代理可信的前提","id":"保真度-代理可信的前提"},{"level":2,"text":"全局代理 vs 局部代理","id":"全局代理-vs-局部代理"},{"level":2,"text":"模型蒸馏与代理的边界","id":"模型蒸馏与代理的边界"},{"level":2,"text":"什么时候用、什么时候别用","id":"什么时候用-什么时候别用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"部分依赖与 ICE","url":"/l-doc-books/h/data-science/explainable-ai/global-methods/partial-dependence"},"next":{"title":"LIME 局部线性解释","url":"/l-doc-books/h/data-science/explainable-ai/local-methods/lime"}}