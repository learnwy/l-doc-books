</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> recommendations]:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            recommendations.append((</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'GBDT + SHAP'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'精确 Shapley 值解释'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'HIGH'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 延迟要求极高</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prediction_latency_ms </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        recommendations </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'CatBoost'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'对称树 O(1) 预测'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'CRITICAL'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> recommendations</span></span></code></pre></div><h2 id=\"竞赛实践中的集成策略\">竞赛实践中的集成策略</h2><p>在 Kaggle 竞赛中，最终方案往往是 GBDT + 深度模型的集成：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import numpy as np&#10;from sklearn.model_selection import StratifiedKFold&#10;from sklearn.metrics import roc_auc_score&#10;&#10;def blend_models(models, X_train, y_train, X_test, cv=5):&#10;    &quot;&quot;&quot;OOF 集成多个模型&quot;&quot;&quot;&#10;    kf = StratifiedKFold(n_splits=cv, shuffle=True, random_state=42)&#10;    oof_preds = np.zeros((len(X_train), len(models)))&#10;    test_preds = np.zeros((len(X_test), len(models)))&#10;&#10;    for model_idx, (name, model) in enumerate(models):&#10;        fold_test_preds = np.zeros((len(X_test), cv))&#10;&#10;        for fold, (train_idx, val_idx) in enumerate(kf.split(X_train, y_train)):&#10;            X_fold_tr, X_fold_val = X_train[train_idx], X_train[val_idx]&#10;            y_fold_tr, y_fold_val = y_train[train_idx], y_train[val_idx]&#10;&#10;            model.fit(X_fold_tr, y_fold_tr)&#10;            oof_preds[val_idx, model_idx] = model.predict_proba(X_fold_val)[:, 1]&#10;            fold_test_preds[:, fold] = model.predict_proba(X_test)[:, 1]&#10;&#10;        test_preds[:, model_idx] = fold_test_preds.mean(axis=1)&#10;        oof_auc = roc_auc_score(y_train, oof_preds[:, model_idx])&#10;        print(f&quot;{name} OOF AUC: {oof_auc:.4f}&quot;)&#10;&#10;    # 简单平均（也可用 Optuna 学习最优权重）&#10;    final_oof = oof_preds.mean(axis=1)&#10;    final_test = test_preds.mean(axis=1)&#10;    ensemble_auc = roc_auc_score(y_train, final_oof)&#10;    print(f&quot;\\n集成 OOF AUC: {ensemble_auc:.4f}&quot;)&#10;    return final_test\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numpy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.model_selection </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StratifiedKFold</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sklearn.metrics </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> roc_auc_score</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> blend_models</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(models, X_train, y_train, X_test, cv</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"OOF 集成多个模型\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    kf </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StratifiedKFold(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n_splits</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">cv, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">shuffle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">random_state</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span