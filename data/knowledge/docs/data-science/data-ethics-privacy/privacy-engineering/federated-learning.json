8FF\">            print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Round </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">round_idx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: avg_loss=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">total_loss</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:.4f</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> global_model</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">np.random.seed(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">true_weights </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.array([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">client_data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    X </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.random.randn(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> X </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">@</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> true_weights </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.random.normal(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    client_data.append((X, y))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">init_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> np.zeros(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">final_model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> federated_averaging(init_model, client_data, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rounds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"True weights: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">true_weights</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Learned weights: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">final_model.round(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>**纵向联邦学习（Vertical FL）**适用于参与方拥有相同样本但不同特征的场景。例如，银行拥有用户的金融数据，电商平台拥有用户的购物数据，两者的用户群体有重叠。纵向联邦的核心挑战在于：如何在不暴露各自原始特征的前提下，利用双方的特征联合训练模型。常用方法包括基于秘密分享的安全分割学习和基于同态加密的安全梯度计算。</p>\n<h2 id=\"安全多方计算与同态加密\">安全多方计算与同态加密</h2><p>安全多方计算（Secure Multi-Party Computation, MPC）和同态加密（Homomorphic Encryption, HE）为联邦学习提供了更强的安全保证。</p>\n<p>**秘密分享（Secret Sharing）**是 MPC 的基本构建块。Shamir 秘密分享将一个秘密值拆分为 n 份，任何 t 份（t ≤ n）可以恢复原始秘密，但少于 t 份无法获得任何信息。加法秘密分享更为简单：将 x 拆分为 x₁ + x₂ = x，两方各持一份。在此基础上可以高效实现加法、乘法等基本运算，进而构建复杂的联合计算协议。</p>\n<p>**全同态加密（Fully Homomorphic Encryption, FHE）**允许在加密数据上直接进行任意计算，计算结果解密后与在明文上计算的结果一致。FHE 提供了最强的隐私保证——数据全程加密，甚至计算服务器也无法看到原始数据。但 FHE 的计算开销极大（通常比明文计算慢 1000-10000 倍），限制了其在大规模机器学习中的应用。</p>\n<p>**可信执行环境（TEE）**如 Intel SGX 和 ARM TrustZone 提供了硬件级别的数据隔离。数据进入 TEE 的安全飞地（Enclave）后，即使操作系统和虚拟化层被攻破，飞地内的数据和计算仍然受到保护。TEE 的计算效率接近明文计算，但安全模型依赖于对硬件厂商的信任。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 隐私计算安全-效率权衡&#10;        A[纯明文计算] --&gt;|最快/无隐私| B[TEE]&#10;        B --&gt;|快/硬件信任| C[MPC]&#10;        C --&gt;|中速/密码学安全| D[FHE]&#10;        D --&gt;|最慢/最强隐私| E[理论安全上限]&#10;    end\">graph LR\n    subgraph 隐私计算安全-效率权衡\n        A[纯明文计算] --&gt;|最快/无隐私| B[TEE]\n        B --&gt;|快/硬件信任| C[MPC]\n        C --&gt;|中速/密码学安全| D[FHE]\n        D --&gt;|最慢/最强隐私| E[理论安全上限]\n    end</pre><h2 id=\"实际部署挑战\">实际部署挑战</h2><p>隐私计算技术从研究到生产部署面临多重工程和业务挑战。</p>\n<p><strong>通信效率</strong>是联邦学习的核心瓶颈。在移动设备场景中（如手机键盘预测），数百万设备需要周期性地与服务器交换模型参数。梯度压缩（Gradient Compression）、模型量化和异步更新是降低通信开销的主要技术。</p>\n<p>**数据异质性（Non-IID）**是联邦学习中最棘手的统计挑战。不同参与方的数据分布可能差异巨大（如不同地区用户的消费习惯截然不同），导致局部模型的更新方向不一致，全局模型收敛困难。FedProx、SCAFFOLD 和 Per-FedAvg 等算法专门针对 Non-IID 数据设计。</p>\n<table>\n<thead>\n<tr>\n<th>部署挑战</th>\n<th>影响</th>\n<th>解决方案</th>\n<th>成熟度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>通信效率</td>\n<td>带宽消耗/延迟</td>\n<td>梯度压缩/量化</td>\n<td>高</td>\n</tr>\n<tr>\n<td>Non-IID 数据</td>\n<td>收敛困难/模型偏差</td>\n<td>FedProx/个性化联邦</td>\n<td>中高</td>\n</tr>\n<tr>\n<td>设备异构</td>\n<td>训练速度不一致</td>\n<td>异步聚合/掉队者容忍</td>\n<td>中</td>\n</tr>\n<tr>\n<td>梯度泄漏</td>\n<td>通过梯度反推数据</td>\n<td>DP+FL/安全聚合</td>\n<td>高</td>\n</tr>\n<tr>\n<td>激励机制</td>\n<td>参与方贡献不对等</td>\n<td>数据估值/Shapley 值</td>\n<td>低</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>联邦学习实现&quot;数据不出域&quot;的模型训练范式，分为横向、纵向和迁移联邦三种类型</li>\n<li>FedAvg 是横向联邦的经典算法，通过本地训练 + 参数聚合避免原始数据共享</li>\n<li>MPC（秘密分享）、HE（同态加密）和 TEE（可信执行环境）提供不同强度的隐私保证</li>\n<li>通信效率和数据异质性（Non-IID）是联邦学习生产部署的两大核心挑战</li>\n<li>梯度泄漏攻击表明仅共享梯度不能完全保护隐私，需要结合差分隐私或安全聚合</li>\n<li>隐私计算技术的安全性和计算效率之间存在根本性的权衡，需要根据场景选择合适的技术组合</li>\n</ul>\n","headings":[{"level":1,"text":"联邦学习与隐私计算","id":"联邦学习与隐私计算"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"联邦学习架构","id":"联邦学习架构"},{"level":2,"text":"安全多方计算与同态加密","id":"安全多方计算与同态加密"},{"level":2,"text":"实际部署挑战","id":"实际部署挑战"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据匿名化技术","url":"/l-doc-books/h/data-science/data-ethics-privacy/privacy-engineering/anonymization-techniques"},"next":{"title":"AI 透明性与可解释性","url":"/l-doc-books/h/data-science/data-ethics-privacy/responsible-ai/ai-transparency"}}