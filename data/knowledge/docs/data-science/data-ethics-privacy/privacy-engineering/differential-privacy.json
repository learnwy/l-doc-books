;--shiki-dark:#FFAB70\">queryId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">epsilon</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">delta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">canSpend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(epsilon, delta)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.budget.consumed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      queryId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      epsilon,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      delta,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      timestamp: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>组合方式</th>\n<th>总隐私损失</th>\n<th>适用场景</th>\n<th>精度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>基本顺序组合</td>\n<td>Σ εᵢ</td>\n<td>简单分析</td>\n<td>保守</td>\n</tr>\n<tr>\n<td>高级组合定理</td>\n<td>O(√k · ε)</td>\n<td>多次查询</td>\n<td>中等</td>\n</tr>\n<tr>\n<td>Rényi DP 组合</td>\n<td>更紧界</td>\n<td>深度学习训练</td>\n<td>精确</td>\n</tr>\n<tr>\n<td>并行组合</td>\n<td>max(εᵢ)</td>\n<td>不相交子集</td>\n<td>最优</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[隐私预算 ε=1.0] --&gt; B[查询1: ε=0.3]&#10;    B --&gt; C[剩余: ε=0.7]&#10;    C --&gt; D[查询2: ε=0.2]&#10;    D --&gt; E[剩余: ε=0.5]&#10;    E --&gt; F[查询3: ε=0.5]&#10;    F --&gt; G[预算耗尽]\">graph LR\n    A[隐私预算 ε=1.0] --&gt; B[查询1: ε=0.3]\n    B --&gt; C[剩余: ε=0.7]\n    C --&gt; D[查询2: ε=0.2]\n    D --&gt; E[剩余: ε=0.5]\n    E --&gt; F[查询3: ε=0.5]\n    F --&gt; G[预算耗尽]</pre><h2 id=\"差分隐私与机器学习\">差分隐私与机器学习</h2><p>将差分隐私应用于机器学习（DP-ML）是当前最活跃的研究和工程实践方向。核心方法是 DP-SGD（Differentially Private Stochastic Gradient Descent），它在每步梯度更新中对梯度进行裁剪和加噪。</p>\n<p>DP-SGD 的三个关键步骤是：梯度裁剪（将每个样本的梯度范数限制在阈值 C 以内，控制敏感度）、梯度加噪（添加尺度为 σ·C 的高斯噪声）和隐私记账（使用 Rényi DP 或 GDP 精确追踪累积隐私损失）。</p>\n<p>Google 的 TensorFlow Privacy 和 Meta 的 Opacus（PyTorch）是两个主流的 DP-ML 框架。在实践中，DP-SGD 训练的模型精度通常低于非隐私训练，但通过增大数据集规模、优化超参数和使用预训练模型，精度差距可以控制在可接受范围内。</p>\n<p>Apple 在 iOS 输入法中使用局部差分隐私收集表情符号使用频率，Google 在 Chrome 中使用 RAPPOR 协议收集浏览器使用统计，这些都是差分隐私在工业界的成功应用案例。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>差分隐私提供了可量化、可证明的数学隐私保证，是当前最严格的隐私保护框架</li>\n<li>隐私预算 ε 控制隐私与精度的权衡，ε 越小隐私越强但噪声越大</li>\n<li>拉普拉斯机制、高斯机制和指数机制分别适用于数值查询、高维查询和非数值查询</li>\n<li>组合定理使得隐私预算在多次查询中累积消耗，隐私记账是工程实践的核心挑战</li>\n<li>DP-SGD 将差分隐私引入深度学习训练，通过梯度裁剪和加噪实现模型级隐私保护</li>\n<li>Apple 和 Google 的实践证明差分隐私可以在工业规模上成功部署</li>\n</ul>\n","headings":[{"level":1,"text":"差分隐私","id":"差分隐私"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"噪声添加机制","id":"噪声添加机制"},{"level":2,"text":"隐私预算管理","id":"隐私预算管理"},{"level":2,"text":"差分隐私与机器学习","id":"差分隐私与机器学习"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"行业隐私标准","url":"/l-doc-books/h/data-science/data-ethics-privacy/privacy-regulations/industry-privacy-standards"},"next":{"title":"数据匿名化与脱敏","url":"/l-doc-books/h/data-science/data-ethics-privacy/privacy-engineering/anonymization-deidentification"}}