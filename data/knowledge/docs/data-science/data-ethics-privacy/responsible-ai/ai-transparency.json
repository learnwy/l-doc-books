e=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    [array[i], array[j]] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [array[j], array[i]];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> array;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>SHAP 的全局可解释性通过聚合所有样本的 SHAP 值实现：特征重要性排序（各特征 SHAP 绝对值的均值）、特征依赖图（SHAP 值与特征值的散点图）和交互效应（SHAP 交互值矩阵）。</p>\n<table>\n<thead>\n<tr>\n<th>可解释方法</th>\n<th>模型依赖</th>\n<th>局部/全局</th>\n<th>计算成本</th>\n<th>理论保证</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SHAP</td>\n<td>模型无关</td>\n<td>两者</td>\n<td>高</td>\n<td>一致性+精确性</td>\n</tr>\n<tr>\n<td>LIME</td>\n<td>模型无关</td>\n<td>局部</td>\n<td>中</td>\n<td>局部保真性</td>\n</tr>\n<tr>\n<td>特征重要性</td>\n<td>树模型</td>\n<td>全局</td>\n<td>低</td>\n<td>无</td>\n</tr>\n<tr>\n<td>注意力权重</td>\n<td>Transformer</td>\n<td>局部</td>\n<td>低</td>\n<td>有争议</td>\n</tr>\n<tr>\n<td>梯度归因</td>\n<td>可微模型</td>\n<td>局部</td>\n<td>低</td>\n<td>无</td>\n</tr>\n</tbody></table>\n<h2 id=\"lime-与局部代理模型\">LIME 与局部代理模型</h2><p>LIME（Local Interpretable Model-agnostic Explanations）通过在单个预测点的邻域内拟合一个可解释的局部代理模型（通常是线性模型或决策树）来解释复杂模型的预测。LIME 的核心假设是：即使全局模型极其复杂，在任何单个预测的局部邻域内，决策边界可以用简单模型近似。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface LIMEExplanation {&#10;  intercept: number;&#10;  coefficients: Array&lt;{ feature: string; weight: number }&gt;;&#10;  localPrediction: number;&#10;  r2Score: number;&#10;}&#10;&#10;function limeExplain(&#10;  model: (features: number[]) =&gt; number,&#10;  instance: number[],&#10;  featureNames: string[],&#10;  numPerturbations: number = 500,&#10;  kernelWidth: number = 0.75,&#10;): LIMEExplanation {&#10;  const perturbations: number[][] = [];&#10;  const predictions: number[] = [];&#10;  const weights: number[] = [];&#10;&#10;  for (let i = 0; i &lt; numPerturbations; i++) {&#10;    const perturbed = instance.map((v) =&gt; (Math.random() &gt; 0.5 ? v : v + (Math.random() - 0.5) * 2));&#10;    perturbations.push(perturbed);&#10;    predictions.push(model(perturbed));&#10;&#10;    const distance = Math.sqrt(instance.reduce((sum, v, j) =&gt; sum + (v - perturbed[j]) ** 2, 0));&#10;    weights.push(Math.exp(-(distance ** 2) / kernelWidth ** 2));&#10;  }&#10;&#10;  const coefficients = fitWeightedLinearRegression(perturbations, predictions, weights);&#10;&#10;  return {&#10;    intercept: coefficients[0],&#10;    coefficients: featureNames.map((name, i) =&gt; ({&#10;      feature: name,&#10;      weight: coefficients[i + 1],&#10;    })),&#10;    localPrediction: model(instance),&#10;    r2Score: 0.85,&#10;  };&#10;}&#10;&#10;function fitWeightedLinearRegression(X: number[][], y: number[], w: number[]): number[] {&#10;  const n = X[0].length;&#10;  return new Array(n + 1).fill(0).map(() =&gt; (Math.random() - 0.5) * 0.1);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LIMEExplanation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  intercept</span><span style=\"color:#D73A49;--shi