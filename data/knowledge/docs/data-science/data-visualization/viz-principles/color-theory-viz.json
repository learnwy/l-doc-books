:#E36209;--shiki-dark:#FFAB70\">colors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;{ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">l</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> colors.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> colors.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ratio</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> checkContrastRatio</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(colors[i].l, colors[j].l);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (ratio </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"语义色彩与文化约定\">语义色彩与文化约定</h2><p>色彩承载着强烈的语义和文化含义，在数据可视化中利用这些约定可以降低认知负担，违背它们则会造成困惑。</p>\n<p>最基本的语义色彩约定是&quot;红色表示危险/负面，绿色表示安全/正面&quot;。在金融可视化中，中国股市习惯红涨绿跌，而欧美市场则相反。温度可视化中蓝色代表冷、红色代表热是全球通用的约定。交通灯配色（红黄绿）在状态指示中被广泛理解。</p>\n<p>在设计可视化色板时，应当遵循以下语义原则：</p>\n<table>\n<thead>\n<tr>\n<th>语义场景</th>\n<th>推荐色彩</th>\n<th>避免色彩</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>温度高/低</td>\n<td>红/蓝</td>\n<td>绿/紫</td>\n<td>违背物理直觉</td>\n</tr>\n<tr>\n<td>正面/负面</td>\n<td>根据文化选择</td>\n<td>固定红绿</td>\n<td>文化差异+色盲</td>\n</tr>\n<tr>\n<td>水域/陆地</td>\n<td>蓝/绿棕</td>\n<td>红/橙</td>\n<td>违背地理认知</td>\n</tr>\n<tr>\n<td>性别区分</td>\n<td>中性色对</td>\n<td>粉/蓝</td>\n<td>强化刻板印象</td>\n</tr>\n<tr>\n<td>危险等级</td>\n<td>黄→橙→红</td>\n<td>蓝→绿</td>\n<td>违背警示约定</td>\n</tr>\n</tbody></table>\n<p>语义色彩的另一个重要应用是品牌一致性。在企业级数据看板中，色彩方案应当与品牌色系协调。通常将品牌主色作为分类色板的第一色，其余颜色在与品牌色保持和谐的前提下选取。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>色彩在数据可视化中承担分类、顺序、发散三种编码角色，选择正确的编码类型是色彩设计的第一步</li>\n<li>感知均匀的色彩空间（CIELAB、HCL、OKLab）是构建高质量色板的数学基础，避免在 RGB/HSL 空间中直接插值</li>\n<li>色板设计需要同时考虑美观性、可辨识性、语义一致性和无障碍兼容性</li>\n<li>约 8% 的男性存在色觉缺陷，必须通过明度冗余、形状冗余等策略确保图表的无障碍性</li>\n<li>色彩承载文化语义，设计时应尊重目标受众的文化约定，避免造成语义冲突</li>\n<li>使用经过验证的色板（ColorBrewer、Viridis）比自行设计更安全可靠</li>\n</ul>\n","headings":[{"level":1,"text":"数据可视化中的色彩理论","id":"数据可视化中的色彩理论"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"色彩空间与感知均匀性","id":"色彩空间与感知均匀性"},{"level":2,"text":"色板设计策略","id":"色板设计策略"},{"level":3,"text":"分类色板","id":"分类色板"},{"level":3,"text":"顺序色板","id":"顺序色板"},{"level":3,"text":"发散色板","id":"发散色板"},{"level":2,"text":"色觉无障碍设计","id":"色觉无障碍设计"},{"level":2,"text":"语义色彩与文化约定","id":"语义色彩与文化约定"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据墨水比与简约设计","url":"/l-doc-books/h/data-science/data-visualization/viz-principles/data-ink-ratio"},"next":{"title":"色彩理论与配色","url":"/l-doc-books/h/data-science/data-visualization/viz-principles/color-theory"}}