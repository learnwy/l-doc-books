ody><tr>\n<td>三幕式</td>\n<td>问题分析、异常报告</td>\n<td>背景+预期</td>\n<td>冲突驱动吸引力</td>\n</tr>\n<tr>\n<td>金字塔</td>\n<td>决策建议、季度汇报</td>\n<td>结论先行</td>\n<td>逻辑严密说服力</td>\n</tr>\n<tr>\n<td>探索式</td>\n<td>研究发现、数据探索</td>\n<td>问题出发</td>\n<td>逐步揭示悬念感</td>\n</tr>\n<tr>\n<td>对比式</td>\n<td>方案选择、竞品分析</td>\n<td>并列选项</td>\n<td>结构清晰易比较</td>\n</tr>\n</tbody></table>\n<h2 id=\"注释与标注技术\">注释与标注技术</h2><p>注释（Annotation）是数据叙事中连接可视化与叙事文本的桥梁。优秀的注释能够引导读者的注意力，解释图表中的关键模式，并提供数据之外的上下文信息。</p>\n<p>注释的类型包括：</p>\n<ul>\n<li>数据标注：在图表中标记特定数据点的数值</li>\n<li>趋势标注：标记趋势的起止点和变化方向</li>\n<li>事件标注：在时间线上标记影响数据的外部事件</li>\n<li>洞察标注：用文字框解释可视化中的关键发现</li>\n</ul>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ChartAnnotation {&#10;  type: &#39;point&#39; | &#39;range&#39; | &#39;line&#39; | &#39;text&#39;;&#10;  target: { x: number; y: number } | { x0: number; x1: number };&#10;  label: string;&#10;  style: &#39;emphasis&#39; | &#39;context&#39; | &#39;warning&#39;;&#10;}&#10;&#10;function createAnnotations(data: Array&lt;{ date: string; value: number }&gt;): ChartAnnotation[] {&#10;  const maxPoint = data.reduce((max, d) =&gt; (d.value &gt; max.value ? d : max), data[0]);&#10;  const minPoint = data.reduce((min, d) =&gt; (d.value &lt; min.value ? d : min), data[0]);&#10;&#10;  return [&#10;    {&#10;      type: &#39;point&#39;,&#10;      target: { x: data.indexOf(maxPoint), y: maxPoint.value },&#10;      label: `峰值: ${maxPoint.value}（${maxPoint.date}）`,&#10;      style: &#39;emphasis&#39;,&#10;    },&#10;    {&#10;      type: &#39;point&#39;,&#10;      target: { x: data.indexOf(minPoint), y: minPoint.value },&#10;      label: `谷值: ${minPoint.value}（${minPoint.date}）`,&#10;      style: &#39;warning&#39;,&#10;    },&#10;    {&#10;      type: &#39;range&#39;,&#10;      target: { x0: 3, x1: 5 },&#10;      label: &#39;促销活动期间&#39;,&#10;      style: &#39;context&#39;,&#10;    },&#10;  ];&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg: