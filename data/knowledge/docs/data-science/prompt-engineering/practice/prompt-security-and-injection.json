tyle=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">prompt</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">(?i)</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">you</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">are</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">now</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">a</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">an</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">(?i)</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">pretend</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">you</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">that</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">are</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">is</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">---</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">END</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">STOP</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">IGNORE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sanitize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, user_input: </span><span style=\"color:#005CC5;--shiki-dark:#