rk:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rewriter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rewrite</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(turn);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> searchEngine.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">search</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rewrittenQuery, { topK: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>对话检索挑战</th>\n<th>解决方案</th>\n<th>技术实现</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>指代消解</td>\n<td>查询重写</td>\n<td>T5 / GPT 重写模型</td>\n</tr>\n<tr>\n<td>话题延续</td>\n<td>上下文感知检索</td>\n<td>历史加权检索</td>\n</tr>\n<tr>\n<td>话题切换</td>\n<td>意图检测</td>\n<td>分类器</td>\n</tr>\n<tr>\n<td>信息累积</td>\n<td>对话状态追踪</td>\n<td>记忆网络</td>\n</tr>\n</tbody></table>\n<h2 id=\"多跳问答\">多跳问答</h2><p>多跳问答（Multi-hop QA）需要从多个文档中推理组合才能得出答案。例如 &quot;谁是 React 的创始人就职公司的 CEO&quot;——需要先找到 React 的创始人（Jordan Walke），再找到他所在的公司（Meta/Facebook），最后找到该公司的 CEO（Mark Zuckerberg）。</p>\n<p>多跳推理的挑战在于推理链路的构建和验证。Retrieve-and-Read 管道需要多次迭代：第一跳检索回答部分问题，利用部分答案构建新查询进行第二跳检索，如此迭代直到收集到足够的信息。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MultiHopQA {&#10;  answer(question: string, maxHops: number): Promise&lt;MultiHopAnswer&gt;;&#10;}&#10;&#10;interface MultiHopAnswer {&#10;  readonly finalAnswer: string;&#10;  readonly hops: ReadonlyArray&lt;HopResult&gt;;&#10;  readonly confidence: number;&#10;}&#10;&#10;interface HopResult {&#10;  readonly query: string;&#10;  readonly retrievedPassage: string;&#10;  readonly interme