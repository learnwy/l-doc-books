:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.answer.confidence </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a.answer.confidence);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> best</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> candidates[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> best</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          answer: best.answer.text,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          confidence: best.answer.confidence,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          sourceDocument: best.docId,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          sourcePassage: best.passage,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { answer: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, confidence: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, sourceDocument: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, sourcePassage: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>Retriever-Reader 架构是开放域 QA 的标准范式——先用 Retriever 从大规模文档集中检索相关段落，再用 Reader 从候选段落中抽取答案。DPR（Dense Passage Retriever）使用双塔 BERT 模型进行密集检索，显著超越了 BM25 在开放域 QA 中的召回性能。</p>\n<h2 id=\"生成式问答与-rag\">生成式问答与 RAG</h2><p>生成式问答不再局限于从文档中抽取现有文本，而是利用 LLM 基于检索到的知识生成自然语言答案。RAG 是当前最主流的生成式 QA 架构。</p>\n<p>生成式 QA 的优势在于答案的自然度和完整度——它可以综合多个段落的信息生成一个连贯的回答，而抽取式方法只能返回单个文本片段。但生成式 QA 也引入了新的风险：幻觉——LLM 可能生成看似合理但不忠于检索上下文的内容。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph RAG 问答&#10;        Q[问题] --&gt; R[Retriever]&#10;        R --&gt; C[上下文组装]&#10;        C --&gt; G[LLM 生成]&#10;        G --&gt; V[答案验证]&#10;        V --&gt; A[最终答案]&#10;    end&#10;    subgraph 抽取式 QA&#10;        Q2[问题] --&gt; R2[Retriever]&#10;        R2 --&gt; RD[Reader]&#10;        RD --&gt; E[文本片段]&#10;    end\">graph LR\n    subgraph RAG 问答\n        Q[问题] --&gt; R[Retriever]\n        R --&gt; C[上下文组装]\n        C --&gt; G[LLM 生成]\n        G --&gt; V[答案验证]\n        V --&gt; A[最终答案]\n    end\n    subgraph 抽取式 QA\n        Q2[问题] --&gt; R2[Retriever]\n        R2 --&gt; RD[Reader]\n        RD --&gt; E[文本片段]\n    end</pre><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>答案质量</th>\n<th>幻觉风险</th>\n<th>可溯源</th>\n<th>延迟</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>抽取式</td>\n<td>精确但片段化</td>\n<td>无</td>\n<td>精确</td>\n<td>低</td>\n</tr>\n<tr>\n<td>生成式 (无检索)</td>\n<td>流畅但不可靠</td>\n<td>高</td>\n<td>无</td>\n<td>低</td>\n</tr>\n<tr>\n<td>RAG</td>\n<td>流畅且有据</td>\n<td>中</td>\n<td>有</td>\n<td>中</td>\n</tr>\n<tr>\n<td>验证增强 RAG</td>\n<td>高质量</td>\n<td>低</td>\n<td>精确</td>\n<td>高</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface GenerativeQA {&#10;  answer(question: string, contexts: ReadonlyArray&lt;string&gt;): Promise&lt;GeneratedAnswer&gt;;&#10;}&#10;&#10;interface GeneratedAnswer {&#10;  readonly text: string;&#10;  readonly citations: ReadonlyArray&lt;Citation&gt;;&#10;  readonly confidence: number;&#10;}&#10;&#10;interface Citation {&#10;  readonly contextIndex: number;&#10;  readonly excerpt: string;&#10;  readonly relevance: number;&#10;}&#10;&#10;const createRAGQA = (retriever: DocumentRetriever, llm: LLMClient, verifier: AnswerVerifier): GenerativeQA =&gt; ({&#10;  answer: async (question, contexts) =&gt; {&#10;    const prompt = buildQAPrompt(question, contexts);&#10;    const rawAnswer = await llm.complete(prompt);&#10;    const citations = extractCitations(rawAnswer, contexts);&#10;    const verification = await verifier.verify(rawAnswer, contexts);&#10;    return {&#10;      text: verification.correctedAnswer ?? rawAnswer,&#10;      citations,&#10;      confidence: verification.faithfulness,&#10;    };&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GenerativeQA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  answer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">question</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">contexts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GeneratedAnswer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GeneratedAnswer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> citations</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Citation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  re