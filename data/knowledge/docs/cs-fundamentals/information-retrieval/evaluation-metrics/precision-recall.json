49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> fBeta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fBetaDenom </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> betaSq) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> precision </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> recall) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fBetaDenom </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { precision, recall, f1, fBeta, tp, fp, fn };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>需要注意的是，精确率和召回率在不同截断点（cutoff）下表现不同。P@10 表示只看前 10 个结果时的精确率，是 Web 搜索中最常用的指标，因为大多数用户只关注首页的 10 个结果。P@k 随 k 增大通常下降，R@k 随 k 增大而上升。</p>\n<h2 id=\"精确率-召回率曲线\">精确率-召回率曲线</h2><p>精确率-召回率曲线（PR Curve）描绘了系统在不同召回率水平下的精确率表现。对于有序的检索结果列表，从 top-1 到 top-N 逐步扩大结果集，在每个位置计算 P 和 R 并绘制曲线。理想系统的 PR 曲线紧贴右上角，随机系统的 PR 曲线近似于水平线 P ≈ |Rel|/|D|。</p>\n<p>插值精确率（Interpolated Precision）用于消除 PR 曲线的锯齿。在标准 11 点插值中，对 11 个标准召回率水平（0, 0.1, 0.2, ..., 1.0）计算插值精确率：<code>P_interp(r) = max(P(r&#39;)) for r&#39; ≥ r</code>。这意味着在每个召回率水平，取该水平及更高召回率的最大精确率。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PRCurvePoint {&#10;  readonly recall: number;&#10;  readonly precision: number;&#10;  readonly rank: number;&#10;  readonly docId: string;&#10;  readonly isRelevant: boolean;&#10;}&#10;&#10;function computePRCurve(rankedDocs: ReadonlyArray&lt;string&gt;, relevant: ReadonlySet&lt;string&gt;): ReadonlyArray&lt;PRCurvePoint&gt; {&#10;  const points: PRCurvePoint[] = [];&#10;  let relevantSoFar = 0;&#10;&#10;  for (let i = 0; i &lt; rankedDocs.length; i++) {&#10;    const docId = rankedDocs[i];&#10;    const isRelevant = relevant.has(docId);&#10;    if (isRelevant) relevantSoFar++;&#10;&#10;    points.push({&#10;      recall: relevant.size &gt; 0 ? relevantSoFar / relevant.size : 0,&#10;      precision: i + 1 &gt; 0 ? relevantSoFar / (i + 1) : 0,&#10;      rank: i + 1,&#10;      docId,&#10;      isRelevant,&#10;    });&#10;  }&#10;  return points;&#10;}&#10;&#10;function interpolatePrecision(&#10;  points: ReadonlyArray&lt;PRCurvePoint&gt;,&#10;  recallLevels: ReadonlyArray&lt;number&gt;,&#10;): ReadonlyArray&lt;{ recall: number; interpolatedPrecision: number }&gt; {&#10;  return recallLevels.map((targetRecall) =&gt; {&#10;    const eligiblePoints = points.filter((p) =&gt; p.recall &gt;= targetRecall);&#10;    const maxPrecision = eligiblePoints.length &gt; 0 ? Math.max(...eligiblePoints.map((p) =&gt; p.precision)) : 0;&#10;    return { recall: targetRecall, interpolatedPrecision: maxPrecision };&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PRCurvePoint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<spa