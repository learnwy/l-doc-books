dark:#E1E4E8\"> rankedDocs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> judgments.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(d)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rankedDocs;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> relevant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">docId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">rel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> judgments) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (rel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.minRelevanceLevel) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      relevant.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(docId);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computePrecisionRecall</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(filtered, relevant);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>第三是「精确率和召回率的尺度不对称」：在大规模文档集合中（如十亿级 Web 索引），即使召回率仅提升 0.1%，绝对数量上也可能意味着发现了数千篇新的相关文档。因此在大规模场景中，召回率的微小变化可能比看起来更有意义。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>精确率衡量返回结果的纯度，召回率衡量相关文档的覆盖度</li>\n<li>P@k 是 Web 搜索最常用指标，因用户通常只看前 k 个结果</li>\n<li>PR 曲线描绘了精确率随召回率变化的完整图景，插值消除锯齿</li>\n<li>F-Measure 通过调和平均综合 P 和 R，β 参数控制两者权重</li>\n<li>不完整判定、评价者不一致和尺度不对称是实际评估中的常见陷阱</li>\n<li>宏平均和微平均 F1 在多查询场景中适用于不同需求</li>\n<li>精确率和召回率虽然基础，但理解其局限性对正确使用高级指标至关重要</li>\n</ul>\n","headings":[{"level":1,"text":"精确率与召回率","id":"精确率与召回率"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"集合检索中的 P/R 计算","id":"集合检索中的-p-r-计算"},{"level":2,"text":"精确率-召回率曲线","id":"精确率-召回率曲线"},{"level":2,"text":"F-Measure：精确率与召回率的综合","id":"f-measure-精确率与召回率的综合"},{"level":2,"text":"实际评估中的陷阱","id":"实际评估中的陷阱"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"TREC 与评测方法论","url":"/l-doc-books/h/cs-fundamentals/information-retrieval/query-evaluation/trec-methodology"},"next":{"title":"MAP 与 NDCG","url":"/l-doc-books/h/cs-fundamentals/information-retrieval/evaluation-metrics/map-ndcg"}}