pan><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(term, documents);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildDocumentVector</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  document</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  vocabulary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  documents</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vocabulary.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">term</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computeTFIDF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(term, document, documents));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>TF 的常见变体包括：原始频率（raw TF）、对数频率（1 + log tf）、归一化频率（tf / max_tf）和布尔频率（0 或 1）。对数频率是最常用的变体，它缓解了高频词项主导权重的问题——出现 100 次和 10 次的词项在重要性上的差异不应是 10 倍。</p>\n<table>\n<thead>\n<tr>\n<th>TF 变体</th>\n<th>公式</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>原始频率</td>\n<td>tf(t,d)</td>\n<td>简单直观</td>\n<td>短文档</td>\n</tr>\n<tr>\n<td>对数频率</td>\n<td>1 + log(tf)</td>\n<td>抑制高频</td>\n<td>通用</td>\n</tr>\n<tr>\n<td>归一化频率</td>\n<td>tf / max_tf</td>\n<td>文档长度归一化</td>\n<td>长度差异大</td>\n</tr>\n<tr>\n<td>增强频率</td>\n<td>0.5 + 0.5 × tf/max_tf</td>\n<td>平滑归一化</td>\n<td>通用</td>\n</tr>\n</tbody></table>\n<h2 id=\"余弦相似度与文档排序\">余弦相似度与文档排序</h2><p>余弦相似度通过计算两个向量之间夹角的余弦值来度量它们的相似程度。取值范围在 [-1, 1] 之间，由于 TF-IDF 权重非负，实际范围是 [0, 1]。余弦值为 1 表示两个向量方向完全相同（完全相似），0 表示正交（不相关）。</p>\n<p>余弦相似度的一个关键优势是它对向量长度不敏感——两个方向相同但长度不同的向量有相同的余弦值。这意味着文档长度不会直接影响相关性评分，避免了长文档因为词频更高而获得不公平的优势。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const cosineSimilarity = (v1: ReadonlyArray&lt;number&gt;, v2: ReadonlyArray&lt;number&gt;): number =&gt; {&#10;  let dotProduct = 0;&#10;  let norm1 = 0;&#10;  let norm2 = 0;&#10;  for (let i = 0; i &lt; v1.length; i++) {&#10;    dotProduct += v1[i] * v2[i];&#10;    norm1 += v1[i] * v1[i];&#10;    norm2 += v2[i] * v2[i];&#10;  }&#10;  const denominator = Math.sqrt(norm1) * Math.sqrt(norm2);&#10;  return denominator === 0 ? 0 : dotProduct / denominator;&#10;};&#10;&#10;const rankDocuments = (&#10;  queryVector: ReadonlyArray&lt;number&gt;,&#10;  documentVectors: Map&lt;string, ReadonlyArray&lt;number&gt;&gt;,&#10;  topK: number,&#10;): ReadonlyArray&lt;{ docId: string; score: number }&gt; =&gt; {&#10;  const scores = [...documentVectors.entries()].map(([docId, docVector]) =&gt; ({&#10;    docId,&#10;    score: cosineSimilarity(queryVector, docVector),&#10;  }));&#10;  return scores&#10;    .filter((s) =&gt; s.score &gt; 0)&#10;    .sort((a, b) =&gt; b.score - a.score)&#10;    .slice(0, topK);&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cosineSimilarity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v2</span><span style=\"colo