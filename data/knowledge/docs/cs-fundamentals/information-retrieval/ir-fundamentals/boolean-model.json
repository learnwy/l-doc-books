</span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'NOT'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> childResult</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> evaluateBoolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((query.children </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [])[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], index);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> allDocs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Array.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ length: index.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getDocCount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> allDocs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">childResult.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(d));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"扩展布尔模型\">扩展布尔模型</h2><p>标准布尔模型的最大局限是缺少排序能力。扩展布尔模型通过引入权重和模糊匹配来缓解这个问题。</p>\n<p>P-Norm 模型将 AND 和 OR 运算泛化为 p-范数距离，当 p=1 时退化为向量空间模型的行为，当 p→∞ 时退化为标准布尔模型。通过调整 p 值，可以在精确匹配和模糊匹配之间平滑过渡。</p>\n<p>模糊布尔模型使用模糊集合论取代经典集合论，允许文档以 [0, 1] 之间的隶属度属于某个词项集合，而非简单的 0 或 1。这使得 AND 运算变为取最小值（min），OR 运算变为取最大值（max），NOT 运算变为 1 减去隶属度。</p>\n<table>\n<thead>\n<tr>\n<th>模型变体</th>\n<th>排序能力</th>\n<th>布尔精确性</th>\n<th>复杂度</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>标准布尔</td>\n<td>无</td>\n<td>精确</td>\n<td>低</td>\n<td>法律检索、专利搜索</td>\n</tr>\n<tr>\n<td>P-Norm</td>\n<td>有</td>\n<td>可调节</td>\n<td>中</td>\n<td>通用检索</td>\n</tr>\n<tr>\n<td>模糊布尔</td>\n<td>有</td>\n<td>近似</td>\n<td>中</td>\n<td>容错检索</td>\n</tr>\n<tr>\n<td>加权布尔</td>\n<td>有</td>\n<td>保留结构</td>\n<td>低</td>\n<td>专家搜索</td>\n</tr>\n</tbody></table>\n<h2 id=\"布尔检索的现代应用\">布尔检索的现代应用</h2><p>尽管布尔模型在通用搜索引擎中已被排序模型取代，但它在特定领域仍然是不可替代的。法律检索要求极高的精确性和可解释性——律师需要确切知道为什么某个判例被检索到或被排除。布尔查询的逻辑透明性满足了这一需求。专利检索同样需要布尔逻辑来构建复杂的检索策略，确保不遗漏任何相关专利。</p>\n<p>现代搜索引擎实际上在底层大量使用布尔运算——倒排索引的查找本质上就是布尔操作。BM25 等排序模型通常在布尔匹配的结果集上进行评分，布尔检索充当了粗筛阶段。结构化过滤（日期范围、类别筛选）也本质上是布尔运算。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>布尔检索模型将文档和查询建模为词项集合，通过 AND/OR/NOT 集合运算实现精确匹配</li>\n<li>倒排索引的有序列表支持双指针法在 O(n+m) 时间内完成高效集合运算</li>\n<li>查询优化的核心策略是从最短倒排列表开始处理，最小化中间结果规模</li>\n<li>扩展布尔模型（P-Norm、模糊布尔）通过引入连续权重弥补了标准模型缺乏排序的缺陷</li>\n<li>布尔检索在法律、专利等需要精确控制和可解释性的领域仍不可替代</li>\n<li>现代搜索引擎在底层仍然依赖布尔运算作为倒排索引操作和结构化过滤的基础</li>\n</ul>\n","headings":[{"level":1,"text":"布尔检索模型","id":"布尔检索模型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"倒排索引与布尔操作","id":"倒排索引与布尔操作"},{"level":2,"text":"查询优化策略","id":"查询优化策略"},{"level":2,"text":"扩展布尔模型","id":"扩展布尔模型"},{"level":2,"text":"布尔检索的现代应用","id":"布尔检索的现代应用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"信息检索概述","url":"/l-doc-books/h/cs-fundamentals/information-retrieval/ir-fundamentals/ir-overview"},"next":{"title":"向量空间模型","url":"/l-doc-books/h/cs-fundamentals/information-retrieval/ir-fundamentals/vector-space-model"}}