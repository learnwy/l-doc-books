E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> list1.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(list1[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> list2.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(list2[j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>NOT 运算需要特别注意——它计算的是一个词项文档集合相对于整个文档集合的补集。直接计算补集的代价很高（需要遍历全部文档），因此实践中通常将 NOT 操作重写为与其他集合的差集运算。</p>\n<h2 id=\"查询优化策略\">查询优化策略</h2><p>布尔查询的执行效率与词项处理顺序密切相关。考虑查询 &quot;A AND B AND C&quot;，如果 A 出现在 10000 个文档中、B 出现在 100 个文档中、C 出现在 5000 个文档中，最优策略是先处理 B（最短的倒排列表），再与 A 求交集，最后与 C 求交集。这种优化称为「从短到长」策略，它最小化了中间结果的大小。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph 查询优化&#10;        Q[&quot;A AND B AND C&quot;] --&gt; S[按文档频率排序]&#10;        S --&gt; P1[&quot;B (100)&quot;]&#10;        P1 --&gt; I1[&quot;B ∩ A → 50&quot;]&#10;        I1 --&gt; I2[&quot;(B∩A) ∩ C → 20&quot;]&#10;    end\">graph LR\n    subgraph 查询优化\n        Q[\"A AND B AND C\"] --&gt; S[按文档频率排序]\n        S --&gt; P1[\"B (100)\"]\n        P1 --&gt; I1[\"B ∩ A → 50\"]\n        I1 --&gt; I2[\"(B∩A) ∩ C → 20\"]\n    end</pre><p>对于包含 OR 的复杂查询，优化策略更加复杂。一般方法是将查询转换为析取范式（DNF）或合取范式（CNF），然后根据每个子句的预估代价选择执行计划。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface BooleanQuery {&#10;  readonly type: &#39;AND&#39; | &#39;OR&#39; | &#39;NOT&#39; | &#39;TERM&#39;;&#10;  readonly children?: ReadonlyArray&lt;BooleanQuery&gt;;&#10;  readonly term?: string;&#10;}&#10;&#10;const optimizeAndQuery = (terms: ReadonlyArray&lt;string&gt;, index: InvertedIndex): ReadonlyArray&lt;string&gt; =&gt; {&#10;  return [...terms].sort((a, b) =&gt; {&#10;    const freqA = index.getPostings(a)?.docFrequency ?? 0;&#10;    const freqB = index.getPostings(b)?.docFrequency ?? 0;&#10;    return freqA - freqB;&#10;  });&#10;};&#10;&#10;const evaluateBoolean = (query: BooleanQuery, index: InvertedIndex): ReadonlyArray&lt;number&gt; =&gt; {&#10;  switch (query.type) {&#10;    case &#39;TERM&#39;: {&#10;      const postings = index.getPostings(query.term ?? &#39;&#39;);&#10;      return postings ? [...postings.docIds] : [];&#10;    }&#10;    case &#39;AND&#39;: {&#10;      const childResults = (query.children ?? []).map((c) =&gt; evaluateBoolean(c, index));&#10;      const sorted = childResults.sort((a, b) =&gt; a.length - b.length);&#10;      return sorted.reduce((acc, curr) =&gt; intersect(acc, curr));&#10;    }&#10;    case &#39;OR&#39;: {&#10;      const childResults = (query.children ?? []).map((c) =&gt; evaluateBoolean(c, index));&#10;      return childResults.reduce((acc, curr) =&gt; union(acc, curr));&#10;    }&#10;    case &#39;NOT&#39;: {&#10;      const childResult = evaluateBoolean((query.children ?? [])[0], index);&#10;      const allDocs = Array.from({ length: index.getDocCount() }, (_, i) =&gt; i);&#10;      return allDocs.filter((d) =&gt; !childResult.includes(d));&#10;    }&#10;    default:&#10;      return [];&#10;  }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BooleanQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'AND'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'OR'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'NOT'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'TERM'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> children</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadonlyArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">BooleanQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<