style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> len </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(maxLen, text.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i); len </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; len</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">--</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> candidate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i, i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> len);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (dict.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(candidate)) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(candidate);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> len;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        matched </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">matched) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(text[i]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>分词方法</th>\n<th>代表工具</th>\n<th>准确率</th>\n<th>速度</th>\n<th>OOV 处理</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>词典匹配</td>\n<td>FMM/BMM</td>\n<td>中</td>\n<td>极快</td>\n<td>差</td>\n<td>高吞吐离线索引</td>\n</tr>\n<tr>\n<td>HMM+词典</td>\n<td>jieba</td>\n<td>中高</td>\n<td>快</td>\n<td>中</td>\n<td>通用 IR 系统</td>\n</tr>\n<tr>\n<td>CRF</td>\n<td>THULAC</td>\n<td>高</td>\n<td>中</td>\n<td>中高</td>\n<td>精度优先场景</td>\n</tr>\n<tr>\n<td>BERT</td>\n<td>LAC、BERT-wwm</td>\n<td>最高</td>\n<td>慢</td>\n<td>优秀</td>\n<td>查询理解、NLU</td>\n</tr>\n</tbody></table>\n<h2 id=\"unicode-归一化与大小写折叠\">Unicode 归一化与大小写折叠</h2><p>Unicode 归一化解决同一字符存在多种编码表示的问题。例如，<code>é</code> 可以用单个码位 U+00E9（NFC 形式）表示，也可以用 <code>e</code> + 组合重音符 U+0301（NFD 形式）表示。如果不做归一化，同一个词在索引和查询中可能因为编码不同而无法匹配。</p>\n<p>NFC（Canonical Decomposition followed by Canonical Composition）和 NFD（Canonical Decomposition）是最常用的两种归一化形式。IR 系统通常选择 NFC，因为它产生最紧凑的表示。NFKC 和 NFKD 进一步将兼容等价字符统一，例如将全角字母 <code>Ａ</code> 转为半角 <code>A</code>。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface NormalizationPipeline {&#10;  readonly unicodeForm: &#39;NFC&#39; | &#39;NFD&#39; | &#39;NFKC&#39; | &#39;NFKD&#39;;&#10;  readonly caseFolding: &#39;lower&#39; | &#39;upper&#39; | &#39;aggressive&#39; | &#39;none&#39;;&#10;  readonly accentHandling: &#39;keep&#39; | &#39;strip&#39;;&#10;  readonly widthNormalization: boolean;&#10;}&#10;&#10;function normalizeToken(token: string, config: NormalizationPipeline): string {&#10;  let result = token.normalize(config.unicodeForm);&#10;&#10;  if (config.widthNormalization) {&#10;    result = result.replace(/[\\uFF01-\\uFF5E]/g, (ch) =&gt; String.fromCharCode(ch.charCodeAt(0) - 0xfee0));&#10;  }&#10;&#10;  if (config.accentHandling === &#39;strip&#39;) {&#10;    result = result.normalize(&#39;NFD&#39;).replace(/[\\u0300-\\u036f]/g, &#39;&#39;);&#10;    result = result.normalize(config.unicodeForm);&#10;  }&#10;&#10;  if (config.caseFolding === &#39;lower&#39;) {&#10;    result = result.toLowerCase();&#10;  } else if (config.caseFolding === &#39;aggressive&#39;) {&#10;    result = result.toLocaleLowerCase(&#39;tr&#39;);&#10;  }&#10;&#10;  return result;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NormalizationPipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> unicodeForm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'NFC'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'NFD'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'NFKC'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'NFKD'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> caseFolding</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'lower'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'upper'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'aggressive'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'none'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> accentHandling</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'keep'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'strip'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> widthNormalization</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> normalizeToken</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">token</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> NormalizationPipeline</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> token.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">normalize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(config.unicodeForm);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.widthNormalization) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[\\uFF01-\\uFF5E]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> String.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fromCharCode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ch.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">charCodeAt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0xfee0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.accentHandling </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'strip'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">normalize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'NFD'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[\\u0300-\\u036f]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">normalize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(config.unicodeForm);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.caseFolding </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'lower'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.caseFolding </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'aggressive'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLocaleLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'tr'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>大小写折叠（Case Folding）将大写字母转为小写，使 <code>Apple</code> 和 <code>apple</code> 匹配同一个词项。但简单的 <code>toLowerCase()</code> 在某些语言中存在问题：德语的 <code>ß</code> 应折叠为 <code>ss</code>，土耳其语的 <code>İ</code> 应折叠为 <code>i</code> 而非英语的 <code>I</code> → <code>i</code> 规则。Unicode Case Folding 标准（CaseFolding.txt）定义了语言无关的完整折叠规则。</p>\n<h2 id=\"停用词过滤\">停用词过滤</h2><p>停用词（Stop Words）是在文档集合中出现频率极高但携带极少语义信息的词汇，如英语的 <code>the</code>、<code>is</code>、<code>at</code> 和中文的「的」「了」「在」。移除停用词可以减少索引大小（通常减少 25-30%）、降低噪音并提升检索效率。</p>\n<p>停用词表的构建有两种策略：基于频率的自动生成和人工编辑的标准列表。基于频率的方法统计语料库中每个词的文档频率（DF），将 DF 超过阈值（如出现在 80% 以上文档中）的词标记为停用词。人工列表如 NLTK 的英文停用词表（179 词）和百度的中文停用词表提供了经过验证的通用方案。</p>\n<table>\n<thead>\n<tr>\n<th>停用词策略</th>\n<th>优点</th>\n<th>缺点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>不过滤</td>\n<td>支持短语查询</td>\n<td>索引膨胀、噪音多</td>\n<td>精确短语搜索</td>\n</tr>\n<tr>\n<td>标准列表</td>\n<td>简单可控</td>\n<td>不适应特定领域</td>\n<td>通用搜索引擎</td>\n</tr>\n<tr>\n<td>频率自适应</td>\n<td>领域适配</td>\n<td>需要语料库统计</td>\n<td>垂直搜索</td>\n</tr>\n<tr>\n<td>查询时过滤</td>\n<td>灵活</td>\n<td>索引不减小</td>\n<td>混合搜索系统</td>\n</tr>\n</tbody></table>\n<p>需要注意的是，现代搜索系统对停用词过滤越来越谨慎。在短语查询（&quot;to be or not to be&quot;）和位置感知检索中，停用词包含重要的句法信息。许多系统选择在索引时保留停用词，仅在查询扩展和相关性计算时降低其权重。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>分词将连续文本切分为离散词项，英文基于空白符和标点规则，中文需要专门的分词算法</li>\n<li>子词分词（BPE/WordPiece）解决 OOV 问题，是深度学习时代的重要补充</li>\n<li>中文分词三大流派各有优劣：词典方法快、统计方法准、深度学习方法全面但慢</li>\n<li>Unicode 归一化消除同一字符的多种编码表示，IR 系统通常采用 NFC 形式</li>\n<li>大小写折叠需考虑多语言差异，简单的 <code>toLowerCase()</code> 不够健壮</li>\n<li>停用词过滤在减小索引和降低噪音之间权衡，现代系统趋向保留停用词并降低权重</li>\n<li>文本处理流水线的每个步骤都需要根据应用场景和目标语言进行定制化配置</li>\n</ul>\n","headings":[{"level":1,"text":"分词与归一化","id":"分词与归一化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"英文分词策略","id":"英文分词策略"},{"level":2,"text":"中文分词技术","id":"中文分词技术"},{"level":2,"text":"Unicode 归一化与大小写折叠","id":"unicode-归一化与大小写折叠"},{"level":2,"text":"停用词过滤","id":"停用词过滤"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"评估方法论","url":"/l-doc-books/h/cs-fundamentals/information-retrieval/evaluation-metrics/evaluation-methodology"},"next":{"title":"词干提取与词形还原","url":"/l-doc-books/h/cs-fundamentals/information-retrieval/text-processing/stemming-lemmatization"}}