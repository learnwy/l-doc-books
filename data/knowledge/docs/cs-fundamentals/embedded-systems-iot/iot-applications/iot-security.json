D);&#10;    mbedtls_ssl_conf_ca_chain(&amp;conf, &amp;cacert, NULL);&#10;&#10;    mbedtls_ssl_setup(&amp;ssl, &amp;conf);&#10;    mbedtls_ssl_set_hostname(&amp;ssl, host);&#10;&#10;    mbedtls_net_connect(&amp;server_fd, host, port, MBEDTLS_NET_PROTO_TCP);&#10;    mbedtls_ssl_set_bio(&amp;ssl, &amp;server_fd,&#10;                        mbedtls_net_send, mbedtls_net_recv, NULL);&#10;&#10;    return mbedtls_ssl_handshake(&amp;ssl);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// mbedTLS 客户端 TLS 连接（MQTT over TLS）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"mbedtls/ssl.h\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"mbedtls/net_sockets.h\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setup_tls_connection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> char</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">host</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> char</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"c