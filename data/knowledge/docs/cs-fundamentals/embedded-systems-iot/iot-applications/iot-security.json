dtls_net_recv, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> mbedtls_ssl_handshake</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ssl);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>加密方案</th>\n<th>适用协议</th>\n<th>RAM 需求</th>\n<th>握手时间</th>\n<th>安全级别</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>TLS 1.3</td>\n<td>MQTT/TCP</td>\n<td>30-60KB</td>\n<td>200-500ms</td>\n<td>最高</td>\n</tr>\n<tr>\n<td>DTLS 1.2</td>\n<td>CoAP/UDP</td>\n<td>20-40KB</td>\n<td>300-800ms</td>\n<td>高</td>\n</tr>\n<tr>\n<td>PSK</td>\n<td>资源受限设备</td>\n<td>5-10KB</td>\n<td>50-100ms</td>\n<td>中</td>\n</tr>\n<tr>\n<td>OSCORE</td>\n<td>CoAP E2E</td>\n<td>2-5KB</td>\n<td>N/A</td>\n<td>高（应用层）</td>\n</tr>\n</tbody></table>\n<h2 id=\"安全-ota-更新\">安全 OTA 更新</h2><p>安全的空中升级（OTA）需要保证固件的完整性、真实性和回滚保护：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[构建服务器] --&gt;|签名| B[固件包]&#10;    B --&gt;|加密传输| C[设备]&#10;    C --&gt; D{验证签名}&#10;    D --&gt;|通过| E[写入备份分区]&#10;    D --&gt;|失败| F[拒绝升级]&#10;    E --&gt; G{启动验证}&#10;    G --&gt;|成功| H[切换启动分区]&#10;    G --&gt;|失败| I[回滚到旧固件]\">graph LR\n    A[构建服务器] --&gt;|签名| B[固件包]\n    B --&gt;|加密传输| C[设备]\n    C --&gt; D{验证签名}\n    D --&gt;|通过| E[写入备份分区]\n    D --&gt;|失败| F[拒绝升级]\n    E --&gt; G{启动验证}\n    G --&gt;|成功| H[切换启动分区]\n    G --&gt;|失败| I[回滚到旧固件]</pre><table>\n<thead>\n<tr>\n<th>OTA 安全特性</th>\n<th>实现方式</th>\n<th>作用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>固件签名</td>\n<td>ECDSA / Ed25519</td>\n<td>确保固件来自可信源</td>\n</tr>\n<tr>\n<td>传输加密</td>\n<td>TLS / DTLS</td>\n<td>防止中间人注入</td>\n</tr>\n<tr>\n<td>版本回滚保护</td>\n<td>版本号单调递增 + 熔丝位</td>\n<td>防止降级攻击</td>\n</tr>\n<tr>\n<td>双分区方案</td>\n<td>A/B 分区交替写入</td>\n<td>失败自动回滚</td>\n</tr>\n<tr>\n<td>差分更新</td>\n<td>bsdiff / detools</td>\n<td>减少传输量</td>\n</tr>\n<tr>\n<td>完整性校验</td>\n<td>SHA-256 + CRC32</td>\n<td>检测传输错误</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>IoT 安全需要构建从芯片到云端的纵深防御体系，不能依赖单一安全措施</li>\n<li>安全启动链是设备安全的基石，确保每次启动都运行经过签名验证的固件</li>\n<li>硬件安全模块（SE、TrustZone）提供密钥的安全存储和加密运算隔离</li>\n<li>TLS/DTLS 是 IoT 通信安全的标准方案，PSK 模式适合资源极度受限的设备</li>\n<li>安全 OTA 必须包含签名验证、传输加密、版本回滚保护和故障回滚机制</li>\n<li>IoT 安全是持续工程，设备生命周期内需要定期评估和更新安全策略</li>\n</ul>\n","headings":[{"level":1,"text":"IoT 安全工程","id":"iot-安全工程"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"设备安全基础","id":"设备安全基础"},{"level":3,"text":"安全启动链","id":"安全启动链"},{"level":3,"text":"硬件安全模块","id":"硬件安全模块"},{"level":2,"text":"通信安全","id":"通信安全"},{"level":3,"text":"TLS 与 DTLS","id":"tls-与-dtls"},{"level":2,"text":"安全 OTA 更新","id":"安全-ota-更新"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"低功耗计算与能量管理","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/iot-applications/power-aware-computing"},"next":null}