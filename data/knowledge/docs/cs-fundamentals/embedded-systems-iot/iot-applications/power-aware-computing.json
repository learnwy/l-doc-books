or:#24292E;--shiki-dark:#E1E4E8\">                                 RTC_WAKEUPCLOCK_CK_SPRE_16BITS);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sensor_duty_cycle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        enable_sensor_power</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        HAL_Delay</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> read_sensor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        disable_sensor_power</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">should_transmit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(value)) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            enable_radio</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            transmit_data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(value);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            disable_radio</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        configure_rtc_wakeup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        enter_stop2_mode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"时钟管理\">时钟管理</h3><div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// 动态时钟频率调整&#10;void set_low_speed_clock(void) {&#10;    RCC_ClkInitTypeDef clk = {0};&#10;    clk.ClockType = RCC_CLOCKTYPE_SYSCLK;&#10;    clk.SYSCLKSource = RCC_SYSCLKSOURCE_MSI;&#10;    HAL_RCC_ClockConfig(&amp;clk, FLASH_LATENCY_0);&#10;&#10;    HAL_RCCEx_MSIRangeConfig(RCC_MSIRANGE_0);&#10;}&#10;&#10;void disable_unused_peripherals(void) {&#10;    __HAL_RCC_GPIOB_CLK_DISABLE();&#10;    __HAL_RCC_GPIOC_CLK_DISABLE();&#10;    __HAL_RCC_SPI2_CLK_DISABLE();&#10;    __HAL_RCC_USART2_CLK_DISABLE();&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 动态时钟频率调整</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> set_low_speed_clock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    RCC_ClkInitTypeDef clk </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    clk.ClockType </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RCC_CLOCKTYPE_SYSCLK;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    clk.SYSCLKSource </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RCC_SYSCLKSOURCE_MSI;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_RCC_ClockConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">clk, FLASH_LATENCY_0);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_RCCEx_MSIRangeConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(RCC_MSIRANGE_0);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> disable_unused_peripherals</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    __HAL_RCC_GPIOB_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    __HAL_RCC_GPIOC_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    __HAL_RCC_SPI2_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    __HAL_RCC_USART2_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>时钟策略</th>\n<th>功耗影响</th>\n<th>实现方式</th>\n<th>注意事项</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>降频运行</td>\n<td>线性降低</td>\n<td>MSI 低频模式</td>\n<td>处理速度同步降低</td>\n</tr>\n<tr>\n<td>外设时钟门控</td>\n<td>减少泄漏电流</td>\n<td>RCC 时钟禁用</td>\n<td>按需开关</td>\n</tr>\n<tr>\n<td>PLL 关闭</td>\n<td>显著降低</td>\n<td>切换到 MSI/HSI</td>\n<td>唤醒后需重新锁定</td>\n</tr>\n<tr>\n<td>LSE 驱动</td>\n<td>节省 RTC 功耗</td>\n<td>低驱动模式</td>\n<td>可能影响起振</td>\n</tr>\n</tbody></table>\n<h2 id=\"能量采集技术\">能量采集技术</h2><p>能量采集（Energy Harvesting）从环境中获取能量，可以延长甚至消除电池更换需求：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[能量来源] --&gt; B[太阳能]&#10;    A --&gt; C[振动/压电]&#10;    A --&gt; D[热能/温差]&#10;    A --&gt; E[射频能量]&#10;    B --&gt; F[光伏电池]&#10;    C --&gt; G[压电陶瓷]&#10;    D --&gt; H[热电偶]&#10;    E --&gt; I[RF 整流天线]&#10;    F --&gt; J[MPPT 控制器]&#10;    G --&gt; J&#10;    H --&gt; J&#10;    I --&gt; J&#10;    J --&gt; K[储能元件]&#10;    K --&gt; L[超级电容]&#10;    K --&gt; M[可充电电池]\">graph LR\n    A[能量来源] --&gt; B[太阳能]\n    A --&gt; C[振动/压电]\n    A --&gt; D[热能/温差]\n    A --&gt; E[射频能量]\n    B --&gt; F[光伏电池]\n    C --&gt; G[压电陶瓷]\n    D --&gt; H[热电偶]\n    E --&gt; I[RF 整流天线]\n    F --&gt; J[MPPT 控制器]\n    G --&gt; J\n    H --&gt; J\n    I --&gt; J\n    J --&gt; K[储能元件]\n    K --&gt; L[超级电容]\n    K --&gt; M[可充电电池]</pre><table>\n<thead>\n<tr>\n<th>能量来源</th>\n<th>功率密度</th>\n<th>可用性</th>\n<th>成本</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>室外太阳能</td>\n<td>10-100 mW/cm²</td>\n<td>白天</td>\n<td>低</td>\n<td>户外传感器</td>\n</tr>\n<tr>\n<td>室内光能</td>\n<td>10-100 μW/cm²</td>\n<td>有光时</td>\n<td>中</td>\n<td>室内传感器</td>\n</tr>\n<tr>\n<td>振动</td>\n<td>1-100 μW/cm³</td>\n<td>振源附近</td>\n<td>高</td>\n<td>工业设备监测</td>\n</tr>\n<tr>\n<td>温差</td>\n<td>10-50 μW/cm²</td>\n<td>有温差时</td>\n<td>中</td>\n<td>管道、引擎监测</td>\n</tr>\n<tr>\n<td>射频</td>\n<td>1-10 μW/cm²</td>\n<td>有信号时</td>\n<td>中</td>\n<td>RFID、无源传感器</td>\n</tr>\n</tbody></table>\n<h2 id=\"功耗预算与寿命估算\">功耗预算与寿命估算</h2><h3 id=\"系统级功耗分析\">系统级功耗分析</h3><div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"功耗预算示例：CR2032 电池供电温度传感器&#10;&#10;电池容量：CR2032 = 225 mAh（标称 3.0V）&#10;&#10;工作周期（每 5 分钟采样一次上报）：&#10;├── 深度睡眠：299.8s × 2μA = 0.167 mAs&#10;├── 唤醒+初始化：5ms × 5mA = 0.025 mAs&#10;├── 传感器采样：50ms × 10mA = 0.500 mAs&#10;├── 无线发送：100ms × 30mA = 3.000 mAs&#10;└── 周期总计：3.692 mAs / 300s = 12.3μA 平均&#10;&#10;电池寿命 = 225mAh / 0.0123mA = 18,293 小时 ≈ 2.09 年&#10;&#10;优化后（每 15 分钟上报、数据压缩）：&#10;平均电流 = 4.4μA → 寿命 ≈ 5.8 年\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>功耗预算示例：CR2032 电池供电温度传感器</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>电池容量：CR2032 = 225 mAh（标称 3.0V）</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>工作周期（每 5 分钟采样一次上报）：</span></span>\n<span class=\"line\"><span>├── 深度睡眠：299.8s × 2μA = 0.167 mAs</span></span>\n<span class=\"line\"><span>├── 唤醒+初始化：5ms × 5mA = 0.025 mAs</span></span>\n<span class=\"line\"><span>├── 传感器采样：50ms × 10mA = 0.500 mAs</span></span>\n<span class=\"line\"><span>├── 无线发送：100ms × 30mA = 3.000 mAs</span></span>\n<span class=\"line\"><span>└── 周期总计：3.692 mAs / 300s = 12.3μA 平均</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>电池寿命 = 225mAh / 0.0123mA = 18,293 小时 ≈ 2.09 年</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>优化后（每 15 分钟上报、数据压缩）：</span></span>\n<span class=\"line\"><span>平均电流 = 4.4μA → 寿命 ≈ 5.8 年</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>优化手段</th>\n<th>功耗降低</th>\n<th>实现难度</th>\n<th>副作用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>延长采样间隔</td>\n<td>线性</td>\n<td>低</td>\n<td>降低时间分辨率</td>\n</tr>\n<tr>\n<td>条件上报（变化时才发）</td>\n<td>30-70%</td>\n<td>中</td>\n<td>可能丢失趋势</td>\n</tr>\n<tr>\n<td>数据聚合批量发送</td>\n<td>20-40%</td>\n<td>中</td>\n<td>增加延迟</td>\n</tr>\n<tr>\n<td>降低发射功率</td>\n<td>10-30%</td>\n<td>低</td>\n<td>减小通信距离</td>\n</tr>\n<tr>\n<td>使用更高效编码</td>\n<td>5-15%</td>\n<td>低</td>\n<td>增加固件复杂度</td>\n</tr>\n<tr>\n<td>硬件升级（更低功耗 MCU）</td>\n<td>30-50%</td>\n<td>高</td>\n<td>成本增加</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>IoT 设备功耗优化需要从硬件、系统、软件和通信四个层面综合考虑</li>\n<li>深度睡眠模式是降低待机功耗的关键，STM32L4 的 STOP2 模式可实现 2μA 待机</li>\n<li>时钟门控和按需启用外设是最基础且有效的软件层功耗优化手段</li>\n<li>能量采集技术可以延长电池寿命甚至实现永久供电，但受限于环境条件和功率密度</li>\n<li>功耗预算是系统设计的必要步骤，需要精确计算每个工作阶段的电流消耗</li>\n<li>通信是 IoT 设备最大的功耗来源，优化传输策略（条件上报、批量发送）效果最显著</li>\n</ul>\n","headings":[{"level":1,"text":"低功耗计算与能量管理","id":"低功耗计算与能量管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"MCU 低功耗模式","id":"mcu-低功耗模式"},{"level":3,"text":"STM32 功耗管理","id":"stm32-功耗管理"},{"level":3,"text":"时钟管理","id":"时钟管理"},{"level":2,"text":"能量采集技术","id":"能量采集技术"},{"level":2,"text":"功耗预算与寿命估算","id":"功耗预算与寿命估算"},{"level":3,"text":"系统级功耗分析","id":"系统级功耗分析"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"传感器数据管线","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/iot-applications/sensor-data-pipeline"},"next":{"title":"IoT 安全工程","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/iot-applications/iot-security"}}