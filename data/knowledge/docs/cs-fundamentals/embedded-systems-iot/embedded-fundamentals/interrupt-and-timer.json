yle=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (uart_data_ready) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            uart_data_ready </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            process_byte</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(uart_rx_byte);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        __WFI</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 等待中断，降低功耗</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>实践原则</th>\n<th>正确做法</th>\n<th>错误做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ISR 长度</td>\n<td>尽短（设标志/搬数据）</td>\n<td>在 ISR 中做复杂处理</td>\n</tr>\n<tr>\n<td>共享变量</td>\n<td>volatile + 临界区</td>\n<td>普通变量</td>\n</tr>\n<tr>\n<td>内存分配</td>\n<td>禁止</td>\n<td>在 ISR 中 malloc</td>\n</tr>\n<tr>\n<td>阻塞调用</td>\n<td>禁止</td>\n<td>在 ISR 中 delay/printf</td>\n</tr>\n<tr>\n<td>优先级</td>\n<td>数据丢失风险高的设高优先级</td>\n<td>所有中断同优先级</td>\n</tr>\n<tr>\n<td>中断频率</td>\n<td>确保处理时间 &lt; 中断间隔</td>\n<td>中断频率过高</td>\n</tr>\n</tbody></table>\n<h2 id=\"看门狗定时器\">看门狗定时器</h2><p>看门狗（Watchdog Timer）是系统可靠性的最后防线——当软件陷入死循环或异常状态时，看门狗会触发系统复位：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// 独立看门狗（IWDG）：独立时钟，不受系统故障影响&#10;IWDG_HandleTypeDef hiwdg;&#10;hiwdg.Instance = IWDG;&#10;hiwdg.Init.Prescaler = IWDG_PRESCALER_64;&#10;hiwdg.Init.Reload = 4095;  // 超时时间 ≈ 4095 × 64 / 32000 ≈ 8.2s&#10;HAL_IWDG_Init(&amp;hiwdg);&#10;&#10;while (1) {&#10;    main_task();&#10;    HAL_IWDG_Refresh(&amp;hiwdg);  // 喂狗&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 独立看门狗（IWDG）：独立时钟，不受系统故障影响</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">IWDG_HandleTypeDef hiwdg;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hiwdg.Instance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> IWDG;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hiwdg.Init.Prescaler </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> IWDG_PRESCALER_64;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hiwdg.Init.Reload </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4095</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 超时时间 ≈ 4095 × 64 / 32000 ≈ 8.2s</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">HAL_IWDG_Init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">hiwdg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    main_task</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_IWDG_Refresh</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hiwdg);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 喂狗</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>看门狗类型</th>\n<th>时钟源</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>IWDG 独立看门狗</td>\n<td>LSI 独立时钟</td>\n<td>系统故障仍工作</td>\n<td>最后防线</td>\n</tr>\n<tr>\n<td>WWDG 窗口看门狗</td>\n<td>APB1 时钟</td>\n<td>必须在时间窗口内喂狗</td>\n<td>精确时序监控</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>中断通过 NVIC 实现优先级仲裁和嵌套，Cortex-M 的中断延迟仅 12 个时钟周期</li>\n<li>优先级分为抢占优先级和子优先级，只有抢占优先级不同才能嵌套</li>\n<li>定时器支持基本计数、PWM 输出、输入捕获、编码器模式等多种工作模式</li>\n<li>ISR 设计原则：尽量短、不阻塞、共享变量用 volatile、复杂处理推迟到主循环</li>\n<li>PWM 是嵌入式最常用的输出方式，输入捕获用于测量外部信号特征</li>\n<li>看门狗定时器是系统可靠性的最后保障，IWDG 独立于系统时钟更可靠</li>\n</ul>\n","headings":[{"level":1,"text":"中断与定时器","id":"中断与定时器"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"中断优先级与嵌套","id":"中断优先级与嵌套"},{"level":2,"text":"定时器工作模式","id":"定时器工作模式"},{"level":2,"text":"ISR 设计最佳实践","id":"isr-设计最佳实践"},{"level":2,"text":"看门狗定时器","id":"看门狗定时器"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"内存与寄存器管理","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/embedded-fundamentals/memory-and-register"},"next":{"title":"RTOS 基础原理","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/rtos-and-scheduling/rtos-fundamentals"}}