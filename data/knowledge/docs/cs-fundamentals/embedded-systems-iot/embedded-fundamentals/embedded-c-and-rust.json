</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 设置多位字段（如 GPIO 模式，每个引脚占 2 位）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">GPIOA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">MODER </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ~</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">0x</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">GPIOA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">MODER </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (mode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span></code></pre></div><h3 id=\"中断服务例程\">中断服务例程</h3><div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"volatile uint32_t tick_count = 0;&#10;&#10;void SysTick_Handler(void) {&#10;    tick_count++;&#10;}&#10;&#10;void USART1_IRQHandler(void) {&#10;    if (USART1-&gt;SR &amp; USART_SR_RXNE) {&#10;        uint8_t data = USART1-&gt;DR;&#10;        ring_buffer_push(&amp;rx_buf, data);&#10;    }&#10;}&#10;&#10;// ISR 规则：&#10;// 1. 尽量短——只做标志设置或数据搬运&#10;// 2. 不调用阻塞函数（malloc, printf）&#10;// 3. 共享变量必须 volatile&#10;// 4. 多字节共享变量需要临界区保护\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">volatile</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> uint32_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tick_count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SysTick_Handler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    tick_count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> USART1_IRQHandler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (USART1->SR </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> USART_SR_RXNE) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        uint8_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> USART1->DR;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        ring_buffer_push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">rx_buf, data);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ISR 规则：</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1. 尽量短——只做标志设置或数据搬运</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 2. 不调用阻塞函数（malloc, printf）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 3. 共享变量必须 volatile</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 4. 多字节共享变量需要临界区保护</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>嵌入式 C 陷阱</th>\n<th>原因</th>\n<th>对策</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>忘记 volatile</td>\n<td>编译器优化掉寄存器读写</td>\n<td>外设指针/共享变量必须 volatile</td>\n</tr>\n<tr>\n<td>栈溢出</td>\n<td>ISR 嵌套消耗栈空间</td>\n<td>静态栈分析、限制嵌套层数</td>\n</tr>\n<tr>\n<td>未对齐访问</td>\n<td>Cortex-M0 不支持</td>\n<td>使用 __packed 或手动对齐</td>\n</tr>\n<tr>\n<td>整数溢出</td>\n<td>无运行时检查</td>\n<td>静态分析工具（Polyspace, PC-lint）</td>\n</tr>\n<tr>\n<td>悬垂指针</td>\n<td>手动内存管理</td>\n<td>减少动态分配，使用静态池</td>\n</tr>\n</tbody></table>\n<h2 id=\"嵌入式-rust-编程模式\">嵌入式 Rust 编程模式</h2><h3 id=\"no_std-环境\">no_std 环境</h3><p>嵌入式 Rust 使用 <code>#![no_std]</code> 放弃标准库，只保留核心库（core）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"#![no_std]&#10;#![no_main]&#10;&#10;use cortex_m_rt::entry;&#10;use panic_halt as _;&#10;use stm32f4xx_hal::{pac, prelude::*};&#10;&#10;#[entry]&#10;fn main() -&gt; ! {&#10;    let dp = pac::Peripherals::take().unwrap();&#10;    let rcc = dp.RCC.constrain();&#10;    let clocks = rcc.cfgr.sysclk(84.MHz()).freeze();&#10;&#10;    let gpioa = dp.GPIOA.split();&#10;    let mut led = gpioa.pa5.into_push_pull_output();&#10;    let mut delay = dp.TIM2.delay_ms(&amp;clocks);&#10;&#10;    loop {&#10;        led.toggle();&#10;        delay.delay_ms(500u32);&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>#![no_std]</span></span>\n<span class=\"line\"><span>#![no_main]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>use cortex_m_rt::entry;</span></span>\n<span class=\"line\"><span>use panic_halt as _;</span></span>\n<span class=\"line\"><span>use stm32f4xx_hal::{pac, prelude::*};</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[entry]</span></span>\n<span class=\"line\"><span>fn main() -> ! {</span></span>\n<span class=\"line\"><span>    let dp = pac::Peripherals::take().unwrap();</span></span>\n<span class=\"line\"><span>    let rcc = dp.RCC.constrain();</span></span>\n<span class=\"line\"><span>    let clocks = rcc.cfgr.sysclk(84.MHz()).freeze();</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    let gpioa = dp.GPIOA.split();</span></span>\n<span class=\"line\"><span>    let mut led = gpioa.pa5.into_push_pull_output();</span></span>\n<span class=\"line\"><span>    let mut delay = dp.TIM2.delay_ms(&#x26;clocks);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    loop {</span></span>\n<span class=\"line\"><span>        led.toggle();</span></span>\n<span class=\"line\"><span>        delay.delay_ms(500u32);</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h3 id=\"类型安全的外设访问\">类型安全的外设访问</h3><p>Rust 的嵌入式 HAL（Hardware Abstraction Layer）通过类型系统在编译期强制正确的引脚配置：</p>\n<div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"use stm32f4xx_hal::gpio::{Output, PushPull, Pin};&#10;&#10;fn blink(led: &amp;mut Pin&lt;&#39;A&#39;, 5, Output&lt;PushPull&gt;&gt;) {&#10;    led.set_high();&#10;}&#10;&#10;// 编译错误：不能对输入引脚调用 set_high&#10;// fn wrong(pin: &amp;mut Pin&lt;&#39;A&#39;, 5, Input&lt;Floating&gt;&gt;) {&#10;//     pin.set_high();  // 类型系统阻止&#10;// }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>use stm32f4xx_hal::gpio::{Output, PushPull, Pin};</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>fn blink(led: &#x26;mut Pin&#x3C;'A', 5, Output&#x3C;PushPull>>) {</span></span>\n<span class=\"line\"><span>    led.set_high();</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 编译错误：不能对输入引脚调用 set_high</span></span>\n<span class=\"line\"><span>// fn wrong(pin: &#x26;mut Pin&#x3C;'A', 5, Input&#x3C;Floating>>) {</span></span>\n<span class=\"line\"><span>//     pin.set_high();  // 类型系统阻止</span></span>\n<span class=\"line\"><span>// }</span></span></code></pre></div><h3 id=\"embedded-hal-trait-抽象\">embedded-hal trait 抽象</h3><div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"use embedded_hal::digital::OutputPin;&#10;use embedded_hal::delay::DelayNs;&#10;&#10;fn blink_generic&lt;P: OutputPin, D: DelayNs&gt;(&#10;    led: &amp;mut P,&#10;    delay: &amp;mut D,&#10;    times: u32,&#10;) {&#10;    for _ in 0..times {&#10;        led.set_high().ok();&#10;        delay.delay_ms(200);&#10;        led.set_low().ok();&#10;        delay.delay_ms(200);&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>use embedded_hal::digital::OutputPin;</span></span>\n<span class=\"line\"><span>use embedded_hal::delay::DelayNs;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>fn blink_generic&#x3C;P: OutputPin, D: DelayNs>(</span></span>\n<span class=\"line\"><span>    led: &#x26;mut P,</span></span>\n<span class=\"line\"><span>    delay: &#x26;mut D,</span></span>\n<span class=\"line\"><span>    times: u32,</span></span>\n<span class=\"line\"><span>) {</span></span>\n<span class=\"line\"><span>    for _ in 0..times {</span></span>\n<span class=\"line\"><span>        led.set_high().ok();</span></span>\n<span class=\"line\"><span>        delay.delay_ms(200);</span></span>\n<span class=\"line\"><span>        led.set_low().ok();</span></span>\n<span class=\"line\"><span>        delay.delay_ms(200);</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>embedded-hal trait</th>\n<th>功能</th>\n<th>C 等价操作</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>OutputPin</td>\n<td>GPIO 输出</td>\n<td>GPIO_WritePin</td>\n</tr>\n<tr>\n<td>InputPin</td>\n<td>GPIO 输入</td>\n<td>GPIO_ReadPin</td>\n</tr>\n<tr>\n<td>SpiBus</td>\n<td>SPI 总线</td>\n<td>HAL_SPI_Transmit</td>\n</tr>\n<tr>\n<td>I2c</td>\n<td>I2C 通信</td>\n<td>HAL_I2C_Mem_Read</td>\n</tr>\n<tr>\n<td>DelayNs</td>\n<td>延时</td>\n<td>HAL_Delay</td>\n</tr>\n<tr>\n<td>Pwm</td>\n<td>PWM 输出</td>\n<td>TIM_PWM_Start</td>\n</tr>\n</tbody></table>\n<h2 id=\"rust-嵌入式安全特性\">Rust 嵌入式安全特性</h2><p>Rust 的所有权系统在嵌入式场景中提供了独特的安全保证：</p>\n<div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"// 外设单例：编译器保证外设只被获取一次&#10;let dp = pac::Peripherals::take().unwrap();  // 第二次调用返回 None&#10;&#10;// 中断安全的共享状态&#10;use core::cell::RefCell;&#10;use cortex_m::interrupt::{self, Mutex};&#10;&#10;static SHARED: Mutex&lt;RefCell&lt;Option&lt;Serial&lt;USART1&gt;&gt;&gt;&gt; =&#10;    Mutex::new(RefCell::new(None));&#10;&#10;#[interrupt]&#10;fn USART1() {&#10;    interrupt::free(|cs| {&#10;        if let Some(serial) = SHARED.borrow(cs).borrow_mut().as_mut() {&#10;            if let Ok(byte) = serial.read() {&#10;                serial.write(byte).ok();&#10;            }&#10;        }&#10;    });&#10;}&#10;&#10;// DMA 安全：只有实现了 ReadBuffer/WriteBuffer 的类型才能用于 DMA&#10;// 编译器保证 DMA 传输期间缓冲区不被移动或释放\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// 外设单例：编译器保证外设只被获取一次</span></span>\n<span class=\"line\"><span>let dp = pac::Peripherals::take().unwrap();  // 第二次调用返回 None</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 中断安全的共享状态</span></span>\n<span class=\"line\"><span>use core::cell::RefCell;</span></span>\n<span class=\"line\"><span>use cortex_m::interrupt::{self, Mutex};</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>static SHARED: Mutex&#x3C;RefCell&#x3C;Option&#x3C;Serial&#x3C;USART1>>>> =</span></span>\n<span class=\"line\"><span>    Mutex::new(RefCell::new(None));</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[interrupt]</span></span>\n<span class=\"line\"><span>fn USART1() {</span></span>\n<span class=\"line\"><span>    interrupt::free(|cs| {</span></span>\n<span class=\"line\"><span>        if let Some(serial) = SHARED.borrow(cs).borrow_mut().as_mut() {</span></span>\n<span class=\"line\"><span>            if let Ok(byte) = serial.read() {</span></span>\n<span class=\"line\"><span>                serial.write(byte).ok();</span></span>\n<span class=\"line\"><span>            }</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>    });</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// DMA 安全：只有实现了 ReadBuffer/WriteBuffer 的类型才能用于 DMA</span></span>\n<span class=\"line\"><span>// 编译器保证 DMA 传输期间缓冲区不被移动或释放</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>安全特性</th>\n<th>C 做法</th>\n<th>Rust 做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>外设独占</td>\n<td>文档约定</td>\n<td>单例 + 所有权</td>\n</tr>\n<tr>\n<td>ISR 共享数据</td>\n<td>volatile + 手动临界区</td>\n<td>Mutex + interrupt::free</td>\n</tr>\n<tr>\n<td>DMA 缓冲区</td>\n<td>手动管理生命周期</td>\n<td>类型系统保证</td>\n</tr>\n<tr>\n<td>并发访问</td>\n<td>全靠纪律</td>\n<td>Send/Sync 编译检查</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具链与生态对比\">工具链与生态对比</h2><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# C 工具链（ARM GCC）&#10;arm-none-eabi-gcc -mcpu=cortex-m4 -mthumb -Os -o main.elf main.c&#10;arm-none-eabi-objcopy -O binary main.elf main.bin&#10;st-flash write main.bin 0x08000000&#10;&#10;# Rust 工具链（probe-rs）&#10;cargo build --target thumbv7em-none-eabihf --release&#10;probe-rs run --chip STM32F411CE target/thumbv7em-none-eabihf/release/app\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># C 工具链（ARM GCC）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">arm-none-eabi-gcc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -mcpu=cortex-m4</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -mthumb</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -Os</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -o</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main.elf</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main.c</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">arm-none-eabi-objcopy</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -O</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> binary</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main.elf</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main.bin</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">st-flash</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> write</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main.bin</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0x08000000</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Rust 工具链（probe-rs）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cargo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> build</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --target</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> thumbv7em-none-eabihf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --release</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">probe-rs</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --chip</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> STM32F411CE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> target/thumbv7em-none-eabihf/release/app</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>C 生态</th>\n<th>Rust 生态</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>编译器</td>\n<td>arm-none-eabi-gcc</td>\n<td>rustc (LLVM)</td>\n</tr>\n<tr>\n<td>构建系统</td>\n<td>Make/CMake</td>\n<td>Cargo</td>\n</tr>\n<tr>\n<td>调试器</td>\n<td>OpenOCD + GDB</td>\n<td>probe-rs / OpenOCD + GDB</td>\n</tr>\n<tr>\n<td>包管理</td>\n<td>无标准（手动管理）</td>\n<td>crates.io</td>\n</tr>\n<tr>\n<td>静态分析</td>\n<td>PC-lint, Polyspace</td>\n<td>clippy + miri</td>\n</tr>\n<tr>\n<td>HAL 框架</td>\n<td>STM32 HAL / CMSIS</td>\n<td>stm32xx-hal / embassy</td>\n</tr>\n<tr>\n<td>RTOS</td>\n<td>FreeRTOS, Zephyr</td>\n<td>Embassy (async), RTIC</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>嵌入式 C 通过 volatile 指针和内存映射直接操作硬件，是当前最成熟的嵌入式开发语言</li>\n<li>嵌入式 Rust 通过 <code>#![no_std]</code> 进入裸机模式，所有权系统在编译期消除内存安全和并发问题</li>\n<li>embedded-hal trait 提供了硬件无关的外设抽象，使驱动代码可跨芯片复用</li>\n<li>Rust 的类型系统将引脚状态（输入/输出）编码为类型，编译期阻止错误配置</li>\n<li>C 生态极度成熟，Rust 生态快速增长（Embassy 异步框架是亮点）</li>\n<li>新项目如果团队具备 Rust 经验，嵌入式 Rust 在安全性和工程效率上具有明显优势</li>\n</ul>\n","headings":[{"level":1,"text":"嵌入式 C 与 Rust 开发","id":"嵌入式-c-与-rust-开发"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"嵌入式 C 编程模式","id":"嵌入式-c-编程模式"},{"level":3,"text":"寄存器抽象层","id":"寄存器抽象层"},{"level":3,"text":"位操作与位带","id":"位操作与位带"},{"level":3,"text":"中断服务例程","id":"中断服务例程"},{"level":2,"text":"嵌入式 Rust 编程模式","id":"嵌入式-rust-编程模式"},{"level":3,"text":"no_std 环境","id":"no_std-环境"},{"level":3,"text":"类型安全的外设访问","id":"类型安全的外设访问"},{"level":3,"text":"embedded-hal trait 抽象","id":"embedded-hal-trait-抽象"},{"level":2,"text":"Rust 嵌入式安全特性","id":"rust-嵌入式安全特性"},{"level":2,"text":"工具链与生态对比","id":"工具链与生态对比"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"微控制器体系结构","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/embedded-fundamentals/microcontroller-architecture"},"next":{"title":"内存与寄存器管理","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/embedded-fundamentals/memory-and-register"}}