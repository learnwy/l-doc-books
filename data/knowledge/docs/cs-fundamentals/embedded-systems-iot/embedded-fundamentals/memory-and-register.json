or:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 方案2：TLSF（Two-Level Segregated Fit）分配器 */</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// O(1) 复杂度的分配和释放</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 适合实时系统，碎片化可控</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 常用于 RTOS 的堆管理</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>分配策略</th>\n<th>碎片化</th>\n<th>实时性</th>\n<th>复杂度</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>静态分配</td>\n<td>无</td>\n<td>确定性</td>\n<td>O(1)</td>\n<td>固定大小的对象</td>\n</tr>\n<tr>\n<td>内存池</td>\n<td>无</td>\n<td>确定性</td>\n<td>O(n)</td>\n<td>同类型对象频繁分配</td>\n</tr>\n<tr>\n<td>TLSF</td>\n<td>极低</td>\n<td>确定性</td>\n<td>O(1)</td>\n<td>RTOS 堆</td>\n</tr>\n<tr>\n<td>First-Fit</td>\n<td>高</td>\n<td>不确定</td>\n<td>O(n)</td>\n<td>不推荐</td>\n</tr>\n<tr>\n<td>dlmalloc</td>\n<td>中</td>\n<td>不确定</td>\n<td>摊销 O(1)</td>\n<td>非实时嵌入式 Linux</td>\n</tr>\n</tbody></table>\n<h2 id=\"dma-控制器\">DMA 控制器</h2><p>DMA（Direct Memory Access）允许外设在不经过 CPU 的情况下直接与内存交换数据，释放 CPU 处理能力：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"/* DMA 传输：ADC → SRAM（循环模式）*/&#10;uint16_t adc_buffer[256];&#10;&#10;DMA_HandleTypeDef hdma_adc;&#10;hdma_adc.Instance = DMA2_Stream0;&#10;hdma_adc.Init.Channel = DMA_CHANNEL_0;&#10;hdma_adc.Init.Direction = DMA_PERIPH_TO_MEMORY;&#10;hdma_adc.Init.PeriphInc = DMA_PINC_DISABLE;&#10;hdma_adc.Init.MemInc = DMA_MINC_ENABLE;&#10;hdma_adc.Init.PeriphDataAlignment = DMA_PDATAALIGN_HALFWORD;&#10;hdma_adc.Init.MemDataAlignment = DMA_MDATAALIGN_HALFWORD;&#10;hdma_adc.Init.Mode = DMA_CIRCULAR;&#10;hdma_adc.Init.Priority = DMA_PRIORITY_HIGH;&#10;HAL_DMA_Init(&amp;hdma_adc);&#10;&#10;HAL_ADC_Start_DMA(&amp;hadc1, (uint32_t *)adc_buffer, 256);&#10;&#10;/* 双缓冲 DMA：前台处理 buffer A，后台 DMA 填充 buffer B */&#10;void HAL_ADC_ConvHalfCpltCallback(ADC_HandleTypeDef *hadc) {&#10;    process_data(adc_buffer, 128);&#10;}&#10;void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc) {&#10;    process_data(adc_buffer + 128, 128);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* DMA 传输：ADC → SRAM（循环模式）*/</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">uint16_t</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> adc_buffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">256</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">DMA_HandleTypeDef hdma_adc;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Instance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA2_Stream0;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.Channel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_CHANNEL_0;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.Direction </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_PERIPH_TO_MEMORY;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.PeriphInc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_PINC_DISABLE;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.MemInc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_MINC_ENABLE;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.PeriphDataAlignment </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_PDATAALIGN_HALFWORD;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.MemDataAlignment </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_MDATAALIGN_HALFWORD;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.Mode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_CIRCULAR;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hdma_adc.Init.Priority </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DMA_PRIORITY_HIGH;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">HAL_DMA_Init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">hdma_adc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">HAL_ADC_Start_DMA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">hadc1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">uint32_t</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">adc_buffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">256</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 双缓冲 DMA：前台处理 buffer A，后台 DMA 填充 buffer B */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HAL_ADC_ConvHalfCpltCallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ADC_HandleTypeDef </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">hadc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    process_data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(adc_buffer, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">128</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HAL_ADC_ConvCpltCallback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ADC_HandleTypeDef </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">hadc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    process_data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(adc_buffer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 128</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">128</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[外设 ADC] --&gt;|DMA 请求| B[DMA 控制器]&#10;    B --&gt;|数据传输| C[SRAM Buffer]&#10;    B --&gt;|传输完成中断| D[CPU]&#10;    D --&gt;|处理数据| C\">graph LR\n    A[外设 ADC] --&gt;|DMA 请求| B[DMA 控制器]\n    B --&gt;|数据传输| C[SRAM Buffer]\n    B --&gt;|传输完成中断| D[CPU]\n    D --&gt;|处理数据| C</pre><table>\n<thead>\n<tr>\n<th>DMA 模式</th>\n<th>行为</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>普通模式</td>\n<td>传输指定数量后停止</td>\n<td>单次数据采集</td>\n</tr>\n<tr>\n<td>循环模式</td>\n<td>自动重新开始</td>\n<td>连续采集（ADC、音频）</td>\n</tr>\n<tr>\n<td>双缓冲</td>\n<td>两个缓冲区交替使用</td>\n<td>实时流处理</td>\n</tr>\n<tr>\n<td>内存到内存</td>\n<td>SRAM 间数据搬运</td>\n<td>快速内存拷贝</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>嵌入式内存布局分为 Flash（.text/.rodata）和 SRAM（.data/.bss/Stack/Heap），由链接脚本精确控制</li>\n<li>启动代码负责从 Flash 复制 .data 到 SRAM 并清零 .bss，在 main() 之前完成</li>\n<li>栈溢出是嵌入式最危险的问题，通过静态分析、填充模式检测和 MPU 硬件保护三级防御</li>\n<li>嵌入式动态内存优先使用静态内存池，需要通用分配时选择 TLSF 等实时友好的分配器</li>\n<li>DMA 控制器实现外设与内存间的零 CPU 数据传输，双缓冲模式支持实时流处理</li>\n<li>内存资源极度受限是嵌入式开发的核心约束，一切设计决策都围绕这一约束展开</li>\n</ul>\n","headings":[{"level":1,"text":"内存与寄存器管理","id":"内存与寄存器管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"链接脚本与内存映射","id":"链接脚本与内存映射"},{"level":2,"text":"栈管理与溢出检测","id":"栈管理与溢出检测"},{"level":2,"text":"嵌入式动态内存管理","id":"嵌入式动态内存管理"},{"level":2,"text":"DMA 控制器","id":"dma-控制器"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"嵌入式 C 与 Rust 开发","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/embedded-fundamentals/embedded-c-and-rust"},"next":{"title":"中断与定时器","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/embedded-fundamentals/interrupt-and-timer"}}