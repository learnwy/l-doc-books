&#10;typedef struct {&#10;    uint8_t data[BLOCK_SIZE];&#10;    uint8_t used;&#10;} MemBlock;&#10;&#10;static MemBlock pool[POOL_SIZE];&#10;&#10;void *pool_alloc(void) {&#10;    for (int i = 0; i &lt; POOL_SIZE; i++) {&#10;        if (!pool[i].used) {&#10;            pool[i].used = 1;&#10;            return pool[i].data;&#10;        }&#10;    }&#10;    return NULL;&#10;}&#10;&#10;void pool_free(void *ptr) {&#10;    MemBlock *blk = (MemBlock *)((uint8_t *)ptr - offsetof(MemBlock, data));&#10;    blk-&gt;used = 0;&#10;}&#10;&#10;/* 方案2：TLSF（Two-Level Segregated Fit）分配器 */&#10;// O(1) 复杂度的分配和释放&#10;// 适合实时系统，碎片化可控&#10;// 常用于 RTOS 的堆管理\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 方案1：静态内存池（推荐） */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">typedef</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    uint8_t</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[BLOCK_SIZE];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    uint8_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> used;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} MemBlock;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">static</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> MemBlock </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[POOL_SIZE];</span></span>\n<span class=\"line\"></span>\n<span class