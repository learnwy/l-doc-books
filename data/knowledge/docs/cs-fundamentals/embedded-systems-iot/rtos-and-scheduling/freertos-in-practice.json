an></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">char</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> statsBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">512</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">vTaskGetRunTimeStats</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(statsBuffer);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 输出示例：</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Task          Abs Time    % Time</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Sensor        15230       12%</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Process       45600       36%</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Comms         8900        7%</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// IDLE          55270       45%</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 栈溢出检测回调</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> vApplicationStackOverflowHook</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">TaskHandle_t</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> xTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">char</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pcTaskName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    printf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Stack overflow in task: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%s\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, pcTaskName);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 任务状态查询</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">UBaseType_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> watermark </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> uxTaskGetStackHighWaterMark</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sensorTask);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// watermark 越小说明栈越接近溢出</span></span></code></pre></div><p><strong>常见调试工具</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>工具</th>\n<th>功能</th>\n<th>集成方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Tracealyzer</td>\n<td>可视化任务调度和同步</td>\n<td>Trace Recorder 库</td>\n</tr>\n<tr>\n<td>SystemView</td>\n<td>SEGGER 可视化工具</td>\n<td>SEGGER RTT</td>\n</tr>\n<tr>\n<td>printf 调试</td>\n<td>串口日志输出</td>\n<td>UART + SWO</td>\n</tr>\n<tr>\n<td>GDB + OpenOCD</td>\n<td>断点调试</td>\n<td>JTAG/SWD</td>\n</tr>\n<tr>\n<td>运行时统计</td>\n<td>CPU 占用率分析</td>\n<td>configGENERATE_RUN_TIME_STATS</td>\n</tr>\n</tbody></table>\n<h2 id=\"tickless-低功耗模式\">Tickless 低功耗模式</h2><p>FreeRTOS 的 Tickless Idle 模式在空闲时停止 SysTick 并进入低功耗状态，显著降低系统功耗：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"#define configUSE_TICKLESS_IDLE  1&#10;&#10;void vPortSuppressTicksAndSleep(TickType_t xExpectedIdleTime) {&#10;    uint32_t sleepTicks = xExpectedIdleTime;&#10;    HAL_SuspendTick();&#10;    configureRTCWakeup(sleepTicks);&#10;    HAL_PWR_EnterSLEEPMode(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);&#10;    HAL_ResumeTick();&#10;    vTaskStepTick(actualSleepTicks);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> configUSE_TICKLESS_IDLE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  1</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> vPortSuppressTicksAndSleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">TickType_t</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> xExpectedIdleTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    uint32_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sleepTicks </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> xExpectedIdleTime;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_SuspendTick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    configureRTCWakeup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sleepTicks);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_PWR_EnterSLEEPMode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_ResumeTick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    vTaskStepTick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(actualSleepTicks);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>低功耗模式</th>\n<th>功耗</th>\n<th>唤醒时间</th>\n<th>保持内容</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Sleep</td>\n<td>数 mA</td>\n<td>微秒</td>\n<td>CPU 停止，外设运行</td>\n</tr>\n<tr>\n<td>Stop</td>\n<td>数十 μA</td>\n<td>数十 μs</td>\n<td>SRAM 保持，多数外设停止</td>\n</tr>\n<tr>\n<td>Standby</td>\n<td>数 μA</td>\n<td>毫秒</td>\n<td>仅 RTC + 备份寄存器保持</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>FreeRTOS 以约 9000 行核心代码提供完整的多任务调度能力，适用于从 8 位到 64 位的处理器</li>\n<li>FreeRTOSConfig.h 是系统行为的控制中心，合理配置栈大小、优先级数量和堆大小至关重要</li>\n<li>生产者-消费者（队列）、事件驱动（信号量）和资源保护（互斥量）是三种核心任务设计模式</li>\n<li>Tracealyzer 和 SystemView 是可视化调试 RTOS 调度行为的利器</li>\n<li>Tickless Idle 通过在空闲时停止 SysTick 进入低功耗模式，显著延长电池供电设备的续航</li>\n<li>栈溢出检测（configCHECK_FOR_STACK_OVERFLOW）和运行时统计是生产系统的必备配置</li>\n</ul>\n","headings":[{"level":1,"text":"FreeRTOS 实战","id":"freertos-实战"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"项目配置与移植","id":"项目配置与移植"},{"level":2,"text":"任务设计模式","id":"任务设计模式"},{"level":3,"text":"生产者-消费者模式","id":"生产者-消费者模式"},{"level":3,"text":"软件定时器","id":"软件定时器"},{"level":2,"text":"调试与性能分析","id":"调试与性能分析"},{"level":2,"text":"Tickless 低功耗模式","id":"tickless-低功耗模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"RTOS 基础原理","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/rtos-and-scheduling/rtos-fundamentals"},"next":{"title":"低功耗设计","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/rtos-and-scheduling/low-power-design"}}