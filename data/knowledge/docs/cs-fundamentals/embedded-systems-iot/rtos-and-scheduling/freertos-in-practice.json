&#10;#define vPortSVCHandler       SVC_Handler\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1. SysTick 配置为 FreeRTOS 时基</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// FreeRTOS 使用 SysTick_Handler 驱动调度器</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 2. 中断优先级设置</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// FreeRTOS 要求 PendSV 和 SysTick 使用最低抢占优先级</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> configLIBRARY_LOWEST_INTERRUPT_PRIORITY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      15</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  5</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 3. 中断处理函数重定向</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xPortPendSVHandler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    PendSV_Handler</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xPortSysTickHandler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">   SysTick_Handler</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B39