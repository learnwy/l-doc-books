C5;--shiki-dark:#79B8FF\">%d</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%06d</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                temp.val1, temp.val2, hum.val1, hum.val2);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        k_sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">K_SECONDS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">K_THREAD_DEFINE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sensor_tid, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1024</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, sensor_thread, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>Zephyr API</th>\n<th>FreeRTOS 等价</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>k_thread_create</td>\n<td>xTaskCreate</td>\n<td>线程创建</td>\n</tr>\n<tr>\n<td>k_sleep</td>\n<td>vTaskDelay</td>\n<td>延时</td>\n</tr>\n<tr>\n<td>k_sem</td>\n<td>xSemaphore</td>\n<td>信号量</td>\n</tr>\n<tr>\n<td>k_mutex</td>\n<td>xSemaphoreCreateMutex</td>\n<td>互斥量</td>\n</tr>\n<tr>\n<td>k_msgq</td>\n<td>xQueue</td>\n<td>消息队列</td>\n</tr>\n<tr>\n<td>k_work</td>\n<td>—</td>\n<td>工作队列（延迟处理）</td>\n</tr>\n<tr>\n<td>k_timer</td>\n<td>xTimerCreate</td>\n<td>定时器</td>\n</tr>\n</tbody></table>\n<h2 id=\"embassy-rust-异步嵌入式框架\">Embassy：Rust 异步嵌入式框架</h2><p>Embassy 是 Rust 嵌入式生态中的异步运行时框架，将 async/await 语法引入裸机编程，无需传统 RTOS 的上下文切换开销：</p>\n<div class=\"code-block-wrapper\" data-lang=\"rust\" data-code=\"#![no_std]&#10;#![no_main]&#10;&#10;use embassy_executor::Spawner;&#10;use embassy_stm32::gpio::{Level, Output, Speed};&#10;use embassy_time::{Duration, Timer};&#10;use defmt::info;&#10;&#10;#[embassy_executor::main]&#10;async fn main(spawner: Spawner) {&#10;    let p = embassy_stm32::init(Default::default());&#10;    spawner.spawn(blink(p.PA5.into())).unwrap();&#10;    spawner.spawn(sensor_read()).unwrap();&#10;}&#10;&#10;#[embassy_executor::task]&#10;async fn blink(mut led: Output&lt;&#39;static&gt;) {&#10;    loop {&#10;        led.set_high();&#10;        Timer::after(Duration::from_millis(500)).await;&#10;        led.set_low();&#10;        Timer::after(Duration::from_millis(500)).await;&#10;    }&#10;}&#10;&#10;#[embassy_executor::task]&#10;async fn sensor_read() {&#10;    loop {&#10;        let temp = read_temperature().await;&#10;        info!(&quot;Temperature: {}&quot;, temp);&#10;        Timer::after(Duration::from_secs(5)).await;&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>#![no_std]</span></span>\n<span class=\"line\"><span>#![no_main]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>use embassy_executor::Spawner;</span></span>\n<span class=\"line\"><span>use embassy_stm32::gpio::{Level, Output, Speed};</span></span>\n<span class=\"line\"><span>use embassy_time::{Duration, Timer};</span></span>\n<span class=\"line\"><span>use defmt::info;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[embassy_executor::main]</span></span>\n<span class=\"line\"><span>async fn main(spawner: Spawner) {</span></span>\n<span class=\"line\"><span>    let p = embassy_stm32::init(Default::default());</span></span>\n<span class=\"line\"><span>    spawner.spawn(blink(p.PA5.into())).unwrap();</span></span>\n<span class=\"line\"><span>    spawner.spawn(sensor_read()).unwrap();</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[embassy_executor::task]</span></span>\n<span class=\"line\"><span>async fn blink(mut led: Output&#x3C;'static>) {</span></span>\n<span class=\"line\"><span>    loop {</span></span>\n<span class=\"line\"><span>        led.set_high();</span></span>\n<span class=\"line\"><span>        Timer::after(Duration::from_millis(500)).await;</span></span>\n<span class=\"line\"><span>        led.set_low();</span></span>\n<span class=\"line\"><span>        Timer::after(Duration::from_millis(500)).await;</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>#[embassy_executor::task]</span></span>\n<span class=\"line\"><span>async fn sensor_read() {</span></span>\n<span class=\"line\"><span>    loop {</span></span>\n<span class=\"line\"><span>        let temp = read_temperature().await;</span></span>\n<span class=\"line\"><span>        info!(\"Temperature: {}\", temp);</span></span>\n<span class=\"line\"><span>        Timer::after(Duration::from_secs(5)).await;</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>FreeRTOS</th>\n<th>Embassy</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>语言</td>\n<td>C</td>\n<td>Rust</td>\n</tr>\n<tr>\n<td>多任务方式</td>\n<td>线程 + 上下文切换</td>\n<td>async/await 协程</td>\n</tr>\n<tr>\n<td>栈内存</td>\n<td>每任务固定栈</td>\n<td>共享栈（编译期计算）</td>\n</tr>\n<tr>\n<td>内存安全</td>\n<td>手动</td>\n<td>编译器保证</td>\n</tr>\n<tr>\n<td>外设访问</td>\n<td>HAL 库</td>\n<td>类型安全 HAL</td>\n</tr>\n<tr>\n<td>生态成熟度</td>\n<td>极高</td>\n<td>快速增长</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Zephyr 是 Linux 基金会的开源 RTOS，提供 Device Tree 硬件描述和完整的网络/安全子系统</li>\n<li>Device Tree 描述硬件拓扑，Kconfig 选择软件功能——两者协同实现硬件无关的应用开发</li>\n<li>Zephyr 适合需要完整网络协议栈和安全认证的中大型嵌入式项目</li>\n<li>Embassy 将 Rust 的 async/await 引入嵌入式，协程模型无需线程上下文切换的内存开销</li>\n<li>选择 RTOS 时需权衡：FreeRTOS（最简、最广泛）、Zephyr（最完整）、Embassy（最安全、Rust 生态）</li>\n<li>现代嵌入式框架正在从&quot;裸机 + 简单 RTOS&quot;向&quot;完整平台 + 安全 + 网络&quot;演进</li>\n</ul>\n","headings":[{"level":1,"text":"Zephyr RTOS 与现代嵌入式框架","id":"zephyr-rtos-与现代嵌入式框架"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Device Tree 与 Kconfig","id":"device-tree-与-kconfig"},{"level":2,"text":"Zephyr 应用开发","id":"zephyr-应用开发"},{"level":2,"text":"Embassy：Rust 异步嵌入式框架","id":"embassy-rust-异步嵌入式框架"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"任务调度算法","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/rtos-and-scheduling/task-scheduling-algorithms"},"next":{"title":"MQTT 协议架构","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/iot-protocols/mqtt-protocol"}}