-dark:#E1E4E8\">CONFIG_SENSOR</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_BME280</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_BT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_BT_PERIPHERAL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_NETWORKING</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_NET_IPV4</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_MQTT_LIB</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_LOG</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">y</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CONFIG_LOG_DEFAULT_LEVEL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">3</span></span></code></pre></div><h2 id=\"zephyr-应用开发\">Zephyr 应用开发</h2><div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"#include &lt;zephyr/kernel.h&gt;&#10;#include &lt;zephyr/device.h&gt;&#10;#include &lt;zephyr/drivers/sensor.h&gt;&#10;#include &lt;zephyr/logging/log.h&gt;&#10;&#10;LOG_MODULE_REGISTER(main, LOG_LEVEL_INF);&#10;&#10;K_MSGQ_DEFINE(sensor_msgq, sizeof(struct sensor_value) * 2, 10, 4);&#10;&#10;void sensor_thread(void) {&#10;    const struct device *bme = DEVICE_DT_GET_ANY(bosch_bme280);&#10;    if (!device_is_ready(bme)) {&#10;        LOG_ERR(&quot;BME280 not ready&quot;);&#10;        return;&#10;    }&#10;&#10;    while (1) {&#10;        struct sensor_value temp, hum;&#10;        sensor_sample_fetch(bme);&#10;        sensor_channel_get(bme, SENSOR_CHAN_AMBIENT_TEMP, &amp;temp);&#10;        sensor_channel_get(bme, SENSOR_CHAN_HUMIDITY, &amp;hum);&#10;&#10;        struct sensor_value data[2] = {temp, hum};&#10;        k_msgq_put(&amp;sensor_msgq, data, K_MSEC(100));&#10;&#10;        LOG_INF(&quot;Temp: %d.%06d, Hum: %d.%06d&quot;,&#10;                temp.val1, temp.val2, hum.val1, hum.val2);&#10;        k_sleep(K_SECONDS(5));&#10;    }&#10;}&#10;&#10;K_THREAD_DEFINE(sensor_tid, 1024, sensor_thread, NULL, NULL, NULL, 5, 0, 0);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;zephyr/kernel.h></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;zephyr/device.h></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;zephyr/drivers/sensor.h></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span 