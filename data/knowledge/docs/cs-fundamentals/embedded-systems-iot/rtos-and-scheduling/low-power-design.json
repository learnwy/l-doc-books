ENCY_4);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setLowPower</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    RCC_ClkInitTypeDef clkInit </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    clkInit.ClockType </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RCC_CLOCKTYPE_SYSCLK;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    clkInit.SYSCLKSource </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RCC_SYSCLKSOURCE_MSI;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_RCC_ClockConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">clkInit, FLASH_LATENCY_0);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    HAL_RCCEx_MSIRangeConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(RCC_MSIRANGE_4);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 外设时钟门控：不用的外设关掉时钟</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">__HAL_RCC_USART2_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">__HAL_RCC_SPI1_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">__HAL_RCC_ADC_CLK_DISABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// GPIO 未使用引脚配置为模拟输入（最低漏电流）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">GPIO_InitStruct.Pin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GPIO_PIN_All;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">GPIO_InitStruct.Mode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GPIO_MODE_ANALOG;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">GPIO_InitStruct.Pull </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> GPIO_NOPULL;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">HAL_GPIO_Init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(GPIOB, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">GPIO_InitStruct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"无线通信功耗优化\">无线通信功耗优化</h2><p>无线通信是 IoT 设备最大的功耗消耗者。通过占空比控制和数据聚合，可以将通信功耗降低 95% 以上：</p>\n<div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// BLE 广播间隔优化&#10;// 广播间隔从 100ms → 1000ms，功耗降低约 10 倍&#10;// 连接间隔从 7.5ms → 4000ms，按需唤醒&#10;&#10;// 数据聚合策略&#10;#define BATCH_SIZE 10&#10;SensorData batch[BATCH_SIZE];&#10;uint8_t batchIndex = 0;&#10;&#10;void collectAndSend(void) {&#10;    batch[batchIndex++] = readSensor();&#10;    if (batchIndex &gt;= BATCH_SIZE) {&#10;        enableRadio();&#10;        sendBatch(batch, BATCH_SIZE);&#10;        disableRadio();&#10;        batchIndex = 0;&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// BLE 广播间隔优化</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 广播间隔从 100ms → 1000ms，功耗降低约 10 倍</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 连接间隔从 7.5ms → 4000ms，按需唤醒</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 数据聚合策略</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BATCH_SIZE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 10</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">SensorData </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">batch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[BATCH_SIZE];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">uint8_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> batchIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> collectAndSend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    batch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[batchIndex</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> readSensor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (batchIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> BATCH_SIZE) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        enableRadio</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        sendBatch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(batch, BATCH_SIZE);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        disableRadio</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        batchIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>优化策略</th>\n<th>原理</th>\n<th>节省比例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>增大广播/连接间隔</td>\n<td>减少无线收发次数</td>\n<td>50-90%</td>\n</tr>\n<tr>\n<td>数据聚合</td>\n<td>批量发送减少开机次数</td>\n<td>80-95%</td>\n</tr>\n<tr>\n<td>压缩传输</td>\n<td>减少每次传输时间</td>\n<td>20-50%</td>\n</tr>\n<tr>\n<td>协议优化</td>\n<td>减少握手和确认</td>\n<td>30-60%</td>\n</tr>\n<tr>\n<td>发射功率调节</td>\n<td>降低 TX 功率</td>\n<td>20-40%</td>\n</tr>\n</tbody></table>\n<h2 id=\"功耗预算与测量\">功耗预算与测量</h2><div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// 功耗预算计算示例（温湿度传感器节点）&#10;// 电池：CR2032 (225mAh)&#10;// 目标续航：3 年 = 26280 小时&#10;// 平均电流预算：225mAh / 26280h ≈ 8.6μA&#10;&#10;// 功耗分解：&#10;// 睡眠（99.9%时间）：0.5μA × 0.999 = 0.4995μA&#10;// 采集（每10分钟，50ms）：5mA × 0.000083 = 0.417μA&#10;// BLE 传输（每10分钟，100ms）：15mA × 0.000167 = 2.5μA&#10;// 合计：~3.4μA &lt; 8.6μA ✓\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 功耗预算计算示例（温湿度传感器节点）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 电池：CR2032 (225mAh)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 目标续航：3 年 = 26280 小时</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 平均电流预算：225mAh / 26280h ≈ 8.6μA</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 功耗分解：</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 睡眠（99.9%时间）：0.5μA × 0.999 = 0.4995μA</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 采集（每10分钟，50ms）：5mA × 0.000083 = 0.417μA</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// BLE 传输（每10分钟，100ms）：15mA × 0.000167 = 2.5μA</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 合计：~3.4μA &#x3C; 8.6μA ✓</span></span></code></pre></div><p><strong>测量工具</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>工具</th>\n<th>量程</th>\n<th>精度</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Nordic PPK2</td>\n<td>nA-1A</td>\n<td>nA 级</td>\n<td>BLE 设备功耗分析</td>\n</tr>\n<tr>\n<td>Joulescope</td>\n<td>μA-3A</td>\n<td>μA 级</td>\n<td>通用嵌入式功耗</td>\n</tr>\n<tr>\n<td>Keysight N6705C</td>\n<td>nA-50A</td>\n<td>nA 级</td>\n<td>专业级精密测量</td>\n</tr>\n<tr>\n<td>示波器 + 采样电阻</td>\n<td>mA 级</td>\n<td>mA 级</td>\n<td>快速估算</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>低功耗设计需要硬件选型、时钟管理、电源域控制和软件优化的系统性协同</li>\n<li>MCU 提供多级睡眠模式，Stop 模式在 μA 级功耗和 μs 级唤醒间取得平衡</li>\n<li>未使用的 GPIO 配置为模拟输入、关闭不用的外设时钟是基础的功耗优化手段</li>\n<li>无线通信是 IoT 设备最大功耗来源，通过增大间隔和数据聚合可节省 80-95%</li>\n<li>功耗预算从电池容量和目标续航反推平均电流限制，分解到各子系统验证可行性</li>\n<li>精确的功耗测量需要 nA 级分辨率的工具（PPK2、Joulescope）</li>\n</ul>\n","headings":[{"level":1,"text":"低功耗设计","id":"低功耗设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"MCU 低功耗模式","id":"mcu-低功耗模式"},{"level":2,"text":"时钟与外设管理","id":"时钟与外设管理"},{"level":2,"text":"无线通信功耗优化","id":"无线通信功耗优化"},{"level":2,"text":"功耗预算与测量","id":"功耗预算与测量"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"FreeRTOS 实战","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/rtos-and-scheduling/freertos-in-practice"},"next":{"title":"实时约束与时序分析","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/rtos-and-scheduling/real-time-constraints"}}