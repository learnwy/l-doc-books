span style=\"color:#D73A49;--shiki-dark:#F97583\">uint8_t</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">uint8_t</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    McpsReq_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> req;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    req.Type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> MCPS_CONFIRMED;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 确认帧</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    req.Req.Confirmed.fPort </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    req.Req.Confirmed.fBuffer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    req.Req.Confirmed.fBufferSize </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> len;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    req.Req.Confirmed.Datarate </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DR_3;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    LoRaMacMcpsRequest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">req);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>设备类型</th>\n<th>接收窗口</th>\n<th>下行延迟</th>\n<th>功耗</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Class A</td>\n<td>上行后开 2 个窗口</td>\n<td>秒级</td>\n<td>最低</td>\n<td>传感器上报</td>\n</tr>\n<tr>\n<td>Class B</td>\n<td>信标同步定时窗口</td>\n<td>可预测</td>\n<td>中</td>\n<td>定期下行控制</td>\n</tr>\n<tr>\n<td>Class C</td>\n<td>持续监听</td>\n<td>几乎实时</td>\n<td>最高</td>\n<td>电源供电执行器</td>\n</tr>\n</tbody></table>\n<h2 id=\"nb-iot-与-lora-选型\">NB-IoT 与 LoRa 选型</h2><p>NB-IoT 基于蜂窝网络基础设施，由运营商部署和维护，提供更高的可靠性和安全性；LoRa 允许用户自建网络，部署灵活且无月租费用：</p>\n<table>\n<thead>\n<tr>\n<th>选型因素</th>\n<th>选 LoRa</th>\n<th>选 NB-IoT</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>网络覆盖</td>\n<td>偏远/无蜂窝覆盖区域</td>\n<td>城市/蜂窝覆盖区域</td>\n</tr>\n<tr>\n<td>部署自主性</td>\n<td>需要自建专网</td>\n<td>可接受运营商依赖</td>\n</tr>\n<tr>\n<td>通信需求</td>\n<td>小数据量、低频上行</td>\n<td>较大数据量、双向通信</td>\n</tr>\n<tr>\n<td>功耗预算</td>\n<td>10 年电池寿命</td>\n<td>5-10 年电池寿命</td>\n</tr>\n<tr>\n<td>成本模型</td>\n<td>一次性网关投入</td>\n<td>持续 SIM 卡月租</td>\n</tr>\n<tr>\n<td>安全认证</td>\n<td>自管理</td>\n<td>运营商 SIM 认证</td>\n</tr>\n<tr>\n<td>QoS 保证</td>\n<td>无保证</td>\n<td>运营商 SLA</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>LoRa 使用 CSS 调制实现公里级通信，通过扩频因子 SF 在距离和速率之间权衡</li>\n<li>LoRaWAN 采用星型拓扑，三类设备（A/B/C）在功耗和下行延迟之间提供不同选择</li>\n<li>NB-IoT 基于蜂窝基础设施，提供更高可靠性和完整双向通信，但依赖运营商</li>\n<li>LPWAN 的核心设计取舍是用极低的带宽换取超远距离和超低功耗</li>\n<li>LoRa 适合自建网络、偏远地区和极低功耗场景；NB-IoT 适合城市部署和需要 QoS 保证的场景</li>\n<li>实际项目中常混合使用多种 LPWAN 技术，根据子场景特点分别选择</li>\n</ul>\n","headings":[{"level":1,"text":"LoRa 与低功耗广域网","id":"lora-与低功耗广域网"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"LoRa 物理层","id":"lora-物理层"},{"level":3,"text":"CSS 调制技术","id":"css-调制技术"},{"level":2,"text":"LoRaWAN 网络架构","id":"lorawan-网络架构"},{"level":3,"text":"星型拓扑","id":"星型拓扑"},{"level":3,"text":"设备分类","id":"设备分类"},{"level":2,"text":"NB-IoT 与 LoRa 选型","id":"nb-iot-与-lora-选型"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"蓝牙与 Zigbee 协议","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/iot-protocols-and-networking/bluetooth-and-zigbee"},"next":{"title":"边缘计算与云架构","url":"/l-doc-books/h/cs-fundamentals/embedded-systems-iot/iot-protocols-and-networking/edge-cloud-architecture"}}