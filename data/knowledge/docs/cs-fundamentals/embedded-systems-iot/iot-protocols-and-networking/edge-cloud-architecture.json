用</td>\n<td>.onnx</td>\n<td>跨框架兼容</td>\n</tr>\n<tr>\n<td>TensorRT</td>\n<td>NVIDIA GPU</td>\n<td>.engine</td>\n<td>GPU 加速最优</td>\n</tr>\n<tr>\n<td>OpenVINO</td>\n<td>Intel</td>\n<td>IR</td>\n<td>Intel 硬件优化</td>\n</tr>\n<tr>\n<td>TVM</td>\n<td>通用</td>\n<td>编译输出</td>\n<td>自动优化、MCU 支持</td>\n</tr>\n</tbody></table>\n<h2 id=\"iot-云平台架构\">IoT 云平台架构</h2><h3 id=\"数据流水线\">数据流水线</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[设备] --&gt;|MQTT| B[消息代理]&#10;    B --&gt; C[规则引擎]&#10;    C --&gt; D[时序数据库]&#10;    C --&gt; E[告警服务]&#10;    C --&gt; F[数据湖]&#10;    D --&gt; G[实时仪表盘]&#10;    F --&gt; H[批处理分析]&#10;    H --&gt; I[模型训练]&#10;    I --&gt;|OTA| J[边缘模型更新]\">graph LR\n    A[设备] --&gt;|MQTT| B[消息代理]\n    B --&gt; C[规则引擎]\n    C --&gt; D[时序数据库]\n    C --&gt; E[告警服务]\n    C --&gt; F[数据湖]\n    D --&gt; G[实时仪表盘]\n    F --&gt; H[批处理分析]\n    H --&gt; I[模型训练]\n    I --&gt;|OTA| J[边缘模型更新]</pre><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# 云端规则引擎示例&#10;class RuleEngine:&#10;    def __init__(self):&#10;        self.rules = []&#10;&#10;    def add_rule(self, condition, action):&#10;        self.rules.append({&quot;condition&quot;: condition, &quot;action&quot;: action})&#10;&#10;    def evaluate(self, event):&#10;        for rule in self.rules:&#10;            if rule[&quot;condition&quot;](event):&#10;                rule[&quot;action&quot;](event)&#10;&#10;engine = RuleEngine()&#10;engine.add_rule(&#10;    condition=lambda e: e.get(&quot;temperature&quot;, 0) &gt; 80,&#10;    action=lambda e: send_alert(f&quot;高温告警: 设备 {e[&#39;device_id&#39;]} 温度 {e[&#39;temperature&#39;]}°C&quot;)&#10;)&#10;engine.add_rule(&#10;    condition=lambda e: e.get(&quot;anomaly&quot;) is True,&#10;    action=lambda e: trigger_maintenance(e[&quot;device_id&quot;])&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span cl