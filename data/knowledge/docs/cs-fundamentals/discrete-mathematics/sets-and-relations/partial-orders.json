:#E1E4E8\">(v) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> queue</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vertices.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> inDegree.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (queue.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> u</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">shift</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(u);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> v</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> adj.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(u)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      inDegree.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v, inDegree.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (inDegree.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vertices.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>当拓扑排序返回 <code>null</code> 时，表示图中存在环——即依赖关系中存在循环依赖，这在工程中通常是错误。包管理器检测到循环依赖时会报错，构建系统遇到循环引用时会失败。</p>\n<p>注意拓扑排序通常不唯一。对同一个 DAG，可能存在多种合法的拓扑序。在并行执行中，互不可比的任务可以同时进行，这就是<strong>拓扑排序的并行化</strong>——Kahn 算法中每轮所有入度为 0 的节点都可以并行处理。</p>\n<p><strong>Dilworth 定理</strong>是偏序理论中的一个深刻结果：偏序集的最小链覆盖数等于最长反链的长度。直观理解：将偏序集分成若干完全可比的链（顺序执行的任务序列），所需的最少链数等于最大的互不可比元素集合的大小。这个定理为任务并行度分析提供了数学基础。在实际的项目管理中，反链长度就是最大并行度——可以同时分配给不同开发者的独立任务数量。</p>\n<p><strong>Mirsky 定理</strong>是其对偶：偏序集的最小反链覆盖数等于最长链的长度。最长链的长度就是关键路径的长度——决定了项目完成的最短时间。无论如何增加并行度，总工期不可能短于关键路径。</p>\n<p>这两个定理共同揭示了偏序集的&quot;宽度&quot;和&quot;高度&quot;之间的对偶关系，在项目调度、流水线设计和编译优化中有广泛应用。</p>\n<h2 id=\"格与最小上界-最大下界\">格与最小上界/最大下界</h2><p><strong>格</strong>（Lattice）是一种特殊的偏序集，其中任意两个元素都有<strong>最小上界</strong>（LUB，也叫 join，记为 a ∨ b）和<strong>最大下界</strong>（GLB，也叫 meet，记为 a ∧ b）。如果所有元素都有 LUB 和 GLB（包括空集），则称为<strong>完全格</strong>。</p>\n<table>\n<thead>\n<tr>\n<th>概念</th>\n<th>定义</th>\n<th>示例</th>\n<th>编程对应</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>最小上界 (LUB)</td>\n<td>所有上界中最小的</td>\n<td>lcm(a,b)</td>\n<td>类型的最小公共父类</td>\n</tr>\n<tr>\n<td>最大下界 (GLB)</td>\n<td>所有下界中最大的</td>\n<td>gcd(a,b)</td>\n<td>类型交集</td>\n</tr>\n<tr>\n<td>格</td>\n<td>任意两元素有 LUB 和 GLB</td>\n<td>(P(S), ⊆)</td>\n<td>类型层次</td>\n</tr>\n<tr>\n<td>完全格</td>\n<td>任意子集有 LUB 和 GLB</td>\n<td>—</td>\n<td>抽象解释域</td>\n</tr>\n</tbody></table>\n<p>格在计算机科学中有重要应用：</p>\n<p><strong>类型系统中的格</strong>：在支持子类型的语言中，类型按子类型关系形成偏序。两个类型的 LUB 是它们的&quot;最小公共超类型&quot;，GLB 是它们的&quot;最大公共子类型&quot;。TypeScript 中 <code>string | number</code> 的推导本质上就是求 LUB。</p>\n<p><strong>抽象解释中的格</strong>：静态分析工具使用格来表示程序状态的抽象。例如符号分析中的格 {⊥, 负, 零, 正, ⊤} 表示变量的可能取值范围。分析器在这个格上迭代直到达到不动点。</p>\n<p><strong>信息安全中的格</strong>：Bell-LaPadula 安全模型使用格来描述安全级别。&quot;不上读、不下写&quot;规则保证信息只能从低安全级别流向高安全级别。</p>\n<p><strong>不动点定理</strong>：Knaster-Tarski 定理说，完全格上的单调函数一定存在不动点。这个定理是数据流分析收敛性的理论保证——只要抽象域构成完全格，且转移函数是单调的，迭代分析一定会终止。</p>\n<p>在编程语言的语义学中，递归函数的语义通过格上的最小不动点来定义。<code>let rec f = ... f ...</code> 的含义是满足方程 f = F(f) 的最小解，其中 F 是相应的单调函数。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type SecurityLevel = &#39;unclassified&#39; | &#39;confidential&#39; | &#39;secret&#39; | &#39;top-secret&#39;;&#10;&#10;const levelOrder: Record&lt;SecurityLevel, number&gt; = {&#10;  unclassified: 0,&#10;  confidential: 1,&#10;  secret: 2,&#10;  &#39;top-secret&#39;: 3,&#10;};&#10;&#10;const lub = (a: SecurityLevel, b: SecurityLevel): SecurityLevel =&gt; (levelOrder[a] &gt;= levelOrder[b] ? a : b);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SecurityLevel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'unclassified'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'confidential'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'secret'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'top-secret'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> levelOrder</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">SecurityLevel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  unclassified: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  confidential: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  secret: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'top-secret'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> lub</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SecurityLevel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SecurityLevel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SecurityLevel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (levelOrder[a] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> levelOrder[b] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b);</span></span></code></pre></div><p>上述代码展示了安全级别格的 LUB 运算——两个安全级别的 LUB 就是较高的那个，这决定了混合数据的最终分类等级。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph BT&#10;    A[⊥ Bottom] --&gt; B[负]&#10;    A --&gt; C[零]&#10;    A --&gt; D[正]&#10;    B --&gt; E[⊤ Top]&#10;    C --&gt; E&#10;    D --&gt; E\">graph BT\n    A[⊥ Bottom] --&gt; B[负]\n    A --&gt; C[零]\n    A --&gt; D[正]\n    B --&gt; E[⊤ Top]\n    C --&gt; E\n    D --&gt; E</pre><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((偏序与格))&#10;    偏序定义&#10;      自反+反对称+传递&#10;      全序 vs 偏序&#10;      严格偏序&#10;    可视化&#10;      哈斯图&#10;      最大/极大元&#10;      链与反链&#10;    拓扑排序&#10;      DAG 线性化&#10;      Kahn 算法&#10;      循环依赖检测&#10;    格&#10;      LUB/GLB&#10;      完全格&#10;    工程应用&#10;      构建系统&#10;      类型层次&#10;      抽象解释&#10;      任务调度\">mindmap\n  root((偏序与格))\n    偏序定义\n      自反+反对称+传递\n      全序 vs 偏序\n      严格偏序\n    可视化\n      哈斯图\n      最大/极大元\n      链与反链\n    拓扑排序\n      DAG 线性化\n      Kahn 算法\n      循环依赖检测\n    格\n      LUB/GLB\n      完全格\n    工程应用\n      构建系统\n      类型层次\n      抽象解释\n      任务调度</pre><ul>\n<li>偏序关系（自反+反对称+传递）刻画&quot;部分排列&quot;，允许元素间不可比较</li>\n<li>哈斯图是偏序集最直观的可视化方式，省略可推导的边</li>\n<li>最大元是全局最高点，极大元是局部最高点，两者在偏序中有本质区别</li>\n<li>拓扑排序将偏序线性化为全序，是构建系统和包管理器的核心算法</li>\n<li>格要求任意两元素有 LUB 和 GLB，是类型系统和抽象解释的数学框架</li>\n<li>循环依赖对应偏序中的环，拓扑排序返回失败是检测循环依赖的标准方法</li>\n<li>偏序思维帮助我们理解任务并行性：互不可比的任务可以并行执行</li>\n<li>Dilworth 定理和 Mirsky 定理分别揭示了偏序集中并行度和关键路径长度的数学本质</li>\n<li>不动点定理保证了格上迭代分析的收敛性，是数据流分析正确性的理论基石</li>\n<li>Promise.all 处理反链（独立任务），.then 链定义链（依赖关系），两者共同刻画了异步编程中的偏序结构</li>\n</ul>\n","headings":[{"level":1,"text":"偏序与格","id":"偏序与格"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"哈斯图与偏序的可视化","id":"哈斯图与偏序的可视化"},{"level":2,"text":"拓扑排序","id":"拓扑排序"},{"level":2,"text":"格与最小上界/最大下界","id":"格与最小上界-最大下界"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"函数","url":"/l-doc-books/h/cs-fundamentals/discrete-mathematics/sets-and-relations/functions"},"next":{"title":"计数原理","url":"/l-doc-books/h/cs-fundamentals/discrete-mathematics/combinatorics/counting-principles"}}