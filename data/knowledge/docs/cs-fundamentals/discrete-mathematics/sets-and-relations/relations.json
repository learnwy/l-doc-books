olor:#24292E;--shiki-dark:#E1E4E8\">(y);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (px </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> py) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.rank[px] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.rank[py]) </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.parent[px] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> py;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.rank[px] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.rank[py]) </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.parent[py] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> px;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.parent[py] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> px;</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.rank[px]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"关系的复合与闭包\">关系的复合与闭包</h2><p><strong>关系的复合</strong>（Composition）：如果 R 是 A 到 B 的关系，S 是 B 到 C 的关系，则 S∘R 是 A 到 C 的关系，其中 a(S∘R)c 当且仅当存在 b ∈ B 使得 aRb 且 bSc。关系复合在数据库中对应多表 JOIN：先通过 R 从 A 表连接到 B 表，再通过 S 从 B 表连接到 C 表。</p>\n<p><strong>闭包</strong>（Closure）是将关系&quot;补全&quot;到满足某性质的最小关系。三种常见闭包：</p>\n<ul>\n<li><strong>自反闭包</strong> r(R)：添加所有 (a, a) 使关系变为自反的</li>\n<li><strong>对称闭包</strong> s(R)：对每个 (a, b) ∈ R 添加 (b, a)</li>\n<li><strong>传递闭包</strong> t(R)：添加所有通过传递性可达的配对</li>\n</ul>\n<p>传递闭包在工程中应用最广。在依赖分析中，如果 A → B 和 B → C 是直接依赖，传递闭包就给出所有传递依赖。在图中，传递闭包回答的是&quot;从 u 出发能否到达 v&quot;的可达性问题。</p>\n<p><strong>Warshall 算法</strong>计算传递闭包的时间复杂度为 O(n³)：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function transitiveClosure(matrix: boolean[][]): boolean[][] {&#10;  const n = matrix.length;&#10;  const result = matrix.map((row) =&gt; [...row]);&#10;  for (let k = 0; k &lt; n; k++) {&#10;    for (let i = 0; i &lt; n; i++) {&#10;      for (let j = 0; j &lt; n; j++) {&#10;        result[i][j] = result[i][j] || (result[i][k] &amp;&amp; result[k][j]);&#10;      }&#10;    }&#10;  }&#10;  return result;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> transitiveClosure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">matrix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[][])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[][] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matrix.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matrix.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">row</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">row]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> k </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; k </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n; k</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n; j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result[i][j] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result[i][j] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result[i][k] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result[k][j]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关系的矩阵表示使运算变得直观：关系 R 的矩阵 M_R 中，M_R[i][j] = 1 当且仅当 (aᵢ, aⱼ) ∈ R。关系的复合对应矩阵的布尔乘法，传递闭包对应矩阵幂序列的并。</p>\n<p><strong>逆关系</strong>也是常见运算：R 的逆关系 R⁻¹ 将 R 中所有配对翻转，即 (a,b) ∈ R 当且仅当 (b,a) ∈ R⁻¹。在图中，逆关系对应所有边反向。在数据库中，&quot;学生选课&quot;关系的逆就是&quot;课程有哪些学生&quot;关系。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((关系))&#10;    基本性质&#10;      自反性&#10;      对称性&#10;      反对称性&#10;      传递性&#10;    等价关系&#10;      自反+对称+传递&#10;      等价类划分&#10;      并查集&#10;    运算&#10;      关系复合&#10;      逆关系&#10;    闭包&#10;      自反闭包&#10;      对称闭包&#10;      传递闭包&#10;      Warshall 算法&#10;    工程应用&#10;      数据库 JOIN&#10;      依赖分析&#10;      连通性&#10;      类型等价\">mindmap\n  root((关系))\n    基本性质\n      自反性\n      对称性\n      反对称性\n      传递性\n    等价关系\n      自反+对称+传递\n      等价类划分\n      并查集\n    运算\n      关系复合\n      逆关系\n    闭包\n      自反闭包\n      对称闭包\n      传递闭包\n      Warshall 算法\n    工程应用\n      数据库 JOIN\n      依赖分析\n      连通性\n      类型等价</pre><ul>\n<li>二元关系是笛卡尔积的子集，是描述元素间联系的通用数学工具</li>\n<li>自反性、对称性、反对称性、传递性是关系最基本的四个性质</li>\n<li>等价关系（自反+对称+传递）将集合划分为互不相交的等价类</li>\n<li>并查集是处理等价关系的经典数据结构，支持高效的查找和合并</li>\n<li>关系复合对应数据库的多表 JOIN 操作</li>\n<li>传递闭包回答可达性问题，Warshall 算法以 O(n³) 时间计算</li>\n<li>理解关系的性质和运算，是分析图结构、数据库查询和依赖关系的数学基础</li>\n</ul>\n","headings":[{"level":1,"text":"关系","id":"关系"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"关系的性质分析","id":"关系的性质分析"},{"level":2,"text":"等价关系与等价类","id":"等价关系与等价类"},{"level":2,"text":"关系的复合与闭包","id":"关系的复合与闭包"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"集合论基础","url":"/l-doc-books/h/cs-fundamentals/discrete-mathematics/sets-and-relations/set-theory"},"next":{"title":"函数","url":"/l-doc-books/h/cs-fundamentals/discrete-mathematics/sets-and-relations/functions"}}