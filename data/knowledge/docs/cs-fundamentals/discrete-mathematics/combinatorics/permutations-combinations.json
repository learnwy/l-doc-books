k:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    dp[i][</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i, r); j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      dp[i][j] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dp[i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dp[i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][j];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dp[n][r];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>二项式定理</strong> (x + y)ⁿ = ∑ C(n, k) × xᵏ × yⁿ⁻ᵏ 将组合数与代数展开联系起来。当 x = y = 1 时，得到 2ⁿ = ∑ C(n, k)，即 n 个元素的子集总数。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph 帕斯卡三角形&#10;        A[&quot;C(0,0)=1&quot;]&#10;        B[&quot;C(1,0)=1&quot;]&#10;        C[&quot;C(1,1)=1&quot;]&#10;        D[&quot;C(2,0)=1&quot;]&#10;        E[&quot;C(2,1)=2&quot;]&#10;        F[&quot;C(2,2)=1&quot;]&#10;        G[&quot;C(3,0)=1&quot;]&#10;        H[&quot;C(3,1)=3&quot;]&#10;        I[&quot;C(3,2)=3&quot;]&#10;        J[&quot;C(3,3)=1&quot;]&#10;    end&#10;    A --&gt; B&#10;    A --&gt; C&#10;    B --&gt; D&#10;    B --&gt; E&#10;    C --&gt; E&#10;    C --&gt; F&#10;    D --&gt; G&#10;    D --&gt; H&#10;    E --&gt; H&#10;    E --&gt; I&#10;    F --&gt; I&#10;    F --&gt; J\">graph TB\n    subgraph 帕斯卡三角形\n        A[\"C(0,0)=1\"]\n        B[\"C(1,0)=1\"]\n        C[\"C(1,1)=1\"]\n        D[\"C(2,0)=1\"]\n        E[\"C(2,1)=2\"]\n        F[\"C(2,2)=1\"]\n        G[\"C(3,0)=1\"]\n        H[\"C(3,1)=3\"]\n        I[\"C(3,2)=3\"]\n        J[\"C(3,3)=1\"]\n    end\n    A --&gt; B\n    A --&gt; C\n    B --&gt; D\n    B --&gt; E\n    C --&gt; E\n    C --&gt; F\n    D --&gt; G\n    D --&gt; H\n    E --&gt; H\n    E --&gt; I\n    F --&gt; I\n    F --&gt; J</pre><h2 id=\"可重复排列与组合\">可重复排列与组合</h2><p>当允许重复选择时，计数模型有所不同：</p>\n<p><strong>可重复排列</strong>：每个位置有 n 种选择，共 r 个位置，方案数为 nʳ。这是密码学中密钥空间计算的基本模型——长度为 r 的密码，每位有 n 种字符选择。IP 地址空间 (256⁴ ≈ 4.3 × 10⁹) 也是可重复排列。</p>\n<p><strong>可重复组合</strong>：从 n 种物品中允许重复选取 r 个（不考虑顺序），方案数为 C(n+r-1, r)。这个公式可以通过&quot;星与条&quot;（Stars and Bars）方法推导：将 r 个相同的星用 n-1 个隔板分成 n 组，等价于从 n+r-1 个位置中选 r 个放星。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 可重复组合：n 种物品选 r 个&#10;const repeatedCombination = (n: number, r: number): number =&gt; combinationsDP(n + r - 1, r);&#10;&#10;// 应用：将 r 个相同的球放入 n 个不同的盒子&#10;const distributeIdentical = (balls: number, boxes: number): number =&gt; repeatedCombination(boxes, balls);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 可重复组合：n 种物品选 r 个</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> repeatedCombination</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> combinationsDP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, r);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 应用：将 r 个相同的球放入 n 个不同的盒子</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> distributeIdentical</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">balls</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">boxes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> repeatedCombination</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(boxes, balls);</span></span></code></pre></div><p>&quot;星与条&quot;方法在整数方程求解中也有重要应用。非负整数解的个数 x₁ + x₂ + ... + xₙ = r 等于 C(n+r-1, r)。这在资源分配问题中经常出现：将 r 单位资源分配给 n 个项目的方案数。</p>\n<h2 id=\"排列组合在工程中的应用\">排列组合在工程中的应用</h2><p><strong>组合测试</strong>（Combinatorial Testing）基于这样的经验：大多数软件缺陷由少量参数的交互引起。两两组合（pairwise testing）通过覆盖所有参数对的组合来减少测试用例数，从 nᵏ 减少到大约 n² × k 量级。</p>\n<p><strong>数据库查询优化</strong>：多表 JOIN 的执行顺序有 n! 种可能。对于 10 张表，有 3,628,800 种顺序。查询优化器使用启发式方法（而非穷举）来找到近似最优的执行计划。</p>\n<p><strong>机器学习超参数搜索</strong>：如果有 k 个超参数，每个有 m 个候选值，网格搜索需要 mᵏ 次实验。当 k 和 m 稍大时（如 k=5, m=10），10⁵ 次实验可能不可接受。随机搜索和贝叶斯优化是对抗这种组合爆炸的方法。</p>\n<p><strong>API 版本兼容性</strong>：如果系统有 n 个 API 端点，每个有 m 个版本，全兼容性测试需要 mⁿ 种组合。实际中通常用兼容性矩阵和版本策略来减少需要测试的组合数。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((排列与组合))&#10;    排列&#10;      P n,r&#10;      全排列 n!&#10;      Heap 算法&#10;    组合&#10;      C n,r&#10;      帕斯卡恒等式&#10;      二项式定理&#10;    可重复&#10;      可重复排列 nʳ&#10;      可重复组合 C n+r-1,r&#10;      星与条方法&#10;    工程应用&#10;      组合测试&#10;      查询优化&#10;      超参数搜索&#10;      密钥空间\">mindmap\n  root((排列与组合))\n    排列\n      P n,r\n      全排列 n!\n      Heap 算法\n    组合\n      C n,r\n      帕斯卡恒等式\n      二项式定理\n    可重复\n      可重复排列 nʳ\n      可重复组合 C n+r-1,r\n      星与条方法\n    工程应用\n      组合测试\n      查询优化\n      超参数搜索\n      密钥空间</pre><ul>\n<li>排列关注有序选择 P(n,r)，组合关注无序选择 C(n,r)，两者通过 r! 关联</li>\n<li>阶乘增长极快，n! 在 n ≈ 15 时就达到暴力搜索的实际上限</li>\n<li>帕斯卡恒等式对应递归分解，帕斯卡三角形的每个数是上方两个数之和</li>\n<li>可重复组合 C(n+r-1, r) 通过&quot;星与条&quot;方法推导，等价于整数方程求解</li>\n<li>二项式定理将组合数与多项式展开联系，C(n,r) 是 (1+x)ⁿ 的系数</li>\n<li>组合爆炸是算法设计的核心挑战，组合测试和随机搜索是工程中的实用应对策略</li>\n</ul>\n","headings":[{"level":1,"text":"排列与组合","id":"排列与组合"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"排列数与阶乘","id":"排列数与阶乘"},{"level":2,"text":"组合数与二项式系数","id":"组合数与二项式系数"},{"level":2,"text":"可重复排列与组合","id":"可重复排列与组合"},{"level":2,"text":"排列组合在工程中的应用","id":"排列组合在工程中的应用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"计数原理","url":"/l-doc-books/h/cs-fundamentals/discrete-mathematics/combinatorics/counting-principles"},"next":{"title":"鸽巢原理与容斥原理","url":"/l-doc-books/h/cs-fundamentals/discrete-mathematics/combinatorics/pigeonhole-inclusion-exclusion"}}