E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nfds; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">events</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[i].data.fd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> listen_fd) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn_fd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> accept</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(listen_fd, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ev.events </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> EPOLLIN </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> EPOLLET;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ev.data.fd </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> conn_fd;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            epoll_ctl</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(epfd, EPOLL_CTL_ADD, conn_fd, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ev);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            handle_connection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">events</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[i].data.fd);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"水平触发-vs-边缘触发\">水平触发 vs 边缘触发</h3><div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"水平触发（LT - Level Triggered）：&#10;  缓冲区有数据 → 每次 epoll_wait 都会通知&#10;  更安全，不会丢事件&#10;&#10;边缘触发（ET - Edge Triggered）：&#10;  缓冲区从无数据变为有数据 → 仅通知一次&#10;  必须一次性读完所有数据（循环 read 直到 EAGAIN）&#10;  性能更高，但编程更复杂\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>水平触发（LT - Level Triggered）：</span></span>\n<span class=\"line\"><span>  缓冲区有数据 → 每次 epoll_wait 都会通知</span></span>\n<span class=\"line\"><span>  更安全，不会丢事件</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>边缘触发（ET - Edge Triggered）：</span></span>\n<span class=\"line\"><span>  缓冲区从无数据变为有数据 → 仅通知一次</span></span>\n<span class=\"line\"><span>  必须一次性读完所有数据（循环 read 直到 EAGAIN）</span></span>\n<span class=\"line\"><span>  性能更高，但编程更复杂</span></span></code></pre></div><hr>\n<h2 id=\"经典并发模型\">经典并发模型</h2><div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"模型 1：一连接一线程（Thread-per-Connection）&#10;  accept → 创建新线程 → 线程内阻塞读写&#10;  缺点：线程数受限，上下文切换开销大&#10;&#10;模型 2：线程池（Thread Pool）&#10;  accept → 任务放入队列 → 线程池中的线程处理&#10;  优化：限制线程数量&#10;&#10;模型 3：Reactor 模式（epoll/kqueue）&#10;  主线程 epoll_wait → 分发事件 → 工作线程处理&#10;  典型实现：Nginx, Redis, Node.js&#10;&#10;模型 4：Proactor 模式（IOCP）&#10;  异步 IO 完成后回调通知&#10;  典型实现：Windows IOCP\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>模型 1：一连接一线程（Thread-per-Connection）</span></span>\n<span class=\"line\"><span>  accept → 创建新线程 → 线程内阻塞读写</span></span>\n<span class=\"line\"><span>  缺点：线程数受限，上下文切换开销大</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>模型 2：线程池（Thread Pool）</span></span>\n<span class=\"line\"><span>  accept → 任务放入队列 → 线程池中的线程处理</span></span>\n<span class=\"line\"><span>  优化：限制线程数量</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>模型 3：Reactor 模式（epoll/kqueue）</span></span>\n<span class=\"line\"><span>  主线程 epoll_wait → 分发事件 → 工作线程处理</span></span>\n<span class=\"line\"><span>  典型实现：Nginx, Redis, Node.js</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>模型 4：Proactor 模式（IOCP）</span></span>\n<span class=\"line\"><span>  异步 IO 完成后回调通知</span></span>\n<span class=\"line\"><span>  典型实现：Windows IOCP</span></span></code></pre></div><hr>\n<h2 id=\"实战-node-js-tcp-服务器\">实战：Node.js TCP 服务器</h2><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const net = require(&#39;net&#39;);&#10;&#10;const server = net.createServer((socket) =&gt; {&#10;  socket.on(&#39;data&#39;, (data) =&gt; {&#10;    const message = data.toString().trim();&#10;    socket.write(`Echo: ${message}\\n`);&#10;  });&#10;&#10;  socket.on(&#39;end&#39;, () =&gt; {&#10;    console.log(&#39;Client disconnected&#39;);&#10;  });&#10;&#10;  socket.on(&#39;error&#39;, (err) =&gt; {&#10;    console.error(&#39;Socket error:&#39;, err.message);&#10;  });&#10;});&#10;&#10;server.listen(8080, () =&gt; {&#10;  console.log(&#39;TCP server listening on port 8080&#39;);&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> net</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> require</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'net'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> server</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> net.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createServer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">socket</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </sp