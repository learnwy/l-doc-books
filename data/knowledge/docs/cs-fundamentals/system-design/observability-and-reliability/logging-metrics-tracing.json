:#24292E;--shiki-dark:#E1E4E8\">logger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">info</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Order created'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { orderId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ord_123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, userId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'usr_456'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, amount: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">99.99</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><h3 id=\"日志聚合架构-elk-stack\">日志聚合架构（ELK Stack）</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    S1[服务 1] --&gt; FB1[Filebeat]&#10;    S2[服务 2] --&gt; FB2[Filebeat]&#10;    S3[服务 3] --&gt; FB3[Filebeat]&#10;&#10;    FB1 --&gt; Logstash[Logstash&lt;br/&gt;解析/过滤/转换]&#10;    FB2 --&gt; Logstash&#10;    FB3 --&gt; Logstash&#10;&#10;    Logstash --&gt; ES[(Elasticsearch&lt;br/&gt;索引/存储)]&#10;    ES --&gt; Kibana[Kibana&lt;br/&gt;可视化/查询]\">flowchart LR\n    S1[服务 1] --&gt; FB1[Filebeat]\n    S2[服务 2] --&gt; FB2[Filebeat]\n    S3[服务 3] --&gt; FB3[Filebeat]\n\n    FB1 --&gt; Logstash[Logstash&lt;br/&gt;解析/过滤/转换]\n    FB2 --&gt; Logstash\n    FB3 --&gt; Logstash\n\n    Logstash --&gt; ES[(Elasticsearch&lt;br/&gt;索引/存储)]\n    ES --&gt; Kibana[Kibana&lt;br/&gt;可视化/查询]</pre><hr>\n<h2 id=\"指标-metrics\">指标（Metrics）</h2><h3 id=\"四种黄金信号\">四种黄金信号</h3><p>Google SRE 提出了四种衡量服务健康状态的黄金信号：</p>\n<table>\n<thead>\n<tr>\n<th>信号</th>\n<th>描述</th>\n<th>示例指标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>延迟</td>\n<td>请求处理耗时</td>\n<td>P50, P95, P99 响应时间</td>\n</tr>\n<tr>\n<td>流量</td>\n<td>系统的请求量</td>\n<td>QPS, 每秒事务数</td>\n</tr>\n<tr>\n<td>错误率</td>\n<td>失败请求的比例</td>\n<td>5xx 错误率, 业务错误率</td>\n</tr>\n<tr>\n<td>饱和度</td>\n<td>系统资源的使用程度</td>\n<td>CPU 使用率, 内存使用率, 队列深度</td>\n</tr>\n</tbody></table>\n<h3 id=\"prometheus-指标类型\">Prometheus 指标类型</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PrometheusMetrics {&#10;  counter: {&#10;    description: &#39;只增不减的累计值&#39;;&#10;    example: &#39;http_requests_total&#39;;&#10;  };&#10;  gauge: {&#10;    description: &#39;可增可减的瞬时值&#39;;&#10;    example: &#39;active_connections&#39;;&#10;  };&#10;  histogram: {&#10;    description: &#39;值的分布（桶计数）&#39;;&#10;    example: &#39;http_request_duration_seconds&#39;;&#10;  };&#10;  summary: {&#10;    description: &#39;值的分布（分位数）&#39;;&#10;    example: &#39;http_request_duration_quantiles&#39;;&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PrometheusMetrics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  counter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '只增不减的累计值'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    example</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'http_requests_total'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  gauge</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '可增可减的瞬时值'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    example</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'active_connections'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  histogram</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '值的分布（桶计数）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    example</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'http_request_duration_seconds'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  summary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    description</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '值的分布（分位数）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    example</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'http_request_duration_quantiles'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"监控与告警\">监控与告警</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    Services[微服务集群] --&gt;|暴露 /metrics| Prometheus[Prometheus&lt;br/&gt;抓取/存储指标]&#10;    Prometheus --&gt; Grafana[Grafana&lt;br/&gt;仪表板]&#10;    Prometheus --&gt; AlertManager[AlertManager&lt;br/&gt;告警管理]&#10;&#10;    AlertManager --&gt; Slack[Slack 通知]&#10;    AlertManager --&gt; PagerDuty[PagerDuty 呼叫]&#10;    AlertManager --&gt; Email[邮件通知]\">flowchart TB\n    Services[微服务集群] --&gt;|暴露 /metrics| Prometheus[Prometheus&lt;br/&gt;抓取/存储指标]\n    Prometheus --&gt; Grafana[Grafana&lt;br/&gt;仪表板]\n    Prometheus --&gt; AlertManager[AlertManager&lt;br/&gt;告警管理]\n\n    AlertManager --&gt; Slack[Slack 通知]\n    AlertManager --&gt; PagerDuty[PagerDuty 呼叫]\n    AlertManager --&gt; Email[邮件通知]</pre><p>告警的核心原则：</p>\n<table>\n<thead>\n<tr>\n<th>原则</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>告警疲劳是最大敌人</td>\n<td>只对需要人工干预的事件发告警</td>\n</tr>\n<tr>\n<td>基于症状而非原因</td>\n<td>告警&quot;用户请求失败率 &gt; 1%&quot;而非&quot;CPU &gt; 90%&quot;</td>\n</tr>\n<tr>\n<td>分级告警</td>\n<td>P0 立即呼叫，P1 工作时间通知，P2 工单</td>\n</tr>\n<tr>\n<td>包含上下文</td>\n<td>告警消息应包含足够的诊断信息</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"链路追踪-distributed-tracing\">链路追踪（Distributed Tracing）</h2><h3 id=\"追踪模型\">追踪模型</h3><pre class=\"mermaid\" data-diagram-type=\"gantt\" data-source=\"gantt&#10;    title 请求链路追踪&#10;    dateFormat  X&#10;    axisFormat %L ms&#10;&#10;    section API Gateway&#10;    接收请求              :0, 5&#10;    路由转发              :5, 8&#10;&#10;    section 用户服务&#10;    认证                  :8, 15&#10;    查询用户              :15, 25&#10;&#10;    section 订单服务&#10;    创建订单              :25, 35&#10;    调用库存服务          :35, 55&#10;&#10;    section 库存服务&#10;    检查库存              :38, 48&#10;    扣减库存              :48, 53&#10;&#10;    section 订单服务&#10;    返回结果              :55, 58\">gantt\n    title 请求链路追踪\n    dateFormat  X\n    axisFormat %L ms\n\n    section API Gateway\n    接收请求              :0, 5\n    路由转发              :5, 8\n\n    section 用户服务\n    认证                  :8, 15\n    查询用户              :15, 25\n\n    section 订单服务\n    创建订单              :25, 35\n    调用库存服务          :35, 55\n\n    section 库存服务\n    检查库存              :38, 48\n    扣减库存              :48, 53\n\n    section 订单服务\n    返回结果              :55, 58</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface Span {&#10;  traceId: string;&#10;  spanId: string;&#10;  parentSpanId: string | null;&#10;  operationName: string;&#10;  serviceName: string;&#10;  startTime: number;&#10;  duration: number;&#10;  tags: Record&lt;string, string&gt;;&#10;  logs: Array&lt;{ timestamp: number; message: string }&gt;;&#10;}&#10;&#10;class SimpleTracer {&#10;  createSpan(operationName: string, parentSpan?: Span): Span {&#10;    return {&#10;      traceId: parentSpan?.traceId ?? crypto.randomUUID(),&#10;      spanId: crypto.randomUUID(),&#10;      parentSpanId: parentSpan?.spanId ?? null,&#10;      operationName,&#10;      serviceName: &#39;my-service&#39;,&#10;      startTime: Date.now(),&#10;      duration: 0,&#10;      tags: {},&#10;      logs: [],&#10;    };&#10;  }&#10;&#10;  finishSpan(span: Span): void 