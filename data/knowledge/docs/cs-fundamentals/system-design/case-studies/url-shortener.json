ine\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"数据库设计\">数据库设计</h3><div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE urls (&#10;    id          BIGINT PRIMARY KEY,&#10;    short_code  VARCHAR(10) UNIQUE NOT NULL,&#10;    long_url    VARCHAR(2048) NOT NULL,&#10;    user_id     VARCHAR(64),&#10;    created_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP,&#10;    expires_at  TIMESTAMP,&#10;    click_count BIGINT DEFAULT 0&#10;);&#10;&#10;CREATE INDEX idx_short_code ON urls(short_code);&#10;CREATE INDEX idx_expires_at ON urls(expires_at) WHERE expires_at IS NOT NULL;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> urls</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    id          </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    short_code  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">UNIQUE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    long_url    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2048</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    user_id     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">VARCHAR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    created_at  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMP</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_TIMESTAMP,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    expires_at  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMP</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    click_count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> idx_short_code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> urls(short_code);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> idx_expires_at</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> urls(expires_at) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> expires_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><h3 id=\"读取流程-重定向\">读取流程（重定向）</h3><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant U as 用户&#10;    participant API as API 服务器&#10;    participant Redis as Redis 缓存&#10;    participant DB as 数据库&#10;&#10;    U-&gt;&gt;API: GET /abc1234&#10;    API-&gt;&gt;Redis: GET url:abc1234&#10;    alt 缓存命中&#10;        Redis--&gt;&gt;API: https://example.com/very-long-url&#10;        API--&gt;&gt;U: 301 Redirect&#10;    else 缓存未命中&#10;        Redis--&gt;&gt;API: null&#10;        API-&gt;&gt;DB: SELECT long_url FROM urls WHERE short_code=&#39;abc1234&#39;&#10;        DB--&gt;&gt;API: https://example.com/very-long-url&#10;        API-&gt;&gt;Redis: SET url:abc1234 (TTL=24h)&#10;        API--&gt;&gt;U: 301 Redirect&#10;    end\">sequenceDiagram\n    participant U as 用户\n    participant API as API 服务器\n    participant Redis as Redis 缓存\n    participant DB as 数据库\n\n    U-&gt;&gt;API: GET /abc1234\n    API-&gt;&gt;Redis: GET url:abc1234\n    alt 缓存命中\n        Redis--&gt;&gt;API: https://example.com/very-long-url\n        API--&gt;&gt;U: 301 Redirect\n    else 缓存未命中\n        Redis--&gt;&gt;API: null\n        API-&gt;&gt;DB: SELECT long_url FROM urls WHERE short_code='abc1234'\n        DB--&gt;&gt;API: https://example.com/very-long-url\n        API-&gt;&gt;Redis: SET url:abc1234 (TTL=24h)\n        API--&gt;&gt;U: 301 Redirect\n    end</pre><h3 id=\"301-vs-302-重定向\">301 vs 302 重定向</h3><table>\n<thead>\n<tr>\n<th>状态码</th>\n<th>含义</th>\n<th>浏览器行为</th>\n<th>对分析的影响</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>301</td>\n<td>永久重定向</td>\n<td>缓存，后续直接访问原始 URL</td>\n<td>无法统计后续访问量</td>\n</tr>\n<tr>\n<td>302</td>\n<td>临时重定向</td>\n<td>每次都请求短链接服务</td>\n<td>可以精确统计访问量</td>\n</tr>\n</tbody></table>\n<p>如果需要统计点击次数，应使用 302。</p>\n<hr>\n<h2 id=\"扩展设计\">扩展设计</h2><h3 id=\"缓存策略\">缓存策略</h3><p>读请求远多于写请求（100:1），缓存命中率是性能的关键：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface CacheConfig {&#10;  hotUrlTTL: number;&#10;  normalUrlTTL: number;&#10;  maxCacheSize: string;&#10;  evictionPolicy: &#39;LRU&#39;;&#10;}&#10;&#10;const cacheConfig: CacheConfig = {&#10;  hotUrlTTL: 86400,&#10;  normalUrlTTL: 3600,&#10;  maxCacheSize: &#39;64GB&#39;,&#10;  evictionPolicy: &#39;LRU&#39;,&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CacheConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  hotUrlTTL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  normalUrlTTL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  maxCacheSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  evictionPolicy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'LRU'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cacheConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CacheConfig</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  hotUrlTTL: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">86400</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  normalUrlTTL: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3600</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  maxCacheSize: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'64GB'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  evictionPolicy: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'LRU'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h3 id=\"数据分区\">数据分区</h3><p>18 亿条记录需要分片存储：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    API[API 服务器] --&gt; Router{分片路由}&#10;    Router --&gt;|&quot;hash(shortCode) % 4 = 0&quot;| S0[&quot;(Shard 0)&quot;]&#10;    Router --&gt;|&quot;hash(shortCode) % 4 = 1&quot;| S1[&quot;(Shard 1)&quot;]&#10;    Router --&gt;|&quot;hash(shortCode) % 4 = 2&quot;| S2[&quot;(Shard 2)&quot;]&#10;    Router --&gt;|&quot;hash(shortCode) % 4 = 3&quot;| S3[&quot;(Shard 3)&quot;]\">flowchart LR\n    API[API 服务器] --&gt; Router{分片路由}\n    Router --&gt;|\"hash(shortCode) % 4 = 0\"| S0[\"(Shard 0)\"]\n    Router --&gt;|\"hash(shortCode) % 4 = 1\"| S1[\"(Shard 1)\"]\n    Router --&gt;|\"hash(shortCode) % 4 = 2\"| S2[\"(Shard 2)\"]\n    Router --&gt;|\"hash(shortCode) % 4 = 3\"| S3[\"(Shard 3)\"]</pre><h3 id=\"过期清理\">过期清理</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"async function cleanExpiredUrls(db: DatabaseClient): Promise&lt;number&gt; {&#10;  const batchSize = 1000;&#10;  let totalDeleted = 0;&#10;&#10;  while (true) {&#10;    const deleted = await db.query&lt;number&gt;(&#39;DELETE FROM urls WHERE expires_at &lt; NOW() LIMIT $1 RETURNING id&#39;, [&#10;      batchSize,&#10;    ]);&#10;    totalDeleted += deleted ?? 0;&#10;    if ((deleted ?? 0) &lt; batchSize) break;&#10;    await new Promise((r) =&gt; setTimeout(r, 100));&#10;  }&#10;&#10;  return totalDeleted;&#10;}&#10;&#10;interface DatabaseClient {&#10;  query&lt;T&gt;(sql: string, params: unknown[]): Promise&lt;T | null&gt;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cleanExpiredUrls</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DatabaseClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> batchSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalDeleted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> deleted</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'DELETE FROM urls WHERE expires_at &#x3C; NOW() LIMIT $1 RETURNING id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      batchSize,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    totalDeleted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deleted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ((deleted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> batchSize) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">break</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(r, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> totalDeleted;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DatabaseClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sql</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">params</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((短链接服务))&#10;    核心设计&#10;      短码生成 计数器+Base62&#10;      缓存优先 100:1读写比&#10;      301 vs 302 重定向&#10;    存储&#10;      MySQL/PostgreSQL&#10;      按短码哈希分片&#10;    扩展&#10;      Redis 缓存热点 URL&#10;      异步统计点击量&#10;      定时清理过期链接\">mindmap\n  root((短链接服务))\n    核心设计\n      短码生成 计数器+Base62\n      缓存优先 100:1读写比\n      301 vs 302 重定向\n    存储\n      MySQL/PostgreSQL\n      按短码哈希分片\n    扩展\n      Redis 缓存热点 URL\n      异步统计点击量\n      定时清理过期链接</pre><ul>\n<li>短链接服务是读密集型系统，<strong>缓存</strong>是性能的关键。</li>\n<li><strong>Base62 编码</strong>配合全局计数器是最简洁的短码生成方案。</li>\n<li>使用 <strong>302 重定向</strong>可以统计点击次数，<strong>301</strong> 可以减少服务负载。</li>\n<li>数据量增长后需要<strong>分库分表</strong>和<strong>过期数据清理</strong>机制。</li>\n</ul>\n","headings":[{"level":1,"text":"短链接服务","id":"短链接服务"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"需求分析","id":"需求分析"},{"level":3,"text":"功能需求","id":"功能需求"},{"level":3,"text":"非功能需求","id":"非功能需求"},{"level":2,"text":"量化估算","id":"量化估算"},{"level":2,"text":"高层设计","id":"高层设计"},{"level":3,"text":"核心 API","id":"核心-api"},{"level":2,"text":"详细设计","id":"详细设计"},{"level":3,"text":"短码生成方案","id":"短码生成方案"},{"level":3,"text":"实现：计数器 + Base62","id":"实现-计数器-base62"},{"level":3,"text":"数据库设计","id":"数据库设计"},{"level":3,"text":"读取流程（重定向）","id":"读取流程-重定向"},{"level":3,"text":"301 vs 302 重定向","id":"301-vs-302-重定向"},{"level":2,"text":"扩展设计","id":"扩展设计"},{"level":3,"text":"缓存策略","id":"缓存策略"},{"level":3,"text":"数据分区","id":"数据分区"},{"level":3,"text":"过期清理","id":"过期清理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"灾难恢复","url":"/l-doc-books/h/cs-fundamentals/system-design/observability-and-reliability/disaster-recovery"},"next":{"title":"聊天系统","url":"/l-doc-books/h/cs-fundamentals/system-design/case-studies/chat-system"}}