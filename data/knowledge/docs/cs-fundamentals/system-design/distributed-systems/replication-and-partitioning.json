n class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    keyRange: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`split_${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">hot</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">partitionId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((复制与分区))&#10;    复制&#10;      同步 强一致高延迟&#10;      异步 低延迟可能丢数据&#10;      半同步 折中方案&#10;    分区&#10;      范围分区 范围查询高效&#10;      哈希分区 分布均匀&#10;    组合使用&#10;      每个分区多副本&#10;      Kafka MongoDB 标准模式&#10;    挑战&#10;      热点问题&#10;      再平衡&#10;      跨分区查询\">mindmap\n  root((复制与分区))\n    复制\n      同步 强一致高延迟\n      异步 低延迟可能丢数据\n      半同步 折中方案\n    分区\n      范围分区 范围查询高效\n      哈希分区 分布均匀\n    组合使用\n      每个分区多副本\n      Kafka MongoDB 标准模式\n    挑战\n      热点问题\n      再平衡\n      跨分区查询</pre><ul>\n<li><strong>复制</strong>提升可用性和读性能，核心权衡是一致性 vs 延迟。</li>\n<li><strong>分区</strong>突破单节点的存储和计算瓶颈，核心权衡是查询灵活性 vs 数据均匀性。</li>\n<li>实际系统<strong>同时使用复制和分区</strong>——每个分区有多个副本。</li>\n<li><strong>热点检测和再平衡</strong>是运维分布式存储系统的关键能力。</li>\n</ul>\n","headings":[{"level":1,"text":"复制与分区","id":"复制与分区"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"数据复制","id":"数据复制"},{"level":3,"text":"同步复制 vs 异步复制","id":"同步复制-vs-异步复制"},{"level":3,"text":"半同步复制","id":"半同步复制"},{"level":3,"text":"复制拓扑","id":"复制拓扑"},{"level":2,"text":"数据分区","id":"数据分区"},{"level":3,"text":"范围分区","id":"范围分区"},{"level":3,"text":"哈希分区","id":"哈希分区"},{"level":3,"text":"分区策略对比","id":"分区策略对比"},{"level":2,"text":"复制 + 分区","id":"复制-分区"},{"level":2,"text":"热点问题与再平衡","id":"热点问题与再平衡"},{"level":3,"text":"热点检测与处理","id":"热点检测与处理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"一致性哈希","url":"/l-doc-books/h/cs-fundamentals/system-design/distributed-systems/consistent-hashing"},"next":{"title":"共识与协调","url":"/l-doc-books/h/cs-fundamentals/system-design/distributed-systems/consensus-and-coordination"}}