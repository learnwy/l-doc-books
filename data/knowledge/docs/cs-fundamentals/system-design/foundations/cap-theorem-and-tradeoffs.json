 timestamp) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    peer.data.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, { value, timestamp });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> queueForLaterSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_peer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> APNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_timestamp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>典型的 AP 系统：</p>\n<ul>\n<li><strong>Cassandra</strong>：最终一致性的列族数据库，优先保证可用性</li>\n<li><strong>DynamoDB</strong>：Amazon 的键值存储，支持最终一致性读取</li>\n<li><strong>DNS</strong>：域名系统，允许短暂的不一致以保证全球可用</li>\n</ul>\n<hr>\n<h2 id=\"一致性模型的光谱\">一致性模型的光谱</h2><p>CAP 中的 C 不是非黑即白的。实际系统中存在多种一致性级别：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[强一致性] --&gt; B[线性一致性] --&gt; C[顺序一致性] --&gt; D[因果一致性] --&gt; E[最终一致性]\">graph LR\n    A[强一致性] --&gt; B[线性一致性] --&gt; C[顺序一致性] --&gt; D[因果一致性] --&gt; E[最终一致性]</pre><table>\n<thead>\n<tr>\n<th>一致性级别</th>\n<th>描述</th>\n<th>延迟</th>\n<th>典型系统</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>强一致性</td>\n<td>写入后立即对所有节点可见</td>\n<td>高</td>\n<td>单机数据库</td>\n</tr>\n<tr>\n<td>线性一致性</td>\n<td>全局顺序一致，所有操作看起来是原子的</td>\n<td>高</td>\n<td>ZooKeeper, etcd</td>\n</tr>\n<tr>\n<td>顺序一致性</td>\n<td>每个客户端的操作保持顺序，但不保证全局顺序</td>\n<td>中</td>\n<td>部分分布式数据库</td>\n</tr>\n<tr>\n<td>因果一致性</td>\n<td>有因果关系的操作保持顺序</td>\n<td>中低</td>\n<td>协作编辑系统</td>\n</tr>\n<tr>\n<td>最终一致性</td>\n<td>在没有新写入的情况下，所有副本最终会一致</td>\n<td>低</td>\n<td>DNS, Cassandra</td>\n</tr>\n</tbody></table>\n<h3 id=\"最终一致性的实现\">最终一致性的实现</h3><p>最终一致性是工程实践中最常用的折中方案。典型实现策略包括：</p>\n<p><strong>读时修复（Read Repair）</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface Replica {&#10;  id: string;&#10;  get(key: string): { value: string; version: number } | null;&#10;  set(key: string, value: string, version: number): void;&#10;}&#10;&#10;async function readWithRepair(replicas: Replica[], key: string): Promise&lt;string&gt; {&#10;  const results = await Promise.all(replicas.map(async (r) =&gt; ({ replica: r, data: r.get(key) })));&#10;&#10;  const validResults = results.filter((r) =&gt; r.data !== null);&#10;  if (validResults.length === 0) throw new Error(&#39;Key not found&#39;);&#10;&#10;  const latest = validResults.reduce((a, b) =&gt; (a.data!.version &gt; b.data!.version ? a : b));&#10;&#10;  for (const result of validResults) {&#10;    if (result.data!.version &lt; latest.data!.version) {&#10;      result.replica.set(key, latest.data!.value, latest.data!.version);&#10;    }&#10;  }&#10;&#10;  return latest.data!.value;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Replica</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> readWithRepair</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">replicas</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Replica</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#