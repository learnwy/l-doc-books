292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (validResults.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Key not found'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> latest</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> validResults.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (a.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> validResults) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> latest.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.version) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      result.replica.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, latest.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.value, latest.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.version);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> latest.data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.value;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>反熵协议（Anti-Entropy）</strong>：</p>\n<p>后台定期比较副本之间的数据差异并修复。Cassandra 使用 Merkle Tree 来高效地检测不一致的数据范围。</p>\n<p><strong>冲突解决</strong>：</p>\n<p>当多个节点同时写入同一个 key 时，需要冲突解决策略：</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>描述</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Last-Write-Wins</td>\n<td>最后写入的值胜出（基于时间戳）</td>\n<td>简单场景</td>\n</tr>\n<tr>\n<td>向量时钟</td>\n<td>追踪因果关系，检测并发冲突</td>\n<td>需要精确冲突检测</td>\n</tr>\n<tr>\n<td>CRDT</td>\n<td>无冲突复制数据类型，自动合并</td>\n<td>协作编辑、计数器</td>\n</tr>\n<tr>\n<td>应用层解决</td>\n<td>将冲突交给应用逻辑处理</td>\n<td>业务规则复杂</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"pacelc-定理\">PACELC 定理</h2><p>PACELC 是对 CAP 的扩展：当发生分区（P）时，在可用性（A）和一致性（C）之间选择；否则（Else），在延迟（L）和一致性（C）之间选择。</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    Start{网络分区?}&#10;    Start --&gt;|是| PAC[选择 A 还是 C?]&#10;    Start --&gt;|否| ELC[选择 L 还是 C?]&#10;    PAC --&gt; PA[PA: 保可用性]&#10;    PAC --&gt; PC[PC: 保一致性]&#10;    ELC --&gt; EL[EL: 低延迟]&#10;    ELC --&gt; EC[EC: 强一致性]\">flowchart TD\n    Start{网络分区?}\n    Start --&gt;|是| PAC[选择 A 还是 C?]\n    Start --&gt;|否| ELC[选择 L 还是 C?]\n    PAC --&gt; PA[PA: 保可用性]\n    PAC --&gt; PC[PC: 保一致性]\n    ELC --&gt; EL[EL: 低延迟]\n    ELC --&gt; EC[EC: 强一致性]</pre><table>\n<thead>\n<tr>\n<th>系统</th>\n<th>P 时选择</th>\n<th>E 时选择</th>\n<th>分类</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DynamoDB</td>\n<td>PA</td>\n<td>EL</td>\n<td>PA/EL</td>\n</tr>\n<tr>\n<td>Cassandra</td>\n<td>PA</td>\n<td>EL</td>\n<td>PA/EL</td>\n</tr>\n<tr>\n<td>MongoDB</td>\n<td>PC</td>\n<td>EC</td>\n<td>PC/EC</td>\n</tr>\n<tr>\n<td>ZooKeeper</td>\n<td>PC</td>\n<td>EC</td>\n<td>PC/EC</td>\n</tr>\n<tr>\n<td>PNUTS</td>\n<td>PC</td>\n<td>EL</td>\n<td>PC/EL</td>\n</tr>\n</tbody></table>\n<p>PACELC 比 CAP 更实用，因为在大多数时间里网络并没有分区，此时延迟与一致性的权衡才是日常需要面对的核心问题。</p>\n<hr>\n<h2 id=\"真实世界的权衡案例\">真实世界的权衡案例</h2><h3 id=\"amazon-dynamodb-的选择\">Amazon DynamoDB 的选择</h3><p>DynamoDB 是一个典型的 AP 系统。Amazon 选择牺牲强一致性来保证：</p>\n<ul>\n<li>购物车服务在任何时候都可用</li>\n<li>即使数据中心故障，用户也能继续添加商品</li>\n<li>最终一致性在大多数场景下用户无感知（毫秒级同步延迟）</li>\n</ul>\n<p>但 DynamoDB 同时也提供了强一致性读取选项（代价是更高的延迟和成本），将选择权交给开发者。</p>\n<h3 id=\"google-spanner-的突破\">Google Spanner 的突破</h3><p>Google Spanner 是第一个实现全球分布式强一致性的数据库。它通过 TrueTime API（基于原子钟和 GPS 接收器的精确时间服务）来实现全球范围内的线性一致性。这证明了在足够的工程投入下，CAP 的限制可以在实践中被大幅缓解——但其代价是极其昂贵的基础设施。</p>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((CAP 定理与权衡))&#10;    CAP 三要素&#10;      一致性 所有节点数据相同&#10;      可用性 每个请求都有响应&#10;      分区容错 网络分区时继续运行&#10;    实际选择&#10;      P 必须保证&#10;      CP 牺牲可用性&#10;      AP 牺牲一致性&#10;    一致性光谱&#10;      强一致性&#10;      线性一致性&#10;      因果一致性&#10;      最终一致性&#10;    扩展理论&#10;      PACELC 无分区时 延迟vs一致性\">mindmap\n  root((CAP 定理与权衡))\n    CAP 三要素\n      一致性 所有节点数据相同\n      可用性 每个请求都有响应\n      分区容错 网络分区时继续运行\n    实际选择\n      P 必须保证\n      CP 牺牲可用性\n      AP 牺牲一致性\n    一致性光谱\n      强一致性\n      线性一致性\n      因果一致性\n      最终一致性\n    扩展理论\n      PACELC 无分区时 延迟vs一致性</pre><ul>\n<li>CAP 定理的核心结论：在网络分区不可避免的前提下，一致性与可用性只能取其一。</li>\n<li>实际系统通常在一致性光谱中选择一个合适的级别，而非非此即彼。</li>\n<li><strong>最终一致性</strong>是最常用的折中方案，通过读时修复、反熵协议等机制实现。</li>\n<li><strong>PACELC</strong> 将 CAP 扩展到无分区场景，更贴近日常工程决策。</li>\n<li>没有&quot;最好&quot;的选择，只有最适合业务场景的权衡。</li>\n</ul>\n","headings":[{"level":1,"text":"CAP 定理与权衡","id":"cap-定理与权衡"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"CAP 定理的核心内容","id":"cap-定理的核心内容"},{"level":2,"text":"理解网络分区","id":"理解网络分区"},{"level":3,"text":"CP 系统的行为","id":"cp-系统的行为"},{"level":3,"text":"AP 系统的行为","id":"ap-系统的行为"},{"level":2,"text":"一致性模型的光谱","id":"一致性模型的光谱"},{"level":3,"text":"最终一致性的实现","id":"最终一致性的实现"},{"level":2,"text":"PACELC 定理","id":"pacelc-定理"},{"level":2,"text":"真实世界的权衡案例","id":"真实世界的权衡案例"},{"level":3,"text":"Amazon DynamoDB 的选择","id":"amazon-dynamodb-的选择"},{"level":3,"text":"Google Spanner 的突破","id":"google-spanner-的突破"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"可扩展性与可靠性","url":"/l-doc-books/h/cs-fundamentals/system-design/foundations/scalability-and-reliability"},"next":{"title":"HTTP、HTTPS 与 HTTP/2","url":"/l-doc-books/h/cs-fundamentals/system-design/networking-and-protocols/http-https-and-http2"}}