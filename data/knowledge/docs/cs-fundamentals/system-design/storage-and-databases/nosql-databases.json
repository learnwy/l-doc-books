=\"color:#032F62;--shiki-dark:#9ECBFF\">'100% 棉'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  reviews: [],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'t-shirt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'casual'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>同一个集合中的两个产品有完全不同的 <code>attributes</code> 结构——这在关系型数据库中很难优雅地表达。</p>\n<h3 id=\"mongodb-查询示例\">MongoDB 查询示例</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const aggregationPipeline = [&#10;  { $match: { category: &#39;electronics&#39;, price: { $gte: 1000 } } },&#10;  { $unwind: &#39;$reviews&#39; },&#10;  {&#10;    $group: {&#10;      _id: &#39;$_id&#39;,&#10;      name: { $first: &#39;$name&#39; },&#10;      price: { $first: &#39;$price&#39; },&#10;      avgRating: { $avg: &#39;$reviews.rating&#39; },&#10;      reviewCount: { $sum: 1 },&#10;    },&#10;  },&#10;  { $match: { avgRating: { $gte: 4.0 } } },&#10;  { $sort: { avgRating: -1 } },&#10;  { $limit: 10 },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> aggregationPipeline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $match: { category: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'electronics'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, price: { $gte: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $unwind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$reviews'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    $group: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      _id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$_id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      name: { $first: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$name'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      price: { $first: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$price'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      avgRating: { $avg: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$reviews.rating'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      reviewCount: { $sum: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $match: { avgRating: { $gte: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4.0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $sort: { avgRating: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $limit: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><hr>\n<h2 id=\"列族数据库\">列族数据库</h2><p>列族数据库（Wide-Column Store）以行键和列族为组织方式，特别适合海量数据的高吞吐写入和时间序列查询。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph Cassandra 数据模型&#10;        Row1[行键: user_001]&#10;        CF1[列族: profile&lt;br/&gt;name=张三&lt;br/&gt;email=zhang@example.com]&#10;        CF2[列族: activity&lt;br/&gt;2026-03-30T10:00=login&lt;br/&gt;2026-03-30T10:05=view_page&lt;br/&gt;2026-03-30T10:10=purchase]&#10;&#10;        Row1 --&gt; CF1&#10;        Row1 --&gt; CF2&#10;    end\">graph TB\n    subgraph Cassandra 数据模型\n        Row1[行键: user_001]\n        CF1[列族: profile&lt;br/&gt;name=张三&lt;br/&gt;email=zhang@example.com]\n        CF2[列族: activity&lt;br/&gt;2026-03-30T10:00=login&lt;br/&gt;2026-03-30T10:05=view_page&lt;br/&gt;2026-03-30T10:10=purchase]\n\n        Row1 --&gt; CF1\n        Row1 --&gt; CF2\n    end</pre><p><strong>Cassandra</strong> 的核心设计理念：</p>\n<table>\n<thead>\n<tr>\n<th>特性</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>无主节点</td>\n<td>所有节点对等，没有单点故障</td>\n</tr>\n<tr>\n<td>可调一致性</td>\n<td>每次读写可指定一致性级别（ONE, QUORUM, ALL）</td>\n</tr>\n<tr>\n<td>线性扩展</td>\n<td>增加节点即可线性提升吞吐量</td>\n</tr>\n<tr>\n<td>优化写入</td>\n<td>LSM-Tree 存储引擎，写入性能极高</td>\n</tr>\n</tbody></table>\n<p>适用场景：IoT 传感器数据、用户活动日志、时间序列数据、消息系统。</p>\n<hr>\n<h2 id=\"图数据库\">图数据库</h2><p>图数据库以节点（Node）和边（Edge）为核心模型，天然适合表达实体之间的复杂关系。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    Alice((Alice)) --&gt;|关注| Bob((Bob))&#10;    Alice --&gt;|关注| Charlie((Charlie))&#10;    Bob --&gt;|关注| Charlie&#10;    Charlie --&gt;|关注| Alice&#10;    Alice --&gt;|点赞| Post1[Post: 系统设计入门]&#10;    Bob --&gt;|撰写| Post1&#10;    Charlie --&gt;|评论| Post1\">graph LR\n    Alice((Alice)) --&gt;|关注| Bob((Bob))\n    Alice --&gt;|关注| Charlie((Charlie))\n    Bob --&gt;|关注| Charlie\n    Charlie --&gt;|关注| Alice\n    Alice --&gt;|点赞| Post1[Post: 系统设计入门]\n    Bob --&gt;|撰写| Post1\n    Charlie --&gt;|评论| Post1</pre><div class=\"code-block-wrapper\" data-lang=\"cypher\" data-code=\"// Neo4j Cypher 查询：找到共同好友&#10;MATCH (a:User {name: &#39;Alice&#39;})-[:FOLLOWS]-&gt;(mutual)&lt;-[:FOLLOWS]-(b:User {name: &#39;Bob&#39;})&#10;RETURN mutual.name&#10;&#10;// 推荐可能认识的人（好友的好友，但不是自己的好友）&#10;MATCH (me:User {name: &#39;Alice&#39;})-[:FOLLOWS]-&gt;()-[:FOLLOWS]-&gt;(recommended)&#10;WHERE NOT (me)-[:FOLLOWS]-&gt;(recommended) AND me &lt;&gt; recommended&#10;RETURN recommended.name, COUNT(*) AS mutualFriends&#10;ORDER BY mutualFriends DESC&#10;LIMIT 10\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// Neo4j Cypher 查询：找到共同好友</span></span>\n<span class=\"line\"><span>MATCH (a:User {name: 'Alice'})-[:FOLLOWS]->(mutual)&#x3C;-[:FOLLOWS]-(b:User {name: 'Bob'})</span></span>\n<span class=\"line\"><span>RETURN mutual.name</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 推荐可能认识的人（好友的好友，但不是自己的好友）</span></span>\n<span class=\"line\"><span>MATCH (me:User {name: 'Alice'})-[:FOLLOWS]->()-[:FOLLOWS]->(recommended)</span></span>\n<span class=\"line\"><span>WHERE NOT (me)-[:FOLLOWS]->(recommended) AND me &#x3C;> recommended</span></span>\n<span class=\"line\"><span>RETURN recommended.name, COUNT(*) AS mutualFriends</span></span>\n<span class=\"line\"><span>ORDER BY mutualFriends DESC</span></span>\n<span class=\"line\"><span>LIMIT 10</span></span></code></pre></div><p>关系型数据库处理这类多跳关系查询需要大量 JOIN 操作，性能随深度指数级下降。图数据库通过直接遍历边来完成查询，性能与数据总量无关，只与遍历的局部图大小有关。</p>\n<hr>\n<h2 id=\"选型对比\">选型对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>关系型</th>\n<th>键值</th>\n<th>文档</th>\n<th>列族</th>\n<th>图</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数据模型</td>\n<td>表/行/列</td>\n<td>Key-Value</td>\n<td>JSON 文档</td>\n<td>行键 + 列族</td>\n<td>节点 + 边</td>\n</tr>\n<tr>\n<td>Schema</td>\n<td>固定 Schema</td>\n<td>无 Schema</td>\n<td>灵活 Schema</td>\n<td>半结构化</td>\n<td>灵活</td>\n</tr>\n<tr>\n<td>查询能力</td>\n<td>SQL，复杂查询</td>\n<td>仅按 Key 查找</td>\n<td>丰富查询和聚合</td>\n<td>按行键和列族查询</td>\n<td>图遍历</td>\n</tr>\n<tr>\n<td>扩展性</td>\n<td>垂直为主</td>\n<td>水平扩展简单</td>\n<td>水平扩展</td>\n<td>线性水平扩展</td>\n<td>有限</td>\n</tr>\n<tr>\n<td>一致性</td>\n<td>强一致（ACID）</td>\n<td>取决于实现</td>\n<td>可调</td>\n<td>可调</td>\n<td>通常强一致</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>核心业务、财务</td>\n<td>缓存、会话</td>\n<td>内容管理、产品目录</td>\n<td>日志、时序数据</td>\n<td>社交网络、推荐</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((NoSQL 数据库))&#10;    键值存储&#10;      极高性能&#10;      缓存 会话 计数器&#10;      Redis DynamoDB&#10;    文档数据库&#10;      灵活 Schema&#10;      快速迭代&#10;      MongoDB Firestore&#10;    列族数据库&#10;      海量写入&#10;      时序数据&#10;      Cassandra HBase&#10;    图数据库&#10;      关系查询&#10;      社交 推荐&#10;      Neo4j Neptune\">mindmap\n  root((NoSQL 数据库))\n    键值存储\n      极高性能\n      缓存 会话 计数器\n      Redis DynamoDB\n    文档数据库\n      灵活 Schema\n      快速迭代\n      MongoDB Firestore\n    列族数据库\n      海量写入\n      时序数据\n      Cassandra HBase\n    图数据库\n      关系查询\n      社交 推荐\n      Neo4j Neptune</pre><ul>\n<li>NoSQL 不是关系型数据库的替代品，而是<strong>互补方案</strong>。</li>\n<li><strong>键值存储</strong>适合高性能缓存和简单 KV 操作。</li>\n<li><strong>文档数据库</strong>适合 Schema 频繁变化的内容管理场景。</li>\n<li><strong>列族数据库</strong>适合海量写入和时间序列数据。</li>\n<li><strong>图数据库</strong>适合多跳关系查询和推荐系统。</li>\n<li>大型系统通常<strong>混合使用</strong>多种数据库（Polyglot Persistence）。</li>\n</ul>\n","headings":[{"level":1,"text":"NoSQL 数据库","id":"nosql-数据库"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要 NoSQL","id":"为什么需要-nosql"},{"level":2,"text":"键值存储","id":"键值存储"},{"level":2,"text":"文档数据库","id":"文档数据库"},{"level":3,"text":"MongoDB 查询示例","id":"mongodb-查询示例"},{"level":2,"text":"列族数据库","id":"列族数据库"},{"level":2,"text":"图数据库","id":"图数据库"},{"level":2,"text":"选型对比","id":"选型对比"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"关系型数据库","url":"/l-doc-books/h/cs-fundamentals/system-design/storage-and-databases/relational-databases"},"next":{"title":"缓存策略","url":"/l-doc-books/h/cs-fundamentals/system-design/storage-and-databases/caching-strategies"}}