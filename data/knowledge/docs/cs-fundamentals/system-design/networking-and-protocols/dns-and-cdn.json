--shiki-dark:#E1E4E8\">    varyHeaders: [],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    path: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/public/*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    maxAge: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    staleWhileRevalidate: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    staleIfError: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3600</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    varyHeaders: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Accept'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Accept-Language'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    path: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/images/*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    maxAge: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">604800</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    staleWhileRevalidate: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">86400</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    staleIfError: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">604800</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    varyHeaders: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Accept'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateCacheHeader</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CDNCacheConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    `max-age=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">config</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">maxAge</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    `stale-while-revalidate=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">config</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">staleWhileRevalidate</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    `stale-if-error=${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">config</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">staleIfError</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">', '</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"cdn-在系统架构中的位置\">CDN 在系统架构中的位置</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    Users[全球用户] --&gt; DNS[DNS&lt;br/&gt;智能解析]&#10;    DNS --&gt; Edge1[边缘节点 亚洲]&#10;    DNS --&gt; Edge2[边缘节点 欧洲]&#10;    DNS --&gt; Edge3[边缘节点 美洲]&#10;&#10;    Edge1 --&gt; LB[负载均衡器]&#10;    Edge2 --&gt; LB&#10;    Edge3 --&gt; LB&#10;&#10;    LB --&gt; API[API 服务器集群]&#10;    API --&gt; Cache[(Redis 缓存)]&#10;    API --&gt; DB[(数据库)]&#10;    API --&gt; Storage[(对象存储&lt;br/&gt;S3/OSS)]&#10;&#10;    Storage -.-&gt;|源站| Edge1&#10;    Storage -.-&gt;|源站| Edge2&#10;    Storage -.-&gt;|源站| Edge3\">flowchart TB\n    Users[全球用户] --&gt; DNS[DNS&lt;br/&gt;智能解析]\n    DNS --&gt; Edge1[边缘节点 亚洲]\n    DNS --&gt; Edge2[边缘节点 欧洲]\n    DNS --&gt; Edge3[边缘节点 美洲]\n\n    Edge1 --&gt; LB[负载均衡器]\n    Edge2 --&gt; LB\n    Edge3 --&gt; LB\n\n    LB --&gt; API[API 服务器集群]\n    API --&gt; Cache[(Redis 缓存)]\n    API --&gt; DB[(数据库)]\n    API --&gt; Storage[(对象存储&lt;br/&gt;S3/OSS)]\n\n    Storage -.-&gt;|源站| Edge1\n    Storage -.-&gt;|源站| Edge2\n    Storage -.-&gt;|源站| Edge3</pre><hr>\n<h2 id=\"真实世界案例\">真实世界案例</h2><h3 id=\"netflix-的-cdn-策略\">Netflix 的 CDN 策略</h3><p>Netflix 使用自建的 CDN（Open Connect）来分发视频内容：</p>\n<ul>\n<li>在全球 ISP 的数据中心部署专用缓存设备</li>\n<li>在非高峰时段预热热门内容到边缘节点</li>\n<li>单个边缘服务器可提供 100Gbps 的视频流量</li>\n<li>通过 DNS 将用户路由到最近的缓存节点</li>\n</ul>\n<h3 id=\"cloudflare-的-anycast-dns\">Cloudflare 的 Anycast DNS</h3><p>Cloudflare 使用 Anycast 技术，同一个 IP 地址在全球多个位置广播。用户的请求自动被路由到地理位置最近的节点，无需在 DNS 层做地理路由——这大幅简化了全球负载均衡的复杂度。</p>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((DNS 与 CDN))&#10;    DNS&#10;      域名解析流程&#10;      记录类型 A CNAME MX&#10;      基于 DNS 的负载均衡&#10;      TTL 与缓存权衡&#10;    CDN&#10;      Push vs Pull&#10;      边缘缓存&#10;      降低延迟&#10;      减轻源站压力&#10;    系统设计应用&#10;      地理路由&#10;      故障转移&#10;      静态资源加速\">mindmap\n  root((DNS 与 CDN))\n    DNS\n      域名解析流程\n      记录类型 A CNAME MX\n      基于 DNS 的负载均衡\n      TTL 与缓存权衡\n    CDN\n      Push vs Pull\n      边缘缓存\n      降低延迟\n      减轻源站压力\n    系统设计应用\n      地理路由\n      故障转移\n      静态资源加速</pre><ul>\n<li><strong>DNS</strong> 是互联网的寻址基础，也是实现全球负载均衡和故障转移的关键工具。</li>\n<li><strong>TTL</strong> 的选择需要权衡更新速度与查询开销。</li>\n<li><strong>CDN</strong> 通过边缘缓存将内容推送到离用户最近的位置，大幅降低延迟。</li>\n<li><strong>Push CDN</strong> 适合已知的静态资源，<strong>Pull CDN</strong> 适合动态和长尾内容。</li>\n<li>DNS + CDN 的组合是几乎所有大规模系统的标配基础设施。</li>\n</ul>\n","headings":[{"level":1,"text":"DNS 与 CDN","id":"dns-与-cdn"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"DNS：互联网的电话簿","id":"dns-互联网的电话簿"},{"level":3,"text":"DNS 解析流程","id":"dns-解析流程"},{"level":3,"text":"DNS 记录类型","id":"dns-记录类型"},{"level":3,"text":"DNS 在系统设计中的作用","id":"dns-在系统设计中的作用"},{"level":3,"text":"DNS 缓存与 TTL","id":"dns-缓存与-ttl"},{"level":2,"text":"CDN：让内容离用户更近","id":"cdn-让内容离用户更近"},{"level":3,"text":"CDN 工作原理","id":"cdn-工作原理"},{"level":3,"text":"Push vs Pull CDN","id":"push-vs-pull-cdn"},{"level":3,"text":"CDN 缓存策略","id":"cdn-缓存策略"},{"level":3,"text":"CDN 在系统架构中的位置","id":"cdn-在系统架构中的位置"},{"level":2,"text":"真实世界案例","id":"真实世界案例"},{"level":3,"text":"Netflix 的 CDN 策略","id":"netflix-的-cdn-策略"},{"level":3,"text":"Cloudflare 的 Anycast DNS","id":"cloudflare-的-anycast-dns"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"TCP、UDP 与 WebSocket","url":"/l-doc-books/h/cs-fundamentals/system-design/networking-and-protocols/tcp-udp-and-websocket"},"next":{"title":"REST、GraphQL 与 gRPC","url":"/l-doc-books/h/cs-fundamentals/system-design/networking-and-protocols/rest-graphql-grpc"}}