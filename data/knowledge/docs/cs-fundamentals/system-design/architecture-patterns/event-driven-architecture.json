hiki-dark:#B392F0\">findByField</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'orders'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'userId'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, query.params.userId </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EventStore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">stream</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReadDatabase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  findById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">collection</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  findByField</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">collection</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">field</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>CQRS 的典型应用场景：读写比例极度不平衡（如电商商品页读写比 1000:1）、读写模型差异大（写入是事件，读取需要聚合视图）。</p>\n<hr>\n<h2 id=\"saga-模式\">Saga 模式</h2><p>在微服务 + 事件驱动架构中，跨服务的分布式事务无法使用传统的 ACID 事务。Saga 模式通过一系列本地事务 + 补偿操作来实现最终一致性：</p>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant OS as 订单服务&#10;    participant IS as 库存服务&#10;    participant PS as 支付服务&#10;    participant NS as 通知服务&#10;&#10;    OS-&gt;&gt;OS: 创建订单(待确认)&#10;    OS-&gt;&gt;IS: 扣减库存&#10;    IS--&gt;&gt;OS: 库存扣减成功&#10;    OS-&gt;&gt;PS: 发起支付&#10;    PS--xOS: 支付失败&#10;&#10;    Note over OS,PS: 触发补偿操作&#10;    OS-&gt;&gt;IS: 回滚库存&#10;    IS--&gt;&gt;OS: 库存已恢复&#10;    OS-&gt;&gt;OS: 取消订单&#10;    OS-&gt;&gt;NS: 通知用户支付失败\">sequenceDiagram\n    participant OS as 订单服务\n    participant IS as 库存服务\n    participant PS as 支付服务\n    participant NS as 通知服务\n\n    OS-&gt;&gt;OS: 创建订单(待确认)\n    OS-&gt;&gt;IS: 扣减库存\n    IS--&gt;&gt;OS: 库存扣减成功\n    OS-&gt;&gt;PS: 发起支付\n    PS--xOS: 支付失败\n\n    Note over OS,PS: 触发补偿操作\n    OS-&gt;&gt;IS: 回滚库存\n    IS--&gt;&gt;OS: 库存已恢复\n    OS-&gt;&gt;OS: 取消订单\n    OS-&gt;&gt;NS: 通知用户支付失败</pre><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((事件驱动架构))&#10;    核心概念&#10;      事件发布订阅&#10;      松耦合异步协作&#10;    事件溯源&#10;      存储事件而非状态&#10;      完整审计追踪&#10;      可回放到任意时间点&#10;    CQRS&#10;      读写分离模型&#10;      优化读写性能&#10;    Saga&#10;      分布式事务替代方案&#10;      本地事务 + 补偿\">mindmap\n  root((事件驱动架构))\n    核心概念\n      事件发布订阅\n      松耦合异步协作\n    事件溯源\n      存储事件而非状态\n      完整审计追踪\n      可回放到任意时间点\n    CQRS\n      读写分离模型\n      优化读写性能\n    Saga\n      分布式事务替代方案\n      本地事务 + 补偿</pre><ul>\n<li><strong>事件驱动架构</strong>通过事件实现服务间的松耦合异步协作。</li>\n<li><strong>事件溯源</strong>存储所有状态变化事件，当前状态通过回放事件计算。</li>\n<li><strong>CQRS</strong> 将读写模型分离，分别优化读和写的性能。</li>\n<li><strong>Saga</strong> 模式通过补偿操作解决微服务中的分布式事务问题。</li>\n<li>事件驱动架构增加了系统的复杂度——只在真正需要解耦和异步的场景中使用。</li>\n</ul>\n","headings":[{"level":1,"text":"事件驱动架构","id":"事件驱动架构"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"从请求驱动到事件驱动","id":"从请求驱动到事件驱动"},{"level":3,"text":"核心优势","id":"核心优势"},{"level":2,"text":"事件的分类","id":"事件的分类"},{"level":2,"text":"事件溯源（Event Sourcing）","id":"事件溯源-event-sourcing"},{"level":3,"text":"事件溯源的优势与挑战","id":"事件溯源的优势与挑战"},{"level":2,"text":"CQRS（命令查询职责分离）","id":"cqrs-命令查询职责分离"},{"level":2,"text":"Saga 模式","id":"saga-模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"单体与微服务","url":"/l-doc-books/h/cs-fundamentals/system-design/architecture-patterns/monolith-vs-microservices"},"next":{"title":"Serverless 与 FaaS","url":"/l-doc-books/h/cs-fundamentals/system-design/architecture-patterns/serverless-and-faas"}}