">}</span></span></code></pre></div><h3 id=\"事件溯源的优势与挑战\">事件溯源的优势与挑战</h3><table>\n<thead>\n<tr>\n<th>优势</th>\n<th>挑战</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>完整审计日志</td>\n<td>事件数量随时间增长</td>\n</tr>\n<tr>\n<td>可以回放到任意时间点</td>\n<td>需要快照机制优化性能</td>\n</tr>\n<tr>\n<td>天然支持时间旅行调试</td>\n<td>事件 Schema 演进复杂</td>\n</tr>\n<tr>\n<td>不会丢失业务信息</td>\n<td>需要转变思维方式</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"cqrs-命令查询职责分离\">CQRS（命令查询职责分离）</h2><p>CQRS 将系统的读操作和写操作使用不同的模型和存储来处理：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    Client[客户端]&#10;&#10;    Client --&gt;|写请求| CommandSide&#10;    Client --&gt;|读请求| QuerySide&#10;&#10;    subgraph CommandSide[命令端]&#10;        CMD[命令处理器] --&gt; ES[(事件存储)]&#10;    end&#10;&#10;    subgraph QuerySide[查询端]&#10;        QH[查询处理器] --&gt; ReadDB[(读模型数据库)]&#10;    end&#10;&#10;    ES --&gt;|事件投影| ReadDB\">flowchart TB\n    Client[客户端]\n\n    Client --&gt;|写请求| CommandSide\n    Client --&gt;|读请求| QuerySide\n\n    subgraph CommandSide[命令端]\n        CMD[命令处理器] --&gt; ES[(事件存储)]\n    end\n\n    subgraph QuerySide[查询端]\n        QH[查询处理器] --&gt; ReadDB[(读模型数据库)]\n    end\n\n    ES --&gt;|事件投影| ReadDB</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface Command {&#10;  type: string;&#10;  payload: unknown;&#10;}&#10;&#10;interface Query {&#10;  type: string;&#10;  params: Record&lt;string, unknown&gt;;&#10;}&#10;&#10;class OrderCommandHandler {&#10;  constructor(private eventStore: EventStore) {}&#10;&#10;  async handle(command: Command): Promise&lt;void&gt; {&#10;    switch (command.type) {&#10;      case &#39;CreateOrder&#39;: {&#10;        const event = {&#10;          type: &#39;OrderCreated&#39;,&#10;          data: command.payload,&#10;          timestamp: Date.now(),&#10;        };&#10;        await this.eventStore.append(&#39;orders&#39;, event);&#10;        break;&#10;      }&#10;    }&#10;  }&#10;}&#10;&#10;class OrderQueryHandler {&#10;  constructor(private readDb: ReadDatabase) {}&#10;&#10;  async handle(query: Query): Promise&lt;unknown&gt; {&#10;    switch (query.type) {&#10;      case &#39;GetOrderById&#39;:&#10;        return this.readDb.findById(&#39;orders&#39;, query.params.id as string);&#10;      case &#39;GetUserOrders&#39;:&#10;        return this.readDb.findByField(&#39;orders&#39;, &#39;userId&#39;, query.params.userId as string);&#10;    }&#10;  }&#10;}&#10;&#10;interface EventStore {&#10;  append(stream: string, event: Record&lt;string, unknown&gt;): Promise&lt;void&gt;;&#10;}&#10;&#10;interface ReadDatabase {&#10;  findById(collection: string, id: string): Promise&lt;unknown&gt;;&#10;  findByField(collection: string, field: string, value: string): Promise&lt;unknown&gt;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Command</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  payload</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Query</span><span style=\"color:#24292E;--shiki-d