n style=\"color:#24292E;--shiki-dark:#E1E4E8\">    keyAlgorithms: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'单调栈'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'单调队列'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph 数据结构决策树&#10;        A{&quot;输入是什么?&quot;} --&gt;|数组/字符串| B[&quot;排序? 双指针? 滑动窗口?&quot;]&#10;        A --&gt;|链表| C[&quot;快慢指针? 反转? 合并?&quot;]&#10;        A --&gt;|树| D[&quot;DFS? BFS? 分治?&quot;]&#10;        A --&gt;|图| E[&quot;BFS? DFS? 最短路?&quot;]&#10;        A --&gt;|需要动态取极值| F[&quot;堆/优先队列&quot;]&#10;        A --&gt;|需要 LIFO/FIFO| G[&quot;栈/队列&quot;]&#10;    end\">flowchart TD\n    subgraph 数据结构决策树\n        A{\"输入是什么?\"} --&gt;|数组/字符串| B[\"排序? 双指针? 滑动窗口?\"]\n        A --&gt;|链表| C[\"快慢指针? 反转? 合并?\"]\n        A --&gt;|树| D[\"DFS? BFS? 分治?\"]\n        A --&gt;|图| E[\"BFS? DFS? 最短路?\"]\n        A --&gt;|需要动态取极值| F[\"堆/优先队列\"]\n        A --&gt;|需要 LIFO/FIFO| G[\"栈/队列\"]\n    end</pre><h2 id=\"按算法范式分类\">按算法范式分类</h2><p>算法范式是更高层次的分类维度，决定了解题的整体框架。</p>\n<table>\n<thead>\n<tr>\n<th>范式</th>\n<th>识别特征</th>\n<th>核心思想</th>\n<th>典型题型</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>贪心</td>\n<td>局部最优→全局最优</td>\n<td>每步选当前最好的</td>\n<td>区间调度、活动选择、跳跃游戏</td>\n</tr>\n<tr>\n<td>动态规划</td>\n<td>最优子结构+重叠子问题</td>\n<td>拆分子问题+记忆化</td>\n<td>背包、LCS、编辑距离</td>\n</tr>\n<tr>\n<td>回溯搜索</td>\n<td>所有方案/排列组合</td>\n<td>枚举+剪枝</td>\n<td>全排列、组合总和、N 皇后</td>\n</tr>\n<tr>\n<td>分治</td>\n<td>问题可均分为子问题</td>\n<td>分→治→合</td>\n<td>归并排序、快排、最近点对</td>\n</tr>\n<tr>\n<td>二分</td>\n<td>有序性或单调性</td>\n<td>缩小搜索范围</td>\n<td>搜索、最小化最大值</td>\n</tr>\n<tr>\n<td>图论</td>\n<td>节点+边的关系</td>\n<td>遍历/最短路/连通性</td>\n<td>岛屿、课程表、网络延迟</td>\n</tr>\n</tbody></table>\n<p>贪心 vs 动态规划的判断——这是最常见的困惑：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const greedyVsDp = {&#10;  greedy: {&#10;    signal: &#39;每步选择不影响后续最优性&#39;,&#10;    proof: &#39;需要证明贪心选择性质和最优子结构&#39;,&#10;    examples: [&#39;活动选择&#39;, &#39;霍夫曼编码&#39;, &#39;区间调度&#39;],&#10;  },&#10;  dp: {&#10;    signal: &#39;当前选择影响后续可选范围&#39;,&#10;    proof: &#39;需要定义状态和转移方程&#39;,&#10;    examples: [&#39;背包问题&#39;, &#39;股票买卖&#39;, &#39;编辑距离&#39;],&#10;  },&#10;  ambiguous: {&#10;    tip: &#39;先尝试贪心，找反例。找不到反例就实现贪心；找到反例就转DP&#39;,&#10;    examples: [&#39;跳跃游戏I可贪心&#39;, &#39;跳跃游戏II可贪心&#39;, &#39;背包不能贪心&#39;],&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> greedyVsDp</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  greedy: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    signal: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'每步选择不影响后续最优性'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    proof: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'需要证明贪心选择性质和最优子结构'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    examples: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'活动选择'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'霍夫曼编码'</span><span style=\"color:#24292E;-