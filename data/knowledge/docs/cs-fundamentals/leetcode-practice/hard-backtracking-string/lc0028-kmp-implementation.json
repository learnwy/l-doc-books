A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pattern.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> next</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> len </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pattern[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pattern[len]) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      len</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      next[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> len;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (len </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      len </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> next[len </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      next[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> next;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong><code>buildNext</code> 函数的逐步解析：</strong></p>\n<ul>\n<li><code>len</code> 追踪当前最长相等前后缀的长度，初始为 0。</li>\n<li>当 <code>pattern[i] === pattern[len]</code> 时，前后缀可以扩展，<code>len++</code>，记录 <code>next[i] = len</code>。</li>\n<li>当不匹配且 <code>len &gt; 0</code> 时，回退到 <code>next[len-1]</code>——这是 KMP 的精髓，利用已有的 next 信息避免从头比较。</li>\n<li>当不匹配且 <code>len === 0</code> 时，说明没有任何相等前后缀，<code>next[i] = 0</code>。</li>\n</ul>\n<p><strong>匹配阶段的逻辑：</strong></p>\n<ul>\n<li><code>i</code> 遍历主串（永不回退），<code>j</code> 指向模式串当前待匹配位置。</li>\n<li>失配时，<code>j</code> 跳转到 <code>next[j-1]</code>，相当于将模式串右移，对齐已匹配的前缀。</li>\n<li>当 <code>j === n</code> 时，完整匹配成功，返回起始位置 <code>i - n + 1</code>。</li>\n</ul>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>复杂度</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间（预处理）</td>\n<td>O(n)</td>\n<td>构建 next 数组，每个字符最多被处理两次</td>\n</tr>\n<tr>\n<td>时间（匹配）</td>\n<td>O(m)</td>\n<td>主串指针 <code>i</code> 只前进不后退</td>\n</tr>\n<tr>\n<td>总时间</td>\n<td>O(m + n)</td>\n<td>两阶段之和</td>\n</tr>\n<tr>\n<td>空间</td>\n<td>O(n)</td>\n<td>next 数组大小等于模式串长度</td>\n</tr>\n</tbody></table>\n<p>KMP 算法的时间复杂度证明依赖于摊还分析：在匹配阶段，<code>j</code> 每次通过 <code>while</code> 循环减小至少 1，而 <code>j</code> 通过 <code>j++</code> 增加的总次数不超过 m，因此 <code>while</code> 循环的总执行次数也不超过 m，整体为 O(m)。<code>buildNext</code> 的分析同理。</p>\n<p>KMP 算法不仅是字符串匹配的基础工具，其 next 数组（也称为失败函数或部分匹配表）在许多高级算法中都有应用，包括 AC 自动机的构建、最短循环节的计算（<code>n % (n - next[n-1]) === 0</code> 时循环节长度为 <code>n - next[n-1]</code>），以及字符串的周期性分析。</p>\n","headings":[{"level":1,"text":"LeetCode 28 KMP 字符串匹配","id":"leetcode-28-kmp-字符串匹配"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 60 排列序列","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-backtracking-string/lc0060-permutation-sequence"},"next":{"title":"LeetCode 214 最短回文串","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-backtracking-string/lc0214-shortest-palindrome"}}