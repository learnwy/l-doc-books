n style=\"color:#6F42C1;--shiki-dark:#B392F0\">reverse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> matchIdx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> reverseMap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(revRight);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (matchIdx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> undefined</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matchIdx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([matchIdx, i]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> isPalindrome</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> l </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (l </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (s[l] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s[r]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    l</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">--</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>实现要点：</p>\n<ul>\n<li><strong>反转映射</strong>：将每个单词的反转作为 key，原始索引作为 value 存入 Map。查找时直接用子串查询，O(1) 匹配。</li>\n<li><strong>分割枚举</strong>：对于长度为 k 的单词，枚举 k+1 个分割点。<code>j=0</code> 表示左半为空，<code>j=len</code> 表示右半为空。</li>\n<li><strong>避免重复</strong>：右半部分回文时，<code>j=0</code> 涵盖了等长完全匹配的情况。左半部分回文的检查中 <code>j &gt; 0</code> 避免与前一种情况重复。</li>\n<li><strong>自身排除</strong>：<code>matchIdx !== i</code> 确保不会将单词与自身配对。</li>\n</ul>\n<p><strong>为什么需要两个方向的检查？</strong> 当 <code>word[i]</code> 放在左边时，需要右半部分是回文并在字典中找到左半部分的反转。当 <code>word[i]</code> 放在右边时，需要左半部分是回文并在字典中找到右半部分的反转。两个方向的逻辑互补，共同覆盖所有可能的回文对。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>复杂度</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间</td>\n<td>O(n × k²)</td>\n<td>n 个单词，每个枚举 k 个分割点，每次回文检查和字符串反转 O(k)</td>\n</tr>\n<tr>\n<td>空间</td>\n<td>O(n × k)</td>\n<td>哈希表存储 n 个反转字符串</td>\n</tr>\n</tbody></table>\n<p>其中 n 为单词数量，k 为单词平均长度。相比暴力的 O(n² × k)，当 k 远小于 n 时（本题 k ≤ 300, n ≤ 5000），哈希表方法有显著优势。</p>\n<p>本题还有字典树（Trie）解法，将所有单词的反转插入字典树中。搜索时，对于每个单词沿字典树往下走，在每个节点检查剩余部分是否为回文。字典树方法的时间复杂度相同，但在实际运行中由于避免了大量字符串创建和哈希计算，通常更快。此外，字典树天然处理了前缀匹配，代码逻辑可能更清晰。</p>\n","headings":[{"level":1,"text":"LeetCode 336 回文对","id":"leetcode-336-回文对"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 214 最短回文串","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-backtracking-string/lc0214-shortest-palindrome"},"next":{"title":"LeetCode 4 寻找两个正序数组的中位数","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-comprehensive/lc0004-median-of-two-sorted-arrays"}}