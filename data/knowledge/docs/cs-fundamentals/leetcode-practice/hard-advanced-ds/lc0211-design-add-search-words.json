:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">index</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">node</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TrieNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> word.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node.isEnd;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ch</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> word[index];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (ch </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '.'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> child</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node.children.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">values</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dfs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(word, index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, child)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">node.children.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ch)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dfs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(word, index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, node.children.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ch)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>dfs</code> 方法是本题的核心。它接受三个参数：待搜索的单词、当前处理到的字符索引、当前 Trie 节点。</p>\n<p>当遇到 <code>.</code> 时的分支搜索过程可以用一个例子来理解：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"已插入：bad, dad, mad&#10;Trie 结构：&#10;  root → b → a → d(end)&#10;       → d → a → d(end)&#10;       → m → a → d(end)&#10;&#10;搜索 &quot;.ad&quot;：&#10;  i=0, ch=&#39;.&#39;: 尝试所有子节点 b, d, m&#10;    → 走 b: i=1, ch=&#39;a&#39; → 走 a: i=2, ch=&#39;d&#39; → 走 d: isEnd=true → 返回 true&#10;  （找到匹配，立即返回 true）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>已插入：bad, dad, mad</span></span>\n<span class=\"line\"><span>Trie 结构：</span></span>\n<span class=\"line\"><span>  root → b → a → d(end)</span></span>\n<span class=\"line\"><span>       → d → a → d(end)</span></span>\n<span class=\"line\"><span>       → m → a → d(end)</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>搜索 \".ad\"：</span></span>\n<span class=\"line\"><span>  i=0, ch='.': 尝试所有子节点 b, d, m</span></span>\n<span class=\"line\"><span>    → 走 b: i=1, ch='a' → 走 a: i=2, ch='d' → 走 d: isEnd=true → 返回 true</span></span>\n<span class=\"line\"><span>  （找到匹配，立即返回 true）</span></span></code></pre></div><p>由于一旦找到匹配就立即返回，实际性能通常比最差情况好得多。在最差情况下（如搜索 &quot;...&quot; 且 Trie 中存储了大量 3 字符单词），需要遍历所有路径。</p>\n<p><strong>优化思路：</strong> 如果通配符搜索非常频繁且性能要求高，可以考虑按单词长度分组存储，或者使用更高级的数据结构如后缀自动机。但对于本题的数据范围，Trie + DFS 的方案已经足够高效。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>操作</th>\n<th>时间复杂度</th>\n<th>空间复杂度</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>addWord</td>\n<td>O(m)</td>\n<td>O(m)</td>\n<td>标准 Trie 插入</td>\n</tr>\n<tr>\n<td>search（无通配符）</td>\n<td>O(m)</td>\n<td>O(m)</td>\n<td>递归栈深度 m</td>\n</tr>\n<tr>\n<td>search（有通配符）</td>\n<td>O(26^d × m)</td>\n<td>O(m)</td>\n<td>d 为通配符数量</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度说明：</strong> <code>addWord</code> 始终是 O(m)。<code>search</code> 的复杂度取决于通配符的数量 <code>d</code>。每个通配符可能分叉为最多 26 条路径，因此最差情况为 O(26^d)。但实际中 Trie 的分支因子远小于 26（因为不是所有字母组合都对应有效单词），所以实际性能通常很好。</p>\n<p><strong>空间复杂度说明：</strong> Trie 本身的空间为 O(N × m)，其中 N 为插入的单词数量，m 为平均长度。搜索操作的额外空间为递归栈 O(m)。</p>\n<p><strong>与正则表达式的对比：</strong> 本题的 <code>.</code> 通配符类似于正则表达式中的 <code>.</code>。但 Trie + DFS 的方案比通用正则引擎更高效，因为它利用了 Trie 的前缀共享结构来剪枝。</p>\n","headings":[{"level":1,"text":"LeetCode 211 添加与搜索单词","id":"leetcode-211-添加与搜索单词"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 208 实现 Trie（前缀树）","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-advanced-ds/lc0208-implement-trie"},"next":{"title":"LeetCode 212 单词搜索 II","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-advanced-ds/lc0212-word-search-ii"}}