rk:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(u)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> newCost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cost </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (newCost </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dist[v]) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          dist[v] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> newCost;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([v, newCost]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    stops</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dist[dst] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Infinity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dist[dst];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Bellman-Ford 变体</th>\n<th>BFS 分层遍历</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O((k+1) × E)</td>\n<td>O(k × E)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(V)</td>\n<td>O(V + E)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> Bellman-Ford 变体执行 k+1 轮松弛，每轮遍历所有边。在本题约束下，k &lt; n ≤ 100，E ≤ n(n-1)/2 ≈ 4950，因此最坏情况约 100 × 5000 = 50 万次操作，非常高效。</p>\n<p><strong>空间复杂度详解：</strong> Bellman-Ford 只需要维护两个长度为 V 的数组（当前距离和上一轮距离），空间复杂度 O(V)。BFS 需要额外的邻接表和队列空间。</p>\n<p><strong>关键陷阱：</strong> 松弛时必须使用上一轮的快照 <code>prev</code>，否则同一轮内的连锁更新会导致实际中转次数超过 k。这是本题最容易犯的错误。</p>\n","headings":[{"level":1,"text":"LeetCode 787 K 站中转内最便宜的航班","id":"leetcode-787-k-站中转内最便宜的航班"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 743 网络延迟时间","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-graph-advanced/lc0743-network-delay-time"},"next":{"title":"LeetCode 332 重新安排行程","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-graph-advanced/lc0332-reconstruct-itinerary"}}