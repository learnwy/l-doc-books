 style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">di</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dj</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dirs) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> di;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ny</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dj;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (nx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> m </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ny </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ny </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matrix[nx][ny] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> matrix[x][y]) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          outDegree[nx][ny]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">--</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (outDegree[nx][ny] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([nx, ny]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> layers;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>BFS 解法详解：</strong></p>\n<p>BFS 方法将问题反转——从&quot;最大值&quot;开始，逆向扩展。<code>outDegree[i][j]</code> 表示从 <code>(i, j)</code> 可以到达的更大值邻居数量。出度为 0 的格子是&quot;路径终点&quot;（局部最大值）。</p>\n<p>BFS 从所有终点开始，每层将&quot;已处理&quot;节点的邻居出度减 1。当邻居出度降为 0 时入队。BFS 的层数就是最长路径。</p>\n<p>这个思路类似于求 DAG 最长路径的经典方法——反向拓扑排序。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>记忆化 DFS</th>\n<th>拓扑排序 BFS</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O(m × n)</td>\n<td>O(m × n)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(m × n)</td>\n<td>O(m × n)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> 每个格子最多被计算一次（记忆化保证），每次计算检查 4 个邻居。总计 O(4 × m × n) = O(m × n)。在 m = n = 200 时，约 16 万次操作。</p>\n<p><strong>空间复杂度详解：</strong> memo 数组或 outDegree 数组需要 O(m × n)。DFS 方法的递归栈最深 O(m × n)（极端情况下整个矩阵是一条递增路径）。</p>\n<p><strong>为什么记忆化有效？</strong> 严格递增的约束保证了 DFS 不会形成环。每个格子的答案只取决于其值更大的邻居的答案。因此整个计算形成了一个 DAG，每个节点只需计算一次。这是记忆化搜索最经典的应用场景之一。</p>\n<p><strong>面试技巧：</strong> 本题是记忆化 DFS 的高频考题。关键是解释清楚&quot;为什么没有循环依赖&quot;和&quot;为什么每个格子只算一次&quot;。如果面试官追问迭代解法，可以展示拓扑排序 BFS 版本。</p>\n","headings":[{"level":1,"text":"LeetCode 329 矩阵中的最长递增路径","id":"leetcode-329-矩阵中的最长递增路径"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 269 火星词典","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-graph-advanced/lc0269-alien-dictionary"},"next":{"title":"LeetCode 10 正则表达式匹配","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-dp-advanced/lc0010-regular-expression-matching"}}