"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> clone;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"方法二-dfs\">方法二：DFS</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function cloneGraph(node: GraphNode | null): GraphNode | null {&#10;  const cloneMap = new Map&lt;GraphNode, GraphNode&gt;();&#10;&#10;  const dfs = (original: GraphNode | null): GraphNode | null =&gt; {&#10;    if (original === null) return null;&#10;&#10;    if (cloneMap.has(original)) {&#10;      return cloneMap.get(original)!;&#10;    }&#10;&#10;    const clone = new GraphNode(original.val);&#10;    cloneMap.set(original, clone);&#10;&#10;    for (const neighbor of original.neighbors) {&#10;      clone.neighbors.push(dfs(neighbor)!);&#10;    }&#10;&#10;    return clone;&#10;  };&#10;&#10;  return dfs(node);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cloneGraph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">node</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cloneMap</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GraphNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GraphNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dfs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">original</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (original </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (cloneMap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(original)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cloneMap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(original)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> clone</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(original.val);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    cloneMap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(original, clone);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> neighbor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> original.neighbors) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      clone.neighbors.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dfs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(neighbor)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> clone;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dfs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(node);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"执行过程示例\">执行过程示例</h3><p>以 <code>adjList = [[2,4],[1,3],[2,4],[1,3]]</code> 为例：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"1 — 2&#10;|   |&#10;4 — 3\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>1 — 2</span></span>\n<span class=\"line\"><span>|   |</span></span>\n<span class=\"line\"><span>4 — 3</span></span></code></pre></div><p><strong>BFS 克隆过程：</strong></p>\n<table>\n<thead>\n<tr>\n<th>步骤</th>\n<th>队列</th>\n<th>当前处理</th>\n<th>操作</th>\n<th>cloneMap 大小</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>初始</td>\n<td>[1]</td>\n<td>—</td>\n<td>克隆节点1</td>\n<td>1</td>\n</tr>\n<tr>\n<td>1</td>\n<td>[2,4]</td>\n<td>1</td>\n<td>克隆2和4，加入1&#39;的邻居</td>\n<td>3</td>\n</tr>\n<tr>\n<td>2</td>\n<td>[4,3]</td>\n<td>2</td>\n<td>1已在map中直接引用，克隆3</td>\n<td>4</td>\n</tr>\n<tr>\n<td>3</td>\n<td>[3]</td>\n<td>4</td>\n<td>1和3已在map中直接引用</td>\n<td>4</td>\n</tr>\n<tr>\n<td>4</td>\n<td>[]</td>\n<td>3</td>\n<td>2和4已在map中直接引用</td>\n<td>4</td>\n</tr>\n</tbody></table>\n<p><strong>DFS 克隆过程：</strong></p>\n<table>\n<thead>\n<tr>\n<th>调用</th>\n<th>节点</th>\n<th>操作</th>\n<th>返回</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>dfs(1)</td>\n<td>1</td>\n<td>创建1&#39;，递归邻居</td>\n<td>1&#39;</td>\n</tr>\n<tr>\n<td>dfs(2)</td>\n<td>2</td>\n<td>创建2&#39;，递归邻居</td>\n<td>2&#39;</td>\n</tr>\n<tr>\n<td>dfs(1)</td>\n<td>1</td>\n<td>已在map中，直接返回1&#39;</td>\n<td>1&#39;</td>\n</tr>\n<tr>\n<td>dfs(3)</td>\n<td>3</td>\n<td>创建3&#39;，递归邻居</td>\n<td>3&#39;</td>\n</tr>\n<tr>\n<td>dfs(2)</td>\n<td>2</td>\n<td>已在map中，直接返回2&#39;</td>\n<td>2&#39;</td>\n</tr>\n<tr>\n<td>dfs(4)</td>\n<td>4</td>\n<td>创建4&#39;，递归邻居</td>\n<td>4&#39;</td>\n</tr>\n<tr>\n<td>dfs(1)</td>\n<td>1</td>\n<td>已在map中，直接返回1&#39;</td>\n<td>1&#39;</td>\n</tr>\n<tr>\n<td>dfs(3)</td>\n<td>3</td>\n<td>已在map中，直接返回3&#39;</td>\n<td>3&#39;</td>\n</tr>\n</tbody></table>\n<h3 id=\"为什么映射必须在创建节点后立即设置\">为什么映射必须在创建节点后立即设置</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const clone = new GraphNode(original.val);&#10;cloneMap.set(original, clone);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> clone</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GraphNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(original.val);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">cloneMap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(original, clone);</span></span></code></pre></div><p>如果将 <code>cloneMap.set</code> 放在遍历邻居之后，DFS 遇到环时会无限递归。例如 1→2→1，第二次访问 1 时如果 map 中还没有 1，就会再次创建，导致死循环。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>BFS</th>\n<th>DFS</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O(V + E)</td>\n<td>O(V + E)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(V)</td>\n<td>O(V)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> 每个节点被克隆恰好一次（O(V)），每条边被遍历两次（无向图的两个方向，O(2E) = O(E)）。总时间 O(V + E)。</p>\n<p><strong>空间复杂度详解：</strong> 哈希映射存储 V 个节点对的映射关系。BFS 的队列和 DFS 的递归栈最坏都是 O(V)。如果计算输出空间，克隆图本身占 O(V + E)。</p>\n<p>图的深拷贝是图遍历的实际应用题，核心技巧是使用哈希映射记录已克隆节点来避免重复。这个「已访问 → 直接引用」的模式在序列化/反序列化（LC #297）、复制带随机指针的链表（LC #138）等问题中同样适用。</p>\n","headings":[{"level":1,"text":"LeetCode 133 克隆图","id":"leetcode-133-克隆图"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":3,"text":"核心挑战：避免重复克隆","id":"核心挑战-避免重复克隆"},{"level":3,"text":"BFS 克隆","id":"bfs-克隆"},{"level":3,"text":"DFS 克隆","id":"dfs-克隆"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":3,"text":"节点定义","id":"节点定义"},{"level":3,"text":"方法一：BFS","id":"方法一-bfs"},{"level":3,"text":"方法二：DFS","id":"方法二-dfs"},{"level":3,"text":"执行过程示例","id":"执行过程示例"},{"level":3,"text":"为什么映射必须在创建节点后立即设置","id":"为什么映射必须在创建节点后立即设置"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 82 删除排序链表中的重复元素 II","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-string-linked-list/lc0082-remove-duplicates-sorted-list-ii"},"next":{"title":"LeetCode 98 验证二叉搜索树","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-tree-graph/lc0098-validate-bst"}}