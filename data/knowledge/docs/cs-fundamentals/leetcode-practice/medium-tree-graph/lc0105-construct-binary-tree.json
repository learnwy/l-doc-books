292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (inLeft </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> inRight) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rootVal</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> preorder[preIdx];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    preIdx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> root</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TreeNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rootVal);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> inIdx</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> inorderMap.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(rootVal)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    root.left </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(inLeft, inIdx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    root.right </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(inIdx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, inRight);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> root;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, inorder.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>代码要点：</strong></p>\n<ul>\n<li><code>preIdx</code> 是前序遍历的全局索引，每次取出根节点后自增</li>\n<li><code>build(inLeft, inRight)</code> 使用中序遍历的区间来界定当前子树的范围</li>\n<li>先构建左子树再构建右子树，这与前序遍历的顺序一致（根→左→右），确保 <code>preIdx</code> 按正确顺序推进</li>\n<li>如果调换左右子树的构建顺序，<code>preIdx</code> 的推进就会错位</li>\n</ul>\n<h3 id=\"执行过程示例\">执行过程示例</h3><p>以 <code>preorder = [3,9,20,15,7]</code>，<code>inorder = [9,3,15,20,7]</code> 为例：</p>\n<table>\n<thead>\n<tr>\n<th>步骤</th>\n<th>preIdx</th>\n<th>rootVal</th>\n<th>inIdx</th>\n<th>左子树范围</th>\n<th>右子树范围</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>1</td>\n<td>0→1</td>\n<td>3</td>\n<td>1</td>\n<td>[0,0]</td>\n<td>[2,4]</td>\n</tr>\n<tr>\n<td>2</td>\n<td>1→2</td>\n<td>9</td>\n<td>0</td>\n<td>[0,-1]空</td>\n<td>[1,0]空</td>\n</tr>\n<tr>\n<td>3</td>\n<td>2→3</td>\n<td>20</td>\n<td>3</td>\n<td>[2,2]</td>\n<td>[4,4]</td>\n</tr>\n<tr>\n<td>4</td>\n<td>3→4</td>\n<td>15</td>\n<td>2</td>\n<td>[2,1]空</td>\n<td>[3,2]空</td>\n</tr>\n<tr>\n<td>5</td>\n<td>4→5</td>\n<td>7</td>\n<td>4</td>\n<td>[4,3]空</td>\n<td>[5,4]空</td>\n</tr>\n</tbody></table>\n<p>构建出的树：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"    3&#10;   / \\&#10;  9   20&#10;     /  \\&#10;    15    7\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>    3</span></span>\n<span class=\"line\"><span>   / \\</span></span>\n<span class=\"line\"><span>  9   20</span></span>\n<span class=\"line\"><span>     /  \\</span></span>\n<span class=\"line\"><span>    15    7</span></span></code></pre></div><h3 id=\"为什么-preidx-必须是全局变量\">为什么 preIdx 必须是全局变量</h3><p><code>preIdx</code> 不能作为参数传递给递归函数，因为左子树的递归会消耗掉若干前序元素，右子树的递归必须从左子树消耗后的位置继续。用全局变量（或闭包变量）可以自然地实现这种「消耗」语义。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>复杂度</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O(n)</td>\n<td>每个节点构建一次，哈希查找 O(1)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(n)</td>\n<td>哈希表 O(n) + 递归栈 O(h)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> 预处理哈希表 O(n)。递归过程中每个节点被构建恰好一次，每次构建 O(1)（哈希查找 + 创建节点），总共 O(n)。</p>\n<p><strong>空间复杂度详解：</strong> 哈希表存储 n 个映射关系，占 O(n)。递归栈深度为树高 h，平衡树 O(log n)，退化树 O(n)。总空间 O(n)。</p>\n<p>本题是理解树的遍历序列的经典题目。配套题目包括从中序与后序遍历序列构造二叉树（LC #106），思路类似但后序遍历的根在末尾，需要从右向左取根，先构建右子树再构建左子树。</p>\n","headings":[{"level":1,"text":"LeetCode 105 从前序与中序遍历序列构造二叉树","id":"leetcode-105-从前序与中序遍历序列构造二叉树"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":3,"text":"遍历序列的结构特性","id":"遍历序列的结构特性"},{"level":3,"text":"分治递归","id":"分治递归"},{"level":3,"text":"优化：哈希映射加速查找","id":"优化-哈希映射加速查找"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":3,"text":"执行过程示例","id":"执行过程示例"},{"level":3,"text":"为什么 preIdx 必须是全局变量","id":"为什么-preidx-必须是全局变量"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 102 二叉树的层序遍历","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-tree-graph/lc0102-binary-tree-level-order"},"next":{"title":"LeetCode 114 二叉树展开为链表","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-tree-graph/lc0114-flatten-binary-tree"}}