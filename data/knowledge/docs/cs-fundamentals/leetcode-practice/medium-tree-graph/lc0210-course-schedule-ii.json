005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    postOrder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(node);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numCourses; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (color[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">      dfs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (hasCycle) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> postOrder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reverse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"执行过程示例\">执行过程示例</h3><p>以 <code>numCourses = 4, prerequisites = [[1,0],[2,0],[3,1],[3,2]]</code> 为例：</p>\n<p><strong>BFS 过程：</strong></p>\n<table>\n<thead>\n<tr>\n<th>步骤</th>\n<th>队列</th>\n<th>出队</th>\n<th>order</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>初始</td>\n<td>[0]</td>\n<td>—</td>\n<td>[]</td>\n</tr>\n<tr>\n<td>1</td>\n<td>[1,2]</td>\n<td>0</td>\n<td>[0]</td>\n</tr>\n<tr>\n<td>2</td>\n<td>[2]</td>\n<td>1</td>\n<td>[0,1]</td>\n</tr>\n<tr>\n<td>3</td>\n<td>[3]</td>\n<td>2</td>\n<td>[0,1,2]</td>\n</tr>\n<tr>\n<td>4</td>\n<td>[]</td>\n<td>3</td>\n<td>[0,1,2,3]</td>\n</tr>\n</tbody></table>\n<p>返回 <code>[0,1,2,3]</code>。</p>\n<p><strong>DFS 过程：</strong></p>\n<table>\n<thead>\n<tr>\n<th>DFS 调用</th>\n<th>节点</th>\n<th>后序入栈</th>\n<th>postOrder</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>dfs(0)→dfs(1)→dfs(3)</td>\n<td>3 完成</td>\n<td>3</td>\n<td>[3]</td>\n</tr>\n<tr>\n<td>回到 dfs(1)</td>\n<td>1 完成</td>\n<td>1</td>\n<td>[3,1]</td>\n</tr>\n<tr>\n<td>回到 dfs(0)→dfs(2)→dfs(3)</td>\n<td>3 已黑色跳过</td>\n<td>—</td>\n<td>[3,1]</td>\n</tr>\n<tr>\n<td>回到 dfs(2)</td>\n<td>2 完成</td>\n<td>2</td>\n<td>[3,1,2]</td>\n</tr>\n<tr>\n<td>回到 dfs(0)</td>\n<td>0 完成</td>\n<td>0</td>\n<td>[3,1,2,0]</td>\n</tr>\n</tbody></table>\n<p>反转后：<code>[0,2,1,3]</code>。</p>\n<h3 id=\"与-lc-207-的代码对比\">与 LC #207 的代码对比</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// LC #207：只需判断&#10;return count === numCourses;&#10;&#10;// LC #210：需要输出顺序&#10;return order.length === numCourses ? order : [];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// LC #207：只需判断</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numCourses;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// LC #210：需要输出顺序</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numCourses </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span></code></pre></div><p>唯一的区别是 #210 在处理过程中维护了 <code>order</code> 数组，并在最后返回它而非布尔值。算法本身完全一致。</p>\n<h3 id=\"多种合法顺序\">多种合法顺序</h3><p>拓扑排序的结果通常不唯一。当多个节点同时入度为 0 时，选择不同的节点会产生不同的合法序列。例如上面的例子中，<code>[0,1,2,3]</code> 和 <code>[0,2,1,3]</code> 都是合法的。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>BFS</th>\n<th>DFS</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O(V + E)</td>\n<td>O(V + E)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(V + E)</td>\n<td>O(V + E)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> 与 LC #207 完全相同。建图 O(E)，遍历所有节点和边 O(V + E)。DFS 版本最后的 <code>reverse()</code> 是 O(V)，不影响整体复杂度。</p>\n<p><strong>空间复杂度详解：</strong> 邻接表 O(V + E)，BFS 的队列或 DFS 的栈 O(V)，结果数组 O(V)。总空间 O(V + E)。</p>\n<p>课程表系列是拓扑排序的标准题目。掌握 Kahn 算法（BFS）和 DFS 后序反转两种方法后，可以应对所有拓扑排序相关问题，包括并行任务调度（LC #1136）、外星文字典（LC #269）等。</p>\n","headings":[{"level":1,"text":"LeetCode 210 课程表 II","id":"leetcode-210-课程表-ii"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":3,"text":"从 LC #207 到 LC #210","id":"从-lc-207-到-lc-210"},{"level":3,"text":"BFS vs DFS 输出顺序","id":"bfs-vs-dfs-输出顺序"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":3,"text":"方法一：BFS 拓扑排序","id":"方法一-bfs-拓扑排序"},{"level":3,"text":"方法二：DFS 后序反转","id":"方法二-dfs-后序反转"},{"level":3,"text":"执行过程示例","id":"执行过程示例"},{"level":3,"text":"与 LC #207 的代码对比","id":"与-lc-207-的代码对比"},{"level":3,"text":"多种合法顺序","id":"多种合法顺序"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 207 课程表","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-tree-graph/lc0207-course-schedule"},"next":{"title":"LeetCode 435 无重叠区间","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-search-greedy/lc0435-non-overlapping-intervals"}}