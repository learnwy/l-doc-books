e=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> neighbor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> graph[node]) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (color[neighbor] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (color[neighbor] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hasCycle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(neighbor)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    color[node] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> numCourses; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (color[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hasCycle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"执行过程示例\">执行过程示例</h3><p>以 <code>numCourses = 4, prerequisites = [[1,0],[2,0],[3,1],[3,2]]</code> 为例：</p>\n<p>图结构：<code>0 → 1 → 3, 0 → 2 → 3</code></p>\n<p><strong>BFS 拓扑排序过程：</strong></p>\n<table>\n<thead>\n<tr>\n<th>步骤</th>\n<th>队列</th>\n<th>出队</th>\n<th>更新入度</th>\n<th>count</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>初始</td>\n<td>[0]</td>\n<td>—</td>\n<td>—</td>\n<td>0</td>\n</tr>\n<tr>\n<td>1</td>\n<td>[]</td>\n<td>0</td>\n<td>1的入度:1→0, 2的入度:1→0</td>\n<td>1</td>\n</tr>\n<tr>\n<td>2</td>\n<td>[1,2]</td>\n<td>1</td>\n<td>3的入度:2→1</td>\n<td>2</td>\n</tr>\n<tr>\n<td>3</td>\n<td>[2]</td>\n<td>2</td>\n<td>3的入度:1→0</td>\n<td>3</td>\n</tr>\n<tr>\n<td>4</td>\n<td>[3]</td>\n<td>3</td>\n<td>—</td>\n<td>4</td>\n</tr>\n</tbody></table>\n<p><code>count = 4 = numCourses</code>，返回 <code>true</code>。拓扑排序结果：<code>0 → 1 → 2 → 3</code>。</p>\n<h3 id=\"有环的情况\">有环的情况</h3><p>以 <code>numCourses = 2, prerequisites = [[1,0],[0,1]]</code> 为例：</p>\n<p>图结构：<code>0 → 1, 1 → 0</code>（循环依赖）</p>\n<p><strong>BFS：</strong> 两个节点的入度都是 1，初始队列为空，count = 0 ≠ 2，返回 <code>false</code>。</p>\n<p><strong>DFS：</strong> 从 0 出发，标记灰色，访问 1，标记灰色，访问 0 发现是灰色（在当前路径上），检测到环。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>BFS</th>\n<th>DFS</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O(V + E)</td>\n<td>O(V + E)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(V + E)</td>\n<td>O(V + E)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> V 为课程数（numCourses），E 为先修关系数（prerequisites.length）。建图 O(E)，BFS/DFS 中每个节点和每条边各被处理一次。</p>\n<p><strong>空间复杂度详解：</strong> 邻接表存储图需要 O(V + E)。BFS 额外需要入度数组 O(V) 和队列 O(V)。DFS 额外需要颜色数组 O(V) 和递归栈 O(V)。</p>\n<p>拓扑排序是有向图中最重要的算法之一。本题（LC #207）判断是否可以完成，进阶版 LC #210 要求输出实际的拓扑排序序列。</p>\n","headings":[{"level":1,"text":"LeetCode 207 课程表","id":"leetcode-207-课程表"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":3,"text":"图建模","id":"图建模"},{"level":3,"text":"方法一：BFS 拓扑排序（Kahn 算法）","id":"方法一-bfs-拓扑排序-kahn-算法"},{"level":3,"text":"方法二：DFS 检测环","id":"方法二-dfs-检测环"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":3,"text":"方法一：BFS 拓扑排序","id":"方法一-bfs-拓扑排序"},{"level":3,"text":"方法二：DFS 三色标记","id":"方法二-dfs-三色标记"},{"level":3,"text":"执行过程示例","id":"执行过程示例"},{"level":3,"text":"有环的情况","id":"有环的情况"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 200 岛屿数量","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-tree-graph/lc0200-number-of-islands"},"next":{"title":"LeetCode 210 课程表 II","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-tree-graph/lc0210-course-schedule-ii"}}