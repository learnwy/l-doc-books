A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxDiff </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">prices[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      dp[j][i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(dp[j][i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], prices[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxDiff);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      maxDiff </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(maxDiff, dp[j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prices[i]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dp[k][n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>二维 DP 的优化技巧：</strong></p>\n<p>朴素的二维 DP 状态转移为：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"dp[j][i] = max(dp[j][i-1], max(dp[j-1][m] + prices[i] - prices[m]) for m &lt; i)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>dp[j][i] = max(dp[j][i-1], max(dp[j-1][m] + prices[i] - prices[m]) for m &#x3C; i)</span></span></code></pre></div><p>内层 <code>max(dp[j-1][m] - prices[m])</code> 可以通过维护一个变量 <code>maxDiff</code> 在遍历过程中递推，避免重复计算，将单次状态转移从 O(n) 降到 O(1)。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>状态机 DP</th>\n<th>二维 DP</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间复杂度</td>\n<td>O(n × min(k, n/2))</td>\n<td>O(n × min(k, n/2))</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(k)</td>\n<td>O(k × n)</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> 外层遍历 n 天，内层遍历 k 次交易（实际上限为 min(k, n/2)），每步 O(1)。当 k &gt;= n/2 时退化为 O(n) 的贪心。</p>\n<p><strong>空间复杂度详解：</strong> 状态机版本只需 buy 和 sell 两个长度为 k+1 的数组，O(k)。二维 DP 需要 O(k × n)。</p>\n<p><strong>为什么 k &gt;= n/2 时可以用贪心？</strong></p>\n<p>n 天内最多完成 n/2 笔交易（每笔交易至少需要买入和卖出两天）。当 k 超过这个上限时，交易次数不再是限制条件，可以贪心地收集所有相邻的正差值。</p>\n<p><strong>股票系列总结：</strong></p>\n<p>本题是整个「买卖股票」系列的通用解。理解了状态机 DP 的思想后：</p>\n<ul>\n<li>k=1 → LC #121</li>\n<li>k=2 → LC #123</li>\n<li>k=∞ → LC #122</li>\n<li>k=∞ + 冷冻期 → LC #309</li>\n<li>k=∞ + 手续费 → LC #714</li>\n</ul>\n<p>所有变体都可以用同一套状态机框架来解决，只需调整状态数和转移规则。</p>\n","headings":[{"level":1,"text":"LeetCode 188 买卖股票的最佳时机 IV","id":"leetcode-188-买卖股票的最佳时机-iv"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 123 买卖股票的最佳时机 III","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-dp-advanced/lc0123-best-time-to-buy-sell-stock-iii"},"next":{"title":"LeetCode 312 戳气球","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/hard-dp-advanced/lc0312-burst-balloons"}}