;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stack[stack.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    stack.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> leftCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> left[i];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> rightCount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> right[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> arr[i] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> leftCount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rightCount) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MOD</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>用示例 1 详细模拟贡献法的计算过程：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"arr = [3, 1, 2, 4]&#10;&#10;计算 left[]（左边第一个严格小于的位置，不存在则 -1）：&#10;left = [-1, -1, 1, 2]&#10;&#10;计算 right[]（右边第一个小于等于的位置，不存在则 n=4）：&#10;right = [1, 4, 4, 4]&#10;&#10;计算每个元素的贡献：&#10;i=0: arr[0]=3, leftCount=0-(-1)=1, rightCount=1-0=1, 贡献=3×1×1=3&#10;i=1: arr[1]=1, leftCount=1-(-1)=2, rightCount=4-1=3, 贡献=1×2×3=6&#10;i=2: arr[2]=2, leftCount=2-1=1,    rightCount=4-2=2, 贡献=2×1×2=4&#10;i=3: arr[3]=4, leftCount=3-2=1,    rightCount=4-3=1, 贡献=4×1×1=4&#10;&#10;总和 = 3 + 6 + 4 + 4 = 17 ✓\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>arr = [3, 1, 2, 4]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>计算 left[]（左边第一个严格小于的位置，不存在则 -1）：</span></span>\n<span class=\"line\"><span>left = [-1, -1, 1, 2]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>计算 right[]（右边第一个小于等于的位置，不存在则 n=4）：</span></span>\n<span class=\"line\"><span>right = [1, 4, 4, 4]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>计算每个元素的贡献：</span></span>\n<span class=\"line\"><span>i=0: arr[0]=3, leftCount=0-(-1)=1, rightCount=1-0=1, 贡献=3×1×1=3</span></span>\n<span class=\"line\"><span>i=1: arr[1]=1, leftCount=1-(-1)=2, rightCount=4-1=3, 贡献=1×2×3=6</span></span>\n<span class=\"line\"><span>i=2: arr[2]=2, leftCount=2-1=1,    rightCount=4-2=2, 贡献=2×1×2=4</span></span>\n<span class=\"line\"><span>i=3: arr[3]=4, leftCount=3-2=1,    rightCount=4-3=1, 贡献=4×1×1=4</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>总和 = 3 + 6 + 4 + 4 = 17 ✓</span></span></code></pre></div><p>验证 <code>arr[1]=1</code> 的贡献：它是子数组 <code>[3,1]</code>, <code>[1]</code>, <code>[3,1,2]</code>, <code>[1,2]</code>, <code>[3,1,2,4]</code>, <code>[1,2,4]</code> 的最小值。共 6 个子数组，贡献 <code>1 × 6 = 6</code>，与 <code>leftCount × rightCount = 2 × 3 = 6</code> 一致。</p>\n<p><strong>关于取模的注意事项：</strong> 由于乘法可能溢出，在 JavaScript/TypeScript 中 <code>arr[i] * leftCount * rightCount</code> 的中间结果不会超过 <code>3×10^4 × 3×10^4 × 3×10^4 = 2.7×10^13</code>，在 <code>Number.MAX_SAFE_INTEGER</code> (约 9×10^15) 范围内，因此不需要使用 BigInt。但如果数据范围更大，需要注意溢出问题。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>复杂度</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间</td>\n<td>O(n)</td>\n<td>两次单调栈遍历 + 一次贡献计算</td>\n</tr>\n<tr>\n<td>空间</td>\n<td>O(n)</td>\n<td>left/right 数组 + 栈空间</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度详解：</strong> 计算 <code>left[]</code> 需要一次从左到右的单调栈遍历 O(n)。计算 <code>right[]</code> 需要一次从右到左的单调栈遍历 O(n)。最终的贡献累加是一次线性遍历 O(n)。总计 O(3n) = O(n)。</p>\n<p><strong>空间复杂度详解：</strong> <code>left</code> 和 <code>right</code> 数组各 O(n)，栈最大深度 O(n)。总计 O(n)。</p>\n<p><strong>贡献法的适用场景：</strong> 贡献法是一种逆向思维——不是按子问题（子数组）枚举，而是按元素枚举其对所有子问题的贡献。这种思路在计算子数组最大值之和、子数组异或和等问题中都有应用。掌握&quot;找左右边界 → 计算贡献&quot;的模式，可以解决一大类看似需要暴力枚举的问题。</p>\n","headings":[{"level":1,"text":"LeetCode 907 子数组的最小值之和","id":"leetcode-907-子数组的最小值之和"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 503 下一个更大元素 II","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/medium-heap-monotonic/lc0503-next-greater-element-ii"},"next":null}