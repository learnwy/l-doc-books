 null</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> predecessor.right </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> current) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        predecessor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> predecessor.right;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (predecessor.right </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        predecessor.right </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> current;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        current </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> current.left;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        predecessor.right </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(current.val);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        current </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> current.right;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>迭代法执行过程：</strong></p>\n<p>以 <code>root = [1, null, 2, 3]</code> 为例：</p>\n<table>\n<thead>\n<tr>\n<th>步骤</th>\n<th>current</th>\n<th>stack</th>\n<th>result</th>\n<th>动作</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>1</td>\n<td>1</td>\n<td>[]</td>\n<td>[]</td>\n<td>左子树为空，不进内循环</td>\n</tr>\n<tr>\n<td>2</td>\n<td>1</td>\n<td>[1]</td>\n<td>[]</td>\n<td>压入栈</td>\n</tr>\n<tr>\n<td>3</td>\n<td>null</td>\n<td>[1]</td>\n<td>[]</td>\n<td>current 为空</td>\n</tr>\n<tr>\n<td>4</td>\n<td>1</td>\n<td>[]</td>\n<td>[1]</td>\n<td>弹出 1，记录值</td>\n</tr>\n<tr>\n<td>5</td>\n<td>2</td>\n<td>[]</td>\n<td>[1]</td>\n<td>转向右子树 2</td>\n</tr>\n<tr>\n<td>6</td>\n<td>3</td>\n<td>[2]</td>\n<td>[1]</td>\n<td>沿左走到 3</td>\n</tr>\n<tr>\n<td>7</td>\n<td>null</td>\n<td>[2, 3]</td>\n<td>[1]</td>\n<td>左子树为空</td>\n</tr>\n<tr>\n<td>8</td>\n<td>3</td>\n<td>[2]</td>\n<td>[1, 3]</td>\n<td>弹出 3，记录值</td>\n</tr>\n<tr>\n<td>9</td>\n<td>null</td>\n<td>[2]</td>\n<td>[1, 3]</td>\n<td>3 无右子树</td>\n</tr>\n<tr>\n<td>10</td>\n<td>2</td>\n<td>[]</td>\n<td>[1, 3, 2]</td>\n<td>弹出 2，记录值</td>\n</tr>\n</tbody></table>\n<p>最终返回 <code>[1, 3, 2]</code>。</p>\n<h2 id=\"复杂度分析\">复杂度分析</h2><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>时间复杂度</th>\n<th>空间复杂度</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>递归</td>\n<td>O(n)</td>\n<td>O(n)</td>\n<td>最坏情况栈深度为 n</td>\n</tr>\n<tr>\n<td>迭代</td>\n<td>O(n)</td>\n<td>O(n)</td>\n<td>显式栈最坏存储 n 个节点</td>\n</tr>\n<tr>\n<td>Morris</td>\n<td>O(n)</td>\n<td>O(1)</td>\n<td>每条边最多遍历 2 次</td>\n</tr>\n</tbody></table>\n<p><strong>时间复杂度分析：</strong> 三种方法都需要访问每个节点恰好一次，因此时间复杂度均为 O(n)。Morris 遍历虽然有内层循环寻找前驱节点，但均摊下来每条边最多被访问两次（建立线索和断开线索各一次），总时间仍为 O(n)。</p>\n<p><strong>空间复杂度分析：</strong> 递归法和迭代法的空间取决于树的高度。平衡二叉树的高度为 O(log n)，退化为链表时高度为 O(n)。Morris 遍历不使用任何额外数据结构，空间为 O(1)，但代价是临时修改了树的结构。</p>\n<p><strong>实际选择建议：</strong> 面试中通常要求掌握递归和迭代两种写法。迭代法是必须掌握的，因为它是理解栈与递归关系的关键。Morris 遍历作为进阶内容，在需要严格 O(1) 空间时才使用。</p>\n","headings":[{"level":1,"text":"LeetCode 94 二叉树的中序遍历","id":"leetcode-94-二叉树的中序遍历"},{"level":2,"text":"题目描述","id":"题目描述"},{"level":2,"text":"解题思路","id":"解题思路"},{"level":3,"text":"三种遍历顺序回顾","id":"三种遍历顺序回顾"},{"level":3,"text":"递归法","id":"递归法"},{"level":3,"text":"迭代法（显式栈）","id":"迭代法-显式栈"},{"level":3,"text":"Morris 遍历","id":"morris-遍历"},{"level":2,"text":"代码实现","id":"代码实现"},{"level":3,"text":"递归法","id":"递归法"},{"level":3,"text":"迭代法（推荐）","id":"迭代法-推荐"},{"level":3,"text":"Morris 遍历","id":"morris-遍历"},{"level":2,"text":"复杂度分析","id":"复杂度分析"}],"prev":{"title":"LeetCode 349 两个数组的交集","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/easy-hash-tree-math/lc0349-intersection-of-two-arrays"},"next":{"title":"LeetCode 100 相同的树","url":"/l-doc-books/h/cs-fundamentals/leetcode-practice/easy-hash-tree-math/lc0100-same-tree"}}