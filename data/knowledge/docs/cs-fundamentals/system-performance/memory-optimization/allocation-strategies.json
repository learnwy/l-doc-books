=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (PoolNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)(pool.memory </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool.obj_size);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        node->next </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool.free_list;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        pool.free_list </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pool_alloc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ObjectPool </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pool->free_list) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    PoolNode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">node </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool->free_list;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    pool->free_list </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node->next;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pool_free</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ObjectPool </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ptr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    PoolNode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">node </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (PoolNode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)ptr;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    node->next </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool->free_list;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    pool->free_list </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Linux 内核的 <strong>Slab 分配器</strong>是对象池思想的工业级实现。它为每种内核对象类型（task_struct、inode、dentry 等）维护独立的缓存池，利用 CPU 本地缓存（per-CPU cache）避免跨核锁竞争。</p>\n<table>\n<thead>\n<tr>\n<th>分配器</th>\n<th>特点</th>\n<th>典型用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SLAB (原始)</td>\n<td>简单，per-CPU 缓存</td>\n<td>Linux 2.2-2.6 内核默认</td>\n</tr>\n<tr>\n<td>SLUB (当前默认)</td>\n<td>更简单，减少元数据开销</td>\n<td>Linux 2.6.23+ 默认</td>\n</tr>\n<tr>\n<td>SLOB</td>\n<td>极简，适合嵌入式</td>\n<td>低内存环境</td>\n</tr>\n</tbody></table>\n<h2 id=\"现代通用分配器\">现代通用分配器</h2><p>当无法使用场景化分配器时，选择一个优秀的通用分配器同样重要。现代通用分配器在多线程环境下的性能比传统 glibc malloc 有显著提升。</p>\n<p><strong>jemalloc</strong>（Facebook/Meta 出品）通过 Thread Cache + Arena 分级设计减少锁竞争。每个线程有独立的小对象缓存，大对象使用跨线程的 Arena 池。</p>\n<p><strong>tcmalloc</strong>（Google 出品）类似思路，Thread-Caching Malloc。每个线程维护固定大小类别的空闲链表，小对象分配无需加锁。</p>\n<p><strong>mimalloc</strong>（Microsoft 出品）强调极致的小对象分配性能，使用 Segment/Page 两级结构，在微基准测试中通常是最快的。</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 替换默认分配器（Linux）&#10;# jemalloc&#10;LD_PRELOAD=/usr/lib/libjemalloc.so ./myapp&#10;# tcmalloc&#10;LD_PRELOAD=/usr/lib/libtcmalloc.so ./myapp&#10;# mimalloc&#10;LD_PRELOAD=/usr/lib/libmimalloc.so ./myapp\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 替换默认分配器（Linux）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># jemalloc</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LD_PRELOAD</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/usr/lib/libjemalloc.so</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ./myapp</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># tcmalloc</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LD_PRELOAD</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/usr/lib/libtcmalloc.so</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ./myapp</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># mimalloc</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LD_PRELOAD</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/usr/lib/libmimalloc.so</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ./myapp</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"c\" data-code=\"// jemalloc 提供的高级 API&#10;#include &lt;jemalloc/jemalloc.h&gt;&#10;&#10;void *ptr = mallocx(4096, MALLOCX_ALIGN(64));  // 对齐分配&#10;size_t actual = sallocx(ptr, 0);                // 查询实际分配大小&#10;ptr = rallocx(ptr, 8192, 0);                    // 原地扩展&#10;dallocx(ptr, 0);                                // 释放\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// jemalloc 提供的高级 API</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;jemalloc/jemalloc.h></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ptr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> mallocx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4096</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">MALLOCX_ALIGN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 对齐分配</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">size_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actual </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sallocx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ptr, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                // 查询实际分配大小</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ptr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> rallocx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ptr, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8192</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                    // 原地扩展</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dallocx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ptr, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                                // 释放</span></span></code></pre></div><h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((分配策略))&#10;    栈分配&#10;      最快&#10;      大小受限&#10;      SBO/SSO 优化&#10;    Arena 分配&#10;      Bump 指针&#10;      批量释放&#10;      请求级/阶段级&#10;    对象池&#10;      固定大小&#10;      O-1 操作&#10;      零碎片化&#10;      Slab 分配器&#10;    通用分配器&#10;      jemalloc&#10;      tcmalloc&#10;      mimalloc&#10;      Thread Cache&#10;    选择策略&#10;      按场景匹配&#10;      先栈后堆&#10;      复用优先\">mindmap\n  root((分配策略))\n    栈分配\n      最快\n      大小受限\n      SBO/SSO 优化\n    Arena 分配\n      Bump 指针\n      批量释放\n      请求级/阶段级\n    对象池\n      固定大小\n      O-1 操作\n      零碎片化\n      Slab 分配器\n    通用分配器\n      jemalloc\n      tcmalloc\n      mimalloc\n      Thread Cache\n    选择策略\n      按场景匹配\n      先栈后堆\n      复用优先</pre><ul>\n<li><strong>栈分配</strong>是最快的分配方式，性能关键路径优先考虑栈分配和小缓冲区优化</li>\n<li><strong>Arena 分配器</strong>适合生命周期一致的批量对象（如请求处理、编译阶段），分配 O(1)，释放无开销</li>\n<li><strong>对象池</strong>适合频繁创建/销毁的固定大小对象，完全消除碎片化和分配器开销</li>\n<li>现代通用分配器（<strong>jemalloc/tcmalloc/mimalloc</strong>）通过线程本地缓存大幅减少多线程竞争</li>\n<li>分配策略的选择应该基于<strong>对象大小、生命周期和访问模式</strong>的分析，而非一刀切</li>\n<li>分配性能优化的核心原则：<strong>减少分配次数 &gt; 选择合适的分配器 &gt; 优化分配路径</strong></li>\n</ul>\n","headings":[{"level":1,"text":"分配策略","id":"分配策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"栈分配与堆分配的权衡","id":"栈分配与堆分配的权衡"},{"level":2,"text":"Arena 分配器","id":"arena-分配器"},{"level":2,"text":"对象池与 Slab 分配","id":"对象池与-slab-分配"},{"level":2,"text":"现代通用分配器","id":"现代通用分配器"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"内存布局","url":"/l-doc-books/h/cs-fundamentals/system-performance/memory-optimization/memory-layout"},"next":{"title":"内存泄漏检测","url":"/l-doc-books/h/cs-fundamentals/system-performance/memory-optimization/memory-leak-detection"}}