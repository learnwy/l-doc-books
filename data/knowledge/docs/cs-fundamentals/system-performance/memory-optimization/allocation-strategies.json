pool.obj_size = obj_size &lt; sizeof(PoolNode) ? sizeof(PoolNode) : obj_size;&#10;    pool.memory = malloc(pool.obj_size * POOL_SIZE);&#10;    pool.free_list = NULL;&#10;&#10;    for (int i = POOL_SIZE - 1; i &gt;= 0; i--) {&#10;        PoolNode *node = (PoolNode*)(pool.memory + i * pool.obj_size);&#10;        node-&gt;next = pool.free_list;&#10;        pool.free_list = node;&#10;    }&#10;    return pool;&#10;}&#10;&#10;void* pool_alloc(ObjectPool *pool) {&#10;    if (!pool-&gt;free_list) return NULL;&#10;    PoolNode *node = pool-&gt;free_list;&#10;    pool-&gt;free_list = node-&gt;next;&#10;    return node;&#10;}&#10;&#10;void pool_free(ObjectPool *pool, void *ptr) {&#10;    PoolNode *node = (PoolNode*)ptr;&#10;    node-&gt;next = pool-&gt;free_list;&#10;    pool-&gt;free_list = node;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#define</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> POOL_SIZE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4096</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">typedef</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PoolNode {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PoolNode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">next;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} PoolNode;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">typedef</span><span style=\"color:#D73A49;--shik