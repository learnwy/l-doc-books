{"seq":4,"slug":"load-testing","title":"负载测试","url":"/l-doc-books/h/cs-fundamentals/system-performance/system-tuning/load-testing","wordCount":1150,"readingTime":5,"html":"<h1 id=\"负载测试\">负载测试</h1><h2 id=\"核心概念\">核心概念</h2><p>负载测试（Load Testing）是在受控条件下模拟真实用户请求，测量系统在不同负载水平下的性能表现。它回答的核心问题是：<strong>系统能承受多大的负载？在目标负载下表现如何？何时会崩溃？</strong> 负载测试不是上线前的一次性工作，而应该嵌入 CI/CD 流程，成为持续性能验证的一部分。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    A[负载测试] --&gt; B[性能测试]&#10;    A --&gt; C[压力测试]&#10;    A --&gt; D[容量测试]&#10;    A --&gt; E[浸泡测试]&#10;    B --&gt; B1[验证 SLO 在目标负载下达标]&#10;    C --&gt; C1[找到系统崩溃点]&#10;    D --&gt; D1[确定最大容量和扩容阈值]&#10;    E --&gt; E1[发现长期运行的资源泄漏]\">graph TB\n    A[负载测试] --&gt; B[性能测试]\n    A --&gt; C[压力测试]\n    A --&gt; D[容量测试]\n    A --&gt; E[浸泡测试]\n    B --&gt; B1[验证 SLO 在目标负载下达标]\n    C --&gt; C1[找到系统崩溃点]\n    D --&gt; D1[确定最大容量和扩容阈值]\n    E --&gt; E1[发现长期运行的资源泄漏]</pre><table>\n<thead>\n<tr>\n<th>测试类型</th>\n<th>目标</th>\n<th>负载模式</th>\n<th>持续时间</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>性能测试 (Performance)</td>\n<td>验证目标负载下的 SLO</td>\n<td>稳定的目标 QPS</td>\n<td>10-30 分钟</td>\n</tr>\n<tr>\n<td>压力测试 (Stress)</td>\n<td>找到系统极限</td>\n<td>逐步递增直到崩溃</td>\n<td>直到崩溃或降级</td>\n</tr>\n<tr>\n<td>容量测试 (Capacity)</td>\n<td>确定最大安全容量</td>\n<td>递增负载，记录性能曲线</td>\n<td>数小时</td>\n</tr>\n<tr>\n<td>浸泡测试 (Soak)</td>\n<td>发现内存泄漏等长期问题</td>\n<td>稳定负载，长时间运行</td>\n<td>12-72 小时</td>\n</tr>\n<tr>\n<td>峰值测试 (Spike)</td>\n<td>验证突发流量处理能力</td>\n<td>瞬间从低负载跳到高负载</td>\n<td>几分钟到 1 小时</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具选型与脚本编写\">工具选型与脚本编写</h2><p>现代负载测试工具可以分为脚本驱动和配置驱动两类。选择工具时需要考虑：协议支持、脚本灵活性、分布式执行能力和结果分析功能。</p>\n<p><strong>k6</strong> 是当前最流行的开发者友好型负载测试工具，使用 JavaScript 编写测试脚本：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"import http from &#39;k6/http&#39;;&#10;import { check, sleep } from &#39;k6&#39;;&#10;import { Rate, Trend } from &#39;k6/metrics&#39;;&#10;&#10;const errorRate = new Rate(&#39;error_rate&#39;);&#10;const latencyP99 = new Trend(&#39;latency_p99&#39;);&#10;&#10;export const options = {&#10;  stages: [&#10;    { duration: &#39;2m&#39;, target: 100 }, // 2分钟 ramp up 到 100 VU&#10;    { duration: &#39;5m&#39;, target: 100 }, // 稳定 100 VU 持续 5 分钟&#10;    { duration: &#39;2m&#39;, target: 200 }, // ramp up 到 200 VU&#10;    { duration: &#39;5m&#39;, target: 200 }, // 稳定 200 VU&#10;    { duration: &#39;2m&#39;, target: 0 }, // ramp down&#10;  ],&#10;  thresholds: {&#10;    http_req_duration: [&#39;p(99)&lt;500&#39;], // P99 延迟 &lt; 500ms&#10;    error_rate: [&#39;rate&lt;0.01&#39;], // 错误率 &lt; 1%&#10;  },&#10;};&#10;&#10;export default function () {&#10;  const payload = JSON.stringify({&#10;    username: `user_${__VU}`,&#10;    query: &#39;performance testing&#39;,&#10;  });&#10;&#10;  const params = {&#10;    headers: { &#39;Content-Type&#39;: &#39;application/json&#39; },&#10;  };&#10;&#10;  const res = http.post(&#39;http://api.example.com/search&#39;, payload, params);&#10;&#10;  check(res, {&#10;    &#39;status is 200&#39;: (r) =&gt; r.status === 200,&#10;    &#39;response time &lt; 500ms&#39;: (r) =&gt; r.timings.duration &lt; 500,&#10;  });&#10;&#10;  errorRate.add(res.status !== 200);&#10;  latencyP99.add(res.timings.duration);&#10;&#10;  sleep(Math.random() * 2 + 1); // 模拟用户思考时间&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> http </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'k6/http'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { check, sleep } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'k6'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Rate, Trend } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'k6/metrics'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> errorRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Rate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'error_rate'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> latencyP99</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Trend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'latency_p99'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> options</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  stages: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, target: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 2分钟 ramp up 到 100 VU</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'5m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, target: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 稳定 100 VU 持续 5 分钟</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, target: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ramp up 到 200 VU</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'5m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, target: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 稳定 200 VU</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { duration: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'2m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, target: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ramp down</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  thresholds: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    http_req_duration: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'p(99)&#x3C;500'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// P99 延迟 &#x3C; 500ms</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    error_rate: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'rate&#x3C;0.01'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 错误率 &#x3C; 1%</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> payload</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    username: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`user_${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">__VU</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    query: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'performance testing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> params</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    headers: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Content-Type'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'application/json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> res</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> http.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">post</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'http://api.example.com/search'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, payload, params);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  check</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(res, {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'status is 200'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'response time &#x3C; 500ms'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> r.timings.duration </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 500</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  errorRate.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(res.status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  latencyP99.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(res.timings.duration);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 模拟用户思考时间</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>wrk</strong> 是一个轻量级的 HTTP 基准测试工具，适合快速测试单个端点：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 基本用法: 12 线程, 400 连接, 30 秒&#10;wrk -t12 -c400 -d30s http://localhost:8080/api/search&#10;&#10;# 使用 Lua 脚本自定义请求&#10;wrk -t12 -c400 -d30s -s script.lua http://localhost:8080/api/search\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 基本用法: 12 线程, 400 连接, 30 秒</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">wrk</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t12</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c400</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d30s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> http://localhost:8080/api/search</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 使用 Lua 脚本自定义请求</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">wrk</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t12</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c400</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d30s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> script.lua</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> http://localhost:8080/api/search</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>语言</th>\n<th>协议支持</th>\n<th>分布式</th>\n<th>结果分析</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>k6</td>\n<td>JavaScript</td>\n<td>HTTP, gRPC, WebSocket</td>\n<td>是 (k6 Cloud)</td>\n<td>内建指标 + Grafana</td>\n</tr>\n<tr>\n<td>wrk/wrk2</td>\n<td>Lua</td>\n<td>HTTP</td>\n<td>否</td>\n<td>CLI 输出</td>\n</tr>\n<tr>\n<td>Locust</td>\n<td>Python</td>\n<td>HTTP, 自定义</td>\n<td>是 (内建)</td>\n<td>Web UI</td>\n</tr>\n<tr>\n<td>Gatling</td>\n<td>Scala/Java</td>\n<td>HTTP, JMS</td>\n<td>是</td>\n<td>HTML 报告</td>\n</tr>\n<tr>\n<td>vegeta</td>\n<td>Go</td>\n<td>HTTP</td>\n<td>否</td>\n<td>CLI + 图表</td>\n</tr>\n</tbody></table>\n<h2 id=\"测试场景设计\">测试场景设计</h2><p>好的负载测试必须<strong>模拟真实的用户行为</strong>，而不是简单地对单个 API 发送请求。关键是设计贴近生产的<strong>测试场景</strong>。</p>\n<p><strong>流量模型</strong>的设计需要基于生产数据：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// k6: 模拟真实流量比例&#10;export default function () {&#10;  const scenario = Math.random();&#10;&#10;  if (scenario &lt; 0.6) {&#10;    // 60% 的请求是浏览/搜索&#10;    http.get(&#39;http://api.example.com/products?q=&#39; + randomQuery());&#10;  } else if (scenario &lt; 0.85) {&#10;    // 25% 是查看详情&#10;    http.get(&#39;http://api.example.com/products/&#39; + randomProductId());&#10;  } else if (scenario &lt; 0.95) {&#10;    // 10% 是加入购物车&#10;    http.post(&#10;      &#39;http://api.example.com/cart&#39;,&#10;      JSON.stringify({&#10;        product_id: randomProductId(),&#10;        quantity: 1,&#10;      }),&#10;    );&#10;  } else {&#10;    // 5% 是下单&#10;    http.post(&#10;      &#39;http://api.example.com/orders&#39;,&#10;      JSON.stringify({&#10;        cart_id: randomCartId(),&#10;        payment_method: &#39;credit_card&#39;,&#10;      }),&#10;    );&#10;  }&#10;&#10;  sleep(Math.random() * 3 + 1);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// k6: 模拟真实流量比例</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> scenario</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (scenario </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 60% 的请求是浏览/搜索</span></span>\n<span class=\