83\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> top_stats[:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]:</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(stat)</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"// Go: 对比两个时间点的 heap profile&#10;// curl http://localhost:6060/debug/pprof/heap &gt; t0.prof&#10;// (等待一段时间)&#10;// curl http://localhost:6060/debug/pprof/heap &gt; t1.prof&#10;&#10;// go tool pprof -base t0.prof t1.prof&#10;// (pprof) top&#10;// 显示 t1 相对于 t0 的增量分配 → 泄漏位置\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Go: 对比两个时间点的 heap profile</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// curl http://localhost:6060/debug/pprof/heap > t0.prof</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// (等待一段时间)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// curl http://localhost:6060/debug/pprof/heap > t1.prof</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// go tool pprof -base t0.prof t1.prof</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// (pprof) top</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 显示 t1 相对于 t0 的增量分配 → 泄漏位置</span></span></code></pre></div><h2 id=\"实战指南\">实战指南</h2><h3 id=\"案例一-go-服务-cpu-占用过高\">案例一：Go 服务 CPU 占用过高</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 步骤 1: 获取 CPU profile&#10;curl -o cpu.prof &quot;http://service:6060/debug/pprof/profile?seconds=30&quot;&#10;&#10;# 步骤 2: 交互式分析&#10;go tool pprof -http=:8080 cpu.prof&#10;# 浏览器打开 http://localhost:8080&#10;# 查看 Graph 视图和 Flame Graph 视图&#10;&#10;# 步骤 3: 命令行快速定位&#10;go tool pprof cpu.prof&#10;# (pprof) top10&#10;# Showing top 10 nodes out of 150&#10;#       flat  flat%   sum%        cum   cum%&#10;#     4.52s 30.13%  30.13%      4.52s 30.13%  encoding/json.(*decodeState).scanWhile&#10;#     2.10s 14.00%  44.13%      2.10s 14.00%  runtime.memmove&#10;#     1.80s 12.00%  56.13%      6.32s 42.13%  encoding/json.Unmarshal\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 步骤 1: 获取 CPU profile</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">curl</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -o</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cpu.prof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"http://service:6060/debug/pprof/profile?seconds=30\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 步骤 2: 交互式分析</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">go</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> tool</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> pprof</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -http=:8080</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cpu.prof</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 浏览器打开 http://localhost:8080</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 查看 Graph 视图和 Flame Graph 视图</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 步骤 3: 命令行快速定位</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">go</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> tool</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> pprof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cpu.prof</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># (pprof) top10</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Showing top 10 nodes out of 150</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#       flat  flat%   sum%        cum   cum%</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     4.52s 30.13%  30.13%      4.52s 30.13%  encoding/json.(*decodeState).scanWhile</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     2.10s 14.00%  44.13%      2.10s 14.00%  runtime.memmove</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     1.80s 12.00%  56.13%      6.32s 42.13%  encoding/json.Unmarshal</span></span></code></pre></div><h3 id=\"案例二-node-js-内存泄漏\">案例二：Node.js 内存泄漏</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 步骤 1: 启用 heap snapshot&#10;// --inspect 启动后在 Chrome DevTools 中操作&#10;// 或使用 v8.writeHeapSnapshot()&#10;&#10;const v8 = require(&#39;v8&#39;);&#10;&#10;// 定期生成 heap snapshot 对比&#10;setInterval(() =&gt; {&#10;  const filename = v8.writeHeapSnapshot();&#10;  console.log(`Heap snapshot written to ${filename}`);&#10;}, 60_000);&#10;&#10;// 步骤 2: 使用 clinic.js 自动诊断&#10;// npx clinic doctor -- node app.js&#10;// npx clinic flame -- node app.js&#10;// npx clinic heap -- node app.js\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 步骤 1: 启用 heap snapshot</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// --inspect 启动后在 Chrome DevTools 中操作</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 或使用 v8.writeHeapSnapshot()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> v8</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> require</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'v8'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 定期生成 heap snapshot 对比</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setInterval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> filename</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v8.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">writeHeapSnapshot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Heap snapshot written to ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">filename</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">60_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 步骤 2: 使用 clinic.js 自动诊断</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// npx clinic doctor -- node app.js</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// npx clinic flame -- node app.js</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// npx clinic heap -- node app.js</span></span></code></pre></div><h3 id=\"案例三-java-gc-压力诊断\">案例三：Java GC 压力诊断</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 步骤 1: 观察 GC 行为&#10;# -Xlog:gc*:file=gc.log:time,uptime,level,tags&#10;&#10;# 步骤 2: 使用 async-profiler 分析分配热点&#10;./asprof -e alloc -d 60 -f alloc.html $(pidof java)&#10;# 生成内存分配火焰图，显示哪些代码路径分配最多对象&#10;&#10;# 步骤 3: 分析 GC 日志&#10;# 关注: Allocation Rate, Promotion Rate, Pause Time&#10;# 工具: GCViewer, GCEasy.io\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 步骤 1: 观察 GC 行为</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># -Xlog:gc*:file=gc.log:time,uptime,level,tags</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 步骤 2: 使用 async-profiler 分析分配热点</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">./asprof</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> alloc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 60</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> alloc.html</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pidof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> java</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 生成内存分配火焰图，显示哪些代码路径分配最多对象</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 步骤 3: 分析 GC 日志</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 关注: Allocation Rate, Promotion Rate, Pause Time</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 工具: GCViewer, GCEasy.io</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"profiling-工作流\">Profiling 工作流</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[&quot;建立基准 baseline&quot;] --&gt; B[&quot;识别瓶颈&quot;]&#10;    B --&gt; C[&quot;形成优化假设&quot;]&#10;    C --&gt; D[&quot;实施优化&quot;]&#10;    D --&gt; E[&quot;验证效果&quot;]&#10;    E --&gt; F{&quot;达到目标?&quot;}&#10;    F --&gt;|&quot;否&quot;| B&#10;    F --&gt;|&quot;是&quot;| G[&quot;记录优化方案&quot;]\">flowchart TD\n    A[\"建立基准 baseline\"] --&gt; B[\"识别瓶颈\"]\n    B --&gt; C[\"形成优化假设\"]\n    C --&gt; D[\"实施优化\"]\n    D --&gt; E[\"验证效果\"]\n    E --&gt; F{\"达到目标?\"}\n    F --&gt;|\"否\"| B\n    F --&gt;|\"是\"| G[\"记录优化方案\"]</pre><h3 id=\"各语言推荐工具链\">各语言推荐工具链</h3><table>\n<thead>\n<tr>\n<th>语言</th>\n<th>CPU Profiler</th>\n<th>Memory Profiler</th>\n<th>推荐场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Go</td>\n<td>pprof (内置)</td>\n<td>pprof heap</td>\n<td>HTTP 端点 + go tool pprof</td>\n</tr>\n<tr>\n<td>Java/JVM</td>\n<td>async-profiler</td>\n<td>JFR + MAT</td>\n<td>生产采集 + 离线分析</td>\n</tr>\n<tr>\n<td>Python</td>\n<td>py-spy</td>\n<td>tracemalloc</td>\n<td>外挂进程 + 内置追踪</td>\n</tr>\n<tr>\n<td>Node.js</td>\n<td>clinic flame</td>\n<td>clinic heap</td>\n<td>一键诊断工具包</td>\n</tr>\n<tr>\n<td>Rust</td>\n<td>perf + flamegraph</td>\n<td>DHAT (Valgrind)</td>\n<td>系统级采集</td>\n</tr>\n<tr>\n<td>C/C++</td>\n<td>perf, Instruments</td>\n<td>Valgrind, ASan</td>\n<td>最底层工具</td>\n</tr>\n</tbody></table>\n<h3 id=\"生产环境-profiling-安全守则\">生产环境 Profiling 安全守则</h3><table>\n<thead>\n<tr>\n<th>规则</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>采样频率不超过 99-199Hz</td>\n<td>更高频率影响性能</td>\n</tr>\n<tr>\n<td>单次采集不超过 60s</td>\n<td>避免数据量过大</td>\n</tr>\n<tr>\n<td>先在 staging 验证</td>\n<td>确认 profiler 不影响稳定性</td>\n</tr>\n<tr>\n<td>限制并发 profile 数</td>\n<td>多个 profile 叠加开销</td>\n</tr>\n<tr>\n<td>敏感数据注意脱敏</td>\n<td>profile 可能包含函数参数</td>\n</tr>\n<tr>\n<td>结果存储在安全位置</td>\n<td>profile 数据可能包含业务逻辑</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"持续-profiling-平台-2026-趋势\">持续 Profiling 平台（2026 趋势）</h3><p>持续 Profiling 将采样分析从&quot;按需手动&quot;升级为&quot;always-on 自动&quot;：</p>\n<table>\n<thead>\n<tr>\n<th>平台</th>\n<th>特点</th>\n<th>存储</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Pyroscope (Grafana)</td>\n<td>开源, 多语言</td>\n<td>本地/云</td>\n</tr>\n<tr>\n<td>Parca</td>\n<td>开源, eBPF 支持</td>\n<td>对象存储</td>\n</tr>\n<tr>\n<td>Datadog Profiling</td>\n<td>商业, APM 集成</td>\n<td>SaaS</td>\n</tr>\n<tr>\n<td>Google Cloud Profiler</td>\n<td>商业, GCP 集成</td>\n<td>SaaS</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# Pyroscope 部署配置示例&#10;# docker run -p 4040:4040 grafana/pyroscope&#10;&#10;# Go 集成&#10;# import &quot;github.com/grafana/pyroscope-go&quot;&#10;# pyroscope.Start(pyroscope.Config{&#10;#     ApplicationName: &quot;order-service&quot;,&#10;#     ServerAddress:   &quot;http://pyroscope:4040&quot;,&#10;#     ProfileTypes: []pyroscope.ProfileType{&#10;#         pyroscope.ProfileCPU,&#10;#         pyroscope.ProfileAllocObjects,&#10;#         pyroscope.ProfileAllocSpace,&#10;#         pyroscope.ProfileGoroutines,&#10;#     },&#10;# })\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Pyroscope 部署配置示例</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># docker run -p 4040:4040 grafana/pyroscope</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Go 集成</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># import \"github.com/grafana/pyroscope-go\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># pyroscope.Start(pyroscope.Config{</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     ApplicationName: \"order-service\",</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     ServerAddress:   \"http://pyroscope:4040\",</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     ProfileTypes: []pyroscope.ProfileType{</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#         pyroscope.ProfileCPU,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#         pyroscope.ProfileAllocObjects,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#         pyroscope.ProfileAllocSpace,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#         pyroscope.ProfileGoroutines,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#     },</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># })</span></span></code></pre></div><h2 id=\"总结\">总结</h2><p>CPU 和内存 Profiling 是性能优化的&quot;显微镜&quot;——它让你看到程序内部的资源消耗分布，用数据而非直觉指导优化。关键实践：选择采样型工具用于生产、建立优化前后的量化对比、将持续 Profiling 集成到监控体系中。记住：未经测量的优化是过早优化。</p>\n","headings":[{"level":1,"text":"CPU 与内存 Profiling","id":"cpu-与内存-profiling"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"Profiling 的两种模式","id":"profiling-的两种模式"},{"level":3,"text":"CPU Profiling 工作原理","id":"cpu-profiling-工作原理"},{"level":3,"text":"内存 Profiling 技术","id":"内存-profiling-技术"},{"level":3,"text":"内存泄漏检测","id":"内存泄漏检测"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"案例一：Go 服务 CPU 占用过高","id":"案例一-go-服务-cpu-占用过高"},{"level":3,"text":"案例二：Node.js 内存泄漏","id":"案例二-node-js-内存泄漏"},{"level":3,"text":"案例三：Java GC 压力诊断","id":"案例三-java-gc-压力诊断"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"Profiling 工作流","id":"profiling-工作流"},{"level":3,"text":"各语言推荐工具链","id":"各语言推荐工具链"},{"level":3,"text":"生产环境 Profiling 安全守则","id":"生产环境-profiling-安全守则"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"持续 Profiling 平台（2026 趋势）","id":"持续-profiling-平台-2026-趋势"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"指标与告警","url":"/l-doc-books/h/cs-fundamentals/debugging-troubleshooting/logging-and-observability/metrics-and-alerting"},"next":{"title":"火焰图解读与实战","url":"/l-doc-books/h/cs-fundamentals/debugging-troubleshooting/performance-profiling/flame-graph-analysis"}}