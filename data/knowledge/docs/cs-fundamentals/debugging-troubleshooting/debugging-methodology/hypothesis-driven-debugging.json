ECT state, count(*)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">FROM pg_stat_activity</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">WHERE datname = 'orders'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">GROUP BY state;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 实验 2：验证数据异常假设</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 预测：如果是数据问题，相同 order_id 应该稳定复现</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 操作：提取报错的 order_id 列表，逐一请求</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 实验 3：验证下游超时假设</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 预测：如果是超时问题，错误日志应包含 timeout 关键字</span></span></code></pre></div><p><strong>步骤 3：执行并更新</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 检查连接池&#10;curl -s http://order-service:8080/actuator/metrics/hikaricp.connections.active&#10;&#10;# 输出：{&quot;measurements&quot;:[{&quot;value&quot;: 10.0}]}&#10;# 连接池上限 50，当前才 10 → 排除 H1&#10;&#10;# 检查错误的 order_id&#10;grep &quot;500&quot; access.log | awk &#39;{print $7}&#39; | sort | uniq -c | sort -rn | head&#10;# 发现 order_id=99847 出现了 200 次 → H2 可能性增加&#10;&#10;# 直接请求该 order&#10;curl http://order-service:8080/api/orders/99847&#10;# 稳定返回 500 → H2 确认\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 检查连接池</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">curl</span><