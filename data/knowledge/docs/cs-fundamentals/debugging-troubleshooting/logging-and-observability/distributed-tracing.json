FF\">\"high_risk_score\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            raise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PaymentBlockedError(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Risk score too high: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">risk_score</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 调用银行 API（requests 自动被追踪）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requests.post(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">BANK_API</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">json</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"amount\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: amount})</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        span.set_attribute(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"payment.bank_status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, result.status_code)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result.json()</span></span></code></pre></div><h3 id=\"采样策略\">采样策略</h3><p>全量追踪在高流量系统中成本过高，需要智能采样：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# OpenTelemetry Collector 配置示例&#10;processors:&#10;  # 尾采样：基于完整 trace 特征决定是否保留&#10;  tail_sampling:&#10;    policies:&#10;      # 所有错误 trace 全量保留&#10;      - name: errors&#10;        type: status_code&#10;        status_code: { status_codes: [ERROR] }&#10;&#10;      # 慢请求全量保留&#10;      - name: slow-requests&#10;        type: latency&#10;        latency: { threshold_ms: 1000 }&#10;&#10;      # 正常请求按 10% 采样&#10;      - name: normal-traffic&#10;        type: probabilistic&#10;        probabilistic: { sampling_percentage: 10 }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># OpenTelemetry Collector 配置示例</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">processors</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 尾采样：基于完整 trace 特征决定是否保留</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  tail_sampling</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    policies</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # 所有错误 trace 全量保留</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">errors</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">status_code</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        status_code</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">status_codes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ERROR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # 慢请求全量保留</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">slow-requests</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">latency</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        latency</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">threshold_ms</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # 正常请求按 10% 采样</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">normal-traffic</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">probabilistic</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        probabilistic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">sampling_percentage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span></code></pre></div><h2 id=\"实战指南\">实战指南</h2><h3 id=\"在现有系统中引入追踪\">在现有系统中引入追踪</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    A[&quot;阶段 1: 自动追踪&quot;] --&gt; B[&quot;阶段 2: 关键路径手动追踪&quot;]&#10;    B --&gt; C[&quot;阶段 3: 业务指标关联&quot;]&#10;    C --&gt; D[&quot;阶段 4: 告警集成&quot;]&#10;&#10;    A --&gt; A1[&quot;SDK 自动 instrument&quot;]&#10;    B --&gt; B1[&quot;核心业务 Span&quot;]&#10;    C --&gt; C1[&quot;SLI 从 trace 提取&quot;]&#10;    D --&gt; D1[&quot;异常 trace 触发告警&quot;]\">flowchart LR\n    A[\"阶段 1: 自动追踪\"] --&gt; B[\"阶段 2: 关键路径手动追踪\"]\n    B --&gt; C[\"阶段 3: 业务指标关联\"]\n    C --&gt; D[\"阶段 4: 告警集成\"]\n\n    A --&gt; A1[\"SDK 自动 instrument\"]\n    B --&gt; B1[\"核心业务 Span\"]\n    C --&gt; C1[\"SLI 从 trace 提取\"]\n    D --&gt; D1[\"异常 trace 触发告警\"]</pre><p><strong>阶段 1：零代码自动追踪</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# Java: 使用 OpenTelemetry Java Agent（无需改代码）&#10;java -javaagent:opentelemetry-javaagent.jar \\&#10;     -Dotel.service.name=order-service \\&#10;     -Dotel.exporter.otlp.endpoint=http://collector:4317 \\&#10;     -jar app.jar&#10;&#10;# Node.js: 在入口文件最前面加载&#10;node --require @opentelemetry/auto-instrumentations-node/register app.js\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Java: 使用 OpenTelemetry Java Agent（无需改代码）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">java</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -javaagent:opentelemetry-javaagent.jar</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">     -Dotel.service.name=order-service</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">     -Dotel.exporter.otlp.endpoint=http://collector:4317</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">     -jar</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.jar</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Node.js: 在入口文件最前面加载</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">node</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --require</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> @opentelemetry/auto-instrumentations-node/register</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.js</span></span></code></pre></div><p><strong>阶段 2：关键业务 Span</strong></p>\n<p>对核心业务逻辑添加有意义的 Span 和属性，而不仅是框架层的自动追踪。</p>\n<h3 id=\"跨服务问题排查流程\">跨服务问题排查流程</h3><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# 典型排查流程&#10;investigation_steps = &quot;&quot;&quot;&#10;1. 从告警或用户报告获取 trace_id&#10;2. 在追踪系统中查看完整调用链&#10;3. 识别异常 Span（红色/超时/错误）&#10;4. 检查异常 Span 的属性和事件&#10;5. 进入对应服务的日志（用 trace_id 关联）&#10;6. 定位根因并修复&#10;&quot;&quot;&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 典型排查流程</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">investigation_steps </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">1. 从告警或用户报告获取 trace_id</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">2. 在追踪系统中查看完整调用链</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">3. 识别异常 Span（红色/超时/错误）</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">4. 检查异常 Span 的属性和事件</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">5. 进入对应服务的日志（用 trace_id 关联）</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">6. 定位根因并修复</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"\"</span></span></code></pre></div><h3 id=\"追踪数据的分析价值\">追踪数据的分析价值</h3><p>除了单次问题排查，追踪数据还可以用于：</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 从追踪数据提取服务依赖图&#10;SELECT&#10;    parent_service,&#10;    child_service,&#10;    COUNT(*) as call_count,&#10;    AVG(duration_ms) as avg_latency,&#10;    PERCENTILE_CONT(0.99) WITHIN GROUP (ORDER BY duration_ms) as p99&#10;FROM spans&#10;WHERE timestamp &gt; NOW() - INTERVAL &#39;1 hour&#39;&#10;GROUP BY parent_service, child_service&#10;ORDER BY avg_latency DESC;&#10;&#10;-- 识别性能退化&#10;SELECT&#10;    operation_name,&#10;    DATE_TRUNC(&#39;hour&#39;, timestamp) as hour,&#10;    PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY duration_ms) as p95&#10;FROM spans&#10;WHERE 