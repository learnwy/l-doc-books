"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 数据库</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"db.system\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"postgresql\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"db.statement\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SQL（脱敏）\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"db.operation\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SELECT/INSERT/...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 错误</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"error\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"exception.type\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"NullPointerException\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"exception.message\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"详细信息\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"追踪系统选型\">追踪系统选型</h3><table>\n<thead>\n<tr>\n<th>系统</th>\n<th>存储</th>\n<th>特点</th>\n<th>适用规模</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Jaeger</td>\n<td>Elasticsearch/Cassandra</td>\n<td>CNCF 毕业项目</td>\n<td>中大型</td>\n</tr>\n<tr>\n<td>Tempo</td>\n<td>对象存储</td>\n<td>无需索引, 成本低</td>\n<td>大型</td>\n</tr>\n<tr>\n<td>Zipkin</td>\n<td>多种后端</td>\n<td>简单轻量</td>\n<td>小中型</td>\n</tr>\n<tr>\n<td>Datadog APM</td>\n<td>商业 SaaS</td>\n<td>开箱即用</td>\n<td>任意</td>\n</tr>\n<tr>\n<td>SigNoz</td>\n<td>ClickHouse</td>\n<td>开源全栈</td>\n<td>中型</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"opentelemetry-生态\">OpenTelemetry 生态</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph SDK[&quot;应用层 SDK&quot;]&#10;        S1[&quot;Go SDK&quot;]&#10;        S2[&quot;Java Agent&quot;]&#10;        S3[&quot;Python SDK&quot;]&#10;        S4[&quot;Node.js SDK&quot;]&#10;    end&#10;    subgraph COLLECTOR[&quot;OTel Collector&quot;]&#10;        C1[&quot;Receivers&quot;]&#10;        C2[&quot;Processors&quot;]&#10;        C3[&quot;Exporters&quot;]&#10;    end&#10;    subgraph BACKENDS[&quot;后端&quot;]&#10;        B1[&quot;Jaeger&quot;]&#10;        B2[&quot;Tempo&quot;]&#10;        B3[&quot;Datadog&quot;]&#10;        B4[&quot;New Relic&quot;]&#10;    end&#10;    SDK --&gt; COLLECTOR&#10;    COLLECTOR --&gt; BACKENDS\">flowchart TD\n    subgraph SDK[\"应用层 SDK\"]\n        S1[\"Go SDK\"]\n        S2[\"Java Agent\"]\n        S3[\"Python SDK\"]\n        S4[\"Node.js SDK\"]\n    end\n    subgraph COLLECTOR[\"OTel Collector\"]\n        C1[\"Receivers\"]\n        C2[\"Processors\"]\n        C3[\"Exporters\"]\n    end\n    subgraph BACKENDS[\"后端\"]\n        B1[\"Jaeger\"]\n        B2[\"Tempo\"]\n        B3[\"Datadog\"]\n        B4[\"New Relic\"]\n    end\n    SDK --&gt; COLLECTOR\n    COLLECTOR --&gt; BACKENDS</pre><h3 id=\"2026-年趋势\">2026 年趋势</h3><ul>\n<li><strong>AI Agent 追踪</strong>：OpenTelemetry GenAI 语义约定已支持追踪 LLM 调用、tool call、planning 步骤</li>\n<li><strong>eBPF 自动追踪</strong>：无需 SDK 即可获得内核级追踪</li>\n<li><strong>追踪驱动测试</strong>：从生产 trace 自动生成集成测试场景</li>\n<li><strong>成本优化</strong>：基于 trace 重要性的智能采样和存储分层</li>\n</ul>\n<h2 id=\"总结\">总结</h2><p>分布式追踪是微服务架构中排查跨服务问题的核心技术。采用 OpenTelemetry 作为标准、实施分阶段引入策略、配合合理的采样和存储方案，可以在可控成本下获得对系统行为的深度可见性。关键原则：先自动后手动、错误全量采样、与日志和指标关联使用。</p>\n","headings":[{"level":1,"text":"分布式追踪","id":"分布式追踪"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"Trace、Span 和 Context","id":"trace-span-和-context"},{"level":3,"text":"W3C Trace Context 标准","id":"w3c-trace-context-标准"},{"level":3,"text":"OpenTelemetry 实现","id":"opentelemetry-实现"},{"level":3,"text":"采样策略","id":"采样策略"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"在现有系统中引入追踪","id":"在现有系统中引入追踪"},{"level":3,"text":"跨服务问题排查流程","id":"跨服务问题排查流程"},{"level":3,"text":"追踪数据的分析价值","id":"追踪数据的分析价值"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"Span 命名规范","id":"span-命名规范"},{"level":3,"text":"关键属性清单","id":"关键属性清单"},{"level":3,"text":"追踪系统选型","id":"追踪系统选型"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"OpenTelemetry 生态","id":"opentelemetry-生态"},{"level":3,"text":"2026 年趋势","id":"2026-年趋势"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"结构化日志设计","url":"/l-doc-books/h/cs-fundamentals/debugging-troubleshooting/logging-and-observability/structured-logging-design"},"next":{"title":"指标与告警","url":"/l-doc-books/h/cs-fundamentals/debugging-troubleshooting/logging-and-observability/metrics-and-alerting"}}