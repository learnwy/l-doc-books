le=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    span.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">AddEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"order_completed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, trace.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithAttributes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        attribute.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"items_count\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# Python: OpenTelemetry 自动和手动混合追踪&#10;from opentelemetry import trace&#10;from opentelemetry.instrumentation.requests import RequestsInstrumentor&#10;from opentelemetry.instrumentation.sqlalchemy import SQLAlchemyInstrumentor&#10;&#10;# 自动追踪 HTTP 客户端和数据库查询&#10;RequestsInstrumentor().instrument()&#10;SQLAlchemyInstrumentor().instrument()&#10;&#10;# 手动追踪业务逻辑&#10;tracer = trace.get_tracer(&quot;payment-service&quot;)&#10;&#10;def process_payment(order_id: str, amount: float):&#10;    with tracer.start_as_current_span(&quot;process_payment&quot;) as span:&#10;        span.set_attribute(&quot;payment.order_id&quot;, order_id)&#10;        span.set_attribute(&quot;payment.amount&quot;, amount)&#10;&#10;        # 风控检查（自动成为子 Span）&#10;        risk_score = check_risk(order_id, amount)&#10;        span.set_attribute(&quot;payment.risk_score&quot;, risk_score)&#10;&#10;        if risk_score &gt; 0.8:&#10;            span.add_event(&quot;payment_blocked&quot;, {&#10;                &quot;reason&quot;: &quot;high_risk_score&quot;&#10;            })&#10;            raise PaymentBlockedError(f&quot;Risk score too high: {risk_score}&quot;)&#10;&#10;        # 调用银行 API（requests 自动被追踪）&#10;        result = requests.post(BANK_API, json={&quot;amount&quot;: amount})&#10;        span.set_attribute(&quot;payment.bank_status&quot;, result.status_code)&#10;        return result.json()\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Python: OpenTelemetry 自动和手动混合追踪</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> opentelemetry </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> trace</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> opentelemetry.instrumentation.requests </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RequestsInstrumentor</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> opentelemetry.instrumentation.sqlalchemy </span><span style=\"color:#