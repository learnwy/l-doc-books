):&#10;        self.slo_target = slo_target  # e.g., 0.999&#10;        self.window_days = window_days&#10;        self.budget_total = 1.0 - slo_target  # 0.001 = 0.1%&#10;&#10;    def remaining(self, current_error_rate: float, days_elapsed: int):&#10;        &quot;&quot;&quot;计算剩余错误预算&quot;&quot;&quot;&#10;        budget_used = current_error_rate * days_elapsed / self.window_days&#10;        remaining = self.budget_total - budget_used&#10;        return remaining / self.budget_total  # 返回剩余百分比&#10;&#10;    def burn_rate(self, current_error_rate: float):&#10;        &quot;&quot;&quot;当前消耗速率（1.0 = 刚好用完预算）&quot;&quot;&quot;&#10;        return current_error_rate / self.budget_total * self.window_days&#10;&#10;# 基于 burn rate 的多窗口告警&#10;burn_rate_alerts = [&#10;    {&quot;severity&quot;: &quot;critical&quot;, &quot;burn_rate&quot;: 14.4, &quot;short_window&quot;: &quot;5m&quot;,  &quot;long_window&quot;: &quot;1h&quot;},&#10;    {&quot;severity&quot;: &quot;critical&quot;, &quot;burn_rate&quot;: 6.0,  &quot;short_window&quot;: &quot;30m&quot;, &quot;long_window&quot;: &quot;6h&quot;},&#10;    {&quot;severity&quot;: &quot;warning&quot;,  &quot;burn_rate&quot;: 3.0,  &quot;short_window&quot;: &quot;2h&quot;,  &quot;long_window&quot;: &quot;1d&quot;},&#10;    {&quot;severity&quot;: &quot;warning&quot;,  &quot;burn_rate&quot;: 1.0,  &quot;short_window&quot;: &quot;6h&quot;,  &quot;long_window&quot;: &quot;3d&quot;},&#10;]\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 错误预算计算</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ErrorBudget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\"> 