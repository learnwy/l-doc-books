log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    txn_id       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGSERIAL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    from_account </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    to_account   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BIGINT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    amount       </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DECIMAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">15</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> CHECK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    txn_time     </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TIMESTAMP</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CURRENT_TIMESTAMP,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    FOREIGN KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (from_account) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">REFERENCES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bank_account(account_id),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    FOREIGN KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (to_account) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">REFERENCES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bank_account(account_id),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    CHECK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (from_account </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> to_account)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><hr>\n<h2 id=\"约束策略选择\">约束策略选择</h2><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>优点</th>\n<th>缺点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数据库约束</td>\n<td>强制执行，不可绕过</td>\n<td>灵活性低，迁移复杂</td>\n<td>核心数据一致性</td>\n</tr>\n<tr>\n<td>应用层校验</td>\n<td>灵活，可定制</td>\n<td>可被绕过</td>\n<td>用户输入验证</td>\n</tr>\n<tr>\n<td>触发器</td>\n<td>能实现复杂逻辑</td>\n<td>调试困难，隐式执行</td>\n<td>跨表业务规则</td>\n</tr>\n<tr>\n<td>应用 + 数据库</td>\n<td>双重保障</td>\n<td>维护成本高</td>\n<td>金融等高可靠场景</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((数据完整性))&#10;    实体完整性&#10;      PRIMARY KEY&#10;      UNIQUE&#10;    参照完整性&#10;      FOREIGN KEY&#10;      级联操作&#10;    域完整性&#10;      CHECK&#10;      NOT NULL&#10;      DEFAULT&#10;    用户定义完整性&#10;      触发器&#10;      存储过程&#10;    策略选择&#10;      数据库约束优先&#10;      应用层补充\">mindmap\n  root((数据完整性))\n    实体完整性\n      PRIMARY KEY\n      UNIQUE\n    参照完整性\n      FOREIGN KEY\n      级联操作\n    域完整性\n      CHECK\n      NOT NULL\n      DEFAULT\n    用户定义完整性\n      触发器\n      存储过程\n    策略选择\n      数据库约束优先\n      应用层补充</pre><ul>\n<li><strong>实体完整性</strong>通过主键保证每行的唯一标识。</li>\n<li><strong>参照完整性</strong>通过外键和级联策略维护表间引用关系的有效性。</li>\n<li><strong>域完整性</strong>通过 CHECK、NOT NULL 等约束限制列的取值范围。</li>\n<li><strong>触发器</strong>是实现复杂业务规则的利器，但应谨慎使用避免隐式行为。</li>\n<li>推荐采用<strong>数据库约束 + 应用层校验</strong>的双重保障策略。</li>\n</ul>\n","headings":[{"level":1,"text":"数据完整性","id":"数据完整性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"实体完整性","id":"实体完整性"},{"level":2,"text":"参照完整性","id":"参照完整性"},{"level":3,"text":"级联操作","id":"级联操作"},{"level":2,"text":"域完整性","id":"域完整性"},{"level":2,"text":"用户定义完整性","id":"用户定义完整性"},{"level":3,"text":"触发器实现业务规则","id":"触发器实现业务规则"},{"level":3,"text":"触发器类型对比","id":"触发器类型对比"},{"level":2,"text":"综合约束设计示例","id":"综合约束设计示例"},{"level":2,"text":"约束策略选择","id":"约束策略选择"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ER 建模","url":"/l-doc-books/h/cs-fundamentals/database-systems/relational-model/er-modeling"},"next":{"title":"DDL 与 DML","url":"/l-doc-books/h/cs-fundamentals/database-systems/sql-mastery/ddl-and-dml"}}