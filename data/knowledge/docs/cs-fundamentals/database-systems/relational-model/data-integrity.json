\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">RETURNS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TRIGGER </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $$</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">BEGIN</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    IF</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> NEW</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">total_amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> credit_limit </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> users </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> NEW</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user_id</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">THEN</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        RAISE EXCEPTION </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'订单金额超出信用额度'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    END</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IF</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    RETURN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NEW;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">END</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$$ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">LANGUAGE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> plpgsql;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TRIGGER</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> trg_credit_check</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    BEFORE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INSERT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> OR</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> UPDATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orders</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    FOR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> EACH </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ROW</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    EXECUTE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FUNCTION</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> check_credit_limit();</span></span></code></pre></div><h3 id=\"触发器类型对比\">触发器类型对比</h3><table>\n<thead>\n<tr>\n<th>触发时机</th>\n<th>行级 / 语句级</th>\n<th>典型用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>BEFORE INSERT</td>\n<td>行级</td>\n<td>数据校验、自动填充</td>\n</tr>\n<tr>\n<td>AFTER INSERT</td>\n<td>行级</td>\n<td>审计日志、同步更新</td>\n</tr>\n<tr>\n<td>BEFORE UPDATE</td>\n<td>行级</td>\n<td>检查变更合法性</td>\n</tr>\n<tr>\n<td>AFTER DELETE</td>\n<td>行级</td>\n<td>级联清理、归档</td>\n</tr>\n<tr>\n<td>INSTEAD OF</td>\n<td>行级</td>\n<td>视图上的 DML 操作（可更新视图）</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"综合约束设计示例\">综合约束设计示例</h2><div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE bank_account (&#10;    account_id   BIGINT PRIMARY KEY,&#10;    owner_name   VARCHAR(100) NOT NULL,&#10;    balance      DECIMAL(15, 2) NOT NULL DEFAULT 0.00&#10;                 CHECK (balance &gt;= 0),&#10;    account_type VARCHAR(20) NOT NULL&#10;                 CHECK (account_type IN (&#39;savings&#39;, &#39;checking&#39;, &#39;credit&#39;)),&#10;    status       VARCHAR(10) NOT NULL DEFAULT &#39;active&#39;&#10;                 CHECK (status IN (&#39;active&#39;, &#39;frozen&#39;, &#39;closed&#39;)),&#10;    created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    branch_id    INT NOT NULL,&#10;    FOREIGN KEY (branch_id) REFERENCES branch(branch_id)&#10;        ON DELETE RESTRICT&#10;        ON UPDATE CASCADE&#10;);&#10;&#10;CREATE TABLE transaction_log (&#10;    txn_id       BIGSERIAL PRIMARY KEY,&#10;    from_account BIGINT NOT NULL,&#10;    to_account   BIGINT NOT NULL,&#10;    amount       DECIMAL(15, 2) NOT NULL CHECK (amount &gt; 0),&#10;    txn_time     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    FOREIGN KEY (from_account) REFERENCES bank_account(account_id),&#10;    FOREIGN KEY (to_account) REFERENCES bank_account(account_id),&#10;    CHECK (from_account &lt;&gt; to_account)&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#