ock, version FROM products WHERE id = 100;&#10;-- 返回 stock=10, version=5&#10;&#10;-- 更新时检查版本号&#10;UPDATE products&#10;SET stock = stock - 1, version = version + 1&#10;WHERE id = 100 AND version = 5;&#10;-- 如果受影响行数 = 0，说明被其他事务修改过，需要重试&#10;&#10;-- 方案2：CAS（Compare And Swap）&#10;UPDATE products SET stock = 9&#10;WHERE id = 100 AND stock = 10;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 方案1：版本号</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ALTER</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> products </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ADD</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> COLUMN </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 读取</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id, stock, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> products </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 返回 stock=10, version=5</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 更新时检查版本号</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> products</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stock </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stock </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 如果受影响行数 = 0，说明被其他事务修改过，需要重试</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 方案2：CAS（Compare And Swap）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> products </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stock </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 9</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stock </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><hr>\n<h2 id=\"锁粒度选择指南\">锁粒度选择指南</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A{并发写入频率?} --&gt;|高| B{冲突概率?}&#10;    A --&gt;|低| C[表锁或乐观锁]&#10;    B --&gt;|高| D[悲观锁 + 行锁]&#10;    B --&gt;|低| E[乐观锁]&#10;    D --&gt; F{需要跨行?}&#10;    F --&gt;|是| G[注意死锁预防]&#10;    F --&gt;|否| H[单行 FOR UPDATE]\">graph TD\n    A{并发写入频率?} --&gt;|高| B{冲突概率?}\n    A --&gt;|低| C[表锁或乐观锁]\n    B --&gt;|高| D[悲观锁 + 行锁]\n    B --&gt;|低| E[乐观锁]\n    D --&gt; F{需要跨行?}\n    F --&gt;|是| G[注意死锁预防]\n    F --&gt;|否| H[单行 FOR UPDATE]</pre><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((锁机制))&#10;    锁粒度&#10;      行锁 高并发&#10;      表锁 低开销&#10;      间隙锁 防幻读&#10;    死锁&#10;      等待图检测&#10;      超时回滚&#10;      固定加锁顺序&#10;    乐观锁&#10;      版本号&#10;      CAS&#10;      写冲突少时使用&#10;    悲观锁&#10;      FOR UPDATE&#10;      FOR SHARE&#10;      SKIP LOCKED\">mindmap\n  root((锁机制))\n    锁粒度\n      行锁 高并发\n      表锁 低开销\n      间隙锁 防幻读\n    死锁\n      等待图检测\n      超时回滚\n      固定加锁顺序\n    乐观锁\n      版本号\n      CAS\n      写冲突少时使用\n    悲观锁\n      FOR UPDATE\n      FOR SHARE\n      SKIP LOCKED</pre><ul>\n<li><strong>行锁</strong>是 InnoDB 的默认锁粒度，加在索引上，无索引退化为表锁。</li>\n<li><strong>间隙锁</strong>防止幻读，是 InnoDB REPEATABLE READ 的关键机制。</li>\n<li><strong>死锁</strong>不可避免，应通过固定加锁顺序、缩小事务范围来降低发生概率。</li>\n<li><strong>悲观锁</strong>适合高冲突场景，<strong>乐观锁</strong>适合读多写少的低冲突场景。</li>\n<li><code>SKIP LOCKED</code> 是实现并发任务队列的高效手段。</li>\n</ul>\n","headings":[{"level":1,"text":"锁机制","id":"锁机制"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"锁的粒度","id":"锁的粒度"},{"level":2,"text":"行锁","id":"行锁"},{"level":3,"text":"行锁与索引的关系","id":"行锁与索引的关系"},{"level":2,"text":"表锁","id":"表锁"},{"level":2,"text":"死锁","id":"死锁"},{"level":3,"text":"死锁检测与处理","id":"死锁检测与处理"},{"level":3,"text":"避免死锁的实践","id":"避免死锁的实践"},{"level":2,"text":"乐观锁与悲观锁","id":"乐观锁与悲观锁"},{"level":3,"text":"悲观锁实现","id":"悲观锁实现"},{"level":3,"text":"乐观锁实现","id":"乐观锁实现"},{"level":2,"text":"锁粒度选择指南","id":"锁粒度选择指南"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"隔离级别","url":"/l-doc-books/h/cs-fundamentals/database-systems/transactions-and-concurrency/isolation-levels"},"next":{"title":"分布式事务","url":"/l-doc-books/h/cs-fundamentals/database-systems/transactions-and-concurrency/distributed-transactions"}}