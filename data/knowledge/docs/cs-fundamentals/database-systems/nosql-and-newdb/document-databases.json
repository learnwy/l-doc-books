shiki-dark:#E1E4E8\">db.orders.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">aggregate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $match: { status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'completed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $unwind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$items'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    $group: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      _id: { $dateToString: { format: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'%Y-%m'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, date: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$createdAt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      totalRevenue: { $sum: { $multiply: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$items.price'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'$items.qty'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      orderCount: { $sum: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $sort: { _id: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>管道阶段</th>\n<th>作用</th>\n<th>SQL 等价</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>$match</td>\n<td>过滤文档</td>\n<td>WHERE</td>\n</tr>\n<tr>\n<td>$group</td>\n<td>分组聚合</td>\n<td>GROUP BY</td>\n</tr>\n<tr>\n<td>$sort</td>\n<td>排序</td>\n<td>ORDER BY</td>\n</tr>\n<tr>\n<td>$limit</td>\n<td>限制数量</td>\n<td>LIMIT</td>\n</tr>\n<tr>\n<td>$project</td>\n<td>投影字段</td>\n<td>SELECT</td>\n</tr>\n<tr>\n<td>$unwind</td>\n<td>展开数组</td>\n<td>行转列</td>\n</tr>\n<tr>\n<td>$lookup</td>\n<td>关联查询</td>\n<td>LEFT JOIN</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"模式设计模式\">模式设计模式</h2><table>\n<thead>\n<tr>\n<th>模式</th>\n<th>描述</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>属性模式</td>\n<td>将相似字段归入数组</td>\n<td>多语言、多规格</td>\n</tr>\n<tr>\n<td>桶模式</td>\n<td>将时间序列数据分组到桶中</td>\n<td>IoT、日志</td>\n</tr>\n<tr>\n<td>计算模式</td>\n<td>预计算并存储聚合结果</td>\n<td>统计、排行榜</td>\n</tr>\n<tr>\n<td>子集模式</td>\n<td>在父文档中嵌入常用子集</td>\n<td>商品评价前 N 条</td>\n</tr>\n<tr>\n<td>扩展引用模式</td>\n<td>引用中冗余部分常用字段</td>\n<td>订单中冗余商品名称</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"索引策略\">索引策略</h2><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 单字段索引&#10;db.users.createIndex({ email: 1 }, { unique: true });&#10;&#10;// 复合索引&#10;db.orders.createIndex({ userId: 1, createdAt: -1 });&#10;&#10;// 文本索引&#10;db.articles.createIndex({ title: &#39;text&#39;, content: &#39;text&#39; });&#10;&#10;// TTL 索引：自动过期删除&#10;db.sessions.createIndex({ expireAt: 1 }, { expireAfterSeconds: 0 });\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 单字段索引</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.users.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ email: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { unique: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 复合索引</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.orders.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ userId: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, createdAt: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 文本索引</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.articles.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'text'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, content: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'text'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// TTL 索引：自动过期删除</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.sessions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ expireAt: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { expireAfterSeconds: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((文档数据库))&#10;    MongoDB&#10;      BSON 文档&#10;      聚合管道&#10;      水平分片&#10;    数据建模&#10;      嵌入 一次读取&#10;      引用 避免冗余&#10;    设计模式&#10;      属性模式&#10;      桶模式&#10;      计算模式&#10;    索引&#10;      单字段 / 复合&#10;      文本索引&#10;      TTL 索引\">mindmap\n  root((文档数据库))\n    MongoDB\n      BSON 文档\n      聚合管道\n      水平分片\n    数据建模\n      嵌入 一次读取\n      引用 避免冗余\n    设计模式\n      属性模式\n      桶模式\n      计算模式\n    索引\n      单字段 / 复合\n      文本索引\n      TTL 索引</pre><ul>\n<li><strong>文档数据库</strong>以 JSON 文档为存储单元，灵活的 Schema 适合快速迭代。</li>\n<li><strong>嵌入</strong>适合一对少量且一起读取的数据，<strong>引用</strong>适合独立更新的大量关联数据。</li>\n<li><strong>聚合管道</strong>是 MongoDB 的数据分析利器，支持复杂的多阶段数据处理。</li>\n<li>模式设计需要根据<strong>查询模式</strong>而非数据关系来组织文档结构。</li>\n<li>MongoDB 支持丰富的索引类型，TTL 索引可自动清理过期数据。</li>\n</ul>\n","headings":[{"level":1,"text":"文档数据库","id":"文档数据库"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"MongoDB","id":"mongodb"},{"level":3,"text":"基本操作","id":"基本操作"},{"level":3,"text":"查询操作符","id":"查询操作符"},{"level":2,"text":"嵌入 vs 引用","id":"嵌入-vs-引用"},{"level":3,"text":"选择指南","id":"选择指南"},{"level":2,"text":"聚合管道","id":"聚合管道"},{"level":2,"text":"模式设计模式","id":"模式设计模式"},{"level":2,"text":"索引策略","id":"索引策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"键值存储","url":"/l-doc-books/h/cs-fundamentals/database-systems/nosql-and-newdb/key-value-stores"},"next":{"title":"列族存储","url":"/l-doc-books/h/cs-fundamentals/database-systems/nosql-and-newdb/column-family"}}