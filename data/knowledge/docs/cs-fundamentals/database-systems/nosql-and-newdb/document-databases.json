ectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  userId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ObjectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  items</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { productId: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ObjectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), qty: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { productId: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ObjectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), qty: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  total</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5097</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"选择指南\">选择指南</h3><table>\n<thead>\n<tr>\n<th>选择嵌入的场景</th>\n<th>选择引用的场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>一对一或一对少量关系</td>\n<td>一对多（大量）关系</td>\n</tr>\n<tr>\n<td>子数据随父数据一起读取</td>\n<td>子数据独立频繁更新</td>\n</tr>\n<tr>\n<td>数据不会无限增长</td>\n<td>数据可能超过 16MB 文档限制</td>\n</tr>\n<tr>\n<td>不需要独立查询子数据</td>\n<td>需要独立查询和更新子数据</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"聚合管道\">聚合管道</h2><p>MongoDB 聚合管道是一系列数据处理阶段，类似于 Unix 管道。</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 统计每个城市的用户数和平均年龄&#10;db.users.aggregate([&#10;  { $match: { status: &#39;active&#39; } },&#10;  {&#10;    $group: {&#10;      _id: &#39;$address.city&#39;,&#10;      count: { $sum: 1 },&#10;      avgAge: { $avg: &#39;$age&#39; },&#10;    },&#10;  },&#10;  { $sort: { count: -1 } },&#10;  { $limit: 10 },&#10;]);&#10;&#10;// 订单分析：按月统计销售额&#10;db.orders.aggregate([&#10;  { $match: { status: &#39;completed&#39; } },&#10;  { $unwind: &#39;$items&#39; },&#10;  {&#10;    $group: {&#10;      _id: { $dateToString: { format: &#39;%Y-%m&#39;, date: &#39;$createdAt&#39; } },&#10;      totalRevenue: { $sum: { $multiply: [&#39;$items.price&#39;, &#39;$items.qty&#39;] } },&#10;      orderCount: { $sum: 1 },&#10;    },&#10;  },&#10;  { $sort: { _id: 1 } },&#10;]);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 统计每个城市的用户数和平均年龄</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.users.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">aggregate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { $match: { status: </s