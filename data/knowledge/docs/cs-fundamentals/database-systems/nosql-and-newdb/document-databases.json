</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4999</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { userId: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ObjectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'...'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), items: [{ name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'耳机'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, qty: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, price: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">299</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }], total: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">598</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 查询</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.users.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ age: { $gte: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'address.city'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'北京'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 更新</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.users.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">updateOne</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'alice'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { $set: { age: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">29</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, $push: { tags: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'writer'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 删除</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.users.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">deleteMany</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'inactive'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span></code></pre></div><h3 id=\"查询操作符\">查询操作符</h3><table>\n<thead>\n<tr>\n<th>操作符</th>\n<th>说明</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>$eq</td>\n<td>等于</td>\n<td>{ age: { $eq: 25 } }</td>\n</tr>\n<tr>\n<td><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>g</mi><mi>t</mi><mi mathvariant=\"normal\">/</mi></mrow><annotation encoding=\"application/x-tex\">gt /</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">g</span><span class=\"mord mathnormal\">t</span><span class=\"mord\">/</span></span></span></span></span>gte</td>\n<td>大于 / ≥</td>\n<td>{ age: { $gte: 18 } }</td>\n</tr>\n<tr>\n<td><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>l</mi><mi>t</mi><mi mathvariant=\"normal\">/</mi></mrow><annotation encoding=\"application/x-tex\">lt /</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0197em;\">l</span><span class=\"mord mathnormal\">t</span><span class=\"mord\">/</span></span></span></span></span>lte</td>\n<td>小于 / ≤</td>\n<td>{ price: { $lt: 100 } }</td>\n</tr>\n<tr>\n<td>$in</td>\n<td>包含在列表中</td>\n<td>{ status: { $in: [&quot;active&quot;, &quot;vip&quot;] } }</td>\n</tr>\n<tr>\n<td>$regex</td>\n<td>正则匹配</td>\n<td>{ name: { $regex: /^ali/i } }</td>\n</tr>\n<tr>\n<td>$exists</td>\n<td>字段存在</td>\n<td>{ phone: { $exists: true } }</td>\n</tr>\n<tr>\n<td>$elemMatch</td>\n<td>数组元素匹配</td>\n<td>{ items: { <span class=\"math-inline\"><span class=\"katex-error\" title=\"ParseError: KaTeX parse error: Expected &#x27;}&#x27;, got &#x27;EOF&#x27; at end of input: …Match: { qty: {\" style=\"color:#cc0000\">elemMatch: { qty: {</span></span>gt: 2 } } } }</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"嵌入-vs-引用\">嵌入 vs 引用</h2><p>文档数据库中处理关联数据有两种核心策略：</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>数据存储方式</th>\n<th>优点</th>\n<th>缺点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>嵌入</td>\n<td>嵌套在父文档中</td>\n<td>一次读取，无 JOIN</td>\n<td>文档过大，数据冗余</td>\n</tr>\n<tr>\n<td>引用</td>\n<td>存储 ObjectId 引用</td>\n<td>避免冗余</td>\n<td>需要多次查询</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 嵌入模式：订单包含完整商品信息&#10;{&#10;  _id: ObjectId(&quot;...&quot;),&#10;  userId: ObjectId(&quot;...&quot;),&#10;  items: [&#10;    { productId: &quot;P001&quot;, name: &quot;手机&quot;, price: 4999, qty: 1 },&#10;    { productId: &quot;P002&quot;, name: &quot;保护壳&quot;, price: 49, qty: 2 }&#10;  ],&#10;  total: 5097,&#10;  status: &quot;completed&quot;&#10;}&#10;&#10;// 引用模式：订单引用商品 ID&#10;{&#10;  _id: ObjectId(&quot;...&quot;),&#10;  userId: ObjectId(&quot;...&quot;),&#10;  items: [&#10;    { productId: ObjectId(&quot;...&quot;), qty: 1 },&#10;    { productId: ObjectId(&quot;...&quot;), qty: 2 }&#10;  ],&#10;  total: 5097&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 嵌入模式：订单包含完整商品信息</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  _id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ObjectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  userId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ObjectId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  items</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { productId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"P001\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"手机\"</span><span style=\"color:#24292E;--shiki-dark:#