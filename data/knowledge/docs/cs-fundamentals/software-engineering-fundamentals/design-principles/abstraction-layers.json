pan style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MongoUserRepository</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> implements</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserRepository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> findById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">User</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.collection.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">findOne</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ _id: id });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> save</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>六边形架构</strong>（Hexagonal Architecture，又名端口与适配器）是对分层架构的进化。它将&quot;核心业务逻辑&quot;放在中心，周围通过&quot;端口&quot;定义抽象接口，&quot;适配器&quot;负责将外部技术（数据库、消息队列、HTTP 框架）连接到端口。核心业务逻辑不依赖任何外部技术——技术细节被推到了系统的边缘。</p>\n<p>六边形架构的关键优势是<strong>可测试性</strong>：核心业务逻辑可以在没有数据库、没有 HTTP 服务器、没有消息队列的情况下通过纯粹的单元测试验证。所有外部依赖都通过端口接口进行模拟。</p>\n<p><strong>洋葱架构</strong>（Onion Architecture）和<strong>整洁架构</strong>（Clean Architecture）是六边形架构的变体，核心思想一致：依赖方向始终从外向内，内层不知道外层的存在。区别主要在层次的命名和组织方式：洋葱架构强调领域模型在最内层，整洁架构强调用例（Use Case）作为应用核心。</p>\n<table>\n<thead>\n<tr>\n<th>架构风格</th>\n<th>核心思想</th>\n<th>分层方式</th>\n<th>典型应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>三层架构</td>\n<td>水平分层</td>\n<td>表示→业务→数据</td>\n<td>传统 Web 应用</td>\n</tr>\n<tr>\n<td>六边形架构</td>\n<td>端口与适配器</td>\n<td>核心←→端口←→适配器</td>\n<td>领域复杂的应用</td>\n</tr>\n<tr>\n<td>洋葱架构</td>\n<td>依赖向内</td>\n<td>基础设施→应用→领域</td>\n<td>DDD 项目</td>\n</tr>\n<tr>\n<td>整洁架构</td>\n<td>用例驱动</td>\n<td>框架→适配器→用例→实体</td>\n<td>大型企业系统</td>\n</tr>\n</tbody></table>\n<h2 id=\"抽象泄漏的识别与防范\">抽象泄漏的识别与防范</h2><p>&quot;所有非平凡的抽象都是有漏洞的&quot;——Joel Spolsky 的这句名言揭示了抽象设计的根本挑战。抽象泄漏指底层的实现细节穿透抽象层，迫使上层代码处理本应被隐藏的复杂性。</p>\n<p>常见的抽象泄漏场景包括：</p>\n<p>ORM 的 N+1 查询问题。ORM 抽象了 SQL 查询，但开发者如果不理解其背后的 SQL 生成策略，容易在循环中触发大量独立查询。这时&quot;SQL 查询&quot;这个底层细节穿透了 ORM 的抽象。</p>\n<p>HTTP 客户端库隐藏了 TCP 连接管理，但当网络不稳定时，超时、重试和连接池耗尽等底层问题会暴露出来。上层代码必须处理这些异常，这就是抽象泄漏。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[上层代码] --&gt;|调用| B[抽象层接口]&#10;    B --&gt;|正常路径| C[隐藏的实现细节]&#10;    C --&gt;|异常路径| D[泄漏到上层的细节]&#10;    D --&gt;|迫使| A\">graph TD\n    A[上层代码] --&gt;|调用| B[抽象层接口]\n    B --&gt;|正常路径| C[隐藏的实现细节]\n    C --&gt;|异常路径| D[泄漏到上层的细节]\n    D --&gt;|迫使| A</pre><p>防范抽象泄漏的策略包括：<strong>防腐层</strong>（Anti-Corruption Layer）在系统边界处建立翻译层，将外部系统的概念模型转换为内部模型，防止外部的&quot;坏味道&quot;污染核心代码。<strong>故障屏障</strong>（Bulkhead）模式为不同的外部依赖建立独立的资源池，一个依赖的故障不会耗尽其他依赖的资源。<strong>优雅降级</strong>策略在底层组件失败时提供有意义的备选行为，而不是将底层异常直接抛给上层。</p>\n<p>设计抽象层时，应该有意识地定义&quot;泄漏预算&quot;——哪些底层细节是允许泄漏的（如性能调优参数），哪些是绝对不允许泄漏的（如数据库方言差异）。完全无泄漏的抽象在实践中几乎不可能实现，关键是控制泄漏的范围和影响。</p>\n<h2 id=\"适配器模式与策略模式\">适配器模式与策略模式</h2><p>适配器模式和策略模式是实现抽象层的两种核心设计模式。</p>\n<p><strong>适配器模式</strong>解决接口不兼容问题——当现有组件的接口与系统期望的接口不一致时，通过适配器进行转换。在系统集成中，适配器模式用于将第三方库的 API 转换为系统内部的标准接口，避免第三方库的变化影响核心代码。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface PaymentGateway {&#10;  charge(amount: number, currency: string): Promise&lt;PaymentResult&gt;;&#10;  refund(transactionId: string): Promise&lt;RefundResult&gt;;&#10;}&#10;&#10;class StripeAdapter implements PaymentGateway {&#10;  constructor(private stripe: StripeClient) {}&#10;  async charge(amount: number, currency: string): Promise&lt;PaymentResult&gt; {&#10;    const result = await this.stripe.paymentIntents.create({ amount, currency });&#10;    return { transactionId: result.id, status: result.status === &#39;succeeded&#39; ? &#39;success&#39; : &#39;pending&#39; };&#10;  }&#10;  async refund(transactionId: string): Promise&lt;RefundResult&gt; {&#10;    const result = await this.stripe.refunds.create({ payment_intent: transactionId });&#10;    return { refundId: result.id, status: &#39;completed&#39; };&#10;  }&#10;}&#10;&#10;class AlipayAdapter implements PaymentGateway {&#10;  constructor(private alipay: AlipaySDK) {}&#10;  async charge(amount: number, currency: string): Promise&lt;PaymentResult&gt; {&#10;    /* ... */&#10;  }&#10;  async refund(transactionId: string): Promise&lt;RefundResult&gt; {&#10;    /* ... */&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PaymentGateway</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  charge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">currency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"c