83\"> :</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pending'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> refund</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">transactionId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">RefundResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.stripe.refunds.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ payment_intent: transactionId });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { refundId: result.id, status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'completed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AlipayAdapter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> implements</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PaymentGateway</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  constructor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> alipay</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AlipaySDK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> charge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">currency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">PaymentResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> refund</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">transactionId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">RefundResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /* ... */</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>策略模式</strong>将算法封装在独立的策略对象中，使得算法可以在运行时动态切换。在抽象层设计中，策略模式常用于提供同一接口的不同实现——如不同的缓存策略（LRU、LFU、TTL）、不同的序列化格式（JSON、Protobuf、MessagePack）或不同的日志输出目标（控制台、文件、远程服务）。</p>\n<p>两种模式的区别在于动机：适配器模式是&quot;让不兼容的接口协同工作&quot;，策略模式是&quot;让算法可以互换&quot;。在实际系统中，两者常常组合使用——适配器负责接口转换，策略负责实现选择。</p>\n<p><strong>外观模式</strong>（Facade）也是构建抽象层的常用模式。它为复杂的子系统提供一个简化的统一接口。与适配器的区别在于：适配器转换接口格式，外观简化接口复杂度。例如，一个&quot;订单创建外观&quot;可能内部协调库存检查、价格计算、优惠券验证、支付预授权等多个子系统，但对外只暴露一个 <code>createOrder()</code> 方法。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"class OrderFacade {&#10;  constructor(&#10;    private inventory: InventoryService,&#10;    private pricing: PricingService,&#10;    private coupon: CouponService,&#10;    private payment: PaymentService,&#10;  ) {}&#10;&#10;  async createOrder(items: CartItem[], couponCode?: string): Promise&lt;Order&gt; {&#10;    await this.inventory.reserveItems(items);&#10;    const price = await this.pricing.calculate(items);&#10;    const discount = couponCode ? await this.coupon.apply(couponCode, price) : 0;&#10;    const paymentAuth = await this.payment.preAuthorize(price - discount);&#10;    return { items, total: price - discount, paymentAuth };&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderFacade</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  constructor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> inventory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InventoryService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> pricing</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PricingService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> coupon</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CouponService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> payment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PaymentService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">items</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CartItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">couponCode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.inventory.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reserveItems</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(items);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> price</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.pricing.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">calculate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(items);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> discount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> couponCode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.coupon.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">apply</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(couponCode, price) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> paymentAuth</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.payment.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">preAuthorize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(price </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> discount);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { items, total: price </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> discount, paymentAuth };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"抽象层次的权衡\">抽象层次的权衡</h2><p>抽象不是免费的。每增加一层抽象，都增加了间接调用、认知负担和调试复杂度。过度抽象（Over-Abstraction）和抽象不足（Under-Abstraction）都会损害系统质量。</p>\n<p>过度抽象的症状包括：为了&quot;将来可能需要&quot;而提前创建接口，但实际上只有一个实现；通过多层委托调用才能到达实际执行代码，每一层只是简单地转发参数；命名过于抽象以至于无法从名字推断功能（如 <code>AbstractBaseProcessorFactory</code>）。</p>\n<p>抽象不足的症状包括：重复的代码散布在多处，每次修改都需要在多个位置同步；具体的技术细节（如 SQL 语句）出现在业务逻辑代码中；替换一个外部依赖需要修改大量文件。</p>\n<table>\n<thead>\n<tr>\n<th>抽象层数</th>\n<th>特征</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>0-1 层</td>\n<td>直接调用，无间接</td>\n<td>一次性脚本、原型验证</td>\n</tr>\n<tr>\n<td>2-3 层</td>\n<td>适度间接，清晰层次</td>\n<td>大多数应用程序</td>\n</tr>\n<tr>\n<td>4-5 层</td>\n<td>高度灵活，但认知成本高</td>\n<td>框架、平台、大型企业系统</td>\n</tr>\n<tr>\n<td>6+ 层</td>\n<td>过度间接，&quot;架构宇航员&quot;</td>\n<td>几乎没有合理场景</td>\n</tr>\n</tbody></table>\n<p>选择合适的抽象层次需要遵循 <strong>YAGNI</strong>（You Aren&#39;t Gonna Need It）原则：不要为假想的未来需求创建抽象层。当且仅当出现以下信号时才引入新的抽象层：存在需要统一的多个实现（如多个支付渠道）、需要隔离频繁变化的外部依赖（如第三方 API）、或测试需要模拟外部组件。</p>\n<p><strong>三次法则</strong>（Rule of Three）提供了更具操作性的指导：当你第一次遇到某种需求时直接实现，第二次遇到类似需求时注意但仍然直接实现，第三次遇到时才提取抽象。这避免了基于猜测的过早抽象，确保抽象是从真实需求中提炼出来的。</p>\n<p>抽象层的命名应该反映其屏蔽的职责而非实现技术。<code>UserRepository</code> 比 <code>UserDatabaseAccessor</code> 更好——前者不假设底层一定是数据库（可能是 API、缓存或内存），后者则泄露了实现细节。好的命名让开发者仅凭接口名称就能理解其职责，无需查看实现。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((抽象层设计))&#10;    分层架构&#10;      三层架构&#10;      六边形架构&#10;      层次隔离&#10;    抽象泄漏&#10;      N+1 查询&#10;      网络异常穿透&#10;      防腐层防范&#10;      优雅降级&#10;    设计模式&#10;      适配器模式&#10;      策略模式&#10;      组合使用&#10;    层次权衡&#10;      过度抽象&#10;      抽象不足&#10;      YAGNI 原则&#10;      2-3 层最优\">mindmap\n  root((抽象层设计))\n    分层架构\n      三层架构\n      六边形架构\n      层次隔离\n    抽象泄漏\n      N+1 查询\n      网络异常穿透\n      防腐层防范\n      优雅降级\n    设计模式\n      适配器模式\n      策略模式\n      组合使用\n    层次权衡\n      过度抽象\n      抽象不足\n      YAGNI 原则\n      2-3 层最优</pre><ul>\n<li>抽象层通过隐藏底层细节降低上层的认知负担，是管理复杂度的核心手段</li>\n<li>分层架构限制变更传播范围，六边形架构将技术细节推到边缘提高可测试性</li>\n<li>抽象泄漏不可完全避免，关键是通过防腐层和故障屏障控制泄漏范围</li>\n<li>适配器模式解决接口不兼容，策略模式实现算法可互换，两者常组合使用</li>\n<li>遵循 YAGNI 原则，只在有明确需求时引入新的抽象层，避免过度设计</li>\n<li>大多数应用程序 2-3 层抽象是最优平衡点，超过 5 层应审慎评估必要性</li>\n<li>三次法则提供操作性指导：第三次遇到相似需求时才提取抽象，避免过早泛化</li>\n</ul>\n","headings":[{"level":1,"text":"抽象层设计","id":"抽象层设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"分层架构的设计模式","id":"分层架构的设计模式"},{"level":2,"text":"抽象泄漏的识别与防范","id":"抽象泄漏的识别与防范"},{"level":2,"text":"适配器模式与策略模式","id":"适配器模式与策略模式"},{"level":2,"text":"抽象层次的权衡","id":"抽象层次的权衡"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"模块化与耦合度控制","url":"/l-doc-books/h/cs-fundamentals/software-engineering-fundamentals/design-principles/modularity-and-coupling"},"next":{"title":"设计文档化","url":"/l-doc-books/h/cs-fundamentals/software-engineering-fundamentals/design-principles/design-documentation"}}