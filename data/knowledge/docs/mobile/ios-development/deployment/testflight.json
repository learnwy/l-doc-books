:#E1E4E8\">$ARCHIVE_PATH</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -destination</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"generic/platform=iOS\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CODE_SIGN_STYLE=Manual</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"=== Export IPA ===\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xcodebuild</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -exportArchive</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -archivePath</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$ARCHIVE_PATH</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -exportPath</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$IPA_DIR</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -exportOptionsPlist</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ExportOptions.plist</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"=== Upload to TestFlight ===\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">xcrun</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> altool</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --upload-app</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$IPA_DIR</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$APP_SCHEME</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.ipa\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -t</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ios</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -u</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$APPLE_ID</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  -p</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$APP_SPECIFIC_PASSWORD</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"=== Done ✅ ===\"</span></span></code></pre></div><h2 id=\"常见问题\">常见问题</h2><h3 id=\"问题一-上传后构建长时间处于-processing-状态\">问题一：上传后构建长时间处于 &quot;Processing&quot; 状态</h3><p><strong>原因</strong>：Apple 服务端处理需要时间，通常 5-30 分钟，高峰期可能更久。</p>\n<p><strong>解决</strong>：</p>\n<ol>\n<li>耐心等待，避免重复上传同一构建号</li>\n<li>检查 App Store Connect 的邮箱通知，处理完成后会收到邮件</li>\n<li>如果超过 1 小时仍未完成，尝试递增构建号后重新上传</li>\n</ol>\n<h3 id=\"问题二-外部测试提交后-beta-review-被拒\">问题二：外部测试提交后 Beta Review 被拒</h3><p><strong>原因</strong>：Beta Review 也会检查基本的 App Store Guidelines 合规性。</p>\n<p><strong>解决</strong>：</p>\n<ol>\n<li>确保 App 不会崩溃、基本功能完整</li>\n<li>填写完整的 &quot;What to Test&quot; 说明</li>\n<li>如果使用了登录功能，提供测试账号</li>\n</ol>\n<h3 id=\"问题三-构建号冲突-has-already-been-uploaded\">问题三：构建号冲突 &quot;has already been uploaded&quot;</h3><p><strong>原因</strong>：同一个版本号 + 构建号的组合只能上传一次。</p>\n<p><strong>解决</strong>：每次上传前递增 <code>CFBundleVersion</code>，推荐使用时间戳或 CI 构建序号。</p>\n<h3 id=\"问题四-测试人员未收到安装通知\">问题四：测试人员未收到安装通知</h3><p><strong>原因</strong>：测试人员的 Apple ID 邮箱可能有误，或未安装 TestFlight App。</p>\n<p><strong>解决</strong>：</p>\n<ol>\n<li>确认测试人员邮箱正确</li>\n<li>确认测试人员已在设备上安装 TestFlight App 并接受邀请</li>\n<li>对于外部测试，检查构建是否已通过 Beta Review</li>\n</ol>\n<h3 id=\"问题五-构建-90-天过期\">问题五：构建 90 天过期</h3><p><strong>原因</strong>：TestFlight 构建有效期为 90 天，到期后无法安装。</p>\n<p><strong>解决</strong>：定期上传新构建，确保测试人员始终有可用版本。在 CI 中配置定时构建。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>内部测试</strong>最多 100 人，上传即可用，无需审核；<strong>外部测试</strong>最多 10,000 人，首次需 Beta Review。</li>\n<li>使用 <code>xcodebuild archive</code> + <code>xcodebuild -exportArchive</code> 组合完成命令行构建和导出。</li>\n<li><code>xcrun altool</code> 或 <strong>Transporter</strong> 用于上传 IPA 到 App Store Connect。</li>\n<li><strong>fastlane pilot</strong> 实现从构建到分发的全自动化，支持测试组管理和测试人员增删。</li>\n<li>每次上传必须递增 <code>CFBundleVersion</code>（构建号），推荐使用时间戳或 CI 序号。</li>\n<li>TestFlight 构建有效期 <strong>90 天</strong>，需定期更新。</li>\n<li>外部测试支持<strong>公开链接</strong>邀请，无需逐一添加测试人员邮箱。</li>\n<li>在 CI 环境中使用 App Specific Password 或 API Key 进行身份认证。</li>\n</ul>\n","headings":[{"level":1,"text":"TestFlight 内测分发","id":"testflight-内测分发"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心工具","id":"核心工具"},{"level":2,"text":"工作流程","id":"工作流程"},{"level":3,"text":"步骤一：构建 Archive","id":"步骤一-构建-archive"},{"level":3,"text":"步骤二：导出 IPA","id":"步骤二-导出-ipa"},{"level":3,"text":"步骤三：上传构建","id":"步骤三-上传构建"},{"level":3,"text":"步骤四：配置测试组","id":"步骤四-配置测试组"},{"level":3,"text":"版本管理","id":"版本管理"},{"level":3,"text":"fastlane pilot 自动化","id":"fastlane-pilot-自动化"},{"level":2,"text":"实战演示","id":"实战演示"},{"level":2,"text":"常见问题","id":"常见问题"},{"level":3,"text":"问题一：上传后构建长时间处于 \"Processing\" 状态","id":"问题一-上传后构建长时间处于-processing-状态"},{"level":3,"text":"问题二：外部测试提交后 Beta Review 被拒","id":"问题二-外部测试提交后-beta-review-被拒"},{"level":3,"text":"问题三：构建号冲突 \"has already been uploaded\"","id":"问题三-构建号冲突-has-already-been-uploaded"},{"level":3,"text":"问题四：测试人员未收到安装通知","id":"问题四-测试人员未收到安装通知"},{"level":3,"text":"问题五：构建 90 天过期","id":"问题五-构建-90-天过期"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"代码签名与描述文件","url":"/l-doc-books/h/mobile/ios-development/deployment/code-signing"},"next":{"title":"App Review 审核指南","url":"/l-doc-books/h/mobile/ios-development/deployment/app-review"}}