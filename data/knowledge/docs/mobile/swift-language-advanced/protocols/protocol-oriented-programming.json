n><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user: User </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> network.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: url)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> storage.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">save</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">forKey</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"user_</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\\(id)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    US[&quot;UserService&quot;] --&gt; NC[&quot;NetworkClient 协议&quot;]&#10;    US --&gt; SC[&quot;StorageClient 协议&quot;]&#10;    NC --&gt; RC[&quot;真实网络客户端&quot;]&#10;    NC --&gt; MC[&quot;Mock 网络客户端&quot;]&#10;    SC --&gt; FS[&quot;文件存储&quot;]&#10;    SC --&gt; MS[&quot;内存存储 Mock&quot;]\">flowchart LR\n    US[\"UserService\"] --&gt; NC[\"NetworkClient 协议\"]\n    US --&gt; SC[\"StorageClient 协议\"]\n    NC --&gt; RC[\"真实网络客户端\"]\n    NC --&gt; MC[\"Mock 网络客户端\"]\n    SC --&gt; FS[\"文件存储\"]\n    SC --&gt; MS[\"内存存储 Mock\"]</pre><hr>\n<h2 id=\"何时选择协议-vs-类\">何时选择协议 vs 类</h2><p>虽然 POP 是 Swift 的推荐范式，但类继承在某些场景仍有价值：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// 适合类继承：需要引用语义和身份标识&#10;class ViewController: UIViewController {&#10;    override func viewDidLoad() { }&#10;}&#10;&#10;// 适合协议：定义行为契约&#10;protocol DataSource {&#10;    func numberOfItems() -&gt; Int&#10;    func item(at index: Int) -&gt; Any&#10;}&#10;&#10;// 适合协议 + 值类型：无共享状态&#10;struct Point: Equatable, Hashable, Codable {&#10;    var x: Double&#10;    var y: Double&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 适合类继承：需要引用语义和身份标识</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ViewController</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">UIViewController </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    override</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> viewDidLoad</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 适合协议：定义行为契约</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DataSource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> numberOfItems</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Int</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">at</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> index: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Any</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 适合协议 + 值类型：无共享状态</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Point</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Equatable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Hashable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Codable </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Double</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> y: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Double</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>面向协议编程</strong>用协议组合替代类继承，是 Swift 的核心范式</li>\n<li>协议组合通过 <code>&amp;</code> 运算符灵活组合多个能力，遵循&quot;小协议、大组合&quot;原则</li>\n<li><strong>追溯遵循</strong>允许对已有类型扩展协议遵循，无需修改源码</li>\n<li>POP 常见模式包括<strong>能力组合</strong>和<strong>依赖抽象</strong>，提高代码的可测试性和解耦性</li>\n<li>类继承在需要引用语义、身份标识和框架互操作（如 UIKit）时仍有价值</li>\n<li>值类型 + 协议是 Swift 推荐的默认选择，兼具安全性和性能</li>\n</ul>\n","headings":[{"level":1,"text":"面向协议编程","id":"面向协议编程"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"协议 vs 类继承","id":"协议-vs-类继承"},{"level":2,"text":"协议组合","id":"协议组合"},{"level":2,"text":"追溯遵循（Retroactive Conformance）","id":"追溯遵循-retroactive-conformance"},{"level":2,"text":"POP 设计模式","id":"pop-设计模式"},{"level":3,"text":"能力组合模式","id":"能力组合模式"},{"level":3,"text":"依赖抽象模式","id":"依赖抽象模式"},{"level":2,"text":"何时选择协议 vs 类","id":"何时选择协议-vs-类"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Result Builders 结果构建器","url":"/l-doc-books/h/mobile/swift-language-advanced/type-system/result-builders"},"next":{"title":"协议扩展","url":"/l-doc-books/h/mobile/swift-language-advanced/protocols/protocol-extensions"}}