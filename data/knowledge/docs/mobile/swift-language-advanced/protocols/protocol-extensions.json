1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"避免协议扩展的过度使用\">避免协议扩展的过度使用</h3><div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// ❌ 不好：大量无关方法堆在一个协议扩展中&#10;extension MyProtocol {&#10;    func methodA() { }&#10;    func methodB() { }&#10;    func methodC() { }&#10;    func methodD() { }&#10;}&#10;&#10;// ✅ 好：按功能拆分为多个协议&#10;protocol Readable { func read() -&gt; Data }&#10;protocol Writable { func write(_ data: Data) }&#10;protocol Deletable { func delete() }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ❌ 不好：大量无关方法堆在一个协议扩展中</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">extension</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MyProtocol</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> methodA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> methodB</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> methodC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> methodD</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ 好：按功能拆分为多个协议</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Readable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> read</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Data }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Writable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> write</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data: Data) }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Deletable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>协议扩展</strong>为协议方法提供默认实现，是 POP 的基石</li>\n<li><strong>动态分派</strong>应用于协议要求中声明的方法；<strong>静态分派</strong>应用于仅在扩展中添加的方法</li>\n<li>利用分派机制可设计<strong>定制点模式</strong>，让遵循类型只覆盖需要定制的部分</li>\n<li><strong>条件扩展</strong>通过 <code>where</code> 子句为特定类型提供额外功能</li>\n<li>协议扩展不能添加存储属性，但可通过计算属性提供派生值</li>\n<li>避免在协议扩展中堆积大量无关方法，应按功能拆分为多个小协议</li>\n</ul>\n","headings":[{"level":1,"text":"协议扩展","id":"协议扩展"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"默认实现","id":"默认实现"},{"level":2,"text":"静态分派 vs 动态分派","id":"静态分派-vs-动态分派"},{"level":2,"text":"定制点（Customization Points）","id":"定制点-customization-points"},{"level":2,"text":"条件扩展","id":"条件扩展"},{"level":2,"text":"协议扩展 vs 基类默认实现","id":"协议扩展-vs-基类默认实现"},{"level":2,"text":"常见陷阱","id":"常见陷阱"},{"level":3,"text":"协议扩展中的存储","id":"协议扩展中的存储"},{"level":3,"text":"避免协议扩展的过度使用","id":"避免协议扩展的过度使用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"面向协议编程","url":"/l-doc-books/h/mobile/swift-language-advanced/protocols/protocol-oriented-programming"},"next":{"title":"条件遵循","url":"/l-doc-books/h/mobile/swift-language-advanced/protocols/conditional-conformance"}}