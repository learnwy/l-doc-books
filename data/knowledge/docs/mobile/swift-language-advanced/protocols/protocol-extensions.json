with separator: String = &quot;, &quot;) -&gt; String {&#10;        map(String.init).joined(separator: separator)&#10;    }&#10;}&#10;&#10;let numbers = [1, 2, 3, 4, 5]&#10;print(numbers.total()) // 15&#10;&#10;let words = [&quot;Swift&quot;, &quot;is&quot;, &quot;great&quot;]&#10;print(words.joined(with: &quot; &quot;)) // Swift is great\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">extension</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Collection</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> where</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Element</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Numeric</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> total</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line