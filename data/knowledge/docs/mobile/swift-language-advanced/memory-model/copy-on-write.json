le=\"color:#6F42C1;--shiki-dark:#B392F0\"> append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> element: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        makeUniqueIfNeeded</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        storage.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">buffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(element)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    MUT[&quot;mutating 操作&quot;] --&gt; CHK{&quot;isKnownUniquelyReferenced?&quot;}&#10;    CHK --&gt;|true 唯一引用| DIR[&quot;直接修改存储&quot;]&#10;    CHK --&gt;|false 共享引用| COPY[&quot;复制存储&quot;]&#10;    COPY --&gt; MOD[&quot;修改新存储&quot;]\">flowchart TD\n    MUT[\"mutating 操作\"] --&gt; CHK{\"isKnownUniquelyReferenced?\"}\n    CHK --&gt;|true 唯一引用| DIR[\"直接修改存储\"]\n    CHK --&gt;|false 共享引用| COPY[\"复制存储\"]\n    COPY --&gt; MOD[\"修改新存储\"]</pre><hr>\n<h2 id=\"cow-的性能特征\">COW 的性能特征</h2><div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// O(1) 操作：赋值（只增加引用计数）&#10;var bigArray = Array(0..&lt;1_000_000)&#10;var copy = bigArray  // O(1)&#10;&#10;// O(n) 操作：首次修改（触发完整复制）&#10;copy[0] = -1  // O(n) — 复制 100 万个元素&#10;&#10;// O(1) 操作：后续修改（已经是唯一引用）&#10;copy[1] = -2  // O(1)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// O(1) 操作：赋值（只增加引用计数）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bigArray </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">..&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1_000_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> copy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> bigArray  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// O(1)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// O(n) 操作：首次修改（触发完整复制）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">copy[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -1</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // O(n) — 复制 100 万个元素</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// O(1) 操作：后续修改（已经是唯一引用）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">copy[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -2</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // O(1)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>操作</th>\n<th>唯一引用</th>\n<th>共享引用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>读取</td>\n<td>O(1)</td>\n<td>O(1)</td>\n</tr>\n<tr>\n<td>赋值</td>\n<td>O(1)</td>\n<td>O(1)（只增加引用计数）</td>\n</tr>\n<tr>\n<td>首次写入</td>\n<td>O(1)</td>\n<td>O(n)（触发复制）</td>\n</tr>\n<tr>\n<td>后续写入</td>\n<td>O(1)</td>\n<td>O(1)（已复制）</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 在循环中频繁复制后修改会导致反复触发 COW 复制。如果需要频繁独立修改，考虑在循环外先完成复制。</p>\n</blockquote>\n<hr>\n<h2 id=\"陷阱-意外的共享引用\">陷阱：意外的共享引用</h2><div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func appendToArray(_ array: [Int]) -&gt; [Int] {&#10;    var result = array  // 引用计数 +1&#10;    result.append(42)   // 触发 COW 复制 ⚠️&#10;    return result&#10;}&#10;&#10;// 更好的方式：使用 inout 避免 COW&#10;func appendInPlace(_ array: inout [Int]) {&#10;    array.append(42)  // 如果外部只有一个引用，不触发复制&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> appendToArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> array: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> array  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 引用计数 +1</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    result.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 触发 COW 复制 ⚠️</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 更好的方式：使用 inout 避免 COW</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> appendInPlace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> array: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">inout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    array.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 如果外部只有一个引用，不触发复制</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>COW</strong> 在赋值时共享存储（O(1)），仅在修改时才复制（O(n)），兼顾值语义和性能</li>\n<li><strong><code>isKnownUniquelyReferenced</code></strong> 是实现 COW 的核心 API，检查引用是否唯一</li>\n<li>Swift 标准库的 <code>Array</code>、<code>Dictionary</code>、<code>Set</code>、<code>String</code> 全部使用 COW</li>\n<li>自定义 COW 需要一个引用类型的内部存储（<code>class</code>），在 mutating 方法中检查唯一性</li>\n<li>首次写入共享存储时触发 O(n) 复制，后续写入为 O(1)</li>\n<li>使用 <code>inout</code> 传参可以避免函数调用中的意外 COW 复制</li>\n</ul>\n","headings":[{"level":1,"text":"写时复制","id":"写时复制"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"值语义与引用语义","id":"值语义与引用语义"},{"level":2,"text":"isKnownUniquelyReferenced","id":"isknownuniquelyreferenced"},{"level":2,"text":"标准库 COW 类型","id":"标准库-cow-类型"},{"level":2,"text":"完整的自定义 COW 实现","id":"完整的自定义-cow-实现"},{"level":2,"text":"COW 的性能特征","id":"cow-的性能特征"},{"level":2,"text":"陷阱：意外的共享引用","id":"陷阱-意外的共享引用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"所有权与借用","url":"/l-doc-books/h/mobile/swift-language-advanced/memory-model/ownership-and-borrowing"},"next":{"title":"不安全指针","url":"/l-doc-books/h/mobile/swift-language-advanced/memory-model/unsafe-pointers"}}