span></span></code></pre></div><hr>\n<h2 id=\"不可复制类型的方法\">不可复制类型的方法</h2><p>不可复制类型的方法需要注意所有权：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"struct Connection: ~Copyable {&#10;    private var isOpen: Bool&#10;&#10;    init() { isOpen = true }&#10;&#10;    borrowing func query(_ sql: String) -&gt; [Row] {&#10;        guard isOpen else { return [] }&#10;        return executeQuery(sql)&#10;    }&#10;&#10;    mutating func reconnect() {&#10;        isOpen = true&#10;    }&#10;&#10;    consuming func close() {&#10;        isOpen = false&#10;        print(&quot;Connection closed&quot;)&#10;    }&#10;}&#10;&#10;func useConnection() {&#10;    var conn = Connection()&#10;    let rows = conn.query(&quot;SELECT * FROM users&quot;) // borrowing&#10;    conn.reconnect()                               // mutating&#10;    conn.close()                                   // consuming：conn 不再可用&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Connection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">~</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Copyable </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> isOpen: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Bool</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { isOpen </span><span style=\"color:#D73