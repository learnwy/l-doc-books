iki-dark:#E1E4E8\"> connection.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ROLLBACK\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    deinit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        try?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> connection.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ROLLBACK\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 不可复制类型目前（Swift 5.9+）仍在快速演进中。泛型中使用 <code>~Copyable</code> 的支持在 Swift 6 中进一步完善。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong><code>borrowing</code></strong> 参数只读借用值，不产生拷贝；<strong><code>consuming</code></strong> 参数转移所有权</li>\n<li><strong><code>~Copyable</code></strong> 标记不可复制类型，确保值的唯一所有权</li>\n<li><strong><code>consume</code></strong> 操作符显式转移所有权，转移后原变量不可再使用</li>\n<li>不可复制类型的方法可以标记为 <code>borrowing</code>、<code>mutating</code> 或 <code>consuming</code></li>\n<li>不可复制类型适合建模<strong>唯一资源</strong>（文件句柄、网络连接、事务）和 <strong>RAII 模式</strong></li>\n<li>所有权特性让 Swift 能更精细地控制值的生命周期，减少不必要的拷贝</li>\n</ul>\n","headings":[{"level":1,"text":"所有权与借用","id":"所有权与借用"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"consuming 与 borrowing","id":"consuming-与-borrowing"},{"level":2,"text":"~Copyable：不可复制类型","id":"copyable-不可复制类型"},{"level":2,"text":"consume 操作符","id":"consume-操作符"},{"level":2,"text":"不可复制类型的方法","id":"不可复制类型的方法"},{"level":2,"text":"实际应用场景","id":"实际应用场景"},{"level":3,"text":"RAII 模式","id":"raii-模式"},{"level":3,"text":"唯一资源令牌","id":"唯一资源令牌"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ARC 内部机制","url":"/l-doc-books/h/mobile/swift-language-advanced/memory-model/arc-internals"},"next":{"title":"写时复制","url":"/l-doc-books/h/mobile/swift-language-advanced/memory-model/copy-on-write"}}