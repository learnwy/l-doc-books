ot;]&#10;        QR[&quot;queryHelper()&quot;]&#10;    end&#10;    subgraph &quot;@MainActor 隔离域&quot;&#10;        VM[&quot;ViewModel&quot;]&#10;        VC[&quot;ViewController&quot;]&#10;    end&#10;    DM --&gt; |await| VM\">flowchart LR\n    subgraph \"@DatabaseActor 隔离域\"\n        DM[\"DatabaseManager\"]\n        MG[\"migrateDatabase()\"]\n        QR[\"queryHelper()\"]\n    end\n    subgraph \"@MainActor 隔离域\"\n        VM[\"ViewModel\"]\n        VC[\"ViewController\"]\n    end\n    DM --&gt; |await| VM</pre><hr>\n<h2 id=\"nonisolated\">nonisolated</h2><p>使用 <code>nonisolated</code> 关键字可以让 actor 中的方法脱离隔离，允许同步访问：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"actor UserCache {&#10;    let maxSize: Int&#10;    private var cache: [String: User] = [:]&#10;&#10;    init(maxSize: Int) {&#10;        self.maxSize = maxSize&#10;    }&#10;&#10;    nonisolated var description: String {&#10;        &quot;UserCache(maxSize: \\(maxSize))&quot;&#10;    }&#10;&#10;    nonisolated func cacheKeyFor(id: String) -&gt; String {&#10;        &quot;user_\\(id)&quot;&#10;    }&#10;&#10;    func store(_ user: User) {&#10;        let key = cacheKeyFor(id: user.id)&#10;        cache[key] = user&#10;        if cache.count &gt; maxSize {&#10;            evictOldest()&#10;        }&#10;    }&#10;}&#10;&#10;let cache = UserCache(maxSize: 100)&#10;print(cache.description) // 不需要 await&#10;print(cache.maxSize)     // let 属性自动 nonisolated\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">actor</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserCache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxSize: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: User] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">maxSize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.maxSize </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxSize</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    nonisolated</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> description: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"UserCache(maxSize: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\\(maxSize)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    nonisolated</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cacheKeyFor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"user_</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\\(id)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> store</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user: User) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> key </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cacheKeyFor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: user.id)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        cache[key] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxSize {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            evictOldest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UserCache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">maxSize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(cache.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">description</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 不需要 await</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(cache.maxSize)     </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// let 属性自动 nonisolated</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>访问修饰</th>\n<th>需要 await</th>\n<th>可访问</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>隔离方法/属性</td>\n<td>是</td>\n<td>可变状态</td>\n</tr>\n<tr>\n<td><code>nonisolated</code> 方法</td>\n<td>否</td>\n<td>仅不可变状态（let）</td>\n</tr>\n<tr>\n<td><code>let</code> 属性</td>\n<td>否</td>\n<td>自动 nonisolated</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"重入性-reentrancy\">重入性（Reentrancy）</h2><p>Actor 方法是<strong>可重入</strong>的——当方法在 <code>await</code> 处挂起时，其他任务可以进入该 actor 执行：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"actor ImageLoader {&#10;    private var cache: [URL: UIImage] = [:]&#10;&#10;    func loadImage(from url: URL) async throws -&gt; UIImage {&#10;        if let cached = cache[url] {&#10;            return cached&#10;        }&#10;&#10;        // ⚠️ 挂起点：此时其他任务可进入 actor&#10;        let (data, _) = try await URLSession.shared.data(from: url)&#10;        let image = UIImage(data: data)!&#10;&#10;        // 需要重新检查：挂起期间状态可能已变&#10;        cache[url] = cache[url] ?? image&#10;        return cache[url]!&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">actor</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ImageLoader</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache: [URL: UIImage] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> loadImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> url: URL) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UIImage {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cached </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache[url] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cached</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        // ⚠️ 挂起点：此时其他任务可进入 actor</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (data, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> URLSession.shared.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: url)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> image </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UIImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: data)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        // 需要重新检查：挂起期间状态可能已变</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        cache[url] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache[url] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> image</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cache[url]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 在每个 <code>await</code> 之后，actor 的状态可能已被其他任务修改。永远不要假设 <code>await</code> 前后状态一致——这是 actor 编程最重要的原则。</p>\n</blockquote>\n<pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant T1 as Task 1&#10;    participant T2 as Task 2&#10;    participant A as ImageLoader&#10;    T1-&gt;&gt;A: loadImage(urlA)&#10;    Note over A: 缓存未命中&#10;    A-&gt;&gt;A: await URLSession(挂起)&#10;    T2-&gt;&gt;A: loadImage(urlA)&#10;    Note over A: 缓存未命中&#10;    A-&gt;&gt;A: await URLSession(挂起)&#10;    Note over A: T1 恢复,写入缓存&#10;    Note over A: T2 恢复,检查缓存\">sequenceDiagram\n    participant T1 as Task 1\n    participant T2 as Task 2\n    participant A as ImageLoader\n    T1-&gt;&gt;A: loadImage(urlA)\n    Note over A: 缓存未命中\n    A-&gt;&gt;A: await URLSession(挂起)\n    T2-&gt;&gt;A: loadImage(urlA)\n    Note over A: 缓存未命中\n    A-&gt;&gt;A: await URLSession(挂起)\n    Note over A: T1 恢复,写入缓存\n    Note over A: T2 恢复,检查缓存</pre><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>Actor</strong> 通过隔离机制保护可变状态，同一时间只允许一个任务访问</li>\n<li>跨隔离边界访问 actor 成员必须使用 <code>await</code>，编译器在编译时检查</li>\n<li><strong><code>@MainActor</code></strong> 确保代码在主线程执行，是 UI 更新的标准方式</li>\n<li><strong>全局 Actor</strong> 可以将分散的代码统一到同一隔离域</li>\n<li><strong><code>nonisolated</code></strong> 让方法脱离隔离，仅可访问不可变状态</li>\n<li>Actor 方法是<strong>可重入</strong>的，<code>await</code> 前后状态可能变化，需要重新验证</li>\n</ul>\n","headings":[{"level":1,"text":"Actors 行为体","id":"actors-行为体"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Actor 基础","id":"actor-基础"},{"level":2,"text":"Actor 隔离机制","id":"actor-隔离机制"},{"level":2,"text":"MainActor","id":"mainactor"},{"level":2,"text":"全局 Actor","id":"全局-actor"},{"level":2,"text":"nonisolated","id":"nonisolated"},{"level":2,"text":"重入性（Reentrancy）","id":"重入性-reentrancy"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"结构化并发","url":"/l-doc-books/h/mobile/swift-language-advanced/concurrency/structured-concurrency"},"next":{"title":"Sendable 与隔离","url":"/l-doc-books/h/mobile/swift-language-advanced/concurrency/sendable-and-isolation"}}