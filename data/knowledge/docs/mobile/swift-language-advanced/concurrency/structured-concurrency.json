292E;--shiki-dark:#E1E4E8\"> image</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> images.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">compactMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    TG[&quot;TaskGroup&quot;] --&gt; ADD1[&quot;addTask: URL 1&quot;]&#10;    TG --&gt; ADD2[&quot;addTask: URL 2&quot;]&#10;    TG --&gt; ADD3[&quot;addTask: URL N&quot;]&#10;    ADD1 --&gt; COLLECT[&quot;for try await in group&quot;]&#10;    ADD2 --&gt; COLLECT&#10;    ADD3 --&gt; COLLECT&#10;    COLLECT --&gt; RESULT[&quot;组合结果&quot;]\">flowchart TD\n    TG[\"TaskGroup\"] --&gt; ADD1[\"addTask: URL 1\"]\n    TG --&gt; ADD2[\"addTask: URL 2\"]\n    TG --&gt; ADD3[\"addTask: URL N\"]\n    ADD1 --&gt; COLLECT[\"for try await in group\"]\n    ADD2 --&gt; COLLECT\n    ADD3 --&gt; COLLECT\n    COLLECT --&gt; RESULT[\"组合结果\"]</pre><table>\n<thead>\n<tr>\n<th>特性</th>\n<th><code>async let</code></th>\n<th><code>TaskGroup</code></th>\n</tr>\n</thead>\n<tbody><tr>\n<td>子任务数量</td>\n<td>编译时确定</td>\n<td>运行时动态</td>\n</tr>\n<tr>\n<td>结果类型</td>\n<td>可以不同</td>\n<td>必须统一</td>\n</tr>\n<tr>\n<td>语法</td>\n<td>简洁</td>\n<td>灵活</td>\n</tr>\n<tr>\n<td>取消处理</td>\n<td>自动</td>\n<td>自动 + 手动</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"任务取消\">任务取消</h2><p>结构化并发的取消是<strong>协作式</strong>的——系统设置取消标志，任务需要主动检查：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func processLargeDataset(_ items: [Item]) async throws -&gt; [Result] {&#10;    try await withThrowingTaskGroup(of: Result.self) { group in&#10;        for item in items {&#10;            try Task.checkCancellation()&#10;&#10;            group.addTask {&#10;                try await process(item)&#10;            }&#10;        }&#10;&#10;        var results: [Result] = []&#10;        for try await result in group {&#10;            results.append(result)&#10;        }&#10;        return results&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processLargeDataset</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items: [Item]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [Result] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> withThrowingTaskGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: Result.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { group </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#