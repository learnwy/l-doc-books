;--shiki-dark:#F97583\">        await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> loadVisibleContent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    group.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">priority</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .utility) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> prefetchNextPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>优先级</th>\n<th>值</th>\n<th>典型场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>.high</code></td>\n<td>25</td>\n<td>用户正在等待的操作</td>\n</tr>\n<tr>\n<td><code>.userInitiated</code></td>\n<td>25</td>\n<td>用户触发的操作</td>\n</tr>\n<tr>\n<td><code>.medium</code></td>\n<td>21</td>\n<td>默认优先级</td>\n</tr>\n<tr>\n<td><code>.low</code></td>\n<td>17</td>\n<td>用户不直接等待的操作</td>\n</tr>\n<tr>\n<td><code>.utility</code></td>\n<td>17</td>\n<td>长时间运行的后台计算</td>\n</tr>\n<tr>\n<td><code>.background</code></td>\n<td>9</td>\n<td>维护、同步等不紧急任务</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> Swift 支持<strong>优先级提升（Priority Escalation）</strong>——如果高优先级任务等待低优先级任务的结果，低优先级任务会被临时提升优先级。</p>\n</blockquote>\n<hr>\n<h2 id=\"作用域绑定任务\">作用域绑定任务</h2><p>结构化并发的核心保证是<strong>作用域绑定</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func scopeExample() async throws {&#10;    try await withThrowingTaskGroup(of: Void.self) { group in&#10;        group.addTask { await task1() }&#10;        group.addTask { await task2() }&#10;        group.addTask { await task3() }&#10;    }&#10;    // 执行到这里时，所有子任务已完成或已取消&#10;    print(&quot;All tasks finished&quot;)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> scopeExample</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> withThrowingTaskGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { group </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        group.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> task1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        group.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> task2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        group.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> task3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 执行到这里时，所有子任务已完成或已取消</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"All tasks finished\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>如果任何子任务抛出错误：</p>\n<ol>\n<li>错误传播到 TaskGroup</li>\n<li>其余子任务被自动取消</li>\n<li>等待所有子任务完成（取消或正常完成）</li>\n<li>错误传播到调用方</li>\n</ol>\n<hr>\n<h2 id=\"限制并发度\">限制并发度</h2><p><code>TaskGroup</code> 默认不限制并发子任务数量。可以手动限制：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func processWithLimit(&#10;    items: [Item],&#10;    maxConcurrency: Int = 4&#10;) async throws -&gt; [ProcessedItem] {&#10;    try await withThrowingTaskGroup(of: ProcessedItem.self) { group in&#10;        var results: [ProcessedItem] = []&#10;        var iterator = items.makeIterator()&#10;&#10;        for _ in 0..&lt;min(maxConcurrency, items.count) {&#10;            if let item = iterator.next() {&#10;                group.addTask { try await process(item) }&#10;            }&#10;        }&#10;&#10;        for try await result in group {&#10;            results.append(result)&#10;            if let item = iterator.next() {&#10;                group.addTask { try await process(item) }&#10;            }&#10;        }&#10;&#10;        return results&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processWithLimit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    items</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [Item],</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    maxConcurrency</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [ProcessedItem] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> withThrowingTaskGroup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: ProcessedItem.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { group </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results: [ProcessedItem] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> iterator </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">makeIterator</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> _</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">..&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(maxConcurrency, items.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> item </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> iterator.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                group.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item) }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> group {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            results.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> item </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> iterator.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                group.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item) }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>结构化并发</strong>确保子任务的生命周期受父作用域约束，自动处理取消和清理</li>\n<li><strong><code>async let</code></strong> 用于编译时已知数量的并发任务，语法简洁</li>\n<li><strong><code>TaskGroup</code></strong> 用于动态数量的并发任务，结果类型必须统一</li>\n<li>取消是<strong>协作式</strong>的，任务需要主动调用 <code>checkCancellation()</code> 或检查 <code>isCancelled</code></li>\n<li>任务优先级影响调度顺序，支持自动优先级提升</li>\n<li>可以通过手动控制 <code>addTask</code> 时机来限制并发度</li>\n</ul>\n","headings":[{"level":1,"text":"结构化并发","id":"结构化并发"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"async let：静态并发","id":"async-let-静态并发"},{"level":2,"text":"TaskGroup：动态并发","id":"taskgroup-动态并发"},{"level":2,"text":"任务取消","id":"任务取消"},{"level":2,"text":"任务优先级","id":"任务优先级"},{"level":2,"text":"作用域绑定任务","id":"作用域绑定任务"},{"level":2,"text":"限制并发度","id":"限制并发度"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"async/await 异步等待","url":"/l-doc-books/h/mobile/swift-language-advanced/concurrency/async-await"},"next":{"title":"Actors 行为体","url":"/l-doc-books/h/mobile/swift-language-advanced/concurrency/actors"}}