2F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> key: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        lock.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">lock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { lock.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> storage[key]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> key: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">value</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Value</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        lock.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">lock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { lock.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        storage[key] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> <code>@unchecked Sendable</code> 绕过了编译器的安全检查。使用时必须确保类型真的是线程安全的，否则会引入数据竞争。</p>\n</blockquote>\n<hr>\n<h2 id=\"基于区域的隔离-region-based-isolation\">基于区域的隔离（Region-based Isolation）</h2><p>Swift 5.10 和 Swift 6 引入了基于区域的隔离分析，能更精确地判断值是否可以安全传递：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func createAndSend() async {&#10;    let config = NonSendableConfig()&#10;    config.setup()&#10;&#10;    // Swift 6：编译器分析 config 在发送后不再被访问&#10;    // 即使 NonSendableConfig 不是 Sendable，也可以安全传递&#10;    await actor.use(config)&#10;    // config 在此之后不再被使用 → 安全&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createAndSend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> NonSendableConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    config.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // Swift 6：编译器分析 config 在发送后不再被访问</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 即使 NonSendableConfig 不是 Sendable，也可以安全传递</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actor.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">use</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(config)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // config 在此之后不再被使用 → 安全</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    RBI[&quot;区域隔离分析&quot;] --&gt; CREATE[&quot;创建值&quot;]&#10;    CREATE --&gt; USE[&quot;本地使用&quot;]&#10;    USE --&gt; SEND[&quot;跨隔离边界发送&quot;]&#10;    SEND --&gt; CHK{&quot;发送后还使用？&quot;}&#10;    CHK --&gt;|否| SAFE[&quot;✅ 安全:值的&#39;区域&#39;已转移&quot;]&#10;    CHK --&gt;|是| UNSAFE[&quot;❌ 编译错误&quot;]\">flowchart TD\n    RBI[\"区域隔离分析\"] --&gt; CREATE[\"创建值\"]\n    CREATE --&gt; USE[\"本地使用\"]\n    USE --&gt; SEND[\"跨隔离边界发送\"]\n    SEND --&gt; CHK{\"发送后还使用？\"}\n    CHK --&gt;|否| SAFE[\"✅ 安全:值的'区域'已转移\"]\n    CHK --&gt;|是| UNSAFE[\"❌ 编译错误\"]</pre><p>区域隔离的核心思想是<strong>所有权转移</strong>——如果一个值在发送到另一个隔离域后不再被当前上下文使用，即使它不是 <code>Sendable</code>，传递也是安全的。</p>\n<hr>\n<h2 id=\"迁移到完整并发安全\">迁移到完整并发安全</h2><p>分步迁移策略：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// 步骤 1：将不可变值类型标记为 Sendable&#10;struct AppConfig: Sendable {&#10;    let environment: String&#10;    let version: String&#10;}&#10;&#10;// 步骤 2：将内部同步的类标记为 @unchecked Sendable&#10;final class Logger: @unchecked Sendable {&#10;    private let queue = DispatchQueue(label: &quot;logger&quot;)&#10;    func log(_ message: String) {&#10;        queue.async { print(message) }&#10;    }&#10;}&#10;&#10;// 步骤 3：将可变共享状态迁移到 actor&#10;actor SessionManager {&#10;    private var sessions: [String: Session] = [:]&#10;&#10;    func createSession(for user: String) -&gt; Session {&#10;        let session = Session(user: user)&#10;        sessions[user] = session&#10;        return session&#10;    }&#10;}&#10;&#10;// 步骤 4：确保闭包是 @Sendable&#10;func scheduleWork(_ work: @Sendable @escaping () async -&gt; Void) {&#10;    Task { await work() }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 步骤 1：将不可变值类型标记为 Sendable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AppConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Sendable </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> environment: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> version: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 步骤 2：将内部同步的类标记为 @unchecked Sendable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">final</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Logger</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">@unchecked</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Sendable </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> queue </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> DispatchQueue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">label</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"logger\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> message: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        queue.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(message) }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 步骤 3：将可变共享状态迁移到 actor</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">actor</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SessionManager</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sessions: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: Session] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createSession</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Session {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> session </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Session</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">user</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: user)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        sessions[user] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> session</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> session</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 步骤 4：确保闭包是 @Sendable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> scheduleWork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> work: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">@Sendable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> @escaping</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    Task</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> work</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>Sendable</strong> 是标记协议，表示值可以安全跨并发域传递</li>\n<li>值类型（struct、enum）在属性都是 Sendable 时<strong>自动遵循</strong>；类需要显式声明且满足条件</li>\n<li><strong><code>@Sendable</code> 闭包</strong>不能捕获可变变量，确保跨隔离边界安全</li>\n<li><strong>严格并发检查</strong>有三个级别，<code>complete</code> 是 Swift 6 默认行为</li>\n<li><strong><code>@unchecked Sendable</code></strong> 绕过编译器检查，需自行保证线程安全</li>\n<li><strong>区域隔离</strong>分析值在发送后是否还被使用，实现更精确的安全判断</li>\n</ul>\n","headings":[{"level":1,"text":"Sendable 与隔离","id":"sendable-与隔离"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Sendable 协议","id":"sendable-协议"},{"level":2,"text":"@Sendable 闭包","id":"sendable-闭包"},{"level":2,"text":"严格并发检查","id":"严格并发检查"},{"level":2,"text":"@unchecked Sendable","id":"unchecked-sendable"},{"level":2,"text":"基于区域的隔离（Region-based Isolation）","id":"基于区域的隔离-region-based-isolation"},{"level":2,"text":"迁移到完整并发安全","id":"迁移到完整并发安全"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Actors 行为体","url":"/l-doc-books/h/mobile/swift-language-advanced/concurrency/actors"},"next":{"title":"ARC 内部机制","url":"/l-doc-books/h/mobile/swift-language-advanced/memory-model/arc-internals"}}