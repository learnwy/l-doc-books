data-lang=\"swift\" data-code=\"func example() async throws -&gt; Data    // 声明&#10;let data = try await example()          // 调用\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Data    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 声明</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()          </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 调用</span></span></code></pre></div><hr>\n<h2 id=\"continuation-bridge\">Continuation Bridge</h2><p>Continuation 是将传统回调 API 桥接到 async/await 的机制：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func fetchImage(url: URL) async throws -&gt; UIImage {&#10;    try await withCheckedThrowingContinuation { continuation in&#10;        URLSession.shared.dataTask(with: url) { data, _, error in&#10;            if let error = error {&#10;                continuation.resume(throwing: error)&#10;                return&#10;            }&#10;            guard let data = data, let image = UIImage(data: data) else {&#10;                continuation.resume(throwing: ImageError.invalidData)&#10;                return&#10;            }&#10;            continuation.resume(returning: image)&#10;        }.resume()&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">url</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: URL) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UIImage {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> withCheckedThrowingContinuation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { continuation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        URLSession.shared.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">dataTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: url) { data, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, error </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> error </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> error {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                continuation.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">resume</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">throwing</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: error)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                return</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            guard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> image </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UIImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: data) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                continuation.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">resume</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">throwing</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: ImageError.invalidData)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                return</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            continuation.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">resume</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">returning</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: image)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">resume</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>Continuation 类型</th>\n<th>用途</th>\n<th>安全检查</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>withCheckedContinuation</code></td>\n<td>非抛出</td>\n<td>运行时检查 resume 次数</td>\n</tr>\n<tr>\n<td><code>withCheckedThrowingContinuation</code></td>\n<td>可抛出</td>\n<td>运行时检查 resume 次数</td>\n</tr>\n<tr>\n<td><code>withUnsafeContinuation</code></td>\n<td>非抛出</td>\n<td>无检查（更快）</td>\n</tr>\n<tr>\n<td><code>withUnsafeThrowingContinuation</code></td>\n<td>可抛出</td>\n<td>无检查（更快）</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> Continuation 必须恰好 resume <strong>一次</strong>。不调用会导致任务永久挂起，调用多次会导致未定义行为。<code>Checked</code> 版本会在违规时触发运行时错误。</p>\n</blockquote>\n<hr>\n<h2 id=\"异步属性和下标\">异步属性和下标</h2><p>Swift 支持异步计算属性（只读）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"struct RemoteConfig {&#10;    var endpoint: URL&#10;&#10;    var latestVersion: String {&#10;        get async throws {&#10;            let (data, _) = try await URLSession.shared.data(from: endpoint)&#10;            return String(data: data, encoding: .utf8) ?? &quot;unknown&quot;&#10;        }&#10;    }&#10;}&#10;&#10;let config = RemoteConfig(endpoint: versionURL)&#10;let version = try await config.latestVersion\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RemoteConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> endpoint: URL</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> latestVersion: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> async </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (data, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> URLSession.shared.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: endpoint)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: data, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">encoding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">utf8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"unknown\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RemoteConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">endpoint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: versionURL)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> version </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.latestVersion</span></span></code></pre></div><hr>\n<h2 id=\"async-await-执行模型\">async/await 执行模型</h2><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    CALL[&quot;调用 async 函数&quot;] --&gt; EXEC[&quot;开始执行&quot;]&#10;    EXEC --&gt; AWAIT[&quot;遇到 await(挂起点)&quot;]&#10;    AWAIT --&gt; RELEASE[&quot;释放线程&quot;]&#10;    RELEASE --&gt; POOL[&quot;线程返回线程池&quot;]&#10;    POOL --&gt; OTHER[&quot;执行其他任务&quot;]&#10;    subgraph &quot;异步操作完成后&quot;&#10;        DONE[&quot;操作完成&quot;] --&gt; RESUME[&quot;调度器选择线程&quot;]&#10;        RESUME --&gt; CONT[&quot;从挂起点恢复&quot;]&#10;    end&#10;    OTHER -.-&gt; DONE\">flowchart TD\n    CALL[\"调用 async 函数\"] --&gt; EXEC[\"开始执行\"]\n    EXEC --&gt; AWAIT[\"遇到 await(挂起点)\"]\n    AWAIT --&gt; RELEASE[\"释放线程\"]\n    RELEASE --&gt; POOL[\"线程返回线程池\"]\n    POOL --&gt; OTHER[\"执行其他任务\"]\n    subgraph \"异步操作完成后\"\n        DONE[\"操作完成\"] --&gt; RESUME[\"调度器选择线程\"]\n        RESUME --&gt; CONT[\"从挂起点恢复\"]\n    end\n    OTHER -.-&gt; DONE</pre><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>async/await</strong> 将回调式异步代码转为线性编写，<code>await</code> 标记挂起点</li>\n<li><strong>结构化 Task</strong> 继承当前 actor 上下文；<code>Task.detached</code> 创建独立任务</li>\n<li><strong>AsyncSequence</strong> 是异步版本的 Sequence，支持 <code>for await</code> 遍历和链式操作</li>\n<li>声明顺序 <code>async throws</code>，调用顺序 <code>try await</code></li>\n<li><strong>Continuation</strong> 桥接传统回调 API，必须恰好 resume 一次</li>\n<li>异步函数在挂起时释放线程，不会阻塞，由运行时调度恢复</li>\n</ul>\n","headings":[{"level":1,"text":"async/await 异步等待","id":"async-await-异步等待"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"异步函数基础","id":"异步函数基础"},{"level":2,"text":"结构化任务（Structured Tasks）","id":"结构化任务-structured-tasks"},{"level":2,"text":"Async Sequences","id":"async-sequences"},{"level":2,"text":"Throwing Async","id":"throwing-async"},{"level":2,"text":"Continuation Bridge","id":"continuation-bridge"},{"level":2,"text":"异步属性和下标","id":"异步属性和下标"},{"level":2,"text":"async/await 执行模型","id":"async-await-执行模型"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"协议见证表","url":"/l-doc-books/h/mobile/swift-language-advanced/protocols/protocol-witness-table"},"next":{"title":"结构化并发","url":"/l-doc-books/h/mobile/swift-language-advanced/concurrency/structured-concurrency"}}