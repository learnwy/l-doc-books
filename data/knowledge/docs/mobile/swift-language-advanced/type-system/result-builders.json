dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> components: [[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Element</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        components.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@ArrayBuilder&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> numberedList</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">items</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (index, item) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">enumerated</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\\(index </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">. </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\\(item)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"完整-result-builder-方法一览\">完整 Result Builder 方法一览</h2><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>用途</th>\n<th>触发条件</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>buildBlock</code></td>\n<td>组合多个语句</td>\n<td>必须实现</td>\n</tr>\n<tr>\n<td><code>buildExpression</code></td>\n<td>将单个表达式转为组件</td>\n<td>表达式类型不同于组件类型时</td>\n</tr>\n<tr>\n<td><code>buildOptional</code></td>\n<td>处理 <code>if</code> 无 <code>else</code></td>\n<td><code>if</code> 语句</td>\n</tr>\n<tr>\n<td><code>buildEither(first:)</code></td>\n<td>处理条件分支（真）</td>\n<td><code>if-else</code> / <code>switch</code></td>\n</tr>\n<tr>\n<td><code>buildEither(second:)</code></td>\n<td>处理条件分支（假）</td>\n<td><code>if-else</code> / <code>switch</code></td>\n</tr>\n<tr>\n<td><code>buildArray</code></td>\n<td>处理循环</td>\n<td><code>for-in</code> 循环</td>\n</tr>\n<tr>\n<td><code>buildFinalResult</code></td>\n<td>最终结果转换</td>\n<td>闭包返回前</td>\n</tr>\n<tr>\n<td><code>buildLimitedAvailability</code></td>\n<td>处理 <code>#available</code></td>\n<td>可用性检查</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"实战-sql-查询构建器\">实战：SQL 查询构建器</h2><div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"struct SQLQuery {&#10;    var parts: [String]&#10;    var sql: String { parts.joined(separator: &quot; &quot;) }&#10;}&#10;&#10;@resultBuilder&#10;struct QueryBuilder {&#10;    static func buildBlock(_ components: String...) -&gt; SQLQuery {&#10;        SQLQuery(parts: components)&#10;    }&#10;&#10;    static func buildOptional(_ component: SQLQuery?) -&gt; String {&#10;        component?.sql ?? &quot;&quot;&#10;    }&#10;&#10;    static func buildEither(first component: String) -&gt; String {&#10;        component&#10;    }&#10;&#10;    static func buildEither(second component: String) -&gt; String {&#10;        component&#10;    }&#10;}&#10;&#10;func query(@QueryBuilder _ build: () -&gt; SQLQuery) -&gt; SQLQuery {&#10;    build()&#10;}&#10;&#10;let searchQuery = query {&#10;    &quot;SELECT * FROM users&quot;&#10;    &quot;WHERE active = true&quot;&#10;    &quot;ORDER BY created_at DESC&quot;&#10;    &quot;LIMIT 10&quot;&#10;}&#10;print(searchQuery.sql)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SQLQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> parts: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sql: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { parts.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">joined</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">separator</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\" \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@resultBuilder</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> QueryBuilder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildBlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> components: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SQLQuery {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        SQLQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">parts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: components)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildOptional</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> component: SQLQuery</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        component</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.sql </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildEither</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">first</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> component: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        component</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildEither</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">second</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> component: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        component</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(@QueryBuilder </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> build: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SQLQuery) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> SQLQuery {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> searchQuery </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"SELECT * FROM users\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"WHERE active = true\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"ORDER BY created_at DESC\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"LIMIT 10\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(searchQuery.sql)</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> Result Builder 在编译时进行完整的类型检查，任何类型不匹配都会产生编译错误。这使得 DSL 在拥有灵活语法的同时保持类型安全。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong><code>@resultBuilder</code></strong> 允许定义声明式 DSL，编译器自动将代码块转换为 <code>build</code> 方法调用</li>\n<li><strong><code>buildBlock</code></strong> 是唯一必须的方法，用于组合闭包中的多个语句</li>\n<li><strong><code>buildOptional</code></strong> 和 <strong><code>buildEither</code></strong> 分别支持 <code>if</code> 和 <code>if-else</code>/<code>switch</code> 分支</li>\n<li><strong><code>buildArray</code></strong> 支持 <code>for-in</code> 循环</li>\n<li>SwiftUI 的 <code>@ViewBuilder</code> 是最广泛使用的 Result Builder 实现</li>\n<li>自定义 Result Builder 适合构建 HTML、SQL、配置文件等声明式 DSL，兼具灵活性和类型安全</li>\n</ul>\n","headings":[{"level":1,"text":"Result Builders 结果构建器","id":"result-builders-结果构建器"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基本原理","id":"基本原理"},{"level":2,"text":"buildBlock：基础组合","id":"buildblock-基础组合"},{"level":2,"text":"buildOptional：支持 if 语句","id":"buildoptional-支持-if-语句"},{"level":2,"text":"buildEither：支持 if-else 和 switch","id":"buildeither-支持-if-else-和-switch"},{"level":2,"text":"buildArray：支持 for-in 循环","id":"buildarray-支持-for-in-循环"},{"level":2,"text":"完整 Result Builder 方法一览","id":"完整-result-builder-方法一览"},{"level":2,"text":"实战：SQL 查询构建器","id":"实战-sql-查询构建器"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"不透明类型与存在类型","url":"/l-doc-books/h/mobile/swift-language-advanced/type-system/opaque-and-existential-types"},"next":{"title":"面向协议编程","url":"/l-doc-books/h/mobile/swift-language-advanced/protocols/protocol-oriented-programming"}}