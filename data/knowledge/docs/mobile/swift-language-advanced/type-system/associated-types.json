[Item] { get }&#10;    func sorted() -&gt; [Item]&#10;}&#10;&#10;protocol Graph {&#10;    associatedtype Node: Hashable&#10;    associatedtype Edge: Hashable&#10;    func neighbors(of node: Node) -&gt; [Node]&#10;    func edges(from source: Node, to target: Node) -&gt; [Edge]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SortableContainer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Comparable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items: [Item] { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sorted</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [Item]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Graph</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Node</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Hashable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Edge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Hashable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> neighbors</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> node: Node) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [Node]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> edges</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> source: Node, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> target: Node) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [Edge]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>也可以使用 <code>where</code> 子句表达关联类型之间的关系：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"protocol ConvertibleContainer {&#10;    associatedtype Input&#10;    associatedtype Output where Output: Collection, Output.Element == Input&#10;    func convert() -&gt; Output&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConvertibleContainer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Input</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> where</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Output</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Collection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, Output.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Element</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Input</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> convert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Output</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"类型擦除\">类型擦除</h2><p>带有关联类型的协议不能直接用作类型（即不能写 <code>let c: Container</code>），因为编译器无法确定关联类型的具体绑定。类型擦除是解决这一限制的经典模式：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"struct AnyContainer&lt;Item&gt;: Container {&#10;    private let _count: () -&gt; Int&#10;    private let _append: (Item) -&gt; Void&#10;    private let _subscript: (Int) -&gt; Item&#10;&#10;    var count: Int { _count() }&#10;&#10;    init&lt;C: Container&gt;(_ container: C) where C.Item == Item {&#10;        var mutableContainer = container&#10;        _count = { mutableContainer.count }&#10;        _append = { mutableContainer.append($0) }&#10;        _subscript = { mutableContainer[$0] }&#10;    }&#10;&#10;    mutating func append(_ item: Item) {&#10;        _append(item)&#10;    }&#10;&#10;    subscript(i: Int) -&gt; Item {&#10;        _subscript(i)&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AnyContainer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Container </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _count: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Int</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _append: (Item) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Void</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _subscript: (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Item</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> count: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">_count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">C</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Container</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> container: C) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">where</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> C.Item </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Item {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mutableContainer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> container</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        _count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { mutableContainer.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        _append </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { mutableContainer.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        _subscript </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { mutableContainer[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    mutating</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> item: Item) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        _append</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    subscript</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Item {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        _subscript</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>方式</th>\n<th>优点</th>\n<th>缺点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>类型擦除包装</td>\n<td>完全控制，灵活</td>\n<td>手动编写，样板代码多</td>\n</tr>\n<tr>\n<td><code>any Protocol</code> (Swift 5.6+)</td>\n<td>语法简洁，编译器自动处理</td>\n<td>存在性能开销</td>\n</tr>\n<tr>\n<td><code>some Protocol</code></td>\n<td>零开销，编译时确定</td>\n<td>不能用于异构集合</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> Swift 标准库中的 <code>AnySequence</code>、<code>AnyCollection</code>、<code>AnyHashable</code> 都是类型擦除包装的典型实现。</p>\n</blockquote>\n<hr>\n<h2 id=\"主关联类型-primary-associated-types\">主关联类型（Primary Associated Types）</h2><p>Swift 5.7（SE-0346）引入了主关联类型语法，使协议可以像泛型类型一样使用尖括号参数化：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"protocol Collection&lt;Element&gt; {&#10;    associatedtype Element&#10;    associatedtype Index: Comparable&#10;    // ...&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Collection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;Element> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Element</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Index</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Comparable</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>这使得 <code>any</code> 和 <code>some</code> 可以搭配类型参数使用：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func processItems(_ items: some Collection&lt;Int&gt;) {&#10;    for item in items {&#10;        print(item * 2)&#10;    }&#10;}&#10;&#10;func storeContainer(_ container: any Collection&lt;String&gt;) {&#10;    print(container.count)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processItems</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">some</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Collection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> item </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> storeContainer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> container: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">any</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Collection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(container.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph &quot;Swift 5.6 之前&quot;&#10;        OLD[&quot;func foo&amp;lt;C: Collection&amp;gt;(_ c: C) where C.Element == Int&quot;]&#10;    end&#10;    subgraph &quot;Swift 5.7+&quot;&#10;        NEW1[&quot;func foo(_ c: some Collection&amp;lt;Int&amp;gt;)&quot;]&#10;        NEW2[&quot;func foo(_ c: any Collection&amp;lt;Int&amp;gt;)&quot;]&#10;    end&#10;    OLD --&gt; NEW1&#10;    OLD --&gt; NEW2\">flowchart LR\n    subgraph \"Swift 5.6 之前\"\n        OLD[\"func foo&amp;lt;C: Collection&amp;gt;(_ c: C) where C.Element == Int\"]\n    end\n    subgraph \"Swift 5.7+\"\n        NEW1[\"func foo(_ c: some Collection&amp;lt;Int&amp;gt;)\"]\n        NEW2[\"func foo(_ c: any Collection&amp;lt;Int&amp;gt;)\"]\n    end\n    OLD --&gt; NEW1\n    OLD --&gt; NEW2</pre><p>主关联类型极大简化了带有关联类型的协议的使用语法，特别是在参数声明和返回值类型上。</p>\n<hr>\n<h2 id=\"关联类型的递归约束\">关联类型的递归约束</h2><p>关联类型支持递归约束，这在定义树形或图形数据结构时非常有用：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"protocol TreeNode {&#10;    associatedtype Value&#10;    associatedtype Child: TreeNode where Child.Value == Value&#10;    var value: Value { get }&#10;    var children: [Child] { get }&#10;}&#10;&#10;struct SimpleTreeNode&lt;V&gt;: TreeNode {&#10;    var value: V&#10;    var children: [SimpleTreeNode&lt;V&gt;]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TreeNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Value</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Child</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">TreeNode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">where</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Child</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Value</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Value</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> children: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Child</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SimpleTreeNode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">V</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">TreeNode </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value: V</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> children: [SimpleTreeNode&#x3C;V>]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"实际应用-协议组合与关联类型\">实际应用：协议组合与关联类型</h2><p>在实际项目中，关联类型常用于定义数据层抽象：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"protocol Repository {&#10;    associatedtype Entity: Identifiable&#10;    func fetchAll() async throws -&gt; [Entity]&#10;    func fetch(byID id: Entity.ID) async throws -&gt; Entity?&#10;    func save(_ entity: Entity) async throws&#10;    func delete(byID id: Entity.ID) async throws&#10;}&#10;&#10;struct UserRepository: Repository {&#10;    func fetchAll() async throws -&gt; [User] { /* ... */ [] }&#10;    func fetch(byID id: User.ID) async throws -&gt; User? { /* ... */ nil }&#10;    func save(_ entity: User) async throws { /* ... */ }&#10;    func delete(byID id: User.ID) async throws { /* ... */ }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">protocol</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Repository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    associatedtype</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Entity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Identifiable</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchAll</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [Entity]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">byID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id: Entity.ID) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Entity</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> save</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> entity: Entity) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">byID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id: Entity.ID) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserRepository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Repository </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchAll</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [User] { </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [] }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">byID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id: User.ID) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> User</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> save</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> entity: User) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">byID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id: User.ID) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>关联类型</strong>是协议中的类型占位符，遵循类型在实现时确定具体绑定</li>\n<li>关联类型可以添加<strong>协议约束</strong>和 <strong>where 子句</strong>，表达复杂的类型关系</li>\n<li><strong>类型擦除</strong>通过包装器解决带关联类型的协议不能直接用作类型的问题</li>\n<li>Swift 5.7 的<strong>主关联类型</strong>引入尖括号语法（<code>Collection&lt;Int&gt;</code>），大幅简化使用体验</li>\n<li>关联类型支持<strong>递归约束</strong>，适合树、图等递归数据结构的协议建模</li>\n<li>在实际项目中，关联类型常用于定义 Repository、Service 等可替换的抽象层</li>\n</ul>\n","headings":[{"level":1,"text":"关联类型","id":"关联类型"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基本用法","id":"基本用法"},{"level":2,"text":"关联类型约束","id":"关联类型约束"},{"level":2,"text":"类型擦除","id":"类型擦除"},{"level":2,"text":"主关联类型（Primary Associated Types）","id":"主关联类型-primary-associated-types"},{"level":2,"text":"关联类型的递归约束","id":"关联类型的递归约束"},{"level":2,"text":"实际应用：协议组合与关联类型","id":"实际应用-协议组合与关联类型"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"泛型深入","url":"/l-doc-books/h/mobile/swift-language-advanced/type-system/generics-deep-dive"},"next":{"title":"不透明类型与存在类型","url":"/l-doc-books/h/mobile/swift-language-advanced/type-system/opaque-and-existential-types"}}