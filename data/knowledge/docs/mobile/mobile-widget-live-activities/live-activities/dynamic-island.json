span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> window </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UIApplication.shared.connectedScenes</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">compactMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UIWindowScene }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.windows }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">first</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.isKeyWindow }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> window</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.safeAreaInsets.top </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 50</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"自定义转场动画\">自定义转场动画</h3><p>iOS 18 新增 <code>contentTransition</code> 修饰符，控制紧凑态和展开态之间的过渡效果：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"DynamicIsland {&#10;    // 展开内容&#10;} compactLeading: {&#10;    // 紧凑内容&#10;}&#10;.contentTransition(.opacity)        // 淡入淡出&#10;.contentTransition(.identity)       // 无动画&#10;// 自定义：&#10;.contentTransition(.interpolate)    // 插值过渡（iOS 18+）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DynamicIsland</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 展开内容</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">compactLeading</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 紧凑内容</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">contentTransition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.opacity)        </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 淡入淡出</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">contentTransition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">identity</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)       </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 无动画</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 自定义：</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">contentTransition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.interpolate)    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 插值过渡（iOS 18+）</span></span></code></pre></div><hr>\n<h2 id=\"动态岛交互控件\">动态岛交互控件</h2><p>iOS 17 起，展开态支持交互控件（Button、Toggle 等），通过 <code>AppIntent</code> 实现：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"DynamicIslandExpandedRegion(.bottom) {&#10;    HStack(spacing: 16) {&#10;        Button {&#10;            // 不支持闭包形式的 action&#10;        } label: {&#10;            // iOS 17+ 必须使用 AppIntent&#10;        }&#10;&#10;        Button(intent: CallRiderIntent(rider: context.state.riderName)) {&#10;            Label(&quot;联系骑手&quot;, systemImage: &quot;phone&quot;)&#10;        }&#10;&#10;        Button(intent: CancelDeliveryIntent(orderID: context.attributes.order.orderID)) {&#10;            Label(&quot;取消订单&quot;, systemImage: &quot;xmark.circle&quot;)&#10;        }&#10;        .tint(.red)&#10;    }&#10;    .buttonStyle(.borderedProminent)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DynamicIslandExpandedRegion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.bottom) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    HStack</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">spacing</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        Button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">            // 不支持闭包形式的 action</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        } </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">label</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">            // iOS 17+ 必须使用 AppIntent</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        Button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">intent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">CallRiderIntent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">rider</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: context.state.riderName)) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            Label</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"联系骑手\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">systemImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"phone\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        Button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">intent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">CancelDeliveryIntent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">orderID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: context.attributes.order.orderID)) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            Label</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"取消订单\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">systemImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"xmark.circle\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.red)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">buttonStyle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.borderedProminent)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"支持的交互控件\">支持的交互控件</h3><table>\n<thead>\n<tr>\n<th align=\"left\">控件</th>\n<th align=\"left\">紧凑态</th>\n<th align=\"left\">展开态</th>\n<th align=\"left\">说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td align=\"left\"><code>Button</code></td>\n<td align=\"left\">iOS 18+</td>\n<td align=\"left\">iOS 17+</td>\n<td align=\"left\">绑定 <code>AppIntent</code> 执行操作</td>\n</tr>\n<tr>\n<td align=\"left\"><code>Toggle</code></td>\n<td align=\"left\">不支持</td>\n<td align=\"left\">iOS 17+</td>\n<td align=\"left\">开关类操作</td>\n</tr>\n<tr>\n<td align=\"left\"><code>Link</code></td>\n<td align=\"left\">不支持</td>\n<td align=\"left\">iOS 17+</td>\n<td align=\"left\">深链接到应用</td>\n</tr>\n<tr>\n<td align=\"left\"><code>ProgressView</code></td>\n<td align=\"left\">只读</td>\n<td align=\"left\">只读</td>\n<td align=\"left\">展示进度</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"设计最佳实践\">设计最佳实践</h2><h3 id=\"紧凑态设计原则\">紧凑态设计原则</h3><table>\n<thead>\n<tr>\n<th align=\"left\">原则</th>\n<th align=\"left\">说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td align=\"left\">信息密度极低</td>\n<td align=\"left\">Leading 放品牌图标，Trailing 放关键数值</td>\n</tr>\n<tr>\n<td align=\"left\">不超过 2 个数据点</td>\n<td align=\"left\">一个图标 + 一个数字/倒计时</td>\n</tr>\n<tr>\n<td align=\"left\">避免文字</td>\n<td align=\"left\">紧凑空间中文字几乎不可读</td>\n</tr>\n<tr>\n<td align=\"left\">色彩对比</td>\n<td align=\"left\">使用高对比度颜色确保在各种背景下可见</td>\n</tr>\n</tbody></table>\n<h3 id=\"展开态设计原则\">展开态设计原则</h3><table>\n<thead>\n<tr>\n<th align=\"left\">原则</th>\n<th align=\"left\">说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td align=\"left\">信息层次清晰</td>\n<td align=\"left\">Leading/Trailing 放摘要，Center 放核心内容，Bottom 放操作</td>\n</tr>\n<tr>\n<td align=\"left\">交互目标 ≥ 44pt</td>\n<td align=\"left\">确保可点击区域足够大</td>\n</tr>\n<tr>\n<td align=\"left\">不超过 3 个操作按钮</td>\n<td align=\"left\">避免选择困难</td>\n</tr>\n<tr>\n<td align=\"left\">与锁屏视图一致</td>\n<td align=\"left\">展开态和锁屏视图展示相同的核心信息</td>\n</tr>\n</tbody></table>\n<h3 id=\"最小态设计原则\">最小态设计原则</h3><table>\n<thead>\n<tr>\n<th align=\"left\">原则</th>\n<th align=\"left\">说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td align=\"left\">单一可识别图标</td>\n<td align=\"left\">用户一眼就能识别是哪个应用的活动</td>\n</tr>\n<tr>\n<td align=\"left\">可选简短文本</td>\n<td align=\"left\">iOS 18+ 可附加数字或短词（如 &quot;3:24&quot;）</td>\n</tr>\n<tr>\n<td align=\"left\">品牌色</td>\n<td align=\"left\">使用应用的品牌色或主题色</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"动态岛与实时活动的优先级排序\">动态岛与实时活动的优先级排序</h2><p>当多个实时活动同时运行时，系统根据以下因素决定哪个显示为主要活动（紧凑态）、哪个显示为最小态：</p>\n<ol>\n<li><strong>relevanceScore</strong> — <code>ActivityContent</code> 中设置的优先级分数（0-100）</li>\n<li><strong>最近更新时间</strong> — 最近更新的活动优先级更高</li>\n<li><strong>用户交互历史</strong> — 用户经常查看的活动优先级更高</li>\n<li><strong>活动类型</strong> — 通话类活动优先级最高</li>\n</ol>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"let highPriorityContent = ActivityContent(&#10;    state: currentState,&#10;    staleDate: Date().addingTimeInterval(300),&#10;    relevanceScore: 100  // 最高优先级&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> highPriorityContent </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ActivityContent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: currentState,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    staleDate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Date</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">addingTimeInterval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    relevanceScore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 最高优先级</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>动态岛有三种形态：紧凑态（单活动）、最小态（多活动时次要活动）、展开态（用户交互）</li>\n<li>展开态分为四个区域：Leading、Trailing、Center、Bottom</li>\n<li>iOS 18 新特性：紧凑视图交互、灵活紧凑布局、iPad 支持、自定义转场</li>\n<li>交互控件通过 <code>AppIntent</code> 实现，iOS 17 支持展开态，iOS 18 扩展到紧凑态</li>\n<li>设计原则：紧凑态极简（图标+数值）、展开态层次清晰、最小态可识别</li>\n<li>多活动时通过 <code>relevanceScore</code> 控制优先级排序</li>\n</ul>\n<p>相关内容请参阅 <a href=\"activitykit-live-activities\">ActivityKit 与实时活动</a> 和 <a href=\"live-activity-updates\">实时活动更新策略</a>。</p>\n","headings":[{"level":1,"text":"动态岛设计与交互","id":"动态岛设计与交互"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"动态岛的三种展示形态","id":"动态岛的三种展示形态"},{"level":3,"text":"紧凑态（Compact）","id":"紧凑态-compact"},{"level":3,"text":"最小态（Minimal）","id":"最小态-minimal"},{"level":3,"text":"展开态（Expanded）","id":"展开态-expanded"},{"level":2,"text":"构建动态岛视图","id":"构建动态岛视图"},{"level":2,"text":"iOS 18 动态岛新特性","id":"ios-18-动态岛新特性"},{"level":3,"text":"紧凑视图交互","id":"紧凑视图交互"},{"level":3,"text":"灵活紧凑布局","id":"灵活紧凑布局"},{"level":3,"text":"iPad 支持","id":"ipad-支持"},{"level":3,"text":"自定义转场动画","id":"自定义转场动画"},{"level":2,"text":"动态岛交互控件","id":"动态岛交互控件"},{"level":3,"text":"支持的交互控件","id":"支持的交互控件"},{"level":2,"text":"设计最佳实践","id":"设计最佳实践"},{"level":3,"text":"紧凑态设计原则","id":"紧凑态设计原则"},{"level":3,"text":"展开态设计原则","id":"展开态设计原则"},{"level":3,"text":"最小态设计原则","id":"最小态设计原则"},{"level":2,"text":"动态岛与实时活动的优先级排序","id":"动态岛与实时活动的优先级排序"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"ActivityKit 与实时活动","url":"/l-doc-books/h/mobile/mobile-widget-live-activities/live-activities/activitykit-live-activities"},"next":{"title":"实时活动更新策略","url":"/l-doc-books/h/mobile/mobile-widget-live-activities/live-activities/live-activity-updates"}}