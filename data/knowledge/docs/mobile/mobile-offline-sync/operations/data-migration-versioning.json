an><span style=\"color:#D73A49;--shiki-dark:#F97583\">any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PersistentModel.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] { [Note.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    @Model</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> final</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Note</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id: UUID</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> title: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> content: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tags: [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 新增，可选</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> priority: </span><span style=\"co