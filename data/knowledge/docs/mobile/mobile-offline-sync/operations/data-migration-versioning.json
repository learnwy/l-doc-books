;--shiki-dark:#E1E4E8\">        [.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">lightweight</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">fromVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: AppSchemaV1.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">toVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: AppSchemaV2.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"android-room-automigration-手动迁移\">Android：Room AutoMigration + 手动迁移</h3><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"@Database(&#10;    entities = [NoteEntity::class, TagEntity::class],&#10;    version = 3,&#10;    autoMigrations = [&#10;        AutoMigration(from = 1, to = 2),  // 加 priority 列&#10;    ]&#10;)&#10;abstract class AppDatabase : RoomDatabase() {&#10;    companion object {&#10;        // 手动迁移：数据转换场景&#10;        val MIGRATION_2_3 = object : Migration(2, 3) {&#10;            override fun migrate(db: SupportSQLiteDatabase) {&#10;                // 创建新的 tags 表&#10;                db.execSQL(&quot;&quot;&quot;&#10;                    CREATE TABLE tags (&#10;                        id TEXT PRIMARY KEY NOT NULL,&#10;                        note_id TEXT NOT NULL,&#10;                        name TEXT NOT NULL,&#10;                        FOREIGN KEY (note_id) REFERENCES notes(id) ON DELETE CASCADE&#10;                    )&#10;                &quot;&quot;&quot;)&#10;                // 从旧的 tags_json 字段迁移数据&#10;                db.execSQL(&quot;&quot;&quot;&#10;                    INSERT INTO tags (id, note_id, name)&#10;                    SELECT hex(randomblob(16)), id, value&#10;                    FROM notes, json_each(notes.tags_json)&#10;                    WHERE notes.tags_json IS NOT NULL&#10;                &quot;&quot;&quot;)&#10;                // 删除旧字段（SQLite 不支持 DROP COLUMN，需重建表）&#10;            }&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>@Database(</span></span>\n<span class=\"line\"><span>    entities = [NoteEntity::class, TagEntity::class],</span></span>\n<span class=\"line\"><span>    version = 3,</span></span>\n<span class=\"line\"><span>    autoMigrations = [</span></span>\n<span class=\"line\"><span>        AutoMigration(from = 1, to = 2),  // 加 priority 列</span></span>\n<span class=\"line\"><span>    ]</span></span>\n<span class=\"line\"><span>)</span></span>\n<span class=\"line\"><span>abstract class AppDatabase : RoomDatabase() {</span></span>\n<span class=\"line\"><span>    companion object {</span></span>\n<span class=\"line\"><span>        // 手动迁移：数据转换场景</span></span>\n<span class=\"line\"><span>        val MIGRATION_2_3 = object : Migration(2, 3) {</span></span>\n<span class=\"line\"><span>            override fun migrate(db: SupportSQLiteDatabase) {</span></span>\n<span class=\"line\"><span>                // 创建新的 tags 表</span></span>\n<span class=\"line\"><span>                db.execSQL(\"\"\"</span></span>\n<span class=\"line\"><span>                    CREATE TABLE tags (</span></span>\n<span class=\"line\"><span>                        id TEXT PRIMARY KEY NOT NULL,</span></span>\n<span class=\"line\"><span>                        note_id TEXT NOT NULL,</span></span>\n<span class=\"line\"><span>                        name TEXT NOT NULL,</span></span>\n<span class=\"line\"><span>                        FOREIGN KEY (note_id) REFERENCES notes(id) ON DELETE CASCADE</span></span>\n<span class=\"line\"><span>                    )</span></span>\n<span class=\"line\"><span>                \"\"\")</span></span>\n<span class=\"line\"><span>                // 从旧的 tags_json 字段迁移数据</span></span>\n<span class=\"line\"><span>                db.execSQL(\"\"\"</span></span>\n<span class=\"line\"><span>                    INSERT INTO tags (id, note_id, name)</span></span>\n<span class=\"line\"><span>                    SELECT hex(randomblob(16)), id, value</span></span>\n<span class=\"line\"><span>                    FROM notes, json_each(notes.tags_json)</span></span>\n<span class=\"line\"><span>                    WHERE notes.tags_json IS NOT NULL</span></span>\n<span class=\"line\"><span>                \"\"\")</span></span>\n<span class=\"line\"><span>                // 删除旧字段（SQLite 不支持 DROP COLUMN，需重建表）</span></span>\n<span class=\"line\"><span>            }</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"服务端-schema-版本管理\">服务端 Schema 版本管理</h2><p>服务端需要同时理解多个版本的数据格式。两种主流方案：</p>\n<p><strong>方案一：版本化 API 端点</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"POST /api/v2/sync/push   ← V2 客户端使用&#10;POST /api/v3/sync/push   ← V3 客户端使用\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>POST /api/v2/sync/push   ← V2 客户端使用</span></span>\n<span class=\"line\"><span>POST /api/v3/sync/push   ← V3 客户端使用</span></span></code></pre></div><p>每个版本的端点理解对应版本的 payload 格式，内部转换为统一的存储格式。</p>\n<p><strong>方案二：Payload 自描述版本</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;schema_version&quot;: 3,&#10;  &quot;mutations&quot;: [&#10;    {&#10;      &quot;table&quot;: &quot;notes&quot;,&#10;      &quot;op&quot;: &quot;upsert&quot;,&#10;      &quot;data&quot;: { &quot;id&quot;: &quot;...&quot;, &quot;title&quot;: &quot;...&quot;, &quot;priority&quot;: 1 }&#10;    }&#10;  ]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"schema_version\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"mutations\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"table\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"notes\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"op\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"upsert\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"data\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"title\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"priority\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>服务端根据 <code>schema_version</code> 选择对应的反序列化器和验证器。</p>\n<h2 id=\"跨版本同步的数据转换\">跨版本同步的数据转换</h2><p>当 V2 客户端接收到 V3 客户端产生的数据时，需要安全处理未知字段：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[服务端推送数据] --&gt; B{客户端识别所有字段?}&#10;    B --&gt;|是| C[正常应用变更]&#10;    B --&gt;|否| D[已知字段正常应用]&#10;    D --&gt; E[未知字段存入 _overflow JSON 列]&#10;    E --&gt; F[下次推送时回传 _overflow]\">flowchart TD\n    A[服务端推送数据] --&gt; B{客户端识别所有字段?}\n    B --&gt;|是| C[正常应用变更]\n    B --&gt;|否| D[已知字段正常应用]\n    D --&gt; E[未知字段存入 _overflow JSON 列]\n    E --&gt; F[下次推送时回传 _overflow]</pre><p><code>_overflow</code> 模式确保了旧客户端不会丢弃它不理解的字段——这些字段保存在一个 JSON blob 中，当该记录再次推送到服务端时原样回传。</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 每张业务表增加 _overflow 列&#10;ALTER TABLE notes ADD COLUMN _overflow TEXT DEFAULT &#39;{}&#39;;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 每张业务表增加 _overflow 列</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ALTER</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> notes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ADD</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> COLUMN _overflow </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TEXT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '{}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><h2 id=\"数据迁移执行策略\">数据迁移执行策略</h2><p>大规模数据迁移（如几十万条记录的格式转换）不能在应用启动时同步执行——否则用户会看到长时间的启动等待。</p>\n<table>\n<thead>\n<tr>\n<th>策略</th>\n<th>启动时间</th>\n<th>数据一致性</th>\n<th>实现复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>同步迁移（启动时）</td>\n<td>可能很长</td>\n<td>完全一致</td>\n<td>低</td>\n</tr>\n<tr>\n<td>懒迁移（读取时）</td>\n<td>零影响</td>\n<td>渐进式</td>\n<td>中</td>\n</tr>\n<tr>\n<td>后台迁移</td>\n<td>零影响</td>\n<td>最终一致</td>\n<td>高</td>\n</tr>\n<tr>\n<td>混合策略</td>\n<td>短暂</td>\n<td>分阶段一致</td>\n<td>高</td>\n</tr>\n</tbody></table>\n<p><strong>推荐：懒迁移 + 后台迁移</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// 懒迁移：读取时检查并转换&#10;suspend fun getNote(id: String): Note {&#10;    val entity = noteDao.getById(id)&#10;    return if (entity.schemaVersion &lt; CURRENT_SCHEMA_VERSION) {&#10;        val migrated = migrateEntity(entity)&#10;        noteDao.upsert(migrated)  // 回写迁移后的版本&#10;        migrated.toNote()&#10;    } else {&#10;        entity.toNote()&#10;    }&#10;}&#10;&#10;// 后台迁移：空闲时批量转换&#10;class SchemaMigrationWorker : CoroutineWorker(...) {&#10;    override suspend fun doWork(): Result {&#10;        val batch = noteDao.getUnmigrated(limit = 100)&#10;        if (batch.isEmpty()) return Result.success()&#10;&#10;        db.withTransaction {&#10;            batch.forEach { entity -&gt;&#10;                noteDao.upsert(migrateEntity(entity))&#10;            }&#10;        }&#10;&#10;        // 还有未迁移数据，重新调度&#10;        return if (noteDao.countUnmigrated() &gt; 0) {&#10;            Result.success()  // WorkManager 会重新调度&#10;        } else {&#10;            Result.success()&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// 懒迁移：读取时检查并转换</span></span>\n<span class=\"line\"><span>suspend fun getNote(id: String): Note {</span></span>\n<span class=\"line\"><span>    val entity = noteDao.getById(id)</span></span>\n<span class=\"line\"><span>    return if (entity.schemaVersion &#x3C; CURRENT_SCHEMA_VERSION) {</span></span>\n<span class=\"line\"><span>        val migrated = migrateEntity(entity)</span></span>\n<span class=\"line\"><span>        noteDao.upsert(migrated)  // 回写迁移后的版本</span></span>\n<span class=\"line\"><span>        migrated.toNote()</span></span>\n<span class=\"line\"><span>    } else {</span></span>\n<span class=\"line\"><span>        entity.toNote()</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 后台迁移：空闲时批量转换</span></span>\n<span class=\"line\"><span>class SchemaMigrationWorker : CoroutineWorker(...) {</span></span>\n<span class=\"line\"><span>    override suspend fun doWork(): Result {</span></span>\n<span class=\"line\"><span>        val batch = noteDao.getUnmigrated(limit = 100)</span></span>\n<span class=\"line\"><span>        if (batch.isEmpty()) return Result.success()</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        db.withTransaction {</span></span>\n<span class=\"line\"><span>            batch.forEach { entity -></span></span>\n<span class=\"line\"><span>                noteDao.upsert(migrateEntity(entity))</span></span>\n<span class=\"line\"><span>            }</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>        // 还有未迁移数据，重新调度</span></span>\n<span class=\"line\"><span>        return if (noteDao.countUnmigrated() > 0) {</span></span>\n<span class=\"line\"><span>            Result.success()  // WorkManager 会重新调度</span></span>\n<span class=\"line\"><span>        } else {</span></span>\n<span class=\"line\"><span>            Result.success()</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"cloudkit-schema-的特殊约束\">CloudKit Schema 的特殊约束</h2><p>CloudKit 的 production schema 只允许 additive changes（参见 <a href=\"../implementation/ios-core-data-cloudkit\">iOS Core Data 与 CloudKit 同步</a>）。这意味着：</p>\n<ul>\n<li>永远不能从 CloudKit schema 删除字段</li>\n<li>类型变更需要创建新字段 + 双写期 + 旧字段标记废弃</li>\n<li>表重命名需要创建新 RecordType + 数据复制 + 旧 Type 标记废弃</li>\n</ul>\n<p>这种「只加不减」的约束实际上是最保守也最安全的迁移策略——它从协议层面杜绝了破坏性变更。</p>\n<h2 id=\"回滚与灾难恢复\">回滚与灾难恢复</h2><p>迁移失败时的回滚策略：</p>\n<ol>\n<li><strong>迁移前备份</strong>：在执行破坏性迁移前复制一份数据库文件（iOS: <code>FileManager.copyItem</code>, Android: <code>File.copyTo</code>）</li>\n<li><strong>版本回退兼容</strong>：新版本的数据库文件能被旧版本安全打开（需要 <code>_overflow</code> 机制）</li>\n<li><strong>服务端回退窗口</strong>：保留旧版本 API 端点至少 N 个版本周期</li>\n</ol>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// iOS 迁移前自动备份&#10;func backupBeforeMigration(storeURL: URL) throws {&#10;    let backupURL = storeURL.deletingLastPathComponent()&#10;        .appendingPathComponent(&quot;backup_v\\(currentVersion).sqlite&quot;)&#10;    try FileManager.default.copyItem(at: storeURL, to: backupURL)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// iOS 迁移前自动备份</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> backupBeforeMigration</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">storeURL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: URL) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> backupURL </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> storeURL.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">deletingLastPathComponent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">appendingPathComponent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"backup_v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\\(currentVersion)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.sqlite\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> FileManager.default.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">copyItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">at</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: storeURL, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: backupURL)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><a href=\"sync-monitoring-debugging\">同步监控与调试</a> 中的告警体系应在迁移期间特别关注：同步成功率下降、未知字段比例上升、冲突率飙升——这些都是迁移问题的早期信号。</p>\n<h2 id=\"小结\">小结</h2><p>数据迁移与版本管理是离线同步系统长期演进的保障。核心策略是「只加不减 + 版本兼容窗口」——新字段用 Optional、旧字段先废弃后清理、未知字段用 <code>_overflow</code> 保护。客户端迁移用懒迁移 + 后台批量确保零启动延迟，服务端通过版本化 API 或自描述 payload 同时服务多版本客户端。迁移前备份 + 回退兼容设计 + 监控告警构成了灾难恢复的安全网。</p>\n","headings":[{"level":1,"text":"数据迁移与版本管理","id":"数据迁移与版本管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"离线同步系统的演进悖论","id":"离线同步系统的演进悖论"},{"level":2,"text":"Schema 演进的安全操作分类","id":"schema-演进的安全操作分类"},{"level":2,"text":"版本兼容窗口策略","id":"版本兼容窗口策略"},{"level":2,"text":"客户端迁移策略","id":"客户端迁移策略"},{"level":3,"text":"iOS：SwiftData VersionedSchema","id":"ios-swiftdata-versionedschema"},{"level":3,"text":"Android：Room AutoMigration + 手动迁移","id":"android-room-automigration-手动迁移"},{"level":2,"text":"服务端 Schema 版本管理","id":"服务端-schema-版本管理"},{"level":2,"text":"跨版本同步的数据转换","id":"跨版本同步的数据转换"},{"level":2,"text":"数据迁移执行策略","id":"数据迁移执行策略"},{"level":2,"text":"CloudKit Schema 的特殊约束","id":"cloudkit-schema-的特殊约束"},{"level":2,"text":"回滚与灾难恢复","id":"回滚与灾难恢复"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"带宽与电量优化","url":"/l-doc-books/h/mobile/mobile-offline-sync/operations/bandwidth-battery-optimization"},"next":null}