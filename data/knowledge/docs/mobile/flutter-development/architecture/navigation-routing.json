e\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">intent-filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><h3 id=\"ios-配置-info-plist\">iOS 配置（Info.plist）</h3><div class=\"code-block-wrapper\" data-lang=\"xml\" data-code=\"&lt;key&gt;FlutterDeepLinkingEnabled&lt;/key&gt;&#10;&lt;true/&gt;&#10;&lt;key&gt;CFBundleURLTypes&lt;/key&gt;&#10;&lt;array&gt;&#10;  &lt;dict&gt;&#10;    &lt;key&gt;CFBundleURLSchemes&lt;/key&gt;&#10;    &lt;array&gt;&#10;      &lt;string&gt;myapp&lt;/string&gt;&#10;    &lt;/array&gt;&#10;  &lt;/dict&gt;&#10;&lt;/array&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>FlutterDeepLinkingEnabled&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>CFBundleURLTypes&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>CFBundleURLSchemes&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>myapp&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  &#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">dict</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><p>GoRouter 自动处理深度链接 URL 映射——当应用通过 <code>https://example.com/products/123</code> 打开时，GoRouter 自动导航到 <code>/products/123</code> 路由。</p>\n<hr>\n<h2 id=\"路由状态与-riverpod-集成\">路由状态与 Riverpod 集成</h2><div class=\"code-block-wrapper\" data-lang=\"dart\" data-code=\"// 将认证状态与路由重定向集成&#10;final appRouter = Provider&lt;GoRouter&gt;((ref) {&#10;  final authState = ref.watch(authStateProvider);&#10;&#10;  return GoRouter(&#10;    refreshListenable: GoRouterRefreshStream(&#10;      ref.watch(authStateProvider.stream),&#10;    ),&#10;    redirect: (context, state) {&#10;      final isLoggedIn = authState.isLoggedIn;&#10;      if (!isLoggedIn) return &#39;/login&#39;;&#10;      return null;&#10;    },&#10;    routes: [...],&#10;  );&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// 将认证状态与路由重定向集成</span></span>\n<span class=\"line\"><span>final appRouter = Provider&#x3C;GoRouter>((ref) {</span></span>\n<span class=\"line\"><span>  final authState = ref.watch(authStateProvider);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>  return GoRouter(</span></span>\n<span class=\"line\"><span>    refreshListenable: GoRouterRefreshStream(</span></span>\n<span class=\"line\"><span>      ref.watch(authStateProvider.stream),</span></span>\n<span class=\"line\"><span>    ),</span></span>\n<span class=\"line\"><span>    redirect: (context, state) {</span></span>\n<span class=\"line\"><span>      final isLoggedIn = authState.isLoggedIn;</span></span>\n<span class=\"line\"><span>      if (!isLoggedIn) return '/login';</span></span>\n<span class=\"line\"><span>      return null;</span></span>\n<span class=\"line\"><span>    },</span></span>\n<span class=\"line\"><span>    routes: [...],</span></span>\n<span class=\"line\"><span>  );</span></span>\n<span class=\"line\"><span>});</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><p>GoRouter 是现代 Flutter 应用导航的标准选择。<strong>声明式路由</strong>将页面跳转表达为状态变化，天然支持 Web URL、深度链接和状态恢复。<strong>ShellRoute</strong> 优雅解决底部导航栏与嵌套路由的问题。<strong>类型安全路由</strong>（代码生成）消除字符串路径错误，推荐在中大型项目中使用。路由重定向（<code>redirect</code>）是处理鉴权跳转的正确位置，不应在 Widget 内部手动检查登录状态再 push。</p>\n<hr>\n<h2 id=\"相关文档\">相关文档</h2><ul>\n<li><a href=\"state-management-patterns\">状态管理模式对比</a> — 路由状态与 Riverpod 的集成模式</li>\n<li><a href=\"clean-architecture-flutter\">Clean Architecture 实践</a> — 展示层中路由的位置和职责</li>\n<li><a href=\"../production/cicd-distribution\">CI/CD 与分发</a> — 深度链接在多渠道分发中的配置</li>\n</ul>\n","headings":[{"level":1,"text":"导航与路由 2.0：GoRouter、声明式路由与深度链接","id":"导航与路由-2-0-gorouter-声明式路由与深度链接"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"为什么需要 Navigator 2.0","id":"为什么需要-navigator-2-0"},{"level":2,"text":"GoRouter 基础配置","id":"gorouter-基础配置"},{"level":2,"text":"导航操作","id":"导航操作"},{"level":2,"text":"类型安全路由（代码生成）","id":"类型安全路由-代码生成"},{"level":2,"text":"ShellRoute：底部导航栏实现","id":"shellroute-底部导航栏实现"},{"level":2,"text":"深度链接配置","id":"深度链接配置"},{"level":3,"text":"Android 配置（AndroidManifest.xml）","id":"android-配置-androidmanifest-xml"},{"level":3,"text":"iOS 配置（Info.plist）","id":"ios-配置-info-plist"},{"level":2,"text":"路由状态与 Riverpod 集成","id":"路由状态与-riverpod-集成"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"相关文档","id":"相关文档"}],"prev":{"title":"Clean Architecture 在 Flutter 中的实践","url":"/l-doc-books/h/mobile/flutter-development/architecture/clean-architecture-flutter"},"next":{"title":"自定义 RenderObject：布局与绘制的底层控制","url":"/l-doc-books/h/mobile/flutter-development/advanced/custom-render-objects"}}