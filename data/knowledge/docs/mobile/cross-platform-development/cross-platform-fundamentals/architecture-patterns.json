er\" data-lang=\"typescript\" data-code=\"declare global {&#10;  function nativeMultiply(a: number, b: number): number;&#10;}&#10;&#10;const result = nativeMultiply(3, 7);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">declare</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> global {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> nativeMultiply</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> nativeMultiply</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h3 id=\"桥接开销对比\">桥接开销对比</h3><table>\n<thead>\n<tr>\n<th>通信方式</th>\n<th>序列化方式</th>\n<th>单次调用耗时</th>\n<th>批量效率</th>\n<th>代表框架</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>JSON Bridge</td>\n<td>JSON 序列化/反序列化</td>\n<td>~1ms</td>\n<td>低（逐条处理）</td>\n<td>RN 旧架构</td>\n</tr>\n<tr>\n<td>JSI</td>\n<td>C++ 直接绑定</td>\n<td>~0.01ms</td>\n<td>高（零拷贝）</td>\n<td>RN 新架构</td>\n</tr>\n<tr>\n<td>MessageChannel</td>\n<td>结构化克隆</td>\n<td>~0.5ms</td>\n<td>中</td>\n<td>Lynx</td>\n</tr>\n<tr>\n<td>FFI</td>\n<td>二进制调用</td>\n<td>~0.001ms</td>\n<td>极高</td>\n<td>KMP</td>\n</tr>\n</tbody></table>\n<h2 id=\"自渲染模式\">自渲染模式</h2><p>自渲染模式绕过了平台原生组件，由框架自带的图形引擎直接在 Canvas/Surface 上绘制所有 UI 元素。Flutter 是此模式的标杆，其底层渲染引擎从 Skia 演进到 Impeller。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph Flutter 渲染管线&#10;        A[Widget Tree] --&gt; B[Element Tree]&#10;        B --&gt; C[RenderObject Tree]&#10;        C --&gt; D[Layer Tree]&#10;        D --&gt; E[Skia / Impeller]&#10;        E --&gt; F[GPU 光栅化]&#10;        F --&gt; G[屏幕像素]&#10;    end\">graph TB\n    subgraph Flutter 渲染管线\n        A[Widget Tree] --&gt; B[Element Tree]\n        B --&gt; C[RenderObject Tree]\n        C --&gt; D[Layer Tree]\n        D --&gt; E[Skia / Impeller]\n        E --&gt; F[GPU 光栅化]\n        F --&gt; G[屏幕像素]\n    end</pre><h3 id=\"flutter-自绘渲染\">Flutter 自绘渲染</h3><div class=\"code-block-wrapper\" data-lang=\"dart\" data-code=\"import &#39;package:flutter/material.dart&#39;;&#10;&#10;class CustomPainterDemo extends StatelessWidget {&#10;  @override&#10;  Widget build(BuildContext context) {&#10;    return CustomPaint(&#10;      size: const Size(300, 300),&#10;      painter: ChartPainter(),&#10;    );&#10;  }&#10;}&#10;&#10;class ChartPainter extends CustomPainter {&#10;  @override&#10;  void paint(Canvas canvas, Size size) {&#10;    final paint = Paint()&#10;      ..color = Colors.blue&#10;      ..strokeWidth = 2.0&#10;      ..style = PaintingStyle.stroke;&#10;&#10;    final path = Path();&#10;    final points = [&#10;      Offset(0, size.height * 0.8),&#10;      Offset(size.width * 0.25, size.height * 0.4),&#10;      Offset(size.width * 0.5, size.height * 0.6),&#10;      Offset(size.width * 0.75, size.height * 0.2),&#10;      Offset(size.width, size.height * 0.3),&#10;    ];&#10;&#10;    path.moveTo(points[0].dx, points[0].dy);&#10;    for (var i = 1; i &lt; points.length; i++) {&#10;      path.lineTo(points[i].dx, points[i].dy);&#10;    }&#10;    canvas.drawPath(path, paint);&#10;&#10;    final dotPaint = Paint()..color = Colors.red;&#10;    for (final point in points) {&#10;      canvas.drawCircle(point, 4, dotPaint);&#10;    }&#10;  }&#10;&#10;  @override&#10;  bool shouldRepaint(covariant CustomPainter oldDelegate) =&gt; false;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>import 'package:flutter/material.dart';</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>class CustomPainterDemo extends StatelessWidget {</span></span>\n<span class=\"line\"><span>  @override</span></span>\n<span class=\"line\"><span>  Widget build(BuildContext context) {</span></span>\n<span class=\"line\"><span>    return CustomPaint(</span></span>\n<span class=\"line\"><span>      size: const Size(300, 300),</span></span>\n<span class=\"line\"><span>      painter: ChartPainter(),</span></span>\n<span class=\"line\"><span>    );</span></span>\n<span class=\"line\"><span>  }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>class ChartPainter extends CustomPainter {</span></span>\n<span class=\"line\"><span>  @override</span></span>\n<span class=\"line\"><span>  void paint(Canvas canvas, Size size) {</span></span>\n<span class=\"line\"><span>    final paint = Paint()</span></span>\n<span class=\"line\"><span>      ..color = Colors.blue</span></span>\n<span class=\"line\"><span>      ..strokeWidth = 2.0</span></span>\n<span class=\"line\"><span>      ..style = PaintingStyle.stroke;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    final path = Path();</span></span>\n<span class=\"line\"><span>    final points = [</span></span>\n<span class=\"line\"><span>      Offset(0, size.height * 0.8),</span></span>\n<span class=\"line\"><span>      Offset(size.width * 0.25, size.height * 0.4),</span></span>\n<span class=\"line\"><span>      Offset(size.width * 0.5, size.height * 0.6),</span></span>\n<span class=\"line\"><span>      Offset(size.width * 0.75, size.height * 0.2),</span></span>\n<span class=\"line\"><span>      Offset(size.width, size.height * 0.3),</span></span>\n<span class=\"line\"><span>    ];</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    path.moveTo(points[0].dx, points[0].dy);</span></span>\n<span class=\"line\"><span>    for (var i = 1; i &#x3C; points.length; i++) {</span></span>\n<span class=\"line\"><span>      path.lineTo(points[i].dx, points[i].dy);</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>    canvas.drawPath(path, paint);</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    final dotPaint = Paint()..color = Colors.red;</span></span>\n<span class=\"line\"><span>    for (final point in points) {</span></span>\n<span class=\"line\"><span>      canvas.drawCircle(point, 4, dotPaint);</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>  }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>  @override</span></span>\n<span class=\"line\"><span>  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h3 id=\"skia-与-impeller-对比\">Skia 与 Impeller 对比</h3><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Skia</th>\n<th>Impeller</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>编译策略</td>\n<td>运行时编译着色器</td>\n<td>预编译所有着色器</td>\n</tr>\n<tr>\n<td>首帧性能</td>\n<td>首次绘制可能卡顿（shader jank）</td>\n<td>首帧即流畅</td>\n</tr>\n<tr>\n<td>GPU 利用</td>\n<td>通用化处理，未深度优化</td>\n<td>针对移动 GPU 深度优化</td>\n</tr>\n<tr>\n<td>平台支持</td>\n<td>全平台</td>\n<td>iOS 已默认，Android 逐步推进</td>\n</tr>\n<tr>\n<td>文字渲染</td>\n<td>成熟稳定</td>\n<td>持续优化中</td>\n</tr>\n</tbody></table>\n<h2 id=\"编译转换模式\">编译转换模式</h2><p>编译转换模式将一种高级语言编译为各平台的原生代码或中间产物。Kotlin Multiplatform（KMP）是该模式的代表——共享的 Kotlin 代码被编译为 JVM 字节码（Android）、LLVM 原生代码（iOS）和 JavaScript（Web）。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    A[Kotlin 共享代码] --&gt; B{Kotlin 编译器}&#10;    B --&gt;|JVM Backend| C[Android .class]&#10;    B --&gt;|Native Backend| D[iOS .framework]&#10;    B --&gt;|JS Backend| E[Web .js]&#10;    B --&gt;|Wasm Backend| F[WebAssembly .wasm]\">graph TB\n    A[Kotlin 共享代码] --&gt; B{Kotlin 编译器}\n    B --&gt;|JVM Backend| C[Android .class]\n    B --&gt;|Native Backend| D[iOS .framework]\n    B --&gt;|JS Backend| E[Web .js]\n    B --&gt;|Wasm Backend| F[WebAssembly .wasm]</pre><h3 id=\"kotlin-multiplatform-示例\">Kotlin Multiplatform 示例</h3><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// commonMain - 共享业务逻辑&#10;expect class PlatformInfo() {&#10;    val name: String&#10;    val version: String&#10;}&#10;&#10;class UserRepository(private val api: ApiClient) {&#10;    suspend fun getUser(id: String): User {&#10;        return api.get(&quot;/users/$id&quot;)&#10;    }&#10;&#10;    suspend fun updateProfile(user: User): Result&lt;User&gt; {&#10;        return runCatching {&#10;            api.put(&quot;/users/${user.id}&quot;, user)&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// commonMain - 共享业务逻辑</span></span>\n<span class=\"line\"><span>expect class PlatformInfo() {</span></span>\n<span class=\"line\"><span>    val name: String</span></span>\n<span class=\"line\"><span>    val version: String</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>class UserRepository(private val api: ApiClient) {</span></span>\n<span class=\"line\"><span>    suspend fun getUser(id: String): User {</span></span>\n<span class=\"line\"><span>        return api.get(\"/users/$id\")</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    suspend fun updateProfile(user: User): Result&#x3C;User> {</span></span>\n<span class=\"line\"><span>        return runCatching {</span></span>\n<span class=\"line\"><span>            api.put(\"/users/${user.id}\", user)</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// androidMain&#10;actual class PlatformInfo actual constructor() {&#10;    actual val name: String = &quot;Android&quot;&#10;    actual val version: String = android.os.Build.VERSION.RELEASE&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// androidMain</span></span>\n<span class=\"line\"><span>actual class PlatformInfo actual constructor() {</span></span>\n<span class=\"line\"><span>    actual val name: String = \"Android\"</span></span>\n<span class=\"line\"><span>    actual val version: String = android.os.Build.VERSION.RELEASE</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// iOS 侧调用 KMP 产物&#10;import shared&#10;&#10;let repo = UserRepository(api: ApiClient())&#10;let user = try await repo.getUser(id: &quot;123&quot;)&#10;print(user.name)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// iOS 侧调用 KMP 产物</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> shared</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> repo </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UserRepository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">api</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ApiClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> user </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> repo.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">getUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"123\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user.name)</span></span></code></pre></div><h2 id=\"架构选型决策树\">架构选型决策树</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    Start[项目启动] --&gt; Q1{性能要求?}&#10;    Q1 --&gt;|极致性能| Q2{团队技术栈?}&#10;    Q1 --&gt;|一般性能| Q3{开发周期?}&#10;    Q1 --&gt;|简单展示| B1[Web 容器模式]&#10;&#10;    Q2 --&gt;|Dart 可接受| D1[Flutter 自渲染]&#10;    Q2 --&gt;|偏好 JS/TS| Q4{是否需要原生体验?}&#10;    Q2 --&gt;|Kotlin/Swift| E1[KMP 编译转换]&#10;&#10;    Q4 --&gt;|是| C1[RN 新架构 / Lynx]&#10;    Q4 --&gt;|否| D1&#10;&#10;    Q3 --&gt;|紧急 MVP| B1&#10;    Q3 --&gt;|正常迭代| Q5{目标平台?}&#10;&#10;    Q5 --&gt;|仅移动端| C1&#10;    Q5 --&gt;|移动 + Web| Q6{UI 一致性要求?}&#10;    Q5 --&gt;|移动 + 桌面| D1&#10;&#10;    Q6 --&gt;|高一致性| D1&#10;    Q6 --&gt;|平台原生感| C1\">graph TD\n    Start[项目启动] --&gt; Q1{性能要求?}\n    Q1 --&gt;|极致性能| Q2{团队技术栈?}\n    Q1 --&gt;|一般性能| Q3{开发周期?}\n    Q1 --&gt;|简单展示| B1[Web 容器模式]\n\n    Q2 --&gt;|Dart 可接受| D1[Flutter 自渲染]\n    Q2 --&gt;|偏好 JS/TS| Q4{是否需要原生体验?}\n    Q2 --&gt;|Kotlin/Swift| E1[KMP 编译转换]\n\n    Q4 --&gt;|是| C1[RN 新架构 / Lynx]\n    Q4 --&gt;|否| D1\n\n    Q3 --&gt;|紧急 MVP| B1\n    Q3 --&gt;|正常迭代| Q5{目标平台?}\n\n    Q5 --&gt;|仅移动端| C1\n    Q5 --&gt;|移动 + Web| Q6{UI 一致性要求?}\n    Q5 --&gt;|移动 + 桌面| D1\n\n    Q6 --&gt;|高一致性| D1\n    Q6 --&gt;|平台原生感| C1</pre><h3 id=\"选型评分矩阵\">选型评分矩阵</h3><table>\n<thead>\n<tr>\n<th>评估维度</th>\n<th>Web 容器</th>\n<th>桥接</th>\n<th>自渲染</th>\n<th>编译转换</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>开发效率</td>\n<td>9</td>\n<td>8</td>\n<td>7</td>\n<td>6</td>\n</tr>\n<tr>\n<td>运行性能</td>\n<td>4</td>\n<td>7</td>\n<td>9</td>\n<td>9</td>\n</tr>\n<tr>\n<td>UI 一致性</td>\n<td>9</td>\n<td>5</td>\n<td>10</td>\n<td>5</td>\n</tr>\n<tr>\n<td>原生体验</td>\n<td>3</td>\n<td>8</td>\n<td>6</td>\n<td>9</td>\n</tr>\n<tr>\n<td>生态成熟度</td>\n<td>8</td>\n<td>9</td>\n<td>8</td>\n<td>6</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>2</td>\n<td>4</td>\n<td>6</td>\n<td>7</td>\n</tr>\n<tr>\n<td>包体积</td>\n<td>3</td>\n<td>6</td>\n<td>7</td>\n<td>8</td>\n</tr>\n<tr>\n<td>热更新</td>\n<td>10</td>\n<td>8</td>\n<td>3</td>\n<td>2</td>\n</tr>\n</tbody></table>\n<h2 id=\"混合架构实践\">混合架构实践</h2><p>真实的大型应用往往不会只用一种模式。以字节跳动为例，抖音同时使用了 Lynx（桥接）渲染动态化页面、Flutter（自渲染）承载特定模块、WebView（Web 容器）加载运营活动页。混合架构的关键在于定义清晰的边界：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TB&#10;    subgraph 混合架构&#10;        A[原生壳工程] --&gt; B[核心体验页 - 原生]&#10;        A --&gt; C[动态业务页 - Lynx/RN]&#10;        A --&gt; D[运营活动页 - WebView]&#10;        A --&gt; E[独立模块 - Flutter]&#10;    end&#10;&#10;    subgraph 路由层&#10;        F[统一路由] --&gt; B&#10;        F --&gt; C&#10;        F --&gt; D&#10;        F --&gt; E&#10;    end\">graph TB\n    subgraph 混合架构\n        A[原生壳工程] --&gt; B[核心体验页 - 原生]\n        A --&gt; C[动态业务页 - Lynx/RN]\n        A --&gt; D[运营活动页 - WebView]\n        A --&gt; E[独立模块 - Flutter]\n    end\n\n    subgraph 路由层\n        F[统一路由] --&gt; B\n        F --&gt; C\n        F --&gt; D\n        F --&gt; E\n    end</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface RouteConfig {&#10;  path: string;&#10;  type: &#39;native&#39; | &#39;lynx&#39; | &#39;webview&#39; | &#39;flutter&#39;;&#10;  module: string;&#10;  fallback?: string;&#10;  preload?: boolean;&#10;}&#10;&#10;const routes: RouteConfig[] = [&#10;  { path: &#39;/home&#39;, type: &#39;native&#39;, module: &#39;HomeModule&#39; },&#10;  { path: &#39;/feed&#39;, type: &#39;lynx&#39;, module: &#39;feed_card&#39;, preload: true },&#10;  { path: &#39;/campaign/*&#39;, type: &#39;webview&#39;, module: &#39;https://m.example.com/campaign&#39; },&#10;  { path: &#39;/editor&#39;, type: &#39;flutter&#39;, module: &#39;video_editor&#39;, fallback: &#39;/editor-lite&#39; },&#10;];&#10;&#10;function resolveRoute(path: string): RouteConfig | undefined {&#10;  return routes.find((r) =&gt; {&#10;    if (r.path.endsWith(&#39;*&#39;)) {&#10;      return path.startsWith(r.path.slice(0, -1));&#10;    }&#10;    return r.path === path;&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RouteConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  path</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  type</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'native'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'lynx'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'webview'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'flutter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  module</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  fallback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">