/span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">delay</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">debouncedValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setDebouncedValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(value);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  useEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> timer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setDebouncedValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(value), delay);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> clearTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }, [value, delay]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> debouncedValue;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在组件中使用</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SearchScreen</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> orientation</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useOrientation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">setQuery</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> debouncedQuery</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useDebounce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // debouncedQuery 变化时才触发搜索请求</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useSearchResults</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(debouncedQuery);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* ... */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>模式</th>\n<th>适用场景</th>\n<th>优势</th>\n<th>注意事项</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>自定义 Hooks</td>\n<td>有状态逻辑复用</td>\n<td>不增加组件层级、类型推断好</td>\n<td>只能在函数组件中使用</td>\n</tr>\n<tr>\n<td>复合组件</td>\n<td>相关组件的统一 API</td>\n<td>调用侧简洁、内部灵活</td>\n<td>需要 Context，避免过度使用</td>\n</tr>\n<tr>\n<td>Render Props</td>\n<td>行为与 UI 解耦</td>\n<td>非常灵活</td>\n<td>嵌套深时可读性差</td>\n</tr>\n<tr>\n<td>HOC</td>\n<td>横切关注点（如权限检查）</td>\n<td>可包裹任意组件</td>\n<td>类型推断复杂，不推荐新代码使用</td>\n</tr>\n</tbody></table>\n<h2 id=\"样式系统-stylesheet-vs-内联样式-vs-样式库\">样式系统：StyleSheet vs 内联样式 vs 样式库</h2><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// ✅ StyleSheet.create——推荐方式&#10;const styles = StyleSheet.create({&#10;  container: {&#10;    flex: 1,&#10;    backgroundColor: &#39;#fff&#39;,&#10;    padding: 16,&#10;  },&#10;  title: {&#10;    fontSize: 20,&#10;    fontWeight: &#39;700&#39;,&#10;    color: &#39;#1a1a1a&#39;,&#10;  },&#10;});&#10;&#10;// ❌ 内联样式——每次渲染创建新对象，在列表中会导致不必要的重渲染&#10;&lt;View style={{ flex: 1, padding: 16 }}&gt;&#10;&#10;// ✅ 动态样式的正确写法——静态部分用 StyleSheet，动态部分用数组合并&#10;&lt;View style={[styles.container, isSelected &amp;&amp; styles.selected]}&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ StyleSheet.create——推荐方式</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> styles</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StyleSheet.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  container: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    flex: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    backgroundColor: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'#fff'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    padding: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  title: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fontSize: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    fontWeight: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'700'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    color: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'#1a1a1a'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ❌ 内联样式——每次渲染创建新对象，在列表中会导致不必要的重渲染</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">View style</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">padding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ 动态样式的正确写法——静态部分用 StyleSheet，动态部分用数组合并</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">View style</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{[styles.container, isSelected </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> styles.selected]}></span></span></code></pre></div><p><strong>NativeWind / Tailwind for React Native</strong>：基于 Tailwind CSS 的 React Native 样式方案，NativeWind 2.x/3.x 将 Tailwind 类名编译为 StyleSheet 对象，开发效率高且与 Web 共享样式约定：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { View, Text } from &#39;react-native&#39;;&#10;&#10;function Card() {&#10;  return (&#10;    &lt;View className=&quot;flex-1 bg-white p-4 rounded-xl shadow-sm&quot;&gt;&#10;      &lt;Text className=&quot;text-xl font-bold text-gray-900&quot;&gt;标题&lt;/Text&gt;&#10;    &lt;/View&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { View, Text } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'react-native'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Card</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">View className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"flex-1 bg-white p-4 rounded-xl shadow-sm\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Text className</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"text-xl font-bold text-gray-900\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">标题</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">View</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关于如何在不同章节页面之间导航并传递参数，参见 <a href=\"navigation-routing\">导航与路由体系</a>。</p>\n<h2 id=\"小结\">小结</h2><p>React Native 的组件设计哲学与 Web React 高度一致，但有几个移动端特有的约束需要牢记：触摸目标的最小尺寸（44×44 点）影响交互设计；列表性能对用户体验的影响比 Web 更直接（滚动卡顿在移动端非常明显）；<code>StyleSheet.create</code> 不只是代码风格，而是有实际性能含义的 API。</p>\n<p>在复用策略上，自定义 Hooks 是首选，它在提供最大灵活性的同时保持了最好的类型安全和可测试性。复合组件模式适合需要统一 API 的相关组件族。避免在新代码中使用 HOC——React 19 的 Hooks 生态已经完全覆盖了 HOC 的使用场景，且类型推断更好。</p>\n","headings":[{"level":1,"text":"React Native 组件模式与复用策略","id":"react-native-组件模式与复用策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"组件结构：容器与展示的分离","id":"组件结构-容器与展示的分离"},{"level":2,"text":"列表渲染：高性能策略","id":"列表渲染-高性能策略"},{"level":2,"text":"自定义 Hooks：逻辑复用的首选方式","id":"自定义-hooks-逻辑复用的首选方式"},{"level":2,"text":"样式系统：StyleSheet vs 内联样式 vs 样式库","id":"样式系统-stylesheet-vs-内联样式-vs-样式库"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"JavaScript 与原生边界：线程模型、类型系统与 Codegen","url":"/l-doc-books/h/mobile/react-native-development/foundations/javascript-native-boundary"},"next":{"title":"React Navigation：导航与路由体系","url":"/l-doc-books/h/mobile/react-native-development/core-development/navigation-routing"}}