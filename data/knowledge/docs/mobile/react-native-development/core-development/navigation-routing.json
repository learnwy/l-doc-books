lor:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Stack.Screen name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"MainTabs\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> component</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{HomeTabs} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* Modal 覆盖在 Tab 之上 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Stack.Screen</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ImageViewer\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        component</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{ImageViewerScreen}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        options</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">presentation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'fullScreenModal'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      /></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Stack.Navigator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> App</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NavigationContainer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">RootNavigator </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">NavigationContainer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"类型安全的路由参数\">类型安全的路由参数</h2><p>React Navigation 6 通过泛型参数支持完整的 TypeScript 类型检查，是生产应用的必备配置：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 定义路由参数类型&#10;export type RootStackParamList = {&#10;  Home: undefined;          // 无参数&#10;  UserProfile: { userId: string; fromNotification?: boolean };&#10;  PhotoViewer: { photos: string[]; initialIndex: number };&#10;};&#10;&#10;export type TabParamList = {&#10;  Feed: undefined;&#10;  Search: { initialQuery?: string };&#10;  Notifications: undefined;&#10;  Profile: undefined;&#10;};&#10;&#10;// 在组件中使用——完整类型推断&#10;import type { NativeStackScreenProps } from &#39;@react-navigation/native-stack&#39;;&#10;&#10;type Props = NativeStackScreenProps&lt;RootStackParamList, &#39;UserProfile&#39;&gt;;&#10;&#10;function UserProfileScreen({ route, navigation }: Props) {&#10;  const { userId, fromNotification } = route.params;&#10;  // userId: string，fromNotification: boolean | undefined——类型安全&#10;&#10;  return (&#10;    &lt;View&gt;&#10;      &lt;Button&#10;        title=&quot;返回&quot;&#10;        onPress={() =&gt; navigation.goBack()}&#10;      /&gt;&#10;    &lt;/View&gt;&#10;  );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 定义路由参数类型</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RootStackParamList</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  Home</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> undefined</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;          </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 无参数</span></