           let ekEvent = EKEvent(eventStore: self.eventStore)&#10;            ekEvent.title = event[&quot;title&quot;] as? String ?? &quot;&quot;&#10;            // 设置其他属性...&#10;            do {&#10;                try self.eventStore.save(ekEvent, span: .thisEvent)&#10;                resolve(ekEvent.eventIdentifier)&#10;            } catch {&#10;                reject(&quot;CREATE_FAILED&quot;, error.localizedDescription, error)&#10;            }&#10;        }&#10;    }&#10;&#10;    // 事件发射器必须的两个方法&#10;    func addListener(_ eventType: String) {}&#10;    func removeListeners(_ count: Double) {}&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// RNCalendar.swift</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EventKit</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@objc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">RNCalendar</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RNCalendar</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NSObject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NativeCalendarSpec </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><sp