olor:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useSafeAreaInsets</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">View style</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">paddingBottom</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: insets.bottom }}</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      {</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* 底部内容不会被 Home Indicator 遮挡 */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">View</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>顶部状态栏安全区</td>\n<td><code>SafeAreaView</code> 或 <code>useSafeAreaInsets().top</code></td>\n</tr>\n<tr>\n<td>底部 Home Indicator</td>\n<td><code>useSafeAreaInsets().bottom</code></td>\n</tr>\n<tr>\n<td>键盘遮挡输入框</td>\n<td><code>KeyboardAvoidingView</code> + <code>Platform.select</code> 配置</td>\n</tr>\n<tr>\n<td>横竖屏适配</td>\n<td><code>Dimensions.addEventListener</code> + <code>useOrientation</code> hook</td>\n</tr>\n<tr>\n<td>平板适配</td>\n<td><code>Platform.isPad</code>（iOS）+ 屏幕宽度断点</td>\n</tr>\n</tbody></table>\n<h2 id=\"条件化权限请求\">条件化权限请求</h2><p>iOS 和 Android 的权限模型有根本差异：iOS 权限一旦拒绝无法通过代码重新请求（只能引导用户去系统设置），Android 可以多次请求并提供 rationale 说明：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { PermissionsAndroid, Platform, Linking } from &#39;react-native&#39;;&#10;import { check, request, PERMISSIONS, RESULTS } from &#39;react-native-permissions&#39;;&#10;&#10;async function requestCameraPermission(): Promise&lt;boolean&gt; {&#10;  if (Platform.OS === &#39;ios&#39;) {&#10;    const result = await check(PERMISSIONS.IOS.CAMERA);&#10;    if (result === RESULTS.GRANTED) return true;&#10;    if (result === RESULTS.DENIED) {&#10;      const requestResult = await request(PERMISSIONS.IOS.CAMERA);&#10;      return requestResult === RESULTS.GRANTED;&#10;    }&#10;    // BLOCKED 状态——引导用户去系统设置&#10;    await Linking.openURL(&#39;app-settings:&#39;);&#10;    return false;&#10;  } else {&#10;    const result = await PermissionsAndroid.request(PermissionsAndroid.PERMISSIONS.CAMERA, {&#10;      title: &#39;需要相机权限&#39;,&#10;      message: &#39;拍照功能需要访问您的相机&#39;,&#10;      buttonPositive: &#39;允许&#39;,&#10;      buttonNegative: &#39;拒绝&#39;,&#10;    });&#10;    return result === PermissionsAndroid.RESULTS.GRANTED;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { PermissionsAndroid, Platform, Linking } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'react-native'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { check, request, PERMISSIONS, RESULTS } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'react-native-permissions'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> requestCameraPermission</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Platform.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">OS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ios'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> check</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">PERMISSIONS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">IOS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">CAMERA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RESULTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">GRANTED</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RESULTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DENIED</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> requestResult</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">PERMISSIONS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">IOS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">CAMERA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requestResult </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RESULTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">GRANTED</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // BLOCKED 状态——引导用户去系统设置</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Linking.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">openURL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'app-settings:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PermissionsAndroid.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(PermissionsAndroid.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">PERMISSIONS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">CAMERA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'需要相机权限'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      message: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'拍照功能需要访问您的相机'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      buttonPositive: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'允许'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      buttonNegative: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'拒绝'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> PermissionsAndroid.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">RESULTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">GRANTED</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关于如何测试平台特定代码（包括 mock Platform API），参见 <a href=\"../production-engineering/testing-quality\">测试与质量保障</a>。</p>\n<h2 id=\"小结\">小结</h2><p>平台特定代码策略的核心原则是<strong>按差异程度选择最小化分离粒度</strong>：能用 <code>Platform.select()</code> 一行解决的样式差异，不要拆成两个文件；需要完全不同实现的 UI 场景，用平台文件扩展名做彻底分离，保持业务逻辑层平台无关。</p>\n<p>Safe Area 处理是 React Native 应用视觉质量的基础要求，尤其是 iOS 的 Dynamic Island 和 Android 的各种导航模式，忽略 Safe Area 会让应用在新设备上看起来粗糙。权限模型的差异是另一个高频陷阱——iOS 的&quot;一次性拒绝即永久拒绝&quot;特性要求在请求权限之前做好用户引导，不能在没有说明的情况下直接弹出系统权限对话框。</p>\n","headings":[{"level":1,"text":"React Native 平台特定代码策略","id":"react-native-平台特定代码策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"三种平台特定代码策略","id":"三种平台特定代码策略"},{"level":3,"text":"策略一：Platform.select() 处理样式差异","id":"策略一-platform-select-处理样式差异"},{"level":3,"text":"策略二：Platform.OS 条件渲染处理行为差异","id":"策略二-platform-os-条件渲染处理行为差异"},{"level":3,"text":"策略三：平台文件扩展名处理 UI 完全不同的场景","id":"策略三-平台文件扩展名处理-ui-完全不同的场景"},{"level":2,"text":"Safe Area 与屏幕适配","id":"safe-area-与屏幕适配"},{"level":2,"text":"条件化权限请求","id":"条件化权限请求"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Turbo Modules 与 Fabric：新架构原生集成规范","url":"/l-doc-books/h/mobile/react-native-development/native-integration/turbo-modules-fabric"},"next":{"title":"React Native 性能优化与调优","url":"/l-doc-books/h/mobile/react-native-development/production-engineering/performance-optimization"}}