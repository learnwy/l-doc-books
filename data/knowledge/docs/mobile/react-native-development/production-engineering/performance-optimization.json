9;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> useAnimatedStyle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    transform: [{ scale: scale.value }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    &#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Animated.View</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      style</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{[styles.card, animatedStyle]}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      onTouchStart={() => { scale.value = withSpring(0.95); }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      onTouchEnd={() => { scale.value = withSpring(1); }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    /></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>useNativeDriver: true</code> 对 <code>opacity</code>、<code>transform</code> 等属性有效；<code>useNativeDriver</code> 不支持 <code>width</code>、<code>height</code>、<code>position</code> 等会影响布局的属性。对于需要高帧率手势驱动动画，Reanimated 3 是首选。</p>\n<h2 id=\"内存优化\">内存优化</h2><p>React Native 应用的内存问题往往来自两个来源：大型未释放的 JavaScript 对象（事件监听器未清理）和原生层的图片内存：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// ✅ 确保 useEffect 的 cleanup 清理所有订阅&#10;useEffect(() =&gt; {&#10;  const subscription = someNativeEmitter.addListener(&#39;event&#39;, handler);&#10;  const appStateSubscription = AppState.addEventListener(&#39;change&#39;, handleAppState);&#10;  const networkSubscription = NetInfo.addEventListener(handleNetworkChange);&#10;&#10;  return () =&gt; {&#10;    subscription.remove();&#10;    appStateSubscription.remove();&#10;    networkSubscription();&#10;  };&#10;}, []);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ 确保 useEffect 的 cleanup 清理所有订阅</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">useEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> subscription</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> someNativeEmitter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addListener</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'event'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, handler);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> appStateSubscription</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> AppState.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addEventListener</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'change'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, handleAppState);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> networkSubscription</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NetInfo.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addEventListener</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(handleNetworkChange);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    subscription.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">remove</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    appStateSubscription.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">remove</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    networkSubscription</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}, []);</span></span></code></pre></div><p>关于如何对性能优化结果进行量化测试，参见 <a href=\"testing-quality\">测试与质量保障</a>。</p>\n<h2 id=\"小结\">小结</h2><p>React Native 性能优化的核心方法论是：<strong>先测量，再优化，最后验证</strong>。未经分析就盲目添加 <code>memo</code>、<code>useCallback</code> 会增加代码复杂度而不解决真实问题——因为大多数 React Native 性能问题不是&quot;渲染次数多&quot;，而是&quot;某几次渲染耗时过长&quot;。</p>\n<p>按照优化优先级排序：启动性能（TTI 直接影响留存率）&gt; 滚动帧率（用户最直接感知）&gt; 内存使用（影响低端设备稳定性）&gt; 单次操作响应时间。每个优化步骤都应该用 Performance Panel 的前后对比来验证效果，而不是依赖主观感受。</p>\n<p>动画性能是另一个高优先级领域——所有应该在 UI 线程运行的动画必须正确使用 <code>useNativeDriver: true</code> 或 Reanimated 3，让 JS 线程的负载不影响动画帧率。</p>\n","headings":[{"level":1,"text":"React Native 性能优化与调优","id":"react-native-性能优化与调优"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"性能分析：定位瓶颈的正确顺序","id":"性能分析-定位瓶颈的正确顺序"},{"level":2,"text":"JavaScript 层优化","id":"javascript-层优化"},{"level":3,"text":"React 渲染优化","id":"react-渲染优化"},{"level":3,"text":"启动时间优化","id":"启动时间优化"},{"level":2,"text":"原生层优化","id":"原生层优化"},{"level":3,"text":"减少原生视图层级","id":"减少原生视图层级"},{"level":3,"text":"图片优化","id":"图片优化"},{"level":3,"text":"动画性能","id":"动画性能"},{"level":2,"text":"内存优化","id":"内存优化"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"React Native 平台特定代码策略","url":"/l-doc-books/h/mobile/react-native-development/native-integration/platform-specific-code"},"next":{"title":"React Native 测试与质量保障","url":"/l-doc-books/h/mobile/react-native-development/production-engineering/testing-quality"}}