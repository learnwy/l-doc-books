th</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">java-version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'17'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">distribution</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'temurin'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">./gradlew :shared:testDebugUnitTest</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">./gradlew :androidApp:connectedAndroidTest</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 需 emulator</span></span></code></pre></div><h2 id=\"构建缓存与加速\">构建缓存与加速</h2><table>\n<thead>\n<tr>\n<th>优化手段</th>\n<th>效果</th>\n<th>配置方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Gradle Build Cache</td>\n<td>跨 CI 复用</td>\n<td><code>org.gradle.caching=true</code> + remote cache</td>\n</tr>\n<tr>\n<td>Kotlin daemon</td>\n<td>进程复用</td>\n<td>默认启用</td>\n</tr>\n<tr>\n<td>并行编译</td>\n<td>多模块并行</td>\n<td><code>org.gradle.parallel=true</code></td>\n</tr>\n<tr>\n<td>按需配置</td>\n<td>跳过无关模块</td>\n<td><code>org.gradle.configureondemand=true</code></td>\n</tr>\n<tr>\n<td>iOS 增量编译</td>\n<td>只编译变化</td>\n<td>默认（Kotlin 2.3+）</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>测试金字塔：80% commonTest（快速、跨平台验证）+ 15% 平台集成 + 5% UI 测试</li>\n<li><code>runTest</code> 和 <code>TestDispatcher</code> 提供协程测试的确定性控制</li>\n<li>Compose UI Test v2 支持跨平台 UI 断言</li>\n<li>CI 流水线将 JVM 测试作为最快反馈环，iOS 测试需要 macOS runner</li>\n<li>构建缓存和并行编译是控制 CI 耗时的关键</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"kotlin-toolchain-build\">Kotlin Toolchain 与构建配置</a>——CI 中的构建系统配置</li>\n<li><a href=\"ios-integration-xcode\">iOS 集成与 Xcode 互操作</a>——iOS 测试的 Xcode 配置</li>\n<li><a href=\"../android-development/testing/unit-testing\">Android 开发：单元测试</a>——Android 端测试的深入实践</li>\n</ul>\n","headings":[{"level":1,"text":"测试策略与持续集成","id":"测试策略与持续集成"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"commonTest 编写模式","id":"commontest-编写模式"},{"level":2,"text":"协程测试","id":"协程测试"},{"level":2,"text":"平台特定测试","id":"平台特定测试"},{"level":2,"text":"Compose UI 测试","id":"compose-ui-测试"},{"level":2,"text":"CI/CD 流水线设计","id":"ci-cd-流水线设计"},{"level":2,"text":"构建缓存与加速","id":"构建缓存与加速"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"iOS 集成与 Xcode 互操作","url":"/l-doc-books/h/mobile/kotlin-multiplatform/engineering/ios-integration-xcode"},"next":null}