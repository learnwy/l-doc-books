#032F62;--shiki-dark:#9ECBFF\">'social'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  pagePath: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'pages/ChatPage'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  needLogin: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"构建与分发\">构建与分发</h2><table>\n<thead>\n<tr>\n<th>构建产物</th>\n<th>文件格式</th>\n<th>分发方式</th>\n<th>大小限制</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>App Bundle</td>\n<td>.app</td>\n<td>上传应用市场</td>\n<td>4GB</td>\n</tr>\n<tr>\n<td>单 HAP</td>\n<td>.hap</td>\n<td>调试安装</td>\n<td>—</td>\n</tr>\n<tr>\n<td>HSP</td>\n<td>包含在 HAP 中</td>\n<td>随 HAP 分发</td>\n<td>—</td>\n</tr>\n<tr>\n<td>HAR</td>\n<td>.har</td>\n<td>npm 仓库或本地</td>\n<td>—</td>\n</tr>\n</tbody></table>\n<h3 id=\"包体积优化策略\">包体积优化策略</h3><ol>\n<li><strong>资源分离</strong>：大图片、视频等资源放入 rawfile，支持按需下载</li>\n<li><strong>Tree Shaking</strong>：确保 HSP/HAR 导出粒度够细，编译器可消除未使用代码</li>\n<li><strong>延迟加载</strong>：非首屏功能放入 Feature HAP，首次使用时下载</li>\n<li><strong>共享提取</strong>：多模块公共代码提取为 HSP，避免 HAR 重复打包</li>\n<li><strong>资源压缩</strong>：启用图片压缩和代码混淆</li>\n</ol>\n<h2 id=\"小结\">小结</h2><p>HarmonyOS 的模块化体系通过 HAP（分发单元）、HSP（共享单元）和 HAR（复用单元）三层设计，为应用提供了从代码组织到运行时加载的完整解决方案。合理的分包策略能显著改善安装体积、启动速度和团队协作效率。在实际项目中，建议以功能边界划分 Feature HAP，以复用频率决定 HSP 还是 HAR，并通过统一路由框架管理模块间的导航。</p>\n","headings":[{"level":1,"text":"模块化架构与 HAP/HSP 设计","id":"模块化架构与-hap-hsp-设计"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"模块类型对比","id":"模块类型对比"},{"level":3,"text":"选型决策树","id":"选型决策树"},{"level":2,"text":"工程目录结构","id":"工程目录结构"},{"level":2,"text":"HAP 分包策略","id":"hap-分包策略"},{"level":3,"text":"Entry HAP 设计原则","id":"entry-hap-设计原则"},{"level":3,"text":"Feature HAP 按需加载","id":"feature-hap-按需加载"},{"level":2,"text":"HSP 共享包开发","id":"hsp-共享包开发"},{"level":3,"text":"HSP 导出设计","id":"hsp-导出设计"},{"level":3,"text":"HSP 依赖配置","id":"hsp-依赖配置"},{"level":2,"text":"模块间路由设计","id":"模块间路由设计"},{"level":2,"text":"构建与分发","id":"构建与分发"},{"level":3,"text":"包体积优化策略","id":"包体积优化策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"进程间通信与 IPC 机制","url":"/l-doc-books/h/mobile/harmonyos-development/app-architecture/inter-process-communication"},"next":{"title":"分布式数据同步与管理","url":"/l-doc-books/h/mobile/harmonyos-development/distributed-capabilities/distributed-data-sync"}}