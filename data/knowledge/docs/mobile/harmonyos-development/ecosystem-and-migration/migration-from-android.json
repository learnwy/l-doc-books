ines(2)&#10;        Text(`¥${item.price}`).fontColor(&#39;#FF4444&#39;).fontSize(18)&#10;      }&#10;      .layoutWeight(1)&#10;      .margin({ left: 12 })&#10;      .alignItems(HorizontalAlign.Start)&#10;    }&#10;    .padding(12)&#10;    .width(&#39;100%&#39;)&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Android RecyclerView + ListAdapter 模式 → HarmonyOS List + LazyForEach</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 数据源（替代 ListAdapter 的 DiffUtil）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProductDataSource</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> implements</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> IDataSource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> items</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ProductInfo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> listeners</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DataChangeListener</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583