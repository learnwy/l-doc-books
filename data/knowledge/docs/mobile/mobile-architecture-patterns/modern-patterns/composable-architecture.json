ine\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        Scope</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: \\.home, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: \\.home) { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">HomeFeature</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        Scope</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: \\.search, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: \\.search) { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">SearchFeature</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        Scope</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">state</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: \\.profile, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">action</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: \\.profile) { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ProfileFeature</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"依赖管理-dependency-系统\">依赖管理：<code>@Dependency</code> 系统</h2><p>TCA 内建了轻量级依赖注入系统（基于 Swift TaskLocal），在测试时可以完全替换依赖而无需引入外部 DI 框架：</p>\n<table>\n<thead>\n<tr>\n<th>环境</th>\n<th>依赖行为</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Live</td>\n<td>真实实现（网络、数据库）</td>\n<td>生产环境</td>\n</tr>\n<tr>\n<td>Test</td>\n<td>未实现的依赖会触发 XCTFail</td>\n<td>确保测试覆盖所有依赖调用</td>\n</tr>\n<tr>\n<td>Preview</td>\n<td>返回假数据</td>\n<td>SwiftUI Preview</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// 声明依赖&#10;@DependencyClient&#10;struct APIClient: Sendable {&#10;    var fetchOrders: @Sendable () async throws -&gt; [Order]&#10;}&#10;&#10;// 在 Reducer 中使用&#10;@Reducer&#10;struct OrderFeature {&#10;    @Dependency(\\.apiClient) var apiClient&#10;&#10;    var body: some ReducerOf&lt;Self&gt; {&#10;        Reduce { state, action in&#10;            switch action {&#10;            case .loadOrders:&#10;                return .run { send in&#10;                    let orders = try await apiClient.fetchOrders()&#10;                    await send(.ordersLoaded(orders))&#10;                }&#10;            // ...&#10;            }&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 声明依赖</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@DependencyClient</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> APIClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Sendable </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fetchOrders: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">