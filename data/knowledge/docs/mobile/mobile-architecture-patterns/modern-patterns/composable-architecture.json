E;--shiki-dark:#E1E4E8\"> action {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .loadOrders</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { send </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orders </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> apiClient.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">fetchOrders</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                    await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ordersLoaded</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(orders))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">            // ...</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"测试-一等公民\">测试：一等公民</h2><p>TCA 的 <code>TestStore</code> 允许你断言<strong>每一步状态变化和 Effect 输出</strong>，实现比传统 ViewModel 测试更严格的验证：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"@Test&#10;func testIncrement() async {&#10;    let store = TestStore(initialState: CounterFeature.State()) {&#10;        CounterFeature()&#10;    }&#10;&#10;    await store.send(.increment) {&#10;        $0.count = 1  // 必须精确断言状态变化&#10;    }&#10;    await store.send(.increment) {&#10;        $0.count = 2&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">@Test</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> testIncrement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> store </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> TestStore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">initialState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: CounterFeature.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">State</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        CounterFeature</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> store.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.increment) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        $0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 必须精确断言状态变化</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> store.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">send</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.increment) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        $0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><code>TestStore</code> 强制你处理每一个 Effect 产生的 Action——如果 Reducer 返回了 Effect 但测试中没有 <code>receive</code>，测试会失败。这种<strong>穷举性验证</strong>是 TCA 测试能力远超普通 ViewModel 测试的原因。</p>\n<h2 id=\"swift-6-适配-并发安全\">Swift 6 适配：并发安全</h2><p>TCA 1.18.x 全面适配 Swift 6 严格并发：</p>\n<ul>\n<li>State 和 Action 标记 <code>Sendable</code></li>\n<li><code>@Reducer</code> 宏自动为生成的类型添加 <code>Sendable</code> 一致性</li>\n<li>Region-based isolation 消除了约 60% 的显式 <code>Sendable</code> 注解需求</li>\n<li>Effect 系统在 <code>@MainActor</code> 隔离下运行，保证 UI 更新安全</li>\n</ul>\n<div class=\"math-block\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>并发安全</mtext><mo>=</mo><mtext>编译期 Sendable 检查</mtext><mo>+</mo><mtext>region isolation</mtext><mo>+</mo><mtext>Actor 隔离</mtext></mrow><annotation encoding=\"application/x-tex\">\\text{并发安全} = \\text{编译期 Sendable 检查} + \\text{region isolation} + \\text{Actor 隔离}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">并发安全</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.0833em;\"></span><span class=\"mord text\"><span class=\"mord cjk_fallback\">编译期</span><span class=\"mord\"> Sendable </span><span class=\"mord cjk_fallback\">检查</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">region isolation</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord text\"><span class=\"mord\">Actor </span><span class=\"mord cjk_fallback\">隔离</span></span></span></span></span></span></div><h2 id=\"跨平台影响-android-的-reducer-库\">跨平台影响：Android 的 Reducer 库</h2><p>TCA 的设计理念已经扩散到 Kotlin 生态：</p>\n<table>\n<thead>\n<tr>\n<th>库</th>\n<th>平台</th>\n<th>与 TCA 的相似点</th>\n<th>差异点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Decompose (Arkadii Ivanov)</td>\n<td>KMP</td>\n<td>组件化、生命周期绑定</td>\n<td>不强制纯 Reducer</td>\n</tr>\n<tr>\n<td>Ballast</td>\n<td>KMP</td>\n<td>单向数据流、Effect 管理</td>\n<td>更轻量，无宏系统</td>\n</tr>\n<tr>\n<td>MVIKotlin</td>\n<td>KMP</td>\n<td>Store + Reducer + Intent</td>\n<td>与 Reaktive/Coroutines 集成</td>\n</tr>\n<tr>\n<td>Circuit (Slack)</td>\n<td>Android</td>\n<td>Presenter 模式</td>\n<td>面向 Compose，导航一等</td>\n</tr>\n</tbody></table>\n<h2 id=\"适用边界与权衡\">适用边界与权衡</h2><p>TCA 的强约束带来高确定性，但也带来成本：</p>\n<p><strong>适合</strong>：中大型 iOS/SwiftUI 应用（&gt; 20 屏）、需要严格测试保证的金融/医疗类应用、团队需要统一架构语言。</p>\n<p><strong>不适合</strong>：快速原型、团队没有函数式编程背景的入门项目、以 UIKit 为主的遗留代码库（TCA 2.x 虽支持 UIKit 但体验不如 SwiftUI）。</p>\n<p><strong>学习曲线</strong>：TCA 的概念密度高——Reducer 组合、Effect 取消、Scope 路由、@Dependency、TestStore 穷举验证——团队需要 2-4 周的适应期。</p>\n<p>从 <a href=\"../foundations/unidirectional-data-flow\">单向数据流</a> 的理论基础出发，TCA 是其在 Swift 类型系统上的极致工程化。如果你的目标平台是 Android 或 KMP，<a href=\"mvi-redux-mobile\">MVI 与 Redux 移动端</a> 提供了等价的 Kotlin 实现路径。</p>\n<h2 id=\"小结\">小结</h2><p>TCA 将函数式编程的组合思想落地为一套完整的移动端架构框架——State 是值类型、Reducer 是纯函数、Effect 是受控的副作用容器、Scope 是编译期安全的子 Feature 嵌入机制。这套约束的收益是极高的测试确定性和代码可推理性，代价是陡峭的学习曲线和对 Swift/SwiftUI 生态的深度绑定。TCA 1.18.x 对 Swift 6 并发模型的全面适配证明了其长期演进能力。</p>\n","headings":[{"level":1,"text":"可组合架构（TCA / Composable Architecture）","id":"可组合架构-tca-composable-architecture"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心代数结构","id":"核心代数结构"},{"level":2,"text":"组合：大 Feature 由小 Feature 拼成","id":"组合-大-feature-由小-feature-拼成"},{"level":2,"text":"依赖管理：`@Dependency` 系统","id":"依赖管理-dependency-系统"},{"level":2,"text":"测试：一等公民","id":"测试-一等公民"},{"level":2,"text":"Swift 6 适配：并发安全","id":"swift-6-适配-并发安全"},{"level":2,"text":"跨平台影响：Android 的 Reducer 库","id":"跨平台影响-android-的-reducer-库"},{"level":2,"text":"适用边界与权衡","id":"适用边界与权衡"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"单向数据流架构","url":"/l-doc-books/h/mobile/mobile-architecture-patterns/foundations/unidirectional-data-flow"},"next":{"title":"MVI 与 Redux 移动端实现","url":"/l-doc-books/h/mobile/mobile-architecture-patterns/modern-patterns/mvi-redux-mobile"}}