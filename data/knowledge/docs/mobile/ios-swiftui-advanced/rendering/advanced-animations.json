:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"keyframeanimator-关键帧动画\">KeyframeAnimator 关键帧动画</h2><p>当多个属性需要沿各自独立的时间线变化时，使用 KeyframeAnimator：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"struct AnimationValues {&#10;    var scale: CGFloat = 1.0&#10;    var rotation: Angle = .zero&#10;    var yOffset: CGFloat = 0&#10;}&#10;&#10;struct BouncingLogo: View {&#10;    @State private var trigger = false&#10;&#10;    var body: some View {&#10;        Image(systemName: &quot;star.fill&quot;)&#10;            .font(.system(size: 60))&#10;            .keyframeAnimator(initialValue: AnimationValues(), trigger: trigger) { content, value in&#10;                content&#10;                    .scaleEffect(value.scale)&#10;                    .rotationEffect(value.rotation)&#10;                    .offset(y: value.yOffset)&#10;            } keyframes: { _ in&#10;                KeyframeTrack(\\.scale) {&#10;                    SpringKeyframe(1.5, duration: 0.3, spring: .bouncy)&#10;                    SpringKeyframe(1.0, duration: 0.2, spring: .bouncy)&#10;                }&#10;                KeyframeTrack(\\.rotation) {&#10;                    LinearKeyframe(.degrees(0), duration: 0.1)&#10;                    SpringKeyframe(.degrees(360), duration: 0.5, spring: .smooth)&#10;                }&#10;                KeyframeTrack(\\.yOffset) {&#10;                    CubicKeyframe(-30, duration: 0.2)&#10;                    CubicKeyframe(0, duration: 0.3)&#10;                }&#10;            }&#10;            .onTapGesture { trigger.toggle() }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AnimationValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4