\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">equatable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span></code></pre></div><h2 id=\"减少-attribute-graph-复杂度\">减少 Attribute Graph 复杂度</h2><p>每个 modifier 都在 Attribute Graph 中添加节点。过深的 modifier 链会增加差分开销：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// 反模式：每次 body 求值动态创建 modifier 链&#10;ForEach(items) { item in&#10;    Text(item.name)&#10;        .font(item.isTitle ? .title : .body)&#10;        .foregroundStyle(item.color)&#10;        .padding(item.isTitle ? 16 : 8)&#10;        .background(item.isHighlighted ? Color.yellow : .clear)&#10;        .clipShape(RoundedRectangle(cornerRadius: item.isTitle ? 12 : 6))&#10;}&#10;&#10;// 优化：抽取为独立 View struct，利用 Equatable 跳过不变的行&#10;struct ItemRow: View, Equatable {&#10;    let item: Item&#10;&#10;    var body: some View {&#10;        Text(item.name)&#10;            .font(item.isTitle ? .title : .body)&#10;            .foregroundStyle(item.color)&#10;            .padding(item.isTitle ? 16 : 8)&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 反模式：每次 body 求值动态创建 modifier 链</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ForEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(items) { item </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    Text</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.name)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">font</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.isTitle </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .title </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .body)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">foregroundStyle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">color</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">padding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.isTitle </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 16</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">background</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.isHighlighted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Color.yellow </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .clear)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">clipShape</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">RoundedRectangle</span><span style=\"color:#24292E;--shi