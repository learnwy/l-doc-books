E1E4E8\">                state.numberFact </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fact</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">none</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"子模块组合与-scope\">子模块组合与 Scope</h2><p>大型应用由多个 Feature 组合而成。TCA 通过 <code>Scope</code> 和 <code>ifLet</code> / <code>forEach</code> 操作符将子 Reducer 嵌入父级：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"@Reducer&#10;struct AppFeature {&#10;    @ObservableState&#10;    struct State {&#10;        var counter = CounterFeature.State()&#10;        var settings = SettingsFeature.State()&#10;        @Presents var detail: DetailFeature.State?&#10;    }&#10;&#10;    enum Action {&#10;        case counter(CounterFeature.Action)&#10;        case settings(SettingsFeature.Action)&#10;        case detail(PresentationAction&lt;DetailFeature.Action&gt;)&#10;    }&#10;&#10;    var body: some ReducerOf&lt;Self&gt; {&#10;        Scope(state: \\.counter, action: \\.counter) {&#10;            CounterFeature()&#10;        }&#10;        Scope(state: \\.settings, action: \\.settings) {&#10;            SettingsFeature()&#10;        }&#10;        Reduce { state, action in&#10;            // 父级逻辑&#10;            .none&#10;        }&#10;        .ifLet(\\.$detail, action: \\.detail) {&#10;            DetailFeature()&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes