i-dark:#B392F0\"> testSwipeToDelete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> firstCell </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> app.cells.firstMatch</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        firstCell.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">swipeLeft</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        app.buttons[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Delete\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">tap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        // 验证列表减少</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        XCTAssertEqual</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(app.cells.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 假设原有 3 个</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"accessibility-自动审计\">Accessibility 自动审计</h2><p>iOS 17+ 的 <code>performAccessibilityAudit</code> 自动检测辅助功能问题：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func testAccessibility() throws {&#10;    app.launch()&#10;&#10;    // 自动审计当前屏幕&#10;    try app.performAccessibilityAudit()&#10;&#10;    // 指定审计类别&#10;    try app.performAccessibilityAudit(for: [&#10;        .dynamicType,      // 动态字体支持&#10;        .contrast,         // 对比度&#10;        .hitRegion,        // 触摸区域大小&#10;        .sufficientElementDescription, // 元素描述&#10;    ])&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> testAccessibility</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    app.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">launch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 自动审计当前屏幕</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> app.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">performAccessibilityAudit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 指定审计类别</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> app.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">performAccessibilityAudit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">dynamicType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,      </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 动态字体支持</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .contrast,         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 对比度</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .hitRegion,        </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 触摸区域大小</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .sufficientElementDescription, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 元素描述</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"测试数据隔离\">测试数据隔离</h2><p>通过 Launch Arguments 控制测试环境：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// App 端&#10;@main&#10;struct TaskApp: App {&#10;    var body: some Scene {&#10;        WindowGroup {&#10;            ContentView()&#10;        }&#10;        .modelContainer(for: Task.self, inMemory: isUITesting)&#10;    }&#10;&#10;    private var isUITesting: Bool {&#10;        ProcessInfo.processInfo.arguments.contains(&quot;--ui-testing&quot;)&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\