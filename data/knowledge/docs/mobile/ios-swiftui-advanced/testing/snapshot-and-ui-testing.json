.staticTexts[&quot;购买 SwiftUI 书籍&quot;]&#10;        XCTAssertTrue(taskCell.waitForExistence(timeout: 3))&#10;    }&#10;&#10;    func testCompleteTask() throws {&#10;        let firstTask = app.cells.firstMatch&#10;        let checkbox = firstTask.buttons[&quot;完成&quot;]&#10;        checkbox.tap()&#10;&#10;        // 验证移到已完成区&#10;        let completedSection = app.otherElements[&quot;已完成&quot;]&#10;        XCTAssertTrue(completedSection.waitForExistence(timeout: 2))&#10;    }&#10;&#10;    func testSwipeToDelete() throws {&#10;        let firstCell = app.cells.firstMatch&#10;        firstCell.swipeLeft()&#10;        app.buttons[&quot;Delete&quot;].tap()&#10;&#10;        // 验证列表减少&#10;        XCTAssertEqual(app.cells.count, 2) // 假设原有 3 个&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">final</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TaskFlowUITests</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">XCTestCase </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> app </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> XCUIApplication</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    override</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setUpWithError</span><span style=\"color:#24292E;--shiki-da