an style=\"color:#D73A49;--shiki-dark:#F97583\"> var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> isCompleted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    TaskRow</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">task</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Task</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">title</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Test\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">isCompleted</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: isCompleted))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">onTapGesture</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { isCompleted.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">toggle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"mock-数据设计模式\">Mock 数据设计模式</h2><p>预览的质量取决于 Mock 数据的覆盖度。推荐用静态工厂方法组织：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"extension Task {&#10;    static let mock = Task(title: &quot;买牛奶&quot;, priority: .medium)&#10;    static let mockCompleted = Task(title: &quot;写周报&quot;, priority: .low, isCompleted: true)&#10;    static let mockLongTitle = Task(&#10;        title: &quot;完成SwiftUI进阶文档的第四章测试部分并确保所有代码示例可编译&quot;,&#10;        priority: .high&#1