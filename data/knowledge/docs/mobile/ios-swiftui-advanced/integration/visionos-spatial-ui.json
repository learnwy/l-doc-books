an style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"realityview-桥接-3d-内容\">RealityView 桥接 3D 内容</h2><p><code>RealityView</code> 是 SwiftUI 与 RealityKit 的桥梁，类似于 UIViewRepresentable 的 3D 版本：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"struct GlobeView: View {&#10;    var body: some View {&#10;        RealityView { content in&#10;            // 加载 3D 模型&#10;            guard let earth = try? await ModelEntity(named: &quot;Earth&quot;) else { return }&#10;            earth.scale = SIMD3(repeating: 0.3)&#10;            earth.position = [0, 0, 0]&#10;&#10;            // 添加旋转动画&#10;            let rotation = FromToByAnimation&lt;Transform&gt;(&#10;                from: .init(rotation: simd_quatf(angle: 0, axis: [0, 1, 0])),&#10;                to: .init(rotation: simd_quatf(angle: .pi * 2, axis: [0, 1, 0])),&#10;                duration: 30,&#10;                isAdditive: true,&#10;                repeatMode: .repeat&#10;            )&#10;            let resource = try? AnimationResource.generate(with: rotation)&#10;            if let resource { earth.playAnimation(resource) }&#10;&#10;            content.add(earth)&#10;        } update: { content in&#10;            // 响应 SwiftUI 状态变化更新 3D 内容&#10;        }&#10;        .gesture(&#10;            SpatialTapGesture()&#10;                .targetedToAnyEntity()&#10;                .onEnded { value in&#10;                    // 处理空间点击&#10;                    print(&quot;Tapped entity at \\(value.location3D)&quot;)&#10;                }&#10;        )&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GlobeView</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#