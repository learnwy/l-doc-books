E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"play.fill\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { }</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">                    Button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"暂停\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">systemImage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"pause.fill\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { }</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">                    Slider</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">value</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: $progress)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">padding</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">glassBackgroundEffect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>visionOS 用同一套 SwiftUI 声明式 API 构建 Window、Volume 和 ImmersiveSpace 三种场景</li>\n<li>RealityView 是 SwiftUI 与 RealityKit 的桥梁，支持异步加载模型和实时更新</li>\n<li>Attachments 将 SwiftUI View 渲染为 3D 空间中的面片，实现信息标注</li>\n<li>空间手势需要 InputTargetComponent + CollisionComponent 才能命中 Entity</li>\n<li>从 iOS SwiftUI 迁移到 visionOS 的改动主要在 Scene 声明和手势层，核心业务逻辑可复用</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"uikit-interop-patterns\">本章：UIKit 互操作模式</a> — UIViewRepresentable 与 RealityView 在桥接思路上的一致性</li>\n<li><a href=\"../../swiftui-in-depth/interop-and-advanced/performance-tuning\">SwiftUI 深入 - 性能调优</a> — visionOS 渲染中 SwiftUI 层的性能考量</li>\n<li><a href=\"../../ios-architecture/architecture-patterns/clean-architecture\">iOS 架构 - Clean Architecture</a> — 跨平台（iOS + visionOS）项目中 Clean Architecture 的分层复用策略</li>\n</ul>\n","headings":[{"level":1,"text":"visionOS 空间 UI 开发","id":"visionos-空间-ui-开发"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"项目结构与 Scene 声明","id":"项目结构与-scene-声明"},{"level":2,"text":"RealityView 桥接 3D 内容","id":"realityview-桥接-3d-内容"},{"level":2,"text":"Attachments：将 SwiftUI 锚定到 3D 实体","id":"attachments-将-swiftui-锚定到-3d-实体"},{"level":2,"text":"空间手势系统","id":"空间手势系统"},{"level":2,"text":"Ornament 窗口附件","id":"ornament-窗口附件"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"UIKit 互操作模式","url":"/l-doc-books/h/mobile/ios-swiftui-advanced/integration/uikit-interop-patterns"},"next":{"title":"Preview 驱动开发","url":"/l-doc-books/h/mobile/ios-swiftui-advanced/testing/preview-driven-development"}}