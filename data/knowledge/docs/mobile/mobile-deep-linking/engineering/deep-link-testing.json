l\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> testMalformedURLSafety</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> url </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> URL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"myapp://product/detail?id=&#x3C;script>alert(1)&#x3C;/script>\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        // 路由器不应崩溃，应该安全处理</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        XCTAssertNoThrow</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(DeepLinkRouter.shared.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">url</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: url))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"xcuitest-深链端到端测试\">XCUITest 深链端到端测试</h2><p>XCUITest 可以通过 <code>XCUIApplication.launch(arguments:)</code> 和 URL Scheme 测试完整的深链流程：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"import XCTest&#10;&#10;class DeepLinkUITests: XCTestCase {&#10;&#10;    func testOpenProductDetailViaDeepLink() {&#10;        let app = XCUIApplication()&#10;&#10;        // 方式一：通过 launchArguments 注入深链&#10;        app.launchArguments = [&quot;--deeplink&quot;, &quot;myapp://product/detail?id=123&quot;]&#10;        app.launch()&#10;&#10;        // 等待产品详情页面加载&#10;        let productTitle = app.staticTexts[&quot;product-detail-title&quot;]&#10;        XCTAssertTrue(productTitle.waitForExistence(timeout: 5))&#10;    }&#10;&#10;    func testOpenUniversalLink() {&#10;        // 模拟 Universal Link 点击需要借助 Safari&#10;        let safari = XCUIApplication(bundleIdentifier: &quot;com.apple.mobilesafari&quot;)&#10;        safari.launch()&#10;&#10;        let addressBar = safari.textFields[&quot;Address&quot;]&#10;        addressBar.tap()&#10;        addressBar.typeText(&quot;https://example.com/product/123\\n&quot;)&#10;&#10;        // 等待系统弹出&quot;打开 App&quot;提示&#10;        let openButton = safari.buttons[&quot;Open&quot;]&#10;        if openButton.waitForExistence(timeout: 3) {&#10;            openButton.tap()&#10;        }&#10;&#10;        // 切换到 App 并验证&#10;        let app = XCUIApplication()&#10;        XCTAssertTrue(app.state == .runningForeground)&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> XCTest</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DeepLinkUITests</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#6F42C1;--shiki