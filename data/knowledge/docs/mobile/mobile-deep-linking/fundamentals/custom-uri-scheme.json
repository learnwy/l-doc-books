ndex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> application</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> app: UIApplication,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">                 open</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> url: URL,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">                 options</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [UIApplication.OpenURLOptionsKey: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">Any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Bool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 检查调用方</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sourceApp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> options[.sourceApplication] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> allowedSources </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"com.apple.mobilesafari\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"com.example.trusted-app\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        guard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> allowedSources.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">contains</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sourceApp) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 参数白名单校验</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    guard</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> isValidDeepLinkURL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> DeepLinkRouter.shared.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">handle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">url</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: url)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"防止-url-注入\">防止 URL 注入</h3><p>不要将 URI 参数直接拼接到 SQL、WebView URL 或系统命令中。所有参数必须经过解码和清洗：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"func sanitizeParam(_ value: String?) -&gt; String? {&#10;    guard let value = value else { return nil }&#10;    // 解码后再次检查，防止双重编码绕过&#10;    let decoded = value.removingPercentEncoding ?? value&#10;    // 只允许字母、数字和常见安全字符&#10;    let allowed = CharacterSet.alphanumerics.union(.init(charactersIn: &quot;-_&quot;))&#10;    return decoded.unicodeScalars.allSatisfy { allowed.contains($0) } ? decoded : nil&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sanitizeParam</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">String</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> String</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    guard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 解码后再次检查，防止双重编码绕过</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> decoded </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value.removingPercentEncoding </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 只允许字母、数字和常见安全字符</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> allowed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CharacterSet.alphanumerics.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">union</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">charactersIn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"-_\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> decoded.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">unicodeScalars</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">allSatisfy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { allowed.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">contains</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> decoded </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"scheme-劫持防御\">Scheme 劫持防御</h3><p>由于 iOS 无法阻止其他 App 注册相同的 Scheme，高安全性场景应改用 Universal Links。当必须使用自定义 Scheme 时，可以通过在 URI 中加入 HMAC 签名来验证来源合法性：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"myapp://product/detail?id=123&amp;ts=1720000000&amp;sig=sha256(secret+id+ts)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>myapp://product/detail?id=123&#x26;ts=1720000000&#x26;sig=sha256(secret+id+ts)</span></span></code></pre></div><h2 id=\"与-universal-links-的协同使用\">与 Universal Links 的协同使用</h2><p>实际项目中常见的模式是将 Universal Links 作为主方案，自定义 URI Scheme 作为备用：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>使用方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>社交媒体分享链接</td>\n<td>Universal Links（可降级到网页）</td>\n</tr>\n<tr>\n<td>App 内互跳</td>\n<td>自定义 URI Scheme（无需网络）</td>\n</tr>\n<tr>\n<td>第三方 App 回调</td>\n<td>自定义 URI Scheme（不需要服务器验证）</td>\n</tr>\n<tr>\n<td>推送通知跳转</td>\n<td>两者均可，Universal Links 更安全</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><p>自定义 URI Scheme 的工程要点：</p>\n<ul>\n<li><strong>注册规范</strong>：使用反向域名格式（<code>com.example.app</code>）降低 Scheme 冲突风险，在 Info.plist / AndroidManifest.xml 中声明</li>\n<li><strong>安全校验</strong>：对调用方 Bundle ID 做白名单校验（iOS），对所有参数做 URL 解码后的二次清洗，高安全性场景加 HMAC 签名</li>\n<li><strong>路由设计</strong>：设计统一的路由解析器，将 URL 转换为枚举型导航目标，避免字符串到视图的直接映射</li>\n<li><strong>降级处理</strong>：在 App 未安装时给用户清晰的错误反馈，不要让系统弹出未知协议的错误提示</li>\n</ul>\n<hr>\n<p><strong>本章相关文档：</strong> <a href=\"deep-link-types-protocols\">深链类型与协议</a> 提供所有方案的选型对比；<a href=\"universal-links-app-links\">Universal Links 与 App Links</a> 介绍安全验证的主流方案。</p>\n","headings":[{"level":1,"text":"自定义 URI Scheme","id":"自定义-uri-scheme"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"URI Scheme 的结构","id":"uri-scheme-的结构"},{"level":2,"text":"iOS 注册与处理","id":"ios-注册与处理"},{"level":3,"text":"Info.plist 声明","id":"info-plist-声明"},{"level":3,"text":"AppDelegate 处理（UIKit）","id":"appdelegate-处理-uikit"},{"level":3,"text":"SceneDelegate 处理（iOS 13+）","id":"scenedelegate-处理-ios-13"},{"level":3,"text":"SwiftUI 处理","id":"swiftui-处理"},{"level":2,"text":"Android 注册与处理","id":"android-注册与处理"},{"level":3,"text":"AndroidManifest.xml 声明","id":"androidmanifest-xml-声明"},{"level":3,"text":"Activity 中处理 Intent","id":"activity-中处理-intent"},{"level":2,"text":"URI Scheme 的路由设计","id":"uri-scheme-的路由设计"},{"level":2,"text":"安全防护","id":"安全防护"},{"level":3,"text":"来源验证的必要性","id":"来源验证的必要性"},{"level":3,"text":"防止 URL 注入","id":"防止-url-注入"},{"level":3,"text":"Scheme 劫持防御","id":"scheme-劫持防御"},{"level":2,"text":"与 Universal Links 的协同使用","id":"与-universal-links-的协同使用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Universal Links 与 App Links","url":"/l-doc-books/h/mobile/mobile-deep-linking/fundamentals/universal-links-app-links"},"next":{"title":"延迟深链流程","url":"/l-doc-books/h/mobile/mobile-deep-linking/deferred/deferred-deep-link-flow"}}