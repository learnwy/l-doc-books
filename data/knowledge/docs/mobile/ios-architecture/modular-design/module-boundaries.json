E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">deepLink</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> url)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            handleDeepLink</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(url)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"模块边界验证\">模块边界验证</h2><p>可以通过编译检查和 CI 脚本来验证模块边界：</p>\n<table>\n<thead>\n<tr>\n<th>方法</th>\n<th>工具</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>编译隔离</td>\n<td>SPM/CocoaPods</td>\n<td>模块编译时自动检查 import 合法性</td>\n</tr>\n<tr>\n<td>依赖图分析</td>\n<td>swift package show-dependencies</td>\n<td>可视化依赖关系</td>\n</tr>\n<tr>\n<td>架构规则检查</td>\n<td>自定义 CI 脚本</td>\n<td>检查非法 import 语句</td>\n</tr>\n<tr>\n<td>代码审查</td>\n<td>PR Review</td>\n<td>新增依赖需架构审批</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>模块分为 Feature（功能）、Core（核心）、Shared（共享）三大类型</li>\n<li>依赖方向必须自上而下：App → Feature → Core → Shared</li>\n<li>Feature 模块之间禁止直接依赖，应通过接口模块或路由通信</li>\n<li>使用 Swift 访问控制修饰符严格管理模块公开 API</li>\n<li>遵循无环依赖原则，通过接口提取和依赖反转打破循环</li>\n<li>在 CI 中集成依赖图分析工具，持续守护模块边界</li>\n</ul>\n","headings":[{"level":1,"text":"模块边界","id":"模块边界"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"模块类型","id":"模块类型"},{"level":2,"text":"依赖方向","id":"依赖方向"},{"level":2,"text":"公开 API 控制","id":"公开-api-控制"},{"level":2,"text":"无环依赖原则（ADP）","id":"无环依赖原则-adp"},{"level":2,"text":"模块边界验证","id":"模块边界验证"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"VIPER 架构","url":"/l-doc-books/h/mobile/ios-architecture/architecture-patterns/viper"},"next":{"title":"SPM 模块化","url":"/l-doc-books/h/mobile/ios-architecture/modular-design/spm-modularization"}}