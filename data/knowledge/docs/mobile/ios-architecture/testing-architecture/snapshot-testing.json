or:#6F42C1;--shiki-dark:#B392F0\"> testSettingsViewAccessibilitySize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> view </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SettingsView</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hostingController </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UIHostingController</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">rootView</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: view)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> traits </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UITraitCollection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">preferredContentSizeCategory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .accessibilityExtraLarge)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        assertSnapshot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: hostingController,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">image</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .iPhone13Pro, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">traits</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: traits)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"ci-环境差异对比\">CI 环境差异对比</h2><p>在 CI 中管理快照的关键配置：</p>\n<table>\n<thead>\n<tr>\n<th>配置项</th>\n<th>说明</th>\n<th>推荐值</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>录制环境</td>\n<td>统一的 macOS + Xcode 版本</td>\n<td>CI 专用 Runner</td>\n</tr>\n<tr>\n<td>图片格式</td>\n<td>PNG 无损</td>\n<td>默认</td>\n</tr>\n<tr>\n<td>精度阈值</td>\n<td>允许的像素差异百分比</td>\n<td>0.01 (1%)</td>\n</tr>\n<tr>\n<td>参考图存储</td>\n<td>Git LFS 或独立仓库</td>\n<td>Git LFS</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// 设置精度阈值&#10;assertSnapshot(&#10;    of: hostingController,&#10;    as: .image(precision: 0.99, perceptualPrecision: 0.98, on: .iPhone13Pro)&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 设置精度阈值</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">assertSnapshot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: hostingController,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">image</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">precision</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.99</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">perceptualPrecision</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.98</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .iPhone13Pro)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>CI 快照测试流程：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    PR[&quot;PR 提交&quot;] --&gt; CI[&quot;CI 运行快照测试&quot;]&#10;    CI --&gt; Result{&quot;测试结果&quot;}&#10;    Result --&gt;|通过| Merge[&quot;允许合并&quot;]&#10;    Result --&gt;|失败| Diff[&quot;生成差异报告&quot;]&#10;    Diff --&gt; Review[&quot;开发者审查&quot;]&#10;    Review --&gt; Update{&quot;需要更新?&quot;}&#10;    Update --&gt;|是| Record[&quot;重新录制参考图&quot;]&#10;    Record --&gt; Commit[&quot;提交更新的参考图&quot;]&#10;    Update --&gt;|否| Fix[&quot;修复 UI 回归&quot;]&#10;&#10;    classDef ci fill:none,stroke:#2196F3&#10;    classDef decision fill:none,stroke:#FF9800&#10;    classDef action fill:none,stroke:#4CAF50&#10;&#10;    class PR,CI ci&#10;    class Result,Update decision&#10;    class Merge,Diff,Review,Record,Commit,Fix action\">graph TD\n    PR[\"PR 提交\"] --&gt; CI[\"CI 运行快照测试\"]\n    CI --&gt; Result{\"测试结果\"}\n    Result --&gt;|通过| Merge[\"允许合并\"]\n    Result --&gt;|失败| Diff[\"生成差异报告\"]\n    Diff --&gt; Review[\"开发者审查\"]\n    Review --&gt; Update{\"需要更新?\"}\n    Update --&gt;|是| Record[\"重新录制参考图\"]\n    Record --&gt; Commit[\"提交更新的参考图\"]\n    Update --&gt;|否| Fix[\"修复 UI 回归\"]\n\n    classDef ci fill:none,stroke:#2196F3\n    classDef decision fill:none,stroke:#FF9800\n    classDef action fill:none,stroke:#4CAF50\n\n    class PR,CI ci\n    class Result,Update decision\n    class Merge,Diff,Review,Record,Commit,Fix action</pre><hr>\n<h2 id=\"更新策略\">更新策略</h2><p>当 UI 有意变更时需要更新参考图：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// 方式 1：设置环境变量录制所有快照&#10;// 运行时设置 isRecording = true&#10;// SnapshotTesting.isRecording = true&#10;&#10;// 方式 2：单个测试录制&#10;func testNewDesignProductCard() {&#10;    let view = ProductCardView(product: .mock)&#10;    let hostingController = UIHostingController(rootView: view)&#10;&#10;    assertSnapshot(of: hostingController, as: .image(on: .iPhone13Pro), record: true)&#10;}&#10;&#10;// 方式 3：批量更新脚本&#10;// 设置环境变量 SNAPSHOT_RECORD=1 运行全部快照测试&#10;// 然后 git diff 审查变更，git add 提交\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方式 1：设置环境变量录制所有快照</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 运行时设置 isRecording = true</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// SnapshotTesting.isRecording = true</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方式 2：单个测试录制</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> testNewDesignProductCard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> view </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ProductCardView</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">product</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .mock)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hostingController </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UIHostingController</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">rootView</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: view)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    assertSnapshot</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: hostingController, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">image</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: .iPhone13Pro), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方式 3：批量更新脚本</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 设置环境变量 SNAPSHOT_RECORD=1 运行全部快照测试</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 然后 git diff 审查变更，git add 提交</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 只在 CI 的固定环境中录制参考图。不同 macOS 版本的字体渲染存在差异，会导致本地和 CI 的快照不一致。</p>\n</blockquote>\n<hr>\n<h2 id=\"快照测试最佳实践\">快照测试最佳实践</h2><table>\n<thead>\n<tr>\n<th>实践</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>固定数据</td>\n<td>使用 Mock 数据，避免随机内容</td>\n</tr>\n<tr>\n<td>固定时间</td>\n<td>注入 FixedDateProvider</td>\n</tr>\n<tr>\n<td>固定尺寸</td>\n<td>指定 frame 或设备类型</td>\n</tr>\n<tr>\n<td>按组件测试</td>\n<td>优先测试组件而非整个页面</td>\n</tr>\n<tr>\n<td>Git LFS</td>\n<td>大量图片文件使用 LFS 管理</td>\n</tr>\n<tr>\n<td>精度容忍</td>\n<td>设置合理的 precision 阈值</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>快照测试通过图片对比自动检测 UI 视觉回归</li>\n<li>SnapshotTesting 库支持多设备、多特征（Dark Mode、动态字体）录制</li>\n<li>CI 环境需要固定 macOS/Xcode 版本以保证快照一致性</li>\n<li>精度阈值（precision）允许忽略亚像素级别的渲染差异</li>\n<li>参考图更新需通过 review 确认是有意变更而非回归</li>\n<li>组件级快照测试比页面级更稳定、更易维护</li>\n</ul>\n","headings":[{"level":1,"text":"快照测试","id":"快照测试"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"快照测试原理","id":"快照测试原理"},{"level":2,"text":"SnapshotTesting 库","id":"snapshottesting-库"},{"level":2,"text":"多设备测试","id":"多设备测试"},{"level":2,"text":"特征组合测试","id":"特征组合测试"},{"level":2,"text":"CI 环境差异对比","id":"ci-环境差异对比"},{"level":2,"text":"更新策略","id":"更新策略"},{"level":2,"text":"快照测试最佳实践","id":"快照测试最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"可测试架构","url":"/l-doc-books/h/mobile/ios-architecture/testing-architecture/testable-architecture"},"next":{"title":"集成测试","url":"/l-doc-books/h/mobile/ios-architecture/testing-architecture/integration-testing"}}