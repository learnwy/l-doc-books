er</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        analytics.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">track</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"order_placed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">properties</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ✅ 构造器注入</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">final</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderViewModel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> paymentService: PaymentServiceProtocol</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orderService: OrderServiceProtocol</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> analytics: AnalyticsServiceProtocol</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        paymentService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: PaymentServiceProtocol,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        orderService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: OrderServiceProtocol,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        analytics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: AnalyticsServiceProtocol</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.paymentService </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> paymentService</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.orderService </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orderService</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.analytics </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> analytics</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> placeOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> order </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> try?</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orderService.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">createOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        try?</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> paymentService.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">charge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: order</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        analytics.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">track</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"order_placed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">properties</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Service Locator 的问题：</p>\n<table>\n<thead>\n<tr>\n<th>问题</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>隐式依赖</td>\n<td>无法从接口看出类需要哪些依赖</td>\n</tr>\n<tr>\n<td>测试困难</td>\n<td>需要配置全局状态才能测试</td>\n</tr>\n<tr>\n<td>运行时崩溃</td>\n<td>忘记注册服务会在运行时崩溃</td>\n</tr>\n<tr>\n<td>全局可变状态</td>\n<td>违反最小权限原则</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>依赖注入的核心是让对象从外部接收依赖，而非自己创建</li>\n<li>构造器注入是首选方式，保证不可变性和编译期安全</li>\n<li>属性注入适用于可选依赖和框架限制场景</li>\n<li>方法注入适用于只在特定操作中使用的依赖</li>\n<li>手动 DI 类型安全、调试友好；IoC 容器适合大型项目减少样板代码</li>\n<li>Service Locator 是反模式，它隐藏了依赖关系，应尽量避免使用</li>\n</ul>\n","headings":[{"level":1,"text":"依赖注入基础","id":"依赖注入基础"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"什么是依赖注入","id":"什么是依赖注入"},{"level":2,"text":"三种注入方式","id":"三种注入方式"},{"level":3,"text":"构造器注入（Constructor Injection）","id":"构造器注入-constructor-injection"},{"level":3,"text":"属性注入（Property Injection）","id":"属性注入-property-injection"},{"level":3,"text":"方法注入（Method Injection）","id":"方法注入-method-injection"},{"level":2,"text":"三种注入方式对比","id":"三种注入方式对比"},{"level":2,"text":"IoC 容器 vs 手动 DI","id":"ioc-容器-vs-手动-di"},{"level":3,"text":"手动 DI（Pure DI）","id":"手动-di-pure-di"},{"level":3,"text":"IoC 容器","id":"ioc-容器"},{"level":2,"text":"Service Locator 反模式","id":"service-locator-反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"接口模块模式","url":"/l-doc-books/h/mobile/ios-architecture/modular-design/interface-module-pattern"},"next":{"title":"容器模式","url":"/l-doc-books/h/mobile/ios-architecture/dependency-injection/container-patterns"}}