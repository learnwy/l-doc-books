92E;--shiki-dark:#E1E4E8\"> viewModel: DashboardViewModel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> container.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">resolve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>手动 DI</th>\n<th>IoC 容器</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>类型安全</td>\n<td>✅ 编译期检查</td>\n<td>❌ 运行时解析</td>\n</tr>\n<tr>\n<td>代码量</td>\n<td>较多</td>\n<td>较少</td>\n</tr>\n<tr>\n<td>调试难度</td>\n<td>低</td>\n<td>高</td>\n</tr>\n<tr>\n<td>依赖可见性</td>\n<td>显式</td>\n<td>隐式</td>\n</tr>\n<tr>\n<td>推荐场景</td>\n<td>中小型项目</td>\n<td>大型项目</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"service-locator-反模式\">Service Locator 反模式</h2><p>Service Locator 看似方便，实则隐藏了依赖关系：</p>\n<div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// ❌ Service Locator 反模式&#10;final class OrderViewModel {&#10;    func placeOrder() async {&#10;        let paymentService = ServiceLocator.shared.resolve(PaymentServiceProtocol.self)&#10;        let orderService = ServiceLocator.shared.resolve(OrderServiceProtocol.self)&#10;        let analytics = ServiceLocator.shared.resolve(AnalyticsServiceProtocol.self)&#10;&#10;        let order = try? await orderService.createOrder()&#10;        try? await paymentService.charge(order: order!)&#10;        analytics.track(event: &quot;order_placed&quot;, properties: [:])&#10;    }&#10;}&#10;&#10;// ✅ 构造器注入&#10;final class OrderViewModel {&#10;    private let paymentService: PaymentServiceProtocol&#10;    private let orderService: OrderServiceProtocol&#10;    private let analytics: AnalyticsServiceProtocol&#10;&#10;    init(&#10;        paymentService: PaymentServiceProtocol,&#10;        orderService: OrderServiceProtocol,&#10;        analytics: AnalyticsServiceProtocol&#10;    ) {&#10;        self.paymentService = paymentService&#10;        self.orderService = orderService&#10;        self.analytics = analytics&#10;    }&#10;&#10;    func placeOrder() async {&#10;        let order = try? await orderService.createOrder()&#10;        try? await paymentService.charge(order: order!)&#10;        analytics.track(event: &quot;order_placed&quot;, properties: [:])&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ❌ Service Locator 反模式</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">final</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderViewModel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> placeOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> paymentService </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ServiceLocator.shared.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">resolve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(PaymentServiceProtocol.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orderService </span><span style=\"color:#D73A49;--shiki-dark:#F97