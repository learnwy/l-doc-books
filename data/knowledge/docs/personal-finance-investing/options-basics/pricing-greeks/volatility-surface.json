 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0278em;\">r</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1389em;\">T</span></span></span></span></span></span></span></span></span><span class=\"mord mathnormal\">Q</span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">K</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3214em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">T</span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.686em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3603em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">K</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">F</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.836em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">)</span></span></span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.654em;\"><span style=\"top:-3.9029em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span><span style=\"top:-3.8418em;\"><span class=\"pstrut\" style=\"height:5.1194em;\"></span><span class=\"hide-tail\" style=\"min-width:0.742em;height:3.1994em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"3.1994em\" viewBox=\"0 0 400000 3199\" preserveAspectRatio=\"xMinYMin slice\"><path d=\"M702 80H40000040\nH742v3065l-4 4-4 4c-.667.7 -2 1.5-4 2.5s-4.167 1.833-6.5 2.5-5.5 1-9.5 1\nh-12l-28-84c-16.667-52-96.667 -294.333-240-727l-212 -643 -85 170\nc-4-3.333-8.333-7.667-13 -13l-13-13l77-155 77-156c66 199.333 139 419.667\n219 661 l218 661zM702 80H400000v40H742z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.2777em;\"><span></span></span></span></span></span></span></span></span></span></div><h3 id=\"vix-的特征\">VIX 的特征</h3><table>\n<thead>\n<tr>\n<th>特征</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>均值回归</td>\n<td>VIX 长期均值约 15-20，极端偏离后趋于回归</td>\n</tr>\n<tr>\n<td>与标的负相关</td>\n<td>股市下跌 → VIX 上升（&quot;恐惧指数&quot;）</td>\n</tr>\n<tr>\n<td>不对称响应</td>\n<td>股市下跌 5% 时 VIX 涨幅 &gt;&gt; 股市上涨 5% 时 VIX 跌幅</td>\n</tr>\n<tr>\n<td>远期溢价</td>\n<td>通常 VIX 期货 &gt; VIX 现货（Contango）</td>\n</tr>\n</tbody></table>\n<h3 id=\"中国的波动率指数\">中国的波动率指数</h3><p>中国市场也有类似 VIX 的指标：</p>\n<ul>\n<li><strong>中国波指（iVIX）</strong>：基于上证 50ETF 期权计算，由上交所发布</li>\n<li>2026 年 5 月 7 日数据：50ETF 期权 VIX 报 17.40%，300ETF 期权 VIX 报 18.42%，创业板ETF 期权 VIX 报 30.78%</li>\n<li>不同品种 VIX 的分化反映了市场对不同板块风险的差异化定价</li>\n</ul>\n<h3 id=\"vix-的交易含义\">VIX 的交易含义</h3><table>\n<thead>\n<tr>\n<th>VIX 水平</th>\n<th>市场状态</th>\n<th>策略倾向</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>&lt; 15</td>\n<td>极度平静</td>\n<td>买入波动率（便宜）</td>\n</tr>\n<tr>\n<td>15-20</td>\n<td>正常</td>\n<td>中性策略</td>\n</tr>\n<tr>\n<td>20-30</td>\n<td>焦虑</td>\n<td>卖出波动率（溢价高）</td>\n</tr>\n<tr>\n<td>30-40</td>\n<td>恐慌</td>\n<td>谨慎卖出/等待</td>\n</tr>\n<tr>\n<td>&gt; 40</td>\n<td>极度恐慌</td>\n<td>逆向卖出波动率（高风险高回报）</td>\n</tr>\n</tbody></table>\n<h2 id=\"波动率交易\">波动率交易</h2><h3 id=\"核心理念\">核心理念</h3><p>波动率交易的核心思想是：<strong>IV 与未来 RV 之间的差异可以被系统性地交易获利</strong>。</p>\n<ul>\n<li><strong>做多波动率</strong>：预期 RV &gt; IV → 买入期权（Long Gamma/Vega）</li>\n<li><strong>做空波动率</strong>：预期 RV &lt; IV → 卖出期权（Short Gamma/Vega）</li>\n</ul>\n<h3 id=\"波动率溢价-volatility-risk-premium\">波动率溢价（Volatility Risk Premium）</h3><p>长期统计数据表明，<strong>IV 平均高于 RV 约 2-4 个百分点</strong>。这个溢价的来源：</p>\n<ul>\n<li>投资者为&quot;保险&quot;支付溢价（类似保费 &gt; 预期赔付）</li>\n<li>尾部风险的真实成本（偶尔的大亏损抵消持续的小盈利）</li>\n<li>机构对冲的系统性需求</li>\n</ul>\n<h3 id=\"波动率交易策略\">波动率交易策略</h3><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>做多/做空波动率</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Long Straddle</td>\n<td>做多</td>\n<td>IV 偏低 + 预期大事件</td>\n</tr>\n<tr>\n<td>Short Straddle</td>\n<td>做空</td>\n<td>IV 偏高 + 预期平静</td>\n</tr>\n<tr>\n<td>Calendar Spread</td>\n<td>做多远月/做空近月</td>\n<td>期限结构倒挂</td>\n</tr>\n<tr>\n<td>Variance Swap</td>\n<td>纯波动率敞口</td>\n<td>场外市场（机构）</td>\n</tr>\n<tr>\n<td>VIX 期货</td>\n<td>做多/做空 VIX</td>\n<td>海外市场（中国暂无）</td>\n</tr>\n</tbody></table>\n<h3 id=\"iv-hv-差值分析\">IV-HV 差值分析</h3><p>通过比较 IV 与 HV 的关系判断策略方向：</p>\n<table>\n<thead>\n<tr>\n<th>IV vs HV</th>\n<th>含义</th>\n<th>策略建议</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>IV &gt;&gt; HV</td>\n<td>期权定价过高</td>\n<td>卖出期权策略</td>\n</tr>\n<tr>\n<td>IV ≈ HV</td>\n<td>定价合理</td>\n<td>方向性策略</td>\n</tr>\n<tr>\n<td>IV &lt;&lt; HV</td>\n<td>期权定价过低</td>\n<td>买入期权策略</td>\n</tr>\n</tbody></table>\n<p><strong>注意</strong>：IV &gt; HV 是常态（波动率溢价），只有显著偏离历史分位才有统计意义。建议使用 IV Percentile（IV 在过去一年中的百分位排名）作为判断标准：</p>\n<ul>\n<li>IV Percentile &gt; 80%：适合做空波动率</li>\n<li>IV Percentile &lt; 20%：适合做多波动率</li>\n</ul>\n<h2 id=\"波动率曲面的建模\">波动率曲面的建模</h2><h3 id=\"参数化模型\">参数化模型</h3><p>实务中常用的波动率曲面参数化方法：</p>\n<table>\n<thead>\n<tr>\n<th>模型</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SVI（Stochastic Volatility Inspired）</td>\n<td>5 参数拟合微笑切面</td>\n<td>最广泛使用</td>\n</tr>\n<tr>\n<td>SABR</td>\n<td>随机波动率，4 参数</td>\n<td>利率期权、商品期权</td>\n</tr>\n<tr>\n<td>Heston</td>\n<td>随机波动率 PDE</td>\n<td>定价 exotic options</td>\n</tr>\n<tr>\n<td>Local Vol（Dupire）</td>\n<td>与所有 Vanilla 价格一致</td>\n<td>完美校准标准曲面</td>\n</tr>\n</tbody></table>\n<h3 id=\"曲面套利约束\">曲面套利约束</h3><p>有效的波动率曲面必须满足无套利条件：</p>\n<ul>\n<li><strong>蝶式套利约束</strong>：沿行权价方向曲面不能太凸或太凹</li>\n<li><strong>日历套利约束</strong>：沿时间方向方差必须单调增</li>\n<li><strong>边界条件</strong>：极端行权价的 IV 行为受限</li>\n</ul>\n<h2 id=\"本节小结\">本节小结</h2><ul>\n<li>隐含波动率 IV 是前瞻性预期，历史波动率 HV 是后视统计</li>\n<li>波动率微笑/偏斜揭示了 BSM 假设的失效方式</li>\n<li>波动率期限结构反映事件驱动和不确定性的时间分布</li>\n<li>VIX（或中国 iVIX）是市场恐慌程度的温度计，具有均值回归特性</li>\n<li>波动率交易的核心是 IV vs RV 的差异，长期存在波动率溢价</li>\n<li>波动率曲面是期权定价的完整信息载体，其动态变化本身就是交易机会</li>\n</ul>\n","headings":[{"level":1,"text":"波动率曲面","id":"波动率曲面"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"波动率的两种度量","id":"波动率的两种度量"},{"level":3,"text":"历史波动率（Historical Volatility, HV）","id":"历史波动率-historical-volatility-hv"},{"level":3,"text":"隐含波动率（Implied Volatility, IV）","id":"隐含波动率-implied-volatility-iv"},{"level":3,"text":"HV vs IV 的本质区别","id":"hv-vs-iv-的本质区别"},{"level":3,"text":"已实现波动率（Realized Volatility, RV）","id":"已实现波动率-realized-volatility-rv"},{"level":2,"text":"波动率微笑（Volatility Smile）","id":"波动率微笑-volatility-smile"},{"level":3,"text":"定义","id":"定义"},{"level":3,"text":"股票/ETF 市场的偏斜（Skew）","id":"股票-etf-市场的偏斜-skew"},{"level":3,"text":"偏斜的量化指标","id":"偏斜的量化指标"},{"level":3,"text":"外汇市场的微笑（Smile）","id":"外汇市场的微笑-smile"},{"level":2,"text":"波动率期限结构（Term Structure）","id":"波动率期限结构-term-structure"},{"level":3,"text":"定义","id":"定义"},{"level":3,"text":"常见形态","id":"常见形态"},{"level":3,"text":"期限结构的交易含义","id":"期限结构的交易含义"},{"level":2,"text":"波动率曲面（Volatility Surface）","id":"波动率曲面-volatility-surface"},{"level":3,"text":"三维结构","id":"三维结构"},{"level":3,"text":"曲面的动态变化","id":"曲面的动态变化"},{"level":2,"text":"VIX 恐慌指数","id":"vix-恐慌指数"},{"level":3,"text":"定义","id":"定义"},{"level":3,"text":"VIX 的特征","id":"vix-的特征"},{"level":3,"text":"中国的波动率指数","id":"中国的波动率指数"},{"level":3,"text":"VIX 的交易含义","id":"vix-的交易含义"},{"level":2,"text":"波动率交易","id":"波动率交易"},{"level":3,"text":"核心理念","id":"核心理念"},{"level":3,"text":"波动率溢价（Volatility Risk Premium）","id":"波动率溢价-volatility-risk-premium"},{"level":3,"text":"波动率交易策略","id":"波动率交易策略"},{"level":3,"text":"IV-HV 差值分析","id":"iv-hv-差值分析"},{"level":2,"text":"波动率曲面的建模","id":"波动率曲面的建模"},{"level":3,"text":"参数化模型","id":"参数化模型"},{"level":3,"text":"曲面套利约束","id":"曲面套利约束"},{"level":2,"text":"本节小结","id":"本节小结"}],"prev":{"title":"希腊字母详解","url":"/l-doc-books/h/personal-finance-investing/options-basics/pricing-greeks/greeks-explained"},"next":{"title":"基础策略","url":"/l-doc-books/h/personal-finance-investing/options-basics/strategies/basic-strategies"}}