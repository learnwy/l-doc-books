FF\"> -f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> compose.yaml</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> compose.dev.yaml</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> up</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    BASE[compose.yaml&lt;br/&gt;基础配置] --&gt; DEV[compose.dev.yaml&lt;br/&gt;开发覆盖]&#10;    BASE --&gt; PROD[compose.prod.yaml&lt;br/&gt;生产覆盖]&#10;    BASE --&gt; TEST[compose.test.yaml&lt;br/&gt;测试覆盖]\">graph LR\n    BASE[compose.yaml&lt;br/&gt;基础配置] --&gt; DEV[compose.dev.yaml&lt;br/&gt;开发覆盖]\n    BASE --&gt; PROD[compose.prod.yaml&lt;br/&gt;生产覆盖]\n    BASE --&gt; TEST[compose.test.yaml&lt;br/&gt;测试覆盖]</pre><table>\n<thead>\n<tr>\n<th>文件</th>\n<th>作用</th>\n<th>内容</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>compose.yaml</td>\n<td>基础服务定义</td>\n<td>服务、网络、数据卷</td>\n</tr>\n<tr>\n<td>compose.dev.yaml</td>\n<td>开发环境覆盖</td>\n<td>源码挂载、调试端口</td>\n</tr>\n<tr>\n<td>compose.prod.yaml</td>\n<td>生产环境覆盖</td>\n<td>资源限制、副本数</td>\n</tr>\n<tr>\n<td>compose.test.yaml</td>\n<td>测试环境覆盖</td>\n<td>测试数据库、mock</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((多服务编排))&#10;    依赖管理&#10;      depends_on&#10;      service_healthy&#10;      service_completed&#10;    健康检查&#10;      HTTP 探针&#10;      命令探针&#10;      start_period&#10;    扩缩容&#10;      replicas&#10;      --scale&#10;      负载均衡&#10;    配置复用&#10;      YAML 锚点&#10;      profiles&#10;      多文件覆盖\">mindmap\n  root((多服务编排))\n    依赖管理\n      depends_on\n      service_healthy\n      service_completed\n    健康检查\n      HTTP 探针\n      命令探针\n      start_period\n    扩缩容\n      replicas\n      --scale\n      负载均衡\n    配置复用\n      YAML 锚点\n      profiles\n      多文件覆盖</pre><ul>\n<li><code>depends_on</code> 配合 <code>condition: service_healthy</code> 确保依赖服务真正就绪后再启动下游服务。</li>\n<li>健康检查应覆盖所有关键服务，设置合理的 <code>start_period</code> 避免初始化阶段的误报。</li>\n<li>使用 <code>deploy.replicas</code> 或 <code>--scale</code> 实现水平扩缩容，需配合负载均衡器使用。</li>\n<li>YAML 锚点和 profiles 机制实现配置复用，多文件组合管理环境差异。</li>\n<li>生产环境推荐使用 <code>compose.yaml</code> + <code>compose.prod.yaml</code> 的覆盖模式。</li>\n</ul>\n","headings":[{"level":1,"text":"多服务编排","id":"多服务编排"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"服务依赖管理","id":"服务依赖管理"},{"level":2,"text":"健康检查","id":"健康检查"},{"level":2,"text":"服务扩缩容","id":"服务扩缩容"},{"level":2,"text":"服务配置继承","id":"服务配置继承"},{"level":3,"text":"YAML 锚点复用","id":"yaml-锚点复用"},{"level":3,"text":"Profiles 环境隔离","id":"profiles-环境隔离"},{"level":2,"text":"多文件组合","id":"多文件组合"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Compose 文件解析","url":"/l-doc-books/h/devops-tools/devops-containerization/docker-compose/compose-file-anatomy"},"next":{"title":"数据卷与持久化","url":"/l-doc-books/h/devops-tools/devops-containerization/docker-compose/volumes-and-persistence"}}