rk:#9ECBFF\">/</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            pathType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Prefix</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            backend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">              service</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">frontend</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                  number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">80</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">host</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">api.example.com</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      http</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        paths</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">path</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/v1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            pathType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Prefix</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            backend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">              service</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">api-v1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                  number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">80</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">path</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/v2</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            pathType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Prefix</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            backend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">              service</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">api-v2</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">                  number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">80</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    INTERNET[互联网] --&gt; ING[Ingress Controller&lt;br/&gt;Nginx / Traefik]&#10;    ING --&gt;|app.example.com /| FE[frontend Service]&#10;    ING --&gt;|api.example.com /v1| V1[api-v1 Service]&#10;    ING --&gt;|api.example.com /v2| V2[api-v2 Service]&#10;    FE --&gt; FP1[前端 Pod]&#10;    FE --&gt; FP2[前端 Pod]&#10;    V1 --&gt; AP1[API v1 Pod]&#10;    V2 --&gt; AP2[API v2 Pod]\">graph TD\n    INTERNET[互联网] --&gt; ING[Ingress Controller&lt;br/&gt;Nginx / Traefik]\n    ING --&gt;|app.example.com /| FE[frontend Service]\n    ING --&gt;|api.example.com /v1| V1[api-v1 Service]\n    ING --&gt;|api.example.com /v2| V2[api-v2 Service]\n    FE --&gt; FP1[前端 Pod]\n    FE --&gt; FP2[前端 Pod]\n    V1 --&gt; AP1[API v1 Pod]\n    V2 --&gt; AP2[API v2 Pod]</pre><table>\n<thead>\n<tr>\n<th>Ingress Controller</th>\n<th>特点</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Nginx Ingress</td>\n<td>成熟稳定、功能丰富</td>\n<td>通用场景</td>\n</tr>\n<tr>\n<td>Traefik</td>\n<td>自动服务发现、动态配置</td>\n<td>微服务架构</td>\n</tr>\n<tr>\n<td>Kong</td>\n<td>API 网关特性</td>\n<td>API 管理</td>\n</tr>\n<tr>\n<td>AWS ALB Controller</td>\n<td>原生 ALB 集成</td>\n<td>AWS 环境</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> Ingress 资源本身只是路由规则的声明，必须在集群中部署 Ingress Controller 才能生效。安装 <code>ingress-nginx</code> 是最常见的选择：<code>kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/cloud/deploy.yaml</code>。</p>\n</blockquote>\n<hr>\n<h2 id=\"网络策略\">网络策略</h2><p>NetworkPolicy 控制 Pod 之间以及 Pod 与外部之间的网络流量，实现微服务级别的网络安全隔离。</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"apiVersion: networking.k8s.io/v1&#10;kind: NetworkPolicy&#10;metadata:&#10;  name: api-network-policy&#10;spec:&#10;  podSelector:&#10;    matchLabels:&#10;      app: api&#10;  policyTypes:&#10;    - Ingress&#10;    - Egress&#10;  ingress:&#10;    - from:&#10;        - podSelector:&#10;            matchLabels:&#10;              app: frontend&#10;      ports:&#10;        - port: 3000&#10;  egress:&#10;    - to:&#10;        - podSelector:&#10;            matchLabels:&#10;              app: database&#10;      ports:&#10;        - port: 5432\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">apiVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">networking.k8s.io/v1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">kind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">NetworkPolicy</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">api-network-policy</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">spec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  podSelector</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    matchLabels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">api</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  policyTypes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Ingress</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Egress</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  ingress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">podSelector</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            matchLabels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">              app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">frontend</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      ports</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3000</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  egress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">podSelector</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            matchLabels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">              app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">database</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      ports</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">port</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5432</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>策略维度</th>\n<th>控制方式</th>\n<th>默认行为</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Ingress</td>\n<td>入站流量白名单</td>\n<td>全部允许</td>\n</tr>\n<tr>\n<td>Egress</td>\n<td>出站流量白名单</td>\n<td>全部允许</td>\n</tr>\n<tr>\n<td>podSelector</td>\n<td>按标签选择目标 Pod</td>\n<td>空选择全部</td>\n</tr>\n<tr>\n<td>namespaceSelector</td>\n<td>按命名空间过滤</td>\n<td>当前命名空间</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Service 与 Ingress))&#10;    Service&#10;      ClusterIP 内部&#10;      NodePort 节点&#10;      LoadBalancer 外部&#10;    DNS 发现&#10;      自动注册&#10;      跨命名空间&#10;      FQDN 格式&#10;    Ingress&#10;      域名路由&#10;      路径分发&#10;      TLS 终止&#10;      Controller 实现&#10;    网络策略&#10;      Ingress 入站&#10;      Egress 出站&#10;      标签选择器\">mindmap\n  root((Service 与 Ingress))\n    Service\n      ClusterIP 内部\n      NodePort 节点\n      LoadBalancer 外部\n    DNS 发现\n      自动注册\n      跨命名空间\n      FQDN 格式\n    Ingress\n      域名路由\n      路径分发\n      TLS 终止\n      Controller 实现\n    网络策略\n      Ingress 入站\n      Egress 出站\n      标签选择器</pre><ul>\n<li><strong>Service</strong> 为 Pod 提供稳定的访问入口，ClusterIP 用于内部通信，LoadBalancer 用于外部暴露。</li>\n<li>Kubernetes DNS 自动为 Service 创建 DNS 记录，支持同命名空间和跨命名空间的服务发现。</li>\n<li><strong>Ingress</strong> 在 HTTP/HTTPS 层面实现基于域名和路径的流量路由，需要部署 Ingress Controller。</li>\n<li>NetworkPolicy 实现 Pod 级别的网络隔离，默认无策略时所有流量放行。</li>\n<li>生产环境建议使用 Ingress + TLS 作为外部流量入口，配合 NetworkPolicy 实现零信任网络。</li>\n</ul>\n","headings":[{"level":1,"text":"Service 与 Ingress","id":"service-与-ingress"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Service 概述","id":"service-概述"},{"level":2,"text":"Service 类型","id":"service-类型"},{"level":3,"text":"ClusterIP","id":"clusterip"},{"level":3,"text":"NodePort","id":"nodeport"},{"level":3,"text":"LoadBalancer","id":"loadbalancer"},{"level":2,"text":"DNS 服务发现","id":"dns-服务发现"},{"level":2,"text":"Ingress 资源","id":"ingress-资源"},{"level":2,"text":"网络策略","id":"网络策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Pod 与 Deployment","url":"/l-doc-books/h/devops-tools/devops-containerization/kubernetes-essentials/pods-and-deployments"},"next":{"title":"ConfigMap 与 Secret","url":"/l-doc-books/h/devops-tools/devops-containerization/kubernetes-essentials/configmaps-and-secrets"}}