ns/cache@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    path</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ env.STORE_PATH }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    key</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm-store-${{ hashFiles('**/pnpm-lock.yaml') }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    restore-keys</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm-store-</span></span></code></pre></div><hr>\n<h2 id=\"完整的-ci-流水线模板\">完整的 CI 流水线模板</h2><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"name: CI&#10;on:&#10;  pull_request:&#10;    branches: [main]&#10;  push:&#10;    branches: [main]&#10;&#10;concurrency:&#10;  group: ci-${{ github.ref }}&#10;  cancel-in-progress: true&#10;&#10;jobs:&#10;  ci:&#10;    runs-on: ubuntu-latest&#10;    timeout-minutes: 15&#10;    env:&#10;      TURBO_TOKEN: ${{ secrets.TURBO_TOKEN }}&#10;      TURBO_TEAM: ${{ vars.TURBO_TEAM }}&#10;    steps:&#10;      - uses: actions/checkout@v4&#10;        with:&#10;          fetch-depth: 0&#10;&#10;      - uses: pnpm/action-setup@v4&#10;      - uses: actions/setup-node@v4&#10;        with:&#10;          node-version: 20&#10;          cache: pnpm&#10;&#10;      - run: pnpm install --frozen-lockfile&#10;&#10;      - name: Check formatting&#10;        run: pnpm format:check&#10;&#10;      - name: Lint, typecheck, test, build&#10;        run: |&#10;          pnpm turbo run lint typecheck test build \\&#10;            --filter=...[origin/main...HEAD]\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">CI</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  pull_request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    branches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    branches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">concurrency</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  group</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ci-${{ github.ref }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  cancel-in-progress</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  ci</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    timeout-minutes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">15</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    env</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      TURBO_TOKEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ secrets.TURBO_TOKEN }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      TURBO_TEAM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ vars.TURBO_TEAM }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/checkout@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          fetch-depth</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm/action-setup@v4</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/setup-node@v4</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          node-version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          cache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm install --frozen-lockfile</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Check formatting</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pnpm format:check</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Lint, typecheck, test, build</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          pnpm turbo run lint typecheck test build \\</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            --filter=...[origin/main...HEAD]</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((CI 流水线))&#10;    affected-only&#10;      Git diff 检测&#10;      --filter 过滤&#10;      下游依赖包含&#10;    矩阵构建&#10;      动态矩阵&#10;      包级并行&#10;      fail-fast: false&#10;    缓存策略&#10;      远程构建缓存&#10;      依赖安装缓存&#10;      artifacts 共享&#10;    最佳实践&#10;      concurrency 控制&#10;      timeout 设置&#10;      fetch-depth: 0\">mindmap\n  root((CI 流水线))\n    affected-only\n      Git diff 检测\n      --filter 过滤\n      下游依赖包含\n    矩阵构建\n      动态矩阵\n      包级并行\n      fail-fast: false\n    缓存策略\n      远程构建缓存\n      依赖安装缓存\n      artifacts 共享\n    最佳实践\n      concurrency 控制\n      timeout 设置\n      fetch-depth: 0</pre><ul>\n<li>affected-only 是 Monorepo CI 的核心策略，通过 Git diff + 依赖图只运行受影响的检查</li>\n<li>矩阵构建将不同包的检查分散到多个 CI 作业中，适合大型 Monorepo</li>\n<li>远程构建缓存 + 依赖安装缓存 + artifacts 共享，三层缓存机制最大化 CI 效率</li>\n<li>使用 <code>concurrency</code> 配置避免同一 PR 的多次推送触发重复 CI</li>\n<li>合理设置 <code>timeout-minutes</code> 防止失控的构建占用 CI 资源</li>\n</ul>\n","headings":[{"level":1,"text":"CI 流水线设计","id":"ci-流水线设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Monorepo CI 的核心挑战","id":"monorepo-ci-的核心挑战"},{"level":2,"text":"affected-only CI 策略","id":"affected-only-ci-策略"},{"level":2,"text":"矩阵构建策略","id":"矩阵构建策略"},{"level":2,"text":"构建产物共享","id":"构建产物共享"},{"level":2,"text":"Turbo 远程缓存在 CI 中的应用","id":"turbo-远程缓存在-ci-中的应用"},{"level":2,"text":"依赖安装缓存","id":"依赖安装缓存"},{"level":2,"text":"完整的 CI 流水线模板","id":"完整的-ci-流水线模板"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"代码质量工具","url":"/l-doc-books/h/devops-tools/monorepo-engineering/testing-and-quality/code-quality-tools"},"next":{"title":"依赖图分析","url":"/l-doc-books/h/devops-tools/monorepo-engineering/testing-and-quality/dependency-graph-analysis"}}