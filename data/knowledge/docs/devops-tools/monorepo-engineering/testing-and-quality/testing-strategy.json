un test --filter=...[origin/main]</code></td>\n</tr>\n<tr>\n<td>全量测试</td>\n<td>合并到 main</td>\n<td>所有包</td>\n<td><code>turbo run test</code></td>\n</tr>\n<tr>\n<td>E2E 测试</td>\n<td>每日/发布前</td>\n<td>应用层</td>\n<td>Playwright</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;scripts&quot;: {&#10;    &quot;test&quot;: &quot;turbo run test&quot;,&#10;    &quot;test:watch&quot;: &quot;vitest --watch&quot;,&#10;    &quot;test:coverage&quot;: &quot;turbo run test -- --coverage&quot;,&#10;    &quot;test:affected&quot;: &quot;turbo run test --filter=...[origin/main...HEAD]&quot;,&#10;    &quot;test:e2e&quot;: &quot;turbo run test:e2e --filter=./apps/*&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"scripts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"test\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"turbo run test\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"test:watch\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"vitest --watch\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"test:coverage\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"turbo run test -- --coverage\"</span><