span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  test: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    coverage: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      provider: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'v8'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      reporter: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'text-summary'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'lcov'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      reportsDirectory: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./coverage'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;scripts&quot;: {&#10;    &quot;test:coverage&quot;: &quot;vitest run --coverage --workspace&quot;,&#10;    &quot;coverage:merge&quot;: &quot;nyc merge coverage coverage/merged.json&quot;,&#10;    &quot;coverage:report&quot;: &quot;nyc report --reporter=html --temp-dir=coverage&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"scripts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"test:coverage\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"vitest run --coverage --workspace\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"coverage:merge\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"nyc merge coverage coverage/merged.json\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"coverage:report\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"nyc report --reporter=html --temp-dir=coverage\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((测试策略))&#10;    单元测试&#10;      包内逻辑&#10;      Vitest&#10;      共享配置&#10;    集成测试&#10;      包间交互&#10;      真实依赖&#10;      不 mock 内部包&#10;    E2E 测试&#10;      用户流程&#10;      Playwright&#10;      应用层&#10;    执行策略&#10;      affected-only PR&#10;      全量 main&#10;      watch 本地\">mindmap\n  root((测试策略))\n    单元测试\n      包内逻辑\n      Vitest\n      共享配置\n    集成测试\n      包间交互\n      真实依赖\n      不 mock 内部包\n    E2E 测试\n      用户流程\n      Playwright\n      应用层\n    执行策略\n      affected-only PR\n      全量 main\n      watch 本地</pre><ul>\n<li>Monorepo 测试金字塔：大量包内单元测试 + 适量包间集成测试 + 少量应用层 E2E 测试</li>\n<li>单元测试使用 Vitest + workspace 模式，每个包独立配置但共享基础设置</li>\n<li>集成测试应使用内部包的真实实现而非 mock，充分发挥 Monorepo 的优势</li>\n<li>PR 阶段使用 affected-only 策略只运行受影响包的测试，合并到 main 后全量运行</li>\n<li>覆盖率报告需要聚合各包的独立结果，生成全局覆盖率视图</li>\n</ul>\n","headings":[{"level":1,"text":"测试策略","id":"测试策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Monorepo 测试的分层模型","id":"monorepo-测试的分层模型"},{"level":2,"text":"单元测试：包内逻辑验证","id":"单元测试-包内逻辑验证"},{"level":3,"text":"共享测试配置","id":"共享测试配置"},{"level":2,"text":"集成测试：包间交互验证","id":"集成测试-包间交互验证"},{"level":2,"text":"E2E 测试：完整用户流程验证","id":"e2e-测试-完整用户流程验证"},{"level":2,"text":"测试执行策略","id":"测试执行策略"},{"level":2,"text":"覆盖率聚合","id":"覆盖率聚合"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"发布工作流","url":"/l-doc-books/h/devops-tools/monorepo-engineering/shared-packages/publishing-workflow"},"next":{"title":"代码质量工具","url":"/l-doc-books/h/devops-tools/monorepo-engineering/testing-and-quality/code-quality-tools"}}