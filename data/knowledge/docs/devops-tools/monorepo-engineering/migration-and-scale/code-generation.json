3\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { execSync } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'node:child_process'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> postGenerate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">packageName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Initializing @myorg/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">packageName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}...`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  execSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'pnpm install'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { stdio: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'inherit'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  execSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`pnpm turbo run build --filter=@myorg/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">packageName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    stdio: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'inherit'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  execSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`pnpm turbo run typecheck --filter=@myorg/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">packageName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    stdio: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'inherit'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`✅ @myorg/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">packageName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} is ready!`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>配置方式</th>\n<th>模板语法</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Plop</td>\n<td>plopfile.ts</td>\n<td>Handlebars</td>\n<td>灵活定制</td>\n</tr>\n<tr>\n<td>Hygen</td>\n<td>文件系统目录</td>\n<td>EJS</td>\n<td>零配置</td>\n</tr>\n<tr>\n<td>Turbo Gen</td>\n<td>turbo/generators/</td>\n<td>Handlebars</td>\n<td>Turborepo 项目</td>\n</tr>\n<tr>\n<td>Nx Generate</td>\n<td>project.json</td>\n<td>Schematics</td>\n<td>Nx 项目</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 选择哪个工具不重要，重要的是<strong>确保每个新包都通过脚手架创建</strong>。如果允许手动创建，约定就会逐渐被遗忘。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((代码生成))&#10;    Plop&#10;      plopfile.ts&#10;      Handlebars 模板&#10;      灵活配置&#10;    Hygen&#10;      文件系统模板&#10;      EJS 语法&#10;      零配置&#10;    Turbo Gen&#10;      Turborepo 内置&#10;      turbo gen 命令&#10;      Handlebars&#10;    最佳实践&#10;      强制使用脚手架&#10;      自动化后置步骤&#10;      标准化约定\">mindmap\n  root((代码生成))\n    Plop\n      plopfile.ts\n      Handlebars 模板\n      灵活配置\n    Hygen\n      文件系统模板\n      EJS 语法\n      零配置\n    Turbo Gen\n      Turborepo 内置\n      turbo gen 命令\n      Handlebars\n    最佳实践\n      强制使用脚手架\n      自动化后置步骤\n      标准化约定</pre><ul>\n<li>代码生成确保每个新包都遵循团队约定，避免手动创建导致的不一致</li>\n<li>Plop 适合需要灵活定制的场景，Hygen 适合偏好零配置的团队，Turbo Gen 适合 Turborepo 用户</li>\n<li>模板应覆盖 package.json、tsconfig.json、src/index.ts 和测试配置等关键文件</li>\n<li>生成后的自动化步骤（安装依赖、构建验证）确保新包立即可用</li>\n<li>强制所有新包通过脚手架创建是保持 Monorepo 一致性的关键制度约定</li>\n</ul>\n","headings":[{"level":1,"text":"代码生成","id":"代码生成"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"代码生成在 Monorepo 中的价值","id":"代码生成在-monorepo-中的价值"},{"level":2,"text":"Plop 脚手架","id":"plop-脚手架"},{"level":3,"text":"Plop 模板文件","id":"plop-模板文件"},{"level":2,"text":"Hygen 模板引擎","id":"hygen-模板引擎"},{"level":2,"text":"Turbo Gen（Turborepo 内置）","id":"turbo-gen-turborepo-内置"},{"level":2,"text":"初始化后的自动化步骤","id":"初始化后的自动化步骤"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"规模化挑战","url":"/l-doc-books/h/devops-tools/monorepo-engineering/migration-and-scale/scaling-challenges"},"next":{"title":"案例分析","url":"/l-doc-books/h/devops-tools/monorepo-engineering/migration-and-scale/case-studies"}}