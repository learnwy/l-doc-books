">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> INTERNAL_PACKAGES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (deps[name]) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        deps[name] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'workspace:*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  writeFileSync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(filePath, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pkg, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"迁移后验证\">迁移后验证</h2><p>迁移完成后，执行全面的验证确保一切正常：</p>\n<table>\n<thead>\n<tr>\n<th>验证项</th>\n<th>命令</th>\n<th>期望结果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>依赖安装</td>\n<td><code>pnpm install</code></td>\n<td>无报错</td>\n</tr>\n<tr>\n<td>类型检查</td>\n<td><code>pnpm turbo run typecheck</code></td>\n<td>零错误</td>\n</tr>\n<tr>\n<td>单元测试</td>\n<td><code>pnpm turbo run test</code></td>\n<td>全部通过</td>\n</tr>\n<tr>\n<td>构建</td>\n<td><code>pnpm turbo run build</code></td>\n<td>产物正确</td>\n</tr>\n<tr>\n<td>Lint</td>\n<td><code>pnpm turbo run lint</code></td>\n<td>零错误</td>\n</tr>\n<tr>\n<td>E2E 测试</td>\n<td><code>pnpm turbo run test:e2e</code></td>\n<td>全部通过</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 迁移后的第一周是&quot;观察期&quot;，保留旧仓库的只读副本，便于在发现问题时快速对照排查。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((多仓迁移))&#10;    策略选择&#10;      大爆炸迁移&#10;      渐进式迁移&#10;      混合式迁移&#10;    Git 历史&#10;      git filter-repo&#10;      git subtree&#10;      allow-unrelated-histories&#10;    渐进式计划&#10;      基础包优先&#10;      拓扑顺序&#10;      分阶段验证&#10;    依赖迁移&#10;      npm → workspace:*&#10;      自动化脚本&#10;      内部包识别\">mindmap\n  root((多仓迁移))\n    策略选择\n      大爆炸迁移\n      渐进式迁移\n      混合式迁移\n    Git 历史\n      git filter-repo\n      git subtree\n      allow-unrelated-histories\n    渐进式计划\n      基础包优先\n      拓扑顺序\n      分阶段验证\n    依赖迁移\n      npm → workspace:*\n      自动化脚本\n      内部包识别</pre><ul>\n<li>迁移策略应基于仓库数量和团队规模选择，渐进式迁移适合大多数场景</li>\n<li>使用 <code>git filter-repo</code> 保留完整的 Git 历史，是迁移中的关键步骤</li>\n<li>按依赖图的拓扑顺序从底层包开始迁移，确保每个阶段都可独立验证</li>\n<li>自动化脚本将旧的 npm 版本引用批量替换为 <code>workspace:*</code></li>\n<li>迁移后保留旧仓库的只读副本作为安全网，经过一段观察期后再归档</li>\n</ul>\n","headings":[{"level":1,"text":"多仓迁移","id":"多仓迁移"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"迁移策略选择","id":"迁移策略选择"},{"level":2,"text":"保留 Git 历史","id":"保留-git-历史"},{"level":3,"text":"方法一：git subtree","id":"方法一-git-subtree"},{"level":3,"text":"方法二：git filter-repo（推荐）","id":"方法二-git-filter-repo-推荐"},{"level":2,"text":"渐进式迁移计划","id":"渐进式迁移计划"},{"level":3,"text":"Phase 0：准备阶段","id":"phase-0-准备阶段"},{"level":3,"text":"Phase 1：迁移基础包","id":"phase-1-迁移基础包"},{"level":2,"text":"依赖引用迁移","id":"依赖引用迁移"},{"level":2,"text":"迁移后验证","id":"迁移后验证"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"依赖图分析","url":"/l-doc-books/h/devops-tools/monorepo-engineering/testing-and-quality/dependency-graph-analysis"},"next":{"title":"规模化挑战","url":"/l-doc-books/h/devops-tools/monorepo-engineering/migration-and-scale/scaling-challenges"}}