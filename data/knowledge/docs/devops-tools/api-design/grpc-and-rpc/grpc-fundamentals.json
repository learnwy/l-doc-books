index=\"0\"><code><span class=\"line\"><span>import \"google/rpc/error_details.proto\";</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 错误详情可以包含多种类型</span></span>\n<span class=\"line\"><span>// BadRequest: 字段级错误</span></span>\n<span class=\"line\"><span>// RetryInfo: 重试间隔</span></span>\n<span class=\"line\"><span>// DebugInfo: 调试信息（仅内部）</span></span></code></pre></div><h2 id=\"拦截器与中间件\">拦截器与中间件</h2><p>gRPC 的拦截器（Interceptor）等同于 HTTP 中间件，在请求处理前后执行横切逻辑。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface UnaryInterceptor {&#10;  (request: unknown, metadata: Metadata, next: UnaryHandler): Promise&lt;unknown&gt;;&#10;}&#10;&#10;const loggingInterceptor: UnaryInterceptor = async (request, metadata, next) =&gt; {&#10;  const start = Date.now();&#10;  const method = metadata.get(&#39;method&#39;)[0];&#10;&#10;  try {&#10;    const response = await next(request, metadata);&#10;    const duration = Date.now() - start;&#10;    console.log(`gRPC ${method} OK ${duration}ms`);&#10;    return response;&#10;  } catch (error) {&#10;    const duration = Date.now() - start;&#10;    console.error(`gRPC ${method} ERROR ${duration}ms`, error);&#10;    throw error;&#10;  }&#10;};&#10;&#10;const authInterceptor: UnaryInterceptor = async (request, metadata, next) =&gt; {&#10;  const token = metadata.get(&#39;authorization&#39;)[0];&#10;  if (!token) {&#10;    throw { code: 16, message: &#39;Missing authentication token&#39; };&#10;  }&#10;&#10;  const user = await validateToken(token as string);&#10;  metadata.set(&#39;user-id&#39;, user.id);&#10;  return next(request, metadata);&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UnaryInterceptor</span><