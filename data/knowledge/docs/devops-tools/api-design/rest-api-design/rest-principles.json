"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  message</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createErrorResponse</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">message</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">details</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ErrorDetail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Response</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> body</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ApiError</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    error: { code, message, details },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Response</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(body), {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    status,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    headers: { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Content-Type'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'application/json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"hateoas-与成熟度模型\">HATEOAS 与成熟度模型</h2><p>Richardson 成熟度模型将 REST API 分为四个级别。大多数实际 API 停留在 Level 2（HTTP 动词 + 资源），而 Level 3（HATEOAS）是真正的 REST。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph BT&#10;    A[Level 0: HTTP 隧道] --&gt; B[Level 1: 资源]&#10;    B --&gt; C[Level 2: HTTP 动词]&#10;    C --&gt; D[Level 3: HATEOAS]\">graph BT\n    A[Level 0: HTTP 隧道] --&gt; B[Level 1: 资源]\n    B --&gt; C[Level 2: HTTP 动词]\n    C --&gt; D[Level 3: HATEOAS]</pre><p>HATEOAS（Hypermedia As The Engine Of Application State）意味着 API 响应中包含下一步可执行操作的链接。客户端通过跟随链接导航，而不是硬编码 URL。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface HateoasResponse&lt;T&gt; {&#10;  data: T;&#10;  _links: Record&lt;string, HateoasLink&gt;;&#10;}&#10;&#10;interface HateoasLink {&#10;  href: string;&#10;  method: string;&#10;  title: string;&#10;}&#10;&#10;const userResponse: HateoasResponse&lt;User&gt; = {&#10;  data: { id: 123, name: &#39;Alice&#39;, email: &#39;alice@example.com&#39; },&#10;  _links: {&#10;    self: { href: &#39;/users/123&#39;, method: &#39;GET&#39;, title: &#39;当前用户&#39; },&#10;    update: { href: &#39;/users/123&#39;, method: &#39;PUT&#39;, title: &#39;更新用户&#39; },&#10;    delete: { href: &#39;/users/123&#39;, method: &#39;DELETE&#39;, title: &#39;删除用户&#39; },&#10;    orders: { href: &#39;/users/123/orders&#39;, method: &#39;GET&#39;, title: &#39;用户订单&#39; },&#10;  },&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HateoasResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  _links</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Record</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">HateoasLink</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HateoasLink</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  href</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  method</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  title</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> userResponse</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HateoasResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  data: { id: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">123</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Alice'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'alice@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  _links: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    self: { href: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/users/123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'GET'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'当前用户'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    update: { href: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/users/123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'PUT'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'更新用户'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    delete: { href: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/users/123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'DELETE'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'删除用户'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    orders: { href: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/users/123/orders'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'GET'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'用户订单'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>HATEOAS 在实际项目中的采用率不高，但在对外公开 API 和长生命周期系统中很有价值——它让客户端不依赖硬编码的 URL 结构，API 演进更灵活。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>REST 是架构风格而非协议，核心是六个约束条件，其中无状态和统一接口最关键</li>\n<li>HTTP 方法的安全性和幂等性语义决定了重试和缓存策略</li>\n<li>URL 设计以名词（资源）为核心，HTTP 方法表达操作，嵌套不超过 2 层</li>\n<li>状态码是 REST 的语义载体——401 是未认证，403 是无权限，不可混淆</li>\n<li>Richardson 成熟度模型分四级，Level 2 是实际标准，Level 3（HATEOAS）是理想目标</li>\n</ul>\n","headings":[{"level":1,"text":"REST 设计原则","id":"rest-设计原则"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"HTTP 方法语义","id":"http-方法语义"},{"level":2,"text":"URL 设计规范","id":"url-设计规范"},{"level":2,"text":"状态码最佳实践","id":"状态码最佳实践"},{"level":2,"text":"HATEOAS 与成熟度模型","id":"hateoas-与成熟度模型"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"资源建模","url":"/l-doc-books/h/devops-tools/api-design/rest-api-design/resource-modeling"}}