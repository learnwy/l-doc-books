ring</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>分页有两种主流模式：</p>\n<table>\n<thead>\n<tr>\n<th>分页方式</th>\n<th>实现</th>\n<th>优势</th>\n<th>劣势</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>偏移分页</td>\n<td><code>?page=2&amp;per_page=20</code></td>\n<td>可跳页</td>\n<td>深分页性能差</td>\n</tr>\n<tr>\n<td>游标分页</td>\n<td><code>?cursor=abc&amp;limit=20</code></td>\n<td>性能稳定</td>\n<td>不可跳页</td>\n</tr>\n</tbody></table>\n<p>游标分页使用最后一条记录的标识作为起始点，数据库可以利用索引高效查询。对于无限滚动和大数据集场景，游标分页是更好的选择。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface CursorPagination&lt;T&gt; {&#10;  data: T[];&#10;  pageInfo: {&#10;    hasNextPage: boolean;&#10;    hasPreviousPage: boolean;&#10;    startCursor: string;&#10;    endCursor: string;&#10;  };&#10;}&#10;&#10;const encodeCursor = (id: string, sortValue: string): string =&gt; {&#10;  return Buffer.from(JSON.stringify({ id, sortValue })).toString(&#39;base64url&#39;);&#10;};&#10;&#10;const decodeCursor = (cursor: string): { id: string; sortValue: string } =&gt; {&#10;  return JSON.parse(Buffer.from(cursor, &#39;base64url&#39;).toString());&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CursorPagination</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span>