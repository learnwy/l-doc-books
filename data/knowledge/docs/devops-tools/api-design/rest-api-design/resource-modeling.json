-shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  summary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    total</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    succeeded</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    failed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> BatchResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  index</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  body</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  error</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ApiError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// POST /users/batch</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 返回 207 Multi-Status，每个操作独立的状态码</span></span></code></pre></div><p>批量操作的状态码选择：</p>\n<ul>\n<li><strong>200</strong>：所有操作都成功</li>\n<li><strong>207 Multi-Status</strong>：部分成功部分失败（推荐）</li>\n<li><strong>400</strong>：请求格式错误</li>\n<li><strong>413</strong>：批量大小超限</li>\n</ul>\n<h2 id=\"小结\">小结</h2><ul>\n<li>资源建模面向使用场景而非数据库表——API 是给消费者用的，不是暴露实现的</li>\n<li>粒度设计的核心是避免 N+1 和 over-fetching，子资源和聚合资源是两种工具</li>\n<li>嵌套表示强归属（不超过 2 层），引用表示弱关联，<code>?expand</code> 参数提供灵活性</li>\n<li>游标分页在性能和大数据集场景优于偏移分页，是无限滚动的标准选择</li>\n<li>批量操作使用 207 Multi-Status 处理部分成功场景，每个操作独立报告状态</li>\n</ul>\n","headings":[{"level":1,"text":"资源建模","id":"资源建模"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"资源粒度设计","id":"资源粒度设计"},{"level":2,"text":"关系与嵌套","id":"关系与嵌套"},{"level":2,"text":"集合操作设计","id":"集合操作设计"},{"level":2,"text":"批量操作","id":"批量操作"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"REST 设计原则","url":"/l-doc-books/h/devops-tools/api-design/rest-api-design/rest-principles"},"next":{"title":"API 版本管理","url":"/l-doc-books/h/devops-tools/api-design/rest-api-design/api-versioning"}}