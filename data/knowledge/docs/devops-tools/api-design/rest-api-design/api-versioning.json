r:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><p>废弃的标准做法是在响应 Header 中添加 <code>Deprecation</code> 和 <code>Sunset</code> 标头：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const deprecationMiddleware = (deprecatedAt: string, sunsetAt: string) =&gt; {&#10;  return async (c: Context, next: Next) =&gt; {&#10;    await next();&#10;    c.header(&#39;Deprecation&#39;, deprecatedAt);&#10;    c.header(&#39;Sunset&#39;, sunsetAt);&#10;    c.header(&#39;Link&#39;, &#39;&lt;/docs/migration&gt;; rel=&quot;deprecation&quot;&#39;);&#10;  };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> deprecationMiddleware</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">deprecatedAt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sunsetAt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">next</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">header</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Deprecation'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, deprecatedAt);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">header</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Sunset'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, sunsetAt);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">header</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Link'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'&#x3C;/docs/migration>; rel=\"deprecation\"'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>生命周期阶段</th>\n<th>时长</th>\n<th>行为</th>\n<th>通知方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Active</td>\n<td>持续</td>\n<td>正常服务</td>\n<td>无</td>\n</tr>\n<tr>\n<td>Deprecated</td>\n<td>6-12个月</td>\n<td>正常服务 + 废弃警告</td>\n<td>Header + 邮件 + 控制台</td>\n</tr>\n<tr>\n<td>Sunset</td>\n<td>1-3个月</td>\n<td>降级服务 + 强警告</td>\n<td>所有渠道</td>\n</tr>\n<tr>\n<td>Removed</td>\n<td>永久</td>\n<td>返回 410 Gone</td>\n<td>最终通知</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>API 版本管理的核心是不破坏现有客户端，向后兼容变更可以直接发布</li>\n<li>URL 路径版本最直观通用，日期版本适合长期演进的复杂 API</li>\n<li>兼容性黄金法则：只增不减、只松不紧——新增字段、新增端点、新增枚举值是安全的</li>\n<li>版本转换层（Transform）支持在单一代码库中维护多个版本行为</li>\n<li>废弃流程需要明确的时间线（Active → Deprecated → Sunset → Removed）和多渠道通知</li>\n</ul>\n","headings":[{"level":1,"text":"API 版本管理","id":"api-版本管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"兼容性变更分类","id":"兼容性变更分类"},{"level":2,"text":"版本实现策略","id":"版本实现策略"},{"level":2,"text":"废弃与下线","id":"废弃与下线"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"资源建模","url":"/l-doc-books/h/devops-tools/api-design/rest-api-design/resource-modeling"},"next":{"title":"错误处理","url":"/l-doc-books/h/devops-tools/api-design/rest-api-design/error-handling"}}