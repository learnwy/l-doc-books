n style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (errors.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { data: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, userErrors: errors };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> order</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orderService.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(input);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { data: order, userErrors: [] };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><h2 id=\"schema-演进\">Schema 演进</h2><p>Schema 演进需要向后兼容。GraphQL 的 <code>@deprecated</code> 指令提供了标准的废弃机制：</p>\n<div class=\"code-block-wrapper\" data-lang=\"graphql\" data-code=\"type User {&#10;  id: ID!&#10;  name: String! @deprecated(reason: &quot;Use displayName instead&quot;)&#10;  displayName: String!&#10;  email: String! @deprecated(reason: &quot;Use emailAddress instead&quot;)&#10;  emailAddress: String!&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>type User {</span></span>\n<span class=\"line\"><span>  id: ID!</span></span>\n<span class=\"line\"><span>  name: String! @deprecated(reason: \"Use displayName instead\")</span></span>\n<span class=\"line\"><span>  displayName: String!</span></span>\n<span class=\"line\"><span>  email: String! @deprecated(reason: \"Use emailAddress instead\")</span></span>\n<span class=\"line\"><span>  emailAddress: String!</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>变更类型</th>\n<th>兼容性</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>添加可选字段</td>\n<td>✅ 兼容</td>\n<td>添加 <code>avatar: String</code></td>\n</tr>\n<tr>\n<td>添加可选参数</td>\n<td>✅ 兼容</td>\n<td>添加 <code>filter: UserFilter</code></td>\n</tr>\n<tr>\n<td>废弃字段</td>\n<td>✅ 兼容</td>\n<td><code>@deprecated</code></td>\n</tr>\n<tr>\n<td>删除字段</td>\n<td>❌ 破坏</td>\n<td>移除 <code>name</code> 字段</td>\n</tr>\n<tr>\n<td>修改字段类型</td>\n<td>❌ 破坏</td>\n<td><code>id: Int!</code> → <code>id: String!</code></td>\n</tr>\n<tr>\n<td>添加非空字段</td>\n<td>❌ 破坏</td>\n<td>已有类型添加 <code>required: String!</code></td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Schema 设计面向业务领域而非数据库——好的 Schema 是自文档化的产品接口</li>\n<li>Schema First 适合跨团队协作，Code First 适合全栈团队，都需要代码生成</li>\n<li>Relay Connection 规范是分页的事实标准，<code>Connection → Edge → Node</code> 三层结构</li>\n<li>Input/Payload + UserError 模式是 Mutation 设计的最佳实践</li>\n<li>Schema 演进遵循&quot;只增不减&quot;原则，<code>@deprecated</code> 提供标准废弃机制</li>\n</ul>\n","headings":[{"level":1,"text":"Schema 设计","id":"schema-设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"命名与约定","id":"命名与约定"},{"level":2,"text":"Relay 连接规范","id":"relay-连接规范"},{"level":2,"text":"Mutation 设计模式","id":"mutation-设计模式"},{"level":2,"text":"Schema 演进","id":"schema-演进"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"GraphQL 基础","url":"/l-doc-books/h/devops-tools/api-design/graphql/graphql-fundamentals"},"next":{"title":"GraphQL 性能模式","url":"/l-doc-books/h/devops-tools/api-design/graphql/performance-patterns"}}