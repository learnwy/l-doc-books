oad {</span></span>\n<span class=\"line\"><span>  order: Order</span></span>\n<span class=\"line\"><span>  userErrors: [UserError!]!</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>type UserError {</span></span>\n<span class=\"line\"><span>  field: [String!]</span></span>\n<span class=\"line\"><span>  message: String!</span></span>\n<span class=\"line\"><span>  code: ErrorCode!</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>enum ErrorCode {</span></span>\n<span class=\"line\"><span>  INVALID_INPUT</span></span>\n<span class=\"line\"><span>  NOT_FOUND</span></span>\n<span class=\"line\"><span>  INSUFFICIENT_STOCK</span></span>\n<span class=\"line\"><span>  COUPON_EXPIRED</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><p><strong>UserError 模式</strong>是 Shopify 推广的最佳实践——将业务错误作为 Payload 的一部分返回（而不是 GraphQL 错误），这样客户端可以精确地将错误消息绑定到对应的表单字段。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MutationPayload&lt;T&gt; {&#10;  data: T | null;&#10;  userErrors: UserError[];&#10;}&#10;&#10;interface UserError {&#10;  field: string[];&#10;  message: string;&#10;  code: string;&#10;}&#10;&#10;const createOrder = async (input: CreateOrderInput): Promise&lt;MutationPayload&lt;Order&gt;&gt; =&gt; {&#10;  const errors: UserError[] = [];&#10;&#10;  const stock = await checkStock(input.items);&#10;  if (!stock.sufficient) {&#10;    errors.push({&#10;      field: [&#39;items&#39;],&#10;      message: &#39;库存不足&#39;,&#10;      code: &#39;INSUFFICIENT_STOCK&#39;,&#10;    });&#10;  }&#10;&#10;  if (input.couponCode) {&#10;    const coupon = await validateCoupon(input.couponCode);&#10;    if (!coupon.valid) {&#10;      errors.push({&#10;        field: [&#39;couponCode&#39;],&#10;        message: &#39;优惠券已过期&#39;,&#10;        code: &#39;COUPON_EXPIRED&#39;,&#10;      });&#10;    }&#10;  }&#10;&#10;  if (errors.length &gt; 0) {&#10;    return { data: null, userErrors: errors };&#10;  }&#10;&#10;  const order = await orderService.create(input);&#10;  return { data: order, userErrors: [] };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MutationPayload</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  userErrors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  field</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span st