or:#22863A;--shiki-dark:#85E89D\">  script</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">opa test policy/ -v</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">opa exec --decision data.pipelines.allow --bundle policy/ k8s/</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  artifacts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    reports</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      sast</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">gl-sast-report.json</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">conftest-iac</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  stage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">policy</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  image</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">instrumenta/conftest:v0.50.0</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  script</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">conftest test terraform/plan.json --all-namespaces</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  allow_failure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">deploy-production</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  stage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">deploy</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  script</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">kubectl apply -f k8s/</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  rules</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">$CI_COMMIT_BRANCH == \"main\"</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  when</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">manual</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> # 手动审批作为最后一道门禁</span></span></code></pre></div><hr>\n<h2 id=\"策略门禁的高级模式\">策略门禁的高级模式</h2><h3 id=\"基于变更范围的条件检查\">基于变更范围的条件检查</h3><p>不是每次流水线运行都需要执行所有策略检查。根据变更内容动态决定运行哪些检查，可以提高流水线效率。</p>\n<div class=\"code-block-wrapper\" data-lang=\"rego\" data-code=\"package pipelines&#10;&#10;import future.keywords.if&#10;&#10;# 变更涉及 Terraform 文件时才运行 IaC 策略检查&#10;iac_check_required if {&#10;    file := input.changed_files[_]&#10;    endswith(file, &quot;.tf&quot;)&#10;}&#10;&#10;# 变更涉及 Kubernetes 文件时才运行 K8s 策略检查&#10;k8s_check_required if {&#10;    file := input.changed_files[_]&#10;    startswith(file, &quot;k8s/&quot;)&#10;}&#10;&#10;# 安全敏感文件变更需要额外审批&#10;security_approval_required if {&#10;    file := input.changed_files[_]&#10;    security_sensitive_file(file)&#10;}&#10;&#10;security_sensitive_file(f) if {&#10;    contains(f, &quot;iam_&quot;)&#10;}&#10;&#10;security_sensitive_file(f) if {&#10;    contains(f, &quot;security_group&quot;)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>package pipelines</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>import future.keywords.if</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># 变更涉及 Terraform 文件时才运行 IaC 策略检查</span></span>\n<span class=\"line\"><span>iac_check_required if {</span></span>\n<span class=\"line\"><span>    file := input.changed_files[_]</span></span>\n<span class=\"line\"><span>    endswith(file, \".tf\")</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># 变更涉及 Kubernetes 文件时才运行 K8s 策略检查</span></span>\n<span class=\"line\"><span>k8s_check_required if {</span></span>\n<span class=\"line\"><span>    file := input.changed_files[_]</span></span>\n<span class=\"line\"><span>    startswith(file, \"k8s/\")</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># 安全敏感文件变更需要额外审批</span></span>\n<span class=\"line\"><span>security_approval_required if {</span></span>\n<span class=\"line\"><span>    file := input.changed_files[_]</span></span>\n<span class=\"line\"><span>    security_sensitive_file(file)</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>security_sensitive_file(f) if {</span></span>\n<span class=\"line\"><span>    contains(f, \"iam_\")</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>security_sensitive_file(f) if {</span></span>\n<span class=\"line\"><span>    contains(f, \"security_group\")</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h3 id=\"基于风险的动态门禁\">基于风险的动态门禁</h3><p>根据变更的风险级别动态调整策略严格程度。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    C[代码变更] --&gt; R{风险评估}&#10;    R --&gt; |低风险&lt;br/&gt;文档/注释| L1[基础检查通过即可]&#10;    R --&gt; |中风险&lt;br/&gt;应用代码| L2[完整策略检查]&#10;    R --&gt; |高风险&lt;br/&gt;IAM/安全组| L3[完整检查 + 人工审批]\">graph TD\n    C[代码变更] --&gt; R{风险评估}\n    R --&gt; |低风险&lt;br/&gt;文档/注释| L1[基础检查通过即可]\n    R --&gt; |中风险&lt;br/&gt;应用代码| L2[完整策略检查]\n    R --&gt; |高风险&lt;br/&gt;IAM/安全组| L3[完整检查 + 人工审批]</pre><table>\n<thead>\n<tr>\n<th>风险级别</th>\n<th>判定条件</th>\n<th>门禁要求</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>低风险</td>\n<td>仅修改文档、测试、注释</td>\n<td>快速检查，可跳过部分策略</td>\n</tr>\n<tr>\n<td>中风险</td>\n<td>修改应用代码、配置文件</td>\n<td>完整策略检查套件</td>\n</tr>\n<tr>\n<td>高风险</td>\n<td>修改 IAM、安全组、网络策略</td>\n<td>完整检查 + 至少 2 人审批 + 安全团队审查</td>\n</tr>\n</tbody></table>\n<h3 id=\"策略豁免机制\">策略豁免机制</h3><p>在特定场景下需要临时豁免某些策略。豁免机制应该是显式的、可审计的。</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# 在 PR 描述中声明豁免（需要特定角色审批）&#10;&lt;!-- policy-exemptions: require-resource-limits --&gt;&#10;&lt;!-- exemption-reason: 这是一次性数据迁移 Job，不需要长期运行 --&gt;&#10;&lt;!-- exemption-expires: 2026-08-01 --&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 在 PR 描述中声明豁免（需要特定角色审批）</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">&#x3C;!-- policy-exemptions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">require-resource-limits --></span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">&#x3C;!-- exemption-reason</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">这是一次性数据迁移 Job，不需要长期运行 --></span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">&#x3C;!-- exemption-expires</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">2026-08-01 --></span></span></code></pre></div><p>豁免的最佳实践：</p>\n<ul>\n<li>豁免必须有明确的过期时间</li>\n<li>豁免需要记录原因和审批人</li>\n<li>定期审查未过期的豁免列表</li>\n<li>豁免操作应记录到审计日志</li>\n</ul>\n<hr>\n<h2 id=\"门禁效果度量\">门禁效果度量</h2><p>策略门禁的有效性需要通过指标来衡量和持续改进。</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>计算方式</th>\n<th>目标方向</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>拦截率</td>\n<td>被策略阻止的部署次数 / 总部署次数</td>\n<td>初期上升，稳定后趋于平稳</td>\n</tr>\n<tr>\n<td>平均修复时间</td>\n<td>从策略拦截到修复通过的平均时间</td>\n<td>持续降低</td>\n</tr>\n<tr>\n<td>策略覆盖率</td>\n<td>有策略检查的流水线 / 总流水线数</td>\n<td>持续提升</td>\n</tr>\n<tr>\n<td>误报率</td>\n<td>被人工覆盖的策略失败 / 总策略失败</td>\n<td>持续降低</td>\n</tr>\n<tr>\n<td>流水线时长增加</td>\n<td>引入策略检查前后的流水线时长差</td>\n<td>控制在可接受范围（&lt; 10%）</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    M[策略门禁度量] --&gt; M1[拦截率&lt;br/&gt;有效性]&#10;    M --&gt; M2[修复时间&lt;br/&gt;开发者体验]&#10;    M --&gt; M3[误报率&lt;br/&gt;策略质量]&#10;    M --&gt; M4[覆盖率&lt;br/&gt;治理广度]\">graph LR\n    M[策略门禁度量] --&gt; M1[拦截率&lt;br/&gt;有效性]\n    M --&gt; M2[修复时间&lt;br/&gt;开发者体验]\n    M --&gt; M3[误报率&lt;br/&gt;策略质量]\n    M --&gt; M4[覆盖率&lt;br/&gt;治理广度]</pre><blockquote>\n<p><strong>关键平衡：</strong> 策略门禁的严格程度和开发者体验之间需要平衡。过于严格的门禁会降低交付速度，过于宽松则失去治理意义。建议从宽松开始，随着策略成熟度提升逐步收紧，并通过降低误报率和缩短修复时间来减轻对开发者的影响。</p>\n</blockquote>\n<p>CI/CD 策略门禁是将策略检查自动化的核心手段。要确保策略本身的质量和可靠性，还需要建立完善的<a href=\"../pac-operations/policy-testing\">策略测试与验证</a>体系。</p>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((CI/CD 策略门禁))&#10;    检查点分布&#10;      Pre-commit&#10;      CI 安全扫描&#10;      制品扫描&#10;      部署计划检查&#10;      运行时持续审计&#10;    策略分级&#10;      Blocker 阻塞&#10;      Error 可覆盖&#10;      Warning 警告&#10;      Info 信息&#10;    平台集成&#10;      GitHub Actions&#10;      GitLab CI&#10;      状态检查&#10;    高级模式&#10;      条件检查&#10;      风险分级门禁&#10;      策略豁免机制&#10;    效果度量&#10;      拦截率&#10;      修复时间&#10;      误报率&#10;      覆盖率\">mindmap\n  root((CI/CD 策略门禁))\n    检查点分布\n      Pre-commit\n      CI 安全扫描\n      制品扫描\n      部署计划检查\n      运行时持续审计\n    策略分级\n      Blocker 阻塞\n      Error 可覆盖\n      Warning 警告\n      Info 信息\n    平台集成\n      GitHub Actions\n      GitLab CI\n      状态检查\n    高级模式\n      条件检查\n      风险分级门禁\n      策略豁免机制\n    效果度量\n      拦截率\n      修复时间\n      误报率\n      覆盖率</pre><ul>\n<li>策略门禁应分布在流水线的多个检查点（Pre-commit → CI → 制品 → 部署 → 运行时），形成纵深防御。</li>\n<li>策略按严重度分为 Blocker/Error/Warning/Info 四级，不同级别有不同的流水线行为。</li>\n<li>清晰的反馈机制（流水线日志、PR 评论、状态检查、SARIF）是策略门禁可用性的关键。</li>\n<li>基于变更范围和风险级别的动态门禁可以平衡安全性和流水线效率。</li>\n<li>策略豁免机制必须显式、可审计、有过期时间。</li>\n<li>通过拦截率、修复时间、误报率等指标持续度量和改进门禁效果。</li>\n</ul>\n","headings":[{"level":1,"text":"CI/CD 策略门禁","id":"ci-cd-策略门禁"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"策略门禁在流水线中的位置","id":"策略门禁在流水线中的位置"},{"level":2,"text":"门禁策略设计","id":"门禁策略设计"},{"level":3,"text":"策略严重度分级","id":"策略严重度分级"},{"level":3,"text":"策略门禁的反馈机制","id":"策略门禁的反馈机制"},{"level":2,"text":"GitHub Actions 集成","id":"github-actions-集成"},{"level":3,"text":"完整流水线示例","id":"完整流水线示例"},{"level":3,"text":"必需状态检查配置","id":"必需状态检查配置"},{"level":2,"text":"GitLab CI 集成","id":"gitlab-ci-集成"},{"level":2,"text":"策略门禁的高级模式","id":"策略门禁的高级模式"},{"level":3,"text":"基于变更范围的条件检查","id":"基于变更范围的条件检查"},{"level":3,"text":"基于风险的动态门禁","id":"基于风险的动态门禁"},{"level":3,"text":"策略豁免机制","id":"策略豁免机制"},{"level":2,"text":"门禁效果度量","id":"门禁效果度量"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Terraform 与 Sentinel/Conftest","url":"/l-doc-books/h/devops-tools/policy-as-code/pac-platforms/terraform-sentinel-conftest"},"next":{"title":"策略测试与验证","url":"/l-doc-books/h/devops-tools/policy-as-code/pac-operations/policy-testing"}}