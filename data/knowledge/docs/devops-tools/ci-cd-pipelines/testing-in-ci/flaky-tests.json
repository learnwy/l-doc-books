n></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> server</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setupServer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">handlers);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">beforeAll</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> server.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">listen</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">afterEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> server.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">resetHandlers</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">afterAll</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> server.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span></code></pre></div><h2 id=\"预防机制\">预防机制</h2><p>预防优于治疗。在开发流程中嵌入防 flaky 机制：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"- name: Stress test new tests&#10;  if: github.event_name == &#39;pull_request&#39;&#10;  run: |&#10;    NEW_TESTS=$(git diff --name-only HEAD~1 | grep &#39;\\.test\\.&#39; || true)&#10;    if [ -n &quot;$NEW_TESTS&quot; ]; then&#10;      for i in $(seq 1 5); do&#10;        echo &quot;Run $i/5&quot;&#10;        echo &quot;$NEW_TESTS&quot; | xargs pnpm vitest --run&#10;      done&#10;    fi\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">- </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Stress test new tests</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">github.event_name == 'pull_request'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    NEW_TESTS=$(git diff --name-only HEAD~1 | grep '\\.test\\.' || true)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    if [ -n \"$NEW_TESTS\" ]; then</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      for i in $(seq 1 5); do</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        echo \"Run $i/5\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        echo \"$NEW_TESTS\" | xargs pnpm vitest --run</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      done</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    fi</span></span></code></pre></div><p>这个策略对 PR 中新增的测试文件运行 5 次。如果新测试在 5 次运行中有任何一次失败，就在合并前暴露 flaky 问题。</p>\n<table>\n<thead>\n<tr>\n<th>预防措施</th>\n<th>实施阶段</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>PR 新测试多次运行</td>\n<td>PR 审查</td>\n<td>在合并前发现 flaky</td>\n</tr>\n<tr>\n<td>确定性时钟（fake timers）</td>\n<td>编码</td>\n<td>消除时间依赖</td>\n</tr>\n<tr>\n<td>测试隔离（事务回滚）</td>\n<td>编码</td>\n<td>消除状态污染</td>\n</tr>\n<tr>\n<td>MSW/VCR Mock</td>\n<td>编码</td>\n<td>消除网络依赖</td>\n</tr>\n<tr>\n<td>定期 flaky 审查</td>\n<td>周维护</td>\n<td>控制积压</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Flaky 测试占大型代码库测试失败的 84%，是 CI 信任度的最大杀手</li>\n<li>检测 flaky 的标准方法是自动重试——重试通过的失败即为 flaky</li>\n<li>隔离（Quarantine）将 flaky 从关键路径移出，但必须设置修复期限（14 天）</li>\n<li>时序问题用显式等待替代固定延迟，共享状态用事务回滚隔离，外部依赖用 MSW Mock</li>\n<li>PR 中对新测试运行多次是最有效的预防机制——在合并前暴露 flaky</li>\n</ul>\n","headings":[{"level":1,"text":"Flaky 测试治理","id":"flaky-测试治理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"检测与识别","id":"检测与识别"},{"level":2,"text":"隔离与治理","id":"隔离与治理"},{"level":2,"text":"常见根因修复","id":"常见根因修复"},{"level":2,"text":"预防机制","id":"预防机制"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"并行测试","url":"/l-doc-books/h/devops-tools/ci-cd-pipelines/testing-in-ci/parallel-testing"},"next":{"title":"蓝绿部署","url":"/l-doc-books/h/devops-tools/ci-cd-pipelines/deployment-strategies/blue-green"}}