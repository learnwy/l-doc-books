<span style=\"color:#005CC5;--shiki-dark:#79B8FF\">9999</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"测试生命周期中的数据管理\">测试生命周期中的数据管理</h3><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>动作</th>\n<th>方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Setup（beforeEach）</td>\n<td>创建本测试需要的数据</td>\n<td>API 调用 / Factory</td>\n</tr>\n<tr>\n<td>Execution（test）</td>\n<td>使用数据执行操作</td>\n<td>页面交互</td>\n</tr>\n<tr>\n<td>Assertion（expect）</td>\n<td>验证数据状态变化</td>\n<td>API 查询或 UI 验证</td>\n</tr>\n<tr>\n<td>Teardown（afterEach）</td>\n<td>清理创建的数据</td>\n<td>API 删除 / 标记过期</td>\n</tr>\n</tbody></table>\n<h2 id=\"工厂模式-factory-pattern\">工厂模式（Factory Pattern）</h2><p>数据工厂集中管理测试数据的创建逻辑，提供合理默认值并允许覆盖：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// fixtures/factories/user.factory.ts&#10;interface UserFactoryOptions {&#10;  role?: &#39;admin&#39; | &#39;user&#39; | &#39;guest&#39;;&#10;  verified?: boolean;&#10;  subscription?: &#39;free&#39; | &#39;pro&#39; | &#39;enterprise&#39;;&#10;}&#10;&#10;export class UserFactory {&#10;  constructor(private readonly api: TestApiHelper) {}&#10;&#10;  async create(options: UserFactoryOptions = {}): Promise&lt;TestUser&gt; {&#10;    const defaults = {&#10;      role: &#39;user&#39; as const,&#10;      verified: true,&#10;      subscription: &#39;free&#39; as const,&#10;    };&#10;    const config = { ...defaults, ...options };&#10;&#10;    const user = await this.api.createUser({&#10;      email: uniqueEmail(),&#10;      role: config.role,&#10;      emailVerified: config.verified,&#10;    });&#10;&#10;    if (config.subscription !== &#39;free&#39;) {&#10;      await this.api.createSubscription(user.id, config.subscription);&#10;    }&#10;&#10;    return { ...user, password: &#39;TestPassword123!&#39; };&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// fixtures/factories/user.factory.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserFactoryOptions</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  role</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'admin'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'user'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'guest'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  verified</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  subscription</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'free'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pro'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'enterprise'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></sp