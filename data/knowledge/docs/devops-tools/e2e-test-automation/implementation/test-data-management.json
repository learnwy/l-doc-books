E;--shiki-dark:#E1E4E8\">.api.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      email: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">uniqueEmail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      role: config.role,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      emailVerified: config.verified,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (config.subscription </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'free'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.api.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createSubscription</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user.id, config.subscription);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">user, password: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'TestPassword123!'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"环境数据管理\">环境数据管理</h2><h3 id=\"种子数据-seed-data\">种子数据（Seed Data）</h3><p>静态参考数据（国家列表、商品分类、配置项）通过种子脚本管理：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// scripts/seed-test-data.ts&#10;export async function seedTestEnvironment(db: Database): Promise&lt;void&gt; {&#10;  await db.categories.createMany([&#10;    { id: &#39;cat-electronics&#39;, name: &#39;电子产品&#39; },&#10;    { id: &#39;cat-clothing&#39;, name: &#39;服装&#39; },&#10;    { id: &#39;cat-books&#39;, name: &#39;图书&#39; },&#10;  ]);&#10;&#10;  await db.products.createMany([&#10;    { id: &#39;prod-001&#39;, categoryId: &#39;cat-electronics&#39;, name: &#39;测试手机&#39;, price: 2999 },&#10;    { id: &#39;prod-002&#39;, categoryId: &#39;cat-clothing&#39;, name: &#39;测试T恤&#39;, price: 99 },&#10;  ]);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// scripts/seed-test-data.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> seedTestEnvironment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Database</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.categories.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createMany</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cat-electronics'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'电子产品'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cat-clothing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'服装'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cat-books'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'图书'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.products.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createMany</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'prod-001'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, categoryId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cat-electronics'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'测试手机'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, price: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2999</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'prod-002'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, categoryId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cat-clothing'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'测试T恤'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, price: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">99</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"数据脱敏\">数据脱敏</h3><p>从生产导出数据用于测试时，必须经过脱敏处理：</p>\n<table>\n<thead>\n<tr>\n<th>字段类型</th>\n<th>脱敏方法</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>姓名</td>\n<td>随机替换</td>\n<td>张三 → 测试用户A</td>\n</tr>\n<tr>\n<td>邮箱</td>\n<td>哈希+固定域名</td>\n<td><a href=\"mailto:user@real.com\">user@real.com</a> → <a href=\"mailto:hash@test.example\">hash@test.example</a></td>\n</tr>\n<tr>\n<td>手机号</td>\n<td>保留前三位+随机</td>\n<td>138xxxx1234 → 138xxxx5678</td>\n</tr>\n<tr>\n<td>地址</td>\n<td>模糊化到区级</td>\n<td>具体门牌 → 某区某路</td>\n</tr>\n<tr>\n<td>银行卡号</td>\n<td>测试卡号替换</td>\n<td>真实卡号 → 4111111111111111</td>\n</tr>\n</tbody></table>\n<h2 id=\"状态管理\">状态管理</h2><h3 id=\"认证状态复用\">认证状态复用</h3><p>登录是 E2E 测试中最频繁的前置步骤。通过 <code>storageState</code> 复用认证状态可以节省大量时间：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// global-setup.ts&#10;async function globalSetup(config: FullConfig): Promise&lt;void&gt; {&#10;  const browser = await chromium.launch();&#10;  const page = await browser.newPage();&#10;&#10;  // 一次登录，保存状态&#10;  await page.goto(&#39;/login&#39;);&#10;  await page.getByLabel(&#39;邮箱&#39;).fill(ADMIN_EMAIL);&#10;  await page.getByLabel(&#39;密码&#39;).fill(ADMIN_PASSWORD);&#10;  await page.getByRole(&#39;button&#39;, { name: &#39;登录&#39; }).click();&#10;  await page.waitForURL(&#39;/dashboard&#39;);&#10;&#10;  // 保存认证状态&#10;  await page.context().storageState({ path: &#39;.auth/admin.json&#39; });&#10;  await browser.close();&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// global-setup.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> globalSetup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FullConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> browser</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chromium.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">launch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> browser.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">newPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 一次登录，保存状态</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">goto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/login'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByLabel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'邮箱'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fill</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ADMIN_EMAIL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByLabel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'密码'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fill</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ADMIN_PASSWORD</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByRole</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'button'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'登录'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">click</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">waitForURL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/dashboard'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 保存认证状态</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">storageState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ path: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'.auth/admin.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> browser.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"storagestate-过期处理\">storageState 过期处理</h3><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>实现</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>每次 CI 运行重新生成</td>\n<td>Global Setup</td>\n<td>短 Token 有效期</td>\n</tr>\n<tr>\n<td>按时间戳检查</td>\n<td>检查文件修改时间</td>\n<td>中等有效期</td>\n</tr>\n<tr>\n<td>无限期 Token</td>\n<td>测试专用 never-expire Token</td>\n<td>后端支持时首选</td>\n</tr>\n</tbody></table>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>后果</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>测试间共享可变数据</td>\n<td>执行顺序依赖，并行化失败</td>\n<td>每个测试创建自己的数据</td>\n</tr>\n<tr>\n<td>依赖环境中的残留数据</td>\n<td>换环境就失败</td>\n<td>显式创建所需数据</td>\n</tr>\n<tr>\n<td>通过 UI 创建所有测试数据</td>\n<td>极慢，且依赖 UI 稳定</td>\n<td>API 优先创建</td>\n</tr>\n<tr>\n<td>不清理测试数据</td>\n<td>数据累积导致性能退化</td>\n<td>Teardown 阶段清理或使用短周期环境</td>\n</tr>\n<tr>\n<td>硬编码测试数据</td>\n<td>冲突、不可并行</td>\n<td>Factory 模式 + 唯一标识</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>测试数据管理的核心原则是&quot;每个测试自给自足&quot;——通过 API 优先创建、Factory 模式统一管理、唯一标识符保证隔离、Teardown 自动清理，让测试无论串行还是并行、无论在哪个环境都能稳定运行。数据问题的根因往往是测试间的隐式耦合。</p>\n<hr>\n<blockquote>\n<p><strong>同章参考</strong>：<a href=\"page-object-model\">Page Object 模型</a> 展示了数据如何在测试交互中流动；<a href=\"visual-regression-testing\">视觉回归测试</a> 的基线管理同样依赖可控的数据状态。</p>\n</blockquote>\n","headings":[{"level":1,"text":"测试数据管理","id":"测试数据管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"数据管理核心挑战","id":"数据管理核心挑战"},{"level":2,"text":"数据准备策略","id":"数据准备策略"},{"level":3,"text":"策略对比","id":"策略对比"},{"level":3,"text":"API 优先策略","id":"api-优先策略"},{"level":2,"text":"数据隔离模式","id":"数据隔离模式"},{"level":3,"text":"租户隔离","id":"租户隔离"},{"level":3,"text":"唯一标识符策略","id":"唯一标识符策略"},{"level":3,"text":"测试生命周期中的数据管理","id":"测试生命周期中的数据管理"},{"level":2,"text":"工厂模式（Factory Pattern）","id":"工厂模式-factory-pattern"},{"level":2,"text":"环境数据管理","id":"环境数据管理"},{"level":3,"text":"种子数据（Seed Data）","id":"种子数据-seed-data"},{"level":3,"text":"数据脱敏","id":"数据脱敏"},{"level":2,"text":"状态管理","id":"状态管理"},{"level":3,"text":"认证状态复用","id":"认证状态复用"},{"level":3,"text":"storageState 过期处理","id":"storagestate-过期处理"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Page Object 模型","url":"/l-doc-books/h/devops-tools/e2e-test-automation/implementation/page-object-model"},"next":{"title":"视觉回归测试","url":"/l-doc-books/h/devops-tools/e2e-test-automation/implementation/visual-regression-testing"}}