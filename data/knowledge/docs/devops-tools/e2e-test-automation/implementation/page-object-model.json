"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"页面片段模式-section-object\">页面片段模式（Section Object）</h3><p>对于复杂页面，按区域拆分为多个 Section：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[CheckoutPage] --&gt; B[ShippingSection]&#10;    A --&gt; C[PaymentSection]&#10;    A --&gt; D[OrderSummarySection]&#10;    B --&gt; E[AddressForm]&#10;    C --&gt; F[CreditCardForm]&#10;    C --&gt; G[AlipayForm]\">graph TD\n    A[CheckoutPage] --&gt; B[ShippingSection]\n    A --&gt; C[PaymentSection]\n    A --&gt; D[OrderSummarySection]\n    B --&gt; E[AddressForm]\n    C --&gt; F[CreditCardForm]\n    C --&gt; G[AlipayForm]</pre><h3 id=\"流畅接口-fluent-interface\">流畅接口（Fluent Interface）</h3><p>页面跳转场景使用方法链返回目标页面对象，保持类型安全：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export class LoginPage {&#10;  async signIn(email: string, password: string): Promise&lt;DashboardPage&gt; {&#10;    await this.emailInput.fill(email);&#10;    await this.passwordInput.fill(password);&#10;    await this.submitButton.click();&#10;    return new DashboardPage(this.page);&#10;  }&#10;}&#10;&#10;// 使用时类型安全地链式调用&#10;const dashboard = await loginPage.signIn(email, password);&#10;await dashboard.expectWelcomeMessage(userName);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LoginPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> signIn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">email</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">password</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">DashboardPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.emailInput.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fill</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(email);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.passwordInput.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fill</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(password);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.submitButton.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">click</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DashboardPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.page);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用时类型安全地链式调用</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dashboard</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loginPage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">signIn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(email, password);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dashboard.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expectWelcomeMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userName);</span></span></code></pre></div><h2 id=\"定位器策略\">定位器策略</h2><h3 id=\"优先级矩阵\">优先级矩阵</h3><table>\n<thead>\n<tr>\n<th>优先级</th>\n<th>定位器类型</th>\n<th>稳定性</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>1</td>\n<td><code>getByRole</code></td>\n<td>极高</td>\n<td>按钮、链接、标题、表单控件</td>\n</tr>\n<tr>\n<td>2</td>\n<td><code>getByLabel</code></td>\n<td>高</td>\n<td>表单输入框</td>\n</tr>\n<tr>\n<td>3</td>\n<td><code>getByText</code></td>\n<td>中高</td>\n<td>静态文本、非交互元素</td>\n</tr>\n<tr>\n<td>4</td>\n<td><code>getByTestId</code></td>\n<td>中</td>\n<td>无语义标记的元素（需前端配合）</td>\n</tr>\n<tr>\n<td>5</td>\n<td>CSS 选择器</td>\n<td>低</td>\n<td>不推荐，仅遗留兼容</td>\n</tr>\n</tbody></table>\n<h3 id=\"data-testid-使用规范\">data-testid 使用规范</h3><p>当语义化定位器不可用时，<code>data-testid</code> 是最后的防线：</p>\n<div class=\"code-block-wrapper\" data-lang=\"html\" data-code=\"&lt;!-- 前端代码中添加 --&gt;&#10;&lt;div data-testid=&quot;order-summary-total&quot;&gt;¥299.00&lt;/div&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">&#x3C;!-- 前端代码中添加 --></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">div</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> data-testid</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"order-summary-total\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>¥299.00&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">div</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><p>命名约定：<code>&lt;组件&gt;-&lt;元素&gt;-&lt;状态&gt;</code>，例如 <code>cart-item-delete-button</code>、<code>payment-form-submit</code>。</p>\n<h2 id=\"维护策略\">维护策略</h2><h3 id=\"变更影响分析\">变更影响分析</h3><p>当 UI 发生变更时，Page Object 架构将影响范围最小化：</p>\n<table>\n<thead>\n<tr>\n<th>变更类型</th>\n<th>影响范围</th>\n<th>修改位置</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>元素选择器变化</td>\n<td>单个 Page Object</td>\n<td>构造函数中的定位器</td>\n</tr>\n<tr>\n<td>交互流程变化</td>\n<td>单个方法</td>\n<td>Page Object 的方法实现</td>\n</tr>\n<tr>\n<td>页面结构重组</td>\n<td>Page Object 拆分/合并</td>\n<td>pages 目录</td>\n</tr>\n<tr>\n<td>新增功能</td>\n<td>新增方法或 Page Object</td>\n<td>不影响现有测试</td>\n</tr>\n<tr>\n<td>删除功能</td>\n<td>删除对应方法和测试</td>\n<td>测试清理</td>\n</tr>\n</tbody></table>\n<h3 id=\"代码审查检查清单\">代码审查检查清单</h3><ul>\n<li>定位器是否使用了语义化选择器（<code>getByRole</code> 优先）</li>\n<li>方法名是否反映业务意图而非技术动作</li>\n<li>是否在 Page Object 中混入了断言逻辑</li>\n<li>是否有重复定位器可以提取为 Component Object</li>\n<li>页面跳转是否返回了目标 Page Object</li>\n</ul>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>描述</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>God Page Object</td>\n<td>单个类包含页面所有交互</td>\n<td>按区域拆分为 Section/Component</td>\n</tr>\n<tr>\n<td>断言内置</td>\n<td>Page Object 方法内调用 <code>expect</code></td>\n<td>返回状态值，断言放在测试层</td>\n</tr>\n<tr>\n<td>定位器泄露</td>\n<td>测试直接使用 <code>page.locator()</code></td>\n<td>所有定位器封装在 Page Object 内</td>\n</tr>\n<tr>\n<td>过度封装</td>\n<td>为每个按钮点击都创建方法</td>\n<td>只封装有业务含义的操作序列</td>\n</tr>\n<tr>\n<td>继承滥用</td>\n<td>Page Object 间用继承共享逻辑</td>\n<td>组合优于继承，用 Component 共享</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>Page Object 模型的本质是将&quot;如何操作页面&quot;这一变化频繁的关注点封装隔离——让 UI 重构的影响范围从&quot;所有测试文件&quot;缩小到&quot;单个 Page Object 类&quot;。关键实践：优先语义化定位器、方法名反映用户意图、不在 Page Object 中混入断言、组合优于继承。</p>\n<hr>\n<blockquote>\n<p><strong>同章参考</strong>：<a href=\"test-data-management\">测试数据管理</a> 解决 Page Object 操作时的数据依赖问题；<a href=\"visual-regression-testing\">视觉回归测试</a> 补充 Page Object 无法覆盖的视觉验证维度。</p>\n</blockquote>\n","headings":[{"level":1,"text":"Page Object 模型","id":"page-object-模型"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心设计原则","id":"核心设计原则"},{"level":2,"text":"基础实现","id":"基础实现"},{"level":3,"text":"最小 Page Object","id":"最小-page-object"},{"level":3,"text":"在测试中使用","id":"在测试中使用"},{"level":2,"text":"进阶模式","id":"进阶模式"},{"level":3,"text":"组件对象（Component Object）","id":"组件对象-component-object"},{"level":3,"text":"页面片段模式（Section Object）","id":"页面片段模式-section-object"},{"level":3,"text":"流畅接口（Fluent Interface）","id":"流畅接口-fluent-interface"},{"level":2,"text":"定位器策略","id":"定位器策略"},{"level":3,"text":"优先级矩阵","id":"优先级矩阵"},{"level":3,"text":"data-testid 使用规范","id":"data-testid-使用规范"},{"level":2,"text":"维护策略","id":"维护策略"},{"level":3,"text":"变更影响分析","id":"变更影响分析"},{"level":3,"text":"代码审查检查清单","id":"代码审查检查清单"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"测试架构模式","url":"/l-doc-books/h/devops-tools/e2e-test-automation/foundations/test-architecture-patterns"},"next":{"title":"测试数据管理","url":"/l-doc-books/h/devops-tools/e2e-test-automation/implementation/test-data-management"}}