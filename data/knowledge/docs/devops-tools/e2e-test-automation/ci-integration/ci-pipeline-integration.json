shiki-dark:#9ECBFF\">    else</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      echo \"tests=tests/smoke/**\" >> $GITHUB_OUTPUT</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    fi</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">- </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Run relevant tests</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">npx playwright test ${{ steps.scope.outputs.tests }}</span></span></code></pre></div><h2 id=\"失败处理\">失败处理</h2><h3 id=\"产物收集\">产物收集</h3><p>测试失败时需要收集足够的调试信息：</p>\n<table>\n<thead>\n<tr>\n<th>产物类型</th>\n<th>用途</th>\n<th>保留策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>HTML 报告</td>\n<td>交互式查看结果</td>\n<td>7 天</td>\n</tr>\n<tr>\n<td>Trace 文件</td>\n<td>逐帧回放失败过程</td>\n<td>仅失败时保留</td>\n</tr>\n<tr>\n<td>截图</td>\n<td>快速判断失败原因</td>\n<td>仅失败时保留</td>\n</tr>\n<tr>\n<td>视频</td>\n<td>完整操作回放</td>\n<td>仅失败时保留</td>\n</tr>\n<tr>\n<td>控制台日志</td>\n<td>前端错误追踪</td>\n<td>始终保留</td>\n</tr>\n<tr>\n<td>网络 HAR</td>\n<td>API 请求/响应记录</td>\n<td>仅失败时保留</td>\n</tr>\n</tbody></table>\n<h3 id=\"playwright-调试配置\">Playwright 调试配置</h3><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// playwright.config.ts&#10;export default defineConfig({&#10;  use: {&#10;    trace: &#39;retain-on-failure&#39;, // 失败时保留 trace&#10;    screenshot: &#39;only-on-failure&#39;, // 失败时截图&#10;    video: &#39;retain-on-failure&#39;, // 失败时保留视频&#10;  },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// playwright.config.ts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> defineConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  use: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    trace: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'retain-on-failure'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 失败时保留 trace</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    screenshot: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'only-on-failure'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 失败时截图</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    video: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'retain-on-failure'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 失败时保留视频</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"失败通知\">失败通知</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"- name: Notify on failure&#10;  if: failure()&#10;  uses: slackapi/slack-github-action@v2&#10;  with:&#10;    webhook: ${{ secrets.SLACK_WEBHOOK }}&#10;    payload: |&#10;      {&#10;        &quot;text&quot;: &quot;E2E 测试失败&quot;,&#10;        &quot;blocks&quot;: [{&#10;          &quot;type&quot;: &quot;section&quot;,&#10;          &quot;text&quot;: {&#10;            &quot;type&quot;: &quot;mrkdwn&quot;,&#10;            &quot;text&quot;: &quot;⚠️ *E2E 测试失败* on `${{ github.ref_name }}`\\n&lt;${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|查看详情&gt;&quot;&#10;          }&#10;        }]&#10;      }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">- </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Notify on failure</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">failure()</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">slackapi/slack-github-action@v2</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    webhook</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">${{ secrets.SLACK_WEBHOOK }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    payload</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"text\": \"E2E 测试失败\",</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"blocks\": [{</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          \"type\": \"section\",</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          \"text\": {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            \"type\": \"mrkdwn\",</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            \"text\": \"⚠️ *E2E 测试失败* on `${{ github.ref_name }}`\\n&#x3C;${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|查看详情>\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        }]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      }</span></span></code></pre></div><h2 id=\"成本优化\">成本优化</h2><h3 id=\"ci-时间预算\">CI 时间预算</h3><table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>时间预算</th>\n<th>优化手段</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>环境启动</td>\n<td>&lt; 2 分钟</td>\n<td>预构建镜像 + 缓存</td>\n</tr>\n<tr>\n<td>应用部署</td>\n<td>&lt; 3 分钟</td>\n<td>增量构建 + 缓存</td>\n</tr>\n<tr>\n<td>测试执行</td>\n<td>&lt; 15 分钟</td>\n<td>并行 + 分片</td>\n</tr>\n<tr>\n<td>报告生成</td>\n<td>&lt; 1 分钟</td>\n<td>并行处理</td>\n</tr>\n<tr>\n<td><strong>总计</strong></td>\n<td><strong>&lt; 20 分钟</strong></td>\n<td>—</td>\n</tr>\n</tbody></table>\n<h3 id=\"runner-资源配置\">Runner 资源配置</h3><table>\n<thead>\n<tr>\n<th>规模</th>\n<th>推荐 Runner</th>\n<th>并行度</th>\n<th>月成本估算</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>小型（&lt; 50 测试）</td>\n<td>GitHub hosted 2-core</td>\n<td>2 workers</td>\n<td>免费额度内</td>\n</tr>\n<tr>\n<td>中型（50-200 测试）</td>\n<td>4-core runner</td>\n<td>4 workers</td>\n<td>$50-150/月</td>\n</tr>\n<tr>\n<td>大型（200+ 测试）</td>\n<td>8-core + 4 shards</td>\n<td>4 workers × 4 shards</td>\n<td>$200-500/月</td>\n</tr>\n</tbody></table>\n<h2 id=\"反模式\">反模式</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>问题</th>\n<th>正确做法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>不缓存浏览器安装</td>\n<td>每次 CI 下载 1-2GB</td>\n<td>利用 Actions Cache</td>\n</tr>\n<tr>\n<td>所有推送运行全量套件</td>\n<td>反馈太慢，资源浪费</td>\n<td>分层触发策略</td>\n</tr>\n<tr>\n<td>失败不收集 Trace</td>\n<td>远程调试无据可依</td>\n<td><code>trace: &#39;retain-on-failure&#39;</code></td>\n</tr>\n<tr>\n<td>硬编码环境地址</td>\n<td>无法跨环境复用</td>\n<td>环境变量 + CI Secret</td>\n</tr>\n<tr>\n<td>不设超时</td>\n<td>死锁的测试占用 Runner</td>\n<td>全局和单测试超时</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>CI 集成的核心是在速度和可靠性之间找到平衡——通过分层触发控制运行范围、分片并行压缩执行时间、智能门控区分硬阻断和软告警、产物收集支撑远程调试。目标是将整个 E2E 反馈周期控制在 20 分钟以内，同时保证门禁的可信度。</p>\n<hr>\n<blockquote>\n<p><strong>同章参考</strong>：<a href=\"test-reporting-analytics\">测试报告与分析</a> 讨论如何从 CI 产出中提取可行动的洞察；<a href=\"shift-left-continuous-testing\">左移与持续测试</a> 将 CI 集成扩展到更早的开发阶段。</p>\n</blockquote>\n","headings":[{"level":1,"text":"CI 流水线集成","id":"ci-流水线集成"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"集成架构","id":"集成架构"},{"level":3,"text":"E2E 测试在流水线中的位置","id":"e2e-测试在流水线中的位置"},{"level":3,"text":"触发策略","id":"触发策略"},{"level":2,"text":"GitHub Actions 实现","id":"github-actions-实现"},{"level":3,"text":"基础配置","id":"基础配置"},{"level":3,"text":"分片并行","id":"分片并行"},{"level":2,"text":"门控策略","id":"门控策略"},{"level":3,"text":"门控规则设计","id":"门控规则设计"},{"level":3,"text":"智能门控决策","id":"智能门控决策"},{"level":2,"text":"缓存与加速","id":"缓存与加速"},{"level":3,"text":"浏览器安装缓存","id":"浏览器安装缓存"},{"level":3,"text":"依赖缓存策略","id":"依赖缓存策略"},{"level":3,"text":"选择性测试运行","id":"选择性测试运行"},{"level":2,"text":"失败处理","id":"失败处理"},{"level":3,"text":"产物收集","id":"产物收集"},{"level":3,"text":"Playwright 调试配置","id":"playwright-调试配置"},{"level":3,"text":"失败通知","id":"失败通知"},{"level":2,"text":"成本优化","id":"成本优化"},{"level":3,"text":"CI 时间预算","id":"ci-时间预算"},{"level":3,"text":"Runner 资源配置","id":"runner-资源配置"},{"level":2,"text":"反模式","id":"反模式"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"测试环境管理","url":"/l-doc-books/h/devops-tools/e2e-test-automation/reliability/test-environment-management"},"next":{"title":"测试报告与分析","url":"/l-doc-books/h/devops-tools/e2e-test-automation/ci-integration/test-reporting-analytics"}}