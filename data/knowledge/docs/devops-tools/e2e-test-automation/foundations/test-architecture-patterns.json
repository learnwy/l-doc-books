--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cartPage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expectItemVisible</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'product-123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"given-when-then-模式\">Given-When-Then 模式</h3><p>对业务复杂的场景，BDD 风格更具可读性：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"test.describe(&#39;购物车优惠&#39;, () =&gt; {&#10;  test(&#39;满减优惠在达到门槛时自动生效&#39;, async ({ page }) =&gt; {&#10;    // Given: 购物车中有价值 290 元的商品&#10;    await cartFlow.addItemsWithTotal(290);&#10;&#10;    // When: 再加入一件 20 元商品使总额超过 300 元&#10;    await cartFlow.addItem({ price: 20 });&#10;&#10;    // Then: 满 300 减 50 优惠自动生效&#10;    await cartPage.expectDiscount(&#39;满300减50&#39;);&#10;    await cartPage.expectTotal(260);&#10;  });&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">test.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">describe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'购物车优惠'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'满减优惠在达到门槛时自动生效'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // Given: 购物车中有价值 290 元的商品</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cartFlow.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addItemsWithTotal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">290</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // When: 再加入一件 20 元商品使总额超过 300 元</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cartFlow.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ price: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // Then: 满 300 减 50 优惠自动生效</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cartPage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expectDiscount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'满300减50'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cartPage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expectTotal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">260</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"跨浏览器策略\">跨浏览器策略</h2><p>不同浏览器运行所有测试通常是浪费。推荐分层策略：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[全部用例] --&gt;|Chromium| B[每次 CI 运行]&#10;    A --&gt;|Firefox + WebKit| C[每日定时/发布前]&#10;    A --&gt;|移动设备模拟| D[涉及响应式的用例子集]\">graph LR\n    A[全部用例] --&gt;|Chromium| B[每次 CI 运行]\n    A --&gt;|Firefox + WebKit| C[每日定时/发布前]\n    A --&gt;|移动设备模拟| D[涉及响应式的用例子集]</pre><h2 id=\"反模式清单\">反模式清单</h2><table>\n<thead>\n<tr>\n<th>反模式</th>\n<th>问题</th>\n<th>改进方向</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>测试间共享状态</td>\n<td>执行顺序依赖，并行化破坏</td>\n<td>每个测试独立的浏览器上下文</td>\n</tr>\n<tr>\n<td>硬编码等待时间</td>\n<td><code>waitForTimeout(3000)</code> 既慢又不稳定</td>\n<td>使用 auto-waiting 或条件等待</td>\n</tr>\n<tr>\n<td>过长的测试方法</td>\n<td>单个测试验证过多步骤</td>\n<td>拆分为独立测试 + 共享 setup</td>\n</tr>\n<tr>\n<td>直接操作 DOM</td>\n<td><code>page.evaluate()</code> 绕过正常交互</td>\n<td>通过用户可见的操作验证</td>\n</tr>\n<tr>\n<td>忽略清理逻辑</td>\n<td>测试数据累积导致后续测试失败</td>\n<td>Fixture teardown 自动清理</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><p>测试架构的核心价值是将变更的影响范围最小化——通过分层隔离、Fixture 依赖注入、标准化的目录结构和命名约定，让测试套件能够随产品规模线性增长而非指数膨胀。架构投资的最佳时机是用例数量突破 20 个之前。</p>\n<hr>\n<blockquote>\n<p><strong>同章参考</strong>：<a href=\"e2e-testing-strategy\">E2E 测试策略</a> 定义了哪些场景值得自动化；<a href=\"test-framework-selection\">测试框架选型</a> 确定了架构模式落地的工具基础。</p>\n</blockquote>\n","headings":[{"level":1,"text":"测试架构模式","id":"测试架构模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"分层架构概览","id":"分层架构概览"},{"level":2,"text":"目录结构设计","id":"目录结构设计"},{"level":3,"text":"命名约定","id":"命名约定"},{"level":2,"text":"Fixture 模式","id":"fixture-模式"},{"level":2,"text":"配置管理模式","id":"配置管理模式"},{"level":3,"text":"环境配置分离","id":"环境配置分离"},{"level":2,"text":"测试编写模式","id":"测试编写模式"},{"level":3,"text":"AAA 模式（Arrange-Act-Assert）","id":"aaa-模式-arrange-act-assert"},{"level":3,"text":"Given-When-Then 模式","id":"given-when-then-模式"},{"level":2,"text":"跨浏览器策略","id":"跨浏览器策略"},{"level":2,"text":"反模式清单","id":"反模式清单"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"测试框架选型（2026）","url":"/l-doc-books/h/devops-tools/e2e-test-automation/foundations/test-framework-selection"},"next":{"title":"Page Object 模型","url":"/l-doc-books/h/devops-tools/e2e-test-automation/implementation/page-object-model"}}