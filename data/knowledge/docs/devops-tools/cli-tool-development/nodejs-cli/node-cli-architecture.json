79B8FF\">  \"compilerOptions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"target\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ES2022\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"module\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Node16\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"moduleResolution\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Node16\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"outDir\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"rootDir\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./src\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"strict\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"esModuleInterop\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"skipLibCheck\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"declaration\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"sourceMap\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"include\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"src/**/*\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"exclude\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"node_modules\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"dist\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tests\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 使用 <code>&quot;module&quot;: &quot;Node16&quot;</code> 确保输出的 ESM 代码与 Node.js 的模块系统完全兼容。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Node CLI 架构))&#10;    package.json&#10;      bin 字段注册&#10;      engines 版本约束&#10;      files 发布范围&#10;    Shebang&#10;      #!/usr/bin/env node&#10;      跨平台兼容&#10;    ESM 模块&#10;      import/export&#10;      .mjs 扩展名&#10;      TypeScript&#10;    项目结构&#10;      命令模块分离&#10;      工具层封装&#10;      类型定义集中\">mindmap\n  root((Node CLI 架构))\n    package.json\n      bin 字段注册\n      engines 版本约束\n      files 发布范围\n    Shebang\n      #!/usr/bin/env node\n      跨平台兼容\n    ESM 模块\n      import/export\n      .mjs 扩展名\n      TypeScript\n    项目结构\n      命令模块分离\n      工具层封装\n      类型定义集中</pre><ul>\n<li>package.json 的 bin 字段是 Node.js CLI 工具的注册入口，npm 安装时自动创建命令链接</li>\n<li>Shebang 行 <code>#!/usr/bin/env node</code> 是必须的，它告诉操作系统使用 Node.js 执行脚本</li>\n<li>现代 CLI 工具应使用 ESM 模块系统，配合 TypeScript 获得类型安全</li>\n<li>命令应按模块拆分，每个命令一个文件，通过统一注册函数组织</li>\n<li>TypeScript 配置使用 <code>&quot;module&quot;: &quot;Node16&quot;</code> 确保 ESM 兼容性</li>\n</ul>\n","headings":[{"level":1,"text":"Node CLI 架构","id":"node-cli-架构"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Package.json 的 bin 字段","id":"package-json-的-bin-字段"},{"level":2,"text":"Shebang 行","id":"shebang-行"},{"level":2,"text":"ESM 脚本组织","id":"esm-脚本组织"},{"level":2,"text":"项目结构","id":"项目结构"},{"level":2,"text":"TypeScript 配置","id":"typescript-配置"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"二进制优化","url":"/l-doc-books/h/devops-tools/cli-tool-development/rust-cli/binary-optimization"},"next":{"title":"进程管理","url":"/l-doc-books/h/devops-tools/cli-tool-development/nodejs-cli/process-management"}}