</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cnt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><hr>\n<h2 id=\"外部内容表与同步\">外部内容表与同步</h2><p>当已有数据表且不想复制数据时，使用<strong>外部内容表</strong>模式：</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"CREATE TABLE docs (&#10;    id    INTEGER PRIMARY KEY,&#10;    title TEXT NOT NULL,&#10;    body  TEXT NOT NULL&#10;);&#10;&#10;CREATE VIRTUAL TABLE docs_fts USING fts5(&#10;    title, body,&#10;    content = &#39;docs&#39;,&#10;    content_rowid = &#39;id&#39;&#10;);&#10;&#10;-- 使用触发器保持同步&#10;CREATE TRIGGER docs_ai AFTER INSERT ON docs BEGIN&#10;    INSERT INTO docs_fts(rowid, title, body)&#10;    VALUES (new.id, new.title, new.body);&#10;END;&#10;&#10;CREATE TRIGGER docs_ad AFTER DELETE ON docs BEGIN&#10;    INSERT INTO docs_fts(docs_fts, rowid, title, body)&#10;    VALUES (&#39;delete&#39;, old.id, old.title, old.body);&#10;END;&#10;&#10;CREATE TRIGGER docs_au AFTER UPDATE ON docs BEGIN&#10;    INSERT INTO docs_fts(docs_fts, rowid, title, body)&#10;    VALUES (&#39;delete&#39;, old.id, old.title, old.body);&#10;    INSERT INTO docs_fts(rowid, title, body)&#10;    VALUES (new.id, new.title, new.body);&#10;END;&#10;&#10;-- 重建整个索引&#10;INSERT INTO docs_fts(docs_fts) VALUES (&#39;rebuild&#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> docs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"