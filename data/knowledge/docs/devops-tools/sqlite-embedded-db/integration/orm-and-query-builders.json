pan><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'orders.total'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'total_spent'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">groupBy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'users.name'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">having</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(db.fn.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'orders.total'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'>'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">execute</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><hr>\n<h2 id=\"prisma\">Prisma</h2><p><strong>Prisma</strong> 是一个全功能的 ORM，通过 Schema 文件定义数据模型，自动生成类型安全的客户端代码。</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- prisma/schema.prisma 中的模型定义（Prisma Schema Language）&#10;-- generator client {&#10;--   provider = &quot;prisma-client-js&quot;&#10;-- }&#10;-- datasource db {&#10;--   provider = &quot;sqlite&quot;&#10;--   url      = &quot;file:./myapp.db&quot;&#10;-- }&#10;-- model User {&#10;--   id    Int     @id @default(autoincrement())&#10;--   name  String&#10;--   email String  @unique&#10;--   age   Int?&#10;--   city  String?&#10;-- }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- prisma/schema.prisma 中的模型定义（Prisma Schema Language）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- generator client {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   provider = \"prisma-client-js\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- datasource db {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   provider = \"sqlite\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   url      = \"file:./myapp.db\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- model User {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   id    Int     @id @default(autoincrement())</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   name  String</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   email String  @unique</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   age   Int?</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--   city  String?</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- }</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { PrismaClient } from &#39;@prisma/client&#39;;&#10;&#10;const prisma = new PrismaClient();&#10;&#10;const users = await prisma.user.findMany({&#10;  where: {&#10;    city: &#39;北京&#39;,&#10;    age: { gt: 25 },&#10;  },&#10;  orderBy: { name: &#39;asc&#39; },&#10;});&#10;&#10;const user = await prisma.user.create({&#10;  data: {&#10;    name: &#39;Alice&#39;,&#10;    email: &#39;alice@example.com&#39;,&#10;    age: 30,&#10;    city: &#39;上海&#39;,&#10;  },&#10;});&#10;&#10;const updated = await prisma.user.update({&#10;  where: { id: 1 },&#10;  data: { age: 31 },&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { PrismaClient } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@prisma/client'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> prisma</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PrismaClient</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> users</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prisma.user.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">findMany</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  where: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    city: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'北京'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    age: { gt: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">25</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  orderBy: { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'asc'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prisma.user.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  data: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Alice'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'alice@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    age: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">30</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    city: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'上海'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> updated</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prisma.user.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">update</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  where: { id: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  data: { age: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">31</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><hr>\n<h2 id=\"对比分析\">对比分析</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Drizzle</th>\n<th>Kysely</th>\n<th>Prisma</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>设计哲学</td>\n<td>SQL-like TypeScript</td>\n<td>类型安全查询构建器</td>\n<td>Schema-first ORM</td>\n</tr>\n<tr>\n<td>SQLite 特性支持</td>\n<td>极好</td>\n<td>好</td>\n<td>一般</td>\n</tr>\n<tr>\n<td>JSON 函数</td>\n<td>支持</td>\n<td>通过 raw SQL</td>\n<td>不支持</td>\n</tr>\n<tr>\n<td>FTS5</td>\n<td>通过 raw SQL</td>\n<td>通过 raw SQL</td>\n<td>不支持</td>\n</tr>\n<tr>\n<td>STRICT 表</td>\n<td>支持</td>\n<td>N/A（不管理 DDL）</td>\n<td>不支持</td>\n</tr>\n<tr>\n<td>原生 SQL 逃生舱</td>\n<td>sql`` 模板</td>\n<td>sql`` 模板</td>\n<td>$queryRaw</td>\n</tr>\n<tr>\n<td>Bundle 大小</td>\n<td>小</td>\n<td>极小</td>\n<td>大（生成客户端）</td>\n</tr>\n<tr>\n<td>关系查询</td>\n<td>支持</td>\n<td>需手动 JOIN</td>\n<td>极好</td>\n</tr>\n<tr>\n<td>异步/同步</td>\n<td>同步（better-sqlite3）</td>\n<td>异步</td>\n<td>异步</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    START[需要 SQLite ORM?]&#10;    START --&gt;|最大灵活性 + 类型安全| DRIZZLE[选择 Drizzle]&#10;    START --&gt;|只需查询构建| KYSELY[选择 Kysely]&#10;    START --&gt;|全功能 ORM + 多数据库| PRISMA[选择 Prisma]&#10;    START --&gt;|极致性能 + 完全控制| RAW[选择 better-sqlite3]\">graph TD\n    START[需要 SQLite ORM?]\n    START --&gt;|最大灵活性 + 类型安全| DRIZZLE[选择 Drizzle]\n    START --&gt;|只需查询构建| KYSELY[选择 Kysely]\n    START --&gt;|全功能 ORM + 多数据库| PRISMA[选择 Prisma]\n    START --&gt;|极致性能 + 完全控制| RAW[选择 better-sqlite3]</pre><blockquote>\n<p><strong>提示：</strong> 如果你的项目高度依赖 SQLite 特有功能（JSON、FTS5、STRICT 表），Drizzle 或直接使用 better-sqlite3 是更好的选择。Prisma 的 SQLite 支持虽然完整，但对 SQLite 特有特性的支持有限。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((ORM 与查询构建器))&#10;    Drizzle&#10;      SQL-like 语法&#10;      SQLite 原生支持&#10;      内置迁移&#10;    Kysely&#10;      纯查询构建器&#10;      极小 bundle&#10;      类型推导&#10;    Prisma&#10;      Schema-first&#10;      全功能 ORM&#10;      多数据库支持&#10;    选型原则&#10;      SQLite 特性 → Drizzle&#10;      轻量查询 → Kysely&#10;      多数据库 → Prisma&#10;      极致性能 → 原生 SQL\">mindmap\n  root((ORM 与查询构建器))\n    Drizzle\n      SQL-like 语法\n      SQLite 原生支持\n      内置迁移\n    Kysely\n      纯查询构建器\n      极小 bundle\n      类型推导\n    Prisma\n      Schema-first\n      全功能 ORM\n      多数据库支持\n    选型原则\n      SQLite 特性 → Drizzle\n      轻量查询 → Kysely\n      多数据库 → Prisma\n      极致性能 → 原生 SQL</pre><ul>\n<li><strong>Drizzle</strong> 提供 SQL-like 的 TypeScript API，对 SQLite 特性支持最好。</li>\n<li><strong>Kysely</strong> 是纯查询构建器，bundle 最小，适合只需类型安全查询构建的场景。</li>\n<li><strong>Prisma</strong> 是全功能 ORM，关系查询能力最强，但对 SQLite 特有特性支持有限。</li>\n<li>选型核心：SQLite 特有功能需求高选 Drizzle，多数据库支持选 Prisma，极致性能选原生 SQL。</li>\n</ul>\n","headings":[{"level":1,"text":"ORM 与查询构建器","id":"orm-与查询构建器"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"工具选型概览","id":"工具选型概览"},{"level":2,"text":"Drizzle ORM","id":"drizzle-orm"},{"level":2,"text":"Kysely","id":"kysely"},{"level":2,"text":"Prisma","id":"prisma"},{"level":2,"text":"对比分析","id":"对比分析"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据库迁移","url":"/l-doc-books/h/devops-tools/sqlite-embedded-db/integration/migrations"},"next":{"title":"SQLite 测试","url":"/l-doc-books/h/devops-tools/sqlite-embedded-db/integration/testing-with-sqlite"}}