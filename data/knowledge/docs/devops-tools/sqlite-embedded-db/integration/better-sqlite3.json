<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"db.function(&#39;distance&#39;, (x1: number, y1: number, x2: number, y2: number) =&gt; {&#10;  return Math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);&#10;});&#10;&#10;db.prepare(&#39;SELECT distance(0, 0, 3, 4) AS dist&#39;).get();&#10;&#10;db.aggregate(&#39;median&#39;, {&#10;  start: () =&gt; [] as number[],&#10;  step: (arr, value: number) =&gt; {&#10;    arr.push(value);&#10;    return arr;&#10;  },&#10;  result: (arr) =&gt; {&#10;    arr.sort((a, b) =&gt; a - b);&#10;    const mid = Math.floor(arr.length / 2);&#10;    return arr.length % 2 ? arr[mid] : (arr[mid - 1] + arr[mid]) / 2;&#10;  },&#10;});&#10;&#10;db.prepare(&#39;SELECT median(score) AS med FROM exam_scores&#39;).get();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">function</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'distance'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">x1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">y1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">x2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </sp