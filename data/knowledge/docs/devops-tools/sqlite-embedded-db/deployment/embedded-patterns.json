i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">err</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> error</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error.message.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">includes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'SQLITE_BUSY'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxRetries </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> jitter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">random</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> delayMs;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Atomics.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">wait</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Int32Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SharedArrayBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, delayMs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> jitter);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        continue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'重试次数已用尽'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 在多进程场景中，建议将所有写操作集中在一个进程中（如 Electron 主进程），其他进程通过 IPC 提交写请求。这样避免了跨进程的锁竞争。</p>\n</blockquote>\n<hr>\n<h2 id=\"移动端嵌入\">移动端嵌入</h2><p>SQLite 是 iOS 和 Android 的内置数据库引擎，但在跨平台框架中使用时有额外注意事项：</p>\n<table>\n<thead>\n<tr>\n<th>平台</th>\n<th>注意事项</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>iOS</td>\n<td>App Sandbox 限制文件访问范围</td>\n</tr>\n<tr>\n<td>Android</td>\n<td>数据库文件在应用卸载时自动删除</td>\n</tr>\n<tr>\n<td>React Native</td>\n<td>使用 react-native-quick-sqlite（JSI 绑定）</td>\n</tr>\n<tr>\n<td>Flutter</td>\n<td>使用 sqflite 或 drift 包</td>\n</tr>\n<tr>\n<td>Capacitor</td>\n<td>使用 @capacitor-community/sqlite 插件</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 移动端推荐配置&#10;PRAGMA journal_mode = WAL;&#10;PRAGMA synchronous = NORMAL;&#10;PRAGMA cache_size = -8000;&#10;PRAGMA foreign_keys = ON;&#10;PRAGMA temp_store = MEMORY;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 移动端推荐配置</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA journal_mode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> WAL;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA synchronous </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NORMAL;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA cache_size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA foreign_keys </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA temp_store </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> MEMORY;</span></span></code></pre></div><hr>\n<h2 id=\"electron-打包注意事项\">Electron 打包注意事项</h2><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { platform, arch } from &#39;node:os&#39;;&#10;&#10;const nativeModulePath = `better-sqlite3-${platform()}-${arch()}`;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { platform, arch } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'node:os'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nativeModulePath</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `better-sqlite3-${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">platform</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">()</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}-${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">arch</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">()</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>问题</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>原生模块架构不匹配</td>\n<td>使用 electron-rebuild 重编译</td>\n</tr>\n<tr>\n<td>asar 打包导致无法加载</td>\n<td>将 .node 文件排除出 asar</td>\n</tr>\n<tr>\n<td>macOS 公证失败</td>\n<td>确保原生模块已签名</td>\n</tr>\n<tr>\n<td>应用更新数据库迁移</td>\n<td>启动时检查 user_version 并执行迁移</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((嵌入模式))&#10;    桌面应用&#10;      Electron + better-sqlite3&#10;      Tauri + rusqlite&#10;      主进程运行&#10;    文件位置&#10;      用户数据目录&#10;      不要放安装目录&#10;      平台差异&#10;    多进程访问&#10;      WAL 模式&#10;      busy_timeout&#10;      集中写入&#10;    文件锁&#10;      POSIX fcntl&#10;      锁级别升级&#10;      重试机制&#10;    移动端&#10;      iOS / Android&#10;      跨平台框架&#10;      资源受限配置\">mindmap\n  root((嵌入模式))\n    桌面应用\n      Electron + better-sqlite3\n      Tauri + rusqlite\n      主进程运行\n    文件位置\n      用户数据目录\n      不要放安装目录\n      平台差异\n    多进程访问\n      WAL 模式\n      busy_timeout\n      集中写入\n    文件锁\n      POSIX fcntl\n      锁级别升级\n      重试机制\n    移动端\n      iOS / Android\n      跨平台框架\n      资源受限配置</pre><ul>\n<li>桌面应用中 SQLite 应在<strong>主进程</strong>中运行，渲染进程通过 IPC 访问。</li>\n<li>数据库文件应存放在<strong>用户数据目录</strong>，不要放在应用安装目录。</li>\n<li><strong>WAL 模式 + busy_timeout</strong> 是多进程访问的标准配置。</li>\n<li>建议将写操作<strong>集中在单个进程</strong>，避免跨进程锁竞争。</li>\n<li>移动端应根据平台和框架选择对应的 SQLite 绑定库。</li>\n</ul>\n","headings":[{"level":1,"text":"嵌入模式","id":"嵌入模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"桌面应用中的 SQLite","id":"桌面应用中的-sqlite"},{"level":2,"text":"数据库文件位置","id":"数据库文件位置"},{"level":2,"text":"多进程访问","id":"多进程访问"},{"level":2,"text":"文件锁","id":"文件锁"},{"level":2,"text":"移动端嵌入","id":"移动端嵌入"},{"level":2,"text":"Electron 打包注意事项","id":"electron-打包注意事项"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"复制与分发","url":"/l-doc-books/h/devops-tools/sqlite-embedded-db/deployment/replication"},"next":{"title":"边缘与 Serverless","url":"/l-doc-books/h/devops-tools/sqlite-embedded-db/deployment/edge-and-serverless"}}