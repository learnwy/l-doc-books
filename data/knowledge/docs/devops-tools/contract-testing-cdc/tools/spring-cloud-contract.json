ockMvc(mockMvc);&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SpringBootTest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">webEnvironment</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> MOCK)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AutoConfigureMockMvc</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">public</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> abstract</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserServiceBase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Autowired</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> MockMvc mockMvc;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">MockBean</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UserRepository userRepository;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BeforeEach</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        when</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userRepository.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">findById</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"123\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">thenReturn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Optional.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"abc-123\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Alice\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"alice@example.com\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"user\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            ));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        RestAssuredMockMvc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">mockMvc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(mockMvc);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"消费者侧-stub-runner\">消费者侧 Stub Runner</h2><p>消费者通过 Stub Runner 获取提供者发布的 WireMock 存根，用于集成测试：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"@SpringBootTest&#10;@AutoConfigureStubRunner(&#10;    ids = &quot;com.example:user-service:+:stubs:8090&quot;,&#10;    stubsMode = StubRunnerProperties.StubsMode.REMOTE&#10;)&#10;class OrderServiceIntegrationTest {&#10;&#10;    @Autowired&#10;    private UserClient userClient;&#10;&#10;    @Test&#10;    void shouldFetchUserFromStub() {&#10;        User user = userClient.getUser(&quot;123&quot;);&#10;        assertThat(user.getName()).isNotBlank();&#10;        assertThat(user.getEmail()).contains(&quot;@&quot;);&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SpringBootTest</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AutoConfigureStubRunner</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    ids</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"com.example:user-service:+:stubs:8090\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    stubsMode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StubRunnerProperties.StubsMode.REMOTE</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> OrderServiceIntegrationTest</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Autowired</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> UserClient userClient;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Test</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> shouldFetchUserFromStub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        User user </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userClient.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"123\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        assertThat</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">isNotBlank</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        assertThat</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getEmail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">contains</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"@\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>存根获取方式</th>\n<th>配置</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>REMOTE</td>\n<td>从 Nexus/Artifactory 拉取</td>\n<td>生产环境 CI/CD</td>\n</tr>\n<tr>\n<td>LOCAL</td>\n<td>从本地 Maven 仓库获取</td>\n<td>本地开发调试</td>\n</tr>\n<tr>\n<td>CLASSPATH</td>\n<td>从类路径获取</td>\n<td>单元测试</td>\n</tr>\n</tbody></table>\n<h2 id=\"scc-与-pact-的深度对比\">SCC 与 Pact 的深度对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Spring Cloud Contract</th>\n<th>Pact</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>契约定义方</td>\n<td>默认提供者侧（也支持消费者驱动）</td>\n<td>消费者侧</td>\n</tr>\n<tr>\n<td>契约格式</td>\n<td>Groovy DSL / YAML</td>\n<td>Pact JSON（V1-V4）</td>\n</tr>\n<tr>\n<td>语言支持</td>\n<td>JVM 为主（通过 Docker 支持其他）</td>\n<td>10+ 语言原生支持</td>\n</tr>\n<tr>\n<td>测试生成</td>\n<td>自动生成验证测试</td>\n<td>需手写验证配置</td>\n</tr>\n<tr>\n<td>存根机制</td>\n<td>WireMock 存根 JAR</td>\n<td>Mock Server 运行时</td>\n</tr>\n<tr>\n<td>共享机制</td>\n<td>Maven/Gradle 制品仓库</td>\n<td>Pact Broker</td>\n</tr>\n<tr>\n<td>消息测试</td>\n<td>Spring Integration/Cloud Stream</td>\n<td>Message Pact</td>\n</tr>\n<tr>\n<td>CI 集成</td>\n<td>标准 Maven/Gradle 生命周期</td>\n<td>需配置 Broker + Webhook</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>Spring 开发者低，其他较高</td>\n<td>中等（跨语言一致）</td>\n</tr>\n</tbody></table>\n<h2 id=\"scc-的消费者驱动模式\">SCC 的消费者驱动模式</h2><p>虽然 SCC 默认是提供者驱动的，但它也支持消费者驱动工作流：</p>\n<ol>\n<li>消费者在<strong>独立的契约仓库</strong>或<strong>提供者仓库的特定目录</strong>中提交契约定义</li>\n<li>提供者的 CI 拉取这些契约并运行验证</li>\n<li>也可直接与 Pact Broker 集成——SCC 能读取 Pact 格式的契约并生成验证测试</li>\n</ol>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TB&#10;    subgraph 消费者驱动模式&#10;        CC[消费者提交契约] --&gt; CR[契约仓库 Git]&#10;        CR --&gt; PP[提供者 CI 拉取]&#10;        PP --&gt; VV[SCC 生成验证测试]&#10;        VV --&gt; RR[运行验证]&#10;    end&#10;&#10;    subgraph Pact 互操作&#10;        PB[Pact Broker] --&gt; SCC_P[SCC Pact 转换器]&#10;        SCC_P --&gt; VV2[SCC 生成验证测试]&#10;    end\">flowchart TB\n    subgraph 消费者驱动模式\n        CC[消费者提交契约] --&gt; CR[契约仓库 Git]\n        CR --&gt; PP[提供者 CI 拉取]\n        PP --&gt; VV[SCC 生成验证测试]\n        VV --&gt; RR[运行验证]\n    end\n\n    subgraph Pact 互操作\n        PB[Pact Broker] --&gt; SCC_P[SCC Pact 转换器]\n        SCC_P --&gt; VV2[SCC 生成验证测试]\n    end</pre><h2 id=\"消息契约支持\">消息契约支持</h2><p>SCC 对消息驱动架构有原生支持，可以为 Spring Cloud Stream、Spring Integration 和 Apache Camel 定义消息契约：</p>\n<div class=\"code-block-wrapper\" data-lang=\"groovy\" data-code=\"Contract.make {&#10;    label &quot;orderCreated&quot;&#10;    input {&#10;        triggeredBy(&quot;createOrder()&quot;)&#10;    }&#10;    outputMessage {&#10;        sentTo &quot;orders&quot;&#10;        body([&#10;            orderId: $(anyUuid()),&#10;            customerId: $(anyNonBlankString()),&#10;            amount: $(anyDouble()),&#10;            status: &quot;CREATED&quot;&#10;        ])&#10;        headers {&#10;            header(&#39;contentType&#39;, applicationJson())&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Contract.make {</span></span>\n<span class=\"line\"><span>    label \"orderCreated\"</span></span>\n<span class=\"line\"><span>    input {</span></span>\n<span class=\"line\"><span>        triggeredBy(\"createOrder()\")</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>    outputMessage {</span></span>\n<span class=\"line\"><span>        sentTo \"orders\"</span></span>\n<span class=\"line\"><span>        body([</span></span>\n<span class=\"line\"><span>            orderId: $(anyUuid()),</span></span>\n<span class=\"line\"><span>            customerId: $(anyNonBlankString()),</span></span>\n<span class=\"line\"><span>            amount: $(anyDouble()),</span></span>\n<span class=\"line\"><span>            status: \"CREATED\"</span></span>\n<span class=\"line\"><span>        ])</span></span>\n<span class=\"line\"><span>        headers {</span></span>\n<span class=\"line\"><span>            header('contentType', applicationJson())</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"选择-scc-的决策条件\">选择 SCC 的决策条件</h2><p>SCC 最适合以下技术和组织条件：</p>\n<ul>\n<li>技术栈以 Spring Boot / Spring Cloud 为主</li>\n<li>团队已熟悉 Maven/Gradle 生态与制品仓库</li>\n<li>希望零手写实现提供者验证</li>\n<li>已建立 Nexus/Artifactory 制品管理基础设施</li>\n<li>内部服务间通信以 JVM 语言为主</li>\n</ul>\n<p>如果系统包含大量非 JVM 服务（Node.js、Go、Python），或组织更倾向消费者驱动工作流，Pact 可能是更自然的选择。两者并非互斥——Spring Cloud Contract 可以通过 Pact Converter 读取和生成 Pact 格式契约。</p>\n<h2 id=\"小结\">小结</h2><p>Spring Cloud Contract 为 JVM 生态提供了深度集成的契约测试方案，其自动生成验证测试和 WireMock 存根的能力大幅降低了上手门槛。它默认的提供者驱动模式适合 Spring Boot 团队快速落地，同时也支持消费者驱动工作流和与 Pact Broker 的互操作。选择 SCC 还是 Pact 取决于技术栈的同质性和跨语言需求。</p>\n<hr>\n<blockquote>\n<p><strong>延伸阅读</strong>：下一篇 <a href=\"alternative-tools\">替代工具</a> 将介绍 Pact 和 SCC 之外的契约测试工具生态。</p>\n</blockquote>\n","headings":[{"level":1,"text":"Spring Cloud Contract 实践指南","id":"spring-cloud-contract-实践指南"},{"level":2,"text":"Spring Cloud Contract 的设计哲学","id":"spring-cloud-contract-的设计哲学"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"契约定义语言","id":"契约定义语言"},{"level":3,"text":"Groovy DSL 示例","id":"groovy-dsl-示例"},{"level":3,"text":"YAML 格式示例","id":"yaml-格式示例"},{"level":2,"text":"提供者侧自动验证","id":"提供者侧自动验证"},{"level":2,"text":"消费者侧 Stub Runner","id":"消费者侧-stub-runner"},{"level":2,"text":"SCC 与 Pact 的深度对比","id":"scc-与-pact-的深度对比"},{"level":2,"text":"SCC 的消费者驱动模式","id":"scc-的消费者驱动模式"},{"level":2,"text":"消息契约支持","id":"消息契约支持"},{"level":2,"text":"选择 SCC 的决策条件","id":"选择-scc-的决策条件"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Pact 框架深入实践","url":"/l-doc-books/h/devops-tools/contract-testing-cdc/tools/pact-framework"},"next":{"title":"替代工具与工具选型","url":"/l-doc-books/h/devops-tools/contract-testing-cdc/tools/alternative-tools"}}