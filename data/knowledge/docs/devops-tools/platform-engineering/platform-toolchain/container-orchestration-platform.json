">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  operators</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    purpose</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '管理复杂有状态工作负载'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    examples</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      '数据库 Operator（PostgreSQL、MySQL）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      '消息队列 Operator（Kafka、RabbitMQ）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      '缓存 Operator（Redis）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    benefit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '开发者声明需求，Operator 处理复杂的运维逻辑'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# Kyverno 策略示例：强制镜像来源&#10;apiVersion: kyverno.io/v1&#10;kind: ClusterPolicy&#10;metadata:&#10;  name: restrict-image-registries&#10;spec:&#10;  validationFailureAction: Enforce&#10;  rules:&#10;    - name: validate-registries&#10;      match:&#10;        any:&#10;          - resources:&#10;              kinds: [&#39;Pod&#39;]&#10;      validate:&#10;        message: &#39;镜像必须来自内部镜像仓库&#39;&#10;        pattern:&#10;          spec:&#10;            containers:&#10;              - image: &#39;registry.example.com/*&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Kyverno 策略示例：强制镜像来源</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">apiVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">kyverno.io/v1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">kind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ClusterPolicy</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">restrict-image-registries</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">spec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  validationFailureAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Enforce</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  rules</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">validate-registries</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      match</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">resources</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">              kinds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Pod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">      validate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        message</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'镜像必须来自内部镜像仓库'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        pattern</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          spec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">            containers</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">              - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">image</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'registry.example.com/*'</span></span></code></pre></div><p>平台级 Kubernetes 扩展的核心价值是&quot;护栏而非围墙&quot;——通过自动化策略和控制器保障安全和一致性，同时不限制开发者的合理操作。策略应该有明确的错误信息，告诉开发者&quot;为什么不行&quot;和&quot;怎么修复&quot;。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((容器编排平台))&#10;    多集群管理&#10;      ArgoCD ApplicationSet&#10;      配置一致性&#10;      跨区域部署&#10;    命名空间策略&#10;      RBAC 隔离&#10;      网络策略&#10;      资源配额&#10;    平台扩展&#10;      准入控制器&#10;      自定义控制器&#10;      Operator&#10;    标准化&#10;      统一CNI&#10;      统一Ingress&#10;      统一监控\">mindmap\n  root((容器编排平台))\n    多集群管理\n      ArgoCD ApplicationSet\n      配置一致性\n      跨区域部署\n    命名空间策略\n      RBAC 隔离\n      网络策略\n      资源配额\n    平台扩展\n      准入控制器\n      自定义控制器\n      Operator\n    标准化\n      统一CNI\n      统一Ingress\n      统一监控</pre><ul>\n<li>多集群管理通过 ArgoCD/Fleet 实现配置一致性和 GitOps 统一管理</li>\n<li>命名空间是多租户隔离的基本单元，结合 RBAC、NetworkPolicy 和 ResourceQuota</li>\n<li>平台级 Kubernetes 扩展（准入控制器、自定义控制器、Operator）标准化运维实践</li>\n<li>&quot;默认拒绝 + 显式允许&quot;是网络策略的最佳实践</li>\n<li>策略执行是&quot;护栏而非围墙&quot;——保障安全同时不限制合理操作</li>\n<li>集群标准化（CNI、Ingress、监控）是多集群管理效率的基础</li>\n</ul>\n","headings":[{"level":1,"text":"容器编排平台","id":"容器编排平台"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Kubernetes 多集群管理","id":"kubernetes-多集群管理"},{"level":2,"text":"命名空间策略与多租户","id":"命名空间策略与多租户"},{"level":2,"text":"平台级 Kubernetes 扩展","id":"平台级-kubernetes-扩展"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"CI/CD 平台设计","url":"/l-doc-books/h/devops-tools/platform-engineering/platform-toolchain/ci-cd-platform-design"},"next":{"title":"可观测性平台","url":"/l-doc-books/h/devops-tools/platform-engineering/platform-toolchain/observability-platform"}}