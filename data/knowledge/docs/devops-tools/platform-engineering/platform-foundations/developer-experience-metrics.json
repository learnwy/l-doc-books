"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  presentation_layer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    dashboard</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Grafana 仪表板'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    reports</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'月度 DevEx 报告'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    alerts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'指标异常告警'</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MetricsGovernance {&#10;  principles: [&#39;度量是为了改进，不是为了惩罚&#39;, &#39;团队级聚合，避免个人排名&#39;, &#39;趋势比绝对值更重要&#39;, &#39;主观与客观指标结合&#39;];&#10;  review_cadence: {&#10;    weekly: &#39;平台团队内部看板审查&#39;;&#10;    monthly: &#39;跨团队 DevEx 报告&#39;;&#10;    quarterly: &#39;满意度调查 + 目标调整&#39;;&#10;  };&#10;  anti_patterns: [&#10;    &#39;用 PR 数量评估个人绩效&#39;,&#10;    &#39;仅关注 Activity 维度&#39;,&#10;    &#39;指标造假激励（Goodhart 定律）&#39;,&#10;    &#39;采集数据但从不分析行动&#39;,&#10;  ];&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MetricsGovernance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  principles</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'度量是为了改进，不是为了惩罚'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'团队级聚合，避免个人排名'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'趋势比绝对值更重要'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'主观与客观指标结合'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  review_cadence</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    weekly</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '平台团队内部看板审查'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    monthly</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '跨团队 DevEx 报告'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    quarterly</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '满意度调查 + 目标调整'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  anti_patterns</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '用 PR 数量评估个人绩效'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '仅关注 Activity 维度'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '指标造假激励（Goodhart 定律）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    '采集数据但从不分析行动'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>最重要的原则是：度量的目的是改进而非考核。当指标被用于个人绩效评估时，开发者会优化指标本身而非实际工作效果（Goodhart 定律）。平台团队应该将指标作为诊断工具，定位痛点并验证改进效果。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((开发者体验度量))&#10;    DORA 指标&#10;      部署频率&#10;      变更前置时间&#10;      变更失败率&#10;      恢复时间&#10;    SPACE 框架&#10;      满意度&#10;      产出&#10;      活动量&#10;      协作&#10;      效率&#10;    DevEx 三维度&#10;      反馈循环&#10;      认知负荷&#10;      心流状态&#10;    实施要点&#10;      自动化采集&#10;      多维度结合&#10;      改进导向\">mindmap\n  root((开发者体验度量))\n    DORA 指标\n      部署频率\n      变更前置时间\n      变更失败率\n      恢复时间\n    SPACE 框架\n      满意度\n      产出\n      活动量\n      协作\n      效率\n    DevEx 三维度\n      反馈循环\n      认知负荷\n      心流状态\n    实施要点\n      自动化采集\n      多维度结合\n      改进导向</pre><ul>\n<li>DORA 四指标（部署频率、前置时间、变更失败率、恢复时间）是交付效能的基础度量</li>\n<li>SPACE 框架从五个维度全面评估生产力，避免单一指标的偏见</li>\n<li>DevEx 三维度（反馈循环、认知负荷、心流状态）直接指导平台优化方向</li>\n<li>度量体系应结合自动化采集和调查问卷，覆盖客观与主观指标</li>\n<li>核心原则：度量是为了改进而非惩罚，趋势比绝对值更重要</li>\n<li>警惕 Goodhart 定律——当指标成为目标时，它就不再是好的指标</li>\n</ul>\n","headings":[{"level":1,"text":"开发者体验度量","id":"开发者体验度量"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"DORA 四大关键指标","id":"dora-四大关键指标"},{"level":2,"text":"SPACE 生产力框架","id":"space-生产力框架"},{"level":2,"text":"DevEx 三维度模型","id":"devex-三维度模型"},{"level":2,"text":"度量体系实施","id":"度量体系实施"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"内部开发者平台","url":"/l-doc-books/h/devops-tools/platform-engineering/platform-foundations/internal-developer-platform"},"next":{"title":"平台团队拓扑","url":"/l-doc-books/h/devops-tools/platform-engineering/platform-foundations/platform-team-topology"}}