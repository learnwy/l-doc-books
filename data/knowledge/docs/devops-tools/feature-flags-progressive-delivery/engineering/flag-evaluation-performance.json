\n<td>~1.2ns</td>\n<td>优秀</td>\n</tr>\n<tr>\n<td>xxHash (64bit)</td>\n<td>~1.2B</td>\n<td>~0.8ns</td>\n<td>优秀</td>\n</tr>\n<tr>\n<td>FNV-1a (64bit)</td>\n<td>~600M</td>\n<td>~1.6ns</td>\n<td>良好</td>\n</tr>\n<tr>\n<td>SHA-256</td>\n<td>~20M</td>\n<td>~50ns</td>\n<td>优秀（过剩）</td>\n</tr>\n<tr>\n<td>MD5</td>\n<td>~50M</td>\n<td>~20ns</td>\n<td>优秀（过剩）</td>\n</tr>\n</tbody></table>\n<p>生产建议：使用 <strong>MurmurHash3</strong> 或 <strong>xxHash</strong>。密码学哈希（SHA-256/MD5）的安全性在灰度场景完全多余，性能却差 20-50 倍。</p>\n<h3 id=\"哈希预计算\">哈希预计算</h3><p>对于频繁评估的场景，可以在请求级别预计算用户的哈希桶：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"type EvaluationContext struct {&#10;    TargetingKey string&#10;    Attributes   map[string]interface{}&#10;    // 预计算字段&#10;    hashBucket   uint32  // 在构建 context 时一次性计算&#10;    hashComputed bool&#10;}&#10;&#10;func (ctx *EvaluationContext) GetBucket(salt string) uint32 {&#10;    if ctx.hashComputed &amp;&amp; ctx.lastSalt == salt {&#10;        return ctx.hashBucket&#10;    }&#10;    ctx.hashBucket = murmur3.Sum32([]byte(salt + &quot;:&quot; + ctx.TargetingKey))&#10;    ctx.hashComputed = true&#10;    ctx.lastSalt = salt&#10;    return ctx.hashBucket&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> EvaluationContext</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    TargetingKey </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Attributes   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{}</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 预计算字段</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    hashBucket   </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">uint32</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 在构建 context 时一次性计算</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    hashComputed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bool</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">EvaluationContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GetBucket</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">salt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">uint32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.hashComputed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.lastSalt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> salt {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.hashBucket</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ctx.hashBucket </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> murmur3.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Sum32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">byte</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(salt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \":\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.TargetingKey))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ctx.hashComputed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ctx.lastSalt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> salt</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.hashBucket</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"评估结果缓存\">评估结果缓存</h2><h3 id=\"请求级缓存\">请求级缓存</h3><p>同一请求内对同一开关的多次评估应该只计算一次：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"class RequestScopedCache:&#10;    &quot;&quot;&quot;请求级评估缓存——避免同一请求内重复计算&quot;&quot;&quot;&#10;&#10;    def __init__(self):&#10;        self._cache: dict[str, Any] = {}&#10;&#10;    def evaluate(self, flag_key: str, context: dict) -&gt; Any:&#10;        cache_key = f&quot;{flag_key}:{context[&#39;targetingKey&#39;]}&quot;&#10;&#10;        if cache_key in self._cache:&#10;            return self._cache[cache_key]&#10;&#10;        result = self._engine.evaluate(flag_key, context)&#10;        self._cache[cache_key] = result&#10;        return result\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RequestScopedCache</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"请求级评估缓存——避免同一请求内重复计算\"\"\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._cache: dict[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, Any] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"