:#24292E;--shiki-dark:#E1E4E8\">        result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._engine.evaluate(flag_key, context)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">._cache[cache_key] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result</span></span></code></pre></div><h3 id=\"用户级缓存\">用户级缓存</h3><p>对于客户端 SDK，同一用户的所有开关值可以批量评估并缓存：</p>\n<table>\n<thead>\n<tr>\n<th>缓存策略</th>\n<th>命中率</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>请求级（per-request）</td>\n<td>中</td>\n<td>服务端，同一请求多次评估</td>\n</tr>\n<tr>\n<td>用户级（per-user）</td>\n<td>高</td>\n<td>客户端，用户会话期间</td>\n</tr>\n<tr>\n<td>全局级（per-flag）</td>\n<td>极高</td>\n<td>全量推开的开关（无规则）</td>\n</tr>\n</tbody></table>\n<h2 id=\"并发评估性能\">并发评估性能</h2><h3 id=\"读写锁策略\">读写锁策略</h3><p>规则更新（写操作）远少于规则评估（读操作），天然适合<strong>读写锁</strong>模式：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    subgraph ReadPath[&quot;读路径 - 评估(高频)&quot;]&#10;        R1[获取读锁 RLock] --&gt; R2[读取规则] --&gt; R3[计算结果] --&gt; R4[释放读锁]&#10;    end&#10;    subgraph WritePath[&quot;写路径 - 规则更新(低频)&quot;]&#10;        W1[获取写锁 WLock] --&gt; W2[更新规则集] --&gt; W3[释放写锁]&#10;    end\">flowchart TD\n    subgraph ReadPath[\"读路径 - 评估(高频)\"]\n        R1[获取读锁 RLock] --&gt; R2[读取规则] --&gt; R3[计算结果] --&gt; R4[释放读锁]\n    end\n    subgraph WritePath[\"写路径 - 规则更新(低频)\"]\n        W1[获取写锁 WLock] --&gt; W2[更新规则集] --&gt; W3[释放写锁]\n    end</pre><p>Go 的 <code>sync.RWMutex</code> 和 Java 的 <code>ReadWriteLock</code> 都是适合的工具。在极高并发场景下（如快手 155 亿/s），可以进一步使用<strong>无锁数据结构</strong>（Copy-on-Write）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"type LockFreeStore struct {&#10;    current atomic.Pointer[FlagData]  // 原子指针切换&#10;}&#10;&#10;func (s *LockFreeStore) Evaluate(key string) *Flag {&#10;    data := s.current.Load()         // 无锁读取&#10;    return data.flags[key]&#10;}&#10;&#10;func (s *LockFreeStore) Update(newData *FlagData) {&#10;    s.current.Store(newData)         // 原子替换整个数据集&#10;    // 旧数据由 GC 回收，读者不受影响&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LockFreeStore</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    current </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">atomic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Pointer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">FlagData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 原子指针切换</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">LockFreeStore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Evaluate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Flag</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s.current.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Load</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 无锁读取</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data.flags[key]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">LockFreeStore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Update</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">newData</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">FlagData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    s.current.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Store</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(newData)         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 原子替换整个数据集</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 旧数据由 GC 回收，读者不受影响</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"批量评估优化\">批量评估优化</h3><p>当单个请求需要评估多个开关时，批量评估可以减少锁获取次数和上下文构建开销：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 批量评估接口&#10;const results = client.evaluateBatch([&#39;flag-a&#39;, &#39;flag-b&#39;, &#39;flag-c&#39;, &#39;flag-d&#39;], context);&#10;// 单次锁获取 + 单次上下文解析 → 4 个评估结果\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 批量评估接口</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> results</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> client.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">evaluateBatch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'flag-a'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'flag-b'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'flag-c'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'flag-d'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], context);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 单次锁获取 + 单次上下文解析 → 4 个评估结果</span></span></code></pre></div><h2 id=\"评估延迟的测量与监控\">评估延迟的测量与监控</h2><h3 id=\"关键指标\">关键指标</h3><table>\n<thead>\n<tr>\n<th>指标</th>\n<th>采集方式</th>\n<th>告警阈值</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>P50 评估延迟</td>\n<td>SDK 内埋点</td>\n<td>&gt; 10us (本地)</td>\n</tr>\n<tr>\n<td>P99 评估延迟</td>\n<td>SDK 内埋点</td>\n<td>&gt; 100us (本地)</td>\n</tr>\n<tr>\n<td>规则同步延迟</td>\n<td>平台侧时间戳对比</td>\n<td>&gt; 30s</td>\n</tr>\n<tr>\n<td>缓存命中率</td>\n<td>SDK 内计数器</td>\n<td>&lt; 90%</td>\n</tr>\n<tr>\n<td>评估错误率</td>\n<td>SDK 内计数器</td>\n<td>&gt; 0.01%</td>\n</tr>\n</tbody></table>\n<p>与 <a href=\"../../observability/\">可观测性</a> 平台集成，将 SDK 内部指标暴露为 Prometheus metrics 或 OpenTelemetry spans：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"func (e *Engine) Evaluate(flagKey string, ctx Context) (string, error) {&#10;    start := time.Now()&#10;    defer func() {&#10;        duration := time.Since(start)&#10;        metrics.EvalLatency.WithLabelValues(flagKey).Observe(duration.Seconds())&#10;        metrics.EvalCount.WithLabelValues(flagKey).Inc()&#10;    }()&#10;&#10;    return e.doEvaluate(flagKey, ctx)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Engine</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Evaluate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">flagKey</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    start </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    defer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        duration </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Since</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(start)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        metrics.EvalLatency.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithLabelValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(flagKey).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Observe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(duration.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Seconds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        metrics.EvalCount.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithLabelValues</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(flagKey).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Inc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">doEvaluate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(flagKey, ctx)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"大规模系统的性能实践\">大规模系统的性能实践</h2><h3 id=\"launchdarkly-42t-评估-天\">LaunchDarkly（42T 评估/天）</h3><ul>\n<li>使用 SSE 流式推送实现 &lt; 200ms 全球规则传播</li>\n<li>SDK 端完全本地评估，P99 &lt; 10 微秒</li>\n<li>规则编译为紧凑的二进制格式减少内存和解析开销</li>\n</ul>\n<h3 id=\"快手-155-亿次-秒\">快手（155 亿次/秒）</h3><ul>\n<li>多级缓存：进程内 → 本地 Redis → 中心存储</li>\n<li>规则热更新：Copy-on-Write 无锁切换</li>\n<li>分片评估：按用户 ID 分片，每个分片独立缓存</li>\n</ul>\n<h3 id=\"statsig-1t-事件-天\">Statsig（1T+ 事件/天）</h3><ul>\n<li>Edge Worker 预评估 + 边缘缓存</li>\n<li>规则 DAG 编译为评估 bytecode</li>\n<li>批量上报减少网络开销</li>\n</ul>\n<h2 id=\"小结\">小结</h2><p>开关评估性能的核心优化方向：</p>\n<ol>\n<li><strong>规则编译</strong>：预编译 HashSet、预编译正则、预计算哈希桶</li>\n<li><strong>短路求值</strong>：高区分度条件前置，AND 逻辑早退出</li>\n<li><strong>缓存分层</strong>：请求级 → 用户级 → 全局级，减少重复计算</li>\n<li><strong>并发设计</strong>：读写锁或无锁 Copy-on-Write 支持高并发</li>\n<li><strong>算法选择</strong>：MurmurHash3/xxHash 替代密码学哈希</li>\n</ol>\n<p>性能基线确立后，需要通过 <a href=\"../operations/observability-flag-impact\">可观测性与影响分析</a> 持续监控评估延迟。SDK 架构的整体设计参见 <a href=\"sdk-architecture-patterns\">SDK 架构模式</a>。开关如何与 <a href=\"../../ci-cd-pipelines/\">CI/CD 流水线</a>集成进行性能回归检测，参见 <a href=\"testing-with-flags\">特性开关下的测试</a>。</p>\n","headings":[{"level":1,"text":"开关评估性能：延迟优化与规则引擎设计","id":"开关评估性能-延迟优化与规则引擎设计"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"评估性能为何关键","id":"评估性能为何关键"},{"level":2,"text":"规则引擎的核心数据结构","id":"规则引擎的核心数据结构"},{"level":3,"text":"规则匹配的朴素实现","id":"规则匹配的朴素实现"},{"level":3,"text":"优化一：集合查找加速","id":"优化一-集合查找加速"},{"level":3,"text":"优化二：短路求值","id":"优化二-短路求值"},{"level":3,"text":"优化三：规则索引","id":"优化三-规则索引"},{"level":2,"text":"百分比评估的哈希性能","id":"百分比评估的哈希性能"},{"level":3,"text":"哈希预计算","id":"哈希预计算"},{"level":2,"text":"评估结果缓存","id":"评估结果缓存"},{"level":3,"text":"请求级缓存","id":"请求级缓存"},{"level":3,"text":"用户级缓存","id":"用户级缓存"},{"level":2,"text":"并发评估性能","id":"并发评估性能"},{"level":3,"text":"读写锁策略","id":"读写锁策略"},{"level":3,"text":"批量评估优化","id":"批量评估优化"},{"level":2,"text":"评估延迟的测量与监控","id":"评估延迟的测量与监控"},{"level":3,"text":"关键指标","id":"关键指标"},{"level":2,"text":"大规模系统的性能实践","id":"大规模系统的性能实践"},{"level":3,"text":"LaunchDarkly（42T 评估/天）","id":"launchdarkly-42t-评估-天"},{"level":3,"text":"快手（155 亿次/秒）","id":"快手-155-亿次-秒"},{"level":3,"text":"Statsig（1T+ 事件/天）","id":"statsig-1t-事件-天"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"SDK 架构模式：客户端与服务端的评估引擎","url":"/l-doc-books/h/devops-tools/feature-flags-progressive-delivery/engineering/sdk-architecture-patterns"},"next":{"title":"特性开关下的测试：组合爆炸与策略矩阵","url":"/l-doc-books/h/devops-tools/feature-flags-progressive-delivery/engineering/testing-with-flags"}}