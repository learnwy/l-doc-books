<span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> plugins</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier-plugin-tailwindcss'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier-plugin-organize-imports'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier-plugin-sql'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier-plugin-toml'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '@prettier/plugin-xml'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier-plugin-astro'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier-plugin-svelte'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><p>插件之间可能存在冲突，尤其是当多个插件处理同一语言时。Prettier 使用<strong>最后注册的插件优先</strong>的策略，因此插件的声明顺序很重要。<code>prettier-plugin-tailwindcss</code> 的文档明确要求它必须是插件列表中的最后一个。</p>\n<h2 id=\"与编辑器和工具链的集成\">与编辑器和工具链的集成</h2><p>Prettier 的价值在格式化本身之外，更在于它与开发工具链的深度集成。</p>\n<p><strong>编辑器集成</strong>：VS Code 的 Prettier 扩展通过 <code>editor.formatOnSave</code> 实现保存时自动格式化。扩展内部调用 Prettier 的 Node.js API，并处理了配置解析、文件忽略等逻辑。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// VS Code settings.json 典型配置&#10;const vscodeSettings = {&#10;  &#39;editor.defaultFormatter&#39;: &#39;esbenp.prettier-vscode&#39;,&#10;  &#39;editor.formatOnSave&#39;: true,&#10;  &#39;[javascript]&#39;: {&#10;    &#39;editor.defaultFormatter&#39;: &#39;esbenp.prettier-vscode&#39;,&#10;  },&#10;  &#39;[typescript]&#39;: {&#10;    &#39;editor.defaultFormatter&#39;: &#39;esbenp.prettier-vscode&#39;,&#10;  },&#10;  &#39;prettier.requireConfig&#39;: true,&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// VS Code settings.json 典型配置</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> vscodeSettings</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'editor.defaultFormatter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esbenp.prettier-vscode'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'editor.formatOnSave'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '[javascript]'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'editor.defaultFormatter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esbenp.prettier-vscode'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '[typescript]'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'editor.defaultFormatter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esbenp.prettier-vscode'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'prettier.requireConfig'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p><strong>与 ESLint 协作</strong>：Prettier 和 ESLint 的职责存在部分重叠（格式化规则）。推荐的做法是使用 <code>eslint-config-prettier</code> 关闭 ESLint 中与 Prettier 冲突的规则，让 Prettier 专注格式化，ESLint 专注代码质量。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import prettierConfig from &#39;eslint-config-prettier&#39;;&#10;&#10;export default [...otherConfigs, prettierConfig];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prettierConfig </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'eslint-config-prettier'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">otherConfigs, prettierConfig];</span></span></code></pre></div><p><strong>Git Hooks 集成</strong>：通过 <code>lint-staged</code> 在提交前对暂存文件运行 Prettier，确保进入仓库的代码始终是格式化过的。</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;lint-staged&quot;: {&#10;    &quot;*.{js,ts,tsx,css,md,json}&quot;: &quot;prettier --write&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"lint-staged\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"*.{js,ts,tsx,css,md,json}\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"prettier --write\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"性能优化与缓存机制\">性能优化与缓存机制</h2><p>Prettier 在大型项目中的性能是一个值得关注的话题。格式化单个文件通常在毫秒级，但当项目包含数千个文件时，全量格式化可能需要数十秒。</p>\n<p><strong>文件缓存</strong>：Prettier CLI 支持 <code>--cache</code> 标志，它会记录每个文件的内容哈希和格式化结果。当文件内容未变时跳过格式化，大幅提升增量格式化的速度。</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"prettier --write --cache &quot;src/**/*.{ts,tsx}&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">prettier</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --write</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --cache</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"src/**/*.{ts,tsx}\"</span></span></code></pre></div><p><strong>解析器性能</strong>：Babel Parser 的性能在大文件上可能成为瓶颈。对于纯 TypeScript 项目，使用 <code>--parser typescript</code>（基于 <code>@typescript-eslint/typescript-estree</code>）可能获得更好的性能。</p>\n<p><strong>并行处理</strong>：Prettier CLI 本身是单线程的，但可以通过 <code>--concurrency</code> 参数控制并发数。在 CI 环境中，结合文件分片和并行任务可以显著缩短格式化检查时间。</p>\n<table>\n<thead>\n<tr>\n<th>优化策略</th>\n<th>适用场景</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>--cache</code></td>\n<td>增量格式化</td>\n<td>跳过未变更文件，提速 10-100x</td>\n</tr>\n<tr>\n<td><code>--parser typescript</code></td>\n<td>纯 TS 项目</td>\n<td>解析速度提升 20-30%</td>\n</tr>\n<tr>\n<td>lint-staged</td>\n<td>提交前检查</td>\n<td>只检查变更文件</td>\n</tr>\n<tr>\n<td><code>--check</code> 替代 <code>--write</code></td>\n<td>CI 流水线</td>\n<td>减少磁盘 I/O</td>\n</tr>\n<tr>\n<td>文件分片并行</td>\n<td>大型 monorepo</td>\n<td>线性扩展</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Prettier))&#10;    设计哲学&#10;      有主见&#10;      少配置&#10;      确定性输出&#10;    架构&#10;      解析器管道&#10;      Doc IR 系统&#10;      多层配置合并&#10;    核心配置&#10;      printWidth&#10;      trailingComma&#10;      singleQuote&#10;    扩展能力&#10;      插件系统&#10;      多语言支持&#10;      嵌入式语言&#10;    工具链集成&#10;      编辑器 formatOnSave&#10;      ESLint 协作&#10;      Git Hooks&#10;    性能&#10;      文件缓存&#10;      解析器选择&#10;      并行策略\">mindmap\n  root((Prettier))\n    设计哲学\n      有主见\n      少配置\n      确定性输出\n    架构\n      解析器管道\n      Doc IR 系统\n      多层配置合并\n    核心配置\n      printWidth\n      trailingComma\n      singleQuote\n    扩展能力\n      插件系统\n      多语言支持\n      嵌入式语言\n    工具链集成\n      编辑器 formatOnSave\n      ESLint 协作\n      Git Hooks\n    性能\n      文件缓存\n      解析器选择\n      并行策略</pre><ul>\n<li>Prettier 通过&quot;有主见&quot;的设计哲学终结代码风格争论，将格式化变为自动化基础设施</li>\n<li>内部架构基于 AST 解析 → Doc IR → 行宽求解的确定性管道</li>\n<li>配置项刻意精简，核心决策（如 trailingComma: all）背后有明确的工程理由</li>\n<li>插件系统通过 Parser + Printer 接口支持数十种语言</li>\n<li>与编辑器、ESLint、Git Hooks 的集成形成完整的格式化工具链</li>\n<li>性能优化的关键是缓存和增量策略，避免全量格式化</li>\n</ul>\n","headings":[{"level":1,"text":"Prettier 深度解析","id":"prettier-深度解析"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"架构与执行流程","id":"架构与执行流程"},{"level":2,"text":"核心配置项深度解读","id":"核心配置项深度解读"},{"level":2,"text":"插件系统与语言扩展","id":"插件系统与语言扩展"},{"level":2,"text":"与编辑器和工具链的集成","id":"与编辑器和工具链的集成"},{"level":2,"text":"性能优化与缓存机制","id":"性能优化与缓存机制"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"基于 AST 的格式化原理","url":"/l-doc-books/h/editors-compilers/code-formatting-linting/formatting-principles/ast-based-formatting"},"next":{"title":"EditorConfig 与编辑器统一配置","url":"/l-doc-books/h/editors-compilers/code-formatting-linting/formatting-principles/editorconfig"}}