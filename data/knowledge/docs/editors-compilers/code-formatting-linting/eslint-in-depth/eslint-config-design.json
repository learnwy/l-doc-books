-shiki-dark:#9ECBFF\">'coverage/**'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'**/*.generated.*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><p>文件范围设计的最佳实践：</p>\n<table>\n<thead>\n<tr>\n<th>文件类型</th>\n<th>特殊规则</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>测试文件</td>\n<td>放宽 any/断言限制</td>\n<td>测试中需要灵活 mock</td>\n</tr>\n<tr>\n<td>脚本文件</td>\n<td>允许 console</td>\n<td>脚本需要控制台输出</td>\n</tr>\n<tr>\n<td>配置文件</td>\n<td>允许 default export</td>\n<td>框架要求 default export</td>\n</tr>\n<tr>\n<td>生成代码</td>\n<td>完全忽略</td>\n<td>无需检查自动生成的文件</td>\n</tr>\n<tr>\n<td>类型声明</td>\n<td>放宽未使用变量</td>\n<td>.d.ts 中的类型可能在其他文件使用</td>\n</tr>\n</tbody></table>\n<h2 id=\"共享配置与组织策略\">共享配置与组织策略</h2><p>对于多项目团队或 monorepo，将 ESLint 配置抽取为共享 npm 包是维护效率的关键。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import type { Linter } from &#39;eslint&#39;;&#10;&#10;interface SharedConfigOptions {&#10;  typescript?: boolean;&#10;  react?: boolean;&#10;  strictness?: &#39;relaxed&#39; | &#39;recommended&#39; | &#39;strict&#39;;&#10;  testFramework?: &#39;vitest&#39; | &#39;jest&#39;;&#10;}&#10;&#10;function createConfig(options: SharedConfigOptions): Linter.Config[] {&#10;  const configs: Linter.Config[] = [];&#10;&#10;  configs.push({&#10;    rules: baseRules[options.strictness ?? &#39;recommended&#39;],&#10;  });&#10;&#10;  if (options.typescript) {&#10;    configs.push(...typescriptConfigs);&#10;  }&#10;&#10;  if (options.react) {&#10;    configs.push(...reactConfigs);&#10;  }&#10;&#10;  if (options.testFramework) {&#10;    configs.push(testConfig(options.testFramework));&#10;  }&#10;&#10;  return configs;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"back