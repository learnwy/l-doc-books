=\"color:#032F62;--shiki-dark:#9ECBFF\">'**/*.test.{ts,tsx}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    rules: {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      '@typescript-eslint/no-explicit-any'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'off'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ignores: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'**/dist/**'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'**/node_modules/**'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'**/coverage/**'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[根 eslint.config.mjs] --&gt; B[基础配置层]&#10;    B --&gt; C[&quot;apps/** → + React 规则&quot;]&#10;    B --&gt; D[&quot;packages/ui/** → + React 规则&quot;]&#10;    B --&gt; E[&quot;packages/core/** → + 库规则&quot;]&#10;    B --&gt; F[&quot;scripts/** → + 脚本规则&quot;]&#10;    B --&gt; G[&quot;**/*.test.* → 放宽规则&quot;]\">flowchart TD\n    A[根 eslint.config.mjs] --&gt; B[基础配置层]\n    B --&gt; C[\"apps/** → + React 规则\"]\n    B --&gt; D[\"packages/ui/** → + React 规则\"]\n    B --&gt; E[\"packages/core/** → + 库规则\"]\n    B --&gt; F[\"scripts/** → + 脚本规则\"]\n    B --&gt; G[\"**/*.test.* → 放宽规则\"]</pre><h2 id=\"typescript-项目引用与-lint\">TypeScript 项目引用与 Lint</h2><p>在使用 TypeScript 项目引用（Project References）的 monorepo 中，每个包有自己的 <code>tsconfig.json</code>。ESLint 的类型感知规则需要正确配置 <code>parserOptions.project</code> 指向各包的 tsconfig。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export default [&#10;  ...baseConfig,&#10;  {&#10;    files: [&#39;apps/web/**/*.{ts,tsx}&#39;],&#10;    languageOptions: {&#10;      parserOptions: {&#10;        project: &#39;./apps/web/tsconfig.json&#39;,&#10;        tsconfigRootDir: import.meta.dirname,&#10;      },&#10;    },&#10;  },&#10;  {&#10;    files: [&#39;packages/core/**/*.ts&#39;],&#10;    languageOptions: {&#10;      parserOptions: {&#10;        project: &#39;./packages/core/tsconfig.json&#39;,&#10;        tsconfigRootDir: import.meta.dirname,&#10;      },&#10;    },&#10;  },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">baseConfig,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    files: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'apps/web/**/*.{ts,tsx}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    languageOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      parserOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        project: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./apps/web/tsconfig.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        tsconfigRootDir: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.dirname,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    files: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'packages/core/**/*.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    languageOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      parserOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        project: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./packages/core/tsconfig.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        tsconfigRootDir: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.dirname,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><p>对于包含大量子包的 monorepo，可以使用 glob 模式简化配置：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"export default [&#10;  ...baseConfig,&#10;  {&#10;    files: [&#39;packages/*/src/**/*.{ts,tsx}&#39;, &#39;apps/*/src/**/*.{ts,tsx}&#39;],&#10;    languageOptions: {&#10;      parserOptions: {&#10;        project: true,&#10;        tsconfigRootDir: import.meta.dirname,&#10;      },&#10;    },&#10;  },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">baseConfig,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    files: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'packages/*/src/**/*.{ts,tsx}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'apps/*/src/**/*.{ts,tsx}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    languageOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      parserOptions: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        project: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        tsconfigRootDir: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">meta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.dirname,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>配置方式</th>\n<th>适用场景</th>\n<th>优点</th>\n<th>缺点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>显式列出每个包</td>\n<td>包数量少</td>\n<td>精确控制</td>\n<td>维护成本高</td>\n</tr>\n<tr>\n<td>glob + project: true</td>\n<td>标准 monorepo</td>\n<td>自动发现</td>\n<td>需要所有包有 tsconfig</td>\n</tr>\n<tr>\n<td>分包 eslint.config</td>\n<td>极大型 monorepo</td>\n<td>包级自治</td>\n<td>配置分散</td>\n</tr>\n</tbody></table>\n<h2 id=\"按变更包触发-lint\">按变更包触发 Lint</h2><p>大型 monorepo 中全量 lint 的成本过高。通过只 lint 受影响的包可以大幅缩短 CI 时间。</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"npx turbo lint --filter=&quot;...[origin/main]&quot;&#10;&#10;npx nx affected --target=lint --base=origin/main\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">npx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> turbo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> lint</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --filter=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"...[origin/main]\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">npx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> nx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> affected</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --target=lint</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --base=origin/main</span></span></code></pre></div><p>手动实现基于 Git diff 的增量 lint：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"#!/usr/bin/env bash&#10;CHANGED_PACKAGES=$(git diff --name-only origin/main | \\&#10;  grep -E &#39;^(packages|apps)/&#39; | \\&#10;  cut -d&#39;/&#39; -f1-2 | \\&#10;  sort -u)&#10;&#10;for pkg in $CHANGED_PACKAGES; do&#10;  echo &quot;Linting $pkg...&quot;&#10;  npx eslint &quot;$pkg/src/**/*.{ts,tsx}&quot; --max-warnings 0&#10;done\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#!/usr/bin/env bash</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">CHANGED_PACKAGES</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> diff</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --name-only</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> origin/main</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -E</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '^(packages|apps)/'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  cut</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -f1-2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  sort</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pkg </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $CHANGED_PACKAGES; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">do</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"Linting </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$pkg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">...\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  npx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> eslint</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$pkg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/src/**/*.{ts,tsx}\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --max-warnings</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">done</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[&quot;git diff origin/main&quot;] --&gt; B[识别变更文件]&#10;    B --&gt; C[映射到包]&#10;    C --&gt; D{Turborepo / Nx}&#10;    D --&gt; E[&quot;turbo lint --filter&quot;]&#10;    D --&gt; F[&quot;nx affected --target lint&quot;]&#10;    E --&gt; G[仅 lint 变更包]&#10;    F --&gt; G&#10;    G --&gt; H[输出结果]\">flowchart TD\n    A[\"git diff origin/main\"] --&gt; B[识别变更文件]\n    B --&gt; C[映射到包]\n    C --&gt; D{Turborepo / Nx}\n    D --&gt; E[\"turbo lint --filter\"]\n    D --&gt; F[\"nx affected --target lint\"]\n    E --&gt; G[仅 lint 变更包]\n    F --&gt; G\n    G --&gt; H[输出结果]</pre><p>Turborepo 的缓存机制可以跳过未变更包的 lint：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;tasks&quot;: {&#10;    &quot;lint&quot;: {&#10;      &quot;inputs&quot;: [&quot;src/**/*.ts&quot;, &quot;src/**/*.tsx&quot;, &quot;eslint.config.mjs&quot;],&#10;      &quot;outputs&quot;: [],&#10;      &quot;cache&quot;: true&#10;    }&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"tasks\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"lint\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"inputs\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"src/**/*.ts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"src/**/*.tsx\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"eslint.config.mjs\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"outputs\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"cache\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"biome-在-monorepo-中的使用\">Biome 在 Monorepo 中的使用</h2><p>Biome 对 monorepo 有良好的支持，通过根目录的 <code>biome.json</code> 配置统一管理：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;files&quot;: {&#10;    &quot;include&quot;: [&quot;apps/**&quot;, &quot;packages/**&quot;],&#10;    &quot;ignore&quot;: [&quot;**/dist/**&quot;, &quot;**/node_modules/**&quot;]&#10;  },&#10;  &quot;overrides&quot;: [&#10;    {&#10;      &quot;include&quot;: [&quot;apps/**/*.tsx&quot;],&#10;      &quot;linter&quot;: {&#10;        &quot;rules&quot;: {&#10;          &quot;correctness&quot;: {&#10;            &quot;useExhaustiveDependencies&quot;: &quot;warn&quot;&#10;          }&#10;        }&#10;      }&#10;    },&#10;    {&#10;      &quot;include&quot;: [&quot;packages/core/**&quot;],&#10;      &quot;linter&quot;: {&#10;        &quot;rules&quot;: {&#10;          &quot;style&quot;: {&#10;            &quot;noConsole&quot;: &quot;error&quot;&#10;          }&#10;        }&#10;      }&#10;    },&#10;    {&#10;      &quot;include&quot;: [&quot;scripts/**&quot;],&#10;      &quot;linter&quot;: {&#10;        &quot;rules&quot;: {&#10;          &quot;style&quot;: {&#10;            &quot;noConsole&quot;: &quot;off&quot;&#10;          }&#10;        }&#10;      }&#10;    }&#10;  ]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"files\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"include\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"apps/**\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"packages/**\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"ignore\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"**/dist/**\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"**/node_modules/**\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"overrides\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"include\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"apps/**/*.tsx\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"linter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"rules\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"correctness\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            \"useExhaustiveDependencies\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"warn\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"include\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"packages/core/**\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"linter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"rules\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"style\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            \"noConsole\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"error\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"include\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"scripts/**\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"linter\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        \"rules\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">          \"style\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            \"noConsole\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"off\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>Biome 在 monorepo 中的性能优势尤其明显：得益于 Rust 的并行处理能力，全量扫描数千文件仍然可以在秒级完成，减少了对增量 lint 的依赖。</p>\n<table>\n<thead>\n<tr>\n<th>方案</th>\n<th>全量 lint 2000 文件</th>\n<th>增量需求</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ESLint</td>\n<td>45-60s</td>\n<td>必须增量</td>\n</tr>\n<tr>\n<td>ESLint + 缓存</td>\n<td>5-15s</td>\n<td>建议增量</td>\n</tr>\n<tr>\n<td>Biome</td>\n<td>0.5-2s</td>\n<td>可选增量</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Monorepo Lint))&#10;    配置分层&#10;      根配置基础规则&#10;      包级覆盖&#10;      文件类型区分&#10;    TypeScript&#10;      项目引用&#10;      parserOptions.project&#10;      tsconfigRootDir&#10;    增量策略&#10;      Turborepo filter&#10;      Nx affected&#10;      Git diff 手动实现&#10;    Biome 优势&#10;      秒级全量扫描&#10;      单配置覆盖&#10;      overrides 包级&#10;    最佳实践&#10;      统一管控 + 包自治&#10;      CI 只 lint 变更&#10;      缓存加速\">mindmap\n  root((Monorepo Lint))\n    配置分层\n      根配置基础规则\n      包级覆盖\n      文件类型区分\n    TypeScript\n      项目引用\n      parserOptions.project\n      tsconfigRootDir\n    增量策略\n      Turborepo filter\n      Nx affected\n      Git diff 手动实现\n    Biome 优势\n      秒级全量扫描\n      单配置覆盖\n      overrides 包级\n    最佳实践\n      统一管控 + 包自治\n      CI 只 lint 变更\n      缓存加速</pre><ul>\n<li>Monorepo lint 采用根配置 + 包级覆盖的分层架构，在统一和自治之间取得平衡</li>\n<li>TypeScript 类型感知规则需要正确配置每个包的 <code>tsconfig.json</code> 路径</li>\n<li>大型 monorepo 通过 Turborepo/Nx 的变更检测只 lint 受影响的包</li>\n<li>Biome 的 Rust 并行处理使得全量扫描仍在秒级完成，减少了对增量策略的依赖</li>\n<li><code>package.json</code> 的 lint 脚本应同时支持全量和增量两种模式</li>\n</ul>\n","headings":[{"level":1,"text":"Monorepo 中的 Lint 策略","id":"monorepo-中的-lint-策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"配置分层架构","id":"配置分层架构"},{"level":2,"text":"TypeScript 项目引用与 Lint","id":"typescript-项目引用与-lint"},{"level":2,"text":"按变更包触发 Lint","id":"按变更包触发-lint"},{"level":2,"text":"Biome 在 Monorepo 中的使用","id":"biome-在-monorepo-中的使用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"CI 流水线中的 Lint 集成","url":"/l-doc-books/h/editors-compilers/code-formatting-linting/team-ci-integration/ci-pipeline-lint"},"next":{"title":"代码审查自动化","url":"/l-doc-books/h/editors-compilers/code-formatting-linting/team-ci-integration/code-review-automation"}}