n style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> capture</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> match.captures) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> tokenType</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> mapCaptureToTokenType</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(capture.name);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (tokenType </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> undefined</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          builder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            capture.node.startPosition.row,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            capture.node.startPosition.column,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            capture.node.endIndex </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> capture.node.startIndex,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            tokenType,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">            0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> builder.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph &quot;vscode.dev 架构&quot;&#10;        BROWSER[浏览器] --&gt; VSCODE_WEB[VS Code Web]&#10;        VSCODE_WEB --&gt; EXT_HOST[&quot;Extension Host (Web Worker)&quot;]&#10;        EXT_HOST --&gt; TS_WASM[web-tree-sitter]&#10;        TS_WASM --&gt; LANG_WASM[语法 .wasm 文件]&#10;    end&#10;&#10;    subgraph &quot;功能实现&quot;&#10;        TS_WASM --&gt; HIGHLIGHT[语法高亮]&#10;        TS_WASM --&gt; FOLDING[代码折叠]&#10;        TS_WASM --&gt; SYMBOLS[文档符号]&#10;        TS_WASM --&gt; SELECTION[选区扩展]&#10;    end\">graph TD\n    subgraph \"vscode.dev 架构\"\n        BROWSER[浏览器] --&gt; VSCODE_WEB[VS Code Web]\n        VSCODE_WEB --&gt; EXT_HOST[\"Extension Host (Web Worker)\"]\n        EXT_HOST --&gt; TS_WASM[web-tree-sitter]\n        TS_WASM --&gt; LANG_WASM[语法 .wasm 文件]\n    end\n\n    subgraph \"功能实现\"\n        TS_WASM --&gt; HIGHLIGHT[语法高亮]\n        TS_WASM --&gt; FOLDING[代码折叠]\n        TS_WASM --&gt; SYMBOLS[文档符号]\n        TS_WASM --&gt; SELECTION[选区扩展]\n    end</pre><p>vscode.dev 中 Tree-sitter 提供的功能：</p>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>实现方式</th>\n<th>替代方案（无 Tree-sitter）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>语法高亮</td>\n<td>highlights.scm 查询</td>\n<td>TextMate tmLanguage</td>\n</tr>\n<tr>\n<td>代码折叠</td>\n<td>folds.scm 查询</td>\n<td>基于缩进</td>\n</tr>\n<tr>\n<td>文档符号</td>\n<td>语法树遍历</td>\n<td>正则匹配</td>\n</tr>\n<tr>\n<td>选区扩展</td>\n<td>语法树父节点遍历</td>\n<td>文本级别扩展</td>\n</tr>\n<tr>\n<td>括号匹配</td>\n<td>语法树结构</td>\n<td>纯文本匹配</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"playground-集成\">Playground 集成</h2><p>Tree-sitter Playground 是一个交互式的在线工具，用于开发和调试语法定义。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"class TreeSitterPlayground {&#10;  private parser: Parser;&#10;  private language: Parser.Language;&#10;&#10;  async updateTree(): Promise&lt;void&gt; {&#10;    const code = this.editor.getValue();&#10;    const tree = this.parser.parse(code);&#10;    this.treeView.render(tree.rootNode);&#10;    if (this.queryEditor.getValue()) this.highlightQueryMatches(tree);&#10;  }&#10;&#10;  private highlightQueryMatches(tree: Parser.Tree): void {&#10;    const query = this.language.query(this.queryEditor.getValue());&#10;    const matches = query.matches(tree.rootNode);&#10;    const highlights = matches.flatMap((m) =&gt;&#10;      m.captures.map((c) =&gt; ({&#10;        startRow: c.node.startPosition.row,&#10;        startCol: c.node.startPosition.column,&#10;        endRow: c.node.endPosition.row,&#10;        endCol: c.node.endPosition.column,&#10;        className: `capture-${c.name}`,&#10;      })),&#10;    );&#10;    this.editor.setHighlights(highlights);&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TreeSitterPlayground</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> parser</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Parser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> language</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Parser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Language</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  async</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> updateTree</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.editor.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark: