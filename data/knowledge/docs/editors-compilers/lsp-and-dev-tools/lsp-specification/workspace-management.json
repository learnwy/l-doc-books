oldName: string, newName: string, references: Location[]): Promise&lt;void&gt; {&#10;  const editsByUri = new Map&lt;string, TextEdit[]&gt;();&#10;&#10;  for (const ref of references) {&#10;    const edits = editsByUri.get(ref.uri) ?? [];&#10;    edits.push({ range: ref.range, newText: newName });&#10;    editsByUri.set(ref.uri, edits);&#10;  }&#10;&#10;  const workspaceEdit: WorkspaceEdit = {&#10;    changes: Object.fromEntries(editsByUri),&#10;  };&#10;&#10;  await connection.workspace.applyEdit({&#10;    label: `Rename &#39;${oldName}&#39; to &#39;${newName}&#39;`,&#10;    edit: workspaceEdit,&#10;  });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> renameSymbol</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">oldName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">newName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">references</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Location</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> editsByUri</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">TextEdit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]>();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ref</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> references) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> edits</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> editsByUri.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ref.uri) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    edits.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ range: ref.range, newText: newName });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    editsByUri.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ref.uri, edits);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> workspaceEdit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> WorkspaceEdit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    changes: Object.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fromEntries</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(editsByUri),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> connection.workspace.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">applyEdit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    label: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Rename '${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">oldName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}' to '${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">newName</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}'`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    edit: workspaceEdit,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>操作类型</th>\n<th>接口</th>\n<th>使用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>文本编辑</td>\n<td>TextEdit</td>\n<td>修改文件内容</td>\n</tr>\n<tr>\n<td>创建文件</td>\n<td>CreateFile</td>\n<td>生成新文件（如测试骨架）</td>\n</tr>\n<tr>\n<td>重命名文件</td>\n<td>RenameFile</td>\n<td>重命名模块或组件文件</td>\n</tr>\n<tr>\n<td>删除文件</td>\n<td>DeleteFile</td>\n<td>移除不需要的文件</td>\n</tr>\n<tr>\n<td>编辑注解</td>\n<td>ChangeAnnotation</td>\n<td>标记编辑需要用户确认</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 使用 <code>documentChanges</code> 而非 <code>changes</code> 可以在同一个 WorkspaceEdit 中混合文本编辑和文件操作，并且支持编辑注解让用户逐个确认变更。</p>\n</blockquote>\n<hr>\n<h2 id=\"工作区符号\">工作区符号</h2><p>工作区符号搜索允许用户在整个项目中通过名称查找符号定义。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface WorkspaceSymbol {&#10;  name: string;&#10;  kind: SymbolKind;&#10;  tags?: SymbolTag[];&#10;  containerName?: string;&#10;  location: Location | { uri: string };&#10;  data?: unknown;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> WorkspaceSymbol</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  kind</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SymbolKind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  tags</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> SymbolTag</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  containerName</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  location</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Location</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">uri</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    USER[用户输入查询] --&gt; CLIENT[客户端]&#10;    CLIENT --&gt;|workspace/symbol| SERVER[服务端]&#10;    SERVER --&gt; INDEX[搜索符号索引]&#10;    INDEX --&gt; FILTER[模糊匹配过滤]&#10;    FILTER --&gt; RANK[相关性排序]&#10;    RANK --&gt; RESULT[返回 SymbolInformation 列表]&#10;    RESULT --&gt; CLIENT&#10;    CLIENT --&gt; UI[显示搜索结果]\">graph TD\n    USER[用户输入查询] --&gt; CLIENT[客户端]\n    CLIENT --&gt;|workspace/symbol| SERVER[服务端]\n    SERVER --&gt; INDEX[搜索符号索引]\n    INDEX --&gt; FILTER[模糊匹配过滤]\n    FILTER --&gt; RANK[相关性排序]\n    RANK --&gt; RESULT[返回 SymbolInformation 列表]\n    RESULT --&gt; CLIENT\n    CLIENT --&gt; UI[显示搜索结果]</pre><table>\n<thead>\n<tr>\n<th>搜索特性</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>模糊匹配</td>\n<td>支持缩写查询（如 <code>gCD</code> 匹配 <code>getClientData</code>）</td>\n</tr>\n<tr>\n<td>大小写</td>\n<td>通常大小写不敏感</td>\n</tr>\n<tr>\n<td>符号类型过滤</td>\n<td>部分实现支持按 kind 过滤</td>\n</tr>\n<tr>\n<td>延迟解析</td>\n<td>WorkspaceSymbol 支持 resolve 按需加载</td>\n</tr>\n<tr>\n<td>结果限制</td>\n<td>客户端通常限制返回数量</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((工作区管理))&#10;    workspaceFolders&#10;      多根目录支持&#10;      动态添加/移除&#10;      替代废弃的 rootPath&#10;    配置管理&#10;      推送模式 didChangeConfiguration&#10;      拉取模式 workspace/configuration&#10;      混合模式最佳实践&#10;    文件监听&#10;      glob 模式匹配&#10;      创建/变更/删除事件&#10;      配置文件监控&#10;    工作区编辑&#10;      跨文件文本编辑&#10;      文件创建/重命名/删除&#10;      编辑注解确认&#10;    工作区符号&#10;      全项目符号搜索&#10;      模糊匹配与排序&#10;      延迟 resolve\">mindmap\n  root((工作区管理))\n    workspaceFolders\n      多根目录支持\n      动态添加/移除\n      替代废弃的 rootPath\n    配置管理\n      推送模式 didChangeConfiguration\n      拉取模式 workspace/configuration\n      混合模式最佳实践\n    文件监听\n      glob 模式匹配\n      创建/变更/删除事件\n      配置文件监控\n    工作区编辑\n      跨文件文本编辑\n      文件创建/重命名/删除\n      编辑注解确认\n    工作区符号\n      全项目符号搜索\n      模糊匹配与排序\n      延迟 resolve</pre><ul>\n<li><strong>workspaceFolders</strong> 支持多根目录工作区，是 <code>rootPath</code> 的现代替代方案。</li>\n<li>配置管理推荐<strong>混合模式</strong>：监听推送通知清除缓存，按需拉取具体配置值。</li>\n<li><strong>文件监听</strong>通过 glob 模式注册，服务端据此监控配置文件和源码变更。</li>\n<li><strong>WorkspaceEdit</strong> 支持文本编辑和文件操作的混合，是重构和自动修复的基础设施。</li>\n<li><strong>工作区符号搜索</strong>提供全项目级别的符号导航，支持模糊匹配和延迟 resolve 优化。</li>\n</ul>\n","headings":[{"level":1,"text":"工作区管理","id":"工作区管理"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"workspaceFolders","id":"workspacefolders"},{"level":2,"text":"配置管理","id":"配置管理"},{"level":2,"text":"文件监听","id":"文件监听"},{"level":2,"text":"工作区编辑","id":"工作区编辑"},{"level":2,"text":"工作区符号","id":"工作区符号"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"文本同步","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/lsp-specification/text-synchronization"},"next":{"title":"代码补全","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/language-features/completion"}}