span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(endOffset);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> positionToOffset</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">content</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">position</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Position</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> lines</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> content.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">split</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> offset </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> position.line; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    offset </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lines[i].</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> offset </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> position.character;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>变更事件的多种场景：</p>\n<table>\n<thead>\n<tr>\n<th>操作</th>\n<th>range</th>\n<th>text</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>插入字符</td>\n<td>start === end</td>\n<td><code>&quot;a&quot;</code></td>\n<td>在光标位置插入</td>\n</tr>\n<tr>\n<td>删除字符</td>\n<td>start ≠ end</td>\n<td><code>&quot;&quot;</code></td>\n<td>删除 range 内容</td>\n</tr>\n<tr>\n<td>替换文本</td>\n<td>start ≠ end</td>\n<td><code>&quot;new&quot;</code></td>\n<td>替换 range 内容</td>\n</tr>\n<tr>\n<td>多行删除</td>\n<td>跨行 range</td>\n<td><code>&quot;&quot;</code></td>\n<td>删除跨行区域</td>\n</tr>\n<tr>\n<td>粘贴文本</td>\n<td>选区 range 或 start=end</td>\n<td><code>&quot;...多行&quot;</code></td>\n<td>替换选区或插入</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    subgraph &quot;插入操作&quot;&#10;        I_BEFORE[&quot;Hello|World&quot;] --&gt;|&quot;range: {5,5}, text: &#39; &#39;&quot;| I_AFTER[&quot;Hello World&quot;]&#10;    end&#10;    subgraph &quot;删除操作&quot;&#10;        D_BEFORE[&quot;Hello World&quot;] --&gt;|&quot;range: {5,6}, text: &#39;&#39;&quot;| D_AFTER[&quot;HelloWorld&quot;]&#10;    end&#10;    subgraph &quot;替换操作&quot;&#10;        R_BEFORE[&quot;Hello World&quot;] --&gt;|&quot;range: {0,5}, text: &#39;Hi&#39;&quot;| R_AFTER[&quot;Hi World&quot;]&#10;    end\">graph LR\n    subgraph \"插入操作\"\n        I_BEFORE[\"Hello|World\"] --&gt;|\"range: {5,5}, text: ' '\"| I_AFTER[\"Hello World\"]\n    end\n    subgraph \"删除操作\"\n        D_BEFORE[\"Hello World\"] --&gt;|\"range: {5,6}, text: ''\"| D_AFTER[\"HelloWorld\"]\n    end\n    subgraph \"替换操作\"\n        R_BEFORE[\"Hello World\"] --&gt;|\"range: {0,5}, text: 'Hi'\"| R_AFTER[\"Hi World\"]\n    end</pre><hr>\n<h2 id=\"位置编码\">位置编码</h2><p>LSP 3.17 引入了位置编码协商机制。不同客户端对 <code>character</code> 偏移量的计算方式可能不同。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type PositionEncodingKind = &#39;utf-8&#39; | &#39;utf-16&#39; | &#39;utf-32&#39;;&#10;&#10;interface GeneralClientCapabilities {&#10;  positionEncodings?: PositionEncodingKind[];&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PositionEncodingKind</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'utf-8'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'utf-16'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'utf-32'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GeneralClientCapabilities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  positionEncodings</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> PositionEncodingKind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>编码</th>\n<th>单位</th>\n<th>特点</th>\n<th>使用者</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>UTF-16</td>\n<td>2 字节码元</td>\n<td>LSP 默认，JavaScript 内部编码</td>\n<td>VS Code、大多数编辑器</td>\n</tr>\n<tr>\n<td>UTF-32</td>\n<td>码点</td>\n<td>直觉最自然</td>\n<td>部分 Rust 客户端</td>\n</tr>\n<tr>\n<td>UTF-8</td>\n<td>字节</td>\n<td>内存效率最高</td>\n<td>Neovim、Helix</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 对于纯 ASCII 文档，三种编码的 <code>character</code> 值相同。但包含中文、emoji 等多字节字符时，三种编码计算结果不同，处理不当会导致光标定位错误。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((文本同步))&#10;    文档生命周期&#10;      didOpen 完整文本&#10;      didChange 变更事件&#10;      didSave 保存通知&#10;      didClose 释放资源&#10;    同步策略&#10;      全量同步 简单但带宽大&#10;      增量同步 高效但复杂&#10;      textDocumentSync 声明&#10;    版本号机制&#10;      单调递增&#10;      乱序检测与丢弃&#10;      ContentModified 错误&#10;    变更事件&#10;      range + text&#10;      插入/删除/替换&#10;      多行操作支持&#10;    位置编码&#10;      &quot;UTF-16 默认&quot;&#10;      &quot;UTF-32 码点&quot;&#10;      &quot;UTF-8 字节&quot;\">mindmap\n  root((文本同步))\n    文档生命周期\n      didOpen 完整文本\n      didChange 变更事件\n      didSave 保存通知\n      didClose 释放资源\n    同步策略\n      全量同步 简单但带宽大\n      增量同步 高效但复杂\n      textDocumentSync 声明\n    版本号机制\n      单调递增\n      乱序检测与丢弃\n      ContentModified 错误\n    变更事件\n      range + text\n      插入/删除/替换\n      多行操作支持\n    位置编码\n      \"UTF-16 默认\"\n      \"UTF-32 码点\"\n      \"UTF-8 字节\"</pre><ul>\n<li>文本同步是 LSP 中最频繁的交互，涵盖 <strong>didOpen/didChange/didSave/didClose</strong> 四大事件。</li>\n<li><strong>全量同步</strong>实现简单、天然容错；<strong>增量同步</strong>带宽高效，适合生产环境和大文件场景。</li>\n<li><strong>版本号</strong>单调递增，是解决并发编辑冲突和检测结果过期的核心机制。</li>\n<li>增量变更事件通过 <strong>range + text</strong> 精确描述插入、删除和替换操作。</li>\n<li><strong>位置编码</strong>协商（UTF-8/UTF-16/UTF-32）确保客户端和服务端对字符偏移量的计算一致。</li>\n</ul>\n","headings":[{"level":1,"text":"文本同步","id":"文本同步"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"文档生命周期事件","id":"文档生命周期事件"},{"level":2,"text":"全量同步 vs 增量同步","id":"全量同步-vs-增量同步"},{"level":3,"text":"全量同步","id":"全量同步"},{"level":3,"text":"增量同步","id":"增量同步"},{"level":2,"text":"版本号与一致性","id":"版本号与一致性"},{"level":2,"text":"内容变更事件详解","id":"内容变更事件详解"},{"level":2,"text":"位置编码","id":"位置编码"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"生命周期与能力协商","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/lsp-specification/lifecycle-and-capabilities"},"next":{"title":"工作区管理","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/lsp-specification/workspace-management"}}