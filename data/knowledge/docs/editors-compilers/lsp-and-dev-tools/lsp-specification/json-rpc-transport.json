FF\">32602</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> InternalError</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32603</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ServerNotInitialized</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32002</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> UnknownErrorCode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32001</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RequestCancelled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32800</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ContentModified</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32801</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ServerCancelled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32802</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RequestFailed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32803</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>错误码</th>\n<th>名称</th>\n<th>触发场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>-32700</td>\n<td>ParseError</td>\n<td>JSON 解析失败</td>\n</tr>\n<tr>\n<td>-32600</td>\n<td>InvalidRequest</td>\n<td>不符合 JSON-RPC 规范</td>\n</tr>\n<tr>\n<td>-32601</td>\n<td>MethodNotFound</td>\n<td>方法未注册或不支持</td>\n</tr>\n<tr>\n<td>-32800</td>\n<td>RequestCancelled</td>\n<td>客户端通过 <code>$/cancelRequest</code> 取消</td>\n</tr>\n<tr>\n<td>-32801</td>\n<td>ContentModified</td>\n<td>文档已变更，结果已失效</td>\n</tr>\n<tr>\n<td>-32802</td>\n<td>ServerCancelled</td>\n<td>服务端主动取消请求</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> <code>ContentModified</code> 错误在编辑器快速输入时非常常见。客户端应静默处理此错误而非向用户报错。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((JSON-RPC 传输层))&#10;    JSON-RPC 2.0&#10;      请求/响应/通知&#10;      id 字段区分类型&#10;      无状态协议&#10;    消息帧&#10;      Content-Length 头&#10;      UTF-8 字节计数&#10;      &quot;\\\\r\\\\n\\\\r\\\\n 分隔&quot;&#10;    传输通道&#10;      stdin/stdout 最常用&#10;      TCP/Socket 远程场景&#10;      WebSocket 浏览器端&#10;    批处理&#10;      规范支持但不推荐&#10;      LSP 主流不采用&#10;      错误隔离困难&#10;    错误处理&#10;      标准 JSON-RPC 错误码&#10;      LSP 扩展错误码&#10;      RequestCancelled 最常见\">mindmap\n  root((JSON-RPC 传输层))\n    JSON-RPC 2.0\n      请求/响应/通知\n      id 字段区分类型\n      无状态协议\n    消息帧\n      Content-Length 头\n      UTF-8 字节计数\n      \"\\\\r\\\\n\\\\r\\\\n 分隔\"\n    传输通道\n      stdin/stdout 最常用\n      TCP/Socket 远程场景\n      WebSocket 浏览器端\n    批处理\n      规范支持但不推荐\n      LSP 主流不采用\n      错误隔离困难\n    错误处理\n      标准 JSON-RPC 错误码\n      LSP 扩展错误码\n      RequestCancelled 最常见</pre><ul>\n<li>LSP 基于 <strong>JSON-RPC 2.0</strong> 协议，消息分为请求（含 <code>id</code>）、响应和通知（无 <code>id</code>）三类。</li>\n<li>消息帧由 <strong>Content-Length 头</strong>和 JSON 内容体组成，以 <code>\\r\\n\\r\\n</code> 分隔，Content-Length 计算 UTF-8 字节数。</li>\n<li><strong>stdin/stdout</strong> 是最常见的传输通道，TCP 和 WebSocket 分别适用于远程开发和浏览器 IDE 场景。</li>\n<li>JSON-RPC 批处理在 LSP 中<strong>不推荐使用</strong>，主流实现均采用单条消息模式。</li>\n<li>LSP 在标准 JSON-RPC 错误码基础上扩展了 <code>RequestCancelled</code>、<code>ContentModified</code> 等语言服务专用错误码。</li>\n</ul>\n","headings":[{"level":1,"text":"JSON-RPC 传输层","id":"json-rpc-传输层"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"JSON-RPC 2.0 基础","id":"json-rpc-2-0-基础"},{"level":2,"text":"Content-Length 头与消息帧","id":"content-length-头与消息帧"},{"level":2,"text":"传输通道","id":"传输通道"},{"level":3,"text":"stdin/stdout 传输","id":"stdin-stdout-传输"},{"level":3,"text":"TCP/Socket 传输","id":"tcp-socket-传输"},{"level":3,"text":"WebSocket 传输","id":"websocket-传输"},{"level":2,"text":"消息批处理","id":"消息批处理"},{"level":2,"text":"错误处理","id":"错误处理"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"生命周期与能力协商","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/lsp-specification/lifecycle-and-capabilities"}}