:0.5'&gt;import React from 'react'&lt;/s&gt;\"]\n        API[\"oldMethod()\"] --&gt; DEPRECATED[\"&lt;s&gt;oldMethod()&lt;/s&gt;\"]\n    end</pre><blockquote>\n<p><strong>提示：</strong> 诊断标签可以与任何严重程度组合使用。即使是 Error 级别的诊断也可以标记为 Deprecated，但实践中 Unnecessary 和 Deprecated 通常搭配 Hint 严重程度。</p>\n</blockquote>\n<hr>\n<h2 id=\"快速修复联动\">快速修复联动</h2><p>诊断与 Code Actions 紧密关联。编辑器在诊断位置显示灯泡图标，点击后执行快速修复。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"connection.onCodeAction((params): CodeAction[] =&gt; {&#10;  const diagnostics = params.context.diagnostics;&#10;  const actions: CodeAction[] = [];&#10;&#10;  for (const diag of diagnostics) {&#10;    if (diag.source === &#39;ts&#39; &amp;&amp; diag.code === 6133) {&#10;      actions.push({&#10;        title: `Remove unused import`,&#10;        kind: CodeActionKind.QuickFix,&#10;        diagnostics: [diag],&#10;        isPreferred: true,&#10;        edit: {&#10;          changes: {&#10;            [params.textDocument.uri]: [{ range: diag.range, newText: &#39;&#39; }],&#10;          },&#10;        },&#10;      });&#10;    }&#10;  }&#10;&#10;  return actions;&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">connection.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onCodeAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">params</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CodeAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> diagnostics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> params.context.diagnostics;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> actions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CodeAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> diag</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> diagnostics) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (diag.source </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ts'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> diag.code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 6133</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      actions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`Remove unused import`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        kind: CodeActionKind.QuickFix,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        diagnostics: [diag],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        isPreferred: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        edit: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          changes: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            [params.textDocument.uri]: [{ range: diag.range, newText: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actions;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"sequenceDiagram\" data-source=\"sequenceDiagram&#10;    participant S as 服务端&#10;    participant E as 编辑器&#10;    participant U as 用户&#10;&#10;    S-&gt;&gt;E: publishDiagnostics (未使用导入)&#10;    E-&gt;&gt;E: 显示波浪线 + 灯泡图标&#10;    U-&gt;&gt;E: 点击灯泡&#10;    E-&gt;&gt;S: textDocument/codeAction (含 diagnostics)&#10;    S--&gt;&gt;E: CodeAction[] (删除未使用导入)&#10;    U-&gt;&gt;E: 选择修复&#10;    E-&gt;&gt;E: 应用 WorkspaceEdit\">sequenceDiagram\n    participant S as 服务端\n    participant E as 编辑器\n    participant U as 用户\n\n    S-&gt;&gt;E: publishDiagnostics (未使用导入)\n    E-&gt;&gt;E: 显示波浪线 + 灯泡图标\n    U-&gt;&gt;E: 点击灯泡\n    E-&gt;&gt;S: textDocument/codeAction (含 diagnostics)\n    S--&gt;&gt;E: CodeAction[] (删除未使用导入)\n    U-&gt;&gt;E: 选择修复\n    E-&gt;&gt;E: 应用 WorkspaceEdit</pre><table>\n<thead>\n<tr>\n<th>CodeAction 属性</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>title</td>\n<td>显示在菜单中的修复描述</td>\n</tr>\n<tr>\n<td>kind</td>\n<td>操作类型（quickfix / refactor / source）</td>\n</tr>\n<tr>\n<td>diagnostics</td>\n<td>此操作修复的诊断列表</td>\n</tr>\n<tr>\n<td>isPreferred</td>\n<td>是否为首选修复（支持批量应用）</td>\n</tr>\n<tr>\n<td>edit</td>\n<td>执行的 WorkspaceEdit</td>\n</tr>\n<tr>\n<td>command</td>\n<td>可选的后续命令</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((诊断))&#10;    推送模式&#10;      publishDiagnostics 通知&#10;      服务端主动推送&#10;      空数组清除诊断&#10;    拉取模式&#10;      客户端按需请求&#10;      resultId 增量更新&#10;      支持取消请求&#10;    关联信息&#10;      多位置上下文&#10;      类型声明引用&#10;      循环依赖追踪&#10;    诊断标签&#10;      Unnecessary 变淡&#10;      Deprecated 删除线&#10;      语义化渲染&#10;    快速修复&#10;      CodeAction 联动&#10;      isPreferred 首选&#10;      批量修复支持\">mindmap\n  root((诊断))\n    推送模式\n      publishDiagnostics 通知\n      服务端主动推送\n      空数组清除诊断\n    拉取模式\n      客户端按需请求\n      resultId 增量更新\n      支持取消请求\n    关联信息\n      多位置上下文\n      类型声明引用\n      循环依赖追踪\n    诊断标签\n      Unnecessary 变淡\n      Deprecated 删除线\n      语义化渲染\n    快速修复\n      CodeAction 联动\n      isPreferred 首选\n      批量修复支持</pre><ul>\n<li><strong>推送模式</strong>由服务端主动发送诊断，适合小项目和实时反馈场景。</li>\n<li><strong>拉取模式</strong>由客户端按需请求，通过 <code>resultId</code> 实现增量更新，适合大型项目。</li>\n<li><strong>relatedInformation</strong> 为复杂错误提供多位置上下文，帮助开发者理解错误根因。</li>\n<li><strong>DiagnosticTag</strong> 的 Unnecessary 和 Deprecated 标签让编辑器对未使用代码和废弃 API 提供视觉反馈。</li>\n<li>诊断与 <strong>Code Actions</strong> 紧密联动，通过 <code>isPreferred</code> 标记支持一键修复和批量修复。</li>\n</ul>\n","headings":[{"level":1,"text":"诊断","id":"诊断"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"推送模式（publishDiagnostics）","id":"推送模式-publishdiagnostics"},{"level":2,"text":"拉取模式（Diagnostic Pull Model）","id":"拉取模式-diagnostic-pull-model"},{"level":2,"text":"关联信息","id":"关联信息"},{"level":2,"text":"诊断标签","id":"诊断标签"},{"level":2,"text":"快速修复联动","id":"快速修复联动"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"代码补全","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/language-features/completion"},"next":{"title":"代码导航","url":"/l-doc-books/h/editors-compilers/lsp-and-dev-tools/language-features/navigation"}}