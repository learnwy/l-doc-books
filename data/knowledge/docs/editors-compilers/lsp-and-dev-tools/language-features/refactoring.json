an style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RefactorInline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'refactor.inline'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> RefactorRewrite</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'refactor.rewrite'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Source</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'source'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SourceOrganizeImports</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'source.organizeImports'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> SourceFixAll</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'source.fixAll'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    CA[Code Actions] --&gt; QF[quickfix]&#10;    CA --&gt; RF[refactor]&#10;    CA --&gt; SRC[source]&#10;&#10;    QF --&gt; FIX1[修复类型错误]&#10;    QF --&gt; FIX2[添加缺失导入]&#10;    QF --&gt; FIX3[修复拼写错误]&#10;&#10;    RF --&gt; EXTRACT[refactor.extract]&#10;    RF --&gt; INLINE[refactor.inline]&#10;    RF --&gt; REWRITE[refactor.rewrite]&#10;&#10;    EXTRACT --&gt; E1[提取函数]&#10;    EXTRACT --&gt; E2[提取变量]&#10;    EXTRACT --&gt; E3[提取接口]&#10;&#10;    SRC --&gt; ORG[organizeImports]&#10;    SRC --&gt; FIXALL[fixAll]\">graph TD\n    CA[Code Actions] --&gt; QF[quickfix]\n    CA --&gt; RF[refactor]\n    CA --&gt; SRC[source]\n\n    QF --&gt; FIX1[修复类型错误]\n    QF --&gt; FIX2[添加缺失导入]\n    QF --&gt; FIX3[修复拼写错误]\n\n    RF --&gt; EXTRACT[refactor.extract]\n    RF --&gt; INLINE[refactor.inline]\n    RF --&gt; REWRITE[refactor.rewrite]\n\n    EXTRACT --&gt; E1[提取函数]\n    EXTRACT --&gt; E2[提取变量]\n    EXTRACT --&gt; E3[提取接口]\n\n    SRC --&gt; ORG[organizeImports]\n    SRC --&gt; FIXALL[fixAll]</pre><table>\n<thead>\n<tr>\n<th>类型分类</th>\n<th>Kind 前缀</th>\n<th>触发方式</th>\n<th>典型操作</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>快速修复</td>\n<td>quickfix</td>\n<td>诊断位置灯泡</td>\n<td>修复错误、添加导入</td>\n</tr>\n<tr>\n<td>重构-提取</td>\n<td>refactor.extract</td>\n<td>选区右键菜单</td>\n<td>提取函数、变量、常量</td>\n</tr>\n<tr>\n<td>重构-内联</td>\n<td>refactor.inline</td>\n<td>标识符右键菜单</td>\n<td>内联变量、函数</td>\n</tr>\n<tr>\n<td>重构-改写</td>\n<td>refactor.rewrite</td>\n<td>标识符右键菜单</td>\n<td>转换箭头函数、展开类型</td>\n</tr>\n<tr>\n<td>源操作</td>\n<td>source</td>\n<td>保存时或命令面板</td>\n<td>整理导入、修复全部</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 客户端可通过 <code>context.only</code> 请求特定类型的 Code Action，例如保存时只触发 <code>source.organizeImports</code>。</p>\n</blockquote>\n<hr>\n<h2 id=\"code-action-实现\">Code Action 实现</h2><p>一个完整的 Code Action 实现通常包含条件检测和编辑生成两个阶段。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"connection.onCodeAction((params): CodeAction[] =&gt; {&#10;  const actions: CodeAction[] = [];&#10;  const document = documents.get(params.textDocument.uri);&#10;  if (!document) return actions;&#10;  const selectedText = document.getText(params.range);&#10;&#10;  if (selectedText &amp;&amp; params.range.start.line !== params.range.end.line) {&#10;    actions.push({&#10;      title: &#39;Extract to function&#39;,&#10;      kind: CodeActionKind.RefactorExtract,&#10;      edit: createExtractFunctionEdit(document, params.range, selectedText),&#10;    });&#10;  }&#10;  if (isArrowFunction(document, params.range)) {&#10;    actions.push({&#10;      title: &#39;Convert to named function&#39;,&#10;      kind: CodeActionKind.RefactorRewrite,&#10;      edit: createConvertToNamedFunctionEdit(document, params.range),&#10;    });&#10;  }&#10;  for (const diag of params.context.diagnostics) {&#10;    if (diag.code === &#39;missing-import&#39;) {&#10;      actions.push({&#10;        title: `Add import for &#39;${extractSymbolName(diag)}&#39;`,&#10;        kind: CodeActionKind.QuickFix,&#10;        diagnostics: [diag],&#10;        isPreferred: true,&#10;        edit: createAddImportEdit(document, diag),&#10;      });&#10;    }&#10;  }&#10;  return actions;&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">connection.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onCodeAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">params</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CodeAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> actions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CodeAction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> document</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> documents.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(params.textDocument.uri);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">document) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> actions;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> selectedText</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> document.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(params.range);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--sh