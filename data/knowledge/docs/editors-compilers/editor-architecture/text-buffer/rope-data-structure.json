\n<td>最坏情况退化</td>\n<td>CodeMirror 早期</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function rebalance(rope: Rope): Rope {&#10;  if (rope.kind === &#39;leaf&#39;) return rope;&#10;&#10;  const balanceFactor = height(rope.left) - height(rope.right);&#10;&#10;  if (balanceFactor &gt; 1) {&#10;    return rotateRight(rope);&#10;  }&#10;  if (balanceFactor &lt; -1) {&#10;    return rotateLeft(rope);&#10;  }&#10;&#10;  return rope;&#10;}&#10;&#10;function rotateRight(node: RopeNode): Rope {&#10;  const left = node.left as RopeNode;&#10;  const newRight = concat(left.right, node.right);&#10;  return concat(left.left, newRight);&#10;}&#10;&#10;function rotateLeft(node: RopeNode): Rope {&#10;  const right = node.right as RopeNode;&#10;  const newLeft = concat(node.left, right.left);&#10;  return concat(newLeft, right.right);&#10;}&#10;&#10;function height(rope: Rope): number {&#10;  return rope.kind === &#39;leaf&#39; ? 0 : rope.height;&#10;}&#10;&#10;function ropeLength(rope: Rope): number {&#10;  return rope.kind === &#39;leaf&#39; ? rope.length : rope.weight + ropeLength(rope.right);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> rebalance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rope</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Rope</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Rope</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><s