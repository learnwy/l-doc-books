;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> after</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.buffer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">slice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.gapEnd);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> before.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> after.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"光标局部性优化\">光标局部性优化</h2><p>Gap Buffer 的核心优势在于<strong>光标局部性</strong>：用户通常在当前光标位置附近进行连续编辑。当光标不移动时，插入和删除都是 O(1)。只有光标大幅跳转时才需要 O(n) 的 gap 搬移。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    TYPE[&quot;用户操作&quot;] --&gt;|连续输入| LOCAL[&quot;光标局部编辑&lt;br/&gt;O(1) 插入&quot;]&#10;    TYPE --&gt;|上下翻行| NEAR[&quot;近距离移动&lt;br/&gt;O(k) 搬移&lt;br/&gt;k 通常很小&quot;]&#10;    TYPE --&gt;|Ctrl+End| FAR[&quot;远距离跳转&lt;br/&gt;O(n) 搬移&lt;br/&gt;偶尔发生&quot;]\">graph TD\n    TYPE[\"用户操作\"] --&gt;|连续输入| LOCAL[\"光标局部编辑&lt;br/&gt;O(1) 插入\"]\n    TYPE --&gt;|上下翻行| NEAR[\"近距离移动&lt;br/&gt;O(k) 搬移&lt;br/&gt;k 通常很小\"]\n    TYPE --&gt;|Ctrl+End| FAR[\"远距离跳转&lt;br/&gt;O(n) 搬移&lt;br/&gt;偶尔发生\"]</pre><p>实际测量表明，在典型的编辑会话中：</p>\n<table>\n<thead>\n<tr>\n<th>操作类型</th>\n<th>频率占比</th>\n<th>Gap 搬移量</th>\n<th>均摊代价</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>光标处连续输入</td>\n<td>70%</td>\n<td>0</td>\n<td>O(1)</td>\n</tr>\n<tr>\n<td>相邻行跳转</td>\n<td>20%</td>\n<td>~80 字符</td>\n<td>O(行长度)</td>\n</tr>\n<tr>\n<td>远距离跳转</td>\n<td>8%</td>\n<td>~数千字符</td>\n<td>O(n)</td>\n</tr>\n<tr>\n<td>全文搜索替换</td>\n<td>2%</td>\n<td>全文扫描</td>\n<td>O(n)</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> Emacs 的 Gap Buffer 实现中，gap 的初始大小和扩容策略经过了数十年的调优。现代 Emacs 使用约 2KB 的初始 gap，并在需要扩容时按当前文件大小的一定比例增长，以减少 reallocation 次数。</p>\n</blockquote>\n<hr>\n<h2 id=\"三种缓冲区对比\">三种缓冲区对比</h2><p>Gap Buffer、Rope 和 Piece Table 各有适用场景，没有绝对的最优解。</p>\n<table>\n<thead>\n<tr>\n<th>特性</th>\n<th>Gap Buffer</th>\n<th>Rope</th>\n<th>Piece Table</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>光标处插入</td>\n<td>O(1)</td>\n<td>O(log n)</td>\n<td>O(log n)</td>\n</tr>\n<tr>\n<td>任意位置插入</td>\n<td>O(n)</td>\n<td>O(log n)</td>\n<td>O(log n)</td>\n</tr>\n<tr>\n<td>内存布局</td>\n<td>连续数组</td>\n<td>树节点分散</td>\n<td>两个连续缓冲区</td>\n</tr>\n<tr>\n<td>实现复杂度</td>\n<td>低</td>\n<td>高</td>\n<td>中</td>\n</tr>\n<tr>\n<td>多光标支持</td>\n<td>差</td>\n<td>好</td>\n<td>好</td>\n</tr>\n<tr>\n<td>撤销支持</td>\n<td>需额外实现</td>\n<td>需额外实现</td>\n<td>天然支持</td>\n</tr>\n<tr>\n<td>典型编辑器</td>\n<td>Emacs, Scintilla</td>\n<td>CodeMirror, Ropey</td>\n<td>VS Code, Monaco</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    CHOOSE{&quot;选择缓冲区&quot;} --&gt;|&quot;单光标为主&lt;br/&gt;实现简单&quot;| GAP[&quot;Gap Buffer&quot;]&#10;    CHOOSE --&gt;|&quot;多光标/协同&lt;br/&gt;O(log n) 保证&quot;| ROPE[&quot;Rope&quot;]&#10;    CHOOSE --&gt;|&quot;工业级编辑器&lt;br/&gt;综合最优&quot;| PIECE[&quot;Piece Table&quot;]\">graph TD\n    CHOOSE{\"选择缓冲区\"} --&gt;|\"单光标为主&lt;br/&gt;实现简单\"| GAP[\"Gap Buffer\"]\n    CHOOSE --&gt;|\"多光标/协同&lt;br/&gt;O(log n) 保证\"| ROPE[\"Rope\"]\n    CHOOSE --&gt;|\"工业级编辑器&lt;br/&gt;综合最优\"| PIECE[\"Piece Table\"]</pre><hr>\n<h2 id=\"现代变体与组合策略\">现代变体与组合策略</h2><p>现代编辑器通常不会纯粹使用单一数据结构，而是组合多种策略：</p>\n<table>\n<thead>\n<tr>\n<th>编辑器</th>\n<th>主数据结构</th>\n<th>辅助优化</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Emacs</td>\n<td>Gap Buffer</td>\n<td>标记表（mark table）追踪位置</td>\n</tr>\n<tr>\n<td>VS Code</td>\n<td>Piece Table</td>\n<td>红黑树索引 + 行号缓存</td>\n</tr>\n<tr>\n<td>CodeMirror 6</td>\n<td>定制 Rope</td>\n<td>B-tree 风格平衡 + 增量更新</td>\n</tr>\n<tr>\n<td>Zed</td>\n<td>Rope</td>\n<td>CRDT 集成 + SumTree</td>\n</tr>\n<tr>\n<td>Helix</td>\n<td>Rope (Ropey)</td>\n<td>Selection-first 架构</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 如果你正在构建一个轻量级编辑器组件（例如单行输入框或小型代码块编辑器），Gap Buffer 的简单性是其最大优势。当文件不超过几千行时，Gap Buffer 的实际性能往往优于复杂的树结构，因为它具有更好的缓存局部性。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Gap Buffer))&#10;    基本原理&#10;      连续字符数组&#10;      光标位置保留空隙&#10;      插入填充空隙&#10;    性能特征&#10;      光标处 O(1)&#10;      远距离跳转 O(n)&#10;      光标局部性是关键&#10;    Emacs 历史&#10;      1985 年至今&#10;      经过数十年调优&#10;      简单可靠&#10;    对比选择&#10;      Gap Buffer 简单高效&#10;      Rope 多光标友好&#10;      Piece Table 综合最优&#10;    现代实践&#10;      小型编辑器首选&#10;      常与索引结构组合&#10;      缓存友好性优势\">mindmap\n  root((Gap Buffer))\n    基本原理\n      连续字符数组\n      光标位置保留空隙\n      插入填充空隙\n    性能特征\n      光标处 O(1)\n      远距离跳转 O(n)\n      光标局部性是关键\n    Emacs 历史\n      1985 年至今\n      经过数十年调优\n      简单可靠\n    对比选择\n      Gap Buffer 简单高效\n      Rope 多光标友好\n      Piece Table 综合最优\n    现代实践\n      小型编辑器首选\n      常与索引结构组合\n      缓存友好性优势</pre><ul>\n<li>Gap Buffer 在光标位置维护一段空隙，使局部编辑操作达到 O(1) 时间复杂度。</li>\n<li>光标局部性是 Gap Buffer 性能的关键假设，70% 以上的编辑操作发生在当前光标附近。</li>\n<li>对于多光标、协同编辑等需要任意位置 O(log n) 操作的场景，Gap Buffer 不是最佳选择。</li>\n<li>三种主流缓冲区数据结构各有适用场景：Gap Buffer 适合简单场景，Rope 适合多光标，Piece Table 综合最优。</li>\n<li>现代编辑器通常组合使用数据结构和索引策略，而非依赖单一方案。</li>\n</ul>\n","headings":[{"level":1,"text":"Gap Buffer 间隙缓冲区","id":"gap-buffer-间隙缓冲区"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Gap Buffer 的基本原理","id":"gap-buffer-的基本原理"},{"level":2,"text":"TypeScript 实现","id":"typescript-实现"},{"level":2,"text":"光标局部性优化","id":"光标局部性优化"},{"level":2,"text":"三种缓冲区对比","id":"三种缓冲区对比"},{"level":2,"text":"现代变体与组合策略","id":"现代变体与组合策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Piece Table 片段表","url":"/l-doc-books/h/editors-compilers/editor-architecture/text-buffer/piece-table"},"next":{"title":"行索引与编码","url":"/l-doc-books/h/editors-compilers/editor-architecture/text-buffer/line-index-and-encoding"}}