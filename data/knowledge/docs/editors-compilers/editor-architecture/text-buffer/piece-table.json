hiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      piece.start </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> removeLen;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      piece.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> removeLen;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (pieceOffset </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> removeLen </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> piece.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      piece.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pieceOffset;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> right</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Piece</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        buffer: piece.buffer,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        start: piece.start </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pieceOffset </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> removeLen,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        length: piece.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pieceOffset </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> removeLen,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      piece.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pieceOffset;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      table.pieces.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">splice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, right);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    remaining </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> removeLen;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    pos </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> piece.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>删除操作同样不修改任何缓冲区内容，只调整或移除 Piece 描述符。</p>\n<hr>\n<h2 id=\"vs-code-的红黑树优化\">VS Code 的红黑树优化</h2><p>VS Code 的 Piece Table 实现将 Piece 描述符组织为一棵红黑树（而非简单数组），以获得 O(log n) 的随机位置访问性能。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    ROOT[&quot;Piece Node&lt;br/&gt;leftLen=6&lt;br/&gt;leftLF=0&quot;] --&gt; LEFT[&quot;Piece Node&lt;br/&gt;leftLen=0&lt;br/&gt;leftLF=0&quot;]&#10;    ROOT --&gt; RIGHT[&quot;Piece Node&lt;br/&gt;leftLen=10&lt;br/&gt;leftLF=0&quot;]&#10;    LEFT --&gt; LL[叶: original[0..6]&quot;]&#10;    LEFT --&gt; LR[&quot;null&quot;]&#10;    RIGHT --&gt; RL[叶: add[0..10]&quot;]&#10;    RIGHT --&gt; RR[叶: original[6..11]&quot;]\">graph TD\n    ROOT[\"Piece Node&lt;br/&gt;leftLen=6&lt;br/&gt;leftLF=0\"] --&gt; LEFT[\"Piece Node&lt;br/&gt;leftLen=0&lt;br/&gt;leftLF=0\"]\n    ROOT --&gt; RIGHT[\"Piece Node&lt;br/&gt;leftLen=10&lt;br/&gt;leftLF=0\"]\n    LEFT --&gt; LL[叶: original[0..6]\"]\n    LEFT --&gt; LR[\"null\"]\n    RIGHT --&gt; RL[叶: add[0..10]\"]\n    RIGHT --&gt; RR[叶: original[6..11]\"]</pre><p>每个树节点额外维护两个聚合值：</p>\n<table>\n<thead>\n<tr>\n<th>字段</th>\n<th>作用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>leftLen</td>\n<td>左子树的总字符数</td>\n</tr>\n<tr>\n<td>leftLFCnt</td>\n<td>左子树的总换行符数</td>\n</tr>\n</tbody></table>\n<p>通过这两个字段，可以在 O(log n) 时间内完成偏移量到 Piece 的定位，也能快速将行号映射为偏移量。</p>\n<blockquote>\n<p><strong>提示：</strong> 红黑树相比 AVL 树的优势在于插入/删除时的旋转次数更少（最多 2-3 次），对于编辑器这种写密集型场景更加友好。VS Code 源码中的 <code>pieceTreeBase.ts</code> 是学习这一实现的最佳参考。</p>\n</blockquote>\n<hr>\n<h2 id=\"追加写入的优势\">追加写入的优势</h2><p>Piece Table 的 append-only 设计带来了多项架构层面的优势：</p>\n<table>\n<thead>\n<tr>\n<th>优势</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>撤销简化</td>\n<td>只需反转 Piece 描述符操作，缓冲区无需回滚</td>\n</tr>\n<tr>\n<td>内存连续</td>\n<td>Add Buffer 是连续追加的，对 CPU 缓存友好</td>\n</tr>\n<tr>\n<td>快照成本低</td>\n<td>拷贝 Piece 列表即可创建文本快照</td>\n</tr>\n<tr>\n<td>天然日志</td>\n<td>Add Buffer 记录了所有编辑的完整历史</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    UNDO[&quot;撤销操作&quot;] --&gt; RESTORE[&quot;恢复旧 Piece 列表&quot;]&#10;    UNDO --&gt; KEEP[&quot;缓冲区内容不变&quot;]&#10;    SNAPSHOT[&quot;创建快照&quot;] --&gt; COPY[&quot;拷贝 Piece 数组&quot;]&#10;    SNAPSHOT --&gt; SHARE[&quot;共享底层缓冲区&quot;]\">graph TD\n    UNDO[\"撤销操作\"] --&gt; RESTORE[\"恢复旧 Piece 列表\"]\n    UNDO --&gt; KEEP[\"缓冲区内容不变\"]\n    SNAPSHOT[\"创建快照\"] --&gt; COPY[\"拷贝 Piece 数组\"]\n    SNAPSHOT --&gt; SHARE[\"共享底层缓冲区\"]</pre><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((Piece Table))&#10;    双缓冲区设计&#10;      Original Buffer 只读&#10;      Add Buffer 追加写入&#10;      永不修改原始文本&#10;    Piece 描述符&#10;      指向缓冲区区间&#10;      创建和拆分成本低&#10;      携带行号元数据&#10;    编辑操作&#10;      插入追加 + 拆分 Piece&#10;      删除调整 Piece 边界&#10;      缓冲区内容不变&#10;    红黑树优化&#10;      O&amp;#40;log n&amp;#41; 随机访问&#10;      聚合字符数和行数&#10;      VS Code 核心实现&#10;    架构优势&#10;      撤销仅操作描述符&#10;      快照成本低&#10;      天然操作日志\">mindmap\n  root((Piece Table))\n    双缓冲区设计\n      Original Buffer 只读\n      Add Buffer 追加写入\n      永不修改原始文本\n    Piece 描述符\n      指向缓冲区区间\n      创建和拆分成本低\n      携带行号元数据\n    编辑操作\n      插入追加 + 拆分 Piece\n      删除调整 Piece 边界\n      缓冲区内容不变\n    红黑树优化\n      O&amp;#40;log n&amp;#41; 随机访问\n      聚合字符数和行数\n      VS Code 核心实现\n    架构优势\n      撤销仅操作描述符\n      快照成本低\n      天然操作日志</pre><ul>\n<li>Piece Table 将文本表示为指向两个不可变缓冲区（Original + Add）的片段描述符序列。</li>\n<li>所有编辑操作只追加新文本到 Add Buffer 并调整 Piece 描述符，永不修改已有数据。</li>\n<li>VS Code 使用红黑树组织 Piece 描述符，实现 O(log n) 的偏移量定位和行号映射。</li>\n<li>append-only 设计天然支持低成本的撤销、快照和操作日志功能。</li>\n<li>Piece Table 在编辑器场景中的综合表现优于 Rope 和 Gap Buffer，是现代编辑器的首选方案。</li>\n</ul>\n","headings":[{"level":1,"text":"Piece Table 片段表","id":"piece-table-片段表"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"什么是 Piece Table","id":"什么是-piece-table"},{"level":2,"text":"片段描述符设计","id":"片段描述符设计"},{"level":2,"text":"插入与删除操作","id":"插入与删除操作"},{"level":2,"text":"VS Code 的红黑树优化","id":"vs-code-的红黑树优化"},{"level":2,"text":"追加写入的优势","id":"追加写入的优势"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Rope 数据结构","url":"/l-doc-books/h/editors-compilers/editor-architecture/text-buffer/rope-data-structure"},"next":{"title":"Gap Buffer 间隙缓冲区","url":"/l-doc-books/h/editors-compilers/editor-architecture/text-buffer/gap-buffer"}}