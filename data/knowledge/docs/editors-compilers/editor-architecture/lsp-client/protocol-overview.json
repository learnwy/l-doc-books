art\">stateDiagram-v2\n    [*] --&gt; 启动中: spawn process\n    启动中 --&gt; 初始化: initialize request\n    初始化 --&gt; 运行中: initialized notification\n    运行中 --&gt; 关闭中: shutdown request\n    关闭中 --&gt; 已退出: exit notification\n    已退出 --&gt; [*]\n    运行中 --&gt; 崩溃: process crash\n    崩溃 --&gt; 启动中: auto-restart</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface LanguageServerManager {&#10;  start(config: ServerConfig): Promise&lt;void&gt;;&#10;  stop(): Promise&lt;void&gt;;&#10;  restart(): Promise&lt;void&gt;;&#10;  onCrash(handler: (error: Error) =&gt; void): void;&#10;}&#10;&#10;interface ServerConfig {&#10;  command: string;&#10;  args: string[];&#10;  transport: &#39;stdio&#39; | &#39;socket&#39; | &#39;pipe&#39;;&#10;  maxRestartCount: number;&#10;  restartDelayMs: number;&#10;  initializationOptions?: unknown;&#10;}&#10;&#10;class ServerLifecycle implements LanguageServerManager {&#10;  private restartCount = 0;&#10;&#10;  async start(config: ServerConfig): Promise&lt;void&gt; {&#10;    const process = spawn(config.command, config.args);&#10;    const connection = createConnection(process.stdin, process.stdout);&#10;&#10;    const result = await connection.sendRequest&lt;InitializeResult&gt;(&#39;initialize&#39;, {&#10;      capabilities: this.getClientCapabilities(),&#10;    });&#10;&#10;    this.negotiatedCapabilities = result.capabilities;&#10;    connection.sendNotification(&#39;initialized&#39;, {});&#10;  }&#10;&#10;  async stop(): Promise&lt;void&gt; {&#10;    await this.connection.sendRequest(&#39;shutdown&#39;);&#10;    this.connection.sendNotification(&#39;exit&#39;);&#10;  }&#10;&#10;  async restart(): Promise&lt;void&gt; {&#10;    if (this.restartCount &gt;= this.config.maxRestartCount) {&#10;      throw new Error(&#39;Max restart count exceeded&#39;);&#10;    }&#10;    this.restartCount++;&#10;    await this.stop().catch(() =&gt; {});&#10;    await delay(this.config.restartDelayMs);&#10;    await this.start(this.config);&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LanguageServerManager</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  start</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ServerConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  stop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  restart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">v