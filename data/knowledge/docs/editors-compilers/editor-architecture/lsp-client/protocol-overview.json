\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InitializeResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  capabilities</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ServerCapabilities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  serverInfo</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    version</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><blockquote>\n<p><strong>提示：</strong> 在 <code>initialized</code> 通知发送之前，客户端不应发送任何其他请求或通知。违反此约定可能导致服务器忽略消息或返回错误。</p>\n</blockquote>\n<hr>\n<h2 id=\"能力协商机制\">能力协商机制</h2><p>能力协商是 LSP 最精妙的设计之一。客户端和服务器各自声明支持的功能集，双方根据交集决定可用特性。这使得协议可以渐进演进而不破坏兼容性。</p>\n<table>\n<thead>\n<tr>\n<th>能力类别</th>\n<th>客户端能力示例</th>\n<th>服务端能力示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>文本同步</td>\n<td>textDocument.synchronization</td>\n<td>textDocumentSync (Full/Incremental)</td>\n</tr>\n<tr>\n<td>补全</td>\n<td>textDocument.completion</td>\n<td>completionProvider</td>\n</tr>\n<tr>\n<td>悬停</td>\n<td>textDocument.hover</td>\n<td>hoverProvider</td>\n</tr>\n<tr>\n<td>诊断</td>\n<td>textDocument.publishDiagnostics</td>\n<td>diagnosticProvider</td>\n</tr>\n<tr>\n<td>代码操作</td>\n<td>textDocument.codeAction</td>\n<td>codeActionProvider</td>\n</tr>\n<tr>\n<td>工作区符号</td>\n<td>workspace.symbol</td>\n<td>workspaceSymbolProvider</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ClientCapabilities {&#10;  textDocument?: {&#10;    completion?: {&#10;      completionItem?: {&#10;        snippetSupport?: boolean;&#10;        commitCharactersSupport?: boolean;&#10;        documentationFormat?: MarkupKind[];&#10;        deprecatedSupport?: boolean;&#10;        preselectSupport?: boolean;&#10;        insertReplaceSupport?: boolean;&#10;      };&#10;    };&#10;    hover?: {&#10;      contentFormat?: MarkupKind[];&#10;    };&#10;    publishDiagnostics?: {&#10;      relatedInformation?: boolean;&#10;      tagSupport?: { valueSet: DiagnosticTag[] };&#10;      versionSupport?: boolean;&#10;    };&#10;  };&#10;  workspace?: {&#10;    workspaceFolders?: boolean;&#10;    configuration?: boolean;&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ClientCapabilities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  textDocument</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\">