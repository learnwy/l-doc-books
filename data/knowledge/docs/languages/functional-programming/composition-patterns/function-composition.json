iki-dark:#FFAB70\">s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'-'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"haskell\" data-code=\"processString :: String -&gt; String&#10;processString = trim . toLower . intercalate &quot;-&quot; . words\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>processString :: String -> String</span></span>\n<span class=\"line\"><span>processString = trim . toLower . intercalate \"-\" . words</span></span></code></pre></div><p>不同组合方式的对比：</p>\n<table>\n<thead>\n<tr>\n<th>组合方式</th>\n<th>方向</th>\n<th>可读性</th>\n<th>类型安全</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>compose(f, g)</code></td>\n<td>右到左</td>\n<td>数学直觉</td>\n<td>✅ 泛型</td>\n</tr>\n<tr>\n<td><code>pipe(g, f)</code></td>\n<td>左到右</td>\n<td>数据流直觉</td>\n<td>✅ 泛型</td>\n</tr>\n<tr>\n<td>方法链 <code>.map().filter()</code></td>\n<td>左到右</td>\n<td>非常好</td>\n<td>✅</td>\n</tr>\n<