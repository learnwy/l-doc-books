n</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.items;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LazyList</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">9</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">take</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    L0[LazyList [1..10]&quot;] --&gt;|&quot;.filter(even)&quot;| L1[LazyList [2,4,6,8,10]&quot;]&#10;    L1 --&gt;|&quot;.map(square)&quot;| L2[LazyList [4,16,36,64,100]&quot;]&#10;    L2 --&gt;|&quot;.take(3)&quot;| L3[LazyList [4,16,36]&quot;]&#10;    L3 --&gt;|&quot;.toArray()&quot;| R[[4,16,36]&quot;]\">graph LR\n    L0[LazyList [1..10]\"] --&gt;|\".filter(even)\"| L1[LazyList [2,4,6,8,10]\"]\n    L1 --&gt;|\".map(square)\"| L2[LazyList [4,16,36,64,100]\"]\n    L2 --&gt;|\".take(3)\"| L3[LazyList [4,16,36]\"]\n    L3 --&gt;|\".toArray()\"| R[[4,16,36]\"]</pre><p>方法链与函数管道的对比：</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>方法链</th>\n<th>函数管道</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>扩展性</td>\n<td>需要修改类或继承</td>\n<td>任意函数均可加入</td>\n</tr>\n<tr>\n<td>类型安全</td>\n<td>方法签名保证</td>\n<td>需要泛型重载</td>\n</tr>\n<tr>\n<td>发现性</td>\n<td>IDE 自动补全</td>\n<td>需要了解可用函数</td>\n</tr>\n<tr>\n<td>灵活性</td>\n<td>受限于类的方法集</td>\n<td>任意函数自由组合</td>\n</tr>\n<tr>\n<td>Tree-shaking</td>\n<td>所有方法都被打包</td>\n<td>只打包用到的函数</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> JavaScript 内置的 <code>Array.prototype</code> 方法链（<code>.map().filter().reduce()</code>）是最常见的方法链实例。但注意每次操作都创建中间数组，对于大数据集需要考虑性能。</p>\n</blockquote>\n<hr>\n<h2 id=\"构建类型安全的-pipe\">构建类型安全的 pipe</h2><p>实现一个类型安全的 <code>pipe</code> 函数需要利用 TypeScript 的泛型重载：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function pipe&lt;A&gt;(a: A): A;&#10;function pipe&lt;A, B&gt;(a: A, ab: (a: A) =&gt; B): B;&#10;function pipe&lt;A, B, C&gt;(a: A, ab: (a: A) =&gt; B, bc: (b: B) =&gt; C): C;&#10;function pipe&lt;A, B, C, D&gt;(a: A, ab: (a: A) =&gt; B, bc: (b: B) =&gt; C, cd: (c: C) =&gt; D): D;&#10;function pipe&lt;A, B, C, D, E&gt;(a: A, ab: (a: A) =&gt; B, bc: (b: B) =&gt; C, cd: (c: C) =&gt; D, de: (d: D) =&gt; E): E;&#10;function pipe(a: unknown, ...fns: Array&lt;(a: unknown) =&gt; unknown&gt;): unknown {&#10;  return fns.reduce((acc, fn) =&gt; fn(acc), a);&#10;}&#10;&#10;const processUser = (name: string) =&gt;&#10;  pipe(&#10;    name,&#10;    (s: string) =&gt; s.trim(),&#10;    (s: s