n style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">module</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">message</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `[${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">level</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}] [${</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">module</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}] ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">message</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> errorLog</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> partial</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(log, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ERROR'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> authError</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> partial</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(log, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ERROR'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'AUTH'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"haskell\" data-code=\"import Data.List (intercalate)&#10;&#10;joinWith :: String -&gt; [String] -&gt; String&#10;joinWith = intercalate&#10;&#10;commaSeparated :: [String] -&gt; String&#10;commaSeparated = joinWith &quot;, &quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>import Data.List (intercalate)</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>joinWith :: String -> [String] -> String</span></span>\n<span class=\"line\"><span>joinWith = intercalate</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>commaSeparated :: [String] -> String</span></span>\n<span class=\"line\"><span>commaSeparated = joinWith \", \"</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    FULL[&quot;log(level, module, msg)&quot;] --&gt;|&quot;固定 level=&#39;ERROR&#39;&quot;| PARTIAL1[&quot;errorLog(module, msg)&quot;]&#10;    PARTIAL1 --&gt;|&quot;固定 module=&#39;AUTH&#39;&quot;| PARTIAL2[&quot;authError(msg)&quot;]&#10;    PARTIAL2 --&gt;|&quot;传入 msg&quot;| RESULT[&quot;最终字符串&quot;]\">graph TD\n    FULL[\"log(level, module, msg)\"] --&gt;|\"固定 level='ERROR'\"| PARTIAL1[\"errorLog(module, msg)\"]\n    PARTIAL1 --&gt;|\"固定 module='AUTH'\"| PARTIAL2[\"authError(msg)\"]\n    PARTIAL2 --&gt;|\"传入 msg\"| RESULT[\"最终字符串\"]</pre><p>柯里化与偏应用的对比：</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>柯里化</th>\n<th>偏应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>参数固定数量</td>\n<td>每次恰好一个</td>\n<td>一次可以多个</td>\n</tr>\n<tr>\n<td>返回函数元数</td>\n<td>总是一元函数</td>\n<td>取决于剩余参数数量</td>\n</tr>\n<tr>\n<td>参数顺序</td>\n<td>必须从左到右</td>\n<td>可以固定任意位置</td>\n</tr>\n<tr>\n<td>实现方式</td>\n<td>函数变换</td>\n<td>闭包捕获</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 在设计柯里化友好的 API 时，应将最不常变化的参数放在前面（如配置、选项），将最常变化的参数（如数据）放在最后。这样偏应用或柯里化时可以先固定配置，得到一个处理数据的专用函数。</p>\n</blockquote>\n<hr>\n<h2 id=\"实际应用场景\">实际应用场景</h2><p>柯里化和偏应用在日常开发中有广泛应用：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const createValidator =&#10;  (rules: Record&lt;string, (v: unknown) =&gt; boolean&gt;) =&gt;&#10;  (fieldName: string) =&gt;&#10;  (value: unknown): boolean =&gt;&#10;    rules[fieldName]?.(value) ?? false;&#10;&#10;const validate = createValidator({&#10;  email: (v) =&gt; typeof v === &#39;string&#39; &amp;&amp; v.includes(&#39;@&#39;),&#10;  age: (v) =&gt; typeof v === &#39;number&#39; &amp;&amp; v &gt;= 0 &amp;&amp; v &lt;= 150,&#10;});&#10;&#10;const validateEmail = validate(&#39;email&#39;);&#10;const validateAge = validate(&#39;age&#39;);&#10;&#10;const createApiClient =&#10;  (baseUrl: string) =&gt;&#10;  (endpoint: string) =&gt;&#10;  (params?: Record&lt;string, string&gt;): string =&gt; {&#10;    const query = params ? &#39;?&#39; + new URLSearchParams(params).toString() : &#39;&#39;;&#10;    return `${baseUrl}${endpoint}${query}`;&#10;  };&#10;&#10;const api = createApiClient(&#39;https://api.example.com&#39;);&#10;const usersApi = api(&#39;/users&#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> createValidator</span><span style=\"color:#D73A49;--shiki-dark: