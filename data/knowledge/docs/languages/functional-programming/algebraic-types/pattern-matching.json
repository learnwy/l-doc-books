th: w, height: h }) =&gt; w * h,&#10;// };\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 提案语法（未来）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// const result = match (shape) {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//   when ({ kind: \"circle\", radius: r }) => Math.PI * r ** 2,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">//   when ({ kind: \"rectangle\", width: w, height: h }) => w * h,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// };</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>TypeScript 模拟技巧</th>\n<th>穷尽检查</th>\n<th>解构</th>\n<th>类型收窄</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>switch + never</td>\n<td>✅</td>\n<td>手动</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>if + type guard</td>\n<td>⚠️</td>\n<td>手动</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>ts-pattern 库</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>TC39 提案（未来）</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((模式匹配))&#10;    核心能力&#10;      解构绑定&#10;      穷尽检查&#10;      嵌套匹配&#10;      守卫条件&#10;    模式种类&#10;      字面量&#10;      变量 / 通配符&#10;      构造器&#10;      嵌套 / As&#10;    语言支持&#10;      Haskell - 完整&#10;      Rust - 最强大&#10;      TypeScript - switch 模拟&#10;      TC39 提案&#10;    最佳实践&#10;      始终穷尽&#10;      never 兜底&#10;      避免通配符过度使用\">mindmap\n  root((模式匹配))\n    核心能力\n      解构绑定\n      穷尽检查\n      嵌套匹配\n      守卫条件\n    模式种类\n      字面量\n      变量 / 通配符\n      构造器\n      嵌套 / As\n    语言支持\n      Haskell - 完整\n      Rust - 最强大\n      TypeScript - switch 模拟\n      TC39 提案\n    最佳实践\n      始终穷尽\n      never 兜底\n      避免通配符过度使用</pre><ul>\n<li><strong>模式匹配</strong>是对代数数据类型进行分支处理的核心机制，远比 switch/case 强大。</li>\n<li>编译器的<strong>穷尽检查</strong>确保所有变体都被处理，是类型安全的重要保障。</li>\n<li>Rust 的 match 表达式支持范围、守卫、Or 模式等丰富特性，是最强大的模式匹配实现之一。</li>\n<li>TypeScript 通过 switch + never 类型或 ts-pattern 库模拟模式匹配。</li>\n<li>避免过度使用通配符 <code>_</code>，让编译器帮你发现未处理的新变体。</li>\n</ul>\n","headings":[{"level":1,"text":"模式匹配","id":"模式匹配"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"模式匹配概述","id":"模式匹配概述"},{"level":2,"text":"模式的种类","id":"模式的种类"},{"level":2,"text":"Rust 中的模式匹配","id":"rust-中的模式匹配"},{"level":2,"text":"TypeScript 中的模式匹配","id":"typescript-中的模式匹配"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Option 与 Result","url":"/l-doc-books/h/languages/functional-programming/algebraic-types/option-and-result"},"next":{"title":"可辨识联合","url":"/l-doc-books/h/languages/functional-programming/algebraic-types/discriminated-unions"}}