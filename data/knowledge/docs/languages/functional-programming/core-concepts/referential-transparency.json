 style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fib</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fib</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)));</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    CALL[&quot;fib(5)&quot;] --&gt; CHECK{缓存中有?}&#10;    CHECK --&gt;|否| COMPUTE[&quot;计算 fib(4) + fib(3)&quot;]&#10;    COMPUTE --&gt; STORE[&quot;存入缓存&quot;]&#10;    STORE --&gt; RETURN[&quot;返回结果&quot;]&#10;    CHECK --&gt;|是| CACHED[&quot;直接返回缓存值&quot;]\">graph TD\n    CALL[\"fib(5)\"] --&gt; CHECK{缓存中有?}\n    CHECK --&gt;|否| COMPUTE[\"计算 fib(4) + fib(3)\"]\n    COMPUTE --&gt; STORE[\"存入缓存\"]\n    STORE --&gt; RETURN[\"返回结果\"]\n    CHECK --&gt;|是| CACHED[\"直接返回缓存值\"]</pre><table>\n<thead>\n<tr>\n<th>项目</th>\n<th>无记忆化</th>\n<th>有记忆化</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>fib(10)</td>\n<td>177 次调用</td>\n<td>11 次调用</td>\n</tr>\n<tr>\n<td>fib(30)</td>\n<td>2,692,537 次</td>\n<td>31 次</td>\n</tr>\n<tr>\n<td>fib(50)</td>\n<td>~25 亿次</td>\n<td>51 次</td>\n</tr>\n<tr>\n<td>时间复杂度</td>\n<td>O(2ⁿ)</td>\n<td>O(n)</td>\n</tr>\n<tr>\n<td>空间复杂度</td>\n<td>O(n) 栈</td>\n<td>O(n) 缓存</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"并发与并行安全\">并发与并行安全</h2><p>引用透明的表达式天然支持并行求值，因为它们之间没有共享的可变状态。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const processItems = (items: readonly string[]): Promise&lt;string[]&gt; =&gt;&#10;  Promise.all(items.map((item) =&gt; processOne(item)));&#10;&#10;const processOne = (item: string): Promise&lt;string&gt; =&gt; Promise.resolve(item.toUpperCase());\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processItems</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">items</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">all</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(items.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processOne</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item)));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processOne</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">item</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">resolve</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(item.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toUpperCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph &quot;引用透明 - 安全并行&quot;&#10;        T1[&quot;线程 1: f(a)&quot;] --&gt; R1[&quot;结果 1&quot;]&#10;        T2[&quot;线程 2: f(b)&quot;] --&gt; R2[&quot;结果 2&quot;]&#10;        T3[&quot;线程 3: f(c)&quot;] --&gt; R3[&quot;结果 3&quot;]&#10;    end&#10;    subgraph &quot;引用不透明 - 需要同步&quot;&#10;        T4[&quot;线程 1: g()&quot;] --&gt; S[&quot;共享状态&quot;]&#10;        T5[&quot;线程 2: g()&quot;] --&gt; S&#10;        S --&gt; LOCK[&quot;🔒 锁&quot;]&#10;    end\">graph TD\n    subgraph \"引用透明 - 安全并行\"\n        T1[\"线程 1: f(a)\"] --&gt; R1[\"结果 1\"]\n        T2[\"线程 2: f(b)\"] --&gt; R2[\"结果 2\"]\n        T3[\"线程 3: f(c)\"] --&gt; R3[\"结果 3\"]\n    end\n    subgraph \"引用不透明 - 需要同步\"\n        T4[\"线程 1: g()\"] --&gt; S[\"共享状态\"]\n        T5[\"线程 2: g()\"] --&gt; S\n        S --&gt; LOCK[\"🔒 锁\"]\n    end</pre><table>\n<thead>\n<tr>\n<th>并发模型</th>\n<th>引用透明代码</th>\n<th>引用不透明代码</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>无锁并行</td>\n<td>✅ 天然支持</td>\n<td>❌ 竞态条件</td>\n</tr>\n<tr>\n<td>确定性</td>\n<td>✅ 结果不依赖执行顺序</td>\n<td>❌ 顺序敏感</td>\n</tr>\n<tr>\n<td>可重放</td>\n<td>✅ 相同输入相同输出</td>\n<td>❌ 依赖运行时状态</td>\n</tr>\n<tr>\n<td>分布式计算</td>\n<td>✅ MapReduce 友好</td>\n<td>❌ 需要额外协调</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> MapReduce、Spark 等分布式计算框架的设计本质上依赖引用透明性——如果 map 函数有副作用，在多台机器上并行执行就会产生不一致的结果。</p>\n</blockquote>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((引用透明性))&#10;    定义&#10;      表达式可被值替换&#10;      纯函数的推论&#10;      求值顺序无关&#10;    等式推理&#10;      代数推导&#10;      map 融合&#10;      filter 融合&#10;      编译器优化&#10;    惰性求值&#10;      按需计算&#10;      无限数据结构&#10;      Haskell 默认&#10;    Memoization&#10;      安全缓存&#10;      指数降为线性&#10;      空间换时间&#10;    并发安全&#10;      无锁并行&#10;      确定性结果&#10;      MapReduce\">mindmap\n  root((引用透明性))\n    定义\n      表达式可被值替换\n      纯函数的推论\n      求值顺序无关\n    等式推理\n      代数推导\n      map 融合\n      filter 融合\n      编译器优化\n    惰性求值\n      按需计算\n      无限数据结构\n      Haskell 默认\n    Memoization\n      安全缓存\n      指数降为线性\n      空间换时间\n    并发安全\n      无锁并行\n      确定性结果\n      MapReduce</pre><ul>\n<li><strong>引用透明性</strong>意味着表达式可以被其值安全替换，是纯函数的直接推论。</li>\n<li><strong>等式推理</strong>让程序推导如同代数运算，是编译器优化（如 map 融合）的理论基础。</li>\n<li><strong>惰性求值</strong>依赖引用透明性才能安全工作，使无限数据结构和按需计算成为可能。</li>\n<li><strong>Memoization</strong> 对纯函数天然适用，可将指数级复杂度降为线性。</li>\n<li>引用透明的代码天然支持并行计算和分布式处理，无需额外同步机制。</li>\n</ul>\n","headings":[{"level":1,"text":"引用透明性","id":"引用透明性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"定义与本质","id":"定义与本质"},{"level":2,"text":"等式推理","id":"等式推理"},{"level":2,"text":"惰性求值与引用透明","id":"惰性求值与引用透明"},{"level":2,"text":"Memoization","id":"memoization"},{"level":2,"text":"并发与并行安全","id":"并发与并行安全"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"递归与尾调用","url":"/l-doc-books/h/languages/functional-programming/core-concepts/recursion-and-tail-call"},"next":{"title":"函数组合","url":"/l-doc-books/h/languages/functional-programming/composition-patterns/function-composition"}}