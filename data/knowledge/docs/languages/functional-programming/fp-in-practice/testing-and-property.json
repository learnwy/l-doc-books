pan class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><p>fast-check 内置生成器：</p>\n<table>\n<thead>\n<tr>\n<th>生成器</th>\n<th>类型</th>\n<th>生成范围</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>fc.integer()</code></td>\n<td>number</td>\n<td>任意整数</td>\n</tr>\n<tr>\n<td><code>fc.float()</code></td>\n<td>number</td>\n<td>任意浮点数</td>\n</tr>\n<tr>\n<td><code>fc.string()</code></td>\n<td>string</td>\n<td>任意字符串</td>\n</tr>\n<tr>\n<td><code>fc.boolean()</code></td>\n<td>boolean</td>\n<td>true / false</td>\n</tr>\n<tr>\n<td><code>fc.array(arb)</code></td>\n<td>T[]</td>\n<td>任意长度数组</td>\n</tr>\n<tr>\n<td><code>fc.record()</code></td>\n<td>object</td>\n<td>按结构生成对象</td>\n</tr>\n<tr>\n<td><code>fc.oneof()</code></td>\n<td>T</td>\n<td>从多个生成器中选择</td>\n</tr>\n<tr>\n<td><code>fc.tuple()</code></td>\n<td>[A, B, ...]</td>\n<td>元组生成</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    GEN[&quot;生成器&quot;] --&gt;|&quot;生成 100 个输入&quot;| INPUTS[&quot;随机输入&quot;]&#10;    INPUTS --&gt; TEST[&quot;运行测试&quot;]&#10;    TEST --&gt;|全部通过| PASS[&quot;✅ 通过&quot;]&#10;    TEST --&gt;|某个失败| SHRINK[&quot;缩小反例&quot;]&#10;    SHRINK --&gt; MIN[&quot;最小反例&quot;]&#10;    MIN --&gt; REPORT[&quot;报告失败&quot;]\">graph LR\n    GEN[\"生成器\"] --&gt;|\"生成 100 个输入\"| INPUTS[\"随机输入\"]\n    INPUTS --&gt; TEST[\"运行测试\"]\n    TEST --&gt;|全部通过| PASS[\"✅ 通过\"]\n    TEST --&gt;|某个失败| SHRINK[\"缩小反例\"]\n    SHRINK --&gt; MIN[\"最小反例\"]\n    MIN --&gt; REPORT[\"报告失败\"]</pre><hr>\n<h2 id=\"shrinking-自动缩小反例\">Shrinking：自动缩小反例</h2><p>当属性测试发现失败用例时，框架会自动<strong>缩小</strong>（Shrink）输入，找到导致失败的最小反例：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"fc.assert(&#10;  fc.property(fc.array(fc.integer({ min: 1, max: 100 })), (arr) =&gt; {&#10;    return arr.filter((x) =&gt; x &gt; 50).length &lt;= arr.length / 2;&#10;  }),&#10;);&#10;// 失败时框架会报告最小反例，例如 [51, 51, 51]&#10;// 而不是原始的 [73, 88, 52, 91, 67, 54, ...]\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">assert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">property</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">integer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ min: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, max: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })), (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">arr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> arr.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">x</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> arr.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 失败时框架会报告最小反例，例如 [51, 51, 51]</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 而不是原始的 [73, 88, 52, 91, 67, 54, ...]</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>缩小策略</th>\n<th>描述</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数字缩小</td>\n<td>趋向 0</td>\n<td>1000 → 500 → 100 → 51</td>\n</tr>\n<tr>\n<td>数组缩小</td>\n<td>减少长度</td>\n<td>[a,b,c,d] → [a,b,c]</td>\n</tr>\n<tr>\n<td>字符串缩小</td>\n<td>减少长度和字符复杂度</td>\n<td>&quot;abc&quot; → &quot;ab&quot; → &quot;a&quot;</td>\n</tr>\n<tr>\n<td>对象缩小</td>\n<td>逐字段缩小</td>\n<td>{a:100,b:200} → {a:1,b:1}</td>\n</tr>\n</tbody></table>\n<blockquote>\n<p><strong>提示：</strong> 好的 shrinking 是属性测试框架的核心竞争力。没有 shrinking，失败的反例可能是一个包含 100 个元素的复杂数组——有了 shrinking，你看到的是一个 3 个元素的最小反例，调试效率大幅提升。</p>\n</blockquote>\n<hr>\n<h2 id=\"函数式代码更易测试\">函数式代码更易测试</h2><p>纯函数和不可变数据使属性测试变得特别自然：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const add = (a: number, b: number): number =&gt; a + b;&#10;&#10;fc.assert(fc.property(fc.integer(), fc.integer(), (a, b) =&gt; add(a, b) === add(b, a)));&#10;&#10;fc.assert(fc.property(fc.integer(), fc.integer(), fc.integer(), (a, b, c) =&gt; add(add(a, b), c) === add(a, add(b, c))));&#10;&#10;fc.assert(fc.property(fc.integer(), (a) =&gt; add(a, 0) === a));\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> add</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">assert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">property</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(fc.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">integer</span><span style=\"color:#24292E;-