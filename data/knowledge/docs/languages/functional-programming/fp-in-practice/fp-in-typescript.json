color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    xs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Option</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_tag</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'None'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_tag</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'Some'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Either</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">E</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_tag</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'Left'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">left</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> E</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_tag</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'Right'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">right</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>FP 特性</th>\n<th>TypeScript 支持</th>\n<th>备注</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>一等函数</td>\n<td>✅ 原生</td>\n<td>箭头函数、闭包</td>\n</tr>\n<tr>\n<td>泛型</td>\n<td>✅ 原生</td>\n<td>类型参数、约束</td>\n</tr>\n<tr>\n<td>联合类型（ADT）</td>\n<td>✅ 原生</td>\n<td>可辨识联合</td>\n</tr>\n<tr>\n<td>模式匹配</td>\n<td>⚠️ switch 模拟</td>\n<td>ts-pattern 库增强</td>\n</tr>\n<tr>\n<td>不可变性</td>\n<td>⚠️ readonly</td>\n<td>编译时，非运行时</td>\n</tr>\n<tr>\n<td>高阶类型（HKT）</td>\n<td>❌ 无原生</td>\n<td>需要编码技巧</td>\n</tr>\n<tr>\n<td>尾调用优化</td>\n<td>❌ 运行时不支持</td>\n<td>Trampoline 替代</td>\n</tr>\n<tr>\n<td>do 语法</td>\n<td>❌ 无</td>\n<td>链式调用 / generator</td>\n</tr>\n</tbody></table>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    TS[&quot;TypeScript&quot;] --&gt; NATIVE[&quot;原生支持&quot;]&#10;    TS --&gt; LIB[&quot;库增强&quot;]&#10;    TS --&gt; MISSING[&quot;缺失/受限&quot;]&#10;    NATIVE --&gt; F1[&quot;一等函数&quot;]&#10;    NATIVE --&gt; F2[&quot;泛型&quot;]&#10;    NATIVE --&gt; F3[&quot;联合类型&quot;]&#10;    LIB --&gt; L1[&quot;fp-ts&quot;]&#10;    LIB --&gt; L2[&quot;Effect&quot;]&#10;    LIB --&gt; L3[&quot;ts-pattern&quot;]&#10;    MISSING --&gt; M1[&quot;HKT&quot;]&#10;    MISSING --&gt; M2[&quot;TCO&quot;]\">graph TD\n    TS[\"TypeScript\"] --&gt; NATIVE[\"原生支持\"]\n    TS --&gt; LIB[\"库增强\"]\n    TS --&gt; MISSING[\"缺失/受限\"]\n    NATIVE --&gt; F1[\"一等函数\"]\n    NATIVE --&gt; F2[\"泛型\"]\n    NATIVE --&gt; F3[\"联合类型\"]\n    LIB --&gt; L1[\"fp-ts\"]\n    LIB --&gt; L2[\"Effect\"]\n    LIB --&gt; L3[\"ts-pattern\"]\n    MISSING --&gt; M1[\"HKT\"]\n    MISSING --&gt; M2[\"TCO\"]</pre><blockquote>\n<p><strong>提示：</strong> TypeScript 最大的 FP 障碍是缺少高阶类型（Higher-Kinded Types）。在 Haskell 中你可以写 <code>class Functor f where fmap :: (a -&gt; b) -&gt; f a -&gt; f b</code>，但 TypeScript 无法直接表达这种&quot;类型参数也接受类型参数&quot;的概念。fp-ts 通过 HKT 编码技巧绕过了这个限制。</p>\n</blockquote>\n<hr>\n<h2 id=\"fp-ts-生态\">fp-ts 生态</h2><p><strong>fp-ts</strong> 是 TypeScript 中最成熟的函数式编程库，它提供了完整的 Functor、Applicative、Monad 类型类体系：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { pipe } from &#39;fp-ts/function&#39;;&#10;import * as O from &#39;fp-ts/Option&#39;;&#10;import * as E from &#39;fp-ts/Either&#39;;&#10;import * as A from &#39;fp-ts/Array&#39;;&#10;&#10;const processUsers = (users: Array&lt;{ name: string; age: number }&gt;) =&gt;&#10;  pipe(&#10;    users,&#10;    A.filter((u) =&gt; u.age &gt;= 18),&#10;    A.map((u) =&gt; u.name),&#10;    A.sort(S.Ord),&#10;  );&#10;&#10;const safeDivide = (a: number, b: number): O.Option&lt;number&gt; =&gt; (b === 0 ? O.none : O.some(a / b));&#10;&#10;const compute = pipe(&#10;  O.some(100),&#10;  O.flatMap((x) =&gt; safeDivide(x, 3)),&#10;  O.flatMap((y) =&gt; safeDivide(y, 2)),&#10;  O.getOrElse(() =&gt; 0),&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { pipe } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'fp-ts/function'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> O </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'fp-ts/Option'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> E </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'fp-ts/Either'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-