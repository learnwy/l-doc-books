span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.txt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> head</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -5</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dos2unix</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> windows_file.txt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unix2dos</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> linux_file.txt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 's/\\r$//'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> windows_file.txt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> unix_file.txt</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const text = &#39;line1\\r\\nline2\\r\\nline3&#39;;&#10;text.split(/\\r?\\n/);&#10;&#10;const universalNewline = /\\r\\n|\\r|\\n/g;&#10;text.replace(universalNewline, &#39;\\n&#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'line1</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\r\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">line2</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\r\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">line3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">split</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> universalNewline</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\r\\n</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(universalNewline, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((文本编码))&#10;    编码体系&#10;      ASCII 基础&#10;      UTF-8 主流&#10;      UTF-16 JS 内部&#10;      GB18030 中文&#10;    UTF-8 细节&#10;      变长 1-4 字节&#10;      兼容 ASCII&#10;      自同步特性&#10;    编码工具&#10;      file 检测&#10;      iconv 转换&#10;      chardet Python&#10;    正则影响&#10;      u 标志处理码点&#10;      BOM 干扰行首&#10;      编码不一致乱码&#10;    换行符&#10;      &quot;LF / CRLF / CR&quot;&#10;      &quot;\\\\r?\\\\n 兼容匹配&quot;&#10;      dos2unix 转换\">mindmap\n  root((文本编码))\n    编码体系\n      ASCII 基础\n      UTF-8 主流\n      UTF-16 JS 内部\n      GB18030 中文\n    UTF-8 细节\n      变长 1-4 字节\n      兼容 ASCII\n      自同步特性\n    编码工具\n      file 检测\n      iconv 转换\n      chardet Python\n    正则影响\n      u 标志处理码点\n      BOM 干扰行首\n      编码不一致乱码\n    换行符\n      \"LF / CRLF / CR\"\n      \"\\\\r?\\\\n 兼容匹配\"\n      dos2unix 转换</pre><ul>\n<li><strong>UTF-8</strong> 是互联网主流编码，变长设计（1-4 字节）兼容 ASCII，是文本处理的首选编码。</li>\n<li>处理外部文本前应先检测编码、转换为 UTF-8、去除 BOM，再进行正则匹配。</li>\n<li>JavaScript 的 <code>u</code> 标志确保正则按 Unicode 码点（而非 UTF-16 码元）处理字符。</li>\n<li>BOM 标记和不同平台的换行符约定（LF/CRLF/CR）是正则匹配中常见的编码陷阱。</li>\n<li>使用 <code>\\r?\\n</code> 兼容匹配不同平台的换行符，使用 <code>iconv</code>/<code>dos2unix</code> 进行编码和换行符转换。</li>\n</ul>\n","headings":[{"level":1,"text":"文本编码","id":"文本编码"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"字符编码基础","id":"字符编码基础"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"UTF-8 编码详解","id":"utf-8-编码详解"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"编码检测与转换","id":"编码检测与转换"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"编码与正则匹配","id":"编码与正则匹配"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"BOM 与换行符","id":"bom-与换行符"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"jq 与结构化数据","url":"/l-doc-books/h/languages/regex-text-processing/text-processing-tools/jq-and-structured-data"},"next":{"title":"验证模式","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/validation-patterns"}}