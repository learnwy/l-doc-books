#79B8FF\">\\s</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">(?&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">size</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> result</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> apachePattern.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(apacheLog);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result.groups.ip;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result.groups.status;</span></span></code></pre></div><h3 id=\"速查表\">速查表</h3><table>\n<thead>\n<tr>\n<th>日志类型</th>\n<th>格式特征</th>\n<th>主要字段</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Apache CLF</td>\n<td>空格分隔，方括号时间</td>\n<td>IP、时间、请求、状态</td>\n</tr>\n<tr>\n<td>Nginx</td>\n<td>类似 Apache，可自定义</td>\n<td>IP、时间、请求、上游</td>\n</tr>\n<tr>\n<td>JSON 日志</td>\n<td>单行 JSON 对象</td>\n<td>任意键值对</td>\n</tr>\n<tr>\n<td>Syslog</td>\n<td>标准系统日志格式</td>\n<td>时间、主机、服务、消息</td>\n</tr>\n<tr>\n<td>应用日志</td>\n<td>自定义格式</td>\n<td>时间、级别、模块、消息</td>\n</tr>\n</tbody></table>\n<h3 id=\"图示\">图示</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    LOG[&quot;日志类型&quot;] --&gt; ACCESS[&quot;访问日志&lt;br/&gt;Apache/Nginx&quot;]&#10;    LOG --&gt; APP[&quot;应用日志&lt;br/&gt;自定义格式&quot;]&#10;    LOG --&gt; SYS[&quot;系统日志&lt;br/&gt;Syslog&quot;]&#10;    LOG --&gt; JSON[&quot;JSON 日志&lt;br/&gt;结构化&quot;]&#10;    ACCESS --&gt; A1[&quot;IP 时间 请求 状态&quot;]&#10;    APP --&gt; A2[&quot;时间 级别 消息&quot;]&#10;    SYS --&gt; A3[&quot;时间 主机 服务 消息&quot;]&#10;    JSON --&gt; A4[&quot;键值对直接解析&quot;]\">graph TD\n    LOG[\"日志类型\"] --&gt; ACCESS[\"访问日志&lt;br/&gt;Apache/Nginx\"]\n    LOG --&gt; APP[\"应用日志&lt;br/&gt;自定义格式\"]\n    LOG --&gt; SYS[\"系统日志&lt;br/&gt;Syslog\"]\n    LOG --&gt; JSON[\"JSON 日志&lt;br/&gt;结构化\"]\n    ACCESS --&gt; A1[\"IP 时间 请求 状态\"]\n    APP --&gt; A2[\"时间 级别 消息\"]\n    SYS --&gt; A3[\"时间 主机 服务 消息\"]\n    JSON --&gt; A4[\"键值对直接解析\"]</pre><hr>\n<h2 id=\"apache-nginx-访问日志\">Apache/Nginx 访问日志</h2><p>Web 服务器访问日志是最常见的日志格式，解析后可用于流量分析、错误排查和安全审计。</p>\n<h3 id=\"代码示例\">代码示例</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const combinedLog =&#10;  &#39;10.0.0.1 - - [01/Apr/2026:14:30:25 +0800] &quot;POST /api/login HTTP/2.0&quot; 401 256 &quot;https://example.com/&quot; &quot;Mozilla/5.0&quot;&#39;;&#10;const combinedPattern =&#10;  /^(?&lt;ip&gt;[\\d.]+)\\s+\\S+\\s+(?&lt;user&gt;\\S+)\\s+\\[(?&lt;time&gt;[^\\]]+)\\]\\s+&quot;(?&lt;method&gt;\\w+)\\s+(?&lt;url&gt;\\S+)\\s+[^&quot;]+&quot;\\s+(?&lt;status&gt;\\d+)\\s+(?&lt;bytes&gt;\\d+)\\s+&quot;(?&lt;referer&gt;[^&quot;]*)&quot;\\s+&quot;(?&lt;ua&gt;[^&quot;]*)&quot;/;&#10;&#10;const { groups } = combinedPattern.exec(combinedLog);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> combinedLog</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  '10.0.0.1 - - [01/Apr/2026:14:30:25 +0800] \"POST /api/login HTTP/2.0\" 401 256 \"https://example.com/\" \"Mozilla/5.0\"'</span><span 