pan style=\"color:#24292E;--shiki-dark:#E1E4E8\">file2</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\S</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">))</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">gm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"rg -U &#39;^\\d{4}.*ERROR[\\s\\S]*?(?=^\\d{4}|\\z)&#39; --pcre2 app.log&#10;&#10;awk &#39;/^[0-9]{4}-[0-9]{2}-[0-9]{2}.*ERROR/{found=1} found{print} /^[0-9]{4}-[0-9]{2}-[0-9]{2}/&amp;&amp;!/ERROR/{found=0}&#39; app.log\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rg</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -U</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '^\\d{4}.*ERROR[\\s\\S]*?(?=^\\d{4}|\\z)'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --pcre2</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">awk</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '/^[0-9]{4}-[0-9]{2}-[0-9]{2}.*ERROR/{found=1} found{print} /^[0-9]{4}-[0-9]{2}-[0-9]{2}/&#x26;&#x26;!/ERROR/{found=0}'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span></span></code></pre></div><h3 id=\"速查表\">速查表</h3><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>方法</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>时间戳分界</td>\n<td>新时间戳开始新记录</td>\n<td>大多数应用日志</td>\n</tr>\n<tr>\n<td>缩进检测</td>\n<td>续行以空白开头</td>\n<td>堆栈跟踪</td>\n</tr>\n<tr>\n<td>固定行数</td>\n<td>取错误后 N 行</td>\n<td>已知堆栈深度</td>\n</tr>\n<tr>\n<td>空行分界</td>\n<td>空行分隔不同记录</td>\n<td>某些日志格式</td>\n</tr>\n</tbody></table>\n<ul>\n<li><strong>提示：</strong> 多行日志解析中，使用 <code>s</code>（dotAll）标志让 <code>.</code> 匹配换行符，配合惰性量词 <code>.*?</code> 和下一条日志的时间戳作为终止条件。在 ripgrep 中使用 <code>-U</code> 参数启用多行模式。</li>\n</ul>\n<hr>\n<h2 id=\"日志分析管道\">日志分析管道</h2><p>将正则工具与管道组合，构建实时日志分析流水线。</p>\n<h3 id=\"代码示例\">代码示例</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"tail -f app.log | grep --line-buffered &#39;\\[ERROR\\]&#39; | awk &#39;{print strftime(&quot;%H:%M:%S&quot;), $0}&#39;&#10;&#10;rg -o &#39;(?&lt;=status=)\\d{3}&#39; access.log | sort | uniq -c | awk &#39;{printf &quot;%s: %s (%.1f%%)\\n&quot;, $2, $1, $1/NR*100}&#39;&#10;&#10;rg &#39;(?&lt;=request_time=)[\\d.]+&#39; -o access.log | awk &#39;{sum+=$1; count++; if($1&gt;max)max=$1} END{printf &quot;avg=%.3f max=%.3f count=%d\\n&quot;, sum/count, max, count}&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tail</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --line-buffered</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '\\[ERROR\\]'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> awk</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '{print strftime(\"%H:%M:%S\"), $0}'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rg</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -o</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '(?&#x3C;=status=)\\d{3}'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> access.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sort</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> uniq</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> awk</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '{printf \"%s: %s (%.1f%%)\\n\", $2, $1, $1/NR*100}'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '(?&#x3C;=request_time=)[\\d.]+'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -o</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> access.log</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> awk</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '{sum+=$1; count++; if($1>max)max=$1} END{printf \"avg=%.3f max=%.3f count=%d\\n\", sum/count, max, count}'</span></span></code></pre></div><h3 id=\"图示\">图示</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    SOURCE[&quot;日志源&quot;] --&gt; TAIL[&quot;tail -f 实时&quot;]&#10;    SOURCE --&gt; CAT[&quot;cat 全量&quot;]&#10;    TAIL --&gt; GREP[&quot;grep 过滤&quot;]&#10;    CAT --&gt; RG[&quot;rg 搜索&quot;]&#10;    GREP --&gt; AWK[&quot;awk 统计&quot;]&#10;    RG --&gt; AWK&#10;    AWK --&gt; SORT[&quot;sort 排序&quot;]&#10;    SORT --&gt; OUTPUT[&quot;输出报告&quot;]\">graph LR\n    SOURCE[\"日志源\"] --&gt; TAIL[\"tail -f 实时\"]\n    SOURCE --&gt; CAT[\"cat 全量\"]\n    TAIL --&gt; GREP[\"grep 过滤\"]\n    CAT --&gt; RG[\"rg 搜索\"]\n    GREP --&gt; AWK[\"awk 统计\"]\n    RG --&gt; AWK\n    AWK --&gt; SORT[\"sort 排序\"]\n    SORT --&gt; OUTPUT[\"输出报告\"]</pre><h3 id=\"速查表\">速查表</h3><table>\n<thead>\n<tr>\n<th>分析场景</th>\n<th>管道命令</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>错误率统计</td>\n<td><code>rg -c ERROR log | ...</code></td>\n</tr>\n<tr>\n<td>QPS 计算</td>\n<td><code>awk 按秒分组计数</code></td>\n</tr>\n<tr>\n<td>响应时间分布</td>\n<td><code>rg -o 提取时间 | awk 统计</code></td>\n</tr>\n<tr>\n<td>实时错误告警</td>\n<td><code>tail -f | grep | 通知脚本</code></td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((日志解析))&#10;    日志格式&#10;      Apache/Nginx CLF&#10;      JSON 结构化&#10;      应用自定义&#10;      Syslog 系统&#10;    解析技术&#10;      命名分组提取&#10;      多行模式匹配&#10;      堆栈跟踪处理&#10;    分析工具&#10;      rg 高速搜索&#10;      awk 字段统计&#10;      管道组合&#10;    常见任务&#10;      Top IP/URL&#10;      错误率统计&#10;      响应时间分析&#10;      实时监控\">mindmap\n  root((日志解析))\n    日志格式\n      Apache/Nginx CLF\n      JSON 结构化\n      应用自定义\n      Syslog 系统\n    解析技术\n      命名分组提取\n      多行模式匹配\n      堆栈跟踪处理\n    分析工具\n      rg 高速搜索\n      awk 字段统计\n      管道组合\n    常见任务\n      Top IP/URL\n      错误率统计\n      响应时间分析\n      实时监控</pre><ul>\n<li><strong>访问日志</strong>（Apache/Nginx）使用命名捕获组可以一次性提取 IP、时间、URL、状态码等全部字段。</li>\n<li><strong>应用日志</strong>格式多样，核心是识别时间戳、级别、模块和消息四个基本要素。</li>\n<li><strong>多行日志</strong>（堆栈跟踪）需要特殊处理，以时间戳或缩进作为记录分界。</li>\n<li>将 rg、awk、sort、uniq 通过管道组合，可以构建强大的日志分析流水线。</li>\n<li>实时日志监控使用 <code>tail -f | grep --line-buffered</code> 管道，错误告警可以接入通知脚本。</li>\n</ul>\n","headings":[{"level":1,"text":"日志解析","id":"日志解析"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"日志格式概述","id":"日志格式概述"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"Apache/Nginx 访问日志","id":"apache-nginx-访问日志"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"应用日志解析","id":"应用日志解析"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"多行日志与堆栈跟踪","id":"多行日志与堆栈跟踪"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"日志分析管道","id":"日志分析管道"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"图示","id":"图示"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"提取与转换","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/extraction-and-transformation"},"next":{"title":"正则重构","url":"/l-doc-books/h/languages/regex-text-processing/practical-patterns/refactoring-with-regex"}}