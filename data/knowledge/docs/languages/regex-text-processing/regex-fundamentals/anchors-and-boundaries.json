lass=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> camelCase</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">\\B</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[A-Z]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'backgroundColor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">match</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(camelCase);</span></span></code></pre></div><h3 id=\"速查表\">速查表</h3><table>\n<thead>\n<tr>\n<th>断言</th>\n<th>应用场景</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>\\b</code></td>\n<td>全词匹配</td>\n<td><code>/\\berror\\b/</code></td>\n</tr>\n<tr>\n<td><code>\\b</code></td>\n<td>词首匹配</td>\n<td><code>/\\bpre/</code></td>\n</tr>\n<tr>\n<td><code>\\b</code></td>\n<td>词尾匹配</td>\n<td><code>/ing\\b/</code></td>\n</tr>\n<tr>\n<td><code>\\B</code></td>\n<td>词中匹配</td>\n<td><code>/\\Bcat\\B/</code></td>\n</tr>\n<tr>\n<td><code>\\B</code></td>\n<td>驼峰拆分</td>\n<td><code>/\\B[A-Z]/g</code></td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"function camelToKebab(str) {&#10;  return str.replace(/\\B([A-Z])/g, &#39;-$1&#39;).toLowerCase();&#10;}&#10;camelToKebab(&#39;backgroundColor&#39;);&#10;camelToKebab(&#39;XMLHttpRequest&#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> camelToKebab</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> str.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">\\B</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[A-Z]</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'-$1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">camelToKebab</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'backgroundColor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">camelToKebab</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'XMLHttpRequest'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><ul>\n<li><strong>提示：</strong> <code>\\b</code> 基于 <code>\\w</code> 的定义判断边界，而 <code>\\w</code> 仅包含 <code>[a-zA-Z0-9_]</code>。这意味着中文字符旁边不会产生单词边界。处理中文文本时需要使用 Unicode 属性（<code>\\p{L}</code>）配合前瞻/后顾断言。</li>\n</ul>\n<hr>\n<h2 id=\"多行与全局模式的交互\">多行与全局模式的交互</h2><p>锚点的行为受多个标志共同影响，理解它们的交互关系至关重要。</p>\n<h3 id=\"代码示例\">代码示例</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"const text = &#39;apple\\nbanana\\ncherry&#39;;&#10;&#10;text.match(/^[a-z]+$/);&#10;text.match(/^[a-z]+$/m);&#10;text.match(/^[a-z]+$/gm);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> text</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'apple</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">banana</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">cherry'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">match</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[a-z]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+$</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">match</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[a-z]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+$</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">m</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">text.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">match</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[a-z]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+$</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">gm</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><p>标志组合对锚点行为的影响：</p>\n<h3 id=\"速查表\">速查表</h3><table>\n<thead>\n<tr>\n<th>标志组合</th>\n<th><code>^</code> 行为</th>\n<th><code>$</code> 行为</th>\n<th>典型用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>无标志</td>\n<td>字符串开头</td>\n<td>字符串结尾</td>\n<td>单行验证</td>\n</tr>\n<tr>\n<td><code>m</code></td>\n<td>每行开头</td>\n<td>每行结尾</td>\n<td>多行搜索</td>\n</tr>\n<tr>\n<td><code>g</code></td>\n<td>字符串开头</td>\n<td>字符串结尾</td>\n<td>全局匹配</td>\n</tr>\n<tr>\n<td><code>gm</code></td>\n<td>每行开头</td>\n<td>每行结尾</td>\n<td>多行全局搜索</td>\n</tr>\n</tbody></table>\n<h3 id=\"图示\">图示</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    FLAGS[&quot;标志组合&quot;] --&gt; DEFAULT[&quot;无标志&quot;]&#10;    FLAGS --&gt; M[&quot;m 多行&quot;]&#10;    FLAGS --&gt; G[&quot;g 全局&quot;]&#10;    FLAGS --&gt; GM[&quot;gm 多行全局&quot;]&#10;    DEFAULT --&gt; D1[&quot;^ 字符串开头&lt;br/&gt;$ 字符串结尾&lt;br/&gt;仅首次匹配&quot;]&#10;    M --&gt; M1[&quot;^ 每行开头&lt;br/&gt;$ 每行结尾&lt;br/&gt;仅首次匹配&quot;]&#10;    G --&gt; G1[&quot;^ 字符串开头&lt;br/&gt;$ 字符串结尾&lt;br/&gt;所有匹配&quot;]&#10;    GM --&gt; GM1[&quot;^ 每行开头&lt;br/&gt;$ 每行结尾&lt;br/&gt;所有匹配&quot;]\">graph TD\n    FLAGS[\"标志组合\"] --&gt; DEFAULT[\"无标志\"]\n    FLAGS --&gt; M[\"m 多行\"]\n    FLAGS --&gt; G[\"g 全局\"]\n    FLAGS --&gt; GM[\"gm 多行全局\"]\n    DEFAULT --&gt; D1[\"^ 字符串开头&lt;br/&gt;$ 字符串结尾&lt;br/&gt;仅首次匹配\"]\n    M --&gt; M1[\"^ 每行开头&lt;br/&gt;$ 每行结尾&lt;br/&gt;仅首次匹配\"]\n    G --&gt; G1[\"^ 字符串开头&lt;br/&gt;$ 字符串结尾&lt;br/&gt;所有匹配\"]\n    GM --&gt; GM1[\"^ 每行开头&lt;br/&gt;$ 每行结尾&lt;br/&gt;所有匹配\"]</pre><hr>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((锚点与边界))&#10;    零宽断言&#10;      不匹配字符&#10;      匹配位置&#10;      &quot;^ $ \\\\b \\\\B&quot;&#10;    行锚点&#10;      &quot;^ 行首 $ 行尾&quot;&#10;      多行模式 m 改变行为&#10;      验证输入必须双锚定&#10;    单词边界&#10;      &quot;\\\\b 词界&quot;&#10;      &quot;\\\\w 与 \\\\W 之间&quot;&#10;      全词匹配利器&#10;    非单词边界&#10;      &quot;\\\\B 同类字符间&quot;&#10;      驼峰拆分&#10;      词中定位&#10;    标志交互&#10;      m 影响锚点&#10;      g 影响匹配次数&#10;      gm 组合使用\">mindmap\n  root((锚点与边界))\n    零宽断言\n      不匹配字符\n      匹配位置\n      \"^ $ \\\\b \\\\B\"\n    行锚点\n      \"^ 行首 $ 行尾\"\n      多行模式 m 改变行为\n      验证输入必须双锚定\n    单词边界\n      \"\\\\b 词界\"\n      \"\\\\w 与 \\\\W 之间\"\n      全词匹配利器\n    非单词边界\n      \"\\\\B 同类字符间\"\n      驼峰拆分\n      词中定位\n    标志交互\n      m 影响锚点\n      g 影响匹配次数\n      gm 组合使用</pre><ul>\n<li><strong>锚点</strong>匹配的是位置而非字符，<code>^</code> 和 <code>$</code> 分别匹配行首和行尾。</li>\n<li>多行模式 <code>m</code> 使 <code>^</code> 和 <code>$</code> 匹配每一行的开头和结尾，而非整个字符串。</li>\n<li><strong><code>\\b</code></strong> 匹配单词边界，是实现全词匹配的关键工具。</li>\n<li><strong><code>\\B</code></strong> 匹配非单词边界，常用于驼峰命名拆分等词中定位场景。</li>\n<li>输入验证时务必使用 <code>^...$</code> 双锚定，确保匹配的是整个字符串而非子串。</li>\n</ul>\n","headings":[{"level":1,"text":"锚点与边界","id":"锚点与边界"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"零宽断言的概念","id":"零宽断言的概念"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"行首与行尾锚点","id":"行首与行尾锚点"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"单词边界","id":"单词边界"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"非单词边界与高级定位","id":"非单词边界与高级定位"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"多行与全局模式的交互","id":"多行与全局模式的交互"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"量词与贪婪模式","url":"/l-doc-books/h/languages/regex-text-processing/regex-fundamentals/quantifiers-and-greediness"},"next":{"title":"分组与反向引用","url":"/l-doc-books/h/languages/regex-text-processing/advanced-patterns/groups-and-backreferences"}}