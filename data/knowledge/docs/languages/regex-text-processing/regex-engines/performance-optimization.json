#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> good</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[a-e]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bad2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">cat</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">car</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">cab</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> good2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">ca</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">[trb]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span></code></pre></div><ul>\n<li><strong>提示：</strong> 单字符交替（如 <code>a|b|c</code>）应始终改写为字符类 <code>[abc]</code>。多数引擎对字符类有专门的优化路径（如位图查找），比交替操作快一个数量级。</li>\n</ul>\n<hr>\n<h2 id=\"预编译与缓存\">预编译与缓存</h2><p>在循环中重复使用正则表达式时，预编译和缓存可以避免重复解析和编译的开销。</p>\n<h3 id=\"代码示例\">代码示例</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"function findAllBad(texts) {&#10;  return texts.filter((t) =&gt; /^\\d{4}-\\d{2}-\\d{2}$/.test(t));&#10;}&#10;&#10;const DATE_REGEX = /^\\d{4}-\\d{2}-\\d{2}$/;&#10;function findAllGood(texts) {&#10;  return texts.filter((t) =&gt; DATE_REGEX.test(t));&#10;}&#10;&#10;const regexCache = new Map();&#10;function getCachedRegex(pattern, flags) {&#10;  const key = `${pattern}::${flags}`;&#10;  if (!regexCache.has(key)) {&#10;    regexCache.set(key, new RegExp(pattern, flags));&#10;  }&#10;  return regexCache.get(key);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> findAllBad</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">texts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> texts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{4}</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2}</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2}$</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> DATE_REGEX</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{4}</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2}</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{2}$</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> findAllGood</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">texts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> texts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> DATE_REGEX</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> regexCache</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getCachedRegex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pattern</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">flags</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pattern</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}::${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">flags</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">regexCache.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key)) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    regexCache.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> RegExp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pattern, flags));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> regexCache.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"速查表\">速查表</h3><table>\n<thead>\n<tr>\n<th>方法</th>\n<th>场景</th>\n<th>性能影响</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>字面量</td>\n<td>静态模式</td>\n<td>引擎自动缓存</td>\n</tr>\n<tr>\n<td>模块级常量</td>\n<td>重复使用的模式</td>\n<td>避免重复编译</td>\n</tr>\n<tr>\n<td>Map 缓存</td>\n<td>动态构建的模式</td>\n<td>按需编译一次</td>\n</tr>\n<tr>\n<td>全局标志注意</td>\n<td><code>/g</code> 有状态</td>\n<td>lastIndex 需要重置</td>\n</tr>\n</tbody></table>\n<h3 id=\"图示\">图示</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    COMPILE[&quot;正则编译&quot;] --&gt; LITERAL[&quot;字面量 /abc/&quot;]&#10;    COMPILE --&gt; CONSTRUCTOR[&quot;构造函数 new RegExp()&quot;]&#10;    LITERAL --&gt; CACHE1[&quot;引擎自动缓存&quot;]&#10;    CONSTRUCTOR --&gt; NOCACHE[&quot;每次创建新对象&quot;]&#10;    NOCACHE --&gt; MANUAL[&quot;手动缓存到 Map&quot;]\">graph TD\n    COMPILE[\"正则编译\"] --&gt; LITERAL[\"字面量 /abc/\"]\n    COMPILE --&gt; CONSTRUCTOR[\"构造函数 new RegExp()\"]\n    LITERAL --&gt; CACHE1[\"引擎自动缓存\"]\n    CONSTRUCTOR --&gt; NOCACHE[\"每次创建新对象\"]\n    NOCACHE --&gt; MANUAL[\"手动缓存到 Map\"]</pre><hr>\n<h2 id=\"小结\">小结</h2><table>\n<thead>\n<tr>\n<th>主题</th>\n<th>要点</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>锚点优化</td>\n<td><code>^</code> <code>$</code> <code>\\b</code> 限定位置</td>\n<td>减少起始位置尝试，最简单有效</td>\n</tr>\n<tr>\n<td>字符类优化</td>\n<td><code>[^X]*</code> 替代 <code>.*</code></td>\n<td>精确匹配更高效，排除定界符</td>\n</tr>\n<tr>\n<td>交替优化</td>\n<td>高频分支靠前</td>\n<td>提取公共前缀，字符类替代单字符交替</td>\n</tr>\n<tr>\n<td>预编译缓存</td>\n<td>模块级常量</td>\n<td>Map 缓存动态模式，避免循环内创建</td>\n</tr>\n<tr>\n<td>整体原则</td>\n<td>减少回溯</td>\n<td>尽早失败，精确描述意图</td>\n</tr>\n</tbody></table>\n<ul>\n<li><strong>锚点优化</strong>是最简单有效的手段，<code>^</code>、<code>$</code>、<code>\\b</code> 限制匹配位置，避免逐位置尝试。</li>\n<li><strong>字符类优化</strong>用排除字符类 <code>[^X]*</code> 替代通配符 <code>.*</code>，消除不必要的回溯。</li>\n<li><strong>交替分支</strong>应按匹配概率排序，提取公共前缀，单字符交替改用字符类。</li>\n<li><strong>预编译</strong>正则对象并缓存，避免在循环中重复创建。</li>\n<li>优化的核心思想是让引擎尽早确定结果：尽早匹配成功或尽早判定失败。</li>\n</ul>\n","headings":[{"level":1,"text":"性能优化","id":"性能优化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"正则性能的基本原则","id":"正则性能的基本原则"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"锚点优化","id":"锚点优化"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"图示","id":"图示"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"字符类优化","id":"字符类优化"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"交替分支优化","id":"交替分支优化"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":2,"text":"预编译与缓存","id":"预编译与缓存"},{"level":3,"text":"代码示例","id":"代码示例"},{"level":3,"text":"速查表","id":"速查表"},{"level":3,"text":"图示","id":"图示"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"回溯与灾难性回溯","url":"/l-doc-books/h/languages/regex-text-processing/regex-engines/backtracking-and-catastrophic"},"next":{"title":"引擎差异","url":"/l-doc-books/h/languages/regex-text-processing/regex-engines/engine-differences"}}