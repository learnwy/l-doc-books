ki-dark:#B392F0\">forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(value));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    template</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">typename</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> U</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> emplace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">U</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> value</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        data_.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push_back</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">forward</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">U</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(value));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">private:</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::vector</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">T</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data_;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>std::forward 是完美转发的核心工具，用于在模板中保持参数的值类别。当模板参数 T&amp;&amp; 作为万能引用（forwarding reference）时，T 可能被推导为左值引用或非引用类型。std::forward(arg) 在 T 为左值引用时返回左值引用，否则返回右值引用。</p>\n<h2 id=\"完美转发与工厂模式\">完美转发与工厂模式</h2><p>完美转发（Perfect Forwarding）允许模板函数将参数以完全相同的值类别转发给另一个函数，既不引入多余的拷贝，也不丢失右值性。这在工厂函数、包装器和 emplace 系列接口中至关重要。</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"#include &lt;memory&gt;&#10;#include &lt;tuple&gt;&#10;#include &lt;utility&gt;&#10;&#10;template &lt;typename T, typename... Args&gt;&#10;auto makeUnique(Args&amp;&amp;... args) -&gt; std::unique_ptr&lt;T&gt; {&#10;    return std::unique_ptr&lt;T&gt;(new T(std::forward&lt;Args&gt;(args)...));&#10;}&#10;&#10;template &lt;typename Func, typename... Args&gt;&#10;auto invoke(Func&amp;&amp; func, Args&amp;&amp;... args)&#10;    -&gt; decltype(std::forward&lt;Func&gt;(func)(std::forward&lt;Args&gt;(args)...)) {&#10;    return std::forward&lt;Func&gt;(func)(std::forward&lt;Args&gt;(args)...);&#10;}&#10;&#10;struct Connection {&#10;    std::string host;&#10;    int port;&#10;    bool ssl;&#10;&#10;    Connection(std::string h, int p, bool s)&#10;        : host(std::move(h)), port(p), ssl(s) {}&#10;};&#10;&#10;template &lt;typename T, typename Tuple, std::size_t... Is&gt;&#10;auto constructFromTupleImpl(Tuple&amp;&amp; t, std::index_sequence&lt;Is...&gt;)&#10;    -&gt; std::unique_ptr&lt;T&gt; {&#10;    return std::make_unique&lt;T&gt;(std::get&lt;Is&gt;(std::forward&lt;Tuple&gt;(t))...);&#10;}&#10;&#10;template &lt;typename T, typename Tuple&gt;&#10;auto constructFromTuple(Tuple&amp;&amp; t) -&gt; std::unique_ptr&lt;T&gt; {&#10;    constexpr auto size = std::tuple_size_v&lt;std::remove_reference_t&lt;Tuple&gt;&gt;;&#10;    return constructFromTupleImpl&lt;T&gt;(&#10;        std::forward&lt;Tuple&gt;(t), std::make_index_sequence&lt;size&gt;{}&#10;    );&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;memory></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;tuple></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;utility></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">template</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">typename</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">typename</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">... </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Args</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">auto</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> makeUnique</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Args</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;&#x26;