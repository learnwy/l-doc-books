hub-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;new></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Widget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value_;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">public:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    explicit</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Widget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) : </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">value_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v) {}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    ~Widget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value_; }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> demonstrate_placement_new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    alignas</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Widget) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">char</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> buffer[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Widget)];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Widget</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (buffer) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Widget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> val </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> w-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    w-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">~Widget</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"内存对齐与缓存行\">内存对齐与缓存行</h2><p>CPU 按缓存行（Cache Line，通常 64 字节）从内存加载数据。数据的内存对齐和布局直接影响缓存命中率，进而影响程序性能。C++ 提供了 alignas 关键字和 std::aligned_storage 来控制内存对齐：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"#include &lt;cstddef&gt;&#10;#include &lt;new&gt;&#10;&#10;struct alignas(64) CacheAligned {&#10;    int data[16];&#10;};&#10;&#10;struct Compact {&#10;    char a;      // 1 字节&#10;    int b;       // 4 字节（偏移 4，因对齐填充 3 字节）&#10;    char c;      // 1 字节（偏移 8）&#10;};               // sizeof = 12（尾部填充至 4 的倍数）&#10;&#10;struct Optimized {&#10;    int b;       // 4 字节&#10;    char a;      // 1 字节&#10;    char c;      // 1 字节&#10;};               // sizeof = 8（重新排列减少填充）&#10;&#10;void demonstrate_alignment() {&#10;    static_assert(sizeof(Compact) &gt; sizeof(Optimized));&#10;    static_assert(alignof(CacheAligned) == 64);&#10;&#10;    auto* p = new (std::align_val_t{64}) CacheAligned{};&#10;    ::operator delete(p, std::align_val_t{64});&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;cstddef></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;new></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> alignas(64)</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CacheAligned</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">16</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Compact</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    char</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 1 字节</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">       // 4 字节（偏移 4，因对齐填充 3 字节）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    char</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 1 字节（偏移 8）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">               // sizeof = 12（尾部填充至 4 的倍数）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Optimized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">       // 4 字节</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    char</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 1 字节</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    char</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      // 1 字节</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">               // sizeof = 8（重新排列减少填充）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> demonstrate_alignment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static_assert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Compact) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> sizeof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Optimized));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static_assert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">alignof</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(CacheAligned) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    auto*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">align_val_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}) CacheAligned{};</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ::operator </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">delete</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">align_val_t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>对齐策略</th>\n<th>内存消耗</th>\n<th>缓存效率</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>默认对齐</td>\n<td>最低</td>\n<td>一般</td>\n<td>通用数据结构</td>\n</tr>\n<tr>\n<td>缓存行对齐（64B）</td>\n<td>可能浪费</td>\n<td>极好</td>\n<td>多线程共享数据（避免 false sharing）</td>\n</tr>\n<tr>\n<td>紧凑排列</td>\n<td>最优</td>\n<td>好</td>\n<td>大量小对象（如粒子系统）</td>\n</tr>\n<tr>\n<td>SIMD 对齐（16/32B）</td>\n<td>略多</td>\n<td>极好</td>\n<td>向量化数值计算</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>栈内存由编译器自动管理，速度极快但大小有限（通常 1-8MB）</li>\n<li>堆内存通过 new/delete 手动管理，支持任意大小但有分配开销和碎片化风险</li>\n<li>内存池（Pool Allocator）将堆分配降至 O(1)，适合固定大小对象的高频分配场景</li>\n<li>placement new 在预分配内存上构造对象，需要手动调用析构函数</li>\n<li>成员变量按大小降序排列可减少结构体的填充字节，提高内存利用率</li>\n<li>缓存行对齐（alignas(64)）可避免多线程场景的 false sharing 问题</li>\n<li>现代 C++ 推荐使用 std::make_unique / std::make_shared 替代裸 new/delete</li>\n<li>栈分配是缓存友好的连续内存访问，堆分配分散在地址空间中缓存命中率低</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li>同 hub：<a href=\"raii-smart-pointers\">RAII 与智能指针</a>——本篇讲堆的手动 new/delete，下一步看 RAII 如何把释放绑定到作用域结束，消除手动管理。</li>\n<li>同 hub：<a href=\"memory-pitfalls\">内存陷阱与调试</a>——本篇 demonstrate_stack_overflow 等隐患，这里给出系统的检测与防御手段。</li>\n<li>跨 hub：<a href=\"../../c-language-programming/c-fundamentals/memory-model-and-layout\">C 语言·内存模型与布局</a>——栈/堆/静态区的进程地址空间划分继承自 C，对照 C 视角理解底层布局。</li>\n<li>跨 hub：<a href=\"../../assembly-language/abi/stack-frames\">汇编·栈帧</a>——从汇编层面看栈帧如何在调用时压入返回地址、参数和局部变量，对应本篇「栈帧与函数调用」。</li>\n</ul>\n","headings":[{"level":1,"text":"栈与堆内存","id":"栈与堆内存"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"栈帧与函数调用","id":"栈帧与函数调用"},{"level":2,"text":"堆分配策略","id":"堆分配策略"},{"level":2,"text":"placement new 与自定义内存","id":"placement-new-与自定义内存"},{"level":2,"text":"内存对齐与缓存行","id":"内存对齐与缓存行"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"面向对象基础","url":"/l-doc-books/h/languages/cpp-fundamentals/cpp-core-language/oop-fundamentals"},"next":{"title":"RAII 与智能指针","url":"/l-doc-books/h/languages/cpp-fundamentals/memory-management/raii-smart-pointers"}}