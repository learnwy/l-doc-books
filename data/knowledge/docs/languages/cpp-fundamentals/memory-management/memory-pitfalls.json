pan><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">runtime_error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"oops\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><p>Use-After-Free 是最危险的内存错误之一。攻击者可以通过控制被释放内存区域的重新分配来实现任意代码执行。在现代 C++ 中，使用 unique_ptr 和 shared_ptr 可以从根本上消除手动管理导致的 UAF 风险。</p>\n<table>\n<thead>\n<tr>\n<th>错误模式</th>\n<th>根因</th>\n<th>症状</th>\n<th>现代 C++ 解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>返回局部变量指针</td>\n<td>栈帧销毁</td>\n<td>读到垃圾值</td>\n<td>返回值（RVO/NRVO）</td>\n</tr>\n<tr>\n<td>迭代器失效</td>\n<td>容器扩容</td>\n<td>崩溃或数据错误</td>\n<td>range-based for、预留空间</td>\n</tr>\n<tr>\n<td>虚函数中调用删除</td>\n<td>析构顺序</td>\n<td>崩溃</td>\n<td>shared_from_this</td>\n</tr>\n<tr>\n<td>多线程共享裸指针</td>\n<td>竞态条件</td>\n<td>非确定性崩溃</td>\n<td>shared_ptr + mutex</td>\n</tr>\n</tbody></table>\n<h2 id=\"addresssanitizer-实战\">AddressSanitizer 实战</h2><p>AddressSanitizer（ASan）是 Clang/GCC 内置的内存错误检测工具，通过编译时插桩在运行时检测越界访问、Use-After-Free、双重释放等问题。ASan 的运行时开销约为 2x，远低于 Valgrind 的 20-50x，适合在 CI/CD 中常态化使用。</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"#include &lt;cstdlib&gt;&#10;#include &lt;cstring&gt;&#10;&#10;void demonstrateASanDetection() {&#10;    auto* buffer = new char[32];&#10;    std::memset(buffer, 0, 32);&#10;&#10;    buffer[32] = &#39;x&#39;;&#10;&#10;    delete[] buffer;&#10;&#10;    buffer[0] = &#39;y&#39;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;cstdlib></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;cstring></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> demonstrateASanDetection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    auto*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> buffer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> char</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">memset</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(buffer, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    buffer[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">32</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'x'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    delete[]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> buffer;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    buffer[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'y'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>编译启用 ASan：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"clang++ -fsanitize=address -fno-omit-frame-pointer -g -O1 test.cpp -o test\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">clang++</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -fsanitize=address</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -fno-omit-frame-pointer</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -g</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -O1</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> test.cpp</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -o</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> test</span></span></code></pre></div><p>ASan 会输出详细的错误报告，包括错误类型、发生位置的栈回溯、以及相关内存的分配/释放信息。配合 <code>-fno-omit-frame-pointer</code> 和 <code>-g</code> 可以获得完整的源码级调试信息。</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"struct ASanConfig {&#10;    static constexpr auto kDetectStackUseAfterReturn = true;&#10;    static constexpr auto kDetectLeaks = true;&#10;    static constexpr auto kQuarantine = 256 * 1024 * 1024;&#10;    static constexpr auto kRedzone = 128;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ASanConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> constexpr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> auto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kDetectStackUseAfterReturn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> constexpr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> auto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kDetectLeaks </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> constexpr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> auto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kQuarantine </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 256</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1024</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1024</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> constexpr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> auto</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kRedzone </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 128</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>Sanitizer</th>\n<th>检测能力</th>\n<th>运行时开销</th>\n<th>内存开销</th>\n<th>启用方式</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ASan</td>\n<td>越界、UAF、泄漏</td>\n<td>2x</td>\n<td>3x</td>\n<td>-fsanitize=address</td>\n</tr>\n<tr>\n<td>MSan</td>\n<td>未初始化读取</td>\n<td>3x</td>\n<td>2x</td>\n<td>-fsanitize=memory</td>\n</tr>\n<tr>\n<td>TSan</td>\n<td>数据竞争</td>\n<td>5-15x</td>\n<td>5-10x</td>\n<td>-fsanitize=thread</td>\n</tr>\n<tr>\n<td>UBSan</td>\n<td>未定义行为</td>\n<td>极低</td>\n<td>极低</td>\n<td>-fsanitize=undefined</td>\n</tr>\n</tbody></table>\n<h2 id=\"valgrind-与高级调试\">Valgrind 与高级调试</h2><p>Valgrind 的 Memcheck 工具是最全面的内存错误检测方案，通过动态二进制翻译在不需要重新编译的情况下检测内存问题。Valgrind 能检测到 ASan 无法发现的某些错误模式，如未初始化值的传播。</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"valgrind --tool=memcheck --leak-check=full --show-leak-kinds=all \\&#10;    --track-origins=yes --verbose ./program\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">valgrind</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --tool=memcheck</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --leak-check=full</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --show-leak-kinds=all</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    --track-origins=yes</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --verbose</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ./program</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"struct ValgrindPatterns {&#10;    static void conditionalJumpOnUninitializedValue() {&#10;        int x;&#10;        if (x &gt; 0) {&#10;        }&#10;    }&#10;&#10;    static void indirectLeak() {&#10;        struct Node {&#10;            int value;&#10;            Node* next;&#10;        };&#10;        auto* head = new Node{1, new Node{2, new Node{3, nullptr}}};&#10;        delete head;&#10;    }&#10;&#10;    static void mismatchedAlloc() {&#10;        auto* p = new int[10];&#10;        delete p;&#10;    }&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">struct</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ValgrindPatterns</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> conditionalJumpOnUninitializedValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;-