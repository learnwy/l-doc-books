dark:#E1E4E8\"> largest </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> max_pq.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">top</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 30</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::priority_queue</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::vector</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;int></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::greater</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;int>></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> min_pq;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    min_pq.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">30</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    min_pq.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> smallest </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> min_pq.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">top</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"> // 10</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>适配器</th>\n<th>底层容器</th>\n<th>访问方式</th>\n<th>典型用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>stack</td>\n<td>deque（默认）</td>\n<td>LIFO：top/push/pop</td>\n<td>DFS、括号匹配、表达式求值</td>\n</tr>\n<tr>\n<td>queue</td>\n<td>deque（默认）</td>\n<td>FIFO：front/push/pop</td>\n<td>BFS、任务队列</td>\n</tr>\n<tr>\n<td>priority_queue</td>\n<td>vector（默认）</td>\n<td>堆顶：top/push/pop</td>\n<td>最短路径、Top-K 问题</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>vector 是默认的序列容器选择，连续内存带来优秀的缓存命中率和随机访问性能</li>\n<li>使用 reserve 预分配容量可避免 vector 扩容导致的迭代器失效和性能波动</li>\n<li>deque 适合需要首尾双向高效插入的场景（如滑动窗口、BFS 队列）</li>\n<li>array 是 C 风格数组的安全替代，大小编译期确定，可用于 constexpr 上下文</li>\n<li>list/forward_list 在频繁的中间插入删除场景有理论优势，但缓存不友好限制了实际性能</li>\n<li>stack/queue/priority_queue 是基于序列容器的适配器，封装特定的数据结构语义</li>\n<li>选择容器的经验法则：优先 vector → 需要首部操作用 deque → 需要稳定迭代器用 list</li>\n</ul>\n<h2 id=\"延伸阅读与跨学科链接\">延伸阅读与跨学科链接</h2><ul>\n<li>同 hub：<a href=\"iterators-algorithms\">迭代器与算法</a>——序列容器通过迭代器接入 std::sort 等算法，理解容器-迭代器-算法的三层架构。</li>\n<li>同 hub：<a href=\"../memory-management/stack-heap\">栈与堆内存</a>——vector 的连续堆内存与扩容、array 的栈分配，回看内存布局理解缓存友好性差异。</li>\n<li>跨 hub：<a href=\"../../go-language/data-structures/slices-and-arrays\">Go·切片与数组</a>——Go slice 的底层数组+扩容机制与 vector 高度相似，对比两者的容量增长策略。</li>\n<li>跨 hub：<a href=\"../../rust-language/systems-programming/memory-layout\">Rust·内存布局</a>——Vec 与 std::vector 都是连续内存的动态数组，对照理解数据布局对性能的影响。</li>\n</ul>\n","headings":[{"level":1,"text":"序列容器","id":"序列容器"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"vector 深入","id":"vector-深入"},{"level":2,"text":"deque 与 array","id":"deque-与-array"},{"level":2,"text":"list 与 forward_list","id":"list-与-forward_list"},{"level":2,"text":"容器适配器","id":"容器适配器"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读与跨学科链接","id":"延伸阅读与跨学科链接"}],"prev":{"title":"Concepts 与约束","url":"/l-doc-books/h/languages/cpp-fundamentals/templates-generics/concepts-constraints"},"next":{"title":"关联容器","url":"/l-doc-books/h/languages/cpp-fundamentals/stl-containers/associative-containers"}}