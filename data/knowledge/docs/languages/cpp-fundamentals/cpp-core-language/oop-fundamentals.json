lass=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sum;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"crtp-与编译期多态\">CRTP 与编译期多态</h2><p>Curiously Recurring Template Pattern（CRTP）通过模板继承在编译期实现多态行为，完全消除了虚函数的间接调用开销。基类通过模板参数获取派生类的类型信息，在编译期完成静态分发：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"template&lt;typename Derived&gt;&#10;class ShapeBase {&#10;public:&#10;    double area() const {&#10;        return static_cast&lt;const Derived*&gt;(this)-&gt;area_impl();&#10;    }&#10;&#10;    void draw() const {&#10;        static_cast&lt;const Derived*&gt;(this)-&gt;draw_impl();&#10;    }&#10;};&#10;&#10;class CRTPCircle : public ShapeBase&lt;CRTPCircle&gt; {&#10;    double radius_;&#10;public:&#10;    explicit CRTPCircle(double r) : radius_(r) {}&#10;    double area_impl() const { return 3.14159 * radius_ * radius_; }&#10;    void draw_impl() const { /* 绘制圆形 */ }&#10;};&#10;&#10;class CRTPRect : public ShapeBase&lt;CRTPRect&gt; {&#10;    double w_, h_;&#10;public:&#10;    CRTPRect(double w, double h) : w_(w), h_(h) {}&#10;    double area_impl() const { return w_ * h_; }&#10;    void draw_impl() const { /* 绘制矩形 */ }&#10;};&#10;&#10;template&lt;typename Shape&gt;&#10;double compute_area(const ShapeBase&lt;Shape&gt;&amp; shape) {&#10;    return shape.area();&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">template</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">typename</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Derived</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"lin