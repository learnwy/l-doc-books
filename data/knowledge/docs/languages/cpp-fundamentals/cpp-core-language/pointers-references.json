tyle=\"color:#24292E;--shiki-dark:#E1E4E8\"> a1 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> arr;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">             // int*（退化）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    auto&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> a2 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> arr;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">            // int(&#x26;)[5]（引用保留数组类型）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    decltype</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(arr) a3 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // int[5]（decltype 保留数组类型）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"引用的绑定规则\">引用的绑定规则</h2><p>C++ 引用的绑定规则决定了何种引用可以绑定到何种表达式。这些规则是理解函数重载解析和模板参数推导的关键：</p>\n<div class=\"code-block-wrapper\" data-lang=\"cpp\" data-code=\"#include &lt;string&gt;&#10;#include &lt;utility&gt;&#10;&#10;void bind_rules() {&#10;    int x = 42;&#10;    int&amp; lr = x;             // 左值引用绑定到左值&#10;    // int&amp; lr2 = 42;        // 错误：左值引用不能绑定到右值&#10;&#10;    const int&amp; cr = 42;      // const 引用可以绑定到右值（生命周期延长）&#10;    const int&amp; cr2 = x;      // const 引用也可以绑定到左值&#10;&#10;    int&amp;&amp; rr = 42;           // 右值引用绑定到右值&#10;    int&amp;&amp; rr2 = std::move(x); // 右值引用绑定到 xvalue&#10;    // int&amp;&amp; rr3 = x;        // 错误：右值引用不能绑定到左值&#10;}&#10;&#10;void overload_resolution(int&amp; x)        { /* lvalue 重载 */ }&#10;void overload_resolution(const int&amp; x)  { /* const lvalue 重载 */ }&#10;void overload_resolution(int&amp;&amp; x)       { /* rvalue 重载 */ }&#10;&#10;void call_overloads() {&#10;    int a = 1;&#10;    const int b = 2;&#10;&#10;    overload_resolution(a);              // 调用 int&amp;&#10;    overload_resolution(b);              // 调用 const int&amp;&#10;    overload_resolution(42);             // 调用 int&amp;&amp;&#10;    overload_resolution(std::move(a));   // 调用 int&amp;&amp;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;string></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">#include</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;utility></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bind_rules</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 42</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x;</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">             // 左值引用绑定到左值</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;