ot;\\([^&quot;]*\\)&quot;.*/\\1/p&#39; package.json&#10;&#10;sed -n &#39;s/.*error.*code=\\([0-9]*\\).*/\\1/p&#39; error.log&#10;&#10;sed -E &#39;s/^[[:space:]]+//;s/[[:space:]]+$//&#39; file.txt&#10;&#10;sed &#39;G&#39; file.txt            # 每行后加空行&#10;sed &#39;/^$/d;G&#39; file.txt      # 先删空行再加空行（规范化间距）&#10;&#10;sed &#39;=&#39; file.txt | sed &#39;N;s/\\n/\\t/&#39;  # 给每行加行号&#10;&#10;sed -E &#39;/^[[:space:]]*$/{ N; /^\\n[[:space:]]*$/d }&#39; file.txt\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '3i\\这是插入的新行'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.txt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '5a\\这是追加的新行'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.txt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '/^server {/a\\    listen 443 ssl;'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> nginx.conf</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '/^import/a\\import { newModule } from \"./new\";'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.ts</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sed</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '/deprecated/c\\// 此功能已重构'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> code.ts</span></span>\n<span class=\"line\"></spa