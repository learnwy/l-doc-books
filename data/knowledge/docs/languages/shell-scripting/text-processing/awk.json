rk:#9ECBFF\">        size = $5 + 0</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        printf \"%-20s %8s\\n\", name, human_size(size)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> &#x3C;(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ls</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -la</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">awk</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    function parse_json_value(line, key,    re, val) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        re = \"\\\"\" key \"\\\"[[:space:]]*:[[:space:]]*\\\"([^\\\"]*)\\\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        if (match(line, re)) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            val = substr(line, RSTART, RLENGTH)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            gsub(/.*\": *\"/, \"\", val)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            gsub(/\"$/, \"\", val)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            return val</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        return \"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        name = parse_json_value($0, \"name\")</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        version = parse_json_value($0, \"version\")</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        if (name != \"\")</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            printf \"%s@%s\\n\", name, version</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> package.json</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">awk</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    BEGIN {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        srand()</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        lines[NR] = $0</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    END {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        n = NR</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        for (i = n; i > 1; i--) {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            j = int(rand() * i) + 1</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            temp = lines[i]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            lines[i] = lines[j]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            lines[j] = temp</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        for (i = 1; i &#x3C;= n; i++)</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">            print lines[i]</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> input.txt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">awk</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> threshold=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    $3 > threshold {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        printf \"\\033[31m%s\\033[0m\\n\", $0</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    $3 &#x3C;= threshold {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        print</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> data.txt</span></span></code></pre></div><h2 id=\"常见陷阱\">常见陷阱</h2><p>awk 编程中的错误常与字段引用和变量传递有关，下表汇总几类高频问题。</p>\n<table>\n<thead>\n<tr>\n<th>错误写法</th>\n<th>问题</th>\n<th>正确写法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>awk 内引用 Shell 变量 <code>$v</code></td>\n<td>awk 不识别 Shell 变量</td>\n<td><code>awk -v x=&quot;$v&quot; &#39;...x...&#39;</code></td>\n</tr>\n<tr>\n<td><code>print $1+$2</code> 含空字段</td>\n<td>空字段按 0 处理，结果失真</td>\n<td>先判 <code>NF</code> 或非空</td>\n</tr>\n<tr>\n<td>默认分隔符处理 CSV</td>\n<td>连续空白合并，逗号无效</td>\n<td><code>awk -F&#39;,&#39;</code> 显式指定</td>\n</tr>\n<tr>\n<td><code>$0</code> 被赋值后字段重算</td>\n<td>修改整行触发字段重分割</td>\n<td>注意赋值顺序</td>\n</tr>\n<tr>\n<td>用 awk 解析嵌套 JSON</td>\n<td>正则难以覆盖结构</td>\n<td>改用 <code>jq</code></td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>awk 是功能完备的文本处理语言，核心优势在于字段自动拆分和结构化数据处理</li>\n<li>程序结构为 <code>BEGIN { 初始化 } pattern { 动作 } END { 收尾 }</code></li>\n<li><code>$0</code> 表示整行，<code>$1..$NF</code> 表示各字段，<code>NR</code> 为全局行号，<code>FNR</code> 为文件内行号</li>\n<li><code>-F</code> 指定字段分隔符，支持正则表达式分隔符</li>\n<li>关联数组是 awk 最强大的数据结构，适合统计、分组和查找操作</li>\n<li>awk 支持自定义函数，可以封装复杂的文本处理逻辑</li>\n<li>grep 适合搜索、sed 适合替换、awk 适合结构化数据处理——三者组合使用是 Shell 文本处理的核心</li>\n<li>对于超过 50 行的 awk 程序，建议迁移到 Python 或其他通用编程语言</li>\n</ul>\n","headings":[{"level":1,"text":"awk 编程","id":"awk-编程"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"字段处理与内置变量","id":"字段处理与内置变量"},{"level":3,"text":"内置变量示例","id":"内置变量示例"},{"level":2,"text":"模式匹配与条件过滤","id":"模式匹配与条件过滤"},{"level":3,"text":"模式类型","id":"模式类型"},{"level":2,"text":"编程结构与数据处理","id":"编程结构与数据处理"},{"level":3,"text":"统计与分组聚合","id":"统计与分组聚合"},{"level":3,"text":"关联数组与多文件 join","id":"关联数组与多文件-join"},{"level":2,"text":"自定义函数与高级技巧","id":"自定义函数与高级技巧"},{"level":2,"text":"常见陷阱","id":"常见陷阱"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"sed 流编辑器","url":"/l-doc-books/h/languages/shell-scripting/text-processing/sed"},"next":{"title":"错误处理","url":"/l-doc-books/h/languages/shell-scripting/scripting-patterns/error-handling"}}