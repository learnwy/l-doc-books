t;, bytes / 1048576)&#10;        else if (bytes &gt;= 1024)&#10;            return sprintf(&quot;%.1fK&quot;, bytes / 1024)&#10;        else&#10;            return bytes &quot;B&quot;&#10;    }&#10;    {&#10;        name = trim($1)&#10;        size = $5 + 0&#10;        printf &quot;%-20s %8s\\n&quot;, name, human_size(size)&#10;    }&#10;&#39; &lt;(ls -la)&#10;&#10;awk &#39;&#10;    function parse_json_value(line, key,    re, val) {&#10;        re = &quot;\\&quot;&quot; key &quot;\\&quot;[[:space:]]*:[[:space:]]*\\&quot;([^\\&quot;]*)\\&quot;&quot;&#10;        if (match(line, re)) {&#10;            val = substr(line, RSTART, RLENGTH)&#10;            gsub(/.*&quot;: *&quot;/, &quot;&quot;, val)&#10;            gsub(/&quot;$/, &quot;&quot;, val)&#10;            return val&#10;        }&#10;        return &quot;&quot;&#10;    }&#10;    {&#10;        name = parse_json_value($0, &quot;name&quot;)&#10;        version = parse_json_value($0, &quot;version&quot;)&#10;        if (name != &quot;&quot;)&#10;            printf &quot;%s@%s\\n&quot;, name, version&#10;    }&#10;&#39; package.json&#10;&#10;awk &#39;&#10;    BEGIN {&#10;        srand()&#10;    }&#10;    {&#10;        lines[NR] = $0&#10;    }&#10;    END {&#10;        n = NR&#10;        for (i = n; i &gt; 1; i--) {&#10;            j = int(rand() * i) + 1&#10;            temp = lines[i]&#10;            lines[i] = lines[j]&#10;            lines[j] = temp&#10;        }&#10;        for (i = 1; i &lt;= n; i++)&#10;            print lines[i]&#10;    }&#10;&#39; input.txt&#10;&#10;awk -v threshold=100 &#39;&#10;    $3 &gt; threshold {&#10;        printf &quot;\\033[31m%s\\033[0m\\n&quot;, $0&#10;    }&#10;    $3 &lt;= threshold {&#10;        print&#10;    }&#10;&#39; data.txt\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">awk</sp