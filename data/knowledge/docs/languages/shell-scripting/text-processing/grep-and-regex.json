k:#79B8FF\"> -l</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"newFunction\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sort</span></span></code></pre></div><h3 id=\"代码审查与安全扫描\">代码审查与安全扫描</h3><p>代码审查和安全扫描：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"grep -rn &quot;eval\\|Function(&quot; --include=&quot;*.js&quot; --include=&quot;*.ts&quot; src/&#10;&#10;grep -rP &quot;(password|secret|token|api_key)\\s*[:=]&quot; --include=&quot;*.{ts,js,json,yml}&quot; .&#10;&#10;grep -rn &quot;innerHTML\\|outerHTML\\|document\\.write&quot; --include=&quot;*.ts&quot; src/&#10;&#10;grep -rE &quot;http://&quot; --include=&quot;*.ts&quot; src/ | grep -v &quot;localhost\\|127\\.0\\.0\\.1&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -rn</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"eval\\|Function(\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"*.js\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"*.ts\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> src/</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -rP</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"(password|secret|token|api_key)\\s*[:=]\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"*.{ts,js,json,yml}\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> .</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -rn</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"innerHTML\\|outerHTML\\|document\\.write\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"*.ts\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> src/</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -rE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"http://\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"*.ts\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> src/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"localhost\\|127\\.0\\.0\\.1\"</span></span></code></pre></div><h2 id=\"性能优化与替代工具\">性能优化与替代工具</h2><h3 id=\"大文件优化与现代替代\">大文件优化与现代替代</h3><p>当文件量或数据量巨大时，grep 的性能优化策略至关重要：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"grep -F &quot;exact string&quot; huge.log&#10;&#10;LC_ALL=C grep &quot;pattern&quot; huge.log&#10;&#10;find . -name &quot;*.ts&quot; -print0 | xargs -0 grep -l &quot;pattern&quot;&#10;&#10;grep -r &quot;pattern&quot; --include=&quot;*.ts&quot; --exclude-dir={node_modules,.git,dist} .&#10;&#10;echo &quot;test&quot; | rg &quot;pattern&quot; file.log&#10;&#10;rg &quot;pattern&quot; --type ts&#10;&#10;rg -t ts &quot;useState&quot; -l&#10;&#10;ag &quot;pattern&quot; --ts&#10;&#10;rg &quot;TODO|FIXME|HACK&quot; --type ts -c | sort -t: -k2 -rn\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -F</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"exact string\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> huge.log</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LC_ALL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">C</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> grep</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"pattern\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> huge.log</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"*.ts\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -print0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xargs</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -l</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"pattern\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"pattern\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --include=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"*.ts\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --exclude-dir=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">node_modules,.git,dist}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> .</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"test\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> rg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"pattern\"</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.log</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"pattern\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --type</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ts</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rg</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ts</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"useState\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -l</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ag</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"pattern\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --ts</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"TODO|FIXME|HACK\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --type</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ts</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sort</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -k2</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -rn</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>速度</th>\n<th>正则支持</th>\n<th>.gitignore 尊重</th>\n<th>Unicode</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>grep</td>\n<td>中等</td>\n<td>BRE/ERE/PCRE</td>\n<td>否</td>\n<td>部分</td>\n<td>通用文本搜索</td>\n</tr>\n<tr>\n<td>ripgrep (rg)</td>\n<td>非常快</td>\n<td>Rust regex</td>\n<td>是</td>\n<td>完整</td>\n<td>代码库搜索</td>\n</tr>\n<tr>\n<td>ag (silver searcher)</td>\n<td>快</td>\n<td>PCRE</td>\n<td>是</td>\n<td>完整</td>\n<td>代码库搜索</td>\n</tr>\n<tr>\n<td>ack</td>\n<td>中等</td>\n<td>Perl</td>\n<td>否</td>\n<td>完整</td>\n<td>代码搜索</td>\n</tr>\n</tbody></table>\n<h2 id=\"常见陷阱\">常见陷阱</h2><p>grep 使用中的坑大多与正则方言和元字符转义有关，下表汇总几类典型错误。</p>\n<table>\n<thead>\n<tr>\n<th>错误写法</th>\n<th>问题</th>\n<th>正确写法</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>grep &quot;a+b&quot;</code></td>\n<td>BRE 下 <code>+</code> 是字面量</td>\n<td><code>grep -E &quot;a+b&quot;</code></td>\n</tr>\n<tr>\n<td><code>grep &quot;$pattern&quot;</code> 含特殊字符</td>\n<td>被当正则解释</td>\n<td><code>grep -F &quot;$pattern&quot;</code></td>\n</tr>\n<tr>\n<td><code>grep file*</code> 漏引号</td>\n<td>通配符被 Shell 先展开</td>\n<td><code>grep &quot;pattern&quot; file*</code></td>\n</tr>\n<tr>\n<td><code>ls | grep -c x</code> 当存在判断</td>\n<td>计数 0 仍退出 0</td>\n<td><code>grep -q x</code> 看退出码</td>\n</tr>\n<tr>\n<td>大文件不限语言环境</td>\n<td>UTF-8 校验拖慢匹配</td>\n<td><code>LC_ALL=C grep</code></td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>grep 是 Unix 文本搜索的基石，支持 BRE、ERE、PCRE 和固定字符串四种匹配模式</li>\n<li>推荐默认使用 <code>grep -E</code>（扩展正则），需要零宽断言时使用 <code>grep -P</code></li>\n<li><code>-r</code>（递归）、<code>-n</code>（行号）、<code>-l</code>（仅文件名）、<code>-c</code>（计数）是最高频的组合选项</li>\n<li>上下文选项 <code>-A</code>/<code>-B</code>/<code>-C</code> 在日志分析中极为实用</li>\n<li>对大文件使用 <code>-F</code>（固定字符串）和 <code>LC_ALL=C</code> 可显著提升性能</li>\n<li>ripgrep（rg）是 grep 的现代替代，默认尊重 .gitignore，速度快数倍</li>\n<li>正则表达式从 BRE → ERE → PCRE 能力递增，性能递减，应根据需求选择合适级别</li>\n</ul>\n","headings":[{"level":1,"text":"grep 与正则表达式","id":"grep-与正则表达式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基础正则表达式","id":"基础正则表达式"},{"level":3,"text":"扩展正则（ERE）","id":"扩展正则-ere"},{"level":3,"text":"Perl 正则（PCRE）","id":"perl-正则-pcre"},{"level":2,"text":"常用选项与组合","id":"常用选项与组合"},{"level":3,"text":"高频选项一览","id":"高频选项一览"},{"level":3,"text":"限量与多模式","id":"限量与多模式"},{"level":2,"text":"实战应用场景","id":"实战应用场景"},{"level":3,"text":"代码审查与安全扫描","id":"代码审查与安全扫描"},{"level":2,"text":"性能优化与替代工具","id":"性能优化与替代工具"},{"level":3,"text":"大文件优化与现代替代","id":"大文件优化与现代替代"},{"level":2,"text":"常见陷阱","id":"常见陷阱"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"函数","url":"/l-doc-books/h/languages/shell-scripting/bash-fundamentals/functions"},"next":{"title":"sed 流编辑器","url":"/l-doc-books/h/languages/shell-scripting/text-processing/sed"}}