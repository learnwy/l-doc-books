an class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">DB_PORT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">5432</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">            # 如果 DB_PORT 未设置或为空，设置为 5432 并返回</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">REQUIRED_VAR</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">变量未设置}\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 如果未设置，打印错误并退出</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">OPTIONAL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">+已设置}\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">          # 如果 OPTIONAL 已设置且非空，返回\"已设置\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">config_dir</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">XDG_CONFIG_HOME</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$HOME</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">config</span><span style