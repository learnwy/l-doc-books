ki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}()</span></span></code></pre></div><h3 id=\"pprof-goroutine-分析\">pprof goroutine 分析</h3><div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"import _ &quot;net/http/pprof&quot;&#10;// 访问 /debug/pprof/goroutine?debug=1&#10;// 查看阻塞在相同位置的大量 goroutine\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _ </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">net/http/pprof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 访问 /debug/pprof/goroutine?debug=1</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 查看阻塞在相同位置的大量 goroutine</span></span></code></pre></div><h3 id=\"goleak-测试库\">goleak 测试库</h3><div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"import &quot;go.uber.org/goleak&quot;&#10;&#10;func TestMain(m *testing.M) {&#10;    goleak.VerifyTestMain(m)&#10;}&#10;&#10;func TestNoLeak(t *testing.T) {&#10;    defer goleak.VerifyNone(t)&#10;    // ... 测试逻辑&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">go.uber.org/goleak</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TestMain</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">m</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">testing</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">M</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    goleak.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">VerifyTestMain</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(m)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TestNoLeak</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">testing</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> goleak.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">VerifyNone</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // ... 测试逻辑</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"go-1-26-goroutineleak-profile\">Go 1.26 goroutineleak profile</h3><p>Go 1.26 在 <code>runtime/pprof</code> 中新增了 <code>goroutineleak</code> profile（实验性），可直接标记存活超过阈值的 goroutine：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"GOEXPERIMENT=goroutineleakprofile go build&#10;curl http://localhost:6060/debug/pprof/goroutineleak\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">GOEXPERIMENT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">goroutineleakprofile</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> go</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> build</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">curl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> http://localhost:6060/debug/pprof/goroutineleak</span></span></code></pre></div><h2 id=\"防治原则总结\">防治原则总结</h2><table>\n<thead>\n<tr>\n<th>原则</th>\n<th>实践</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>启动前想好退出</td>\n<td>每个 <code>go func()</code> 都要回答「它什么时候结束」</td>\n</tr>\n<tr>\n<td>context 贯穿到底</td>\n<td>所有 I/O 和长时操作都接收 ctx 参数</td>\n</tr>\n<tr>\n<td>channel 有明确关闭方</td>\n<td>「谁创建谁关闭」或「发送方关闭」</td>\n</tr>\n<tr>\n<td>buffered channel 兜底</td>\n<td>可能无接收者时用 cap=1 防阻塞</td>\n</tr>\n<tr>\n<td>测试中用 goleak</td>\n<td>CI 中强制检查 goroutine 泄漏</td>\n</tr>\n<tr>\n<td>监控 go_goroutines</td>\n<td>Prometheus 指标，阈值告警</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>goroutine 泄漏 = 启动后无确定退出路径</li>\n<li>五大模式：接收者缺失、ctx 未传、无限循环无退出、channel 未关闭、WaitGroup 错误</li>\n<li>检测：runtime.NumGoroutine + pprof + goleak + Go 1.26 新 profile</li>\n<li>核心防治原则：「启动前想好退出」</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"../practice/structured-concurrency\">结构化并发与 errgroup</a>——errgroup 强制所有子 goroutine 在 Wait 返回前退出，是防泄漏的结构化保障</li>\n<li><a href=\"../../concurrency-models/concurrency-foundations/why-concurrency-is-hard\">并发模型 · 为什么并发很难</a>——goroutine 泄漏是「并发为什么难」的一个 Go 特有实例化</li>\n</ul>\n","headings":[{"level":1,"text":"Goroutine 泄漏防治","id":"goroutine-泄漏防治"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"五大泄漏模式与修复","id":"五大泄漏模式与修复"},{"level":3,"text":"模式一：接收者缺失","id":"模式一-接收者缺失"},{"level":3,"text":"模式二：context 未贯穿","id":"模式二-context-未贯穿"},{"level":3,"text":"模式三：无限循环无退出","id":"模式三-无限循环无退出"},{"level":3,"text":"模式四：生产者未关闭 channel","id":"模式四-生产者未关闭-channel"},{"level":3,"text":"模式五：WaitGroup 计数错误","id":"模式五-waitgroup-计数错误"},{"level":2,"text":"检测工具","id":"检测工具"},{"level":3,"text":"runtime 计数监控","id":"runtime-计数监控"},{"level":3,"text":"pprof goroutine 分析","id":"pprof-goroutine-分析"},{"level":3,"text":"goleak 测试库","id":"goleak-测试库"},{"level":3,"text":"Go 1.26 goroutineleak profile","id":"go-1-26-goroutineleak-profile"},{"level":2,"text":"防治原则总结","id":"防治原则总结"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"Worker Pool 模式","url":"/l-doc-books/h/languages/go-concurrency-runtime-patterns/patterns/worker-pool"},"next":{"title":"iter 迭代器与 Range-Over-Func","url":"/l-doc-books/h/languages/go-concurrency-runtime-patterns/advanced/iter-range-over-func"}}