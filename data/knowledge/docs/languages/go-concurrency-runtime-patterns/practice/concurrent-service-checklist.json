\"color:#24292E;--shiki-dark:#E1E4E8\"> time.Second)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ticker.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Stop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        select</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ticker.C:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            goroutineGauge.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">float64</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(runtime.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NumGoroutine</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()))</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ctx.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Done</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">():</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24