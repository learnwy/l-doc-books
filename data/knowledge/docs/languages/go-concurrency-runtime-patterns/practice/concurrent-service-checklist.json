span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // Step 1: 停止接受新连接（给负载均衡器 drain 时间）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    shutdownCtx, cancel </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> context.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(context.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Background</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">30</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">time.Second)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    defer</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cancel</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> httpServer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Shutdown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(shutdownCtx); err </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        log.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Printf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"HTTP shutdown error: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, err)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // Step 2: 等待后台任务完成</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    s.bgPool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Release</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // Step 3: 关闭数据库连接</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    s.dbPool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    log.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Println</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Server shutdown complete\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>关键时间参数：</p>\n<table>\n<thead>\n<tr>\n<th>参数</th>\n<th>推荐值</th>\n<th>依据</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>K8s terminationGracePeriodSeconds</td>\n<td>60s</td>\n<td>容器级上界</td>\n</tr>\n<tr>\n<td>HTTP Shutdown timeout</td>\n<td>30s</td>\n<td>留给进行中请求的 drain 时间</td>\n</tr>\n<tr>\n<td>Worker Pool drain</td>\n<td>15s</td>\n<td>后台任务的宽限期</td>\n</tr>\n<tr>\n<td>DB connection close</td>\n<td>5s</td>\n<td>等待正在执行的查询</td>\n</tr>\n</tbody></table>\n<h3 id=\"8-健康检查与就绪探针\">8. 健康检查与就绪探针</h3><div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"func (s *Server) healthHandler(w http.ResponseWriter, r *http.Request) {&#10;    if s.shuttingDown.Load() {&#10;        w.WriteHeader(http.StatusServiceUnavailable)&#10;        return&#10;    }&#10;    w.WriteHeader(http.StatusOK)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Server</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">healthHandler</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">w</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> http</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ResponseWriter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">http</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> s.shuttingDown.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Load</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        w.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WriteHeader</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(http.StatusServiceUnavailable)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    w.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WriteHeader</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(http.StatusOK)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"完整设计清单总览\">完整设计清单总览</h2><table>\n<thead>\n<tr>\n<th>#</th>\n<th>检查项</th>\n<th>阶段</th>\n<th>严重性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>1</td>\n<td>GOMAXPROCS 适配容器 CPU</td>\n<td>启动</td>\n<td>HIGH</td>\n</tr>\n<tr>\n<td>2</td>\n<td>Worker Pool 有上界</td>\n<td>启动</td>\n<td>HIGH</td>\n</tr>\n<tr>\n<td>3</td>\n<td>信号处理注册</td>\n<td>启动</td>\n<td>HIGH</td>\n</tr>\n<tr>\n<td>4</td>\n<td>请求 context 贯穿所有 I/O</td>\n<td>运行</td>\n<td>CRITICAL</td>\n</tr>\n<tr>\n<td>5</td>\n<td>后台任务有独立 context + 超时</td>\n<td>运行</td>\n<td>HIGH</td>\n</tr>\n<tr>\n<td>6</td>\n<td>goroutine 数监控 + 告警</td>\n<td>运行</td>\n<td>MEDIUM</td>\n</tr>\n<tr>\n<td>7</td>\n<td>优雅关停有 timeout</td>\n<td>关停</td>\n<td>HIGH</td>\n</tr>\n<tr>\n<td>8</td>\n<td>健康检查感知关停状态</td>\n<td>关停</td>\n<td>MEDIUM</td>\n</tr>\n<tr>\n<td>9</td>\n<td>CI 启用 -race</td>\n<td>开发</td>\n<td>CRITICAL</td>\n</tr>\n<tr>\n<td>10</td>\n<td>goleak 检查测试</td>\n<td>开发</td>\n<td>HIGH</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>并发服务设计按生命周期三阶段组织：启动→运行→关停</li>\n<li>GOMAXPROCS + Worker Pool 上界 = 资源边界的第一道防线</li>\n<li>请求级 context 贯穿到底 = 取消/超时传播的唯一正确路径</li>\n<li>优雅关停 = 停接入 → drain 请求 → 关 pool → 关 DB</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"race-detection-profiling\">竞态检测与性能诊断</a>——本清单中的「CI 启用 -race」是该文档的核心建议之一</li>\n<li><a href=\"../../go-service-engineering/running-in-production/graceful-shutdown\">Go 服务工程 · 优雅关停</a>——关停阶段的信号处理与 HTTP Server Shutdown 的完整实现细节</li>\n</ul>\n","headings":[{"level":1,"text":"并发服务设计清单","id":"并发服务设计清单"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"启动阶段清单","id":"启动阶段清单"},{"level":3,"text":"1. GOMAXPROCS 容器适配","id":"1-gomaxprocs-容器适配"},{"level":3,"text":"2. Worker Pool 初始化","id":"2-worker-pool-初始化"},{"level":3,"text":"3. 信号处理注册","id":"3-信号处理注册"},{"level":2,"text":"运行阶段清单","id":"运行阶段清单"},{"level":3,"text":"4. 请求级 Context 传播","id":"4-请求级-context-传播"},{"level":3,"text":"5. 后台任务的生命周期绑定","id":"5-后台任务的生命周期绑定"},{"level":3,"text":"6. Goroutine 监控","id":"6-goroutine-监控"},{"level":2,"text":"关停阶段清单","id":"关停阶段清单"},{"level":3,"text":"7. 优雅关停流程","id":"7-优雅关停流程"},{"level":3,"text":"8. 健康检查与就绪探针","id":"8-健康检查与就绪探针"},{"level":2,"text":"完整设计清单总览","id":"完整设计清单总览"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"竞态检测与性能诊断","url":"/l-doc-books/h/languages/go-concurrency-runtime-patterns/practice/race-detection-profiling"},"next":null}