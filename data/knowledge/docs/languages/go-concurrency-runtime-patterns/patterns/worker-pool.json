3\">chan</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">T</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> any</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">](</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pool</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Pool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">work</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;-chan</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    done </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> make</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">chan</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    pool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        done </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;-</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> work</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> done</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pool, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> heavyComputation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result</span></span></code></pre></div><h2 id=\"池大小选择策略\">池大小选择策略</h2><p>池大小不是一个静态数字，而是需要根据工作负载特征选择：</p>\n<table>\n<thead>\n<tr>\n<th>工作负载类型</th>\n<th>推荐池大小</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>CPU 密集</td>\n<td><code>runtime.NumCPU()</code></td>\n<td>超出核心数无收益，只增调度开销</td>\n</tr>\n<tr>\n<td>I/O 密集（低延迟）</td>\n<td><code>runtime.NumCPU() * 2~4</code></td>\n<td>一半 worker 在等 I/O 时另一半可运行</td>\n</tr>\n<tr>\n<td>I/O 密集（高延迟）</td>\n<td>按下游容量定</td>\n<td>如数据库连接池大小、API 限速</td>\n</tr>\n<tr>\n<td>混合型</td>\n<td>按 Little&#39;s Law: <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>L</mi><mo>=</mo><mi>λ</mi><mo>×</mo><mi>W</mi></mrow><annotation encoding=\"application/x-tex\">L = \\lambda \\times W</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\">L</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.0833em;\"></span><span class=\"mord mathnormal\">λ</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">W</span></span></span></span></span></td>\n<td><span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>L</mi></mrow><annotation encoding=\"application/x-tex\">L</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\">L</span></span></span></span></span>=并发度 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>λ</mi></mrow><annotation encoding=\"application/x-tex\">\\lambda</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\">λ</span></span></span></span></span>=到达率 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>W</mi></mrow><annotation encoding=\"application/x-tex\">W</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1389em;\">W</span></span></span></span></span>=平均处理时间</td>\n</tr>\n</tbody></table>\n<p>Little&#39;s Law 示例：请求到达率 1000/s，平均处理 50ms → 需要 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>1000</mn><mo>×</mo><mn>0.05</mn><mo>=</mo><mn>50</mn></mrow><annotation encoding=\"application/x-tex\">1000 \\times 0.05 = 50</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">1000</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.05</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">50</span></span></span></span></span> 个并发 worker。</p>\n<h2 id=\"ants-库-生产级-pool\">ants 库：生产级 Pool</h2><p><code>github.com/panjf2000/ants/v2</code> 是 Go 生态最成熟的 goroutine 池库：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"pool, _ := ants.NewPool(50,&#10;    ants.WithPreAlloc(true),           // 预分配 goroutine&#10;    ants.WithNonblocking(false),       // Submit 满时阻塞&#10;    ants.WithExpiryDuration(10*time.Second), // 空闲 worker 超时回收&#10;)&#10;defer pool.Release()&#10;&#10;for _, task := range tasks {&#10;    t := task&#10;    pool.Submit(func() {&#10;        process(t)&#10;    })&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pool, _ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ants.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NewPool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ants.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithPreAlloc</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),           </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 预分配 goroutine</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ants.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithNonblocking</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),       </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Submit 满时阻塞</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ants.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">WithExpiryDuration</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">time.Second), </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 空闲 worker 超时回收</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Release</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _, task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tasks {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> task</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    pool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(t)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>实测数据（某支付网关）：</p>\n<table>\n<thead>\n<tr>\n<th>指标</th>\n<th>无池（无限 goroutine）</th>\n<th>ants 池（N=CPU×4）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>峰值内存</td>\n<td>3.8GB</td>\n<td>1.2GB</td>\n</tr>\n<tr>\n<td>P99 延迟</td>\n<td>120ms</td>\n<td>45ms</td>\n</tr>\n<tr>\n<td>GC 频率</td>\n<td>15 次/分</td>\n<td>6 次/分</td>\n</tr>\n</tbody></table>\n<h2 id=\"优雅关停\">优雅关停</h2><p>Worker Pool 的关停需要处理「排空已提交任务」与「终止 worker」两个关切：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"func (p *Pool) GracefulShutdown(timeout time.Duration) error {&#10;    // 1. 停止接受新任务&#10;    close(p.jobs)&#10;&#10;    // 2. 等待已提交任务完成或超时&#10;    done := make(chan struct{})&#10;    go func() {&#10;        p.wg.Wait()&#10;        close(done)&#10;    }()&#10;&#10;    select {&#10;    case &lt;-done:&#10;        return nil&#10;    case &lt;-time.After(timeout):&#10;        return fmt.Errorf(&quot;pool shutdown timeout after %v&quot;, timeout)&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Pool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">GracefulShutdown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">timeout</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> time</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Duration</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 1. 停止接受新任务</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.jobs)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 2. 等待已提交任务完成或超时</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    done </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> make</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">chan</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> struct</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{})</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    go</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        p.wg.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Wait</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(done)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    select</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">done:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> nil</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">After</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(timeout):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fmt.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Errorf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"pool shutdown timeout after </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, timeout)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"动态扩缩容\">动态扩缩容</h2><p>在流量波动大的场景中，固定池大小不够灵活。动态 Pool 根据任务队列深度自动调整 worker 数：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"func (p *DynamicPool) autoscale(ctx context.Context) {&#10;    ticker := time.NewTicker(time.Second)&#10;    defer ticker.Stop()&#10;&#10;    for {&#10;        select {&#10;        case &lt;-ticker.C:&#10;            pending := len(p.jobs)&#10;            active := p.activeWorkers.Load()&#10;            if pending &gt; int(active)*2 &amp;&amp; active &lt; p.maxSize {&#10;                p.addWorker()&#10;            } else if pending == 0 &amp;&amp; active &gt; p.minSize {&#10;                p.removeWorker()&#10;            }&#10;        case &lt;-ctx.Done():&#10;            return&#10;        }&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">DynamicPool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">autoscale</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Context</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ticker </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NewTicker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(time.Second)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ticker.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Stop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        select</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ticker.C:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            pending </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.jobs)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            active </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.activeWorkers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Load</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pending </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(active)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> active </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.maxSize {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                p.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">addWorker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pending </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x26;&#x26;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> active </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p.minSize {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                p.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">removeWorker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ctx.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Done</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">():</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li>Worker Pool = 固定 goroutine 循环消费任务 channel，并发度稳定</li>\n<li>池大小由工作负载类型决定：CPU 密集 → NumCPU，I/O 密集 → Little&#39;s Law</li>\n<li>生产环境推荐 ants 库：预分配、超时回收、非阻塞提交</li>\n<li>优雅关停需同时处理「排空」与「超时」</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li><a href=\"pipeline\">Pipeline 流水线模式</a>——Worker Pool 常作为 Pipeline 中某个 stage 的内部实现，用于加速瓶颈阶段</li>\n<li><a href=\"../../rust-systems-programming/practice/lock-free-data-structures\">Rust 系统编程 · 无锁数据结构</a>——当 Pool 的 jobs channel 成为瓶颈时，无锁队列是一种替代方案；Rust 的所有权模型使无锁结构更易正确实现</li>\n</ul>\n","headings":[{"level":1,"text":"Worker Pool 模式","id":"worker-pool-模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"标准实现","id":"标准实现"},{"level":2,"text":"带结果收集的泛型 Pool","id":"带结果收集的泛型-pool"},{"level":2,"text":"池大小选择策略","id":"池大小选择策略"},{"level":2,"text":"ants 库：生产级 Pool","id":"ants-库-生产级-pool"},{"level":2,"text":"优雅关停","id":"优雅关停"},{"level":2,"text":"动态扩缩容","id":"动态扩缩容"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"Fan-Out/Fan-In 模式","url":"/l-doc-books/h/languages/go-concurrency-runtime-patterns/patterns/fan-out-fan-in"},"next":{"title":"Goroutine 泄漏防治","url":"/l-doc-books/h/languages/go-concurrency-runtime-patterns/advanced/goroutine-leak-prevention"}}