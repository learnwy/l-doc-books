chA:&#10;        process(v)&#10;    case v := &lt;-chB:&#10;        process(v)&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dynamicSelect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">enableA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> bool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> chA </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;-chan</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> int</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> enableA {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        chA </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> producerA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // chA 为 nil 时，对应的 case 永远不会触发</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    select</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">chA:</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">chB:</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"性能特征\">性能特征</h2><p>select 的开销随 case 数量线性增长，因为 <code>selectgo</code> 需要：</p>\n<ol>\n<li>对所有涉及的 hchan 按地址排序并逐一加锁</li>\n<li>遍历所有 case 检查就绪状态</li>\n<li>未就绪时将 G 注册到所有 channel 的等待队列</li>\n<li>唤醒后从所有队列中移除</li>\n</ol>\n<p>基准测试（Go 1.24，AMD Ryzen 9）：</p>\n<table>\n<thead>\n<tr>\n<th>case 数量</th>\n<th>平均耗时</th>\n<th>相对开销</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>2</td>\n<td>85ns</td>\n<td>baseline</td>\n</tr>\n<tr>\n<td>4</td>\n<td>140ns</td>\n<td>+65%</td>\n</tr>\n<tr>\n<td>8</td>\n<td>260ns</td>\n<td>+206%</td>\n</tr>\n<tr>\n<td>16</td>\n<td>510ns</td>\n<td>+500%</td>\n</tr>\n</tbody></table>\n<p>当 case 超过 8 个时，考虑重构为多层 select 或 channel 合并（fan-in）以降低单次 select 的开销。</p>\n<h2 id=\"常见陷阱\">常见陷阱</h2><p><strong>陷阱 1：for-select 中的 time.After 泄漏</strong></p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"// 错误：每次循环都分配一个 timer，旧 timer 直到触发才被 GC&#10;for {&#10;    select {&#10;    case msg := &lt;-ch:&#10;        process(msg)&#10;    case &lt;-time.After(5 * time.Second):&#10;        return&#10;    }&#10;}&#10;&#10;// 正确：复用 timer&#10;timer := time.NewTimer(5 * time.Second)&#10;defer timer.Stop()&#10;for {&#10;    select {&#10;    case msg := &lt;-ch:&#10;        if !timer.Stop() {&#10;            &lt;-timer.C&#10;        }&#10;        timer.Reset(5 * time.Second)&#10;        process(msg)&#10;    case &lt;-timer.C:&#10;        return&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 错误：每次循环都分配一个 timer，旧 timer 直到触发才被 GC</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    select</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> msg </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ch:</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(msg)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">After</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.Second):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正确：复用 timer</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">timer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">NewTimer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time.Second)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">defer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> timer.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Stop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    select</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> msg </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ch:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    