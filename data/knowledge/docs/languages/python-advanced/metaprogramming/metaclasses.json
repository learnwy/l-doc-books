 style=\"color:#E36209;--shiki-dark:#FFAB70\">repr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">False</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    @</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">property</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> distance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span></span></code></pre></div><h3 id=\"dataclass-参数\">dataclass 参数</h3><table>\n<thead>\n<tr>\n<th>参数</th>\n<th>默认</th>\n<th>效果</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>frozen</code></td>\n<td>False</td>\n<td>实例不可变</td>\n</tr>\n<tr>\n<td><code>slots</code></td>\n<td>False</td>\n<td>使用 <code>__slots__</code></td>\n</tr>\n<tr>\n<td><code>order</code></td>\n<td>False</td>\n<td>生成比较方法</td>\n</tr>\n<tr>\n<td><code>kw_only</code></td>\n<td>False</td>\n<td>所有字段仅关键字传参</td>\n</tr>\n<tr>\n<td><code>eq</code></td>\n<td>True</td>\n<td>生成 <code>__eq__</code></td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"attrs-库\">attrs 库</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import attrs&#10;&#10;@attrs.define&#10;class User:&#10;    name: str = attrs.field(validator=attrs.validators.instance_of(str))&#10;    age: int = attrs.field(validator=[&#10;        attrs.validators.instance_of(int),&#10;        attrs.validators.ge(0),&#10;    ])&#10;    email: str = attrs.field(default=&quot;&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attrs</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">@attrs.define</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    name: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attrs.field(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">validator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">attrs.validators.instance_of(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    age: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attrs.field(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">validator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        attrs.validators.instance_of(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        attrs.validators.ge(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    email: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attrs.field(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">default</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h3 id=\"dataclasses-vs-attrs\">dataclasses vs attrs</h3><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>dataclasses</th>\n<th>attrs</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>标准库</td>\n<td>✅</td>\n<td>❌（需安装）</td>\n</tr>\n<tr>\n<td>验证器</td>\n<td>无内置</td>\n<td>丰富的验证器</td>\n</tr>\n<tr>\n<td>转换器</td>\n<td>无</td>\n<td>支持自动转换</td>\n</tr>\n<tr>\n<td>性能</td>\n<td>好</td>\n<td>略好</td>\n</tr>\n<tr>\n<td>API 风格</td>\n<td>装饰器</td>\n<td>装饰器</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"抽象基类元类\">抽象基类元类</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from abc import ABCMeta, abstractmethod&#10;&#10;class Shape(metaclass=ABCMeta):&#10;    @abstractmethod&#10;    def area(self) -&gt; float: ...&#10;&#10;    @abstractmethod&#10;    def perimeter(self) -&gt; float: ...&#10;&#10;class Circle(Shape):&#10;    def __init__(self, radius: float):&#10;        self.radius = radius&#10;&#10;    def area(self) -&gt; float:&#10;        return 3.14159 * self.radius ** 2&#10;&#10;    def perimeter(self) -&gt; float:&#10;        return 2 * 3.14159 * self.radius\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> abc </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ABCMeta, abstractmethod</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Shape</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">metaclass</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ABCMeta</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    @abstractmethod</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> area</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    @abstractmethod</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> perimeter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Circle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Shape</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, radius: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.radius </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> radius</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> area</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3.14159</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.radius </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> perimeter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self) -> </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3.14159</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.radius</span></span></code></pre></div><p>ABCMeta 在类创建时检查是否所有抽象方法都已实现，未实现则禁止实例化。</p>\n<hr>\n<h2 id=\"最佳实践\">最佳实践</h2><ul>\n<li>优先使用 <code>__init_subclass__</code> 和 <code>dataclasses</code>，只在必要时使用元类</li>\n<li>避免多元类冲突——一个类只能有一个元类</li>\n<li>使用 <code>@dataclass(frozen=True, slots=True)</code> 创建高效的不可变值对象</li>\n<li>需要复杂验证时选择 attrs，简单场景使用 dataclasses</li>\n<li>元类代码务必编写清晰的文档，因为其行为对使用者不直观</li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>类本身是 <code>type</code> 的实例，元类是&quot;类的类&quot;，控制类的创建过程。</li>\n<li>类创建是可介入的多阶段流程：<code>__prepare__</code> → 类体执行 → <code>__new__</code> → <code>__init__</code>，实例化再走 <code>__call__</code>。</li>\n<li><code>type(name, bases, namespace)</code> 可直接动态创建类。</li>\n<li><code>__init_subclass__</code> 是元类的轻量替代，适合注册与简单验证，应优先选择。</li>\n<li><code>dataclasses</code> / <code>attrs</code> 是声明式类工厂：前者出自标准库，后者验证器更丰富。</li>\n<li>ABCMeta 在类创建时校验抽象方法是否全部实现，未实现则禁止实例化。</li>\n</ul>\n","headings":[{"level":1,"text":"元类与类工厂","id":"元类与类工厂"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"type 是一切类的元类","id":"type-是一切类的元类"},{"level":2,"text":"用 type 动态创建类","id":"用-type-动态创建类"},{"level":2,"text":"自定义元类","id":"自定义元类"},{"level":3,"text":"元类方法调用顺序","id":"元类方法调用顺序"},{"level":2,"text":"`__init_subclass__`：轻量替代元类","id":"__init_subclass__-轻量替代元类"},{"level":3,"text":"元类 vs `__init_subclass__`","id":"元类-vs-__init_subclass__"},{"level":2,"text":"dataclasses：声明式类工厂","id":"dataclasses-声明式类工厂"},{"level":3,"text":"dataclass 参数","id":"dataclass-参数"},{"level":2,"text":"attrs 库","id":"attrs-库"},{"level":3,"text":"dataclasses vs attrs","id":"dataclasses-vs-attrs"},{"level":2,"text":"抽象基类元类","id":"抽象基类元类"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"描述符与属性协议","url":"/l-doc-books/h/languages/python-advanced/metaprogramming/descriptors"},"next":{"title":"代码生成与 AST","url":"/l-doc-books/h/languages/python-advanced/metaprogramming/code-generation"}}