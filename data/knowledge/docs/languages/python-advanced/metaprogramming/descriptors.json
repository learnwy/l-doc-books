shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Config</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    timeout </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Range(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    retries </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Range(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"__slots__-与描述符\"><code>__slots__</code> 与描述符</h2><p>使用 <code>__slots__</code> 时，Python 为每个 slot 创建一个隐式的数据描述符：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"class Point:&#10;    __slots__ = (&quot;x&quot;, &quot;y&quot;)&#10;&#10;    def __init__(self, x: float, y: float):&#10;        self.x = x&#10;        self.y = y\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Point</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    __slots__</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"x\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"y\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, x: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, y: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">float</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.x </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.y </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> y</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>有 <code>__slots__</code></th>\n<th>无 <code>__slots__</code></th>\n</tr>\n</thead>\n<tbody><tr>\n<td>内存</td>\n<td>更低（无 <code>__dict__</code>）</td>\n<td>更高</td>\n</tr>\n<tr>\n<td>属性访问</td>\n<td>通过 slot 描述符</td>\n<td>通过 <code>__dict__</code> 查找</td>\n</tr>\n<tr>\n<td>动态添加属性</td>\n<td>不允许</td>\n<td>允许</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"描述符在-orm-中的应用\">描述符在 ORM 中的应用</h2><p>Django、SQLAlchemy 等 ORM 大量使用描述符来定义模型字段：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"class Field:&#10;    def __init__(self, column_type: str):&#10;        self.column_type = column_type&#10;        self.name = &quot;&quot;&#10;&#10;    def __set_name__(self, owner, name):&#10;        self.name = name&#10;&#10;    def __get__(self, obj, objtype=None):&#10;        if obj is None:&#10;            return self&#10;        return obj.__dict__.get(self.name)&#10;&#10;    def __set__(self, obj, value):&#10;        obj.__dict__[self.name] = value&#10;&#10;class Model:&#10;    id = Field(&quot;INTEGER PRIMARY KEY&quot;)&#10;    name = Field(&quot;VARCHAR(100)&quot;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Field</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __init__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, column_type: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.column_type </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> column_type</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.name </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __set_name__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, owner, name):</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.name </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> name</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __get__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, obj, objtype</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> obj </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">is</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> obj.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">__dict__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.get(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.name)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __set__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, obj, value):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        obj.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">__dict__</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.name] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> value</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Model</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Field(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"INTEGER PRIMARY KEY\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    name </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Field(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"VARCHAR(100)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><hr>\n<h2 id=\"最佳实践\">最佳实践</h2><ul>\n<li>使用 <code>__set_name__</code> 自动获取属性名，避免在构造时重复传入</li>\n<li>非数据描述符适用于缓存场景（LazyProperty），数据描述符适用于验证场景</li>\n<li>优先使用 <code>property</code> 和 <code>functools.cached_property</code>，只在需要复用逻辑时自定义描述符</li>\n<li>描述符存储数据应写入 <code>obj.__dict__</code> 而非描述符自身，避免实例间数据共享</li>\n<li>理解属性查找链：数据描述符 &gt; 实例属性 &gt; 非数据描述符 &gt; <code>__getattr__</code></li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>描述符把属性访问变成可编程钩子，<code>property</code>、<code>classmethod</code> 与 ORM 字段都由它支撑。</li>\n<li>两条主线：数据/非数据描述符决定优先级；数据必须写入 <code>obj.__dict__</code> 而非描述符自身。</li>\n<li>属性查找链为：数据描述符 &gt; 实例属性 &gt; 非数据描述符 &gt; <code>__getattr__</code>。</li>\n<li><code>__set_name__</code> 在类创建时自动获得属性名，省去构造时重复传参。</li>\n<li>数据描述符适合验证，非数据描述符适合缓存（LazyProperty）；<code>__slots__</code> 为每个 slot 创建隐式数据描述符。</li>\n<li>优先用 <code>property</code> 与 <code>functools.cached_property</code>，只在需要复用逻辑时自定义描述符。</li>\n</ul>\n","headings":[{"level":1,"text":"描述符与属性协议","id":"描述符与属性协议"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"描述符协议","id":"描述符协议"},{"level":3,"text":"数据描述符 vs 非数据描述符","id":"数据描述符-vs-非数据描述符"},{"level":2,"text":"基本示例","id":"基本示例"},{"level":3,"text":"类型验证描述符","id":"类型验证描述符"},{"level":2,"text":"property 的描述符本质","id":"property-的描述符本质"},{"level":2,"text":"实用描述符模式","id":"实用描述符模式"},{"level":3,"text":"延迟计算（Lazy Property）","id":"延迟计算-lazy-property"},{"level":3,"text":"范围验证","id":"范围验证"},{"level":2,"text":"`__slots__` 与描述符","id":"__slots__-与描述符"},{"level":2,"text":"描述符在 ORM 中的应用","id":"描述符在-orm-中的应用"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"装饰器进阶","url":"/l-doc-books/h/languages/python-advanced/metaprogramming/advanced-decorators"},"next":{"title":"元类与类工厂","url":"/l-doc-books/h/languages/python-advanced/metaprogramming/metaclasses"}}