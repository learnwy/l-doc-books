   def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> expensive_result</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self):</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        time.sleep(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 42</span></span></code></pre></div><p>首次访问时计算并缓存到实例 <code>__dict__</code>，后续直接读取（非数据描述符优先级低于实例属性）。</p>\n<h3 id=\"范围验证\">范围验证</h3><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"class Range:&#10;    def __init__(self, min_val: float, max_val: float):&#10;        self.min_val = min_val&#10;        self.max_val = max_val&#10;        self.name = &quot;&quot;&#10;&#10;    def __set_name__(self, owner, name):&#10;        self.name = name&#10;&#10;    def __get__(self, obj, objtype=None):&#10;        if obj is None:&#10;            return self&#10;        return obj.__dict__.get(self.name)&#10;&#10;    def __set__(self, obj, value):&#10;        if not self.min_val &lt;= value &lt;= self.max_val:&#10;            raise ValueError(f&quot;{self.name}: {value} not in [{self.min_val}, {self.max_val}]&quot;)&#10;        obj.__dict__[self.name] = value&#10;&#10;class Config:&#10;    timeout = Range(1, 300)&#10;    retries = Range(0, 10)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Range</span><span style=\"color:#24292E