入其所在部门的平均工资。</p>\n<hr>\n<h2 id=\"合并与连接\">合并与连接</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"merged = pd.merge(df1, df2, on=&quot;user_id&quot;, how=&quot;left&quot;)&#10;concatenated = pd.concat([df1, df2], axis=0, ignore_index=True)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">merged </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.merge(df1, df2, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">on</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"user_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">how</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"left\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">concatenated </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.concat([df1, df2], </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">axis</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ignore_index</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>合并方式</th>\n<th>参数</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>内连接</td>\n<td><code>how=&quot;inner&quot;</code></td>\n<td>仅保留两边都有的行</td>\n</tr>\n<tr>\n<td>左连接</td>\n<td><code>how=&quot;left&quot;</code></td>\n<td>保留左表所有行</td>\n</tr>\n<tr>\n<td>右连接</td>\n<td><code>how=&quot;right&quot;</code></td>\n<td>保留右表所有行</td>\n</tr>\n<tr>\n<td>全外连接</td>\n<td><code>how=&quot;outer&quot;</code></td>\n<td>保留所有行</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"时间序列\">时间序列</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"ts = pd.date_range(&quot;2024-01-01&quot;, periods=365, freq=&quot;D&quot;)&#10;df[&quot;date&quot;] = pd.to_datetime(df[&quot;date&quot;])&#10;df = df.set_index(&quot;date&quot;)&#10;&#10;monthly = df.resample(&quot;ME&quot;).mean()&#10;df[&quot;rolling_7d&quot;] = df[&quot;value&quot;].rolling(window=7).mean()\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.date_range(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"2024-01-01\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">periods</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">365</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">freq</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"D\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.to_datetime(df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df.set_index(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">monthly </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df.resample(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ME\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).mean()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rolling_7d\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"value\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].rolling(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">window</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).mean()</span></span></code></pre></div><hr>\n<h2 id=\"polars-高性能替代\">Polars：高性能替代</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import polars as pl&#10;&#10;df = pl.read_csv(&quot;data.csv&quot;)&#10;result = (&#10;    df.filter(pl.col(&quot;age&quot;) &gt; 18)&#10;    .group_by(&quot;department&quot;)&#10;    .agg(pl.col(&quot;salary&quot;).mean().alias(&quot;avg_salary&quot;))&#10;    .sort(&quot;avg_salary&quot;, descending=True)&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> polars </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pl</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pl.read_csv(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"data.csv\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    df.filter(pl.col(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"age\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 18</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .group_by(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"department\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .agg(pl.col(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"salary\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).mean().alias(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"avg_salary\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .sort(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"avg_salary\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">descending</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>Pandas</th>\n<th>Polars</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>引擎</td>\n<td>C / Cython</td>\n<td>Rust</td>\n</tr>\n<tr>\n<td>并行</td>\n<td>单线程</td>\n<td>多线程</td>\n</tr>\n<tr>\n<td>惰性求值</td>\n<td>不支持</td>\n<td>支持（LazyFrame）</td>\n</tr>\n<tr>\n<td>API 风格</td>\n<td>方法链 + 索引</td>\n<td>表达式链</td>\n</tr>\n<tr>\n<td>内存</td>\n<td>较高</td>\n<td>较低</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"最佳实践\">最佳实践</h2><ul>\n<li>使用 Parquet 格式存储中间数据，比 CSV 快 5-10 倍</li>\n<li>用 <code>query()</code> 替代布尔索引链提升可读性</li>\n<li>避免逐行 <code>iterrows()</code> 循环，改用向量化操作或 <code>apply()</code></li>\n<li>大数据集（&gt;1GB）考虑使用 Polars 或 Dask</li>\n<li>设置 <code>pd.options.display.max_columns = None</code> 查看完整列</li>\n<li>使用 <code>transform()</code> 做组内计算以保持原始索引对齐</li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>DataFrame 是列存储结构：每列一个独立 ndarray，因此按列操作快、按行迭代慢。</li>\n<li>核心数据结构为 Series（1D）与 DataFrame（2D），内部基于 NumPy。</li>\n<li>读写格式各有取舍：Parquet 快且小，CSV 通用但慢，大文件可用 <code>usecols</code> / <code>dtype</code> / <code>chunksize</code> 优化。</li>\n<li>数据清洗围绕缺失值、类型转换与去重展开；分组聚合依赖 <code>groupby().agg()</code>。</li>\n<li>关键区别：<code>agg()</code> 返回缩减结果，<code>transform()</code> 返回与原表等长的结果。</li>\n<li>大数据集可转向 Polars：Rust 引擎、多线程、支持 LazyFrame 惰性求值。</li>\n</ul>\n","headings":[{"level":1,"text":"Pandas 数据处理","id":"pandas-数据处理"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心数据结构","id":"核心数据结构"},{"level":2,"text":"数据读写","id":"数据读写"},{"level":2,"text":"数据探索","id":"数据探索"},{"level":2,"text":"数据清洗","id":"数据清洗"},{"level":3,"text":"缺失值处理","id":"缺失值处理"},{"level":3,"text":"类型转换与去重","id":"类型转换与去重"},{"level":2,"text":"筛选与变换","id":"筛选与变换"},{"level":3,"text":"常用字符串操作","id":"常用字符串操作"},{"level":2,"text":"分组与聚合","id":"分组与聚合"},{"level":2,"text":"合并与连接","id":"合并与连接"},{"level":2,"text":"时间序列","id":"时间序列"},{"level":2,"text":"Polars：高性能替代","id":"polars-高性能替代"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"NumPy 与向量化计算","url":"/l-doc-books/h/languages/python-advanced/data-science/numpy"},"next":{"title":"数据可视化 Matplotlib/Plotly","url":"/l-doc-books/h/languages/python-advanced/data-science/visualization"}}