r:#032F62;--shiki-dark:#9ECBFF\">\"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.to_datetime(df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df.drop_duplicates(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">subset</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"date\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span></code></pre></div><hr>\n<h2 id=\"筛选与变换\">筛选与变换</h2><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"adults = df[df[&quot;age&quot;] &gt;= 18]&#10;top_students = df.query(&quot;score &gt; 90 and age &lt; 30&quot;)&#10;df[&quot;grade&quot;] = df[&quot;score&quot;].apply(lambda x: &quot;A&quot; if x &gt;= 90 else &quot;B&quot;)&#10;&#10;df[&quot;score_normalized&quot;] = (df[&quot;score&quot;] - df[&quot;score&quot;].mean()) / df[&quot;score&quot;].std()\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">adults </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df[df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"age\"</span><span style=\"color:#24292E;--shiki-da