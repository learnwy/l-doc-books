;    time.sleep(2)&#10;    return &quot;done&quot;&#10;&#10;async def main():&#10;    loop = asyncio.get_running_loop()&#10;    with ThreadPoolExecutor(max_workers=4) as pool:&#10;        result = await loop.run_in_executor(pool, sync_heavy_io)&#10;        print(result)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> asyncio</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> concurrent.futures </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ThreadPoolExecutor</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sync_heavy_io</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">():</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> time</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    time.sleep(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"done\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> main</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">():</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    loop </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> asyncio.get_running_loop()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ThreadPoolExecutor(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">max_workers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loop.run_in_executor(pool, sync_heavy_io)</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(result)</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>方案</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>CPU 密集型</td>\n<td>ProcessPoolExecutor</td>\n<td>绕过 GIL</td>\n</tr>\n<tr>\n<td>同步 I/O 库</td>\n<td>ThreadPoolExecutor</td>\n<td>如 PIL、旧版 DB 驱动</td>\n</tr>\n<tr>\n<td>纯异步库可用</td>\n<td>直接 await</td>\n<td>最佳方案</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"最佳实践\">最佳实践</h2><ul>\n<li>全局复用 <code>ClientSession</code> / 数据库连接池，避免频繁创建销毁</li>\n<li>优先选择原生异步驱动（asyncpg &gt; psycopg2 + executor）</li>\n<li>对无异步版本的库使用 <code>run_in_executor</code> 桥接</li>\n<li>使用 <code>async with</code> 确保资源（连接、文件句柄）正确关闭</li>\n<li>为 HTTP 请求设置合理的超时和重试策略</li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>异步的价值在 I/O 密集场景：把等待变成切换，前提是操作非阻塞。</li>\n<li>aiohttp 是异步 HTTP 主力，复用 <code>ClientSession</code> 才能启用连接池；httpx 提供同步/异步双模与 HTTP/2。</li>\n<li>异步数据库驱动按数据库选型：asyncpg（PostgreSQL）、aiomysql、aiosqlite、redis.asyncio、motor。</li>\n<li>aiofiles 用线程池包装同步文件操作，避免阻塞事件循环。</li>\n<li>异步上下文管理器与异步迭代器分别用 <code>async with</code> 与 <code>async for</code> 消费。</li>\n<li>同步库用 <code>run_in_executor</code> 桥接：I/O 阻塞用线程池，CPU 密集用进程池绕过 GIL。</li>\n</ul>\n","headings":[{"level":1,"text":"异步 IO 与网络","id":"异步-io-与网络"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"aiohttp 异步 HTTP","id":"aiohttp-异步-http"},{"level":3,"text":"客户端请求","id":"客户端请求"},{"level":3,"text":"复用 ClientSession","id":"复用-clientsession"},{"level":2,"text":"httpx：同步/异步双模","id":"httpx-同步-异步双模"},{"level":3,"text":"aiohttp vs httpx","id":"aiohttp-vs-httpx"},{"level":2,"text":"异步数据库驱动","id":"异步数据库驱动"},{"level":3,"text":"asyncpg（PostgreSQL）","id":"asyncpg-postgresql"},{"level":3,"text":"主流异步数据库驱动","id":"主流异步数据库驱动"},{"level":2,"text":"异步文件操作","id":"异步文件操作"},{"level":2,"text":"异步上下文管理器","id":"异步上下文管理器"},{"level":2,"text":"异步迭代器","id":"异步迭代器"},{"level":2,"text":"run_in_executor 桥接同步库","id":"run_in_executor-桥接同步库"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"协程与任务调度","url":"/l-doc-books/h/languages/python-advanced/async-programming/coroutines-and-tasks"},"next":{"title":"并发模式与最佳实践","url":"/l-doc-books/h/languages/python-advanced/async-programming/concurrency-patterns"}}