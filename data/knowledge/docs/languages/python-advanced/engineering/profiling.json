/td>\n<td>ThreadPoolExecutor</td>\n<td>GIL 在 I/O 时释放</td>\n</tr>\n<tr>\n<td>异步 I/O</td>\n<td>asyncio</td>\n<td>单线程高并发</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"c-扩展加速\">C 扩展加速</h2><h3 id=\"cython\">Cython</h3><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"def primes_python(nb_primes: int) -&gt; list[int]:&#10;    primes = []&#10;    n = 2&#10;    while len(primes) &lt; nb_primes:&#10;        for p in primes:&#10;            if n % p == 0:&#10;                break&#10;        else:&#10;            primes.append(n)&#10;        n += 1&#10;    return primes\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> primes_python</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(nb_primes: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) -> list[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    primes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(primes) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> nb_primes:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> primes:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">%</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                break</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            primes.append(n)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> primes</span></span></code></pre></div><h3 id=\"加速方案对比\">加速方案对比</h3><table>\n<thead>\n<tr>\n<th>方案</th>\n<th>加速比</th>\n<th>学习成本</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>NumPy</td>\n<td>10-100x</td>\n<td>低</td>\n<td>数组运算</td>\n</tr>\n<tr>\n<td>Cython</td>\n<td>10-50x</td>\n<td>中</td>\n<td>通用计算密集型</td>\n</tr>\n<tr>\n<td>Numba</td>\n<td>10-100x</td>\n<td>低</td>\n<td>数值计算（JIT）</td>\n</tr>\n<tr>\n<td>PyO3/Rust</td>\n<td>50-200x</td>\n<td>高</td>\n<td>极致性能需求</td>\n</tr>\n<tr>\n<td>C 扩展</td>\n<td>50-200x</td>\n<td>高</td>\n<td>底层系统交互</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"最佳实践\">最佳实践</h2><ul>\n<li>先用 cProfile 定位热点函数，再用 line_profiler 逐行分析</li>\n<li>优先优化算法复杂度（O(n²) → O(n log n)），再考虑底层加速</li>\n<li>生产环境使用 py-spy 进行零开销 profiling</li>\n<li>内存敏感场景使用生成器替代列表，使用 <code>__slots__</code> 减少对象开销</li>\n<li>避免过早优化——只在 profiler 证明是瓶颈时才优化</li>\n<li>使用 <code>func.cache_info()</code> 监控 lru_cache 命中率，据此调整 maxsize</li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>优化遵循&quot;先测量，后优化&quot;，用 profiler 定位真实瓶颈而非凭直觉。</li>\n<li>工具分层：cProfile（函数级）、line_profiler（行级）、py-spy（生产零开销采样）。</li>\n<li>内存分析用 memory_profiler，常见问题有大列表、循环引用、字符串拼接、缓存膨胀。</li>\n<li>优先降低算法复杂度，再考虑底层加速；数据结构选择直接影响复杂度数量级。</li>\n<li>并行方案按场景分：CPU 密集用进程池绕 GIL，I/O 密集用线程池，异步 I/O 用 asyncio。</li>\n<li>C 扩展加速的加速比：NumPy 与 Numba 性价比高，PyO3/Rust 与 C 扩展最快但成本高。</li>\n</ul>\n","headings":[{"level":1,"text":"性能分析与优化","id":"性能分析与优化"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"性能分析工具","id":"性能分析工具"},{"level":3,"text":"cProfile","id":"cprofile"},{"level":3,"text":"line_profiler","id":"line_profiler"},{"level":3,"text":"工具对比","id":"工具对比"},{"level":2,"text":"内存分析","id":"内存分析"},{"level":3,"text":"常见内存问题","id":"常见内存问题"},{"level":2,"text":"Python 级优化","id":"python-级优化"},{"level":3,"text":"数据结构选择","id":"数据结构选择"},{"level":3,"text":"常见优化技巧","id":"常见优化技巧"},{"level":2,"text":"并行与并发加速","id":"并行与并发加速"},{"level":2,"text":"C 扩展加速","id":"c-扩展加速"},{"level":3,"text":"Cython","id":"cython"},{"level":3,"text":"加速方案对比","id":"加速方案对比"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"测试框架 pytest","url":"/l-doc-books/h/languages/python-advanced/engineering/pytest"},"next":{"title":"ML Pipeline 与部署","url":"/l-doc-books/h/languages/python-advanced/engineering/ml-pipeline"}}