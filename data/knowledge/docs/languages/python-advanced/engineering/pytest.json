i-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">json</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=lambda</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ok\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fetch_data(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"https://api.com\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        assert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> result[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ok\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">is</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> True</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        mock_get.assert_called_once()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> test_env_var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(monkeypatch):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    monkeypatch.setenv(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"API_KEY\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"test-key-123\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    config </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> load_config()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    assert</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> config.api_key </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"test-key-123\"</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>unittest.mock</code></td>\n<td>替换对象和方法</td>\n<td>标准库，功能全面</td>\n</tr>\n<tr>\n<td><code>monkeypatch</code></td>\n<td>修改环境变量/属性</td>\n<td>pytest 内置</td>\n</tr>\n<tr>\n<td><code>responses</code></td>\n<td>Mock HTTP 请求</td>\n<td>requests 专用</td>\n</tr>\n<tr>\n<td><code>respx</code></td>\n<td>Mock HTTP 请求</td>\n<td>httpx 专用</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"测试覆盖率\">测试覆盖率</h2><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"pip install pytest-cov&#10;pytest --cov=src --cov-report=html --cov-report=term-missing\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pip</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> install</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> pytest-cov</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pytest</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --cov=src</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --cov-report=html</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --cov-report=term-missing</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"toml\" data-code=\"[tool.coverage.run]&#10;source = [&quot;src&quot;]&#10;omit = [&quot;*/tests/*&quot;]&#10;&#10;[tool.coverage.report]&#10;fail_under = 80&#10;show_missing = true\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>[tool.coverage.run]</span></span>\n<span class=\"line\"><span>source = [\"src\"]</span></span>\n<span class=\"line\"><span>omit = [\"*/tests/*\"]</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>[tool.coverage.report]</span></span>\n<span class=\"line\"><span>fail_under = 80</span></span>\n<span class=\"line\"><span>show_missing = true</span></span></code></pre></div><p>覆盖率报告中的 <code>term-missing</code> 选项会在终端直接显示未覆盖的行号，方便快速定位需要补充测试的代码路径。<code>html</code> 报告则提供可视化的源码标注视图，适合深入分析覆盖情况。建议同时使用 branch coverage（<code>--cov-branch</code>）来检测条件分支的覆盖完整性。</p>\n<hr>\n<h2 id=\"常用插件\">常用插件</h2><table>\n<thead>\n<tr>\n<th>插件</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>pytest-cov</td>\n<td>覆盖率报告</td>\n</tr>\n<tr>\n<td>pytest-asyncio</td>\n<td>异步测试支持</td>\n</tr>\n<tr>\n<td>pytest-xdist</td>\n<td>并行执行测试</td>\n</tr>\n<tr>\n<td>pytest-mock</td>\n<td>mock 简化</td>\n</tr>\n<tr>\n<td>pytest-benchmark</td>\n<td>性能基准测试</td>\n</tr>\n<tr>\n<td>pytest-snapshot</td>\n<td>快照测试</td>\n</tr>\n<tr>\n<td>pytest-randomly</td>\n<td>随机化测试顺序</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"测试组织策略\">测试组织策略</h2><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;  A[单元测试] --&gt; B[集成测试]&#10;  B --&gt; C[端到端测试]&#10;  A --&gt; D[快速反馈 &lt; 1s]&#10;  B --&gt; E[中等速度 &lt; 10s]&#10;  C --&gt; F[慢速 &gt; 10s]\">graph TD\n  A[单元测试] --&gt; B[集成测试]\n  B --&gt; C[端到端测试]\n  A --&gt; D[快速反馈 &lt; 1s]\n  B --&gt; E[中等速度 &lt; 10s]\n  C --&gt; F[慢速 &gt; 10s]</pre><table>\n<thead>\n<tr>\n<th>层级</th>\n<th>关注点</th>\n<th>运行频率</th>\n<th>覆盖目标</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单元测试</td>\n<td>单个函数/类</td>\n<td>每次提交</td>\n<td>&gt;80%</td>\n</tr>\n<tr>\n<td>集成测试</td>\n<td>模块间交互</td>\n<td>每次 PR</td>\n<td>关键路径</td>\n</tr>\n<tr>\n<td>端到端测试</td>\n<td>完整业务流程</td>\n<td>每日/发布前</td>\n<td>核心场景</td>\n</tr>\n</tbody></table>\n<hr>\n<h2 id=\"最佳实践\">最佳实践</h2><ul>\n<li>测试文件与源码目录结构镜像：<code>src/core.py</code> → <code>tests/test_core.py</code></li>\n<li>使用 fixture 替代测试中的重复 setup 代码</li>\n<li>参数化测试覆盖边界条件：空值、负数、超大输入</li>\n<li>设置覆盖率门禁（如 80%），在 CI 中强制执行</li>\n<li>使用 <code>pytest-xdist</code> 并行执行加速大型测试套件</li>\n<li>使用 <code>--cov-branch</code> 检测条件分支覆盖，避免遗漏边界路径</li>\n</ul>\n<hr>\n<h2 id=\"小结\">小结</h2><ul>\n<li>pytest 以原生 <code>assert</code>、fixture 依赖注入、参数化测试三大机制简化测试编写。</li>\n<li>AST 重写让断言失败时自动展开中间值，无需手写错误消息。</li>\n<li>fixture 用 <code>yield</code> 划分 setup / teardown，作用域可为 function / class / module / session。</li>\n<li><code>@parametrize</code> 叠加产生笛卡尔积，适合测试矩阵组合；覆盖边界条件。</li>\n<li>Mock 与 monkeypatch 分别处理对象替换与环境变量/属性修改。</li>\n<li>测试分层：单元（每次提交）→ 集成（每次 PR）→ 端到端（发布前），并设置覆盖率门禁。</li>\n</ul>\n","headings":[{"level":1,"text":"测试框架 pytest","id":"测试框架-pytest"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"基本用法","id":"基本用法"},{"level":2,"text":"Fixture 依赖注入","id":"fixture-依赖注入"},{"level":3,"text":"Fixture 作用域","id":"fixture-作用域"},{"level":2,"text":"参数化测试","id":"参数化测试"},{"level":2,"text":"异常与警告测试","id":"异常与警告测试"},{"level":2,"text":"Mock 与 monkeypatch","id":"mock-与-monkeypatch"},{"level":2,"text":"测试覆盖率","id":"测试覆盖率"},{"level":2,"text":"常用插件","id":"常用插件"},{"level":2,"text":"测试组织策略","id":"测试组织策略"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"项目结构与包管理","url":"/l-doc-books/h/languages/python-advanced/engineering/project-structure"},"next":{"title":"性能分析与优化","url":"/l-doc-books/h/languages/python-advanced/engineering/profiling"}}