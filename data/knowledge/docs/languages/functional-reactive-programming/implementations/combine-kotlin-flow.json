style=\"color:#24292E;--shiki-dark:#E1E4E8\">([]) }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            .</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">eraseToAnyPublisher</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"kotlin-flow-冷流与热流\">Kotlin Flow 冷流与热流</h2><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// 冷流（Cold Flow）：每次 collect 独立执行&#10;fun coldNumbers(): Flow&lt;Int&gt; = flow {&#10;    println(&quot;开始生成&quot;)&#10;    for (i in 1..5) {&#10;        delay(100)&#10;        emit(i)&#10;    }&#10;}&#10;&#10;// 热流（Hot Flow）：SharedFlow&#10;val sharedFlow = MutableSharedFlow&lt;Int&gt;(&#10;    replay = 2,         // 新订阅者收到最近 2 个历史值&#10;    extraBufferCapacity = 10  // 额外缓冲&#10;)&#10;&#10;// SharedFlow 作为事件总线&#10;class EventBus {&#10;    private val _events = MutableSharedFlow&lt;AppEvent&gt;()&#10;    val events = _events.asSharedFlow()&#10;&#10;    suspend fun emit(event: AppEvent) = _events.emit(event)&#10;}&#10;&#10;// StateFlow（对应 BehaviorSubject / CurrentValueSubject）&#10;val stateFlow = MutableStateFlow(0)  // 初始值 0&#10;println(stateFlow.value)  // 同步读取当前值&#10;&#10;// 在 ViewModel 中使用（Android）&#10;class CounterViewModel : ViewModel() {&#10;    private val _count = MutableStateFlow(0)&#10;    val count: StateFlow&lt;Int&gt; = _count.asStateFlow()&#10;&#10;    fun increment() { _count.value++ }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// 冷流（Cold Flow）：每次 collect 独立执行</span></span>\n<span class=\"line\"><span>fun coldNumbers(): Flow&#x3C;Int> = flow {</span></span>\n<span class=\"line\"><span>    println(\"开始生成\")</span></span>\n<span class=\"line\"><span>    for (i in 1..5) {</span></span>\n<span class=\"line\"><span>        delay(100)</span></span>\n<span class=\"line\"><span>        emit(i)</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 热流（Hot Flow）：SharedFlow</span></span>\n<span class=\"line\"><span>val sharedFlow = MutableSharedFlow&#x3C;Int>(</span></span>\n<span class=\"line\"><span>    replay = 2,         // 新订阅者收到最近 2 个历史值</span></span>\n<span class=\"line\"><span>    extraBufferCapacity = 10  // 额外缓冲</span></span>\n<span class=\"line\"><span>)</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// SharedFlow 作为事件总线</span></span>\n<span class=\"line\"><span>class EventBus {</span></span>\n<span class=\"line\"><span>    private val _events = MutableSharedFlow&#x3C;AppEvent>()</span></span>\n<span class=\"line\"><span>    val events = _events.asSharedFlow()</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    suspend fun emit(event: AppEvent) = _events.emit(event)</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// StateFlow（对应 BehaviorSubject / CurrentValueSubject）</span></span>\n<span class=\"line\"><span>val stateFlow = MutableStateFlow(0)  // 初始值 0</span></span>\n<span class=\"line\"><span>println(stateFlow.value)  // 同步读取当前值</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 在 ViewModel 中使用（Android）</span></span>\n<span class=\"line\"><span>class CounterViewModel : ViewModel() {</span></span>\n<span class=\"line\"><span>    private val _count = MutableStateFlow(0)</span></span>\n<span class=\"line\"><span>    val count: StateFlow&#x3C;Int> = _count.asStateFlow()</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>    fun increment() { _count.value++ }</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"kotlin-flow-的线程切换-flowon\">Kotlin Flow 的线程切换：flowOn</h2><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// flowOn 指定 Flow 的生产端（上游）在哪个线程运行&#10;// 消费端的线程由 collect 所在的协程决定&#10;&#10;fun fetchData(): Flow&lt;Data&gt; = flow {&#10;    // 这段代码在 IO 线程执行&#10;    val data = database.query()  // 阻塞 I/O&#10;    emit(data)&#10;}&#10;.flowOn(Dispatchers.IO)  // 上游在 IO 调度器&#10;&#10;// collect 在 UI 线程（因为 viewModelScope 在主线程）&#10;viewModelScope.launch {&#10;    fetchData()&#10;        .map { it.transform() }  // 这个 map 在哪？取决于上下文&#10;        // flowOn 只影响它&quot;上游&quot;的操作符&#10;        .flowOn(Dispatchers.Default)  // transform() 在 Default&#10;        .collect { data -&gt;&#10;            // collect 在 viewModelScope 的线程（主线程）&#10;            updateUI(data)&#10;        }&#10;}&#10;&#10;// 与 RxJS observeOn/subscribeOn 的类比&#10;// flowOn    ≈ subscribeOn（影响上游）&#10;// withContext 在 collect 内 ≈ observeOn（影响消费）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// flowOn 指定 Flow 的生产端（上游）在哪个线程运行</span></span>\n<span class=\"line\"><span>// 消费端的线程由 collect 所在的协程决定</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>fun fetchData(): Flow&#x3C;Data> = flow {</span></span>\n<span class=\"line\"><span>    // 这段代码在 IO 线程执行</span></span>\n<span class=\"line\"><span>    val data = database.query()  // 阻塞 I/O</span></span>\n<span class=\"line\"><span>    emit(data)</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span>.flowOn(Dispatchers.IO)  // 上游在 IO 调度器</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// collect 在 UI 线程（因为 viewModelScope 在主线程）</span></span>\n<span class=\"line\"><span>viewModelScope.launch {</span></span>\n<span class=\"line\"><span>    fetchData()</span></span>\n<span class=\"line\"><span>        .map { it.transform() }  // 这个 map 在哪？取决于上下文</span></span>\n<span class=\"line\"><span>        // flowOn 只影响它\"上游\"的操作符</span></span>\n<span class=\"line\"><span>        .flowOn(Dispatchers.Default)  // transform() 在 Default</span></span>\n<span class=\"line\"><span>        .collect { data -></span></span>\n<span class=\"line\"><span>            // collect 在 viewModelScope 的线程（主线程）</span></span>\n<span class=\"line\"><span>            updateUI(data)</span></span>\n<span class=\"line\"><span>        }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// 与 RxJS observeOn/subscribeOn 的类比</span></span>\n<span class=\"line\"><span>// flowOn    ≈ subscribeOn（影响上游）</span></span>\n<span class=\"line\"><span>// withContext 在 collect 内 ≈ observeOn（影响消费）</span></span></code></pre></div><h2 id=\"背压对比\">背压对比</h2><div class=\"code-block-wrapper\" data-lang=\"swift\" data-code=\"// Combine 的显式背压（通过 Demand）&#10;class LimitedSubscriber: Subscriber {&#10;    typealias Input = Int&#10;    typealias Failure = Never&#10;&#10;    func receive(subscription: Subscription) {&#10;        subscription.request(.max(3))  // 只请求 3 个&#10;    }&#10;&#10;    func receive(_ input: Int) -&gt; Subscribers.Demand {&#10;        print(&quot;收到: \\(input)&quot;)&#10;        return .max(1)  // 每处理一个再请求一个&#10;    }&#10;&#10;    func receive(completion: Subscribers.Completion&lt;Never&gt;) {}&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Combine 的显式背压（通过 Demand）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F