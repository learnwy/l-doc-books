y) =&gt; search(query));&#10;&#10;// throttleTime（节流，每 N ms 最多一次）&#10;scrollEvents$&#10;  .pipe(&#10;    throttleTime(100), // 每 100ms 最多处理一次滚动&#10;  )&#10;  .subscribe((pos) =&gt; updateView(pos));&#10;&#10;// throttleTime vs auditTime vs sampleTime 的区别&#10;// throttleTime: 时间窗口开始时取值（leading edge）&#10;// auditTime:    时间窗口结束时取最新值（trailing edge）&#10;// sampleTime:   按固定间隔采样（无论是否有新值）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// RxJS: debounceTime（防抖，最后一次后等待）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">searchInput$</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pipe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    debounceTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">300</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 停止输入 300ms 后才发出</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">subscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">query</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> search</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(query));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// throttleTime（节流，每 N ms 最多一次）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">scrollEvents$</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pipe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    throttleTime</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 每 100ms 最多处理一次滚动</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">subscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pos</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> updateView</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pos));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// throttleTime vs auditTime vs sampleTime 的区别</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// throttleTime: 时间窗口开始时取值（leading edge）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// auditTime:    时间窗口结束时取最新值（trailing edge）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// sampleTime:   按固定间隔采样（无论是否有新值）</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// Reactor: delayElements（固定速率）&#10;Flux&lt;Event&gt; rateLimited = events&#10;    .delayElements(Duration.ofMillis(100))  // 每个元素至少间隔 100ms&#10;&#10;// 令牌桶限速（结合 Reactor + Resilience4j）&#10;RateLimiter rateLimiter = RateLimiter.of(&quot;api&quot;,&#10;    RateLimiterConfig.custom()&#10;        .limitRefreshPeriod(Duration.ofSeconds(1))&#10;        .limitForPeriod(10)  // 每秒最多 10 次&#10;        .build());&#10;&#10;Flux&lt;Response&gt; rateLimitedApi = requests&#10;    .flatMap(req -&gt;&#10;        Mono.fromCallable(() -&gt; rateLimiter.acquirePermission())&#10;            .flatMap(permitted -&gt; callApi(req))&#10;    );\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Reactor: delayElements（固定速率）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Flux&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> rateLimited </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> events</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">delayElements</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Duration.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ofMillis</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 每个元素至少间隔 100ms</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 令牌桶限速（结合 Reactor + Resilience4j）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">RateLimiter rateLimiter </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> RateLimiter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"api\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    RateLimiterConfig.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">custom</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">limitRefreshPeriod</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Duration.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ofSeconds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">limitForPeriod</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 每秒最多 10 次</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Flux&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Response</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> rateLimitedApi </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requests</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(req </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Mono.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fromCallable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rateLimiter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">acquirePermission</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(permitted </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> callApi</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(req))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    );</span></span></code></pre></div><h2 id=\"小结\">小结</h2><ul>\n<li><strong>Buffer</strong>：最安全（无数据丢失）但内存风险最高；必须设置上界和溢出策略，避免 OOM</li>\n<li><strong>Drop</strong>：新数据被丢弃，适合幂等、可重发的事件；需监控丢弃率</li>\n<li><strong>Latest/conflate</strong>：只保留最新值，是 UI 状态更新和传感器数据的理想策略</li>\n<li><strong>Request-based</strong>：最精确的协作背压，Subscriber 按实际处理能力拉取；<code>limitRate</code> 是 Reactor 的便捷封装</li>\n<li><strong>Rate-limit</strong>：在源头节流，<code>debounceTime</code>（防抖）和 <code>throttleTime</code>（节流）是最常用形式</li>\n</ul>\n<pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((背压策略))&#10;    Buffer&#10;      有界缓冲&#10;      溢出策略&#10;      DROP_OLDEST/LATEST&#10;    Drop&#10;      丢弃新数据&#10;      监控丢弃率&#10;    Latest&#10;      只保最新值&#10;      conflate&#10;      UI状态更新&#10;    Request-based&#10;      协作拉取&#10;      limitRate&#10;      动态需求&#10;    Rate-limit&#10;      debounceTime&#10;      throttleTime&#10;      令牌桶\">mindmap\n  root((背压策略))\n    Buffer\n      有界缓冲\n      溢出策略\n      DROP_OLDEST/LATEST\n    Drop\n      丢弃新数据\n      监控丢弃率\n    Latest\n      只保最新值\n      conflate\n      UI状态更新\n    Request-based\n      协作拉取\n      limitRate\n      动态需求\n    Rate-limit\n      debounceTime\n      throttleTime\n      令牌桶</pre>","headings":[{"level":1,"text":"背压策略","id":"背压策略"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Buffer 策略","id":"buffer-策略"},{"level":2,"text":"Drop 策略","id":"drop-策略"},{"level":2,"text":"Latest 策略","id":"latest-策略"},{"level":2,"text":"Request-based 协作背压","id":"request-based-协作背压"},{"level":2,"text":"Rate-limit 限速策略","id":"rate-limit-限速策略"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Combine 与 Kotlin Flow","url":"/l-doc-books/h/languages/functional-reactive-programming/implementations/combine-kotlin-flow"},"next":{"title":"错误处理与容错","url":"/l-doc-books/h/languages/functional-reactive-programming/patterns/error-handling-resilience"}}