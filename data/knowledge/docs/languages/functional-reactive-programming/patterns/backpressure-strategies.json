-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Reactor: onBackpressureDrop</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Flux&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SensorData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> sensorStream </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Flux.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">create</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(sink </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sensor.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setListener</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sink.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(data));  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 传感器推送</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}, FluxSink.OverflowStrategy.DROP);  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 内部队列满后丢弃新数据</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Flux&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SensorData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> processed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sensorStream</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onBackpressureDrop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(dropped </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        metrics.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">increment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sensor.data.dropped\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 监控丢弃量</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    )</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onBackpressureDrop</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 不带回调的简版</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Kotlin Flow: DROP 语义（通过 buffer 的 BufferOverflow.DROP_LATEST）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kotlinx.coroutines.flow.buffer</span></span>\n<span class=\"line\"><span style=\"color:#B31D28;--shiki-light-font-style:italic;--shiki-dark:#FDAEB7;--shiki-dark-font-style:italic\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> kotlinx.coroutines.channels.Channel</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">sensorFlow</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .buffer(capacity = </span><span style=\"color:#B31D28;--shiki-light-font-style:italic;--shiki-dark:#FDAEB7;--shiki-dark-font-style:italic\">64</