op vs onBackpressureLatest</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// DROP:   [1,2,3,4,5] 缓冲满后新的 6,7,8 被丢弃 → 消费者处理 1,2,3,4,5</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// LATEST: [1,2,3,4,5] 下次只给 5（最新），跳过 1,2,3,4 → 消费者处理 5</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// Kotlin Flow: conflate() = onBackpressureLatest 等价&#10;sensorFlow&#10;    .conflate()  // 处理慢时只保留最新值&#10;    .collect { data -&gt;&#10;        delay(500)  // 慢消费者，每 500ms 处理一个&#10;        displayData(data)  // 总是显示最新数据&#10;    }\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// Kotlin Flow: conflate() = onBackpressureLatest 等价</span></span>\n<span class=\"line\"><span>sensorFlow</span></span>\n<span class=\"line\"><span>    .conflate()  // 处理慢时只保留最新值</span></span>\n<span class=\"line\"><span>    .collect { data -></span></span>\n<span class=\"line\"><span>        delay(500)  // 慢消费者，每 500ms 处理一个</span></span>\n<span class=\"line\"><span>        displayData(data)  // 总是显示最新数据</span></span>\n<span class=\"line\"><span>    }</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// RxJS: auditTime / sampleTime（取时间窗口内最新值）&#10;mouseMove$&#10;  .pipe(&#10;    auditTime(16), // 每 16ms 取最新位置（约 60fps）&#10;  )&#10;  .subscribe((pos) =&gt; renderCursor(pos));&#10;&#10;// throttleTime with trailing = Latest 语义&#10;mouseMove$.pipe(throttleTime(16, undefined, { leading: false, trailing: true })).subscribe((pos) =&gt; renderCursor(pos));\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\