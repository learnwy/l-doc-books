iki-dark:#E1E4E8\"> rows_; }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cols</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cols_; }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">private:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rows_, cols_;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    std</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::vector</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;double></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> data_;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">PYBIND11_MODULE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(mymodule, m) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    py</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">class_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Matrix</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(m, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Matrix\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">def</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">py</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">init</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>())</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">def</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"at\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Matrix</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::at)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">def_property_readonly</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rows\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Matrix</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::rows)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">def_property_readonly</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"cols\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x26;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Matrix</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">::cols);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>pybind11 的核心优势是对 C++ 特性的深度支持：类继承、虚函数、模板、智能指针、STL 容器自动转换（<code>std::vector</code> ↔ Python list，<code>std::map</code> ↔ Python dict，<code>std::optional</code> ↔ Python <code>Optional</code>）、NumPy 数组的零拷贝视图、函数重载、默认参数、lambda 表达式。</p>\n<p>pybind11 2.12+（2025 年更新）引入了对 Python 3.13 有限 C API 的原生支持，在不损失性能的前提下提高了跨 Python 版本的兼容性。新的 <code>py::array</code> 优化将常见数组形状的 NumPy 转换开销降低了约 20%。在 2025 年的基准测试中，pybind11 对于 C++ 后端的扩展实现了原生 C++ 速度的 91%——开销主要限于 Python/C++ 边界处的对象转换。</p>\n<p>pybind11 的劣势是编译时间较长（模板元编程的代价）、编译错误信息极其冗长（一个简单的类型错误可能产生几百行的模板实例化回溯）。对于大型 C++ 库的绑定，推荐使用 <code>bind11</code> 的「分拆编译」（split compilation）技术来改善编译时间。</p>\n<h2 id=\"四种扩展方式的对比\">四种扩展方式的对比</h2><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>CPython C API</th>\n<th>Cython</th>\n<th>cffi</th>\n<th>pybind11</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>目标语言</td>\n<td>C</td>\n<td>Cython (Python超集)</td>\n<td>C 声明</td>\n<td>C++</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>陡峭</td>\n<td>平缓</td>\n<td>平缓</td>\n<td>中等</td>\n</tr>\n<tr>\n<td>性能</td>\n<td>最高</td>\n<td>接近 C</td>\n<td>略低</td>\n<td>接近 C++</td>\n</tr>\n<tr>\n<td>C++ 支持</td>\n<td>需要手写包装</td>\n<td>有限</td>\n<td>有限</td>\n<td>原生深度支持</td>\n</tr>\n<tr>\n<td>NumPy 集成</td>\n<td>手动</td>\n<td>原生</td>\n<td>手动</td>\n<td>通过 py::array</td>\n</tr>\n<tr>\n<td>编译要求</td>\n<td>需要</td>\n<td>需要</td>\n<td>ABI 模式不需要</td>\n<td>需要</td>\n</tr>\n<tr>\n<td>调试难度</td>\n<td>高</td>\n<td>中等</td>\n<td>低</td>\n<td>高</td>\n</tr>\n<tr>\n<td>跨 Python 版本</td>\n<td>有限 API 可兼容</td>\n<td>通常需重编译</td>\n<td>ABI 模式兼容</td>\n<td>有限 API 可兼容</td>\n</tr>\n<tr>\n<td>典型场景</td>\n<td>解释器扩展</td>\n<td>数值计算加速</td>\n<td>C 库快速包装</td>\n<td>C++ 库绑定</td>\n</tr>\n</tbody></table>\n<p>选择哪种方式取决于你的具体需求。如果你的核心代码已经是 C++，pybind11 是最自然的选择。如果你要从零开始编写计算密集的代码且团队熟悉 Python，Cython 提供了最佳的开发效率/性能比。如果你只是需要调用一个已有的 C 库且不想引入编译步骤，cffi ABI 模式是最快捷的方式。如果你需要最深层次的解释器集成（比如实现新的内置类型），CPython C API 是唯一的选择。</p>\n<h2 id=\"gil-与多线程扩展\">GIL 与多线程扩展</h2><p>Python 的全局解释器锁（GIL）是 C 扩展中必须理解的概念。GIL 确保同一时刻只有一个线程执行 Python 字节码——这简化了 CPython 的内存管理（不需要线程安全的引用计数操作），但也限制了 CPU 密集型 Python 代码的多线程扩展性。</p>\n<p>C 扩展可以在不需要 Python API 的代码段中释放 GIL，让其他 Python 线程获得执行机会。在 CPython C API 中，使用 <code>Py_BEGIN_ALLOW_THREADS</code> 和 <code>Py_END_ALLOW_THREADS</code> 宏来标记不需要 GIL 的代码段。在 Cython 中，使用 <code>with nogil:</code> 上下文管理器。在 pybind11 中，使用 <code>py::call_guard&lt;py::gil_scoped_release&gt;()</code> 或在函数注册时指定 <code>py::call_guard</code>。</p>\n<p>释放 GIL 时有一条铁律：在 GIL 释放期间，绝不能调用任何 Python C API 函数或操作任何 <code>PyObject*</code>。违反这条规则会导致解释器崩溃。一个安全的模式是：在进入 C 扩展时立即将 Python 参数转换为原生 C 类型（复制数据），然后释放 GIL 执行计算密集的原生代码，计算完成后重新获取 GIL 并将结果构造为 Python 对象返回。</p>\n<p>Python 3.13 引入的自由线程模式（no-GIL 构建）从根本上改变了这一格局。在无 GIL 的 Python 中，扩展模块需要确保自身的线程安全性——引用计数操作变成原子操作，全局状态需要适当的同步机制。这对现有 C 扩展的兼容性提出了挑战，但也为真正的多线程并行打开了大门。截至 2025 年中，Cython 3.2+ 和 pybind11 2.12+ 已经提供了对自由线程模式的优化支持，而 cffi 的支持仍处于初步阶段。</p>\n<h2 id=\"小结\">小结</h2><p>Python 的 C 扩展生态提供了从底层到高层的完整技术谱系。核心要点包括：</p>\n<ul>\n<li>CPython C API 是最底层的扩展方式，提供完全控制权但开发成本高</li>\n<li>Cython 用 Python 超集语法编写编译型代码，是科学计算生态的基石</li>\n<li>cffi 提供最简洁的 C 库包装方式，ABI 模式无需编译</li>\n<li>pybind11 是 C++ 绑定的现代选择，深度支持 C++ 特性和 STL 容器</li>\n<li>GIL 管理是多线程扩展的关键：在纯计算段释放 GIL，在操作 Python 对象时持有 GIL</li>\n<li>Python 3.13 的有限 C API 和自由线程模式正在改变扩展模块的兼容性和性能格局</li>\n</ul>\n<p>截至 2025 年，四种工具在性能上的差距已经缩小——Cython 可达原生 C 的 94%，pybind11 达 91%，cffi API 模式达 88%（来源：2025 Q1 Python Performance Benchmark Suite）。选择工具时，开发效率、团队技能栈、目标语言（C vs C++）往往比微小的性能差异更重要。</p>\n","headings":[{"level":1,"text":"Python扩展与C API","id":"python扩展与c-api"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"CPython C API：底层扩展","id":"cpython-c-api-底层扩展"},{"level":2,"text":"Cython：Python 语法的编译扩展","id":"cython-python-语法的编译扩展"},{"level":2,"text":"cffi：简洁的 C 库包装","id":"cffi-简洁的-c-库包装"},{"level":2,"text":"pybind11：C++ 绑定的现代选择","id":"pybind11-c-绑定的现代选择"},{"level":2,"text":"四种扩展方式的对比","id":"四种扩展方式的对比"},{"level":2,"text":"GIL 与多线程扩展","id":"gil-与多线程扩展"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Rust/C/C++互操作","url":"/l-doc-books/h/languages/language-interop-ffi/mainstream-ffi-practice/rust-c-cpp-interop"},"next":{"title":"Java/JNI与Panama","url":"/l-doc-books/h/languages/language-interop-ffi/mainstream-ffi-practice/java-jni-panama"}}