FF\">list(value = \"¥1,234,567\", color = \"success\")</span></span></code></pre></div><h2 id=\"表格输出\">表格输出</h2><table>\n<thead>\n<tr>\n<th>包</th>\n<th>输出类型</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>knitr::kable()</code></td>\n<td>基础表格</td>\n<td>简单展示</td>\n</tr>\n<tr>\n<td><code>kableExtra</code></td>\n<td>增强表格</td>\n<td>合并单元格、条件格式</td>\n</tr>\n<tr>\n<td><code>gt</code></td>\n<td>现代表格</td>\n<td>复杂格式、HTML/PDF</td>\n</tr>\n<tr>\n<td><code>DT::datatable()</code></td>\n<td>交互表格</td>\n<td>HTML 报告</td>\n</tr>\n<tr>\n<td><code>flextable</code></td>\n<td>Word 友好</td>\n<td>Word/PowerPoint 输出</td>\n</tr>\n<tr>\n<td><code>huxtable</code></td>\n<td>跨格式</td>\n<td>统一 API</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"r\" data-code=\"#| label: tbl-results&#10;#| tbl-cap: &quot;模型比较结果&quot;&#10;&#10;library(gt)&#10;&#10;results_df |&gt;&#10;  gt() |&gt;&#10;  tab_header(title = &quot;模型性能比较&quot;) |&gt;&#10;  fmt_number(columns = c(AIC, BIC), decimals = 1) |&gt;&#10;  fmt_number(columns = R2, decimals = 3) |&gt;&#10;  tab_style(&#10;    style = cell_fill(color = &quot;#E8F5E9&quot;),&#10;    locations = cells_body(rows = R2 == max(R2))&#10;  )\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>#| label: tbl-results</span></span>\n<span class=\"line\"><span>#| tbl-cap: \"模型比较结果\"</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>library(gt)</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>results_df |></span></span>\n<span class=\"line\"><span>  gt() |></span></span>\n<span class=\"line\"><span>  tab_header(title = \"模型性能比较\") |></span></span>\n<span class=\"line\"><span>  fmt_number(columns = c(AIC, BIC), decimals = 1) |></span></span>\n<span class=\"line\"><span>  fmt_number(columns = R2, decimals = 3) |></span></span>\n<span class=\"line\"><span>  tab_style(</span></span>\n<span class=\"line\"><span>    style = cell_fill(color = \"#E8F5E9\"),</span></span>\n<span class=\"line\"><span>    locations = cells_body(rows = R2 == max(R2))</span></span>\n<span class=\"line\"><span>  )</span></span></code></pre></div><h2 id=\"发布与协作\">发布与协作</h2><div class=\"code-block-wrapper\" data-lang=\"r\" data-code=\"# 发布到 Quarto Pub（免费）&#10;# 终端运行：quarto publish quarto-pub&#10;&#10;# 发布到 Posit Connect&#10;# 终端运行：quarto publish connect&#10;&#10;# 发布到 GitHub Pages&#10;# 终端运行：quarto publish gh-pages&#10;&#10;# 发布到 Confluence&#10;# 终端运行：quarto publish confluence\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span># 发布到 Quarto Pub（免费）</span></span>\n<span class=\"line\"><span># 终端运行：quarto publish quarto-pub</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># 发布到 Posit Connect</span></span>\n<span class=\"line\"><span># 终端运行：quarto publish connect</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># 发布到 GitHub Pages</span></span>\n<span class=\"line\"><span># 终端运行：quarto publish gh-pages</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># 发布到 Confluence</span></span>\n<span class=\"line\"><span># 终端运行：quarto publish confluence</span></span></code></pre></div><h3 id=\"ci-cd-集成\">CI/CD 集成</h3><p>GitHub Actions 自动渲染和部署：</p>\n<p><code>.github/workflows/publish.yml</code>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"on:&#10;  push:&#10;    branches: main&#10;&#10;jobs:&#10;  build-deploy:&#10;    runs-on: ubuntu-latest&#10;    steps:&#10;      - uses: actions/checkout@v4&#10;      - uses: quarto-dev/quarto-actions/setup@v2&#10;      - uses: r-lib/actions/setup-r@v2&#10;      - run: quarto render&#10;      - uses: quarto-dev/quarto-actions/publish@v2&#10;        with:&#10;          target: gh-pages\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    branches</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">main</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">jobs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  build-deploy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/checkout@v4</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">quarto-dev/quarto-actions/setup@v2</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">r-lib/actions/setup-r@v2</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">quarto render</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">quarto-dev/quarto-actions/publish@v2</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          target</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">gh-pages</span></span></code></pre></div><h2 id=\"从-r-markdown-迁移\">从 R Markdown 迁移</h2><p>大多数 .Rmd 文件可直接由 Quarto 渲染（仅改扩展名为 .qmd）。主要语法变化：</p>\n<p>R Markdown 使用 chunk 选项行内写法：<code>{r fig.width=8, fig.height=6, echo=FALSE}</code>。Quarto 等价写法使用 <code>#|</code> 前缀的 YAML 式选项：</p>\n<div class=\"code-block-wrapper\" data-lang=\"r\" data-code=\"#| fig-width: 8&#10;#| fig-height: 6&#10;#| echo: false&#10;&#10;plot(x, y)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>#| fig-width: 8</span></span>\n<span class=\"line\"><span>#| fig-height: 6</span></span>\n<span class=\"line\"><span>#| echo: false</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>plot(x, y)</span></span></code></pre></div><p>对于交互式应用场景，<a href=\"shiny-interactive-apps\">Shiny 交互式应用</a>提供了实时响应式计算；Quarto 的 Dashboard 格式是 Shiny 的轻量替代——不需要服务器端进程，但牺牲了实时交互能力。报告中涉及的统计模型可参考<a href=\"../statistical-computing/statistical-modeling-r\">R 统计建模</a>的公式接口。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Quarto 继承了 R Markdown 的可复现理念，但用统一配置、多语言支持和原生交叉引用补齐了工程性短板。</li>\n<li>新项目选 Quarto，既有 R Markdown 文档无需迁移是当前最务实的策略。</li>\n<li><code>#|</code> 块选项与 YAML 头部配置是日常写作中最常打交道的两处语法。</li>\n<li>交叉引用把&quot;图表编号&quot;从手工维护变成由标签自动解析。</li>\n<li>参数化报告 + <code>quarto_render()</code> 批量调用是周期性报告自动化的标准方案。</li>\n<li>表格输出包的选择取决于目标格式：HTML 用 DT，Word 用 flextable，复杂排版用 gt。</li>\n<li>发布与 CI/CD 由 <code>quarto publish</code> 与 GitHub Actions 承担，渲染与部署可以完全自动化。</li>\n</ul>\n","headings":[{"level":1,"text":"R Markdown 与 Quarto 报告","id":"r-markdown-与-quarto-报告"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Quarto vs R Markdown 决策","id":"quarto-vs-r-markdown-决策"},{"level":2,"text":"Quarto 文档结构","id":"quarto-文档结构"},{"level":3,"text":"基础文档","id":"基础文档"},{"level":3,"text":"交叉引用","id":"交叉引用"},{"level":2,"text":"多格式输出","id":"多格式输出"},{"level":3,"text":"HTML 报告","id":"html-报告"},{"level":3,"text":"PDF 报告（学术论文）","id":"pdf-报告-学术论文"},{"level":3,"text":"Typst（轻量 PDF 替代）","id":"typst-轻量-pdf-替代"},{"level":2,"text":"参数化报告","id":"参数化报告"},{"level":2,"text":"项目类型","id":"项目类型"},{"level":3,"text":"Quarto 网站","id":"quarto-网站"},{"level":3,"text":"Quarto 书籍","id":"quarto-书籍"},{"level":3,"text":"Quarto Dashboard（1.4+）","id":"quarto-dashboard-1-4"},{"level":2,"text":"表格输出","id":"表格输出"},{"level":2,"text":"发布与协作","id":"发布与协作"},{"level":3,"text":"CI/CD 集成","id":"ci-cd-集成"},{"level":2,"text":"从 R Markdown 迁移","id":"从-r-markdown-迁移"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Shiny 交互式应用","url":"/l-doc-books/h/languages/r-language-data-analysis/applications/shiny-interactive-apps"},"next":{"title":"R 性能优化与大数据","url":"/l-doc-books/h/languages/r-language-data-analysis/applications/r-performance-scaling"}}