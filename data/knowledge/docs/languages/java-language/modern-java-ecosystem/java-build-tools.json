lor:#22863A;--shiki-dark:#85E89D\">version</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            &#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">dependency</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        &#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">dependencies</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    &#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">dependencyManagement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">project</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span></code></pre></div><p><strong>Gradle 多模块</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// settings.gradle.kts&#10;rootProject.name = &quot;platform&quot;&#10;include(&quot;common&quot;, &quot;order-service&quot;, &quot;user-service&quot;)&#10;&#10;// buildSrc/src/main/kotlin/java-conventions.gradle.kts&#10;plugins {&#10;    java&#10;}&#10;&#10;java {&#10;    toolchain {&#10;        languageVersion = JavaLanguageVersion.of(21)&#10;    }&#10;}&#10;&#10;// order-service/build.gradle.kts&#10;plugins {&#10;    id(&quot;java-conventions&quot;)&#10;}&#10;dependencies {&#10;    implementation(project(&quot;:common&quot;))&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// settings.gradle.kts</span></span>\n<span class=\"line\"><span>rootProject.name = \"platform\"</span></span>\n<span class=\"line\"><span>include(\"common\", \"order-service\", \"user-service\")</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// buildSrc/src/main/kotlin/java-conventions.gradle.kts</span></span>\n<span class=\"line\"><span>plugins {</span></span>\n<span class=\"line\"><span>    java</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>java {</span></span>\n<span class=\"line\"><span>    toolchain {</span></span>\n<span class=\"line\"><span>        languageVersion = JavaLanguageVersion.of(21)</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// order-service/build.gradle.kts</span></span>\n<span class=\"line\"><span>plugins {</span></span>\n<span class=\"line\"><span>    id(\"java-conventions\")</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span>dependencies {</span></span>\n<span class=\"line\"><span>    implementation(project(\":common\"))</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><h2 id=\"依赖冲突解决\">依赖冲突解决</h2><p>依赖冲突是构建工具最常见的问题之一——不同库依赖了同一个库的不同版本：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# Maven：查看依赖树&#10;mvn dependency:tree&#10;# Maven 策略：最近优先（nearest wins）&#10;&#10;# Gradle：查看依赖树&#10;gradle dependencies --configuration runtimeClasspath&#10;# Gradle 策略：最新版本优先（newest wins）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Maven：查看依赖树</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">mvn</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> dependency:tree</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Maven 策略：最近优先（nearest wins）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Gradle：查看依赖树</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">gradle</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> dependencies</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --configuration</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> runtimeClasspath</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Gradle 策略：最新版本优先（newest wins）</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"kotlin\" data-code=\"// Gradle 强制指定版本&#10;configurations.all {&#10;    resolutionStrategy {&#10;        force(&quot;com.google.guava:guava:32.1.3-jre&quot;)&#10;        failOnVersionConflict()&#10;    }&#10;}&#10;&#10;// Gradle BOM 统一版本管理&#10;dependencies {&#10;    implementation(platform(&quot;org.springframework.boot:spring-boot-dependencies:3.2.0&quot;))&#10;    implementation(&quot;com.fasterxml.jackson.core:jackson-databind&quot;)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// Gradle 强制指定版本</span></span>\n<span class=\"line\"><span>configurations.all {</span></span>\n<span class=\"line\"><span>    resolutionStrategy {</span></span>\n<span class=\"line\"><span>        force(\"com.google.guava:guava:32.1.3-jre\")</span></span>\n<span class=\"line\"><span>        failOnVersionConflict()</span></span>\n<span class=\"line\"><span>    }</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>// Gradle BOM 统一版本管理</span></span>\n<span class=\"line\"><span>dependencies {</span></span>\n<span class=\"line\"><span>    implementation(platform(\"org.springframework.boot:spring-boot-dependencies:3.2.0\"))</span></span>\n<span class=\"line\"><span>    implementation(\"com.fasterxml.jackson.core:jackson-databind\")</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>策略</th>\n<th>Maven</th>\n<th>Gradle</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>默认解决</td>\n<td>最近路径优先</td>\n<td>最新版本优先</td>\n</tr>\n<tr>\n<td>强制版本</td>\n<td><code>&lt;dependencyManagement&gt;</code></td>\n<td><code>force()</code> / <code>strictly()</code></td>\n</tr>\n<tr>\n<td>排除依赖</td>\n<td><code>&lt;exclusions&gt;</code></td>\n<td><code>exclude(group, module)</code></td>\n</tr>\n<tr>\n<td>BOM 管理</td>\n<td><code>&lt;import&gt;</code> scope</td>\n<td><code>platform()</code></td>\n</tr>\n<tr>\n<td>冲突检测</td>\n<td>enforcer 插件</td>\n<td><code>failOnVersionConflict()</code></td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>Maven 和 Gradle 是 Java 两大主流构建工具，Maven 约定优于配置，Gradle 更灵活高效</li>\n<li>Maven 使用三阶段生命周期模型，POM XML 声明依赖和插件</li>\n<li>Gradle 通过增量构建、构建缓存和守护进程实现数倍于 Maven 的构建速度</li>\n<li>多模块项目使用 dependencyManagement（Maven）或 platform + convention plugin（Gradle）统一版本</li>\n<li>依赖冲突通过 dependency:tree 诊断，通过 BOM、force、exclusion 等策略解决</li>\n<li>新项目推荐 Gradle + Kotlin DSL，大型企业项目中 Maven 仍是主流选择</li>\n</ul>\n","headings":[{"level":1,"text":"Java 构建工具","id":"java-构建工具"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"Maven 核心机制","id":"maven-核心机制"},{"level":3,"text":"生命周期与阶段","id":"生命周期与阶段"},{"level":3,"text":"POM 配置","id":"pom-配置"},{"level":2,"text":"Gradle 核心机制","id":"gradle-核心机制"},{"level":3,"text":"build.gradle.kts 配置","id":"build-gradle-kts-配置"},{"level":3,"text":"增量构建与构建缓存","id":"增量构建与构建缓存"},{"level":2,"text":"多模块项目管理","id":"多模块项目管理"},{"level":2,"text":"依赖冲突解决","id":"依赖冲突解决"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Stream API 进阶模式","url":"/l-doc-books/h/languages/java-language/modern-java-ecosystem/stream-api-patterns"},"next":{"title":"Java 性能调优","url":"/l-doc-books/h/languages/java-language/modern-java-ecosystem/java-performance-tuning"}}