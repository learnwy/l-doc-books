h>推荐并行</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数据量 &gt; 10000</td>\n<td>是</td>\n<td>并行开销值得</td>\n</tr>\n<tr>\n<td>数据量 &lt; 1000</td>\n<td>否</td>\n<td>并行开销大于收益</td>\n</tr>\n<tr>\n<td>ArrayList / 数组</td>\n<td>是</td>\n<td>支持高效分割</td>\n</tr>\n<tr>\n<td>LinkedList</td>\n<td>否</td>\n<td>分割需要遍历</td>\n</tr>\n<tr>\n<td>无状态操作</td>\n<td>是</td>\n<td>map/filter 天然可并行</td>\n</tr>\n<tr>\n<td>有状态操作</td>\n<td>否</td>\n<td>sorted/distinct 需额外同步</td>\n</tr>\n<tr>\n<td>CPU 密集型</td>\n<td>是</td>\n<td>充分利用多核</td>\n</tr>\n<tr>\n<td>IO 密集型</td>\n<td>否</td>\n<td>ForkJoinPool 线程不够</td>\n</tr>\n</tbody></table>\n<p><strong>并行流陷阱</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 陷阱1：共享可变状态&#10;List&lt;Integer&gt; results = new ArrayList&lt;&gt;();&#10;stream.parallel().forEach(results::add);  // 线程不安全！&#10;&#10;// 正确做法：&#10;List&lt;Integer&gt; results = stream.parallel().collect(Collectors.toList());&#10;&#10;// 陷阱2：自定义 ForkJoinPool&#10;// 默认使用 commonPool，线程数 = CPU 核心数 - 1&#10;// 自定义池&#10;ForkJoinPool customPool = new ForkJoinPool(4);&#10;customPool.submit(() -&gt;&#10;    stream.parallel().forEach(this::process)&#10;).get();&#10;&#10;// 陷阱3：顺序依赖&#10;stream.parallel().forEachOrdered(System.out::println);  // 保证顺序但损失性能\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 陷阱1：共享可变状态</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Integer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> results </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ArrayList&#x3C;>();</span></span>\n<span class=\"line\"><span style=\"color:#