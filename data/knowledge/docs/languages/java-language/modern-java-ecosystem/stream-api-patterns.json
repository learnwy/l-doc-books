E;--shiki-dark:#E1E4E8\"> size, list.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">size</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toList</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>模式3：管道复用</strong>——Stream 只能消费一次，使用 Supplier 延迟创建：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"Supplier&lt;Stream&lt;Order&gt;&gt; orderStream = () -&gt; orders.stream()&#10;    .filter(o -&gt; o.getDate().isAfter(startDate));&#10;&#10;long count = orderStream.get().count();&#10;double total = orderStream.get().mapToDouble(Order::getAmount).sum();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Supplier&#x3C;Stream&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>> orderStream </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> orders.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stream</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(o </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1