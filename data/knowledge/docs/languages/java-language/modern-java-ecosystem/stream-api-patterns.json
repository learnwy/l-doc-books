td>二分区</td>\n<td>Map&lt;Boolean, List&gt;</td>\n</tr>\n<tr>\n<td>joining</td>\n<td>字符串拼接</td>\n<td>String</td>\n</tr>\n<tr>\n<td>summarizing*</td>\n<td>统计汇总</td>\n<td>*SummaryStatistics</td>\n</tr>\n<tr>\n<td>reducing</td>\n<td>自定义归约</td>\n<td>Optional / T</td>\n</tr>\n<tr>\n<td>collectingAndThen</td>\n<td>后处理</td>\n<td>R</td>\n</tr>\n<tr>\n<td>teeing (Java 12)</td>\n<td>双收集器合并</td>\n<td>R</td>\n</tr>\n</tbody></table>\n<h2 id=\"flatmap-与流的扁平化\">flatMap 与流的扁平化</h2><p>flatMap 是处理嵌套数据结构的核心操作——将每个元素映射为一个流，然后将所有流合并为一个：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"List&lt;List&lt;String&gt;&gt; nestedWords = List.of(&#10;    List.of(&quot;hello&quot;, &quot;world&quot;),&#10;    List.of(&quot;java&quot;, &quot;stream&quot;),&#10;    List.of(&quot;flat&quot;, &quot;map&quot;)&#10;);&#10;&#10;List&lt;String&gt; allWords = nestedWords.stream()&#10;    .flatMap(Collection::stream)&#10;    .toList();&#10;// [&quot;hello&quot;, &quot;world&quot;, &quot;java&quot;, &quot;stream&quot;, &quot;flat&quot;, &quot;map&quot;]&#10;&#10;// 实际场景：订单中的所有商品&#10;List&lt;Product&gt; allProducts = orders.stream()&#10;    .flatMap(order -&gt; order.getLineItems().stream())&#10;    .map(LineItem::getProduct)&#10;    .distinct()&#10;    .toList();&#10;&#10;// Optional 的 flatMap&#10;Optional&lt;String&gt; city = getUser()&#10;    .flatMap(User::getAddress)&#10;    .flatMap(Address::getCity);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">List&#x3C;List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>> nestedWords </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> List.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">of</span>