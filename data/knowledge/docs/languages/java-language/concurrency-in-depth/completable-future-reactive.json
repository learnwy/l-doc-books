e(priceCF, (ctx, price) -&gt; ctx.withPrice(price))&#10;        .thenCompose(ctx -&gt; CompletableFuture.supplyAsync(&#10;            () -&gt; orderService.create(ctx), ioPool))&#10;        .thenApply(order -&gt; {&#10;            notificationService.sendAsync(order);&#10;            return new OrderResult(order.getId(), &quot;SUCCESS&quot;);&#10;        })&#10;        .exceptionally(ex -&gt; {&#10;            log.error(&quot;Order failed&quot;, ex);&#10;            return new OrderResult(null, &quot;FAILED: &quot; + ex.getMessage());&#10;        });&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">public</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CompletableFuture</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">OrderResult</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> placeOrder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(OrderRequest request) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    CompletableFuture&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> userCF </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CompletableFuture.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">supplyAsync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userService.</span><span style=\"color:#6