:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> executor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Executors.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">newVirtualThreadPerTaskExecutor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 100_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        executor.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            Thread.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Duration.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ofSeconds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchFromDatabase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方式4：StructuredTaskScope（Java 21 Preview）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StructuredTaskScope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ShutdownOnFailure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Subtask&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> userTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> findUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(id));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Subtask&#x3C;List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Order</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>> ordersTask </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> findOrders</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(id));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">throwIfFailed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> UserProfile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(userTask.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), ordersTask.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>关键原则</strong>：虚拟线程不需要池化——它们的创建成本极低，每个任务直接创建一个虚拟线程即可。</p>\n<h2 id=\"虚拟线程调度原理\">虚拟线程调度原理</h2><p>虚拟线程采用 M:N 调度模型——M 个虚拟线程映射到 N 个平台线程（载体线程，carrier threads）。当虚拟线程执行阻塞操作时，JVM 自动将其从载体线程上卸载（unmount），载体线程可以继续运行其他虚拟线程。</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 阻塞操作的行为变化：&#10;// 平台线程：Thread.sleep → OS 线程挂起 → 浪费一个 OS 线程&#10;// 虚拟线程：Thread.sleep → 从载体线程卸载 → 载体线程服务其他虚拟线程&#10;&#10;// 以下操作都会触发虚拟线程的卸载：&#10;Thread.sleep(duration);         // 定时等待&#10;socket.read();                  // 网络 IO&#10;channel.read(buffer);           // NIO 通道&#10;Lock.lock();                    // j.u.c 锁（非 synchronized）&#10;BlockingQueue.take();           // 阻塞队列\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阻塞操作的行为变化：</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 平台线程：Thread.sleep → OS 线程挂起 → 浪费一个 OS 线程</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 虚拟线程：Thread.sleep → 从载体线程卸载 → 载体线程服务其他虚拟线程</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 以下操作都会触发虚拟线程的卸载：</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Thread.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(duration);         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 定时等待</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">socket.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">read</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();                  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 网络 IO</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">channel.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">read</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(buffer);           </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// NIO 通道</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Lock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();                    </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// j.u.c 锁（非 synchronized）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">BlockingQueue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">take</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();           </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阻塞队列</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[虚拟线程 V1] --&gt;|运行| B[载体线程 C1]&#10;    C[虚拟线程 V2] --&gt;|阻塞IO| D[卸载挂起]&#10;    E[虚拟线程 V3] --&gt;|等待调度| F[调度队列]&#10;    D --&gt;|IO完成| F&#10;    F --&gt;|调度| B\">graph LR\n    A[虚拟线程 V1] --&gt;|运行| B[载体线程 C1]\n    C[虚拟线程 V2] --&gt;|阻塞IO| D[卸载挂起]\n    E[虚拟线程 V3] --&gt;|等待调度| F[调度队列]\n    D --&gt;|IO完成| F\n    F --&gt;|调度| B</pre><p><strong>固定（Pinning）问题</strong>：在以下情况下，虚拟线程无法从载体线程卸载，会&quot;固定&quot;载体线程：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 情况1：synchronized 块中执行阻塞操作&#10;synchronized (lock) {&#10;    Thread.sleep(1000);  // 固定！虚拟线程无法卸载&#10;}&#10;&#10;// 解决方案：使用 ReentrantLock 替代 synchronized&#10;ReentrantLock lock = new ReentrantLock();&#10;lock.lock();&#10;try {&#10;    Thread.sleep(1000);  // 正常卸载&#10;} finally {&#10;    lock.unlock();&#10;}&#10;&#10;// 情况2：native 方法或 JNI 调用中的阻塞&#10;// 这种情况无法避免，需要注意&#10;&#10;// 监测固定&#10;// -Djdk.tracePinnedThreads=short&#10;// -Djdk.tracePinnedThreads=full\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 情况1：synchronized 块中执行阻塞操作</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">synchronized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (lock) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Thread.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 固定！虚拟线程无法卸载</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 解决方案：使用 ReentrantLock 替代 synchronized</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ReentrantLock lock </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReentrantLock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">lock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Thread.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sleep</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 正常卸载</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">finally</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    lock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 情况2：native 方法或 JNI 调用中的阻塞</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 这种情况无法避免，需要注意</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 监测固定</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -Djdk.tracePinnedThreads=short</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -Djdk.tracePinnedThreads=full</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>阻塞操作</th>\n<th>虚拟线程行为</th>\n<th>备注</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Thread.sleep</td>\n<td>正常卸载</td>\n<td>推荐</td>\n</tr>\n<tr>\n<td>Socket/Channel IO</td>\n<td>正常卸载</td>\n<td>推荐</td>\n</tr>\n<tr>\n<td>ReentrantLock</td>\n<td>正常卸载</td>\n<td>推荐替代 synchronized</td>\n</tr>\n<tr>\n<td>synchronized + 阻塞</td>\n<td>固定载体线程</td>\n<td>避免</td>\n</tr>\n<tr>\n<td>native/JNI 阻塞</td>\n<td>固定载体线程</td>\n<td>无法避免</td>\n</tr>\n<tr>\n<td>纯 CPU 计算</td>\n<td>不卸载</td>\n<td>计算密集型不适合虚拟线程</td>\n</tr>\n</tbody></table>\n<h2 id=\"结构化并发\">结构化并发</h2><p>结构化并发（Structured Concurrency, Java 21 Preview）将并发任务的生命周期绑定到代码结构中，确保子任务在父作用域结束前完成或取消，消除了线程泄漏和悬挂任务问题。</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// ShutdownOnFailure：任一失败则取消所有&#10;Response handle(Request request) throws Exception {&#10;    try (var scope = new StructuredTaskScope.ShutdownOnFailure()) {&#10;        Subtask&lt;User&gt; user = scope.fork(() -&gt; fetchUser(request.userId()));&#10;        Subtask&lt;Inventory&gt; inv = scope.fork(() -&gt; checkInventory(request.itemId()));&#10;        Subtask&lt;BigDecimal&gt; price = scope.fork(() -&gt; getPrice(request.itemId()));&#10;&#10;        scope.join().throwIfFailed();&#10;&#10;        return new Response(user.get(), inv.get(), price.get());&#10;    }&#10;}&#10;&#10;// ShutdownOnSuccess：首个成功即返回&#10;&lt;T&gt; T race(List&lt;Callable&lt;T&gt;&gt; tasks) throws Exception {&#10;    try (var scope = new StructuredTaskScope.ShutdownOnSuccess&lt;T&gt;()) {&#10;        for (var task : tasks) {&#10;            scope.fork(task);&#10;        }&#10;        scope.join();&#10;        return scope.result();&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ShutdownOnFailure：任一失败则取消所有</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Response </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">handle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Request request) throws Exception {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StructuredTaskScope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ShutdownOnFailure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Subtask&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> user </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(request.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">userId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Subtask&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Inventory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> inv </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> checkInventory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(request.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">itemId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Subtask&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BigDecimal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> price </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getPrice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(request.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">itemId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">throwIfFailed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Response</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(user.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), inv.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), price.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ShutdownOnSuccess：首个成功即返回</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">T</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> T </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">race</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(List</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Callable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">T</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tasks) throws Exception {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StructuredTaskScope.ShutdownOnSuccess&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">T</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>()) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tasks) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fork</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(task);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scope.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">result</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>结构化并发 vs CompletableFuture</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>特性</th>\n<th>CompletableFuture</th>\n<th>StructuredTaskScope</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>取消传播</td>\n<td>手动</td>\n<td>自动（作用域结束时）</td>\n</tr>\n<tr>\n<td>异常处理</td>\n<td>exceptionally/handle</td>\n<td>结构化（try-catch）</td>\n</tr>\n<tr>\n<td>线程泄漏</td>\n<td>可能</td>\n<td>不可能</td>\n</tr>\n<tr>\n<td>可观测性</td>\n<td>较差</td>\n<td>天然树状结构</td>\n</tr>\n<tr>\n<td>调试</td>\n<td>回调链难跟踪</td>\n<td>栈帧清晰</td>\n</tr>\n</tbody></table>\n<h2 id=\"迁移指南与最佳实践\">迁移指南与最佳实践</h2><div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 迁移前：线程池 + 异步回调&#10;ExecutorService pool = Executors.newFixedThreadPool(200);&#10;Future&lt;Result&gt; future = pool.submit(() -&gt; blockingCall());&#10;Result result = future.get();  // 阻塞等待&#10;&#10;// 迁移后：虚拟线程 + 同步代码&#10;try (var executor = Executors.newVirtualThreadPerTaskExecutor()) {&#10;    Future&lt;Result&gt; future = executor.submit(() -&gt; blockingCall());&#10;    Result result = future.get();  // 虚拟线程中的阻塞不浪费资源&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 迁移前：线程池 + 异步回调</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ExecutorService pool </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Executors.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">newFixedThreadPool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">200</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Future&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Result</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> future </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pool.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> blockingCall</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Result result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> future.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 阻塞等待</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 迁移后：虚拟线程 + 同步代码</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> executor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Executors.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">newVirtualThreadPerTaskExecutor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Future&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Result</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> future </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> executor.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> blockingCall</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    Result result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> future.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 虚拟线程中的阻塞不浪费资源</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>何时使用虚拟线程</strong>：</p>\n<table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>IO 密集型服务</td>\n<td>强烈推荐</td>\n<td>阻塞 IO 自动卸载</td>\n</tr>\n<tr>\n<td>HTTP 服务器</td>\n<td>强烈推荐</td>\n<td>每请求一线程</td>\n</tr>\n<tr>\n<td>数据库访问</td>\n<td>推荐</td>\n<td>JDBC 阻塞调用</td>\n</tr>\n<tr>\n<td>微服务间调用</td>\n<td>推荐</td>\n<td>网络等待</td>\n</tr>\n<tr>\n<td>CPU 密集型计算</td>\n<td>不推荐</td>\n<td>不会卸载，无收益</td>\n</tr>\n<tr>\n<td>GUI 事件循环</td>\n<td>不推荐</td>\n<td>有专用线程模型</td>\n</tr>\n</tbody></table>\n<p><strong>注意事项</strong>：</p>\n<ul>\n<li>不要池化虚拟线程——每个任务创建新的虚拟线程</li>\n<li>将 synchronized 替换为 ReentrantLock（避免固定）</li>\n<li>ThreadLocal 在虚拟线程中仍然可用，但百万线程时要注意内存开销</li>\n<li>使用 ScopedValue（Preview）替代 ThreadLocal 减少内存占用</li>\n</ul>\n<h2 id=\"小结\">小结</h2><ul>\n<li>虚拟线程是 Java 21 引入的轻量级线程，创建成本约 1μs、栈空间约 1KB，可扩展到百万级</li>\n<li>M:N 调度模型将虚拟线程映射到少量载体线程，阻塞 IO 时自动卸载不浪费资源</li>\n<li>synchronized 内的阻塞操作会导致固定（Pinning），应替换为 ReentrantLock</li>\n<li>结构化并发将子任务生命周期绑定到作用域，自动处理取消和异常，消除线程泄漏</li>\n<li>虚拟线程最适合 IO 密集型场景（HTTP 服务、数据库访问、微服务调用），不适合 CPU 密集型</li>\n<li>不要池化虚拟线程，使用 Executors.newVirtualThreadPerTaskExecutor() 为每个任务创建新线程</li>\n</ul>\n","headings":[{"level":1,"text":"虚拟线程与 Project Loom","id":"虚拟线程与-project-loom"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"虚拟线程的使用方式","id":"虚拟线程的使用方式"},{"level":2,"text":"虚拟线程调度原理","id":"虚拟线程调度原理"},{"level":2,"text":"结构化并发","id":"结构化并发"},{"level":2,"text":"迁移指南与最佳实践","id":"迁移指南与最佳实践"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"CompletableFuture 与响应式编程","url":"/l-doc-books/h/languages/java-language/concurrency-in-depth/completable-future-reactive"},"next":{"title":"Java 模块系统 JPMS","url":"/l-doc-books/h/languages/java-language/modern-java-ecosystem/module-system-jpms"}}