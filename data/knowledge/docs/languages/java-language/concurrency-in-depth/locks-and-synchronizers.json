tyle=\"color:#24292E;--shiki-dark:#E1E4E8\">, TimeUnit.SECONDS)) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        // 获取成功</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">finally</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        lock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unlock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 获取失败，执行降级逻辑</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>Condition 条件变量</strong>——替代 wait/notify，支持多个等待条件：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"ReentrantLock lock = new ReentrantLock();&#10;Condition notFull = lock.newCondition();&#10;Condition notEmpty = lock.newCondition();&#10;int[] buffer = new int[10];&#10;int count = 0;&#10;&#10;public void put(int value) throws InterruptedException {&#10;    lock.lock();&#10;    try {&#10;        while (count == buffer.length) {&#10;            notFull.await();&#10;        }&#10;        buffer[count++] = value;&#10;        notEmpty.signal();&#10;    } finally {&#10;        lock.unlock();&#10;    }&#10;}&#10;&#10;public int take() throws InterruptedException {&#10;    lock.lock();&#10;    try {&#10;        while (count == 0) {&#10;            notEmpty.await();&#10;        }&#10;        int value = buffer[--count];&#10;        notFull.signal();&#10;        return value;&#10;    } finally {&#10;        lock.unlock();&#10;    }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">ReentrantLock lock </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ReentrantLock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Condition notFull </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">newCondition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Condition notEmpty </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lock.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">newCondition</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] buffer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color