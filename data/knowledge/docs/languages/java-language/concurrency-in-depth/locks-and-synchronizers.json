>\n<td>读多写少</td>\n</tr>\n<tr>\n<td>StampedLock</td>\n<td>支持</td>\n<td>不支持</td>\n<td>是</td>\n<td>否</td>\n<td>极致读性能</td>\n</tr>\n</tbody></table>\n<h2 id=\"死锁诊断与预防\">死锁诊断与预防</h2><p>死锁发生在两个或多个线程互相等待对方持有的锁。四个必要条件：互斥、占有并等待、不可抢占、循环等待。</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 经典死锁场景&#10;Object lockA = new Object(), lockB = new Object();&#10;&#10;// 线程1&#10;synchronized (lockA) {&#10;    synchronized (lockB) { }  // 等待 lockB&#10;}&#10;&#10;// 线程2&#10;synchronized (lockB) {&#10;    synchronized (lockA) { }  // 等待 lockA → 死锁&#10;}&#10;&#10;// 预防：固定加锁顺序&#10;private static final Object LOCK_FIRST = lockA.hashCode() &lt; lockB.hashCode() ? lockA : lockB;&#10;private static final Object LOCK_SECOND = LOCK_FIRST == lockA ? lockB : lockA;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 经典死锁场景</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Object lockA </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Object</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), lockB </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Object</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 线程1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">synchronized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (lockA) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    synchronized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (lockB) { }  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 等待 lockB</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 线程2</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">synchronized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (lockB) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    synchronized</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (lockA) { }  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 等待 lockA → 死锁</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 预防：固定加锁顺序</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> final</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Object LOCK_FIRST </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockA.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">hashCode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockB.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">hashCode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockA </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockB;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> static</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> final</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Object LOCK_SECOND </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> LOCK_FIRST </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockA </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockB </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lockA;</span></span></code></pre></div><p><strong>诊断工具</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# jstack 查看线程转储&#10;jstack &lt;pid&gt; | grep -A 20 &quot;deadlock&quot;&#10;&#10;# JMX 编程检测&#10;ThreadMXBean tmx = ManagementFactory.getThreadMXBean();&#10;long[] deadlockedThreads = tmx.findDeadlockedThreads();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># jstack 查看线程转储</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">jstack</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">pi</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -A</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 20</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"deadlock\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># JMX 编程检测</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ThreadMXBean</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> tmx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ManagementFactory.getThreadMXBean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">long[]</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> deadlockedThreads</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> tmx.findDeadlockedThreads</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>预防策略</th>\n<th>方法</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>固定顺序</td>\n<td>按资源 hashCode/ID 排序</td>\n<td>多锁场景</td>\n</tr>\n<tr>\n<td>超时机制</td>\n<td>tryLock(timeout)</td>\n<td>替代无限等待</td>\n</tr>\n<tr>\n<td>开放调用</td>\n<td>不在持有锁时调用外部方法</td>\n<td>方法调用链</td>\n</tr>\n<tr>\n<td>锁粒度细化</td>\n<td>减小同步范围</td>\n<td>减少持锁时间</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>synchronized 经过偏向锁→轻量级锁→重量级锁的升级优化，单线程场景性能极高</li>\n<li>ReentrantLock 基于 AQS，提供可中断、可超时、公平性和多条件变量等高级特性</li>\n<li>ReadWriteLock 适用于读多写少场景，StampedLock 通过乐观读进一步提升读性能</li>\n<li>AQS 是 j.u.c 同步器的基石，通过 state 变量和 CLH 队列实现各种同步语义</li>\n<li>死锁预防的核心策略：固定加锁顺序、使用超时获取、最小化持锁范围</li>\n<li>选择锁时优先考虑 synchronized（简单场景），需要高级特性时使用 ReentrantLock</li>\n</ul>\n","headings":[{"level":1,"text":"锁与同步器","id":"锁与同步器"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"synchronized 锁升级","id":"synchronized-锁升级"},{"level":2,"text":"ReentrantLock 与 AQS","id":"reentrantlock-与-aqs"},{"level":2,"text":"ReadWriteLock 与 StampedLock","id":"readwritelock-与-stampedlock"},{"level":2,"text":"死锁诊断与预防","id":"死锁诊断与预防"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"java.util.concurrent 核心组件","url":"/l-doc-books/h/languages/java-language/concurrency-in-depth/java-util-concurrent"},"next":{"title":"CompletableFuture 与响应式编程","url":"/l-doc-books/h/languages/java-language/concurrency-in-depth/completable-future-reactive"}}