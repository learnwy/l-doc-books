pan><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Semaphore</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 最多 10 个并发</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">public</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> accessResource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() throws InterruptedException {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    semaphore.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">acquire</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        useSharedResource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">finally</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        semaphore.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">release</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>可重用</th>\n<th>计数方向</th>\n<th>典型场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>CountDownLatch</td>\n<td>否</td>\n<td>递减</td>\n<td>等待 N 个任务完成</td>\n</tr>\n<tr>\n<td>CyclicBarrier</td>\n<td>是</td>\n<td>到达点</td>\n<td>多阶段并行计算</td>\n</tr>\n<tr>\n<td>Semaphore</td>\n<td>是</td>\n<td>增减</td>\n<td>限流/资源池</td>\n</tr>\n<tr>\n<td>Phaser</td>\n<td>是</td>\n<td>阶段推进</td>\n<td>动态参与者的多阶段</td>\n</tr>\n<tr>\n<td>Exchanger</td>\n<td>是</td>\n<td>交换</td>\n<td>两线程数据交换</td>\n</tr>\n</tbody></table>\n<h2 id=\"blockingqueue-与生产者-消费者\">BlockingQueue 与生产者-消费者</h2><p>BlockingQueue 是实现生产者-消费者模式的核心接口——当队列满时 put 阻塞，当队列空时 take 阻塞：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"BlockingQueue&lt;Task&gt; queue = new ArrayBlockingQueue&lt;&gt;(100);&#10;&#10;// 生产者&#10;executor.submit(() -&gt; {&#10;    while (running) {&#10;        Task task = generateTask();&#10;        queue.put(task);  // 队列满时阻塞&#10;    }&#10;});&#10;&#10;// 消费者&#10;executor.submit(() -&gt; {&#10;    while (running) {&#10;        Task task = queue.take();  // 队列空时阻塞&#10;        processTask(task);&#10;    }&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">BlockingQueue&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Task</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> queue </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ArrayBlockingQueue&#x3C;>(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 生产者</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">executor.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (running) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Task task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> generateTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">put</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(task);  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 队列满时阻塞</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 消费者</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">executor.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">submit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (running) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Task task </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> queue.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">take</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 队列空时阻塞</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">        processTask</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(task);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>实现</th>\n<th>底层结构</th>\n<th>有界</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>ArrayBlockingQueue</td>\n<td>数组</td>\n<td>是</td>\n<td>公平/非公平锁</td>\n</tr>\n<tr>\n<td>LinkedBlockingQueue</td>\n<td>链表</td>\n<td>可选</td>\n<td>吞吐量更高</td>\n</tr>\n<tr>\n<td>PriorityBlockingQueue</td>\n<td>堆</td>\n<td>否</td>\n<td>优先级排序</td>\n</tr>\n<tr>\n<td>SynchronousQueue</td>\n<td>无存储</td>\n<td>—</td>\n<td>直接传递</td>\n</tr>\n<tr>\n<td>DelayQueue</td>\n<td>堆</td>\n<td>否</td>\n<td>延迟元素</td>\n</tr>\n<tr>\n<td>LinkedTransferQueue</td>\n<td>链表</td>\n<td>否</td>\n<td>transfer 语义</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>j.u.c 是 Java 并发编程的核心工具包，提供线程池、原子变量、同步工具和并发集合</li>\n<li>ThreadPoolExecutor 有 7 个关键参数，任务处理遵循核心线程 → 队列 → 非核心线程 → 拒绝策略的流程</li>\n<li>原子变量基于 CAS 实现无锁线程安全，高竞争场景使用 LongAdder 替代 AtomicLong</li>\n<li>CountDownLatch（一次性倒数）、CyclicBarrier（可重用屏障）、Semaphore（限流）是三大线程协调工具</li>\n<li>BlockingQueue 是生产者-消费者模式的标准实现，ArrayBlockingQueue 和 LinkedBlockingQueue 最常用</li>\n<li>始终使用 ThreadPoolExecutor 构造器而非 Executors 工厂方法，明确控制队列和线程数上限</li>\n</ul>\n","headings":[{"level":1,"text":"java.util.concurrent 核心组件","id":"java-util-concurrent-核心组件"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"ThreadPoolExecutor 深入解析","id":"threadpoolexecutor-深入解析"},{"level":2,"text":"原子变量与 CAS","id":"原子变量与-cas"},{"level":2,"text":"同步工具类","id":"同步工具类"},{"level":2,"text":"BlockingQueue 与生产者-消费者","id":"blockingqueue-与生产者-消费者"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Java 内存模型与 JMM","url":"/l-doc-books/h/languages/java-language/jvm-internals/memory-model-and-jmm"},"next":{"title":"锁与同步器","url":"/l-doc-books/h/languages/java-language/concurrency-in-depth/locks-and-synchronizers"}}