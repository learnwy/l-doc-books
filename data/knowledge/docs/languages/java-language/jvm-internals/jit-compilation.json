i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    a[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> b[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c[i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 循环向量化（SIMD）：C2 自动使用 AVX/SSE 指令处理数组运算</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>优化技术</th>\n<th>作用</th>\n<th>收益</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>方法内联</td>\n<td>消除调用开销</td>\n<td>5-50%</td>\n</tr>\n<tr>\n<td>逃逸分析</td>\n<td>栈上分配，消除锁</td>\n<td>显著减少 GC</td>\n</tr>\n<tr>\n<td>标量替换</td>\n<td>拆解对象为基本类型</td>\n<td>消除对象分配</td>\n</tr>\n<tr>\n<td>锁消除</td>\n<td>消除非逃逸对象的锁</td>\n<td>消除同步开销</td>\n</tr>\n<tr>\n<td>循环展开</td>\n<td>减少循环控制开销</td>\n<td>10-30%</td>\n</tr>\n<tr>\n<td>null 检查消除</td>\n<td>移除冗余 null 检查</td>\n<td>减少分支</td>\n</tr>\n<tr>\n<td>范围检查消除</td>\n<td>移除数组越界检查</td>\n<td>数组操作加速</td>\n</tr>\n</tbody></table>\n<h2 id=\"逆优化与性能陷阱\">逆优化与性能陷阱</h2><p>JIT 编译是投机性的——基于运行时 profiling 数据做出优化假设。当假设不再成立时，JVM 执行逆优化（Deoptimization），回退到解释执行：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 假设性内联&#10;public void process(Shape shape) {&#10;    shape.draw();  // profiling 显示 99% 是 Circle&#10;    // C2 直接内联 Circle.draw()&#10;    // 如果突然出现 Rectangle，触发逆优化&#10;}&#10;&#10;// 查看逆优化&#10;// -XX:+TraceDeoptimization&#10;// Uncommon trap: reason=class_check action=maybe_recompile\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 假设性内联</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">public</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> void</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> process</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Shape shape) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    shape.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">draw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// profiling 显示 99% 是 Circle</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // C2 直接内联 Circle.draw()</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    // 如果突然出现 Rectangle，触发逆优化</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 查看逆优化</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -XX:+TraceDeoptimization</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Uncommon trap: reason=class_check action=maybe_recompile</span></span></code></pre></div><p><strong>常见性能陷阱</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"java\" data-code=\"// 1. 多态调用阻止内联（megamorphic site）&#10;List&lt;Shape&gt; shapes = ...; // 包含 5+ 种 Shape 子类&#10;for (Shape s : shapes) {&#10;    s.draw();  // 多态度过高，C2 放弃内联&#10;}&#10;&#10;// 2. Code Cache 溢出&#10;// -XX:ReservedCodeCacheSize=256m (默认)&#10;// 超出后新方法无法被编译，性能骤降&#10;&#10;// 3. 编译队列积压&#10;// 启动时大量方法同时触发编译，C2 队列拥塞&#10;// 监控：-XX:+PrintCompilation 中 &quot;made not entrant&quot; 频繁出现\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1. 多态调用阻止内联（megamorphic site）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Shape</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> shapes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ...; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 包含 5+ 种 Shape 子类</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Shape s </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> shapes) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    s.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">draw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 多态度过高，C2 放弃内联</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 2. Code Cache 溢出</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// -XX:ReservedCodeCacheSize=256m (默认)</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 超出后新方法无法被编译，性能骤降</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 3. 编译队列积压</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 启动时大量方法同时触发编译，C2 队列拥塞</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 监控：-XX:+PrintCompilation 中 \"made not entrant\" 频繁出现</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>逆优化原因</th>\n<th>触发条件</th>\n<th>缓解策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>class_check</td>\n<td>新子类出现</td>\n<td>减少多态调用点</td>\n</tr>\n<tr>\n<td>null_check</td>\n<td>实际遇到 null</td>\n<td>预热阶段覆盖边界情况</td>\n</tr>\n<tr>\n<td>range_check</td>\n<td>数组越界</td>\n<td>保证循环边界正确</td>\n</tr>\n<tr>\n<td>unstable_if</td>\n<td>分支概率改变</td>\n<td>避免条件突变</td>\n</tr>\n</tbody></table>\n<h2 id=\"graalvm-与-aot-编译\">GraalVM 与 AOT 编译</h2><p>GraalVM 提供了两种替代编译方案：Graal JIT 编译器（替代 C2）和 Native Image（AOT 编译）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 使用 Graal JIT（作为 C2 替代）&#10;java -XX:+UseJVMCICompiler -jar app.jar&#10;&#10;# Native Image AOT 编译（消除 JIT，毫秒级启动）&#10;native-image -jar app.jar&#10;# 生成独立可执行文件，启动时间 &lt;100ms，内存占用大幅减少\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 使用 Graal JIT（作为 C2 替代）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">java</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -XX:+UseJVMCICompiler</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -jar</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.jar</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Native Image AOT 编译（消除 JIT，毫秒级启动）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">native-image</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -jar</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> app.jar</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 生成独立可执行文件，启动时间 &#x3C;100ms，内存占用大幅减少</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>特性</th>\n<th>C2 JIT</th>\n<th>Graal JIT</th>\n<th>Native Image</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>编译时机</td>\n<td>运行时</td>\n<td>运行时</td>\n<td>构建时</td>\n</tr>\n<tr>\n<td>启动速度</td>\n<td>秒级</td>\n<td>秒级</td>\n<td>毫秒级</td>\n</tr>\n<tr>\n<td>峰值性能</td>\n<td>极高</td>\n<td>更高（部分场景）</td>\n<td>中等</td>\n</tr>\n<tr>\n<td>内存占用</td>\n<td>较大</td>\n<td>较大</td>\n<td>小</td>\n</tr>\n<tr>\n<td>动态特性支持</td>\n<td>完整</td>\n<td>完整</td>\n<td>受限（需配置）</td>\n</tr>\n<tr>\n<td>适用场景</td>\n<td>通用</td>\n<td>长期运行服务</td>\n<td>微服务、CLI、Serverless</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>JIT 编译是 JVM 将热点字节码编译为本地机器码的运行时优化，Java 默认使用分层编译（C1 + C2）</li>\n<li>热点检测基于方法调用计数器和回边计数器，达到阈值后触发编译</li>\n<li>核心优化技术包括方法内联、逃逸分析、标量替换、循环展开和锁消除</li>\n<li>逆优化在运行时假设失效时发生，多态调用过多和 Code Cache 溢出是常见性能陷阱</li>\n<li>GraalVM Native Image 提供 AOT 编译方案，以峰值性能换取毫秒级启动和低内存占用</li>\n<li>通过 <code>-XX:+PrintCompilation</code> 和 <code>-XX:+TraceDeoptimization</code> 诊断 JIT 行为</li>\n</ul>\n","headings":[{"level":1,"text":"JIT 编译","id":"jit-编译"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"分层编译体系","id":"分层编译体系"},{"level":2,"text":"关键优化技术","id":"关键优化技术"},{"level":2,"text":"逆优化与性能陷阱","id":"逆优化与性能陷阱"},{"level":2,"text":"GraalVM 与 AOT 编译","id":"graalvm-与-aot-编译"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Java 类加载机制","url":"/l-doc-books/h/languages/java-language/jvm-internals/class-loading-mechanism"},"next":{"title":"垃圾回收算法","url":"/l-doc-books/h/languages/java-language/jvm-internals/garbage-collection-algorithms"}}