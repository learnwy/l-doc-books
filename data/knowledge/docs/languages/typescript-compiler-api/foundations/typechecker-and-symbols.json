 data-lang=\"typescript\" data-code=\"// 判断 sourceType 是否可赋值给 targetType&#10;function isAssignableTo(checker: ts.TypeChecker, sourceType: ts.Type, targetType: ts.Type): boolean {&#10;  return checker.isTypeAssignableTo(sourceType, targetType);&#10;}&#10;&#10;// 获取函数的返回类型&#10;function getReturnType(checker: ts.TypeChecker, funcDecl: ts.FunctionDeclaration): ts.Type {&#10;  const signature = checker.getSignatureFromDeclaration(funcDecl);&#10;  return checker.getReturnTypeOfSignature(signature!);&#10;}&#10;&#10;// 解析泛型实例化后的具体类型&#10;function resolveGenericType(checker: ts.TypeChecker, callExpr: ts.CallExpression): ts.Type {&#10;  return checker.getTypeAtLocation(callExpr);&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 判断 sourceType 是否可赋值给 targetType</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> isAssignableTo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">checker</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">TypeChecker</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">sourceType</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">targetTyp