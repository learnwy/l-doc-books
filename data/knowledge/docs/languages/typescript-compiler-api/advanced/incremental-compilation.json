span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createIncrementalProgram</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  rootNames: parsed.fileNames,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  options: {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">parsed.options,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    incremental: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    tsBuildInfoFile: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./.tsbuildinfo'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  host: ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createIncrementalCompilerHost</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(parsed.options),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// emit 只处理需要更新的文件</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> emitResult</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> program.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">emit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 获取增量诊断</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> diagnostics</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">program.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getConfigFileParsingDiagnostics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">program.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getSyntacticDiagnostics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  ...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">program.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getSemanticDiagnostics</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><h2 id=\"watch-模式的编程实现\">Watch 模式的编程实现</h2><p>Watch 模式在增量编译之上增加了文件系统监听——文件变更时自动触发重编译：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const host = ts.createWatchCompilerHost(&#10;  configPath,&#10;  {},&#10;  ts.sys,&#10;  ts.createSemanticDiagnosticsBuilderProgram,&#10;  // 诊断回调&#10;  (diagnostic) =&gt; {&#10;    console.error(ts.flattenDiagnosticMessageText(diagnostic.messageText, &#39;\\n&#39;));&#10;  },&#10;  // Watch 状态回调&#10;  (diagnostic) =&gt; {&#10;    console.log(ts.flattenDiagnosticMessageText(diagnostic.messageText, &#39;\\n&#39;));&#10;  },&#10;);&#10;&#10;// 可以钩入文件变更事件&#10;const origPostProgramCreate = host.afterProgramCreate;&#10;host.afterProgramCreate = (program) =&gt; {&#10;  console.log(&#39;程序已更新，受影响文件:&#39;);&#10;  const affected = program.getSemanticDiagnosticsOfNextAffectedFile();&#10;  origPostProgramCreate?.(program);&#10;};&#10;&#10;// 启动 Watch&#10;const watchProgram = ts.createWatchProgram(host);&#10;// watchProgram 现在在持续监听文件变更\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> host</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createWatchCompilerHost</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  configPath,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {},</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ts.sys,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ts.createSemanticDiagnosticsBuilderProgram,</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 诊断回调</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">diagnostic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flattenDiagnosticMessageText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(diagnostic.messageText, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // Watch 状态回调</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">diagnostic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flattenDiagnosticMessageText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(diagnostic.messageText, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 可以钩入文件变更事件</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> origPostProgramCreate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> host.afterProgramCreate;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">host.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">afterProgramCreate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">program</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'程序已更新，受影响文件:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> affected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> program.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getSemanticDiagnosticsOfNextAffectedFile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  origPostProgramCreate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">?.(program);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 启动 Watch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> watchProgram</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createWatchProgram</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(host);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// watchProgram 现在在持续监听文件变更</span></span></code></pre></div><h2 id=\"builder-program-api\">Builder Program API</h2><p><code>BuilderProgram</code> 是增量编译的核心抽象——它跟踪哪些文件自上次编译以来发生了变化，并只对这些文件执行语义检查：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// SemanticDiagnosticsBuilderProgram 只对变更文件计算诊断&#10;const builderProgram = ts.createSemanticDiagnosticsBuilderProgram(&#10;  rootNames,&#10;  options,&#10;  host,&#10;  oldProgram, // 上一次的 BuilderProgram（增量基础）&#10;);&#10;&#10;// 逐个获取受影响文件的诊断&#10;let affected: ts.AffectedFileResult&lt;readonly ts.Diagnostic[]&gt; | undefined;&#10;while ((affected = builderProgram.getSemanticDiagnosticsOfNextAffectedFile())) {&#10;  if (affected.result.length &gt; 0) {&#10;    console.log(`文件 ${affected.affected} 有 ${affected.result.length} 个错误`);&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// SemanticDiagnosticsBuilderProgram 只对变更文件计算诊断</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> builderProgram</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createSemanticDiagnosticsBuilderProgram</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  rootNames,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  options,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  host,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  oldProgram, </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 上一次的 BuilderProgram（增量基础）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 逐个获取受影响文件的诊断</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> affected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">AffectedFileResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">readonly</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ts</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Diagnostic</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> undefined</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ((affected </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> builderProgram.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getSemanticDiagnosticsOfNextAffectedFile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">())) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (affected.result.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`文件 ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">affected</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">affected</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} 有 ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">affected</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">result</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} 个错误`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"project-references-与-build-模式\">Project References 与 Build 模式</h2><p>Monorepo 场景下，<code>--build</code> 模式利用 Project References 在项目级别实现增量编译——只有依赖图中被修改项目的下游才需要重编译：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"// 编程方式执行 build 模式&#10;const solution = ts.createSolutionBuilder(&#10;  ts.createSolutionBuilderHost(ts.sys),&#10;  [&#39;./tsconfig.json&#39;], // root tsconfig（含 references）&#10;  {},&#10;);&#10;&#10;// 按拓扑排序依次构建&#10;const exitStatus = solution.build();&#10;&#10;// 也可以只构建特定项目&#10;solution.buildNextInvalidatedProject();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 编程方式执行 build 模式</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> solution</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createSolutionBuilder</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ts.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createSolutionBuilderHost</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(ts.sys),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'./tsconfig.json'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// root tsconfig（含 references）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  {},</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 按拓扑排序依次构建</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> exitStatus</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> solution.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">build</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 也可以只构建特定项目</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">solution.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">buildNextInvalidatedProject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><h2 id=\"性能调优建议\">性能调优建议</h2><table>\n<thead>\n<tr>\n<th>优化手段</th>\n<th>效果</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>skipLibCheck: true</code></td>\n<td>跳过 .d.ts 文件类型检查</td>\n<td>所有项目（推荐）</td>\n</tr>\n<tr>\n<td><code>isolatedModules: true</code></td>\n<td>允许单文件转译</td>\n<td>配合 esbuild/swc</td>\n</tr>\n<tr>\n<td>Project References</td>\n<td>项目级增量</td>\n<td>Monorepo</td>\n</tr>\n<tr>\n<td><code>tsBuildInfoFile</code> 持久化</td>\n<td>CI 跨次构建加速</td>\n<td>CI 缓存</td>\n</tr>\n<tr>\n<td><code>assumeChangesOnlyAffectDirectDependencies</code></td>\n<td>减少传播范围</td>\n<td>超大项目</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>增量编译通过 <code>.tsbuildinfo</code> 缓存文件签名和依赖图，只重编译受影响文件</li>\n<li>签名隔离是核心优化：实现变更不传播，API 变更才传播</li>\n<li>Watch 模式 = 增量编译 + 文件系统监听，保持毫秒级响应</li>\n<li><code>BuilderProgram</code> 是增量编译的编程接口，支持逐文件获取变更诊断</li>\n<li>Project References + Build 模式实现 Monorepo 级别的项目间增量</li>\n</ul>\n<h2 id=\"延伸阅读\">延伸阅读</h2><ul>\n<li>兄弟文档：<a href=\"declaration-generation\">声明文件生成与 Bundling</a>——增量模式下声明文件的高效生成策略</li>\n<li>跨库链接：<a href=\"../../../frontend/build-tooling-bundlers/engineering/monorepo-build\">Monorepo 构建策略</a>——Project References 在前端 Monorepo 中的实际应用模式</li>\n</ul>\n","headings":[{"level":1,"text":"增量编译与 Watch 模式","id":"增量编译与-watch-模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"增量编译的内部机制","id":"增量编译的内部机制"},{"level":2,"text":"编程方式使用增量编译","id":"编程方式使用增量编译"},{"level":2,"text":"Watch 模式的编程实现","id":"watch-模式的编程实现"},{"level":2,"text":"Builder Program API","id":"builder-program-api"},{"level":2,"text":"Project References 与 Build 模式","id":"project-references-与-build-模式"},{"level":2,"text":"性能调优建议","id":"性能调优建议"},{"level":2,"text":"小结","id":"小结"},{"level":2,"text":"延伸阅读","id":"延伸阅读"}],"prev":{"title":"CompilerHost 自定义与虚拟文件系统","url":"/l-doc-books/h/languages/typescript-compiler-api/tooling/compiler-host"},"next":{"title":"声明文件生成与 Bundling","url":"/l-doc-books/h/languages/typescript-compiler-api/advanced/declaration-generation"}}