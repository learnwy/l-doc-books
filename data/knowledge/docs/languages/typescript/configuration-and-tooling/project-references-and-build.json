k:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"noEmit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"references\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [{ </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"path\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"../shared\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"path\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"../core\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }],</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"include\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"src/**/*\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    ROOT[&quot;tsconfig.json&lt;br/&gt;(Solution File)&quot;]&#10;    ROOT --&gt; SHARED[&quot;packages/shared&lt;br/&gt;composite: true&lt;br/&gt;No Dependencies&quot;]&#10;    ROOT --&gt; CORE[&quot;packages/core&lt;br/&gt;composite: true&lt;br/&gt;Depends on shared&quot;]&#10;    ROOT --&gt; APP[&quot;packages/app&lt;br/&gt;composite: false&lt;br/&gt;Depends on shared + core&quot;]&#10;    SHARED -.-&gt;|&quot;Reference&quot;| CORE&#10;    SHARED -.-&gt;|&quot;Reference&quot;| APP&#10;    CORE -.-&gt;|&quot;Reference&quot;| APP\">flowchart TD\n    ROOT[\"tsconfig.json&lt;br/&gt;(Solution File)\"]\n    ROOT --&gt; SHARED[\"packages/shared&lt;br/&gt;composite: true&lt;br/&gt;No Dependencies\"]\n    ROOT --&gt; CORE[\"packages/core&lt;br/&gt;composite: true&lt;br/&gt;Depends on shared\"]\n    ROOT --&gt; APP[\"packages/app&lt;br/&gt;composite: false&lt;br/&gt;Depends on shared + core\"]\n    SHARED -.-&gt;|\"Reference\"| CORE\n    SHARED -.-&gt;|\"Reference\"| APP\n    CORE -.-&gt;|\"Reference\"| APP</pre><h3 id=\"增量编译原理\">增量编译原理</h3><p>增量编译依赖 <code>.tsbuildinfo</code> 文件记录每个源文件的签名（内容哈希）：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    SRC[&quot;Source File Modified&quot;] --&gt; HASH[&quot;Calculate File Hash&quot;]&#10;    HASH --&gt; COMPARE[&quot;Compare with .tsbuildinfo&quot;]&#10;    COMPARE --&gt;|&quot;Hash Matches&quot;| SKIP[&quot;Skip Compilation&quot;]&#10;    COMPARE --&gt;|&quot;Hash Differs&quot;| RECOMPILE[&quot;Recompile&quot;]&#10;    RECOMPILE --&gt; UPDATE[&quot;Update .tsbuildinfo&quot;]&#10;    RECOMPILE --&gt; EMIT[&quot;Emit .js + .d.ts&quot;]\">flowchart LR\n    SRC[\"Source File Modified\"] --&gt; HASH[\"Calculate File Hash\"]\n    HASH --&gt; COMPARE[\"Compare with .tsbuildinfo\"]\n    COMPARE --&gt;|\"Hash Matches\"| SKIP[\"Skip Compilation\"]\n    COMPARE --&gt;|\"Hash Differs\"| RECOMPILE[\"Recompile\"]\n    RECOMPILE --&gt; UPDATE[\"Update .tsbuildinfo\"]\n    RECOMPILE --&gt; EMIT[\"Emit .js + .d.ts\"]</pre><p>对于非 <code>composite</code> 的独立项目，也可以使用 <code>incremental</code> 选项启用增量编译：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;compilerOptions&quot;: {&#10;    &quot;incremental&quot;: true,&#10;    &quot;tsBuildInfoFile&quot;: &quot;./dist/.tsbuildinfo&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"compilerOptions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"incremental\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"tsBuildInfoFile\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist/.tsbuildinfo\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"跨包导入\">跨包导入</h3><p>被引用的包通过 <code>package.json</code> 的 <code>exports</code> 或 <code>main</code>/<code>types</code> 字段暴露入口：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;name&quot;: &quot;@monorepo/shared&quot;,&#10;  &quot;main&quot;: &quot;./dist/index.js&quot;,&#10;  &quot;types&quot;: &quot;./dist/index.d.ts&quot;,&#10;  &quot;exports&quot;: {&#10;    &quot;.&quot;: {&#10;      &quot;types&quot;: &quot;./dist/index.d.ts&quot;,&#10;      &quot;import&quot;: &quot;./dist/index.js&quot;&#10;    }&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"@monorepo/shared\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"main\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist/index.js\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"types\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist/index.d.ts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"exports\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \".\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"types\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist/index.d.ts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      \"import\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"./dist/index.js\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>在 <code>core</code> 包中导入：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"import { Logger, type LogLevel } from &#39;@monorepo/shared&#39;;&#10;&#10;const logger = new Logger(&#39;core&#39;);&#10;logger.info(&#39;初始化完成&#39;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Logger, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> LogLevel } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@monorepo/shared'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> logger</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Logger</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'core'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">logger.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">info</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'初始化完成'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h3 id=\"与打包工具集成\">与打包工具集成</h3><p>项目引用是 TypeScript 编译器层面的概念，打包工具（Webpack、Vite、esbuild）有各自的模块解析机制。两者的协作方式：</p>\n<pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart LR&#10;    subgraph TypeScript&#10;        TSC[&quot;tsc --build&lt;br/&gt;Type Checking + Declaration Files&quot;]&#10;    end&#10;    subgraph Bundler&#10;        VITE[&quot;Vite / Webpack&lt;br/&gt;Bundle + Transpile&quot;]&#10;    end&#10;    SRC[&quot;Source Code&quot;] --&gt; TSC&#10;    SRC --&gt; VITE&#10;    TSC --&gt; DTS[&quot;.d.ts Declaration Files&quot;]&#10;    VITE --&gt; BUNDLE[&quot;Output Bundle&quot;]\">flowchart LR\n    subgraph TypeScript\n        TSC[\"tsc --build&lt;br/&gt;Type Checking + Declaration Files\"]\n    end\n    subgraph Bundler\n        VITE[\"Vite / Webpack&lt;br/&gt;Bundle + Transpile\"]\n    end\n    SRC[\"Source Code\"] --&gt; TSC\n    SRC --&gt; VITE\n    TSC --&gt; DTS[\".d.ts Declaration Files\"]\n    VITE --&gt; BUNDLE[\"Output Bundle\"]</pre><table>\n<thead>\n<tr>\n<th>模式</th>\n<th>TypeScript 职责</th>\n<th>打包工具职责</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>noEmit: true</code></td>\n<td>仅类型检查</td>\n<td>负责转译和打包</td>\n</tr>\n<tr>\n<td><code>emitDeclarationOnly</code></td>\n<td>仅生成声明文件</td>\n<td>负责 JS 转译和打包</td>\n</tr>\n<tr>\n<td>完全由 tsc 编译</td>\n<td>编译 + 类型检查 + 声明</td>\n<td>仅打包已编译的 JS</td>\n</tr>\n</tbody></table>\n<p>在 Vite 项目中的典型配置：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;compilerOptions&quot;: {&#10;    &quot;noEmit&quot;: true,&#10;    &quot;composite&quot;: false&#10;  },&#10;  &quot;references&quot;: [{ &quot;path&quot;: &quot;../shared&quot; }, { &quot;path&quot;: &quot;../core&quot; }]&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"compilerOptions\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"noEmit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"composite\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"references\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: [{ </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"path\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"../shared\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\"path\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"../core\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>构建脚本分离类型检查和打包：</p>\n<div class=\"code-block-wrapper\" data-lang=\"json\" data-code=\"{&#10;  &quot;scripts&quot;: {&#10;    &quot;typecheck&quot;: &quot;tsc --build --noEmit&quot;,&#10;    &quot;build&quot;: &quot;vite build&quot;,&#10;    &quot;build:all&quot;: &quot;tsc --build &amp;&amp; vite build&quot;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  \"scripts\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"typecheck\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tsc --build --noEmit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"build\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"vite build\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    \"build:all\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"tsc --build &#x26;&#x26; vite build\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><hr>\n<h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"项目引用设计原则\">项目引用设计原则</h3><table>\n<thead>\n<tr>\n<th>原则</th>\n<th>说明</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单向依赖</td>\n<td>禁止循环引用，保持依赖图为 DAG</td>\n</tr>\n<tr>\n<td>最小暴露</td>\n<td>每个包只导出必要的公共 API</td>\n</tr>\n<tr>\n<td>独立可编译</td>\n<td>每个子项目应能独立通过 <code>tsc -b</code> 编译</td>\n</tr>\n<tr>\n<td>共享基础配置</td>\n<td>使用 <code>extends</code> 继承公共 <code>tsconfig.base.json</code></td>\n</tr>\n<tr>\n<td>叶子节点不设 composite</td>\n<td>最终应用（不被其他包引用）可以关闭 <code>composite</code></td>\n</tr>\n</tbody></table>\n<h3 id=\"性能优化\">性能优化</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 首次完整构建&#10;tsc --build --verbose&#10;&#10;# 后续增量构建（仅编译变更）&#10;tsc --build&#10;&#10;# 监听模式（开发环境）&#10;tsc --build --watch&#10;&#10;# 并行构建（TypeScript 5.6+）&#10;tsc --build --incremental\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 首次完整构建</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tsc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --build</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --verbose</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 后续增量构建（仅编译变更）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tsc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --build</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 监听模式（开发环境）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tsc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --build</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --watch</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 并行构建（TypeScript 5.6+）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tsc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --build</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --incremental</span></span></code></pre></div><p>增量构建的性能提升取决于项目规模：</p>\n<table>\n<thead>\n<tr>\n<th>项目规模</th>\n<th>首次构建</th>\n<th>增量构建（无变更）</th>\n<th>增量构建（单文件变更）</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>小型（&lt; 50 文件）</td>\n<td>~2s</td>\n<td>~0.3s</td>\n<td>~0.5s</td>\n</tr>\n<tr>\n<td>中型（200 文件）</td>\n<td>~8s</td>\n<td>~0.5s</td>\n<td>~1.5s</td>\n</tr>\n<tr>\n<td>大型（1000+ 文件）</td>\n<td>~30s</td>\n<td>~1s</td>\n<td>~3s</td>\n</tr>\n</tbody></table>\n<h3 id=\"常见问题排查\">常见问题排查</h3><table>\n<thead>\n<tr>\n<th>问题</th>\n<th>原因</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>Referenced project must have setting &quot;composite&quot;: true</code></td>\n<td>被引用项目缺少 composite</td>\n<td>在被引用项目中添加 <code>composite: true</code></td>\n</tr>\n<tr>\n<td><code>Output file has not been built from source file</code></td>\n<td>声明文件过期</td>\n<td>运行 <code>tsc -b --force</code> 强制重建</td>\n</tr>\n<tr>\n<td>循环引用报错</td>\n<td>项目之间存在双向依赖</td>\n<td>重构依赖关系，提取公共模块</td>\n</tr>\n<tr>\n<td><code>.tsbuildinfo</code> 导致缓存问题</td>\n<td>构建信息文件损坏</td>\n<td>运行 <code>tsc -b --clean</code> 后重新构建</td>\n</tr>\n<tr>\n<td>修改共享包后依赖方未更新</td>\n<td>增量编译缓存未失效</td>\n<td>确认 <code>references</code> 配置正确</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li><strong>项目引用</strong>通过 <code>composite</code> + <code>references</code> 将大型代码库拆分为独立编译单元，实现依赖感知的构建。</li>\n<li><code>composite: true</code> 是被引用项目的必要条件，它强制生成声明文件并启用增量编译支持。</li>\n<li><code>tsc --build</code> 是项目引用的专用构建命令，自动按依赖拓扑排序编译，跳过未修改的项目。</li>\n<li><code>.tsbuildinfo</code> 文件记录编译状态（文件哈希），是增量编译的基础，大幅减少重复构建时间。</li>\n<li>Monorepo 场景下，根目录使用 <strong>Solution 文件</strong>（<code>files: []</code> + <code>references</code>）统一管理所有子项目。</li>\n<li>与打包工具协作时，通常将 TypeScript 限定为<strong>类型检查</strong>（<code>noEmit: true</code>），由 Vite/Webpack 负责实际的转译和打包。</li>\n<li>项目引用的依赖图必须是<strong>有向无环图（DAG）</strong>，禁止循环引用。</li>\n</ul>\n","headings":[{"level":1,"text":"项目引用与构建流水线","id":"项目引用与构建流水线"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"核心配置项","id":"核心配置项"},{"level":3,"text":"composite 选项","id":"composite-选项"},{"level":3,"text":"references 选项","id":"references-选项"},{"level":3,"text":"tsBuildInfoFile","id":"tsbuildinfofile"},{"level":2,"text":"常见场景配置","id":"常见场景配置"},{"level":3,"text":"tsc --build 模式","id":"tsc-build-模式"},{"level":3,"text":"Monorepo 完整配置","id":"monorepo-完整配置"},{"level":3,"text":"增量编译原理","id":"增量编译原理"},{"level":3,"text":"跨包导入","id":"跨包导入"},{"level":3,"text":"与打包工具集成","id":"与打包工具集成"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"项目引用设计原则","id":"项目引用设计原则"},{"level":3,"text":"性能优化","id":"性能优化"},{"level":3,"text":"常见问题排查","id":"常见问题排查"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"编译选项与严格模式","url":"/l-doc-books/h/languages/typescript/configuration-and-tooling/compiler-options-and-strict-mode"},"next":{"title":"类型安全的设计模式","url":"/l-doc-books/h/languages/typescript/practice-and-best-practices/type-safe-design-patterns"}}