49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'abc123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// identifier</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> url</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '/api/users'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Uniform Resource Locator</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> api</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createAPI</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Application Programming Interface</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> connectDB</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// database</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 循环变量（仅限小范围）</span></span></code></pre></div><h2 id=\"命名反模式与修正\">命名反模式与修正</h2><h3 id=\"避免上下文重复\">避免上下文重复</h3><p>当变量名已经存在于特定上下文中时，无需重复该上下文信息：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// Bad — 在 User 类中重复 &quot;user&quot; 前缀&#10;class User {&#10;  userName; // &quot;User&quot; 上下文已经暗示&#10;  userEmail;&#10;  getUserAge() {}&#10;}&#10;&#10;// Good — 利用上下文消除冗余&#10;class User {&#10;  name;&#10;  email;&#10;  getAge() {}&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Bad — 在 User 类中重复 \"user\" 前缀</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  userName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// \"User\" 上下文已经暗示</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  userEmail</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getUserAge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Good — 利用上下文消除冗余</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> User</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  email</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  getAge</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"反映预期结果\">反映预期结果</h3><p>函数名应当反映其返回值的性质，而非内部实现过程：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// Bad — 描述过程&#10;function processData() {} // 返回什么？&#10;function handleClick() {} // 结果是什么？&#10;function doCalculation() {} // 计算什么？&#10;&#10;// Good — 反映结果&#10;function getFormattedPrice() {} // 返回格式化的价格&#10;function calculateTax() {} // 返回税额&#10;function buildUserProfile() {} // 返回用户档案对象\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Bad — 描述过程</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> processData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {} </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 返回什么？</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> handleClick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {} </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 结果是什么？</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> doCalculation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {} </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 计算什么？</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Good — 反映结果</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getFormattedPrice</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {} </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 返回格式化的价格</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> calculateTax</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {} </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 返回税额</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> buildUserProfile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {} </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 返回用户档案对象</span></span></code></pre></div><h3 id=\"单复数的精确使用\">单复数的精确使用</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 单数 — 表示一个实体&#10;const user = getUser(id);&#10;const selectedItem = items[0];&#10;const config = loadConfig();&#10;&#10;// 复数 — 表示集合&#10;const users = fetchAllUsers();&#10;const selectedItems = getSelection();&#10;const configs = loadAllConfigs();&#10;&#10;// 注意不可数名词&#10;const data = fetchData(); // data 是不可数名词，不用 datas&#10;const information = getInfo(); // 同理&#10;const feedback = collectFeedback();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 单数 — 表示一个实体</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getUser</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(id);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> selectedItem</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> items[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> config</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> loadConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 复数 — 表示集合</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> users</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchAllUsers</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> selectedItems</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getSelection</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> configs</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> loadAllConfigs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 注意不可数名词</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// data 是不可数名词，不用 datas</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> information</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> getInfo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 同理</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> feedback</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> collectFeedback</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><h2 id=\"实战练习-命名审查\">实战练习：命名审查</h2><p>以下是一组常见的&quot;坏名字&quot;及其改进建议，通过对比学习如何选择更精准的英语表达：</p>\n<table>\n<thead>\n<tr>\n<th>原始命名</th>\n<th>问题</th>\n<th>改进方案</th>\n<th>理由</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>data2</code></td>\n<td>无语义编号</td>\n<td><code>transformedData</code></td>\n<td>说明数据状态</td>\n</tr>\n<tr>\n<td><code>temp</code></td>\n<td>含义不明</td>\n<td><code>cachedResponse</code></td>\n<td>说明临时存储什么</td>\n</tr>\n<tr>\n<td><code>flag</code></td>\n<td>什么标记？</td>\n<td><code>isRetryEnabled</code></td>\n<td>明确布尔含义</td>\n</tr>\n<tr>\n<td><code>doSomething()</code></td>\n<td>完全无意义</td>\n<td><code>validateInput()</code></td>\n<td>明确动作和对象</td>\n</tr>\n<tr>\n<td><code>handleStuff()</code></td>\n<td>模糊处理</td>\n<td><code>processPayment()</code></td>\n<td>具体化处理对象</td>\n</tr>\n<tr>\n<td><code>mgr</code></td>\n<td>不必要缩写</td>\n<td><code>manager</code></td>\n<td>或更具体如 <code>connectionManager</code></td>\n</tr>\n<tr>\n<td><code>val</code></td>\n<td>歧义（value? valid?）</td>\n<td><code>inputValue</code> 或 <code>isValid</code></td>\n<td>消除歧义</td>\n</tr>\n</tbody></table>\n<p>每当你写下一个变量名或函数名时，问自己：<strong>如果一个不了解这段代码的同事读到这个名字，他能否在不看定义和注释的情况下猜出它的用途？</strong> 如果答案是否定的，就需要重新命名。</p>\n<h2 id=\"ai-时代的命名考量\">AI 时代的命名考量</h2><p>AI 辅助编程（Copilot / Cursor / Claude Code）让命名同时承担<strong>两层读者</strong>：人类同事 + LLM。两者的偏好大体重合，但有几处差异值得注意：</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>给人类</th>\n<th>给 LLM 也读</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>缩写</td>\n<td>适度（社区惯例缩写 OK）</td>\n<td>避免（LLM 在长上下文里更容易跟错）</td>\n</tr>\n<tr>\n<td>同名复用</td>\n<td>同一作用域避免即可</td>\n<td><strong>跨文件</strong>也避免——LLM 的&quot;语义同名&quot;易混</td>\n</tr>\n<tr>\n<td>单复数</td>\n<td><code>users</code> vs <code>user</code> 明显</td>\n<td><strong>越明显越好</strong>——<code>userList</code> 比 <code>users</code> 对 LLM 更稳</td>\n</tr>\n<tr>\n<td>布尔前缀</td>\n<td><code>is/has/should</code> 习惯化</td>\n<td><strong>强制使用</strong>——LLM 对布尔判定句式特别敏感</td>\n</tr>\n<tr>\n<td>同义词漂移</td>\n<td><code>fetch</code> / <code>get</code> / <code>load</code> 互换</td>\n<td><strong>选一个用到底</strong>——避免 LLM 在生成时混用</td>\n</tr>\n</tbody></table>\n<h3 id=\"llm-友好的命名小约定\">LLM 友好的命名小约定</h3><p>下面这些不是新规则，只是<strong>把人本来就应该做的、做得更彻底</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"# Less LLM-friendly&#10;function process(d, opts) { /* what is d? */ }&#10;&#10;# More LLM-friendly — 类型暗示在名字里&#10;function processOrders(orders: Order[], options: ProcessOptions) { }&#10;&#10;# Less — 缩写让 LLM 自动补全跑偏&#10;const ctx = getCtx();&#10;const req = ctx.req;&#10;&#10;# More — 全名让 LLM 跟得上指代链&#10;const requestContext = getRequestContext();&#10;const request = requestContext.request;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span># Less LLM-friendly</span></span>\n<span class=\"line\"><span>function process(d, opts) { /* what is d? */ }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># More LLM-friendly — 类型暗示在名字里</span></span>\n<span class=\"line\"><span>function processOrders(orders: Order[], options: ProcessOptions) { }</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># Less — 缩写让 LLM 自动补全跑偏</span></span>\n<span class=\"line\"><span>const ctx = getCtx();</span></span>\n<span class=\"line\"><span>const req = ctx.req;</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span># More — 全名让 LLM 跟得上指代链</span></span>\n<span class=\"line\"><span>const requestContext = getRequestContext();</span></span>\n<span class=\"line\"><span>const request = requestContext.request;</span></span></code></pre></div><h3 id=\"prompt-中的命名约定\">Prompt 中的命名约定</h3><p>当你在 prompt 里要求 LLM 生成代码时，<strong>显式指定命名风格</strong>比期待&quot;模型自己懂&quot;可靠：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"Implement a function that validates user input. Use camelCase for&#10;identifiers. Prefer descriptive names over abbreviations (e.g.&#10;&quot;validationErrors&quot; not &quot;errs&quot;). Boolean variables must start with&#10;is/has/should.\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>Implement a function that validates user input. Use camelCase for</span></span>\n<span class=\"line\"><span>identifiers. Prefer descriptive names over abbreviations (e.g.</span></span>\n<span class=\"line\"><span>\"validationErrors\" not \"errs\"). Boolean variables must start with</span></span>\n<span class=\"line\"><span>is/has/should.</span></span></code></pre></div><p>这一条特别影响<strong>长会话</strong>——LLM 在长对话里会逐渐&quot;飘&quot;到自己的命名偏好上，把约定写在 prompt 里能稳定输出。</p>\n<h3 id=\"ai-生成代码的命名审查清单\">AI 生成代码的命名审查清单</h3><p>review AI 生成的代码时，命名维度多查 5 个高频问题：</p>\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"> 是否有&quot;Helper / Util / Manager&quot;这类无义后缀？（LLM 偏爱这类名字）</li>\n<li><input disabled=\"\" type=\"checkbox\"> 复数 / 单数是否一致？（<code>user</code> 与 <code>users</code> 混用是常见漂移）</li>\n<li><input disabled=\"\" type=\"checkbox\"> 布尔变量是否都有 <code>is/has/should/can</code> 前缀？</li>\n<li><input disabled=\"\" type=\"checkbox\"> 异步函数是否带 <code>Async</code> 后缀或返回 <code>Promise</code>？</li>\n<li><input disabled=\"\" type=\"checkbox\"> 同一个概念在不同地方是否始终用同一个词？（fetch vs get vs load）</li>\n</ul>\n<p><strong>判定标准</strong>：如果 AI 生成的命名让你在 PR review 阶段需要&quot;翻译一遍&quot;，那命名约定就没传达给 LLM——回去补 prompt，不要在 review 里手工修。</p>\n<h2 id=\"小结\">小结</h2><ul>\n<li>命名是&quot;把意图压缩进英文单词&quot;的技术，由风格层、词汇层、上下文层三层共同决定</li>\n<li>风格层：同一项目内绝不混用大小写约定，一致性比单点&quot;优雅&quot;更重要</li>\n<li>词汇层：动词按语义分工（<code>get</code>/<code>fetch</code>/<code>find</code>/<code>query</code>）；布尔用 <code>is</code>/<code>has</code>/<code>can</code>/<code>should</code> 构成可读断言；避免非通用缩写</li>\n<li>上下文层：不重复所在作用域已提供的信息，函数名反映返回值而非内部过程</li>\n<li>反模式：<code>temp</code>/<code>flag</code>/<code>data</code> 式泛化词、<code>usrNm</code> 式缩写、<code>processData</code> 式无结果函数</li>\n<li>AI 时代名字要同时服务人类同事和 LLM——缩写、同名复用、同义词漂移对 LLM 的代价更高</li>\n</ul>\n","headings":[{"level":1,"text":"变量与函数命名英语","id":"变量与函数命名英语"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"命名风格基础","id":"命名风格基础"},{"level":3,"text":"四种核心命名风格","id":"四种核心命名风格"},{"level":3,"text":"语言社区的命名传统","id":"语言社区的命名传统"},{"level":2,"text":"函数命名的 A/HC/LC 模式","id":"函数命名的-a-hc-lc-模式"},{"level":3,"text":"模式结构","id":"模式结构"},{"level":3,"text":"实际应用","id":"实际应用"},{"level":3,"text":"核心动词选择指南","id":"核心动词选择指南"},{"level":2,"text":"变量命名的语法规律","id":"变量命名的语法规律"},{"level":3,"text":"布尔变量：用形容词或介词短语","id":"布尔变量-用形容词或介词短语"},{"level":3,"text":"数值变量：量词 + 名词","id":"数值变量-量词-名词"},{"level":3,"text":"集合变量：用复数形式","id":"集合变量-用复数形式"},{"level":3,"text":"避免缩写陷阱","id":"避免缩写陷阱"},{"level":2,"text":"命名反模式与修正","id":"命名反模式与修正"},{"level":3,"text":"避免上下文重复","id":"避免上下文重复"},{"level":3,"text":"反映预期结果","id":"反映预期结果"},{"level":3,"text":"单复数的精确使用","id":"单复数的精确使用"},{"level":2,"text":"实战练习：命名审查","id":"实战练习-命名审查"},{"level":2,"text":"AI 时代的命名考量","id":"ai-时代的命名考量"},{"level":3,"text":"LLM 友好的命名小约定","id":"llm-友好的命名小约定"},{"level":3,"text":"Prompt 中的命名约定","id":"prompt-中的命名约定"},{"level":3,"text":"AI 生成代码的命名审查清单","id":"ai-生成代码的命名审查清单"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"类与模块命名体系","url":"/l-doc-books/h/english-learning/programmer-english/code-naming-conventions/class-module-naming"}}