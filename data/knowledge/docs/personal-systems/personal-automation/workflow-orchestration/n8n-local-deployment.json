 error;&#10;    await new Promise((r) =&gt; setTimeout(r, 1000 * attempt));&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在 Function 节点中实现重试逻辑</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> maxRetries</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attempt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (attempt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxRetries) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> response</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $http.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      method: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'POST'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      url: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'https://api.example.com/data'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      body: $input.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">first</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().json,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [{ json: response }];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    attempt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (attempt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> maxRetries) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> error;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Promise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setTimeout</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(r, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attempt));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"工作流组织策略\">工作流组织策略</h3><ul>\n<li><strong>命名规范</strong>：<code>[Domain] Action - Detail</code>，如 <code>[GitHub] Stars → Notify Slack</code></li>\n<li><strong>标签分类</strong>：按领域（DevOps、Marketing、HR）或状态（Active、Draft、Archived）</li>\n<li><strong>子工作流</strong>：将可复用逻辑封装为子工作流，通过 Execute Workflow 节点调用</li>\n<li><strong>版本管理</strong>：导出 JSON 纳入 Git 管理，配合 CI/CD 自动部署</li>\n</ul>\n<h3 id=\"安全加固\">安全加固</h3><ol>\n<li><strong>加密密钥</strong>：设置 <code>N8N_ENCRYPTION_KEY</code> 保护 Credential 存储</li>\n<li><strong>基础认证</strong>：在反向代理层添加额外认证</li>\n<li><strong>网络隔离</strong>：n8n 容器仅暴露必要端口</li>\n<li><strong>定期备份</strong>：<code>pg_dump</code> 定时备份数据库 + 卷快照</li>\n</ol>\n<h3 id=\"性能优化\">性能优化</h3><ul>\n<li>对大数据量使用 Batch 节点分批处理</li>\n<li>避免在 Function 节点中使用同步阻塞操作</li>\n<li>设置 <code>EXECUTIONS_DATA_SAVE_ON_SUCCESS=none</code> 减少数据库写入</li>\n<li>使用 PostgreSQL 而非 SQLite（SQLite 不支持并发写入）</li>\n</ul>\n<h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"n8n-生态组件\">n8n 生态组件</h3><table>\n<thead>\n<tr>\n<th>组件</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>n8n Cloud</td>\n<td>官方托管版本（快速启动）</td>\n</tr>\n<tr>\n<td>n8n Desktop</td>\n<td>macOS/Windows 桌面应用</td>\n</tr>\n<tr>\n<td>Community Nodes</td>\n<td>社区贡献的第三方节点</td>\n</tr>\n<tr>\n<td>n8n CLI</td>\n<td>命令行管理工具</td>\n</tr>\n<tr>\n<td>LangChain 集成</td>\n<td>原生 AI/LLM 工作流节点</td>\n</tr>\n</tbody></table>\n<h3 id=\"备份策略\">备份策略</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"#!/bin/bash&#10;# backup.sh - 每日执行&#10;DATE=$(date +%Y%m%d)&#10;BACKUP_DIR=/backups/n8n&#10;&#10;# 备份 PostgreSQL&#10;docker exec postgres pg_dumpall -c -U n8n &gt; $BACKUP_DIR/pg_$DATE.sql&#10;&#10;# 备份 n8n 数据卷&#10;docker run --rm -v n8n_data:/data -v $BACKUP_DIR:/backup \\&#10;  alpine tar czf /backup/n8n_data_$DATE.tar.gz /data&#10;&#10;# 保留最近 30 天&#10;find $BACKUP_DIR -mtime +30 -delete\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">#!/bin/bash</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># backup.sh - 每日执行</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">DATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">date</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> +%Y%m%d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">BACKUP_DIR</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/backups/n8n</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 备份 PostgreSQL</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">docker</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> exec</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> postgres</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> pg_dumpall</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -U</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> n8n</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $BACKUP_DIR</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/pg_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$DATE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.sql</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 备份 n8n 数据卷</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">docker</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --rm</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> n8n_data:/data</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $BACKUP_DIR</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">:/backup</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  alpine</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> tar</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> czf</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /backup/n8n_data_</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$DATE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.tar.gz</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /data</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 保留最近 30 天</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $BACKUP_DIR </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">-mtime</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> +30</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -delete</span></span></code></pre></div><h3 id=\"监控方案\">监控方案</h3><ul>\n<li><strong>健康检查</strong>：<code>GET /healthz</code> 端点返回 200</li>\n<li><strong>执行监控</strong>：定期查询执行历史中的失败记录</li>\n<li><strong>资源监控</strong>：Docker stats + Prometheus exporter</li>\n</ul>\n<h2 id=\"总结\">总结</h2><p>n8n 自托管是个人和小团队实现无限自动化的最具性价比方案。Docker Compose 部署在 10 分钟内即可完成，PostgreSQL 提供了可靠的数据持久化，队列模式则为未来扩展留出了空间。核心要点：</p>\n<ol>\n<li>生产环境必须使用 PostgreSQL + 加密密钥 + SSL</li>\n<li>用子工作流和标签实现工作流的模块化管理</li>\n<li>错误处理不是可选项——为每个外部 API 调用添加重试逻辑</li>\n<li>定期备份数据库和数据卷是运维底线</li>\n<li>LangChain 原生集成使 n8n 成为 AI Agent 编排的理想平台</li>\n</ol>\n","headings":[{"level":1,"text":"n8n 本地部署与编排","id":"n8n-本地部署与编排"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"n8n 架构模型","id":"n8n-架构模型"},{"level":3,"text":"核心术语","id":"核心术语"},{"level":3,"text":"数据流模型","id":"数据流模型"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"Docker Compose 部署","id":"docker-compose-部署"},{"level":3,"text":"SSL 配置（Caddy 反向代理）","id":"ssl-配置-caddy-反向代理"},{"level":3,"text":"队列模式（水平扩展）","id":"队列模式-水平扩展"},{"level":3,"text":"构建第一个工作流","id":"构建第一个工作流"},{"level":3,"text":"错误处理与重试","id":"错误处理与重试"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"工作流组织策略","id":"工作流组织策略"},{"level":3,"text":"安全加固","id":"安全加固"},{"level":3,"text":"性能优化","id":"性能优化"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"n8n 生态组件","id":"n8n-生态组件"},{"level":3,"text":"备份策略","id":"备份策略"},{"level":3,"text":"监控方案","id":"监控方案"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"快速操作系统设计","url":"/l-doc-books/h/personal-systems/personal-automation/launcher-automation/quick-action-system-design"},"next":{"title":"Zapier 与 Make 场景设计","url":"/l-doc-books/h/personal-systems/personal-automation/workflow-orchestration/zapier-make-scenario-design"}}