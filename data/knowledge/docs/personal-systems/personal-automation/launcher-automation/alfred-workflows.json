span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> json.loads(resp.read())</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">results </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> search_notion(query)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">items </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results.get(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"results\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, []):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    title </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"properties\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Name\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"title\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">][</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"plain_text\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    url </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"url\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    items.append({</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"title\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: title, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"arg\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: url, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"subtitle\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Open in Notion\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">print</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(json.dumps({</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"items\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: items}))</span></span></code></pre></div><h3 id=\"automation-tasks-alfred-5\">Automation Tasks（Alfred 5+）</h3><p>Alfred 5 引入了 Automation Tasks，可直接调用 macOS 系统能力：</p>\n<ul>\n<li>剪贴板操作（获取/设置/清空）</li>\n<li>文件操作（移动/重命名/压缩）</li>\n<li>系统控制（暗黑模式/音量/亮度）</li>\n<li>通知中心（发送通知/设置勿扰）</li>\n</ul>\n<p>这些 Task 无需编写脚本即可作为 Action 节点使用。</p>\n<h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"性能优化\">性能优化</h3><ul>\n<li><strong>缓存结果</strong>：对不频繁变化的数据（如项目列表），写入 <code>~/Library/Caches/com.runningwithcrayons.Alfred/Workflow Data/</code></li>\n<li><strong>增量搜索</strong>：使用 <code>rerun</code> 字段实现打字即搜，避免每次都执行完整查询</li>\n<li><strong>延迟加载</strong>：对耗时操作使用 <code>valid: false</code> 先展示占位项，后续通过 <code>rerun</code> 更新</li>\n</ul>\n<h3 id=\"workflow-设计原则\">Workflow 设计原则</h3><ol>\n<li><strong>单一职责</strong>：每个 Workflow 解决一个明确问题</li>\n<li><strong>渐进式发现</strong>：基础功能用关键字触发，高级功能通过修饰键暴露</li>\n<li><strong>容错设计</strong>：脚本中处理网络失败、空结果等边界情况</li>\n<li><strong>变量隔离</strong>：敏感信息（API Key）放在 Workflow Environment Variables 中</li>\n</ol>\n<h3 id=\"分发与版本管理\">分发与版本管理</h3><ul>\n<li>使用 <code>.alfredworkflow</code> 格式导出（本质是 zip）</li>\n<li>通过 GitHub Release 分发，附带 <code>info.plist</code> 的 README</li>\n<li>版本号遵循语义化版本，写在 Workflow 配置的 version 字段</li>\n</ul>\n<h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"开发辅助工具\">开发辅助工具</h3><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Alfred Debugger</td>\n<td>实时查看 Script Filter 输出和变量流</td>\n</tr>\n<tr>\n<td><code>alfred-workflow</code> (Python)</td>\n<td>Python 版 Workflow 开发框架</td>\n</tr>\n<tr>\n<td><code>alfy</code> (Node.js)</td>\n<td>Node.js 版 Workflow 开发框架</td>\n</tr>\n<tr>\n<td>OneUpdater</td>\n<td>Workflow 自动更新机制</td>\n</tr>\n</tbody></table>\n<h3 id=\"推荐学习资源\">推荐学习资源</h3><ul>\n<li>Alfred 官方 Workflow 文档</li>\n<li>Packal.org 社区 Workflow 仓库</li>\n<li>GitHub <code>alfred-workflow</code> 标签下的开源项目</li>\n</ul>\n<h3 id=\"alfred-vs-raycast-选型矩阵\">Alfred vs Raycast 选型矩阵</h3><table>\n<thead>\n<tr>\n<th>维度</th>\n<th>Alfred</th>\n<th>Raycast</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>可视化编排</td>\n<td>★★★★★</td>\n<td>★★☆☆☆</td>\n</tr>\n<tr>\n<td>代码定制深度</td>\n<td>★★★☆☆</td>\n<td>★★★★★</td>\n</tr>\n<tr>\n<td>内置 AI</td>\n<td>☆☆☆☆☆</td>\n<td>★★★★★</td>\n</tr>\n<tr>\n<td>社区生态规模</td>\n<td>★★★★☆</td>\n<td>★★★★★</td>\n</tr>\n<tr>\n<td>学习曲线</td>\n<td>较低</td>\n<td>需会 React</td>\n</tr>\n<tr>\n<td>离线能力</td>\n<td>★★★★★</td>\n<td>★★★★★</td>\n</tr>\n<tr>\n<td>一次购买永久</td>\n<td>✓（Powerpack）</td>\n<td>✗（订阅制）</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>Alfred Workflow 的核心价值在于它的可视化编排范式——你可以像搭积木一样组装自动化逻辑，同时在需要时嵌入任意复杂度的脚本代码。关键收获：</p>\n<ol>\n<li>掌握 Script Filter 的 JSON 协议是解锁 Alfred 高级能力的钥匙</li>\n<li>利用修饰键（cmd/alt/ctrl/shift）为单个结果提供多维操作</li>\n<li>将核心逻辑封装在独立脚本文件中，便于版本控制和调试</li>\n<li>Automation Tasks 是无代码实现系统级操作的最快路径</li>\n<li>选择 Alfred 还是 Raycast 取决于你更偏好可视化编排还是代码控制</li>\n</ol>\n","headings":[{"level":1,"text":"Alfred Workflows 实战","id":"alfred-workflows-实战"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"Workflow 节点模型","id":"workflow-节点模型"},{"level":3,"text":"Script Filter 协议","id":"script-filter-协议"},{"level":3,"text":"变量与数据流","id":"变量与数据流"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"构建一个项目切换器 Workflow","id":"构建一个项目切换器-workflow"},{"level":4,"text":"Step 1：创建 Script Filter","id":"step-1-创建-script-filter"},{"level":4,"text":"Step 2：连接 Action 节点","id":"step-2-连接-action-节点"},{"level":4,"text":"Step 3：添加 Hotkey Trigger","id":"step-3-添加-hotkey-trigger"},{"level":3,"text":"外部脚本集成模式","id":"外部脚本集成模式"},{"level":3,"text":"Automation Tasks（Alfred 5+）","id":"automation-tasks-alfred-5"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"性能优化","id":"性能优化"},{"level":3,"text":"Workflow 设计原则","id":"workflow-设计原则"},{"level":3,"text":"分发与版本管理","id":"分发与版本管理"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"开发辅助工具","id":"开发辅助工具"},{"level":3,"text":"推荐学习资源","id":"推荐学习资源"},{"level":3,"text":"Alfred vs Raycast 选型矩阵","id":"alfred-vs-raycast-选型矩阵"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"Raycast 深度定制","url":"/l-doc-books/h/personal-systems/personal-automation/launcher-automation/raycast-deep-customization"},"next":{"title":"快速操作系统设计","url":"/l-doc-books/h/personal-systems/personal-automation/launcher-automation/quick-action-system-design"}}