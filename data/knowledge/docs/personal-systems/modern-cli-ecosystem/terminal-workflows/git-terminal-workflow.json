6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> diff</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delta</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --line-numbers-left-format=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 隐藏左侧行号</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># delta 与 grep 结合</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> log</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -p</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --color=always</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delta</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> rg</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"function\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 在 diff 中搜索</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 查看特定提交的完整变更</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> show</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> abc123</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delta</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --side-by-side</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 对比两个分支</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> diff</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main..feature</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delta</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"日常-git-工作流模板\">日常 Git 工作流模板</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 早上开始工作&#10;gco          # fzf 选择分支&#10;git pull     # 拉取最新&#10;&#10;# 开发过程中&#10;# ... 编码 ...&#10;gadd         # fzf 选择性 stage&#10;lazygit      # 或 lg 进入 TUI 操作&#10;&#10;# 代码审查&#10;git diff main..HEAD | delta --side-by-side   # 查看所有变更&#10;gdiff        # fzf 逐文件查看变更&#10;&#10;# 处理冲突&#10;lazygit      # 在 TUI 中解决冲突更直观&#10;&#10;# 结束工作&#10;glog         # 检查今天的提交历史\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 早上开始工作</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">gco</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">          # fzf 选择分支</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> pull</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">     # 拉取最新</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 开发过程中</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># ... 编码 ...</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">gadd</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">         # fzf 选择性 stage</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lazygit</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # 或 lg 进入 TUI 操作</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 代码审查</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> diff</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main..HEAD</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> delta</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --side-by-side</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">   # 查看所有变更</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">gdiff</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # fzf 逐文件查看变更</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 处理冲突</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lazygit</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # 在 TUI 中解决冲突更直观</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 结束工作</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">glog</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">         # 检查今天的提交历史</span></span></code></pre></div><h3 id=\"lazygit-配置优化\">lazygit 配置优化</h3><div class=\"code-block-wrapper\" data-lang=\"yaml\" data-code=\"# ~/.config/lazygit/config.yml&#10;gui:&#10;  theme:&#10;    selectedLineBgColor:&#10;      - reverse&#10;  showIcons: true&#10;  nerdFontsVersion: &#39;3&#39;&#10;git:&#10;  paging:&#10;    colorArg: always&#10;    pager: delta --paging=never&#10;  merging:&#10;    manualCommit: false&#10;os:&#10;  editPreset: &#39;nvim&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># ~/.config/lazygit/config.yml</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">gui</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  theme</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    selectedLineBgColor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">reverse</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  showIcons</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  nerdFontsVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'3'</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">git</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  paging</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    colorArg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">always</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    pager</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">delta --paging=never</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  merging</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    manualCommit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">os</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  editPreset</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'nvim'</span></span></code></pre></div><h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>功能</th>\n<th>与本工作流的关系</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>gh</td>\n<td>GitHub CLI</td>\n<td>PR/Issue 操作</td>\n</tr>\n<tr>\n<td>forgit</td>\n<td>fzf Git 插件</td>\n<td>开箱即用的 fzf git 函数</td>\n</tr>\n<tr>\n<td>tig</td>\n<td>Git TUI（C 语言）</td>\n<td>lazygit 的替代</td>\n</tr>\n<tr>\n<td>gitui</td>\n<td>Rust Git TUI</td>\n<td>lazygit 的 Rust 替代</td>\n</tr>\n<tr>\n<td>difftastic</td>\n<td>语义 diff</td>\n<td>AST 级别的代码对比</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>Git 终端工作流的核心升级路径可以归纳为三条互补策略：</p>\n<ul>\n<li><strong>delta 让 diff 可读</strong>：作为 pager 接管 <code>git diff</code> / <code>git log -p</code> / <code>git show</code>，把原始文本变为语法高亮的现代视图。</li>\n<li><strong>lazygit 让操作可视</strong>：复杂的 stage / rebase / merge 在 TUI 中更直观，无需逐条记忆命令。</li>\n<li><strong>fzf 函数让选择交互</strong>：分支切换、commit 浏览、stash 管理等「选一个」场景用 fzf 最快。</li>\n</ul>\n<p>三者互补而非替代——根据操作的复杂度选择合适的工具层级，你的 Git 体验将从「命令行的痛苦记忆」变为「视觉化的流畅操作」。</p>\n","headings":[{"level":1,"text":"Git 终端工作流","id":"git-终端工作流"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"工具角色分工","id":"工具角色分工"},{"level":3,"text":"delta 配置详解","id":"delta-配置详解"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"lazygit 核心操作","id":"lazygit-核心操作"},{"level":3,"text":"fzf Git 函数库","id":"fzf-git-函数库"},{"level":3,"text":"delta 高级用法","id":"delta-高级用法"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"日常 Git 工作流模板","id":"日常-git-工作流模板"},{"level":3,"text":"lazygit 配置优化","id":"lazygit-配置优化"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"自定义脚本集成","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/pipeline-composition/custom-script-integration"},"next":{"title":"开发调试流","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/terminal-workflows/development-debugging-flow"}}