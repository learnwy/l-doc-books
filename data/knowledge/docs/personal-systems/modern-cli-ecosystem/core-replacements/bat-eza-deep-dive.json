语法高亮引擎（配合 delta 更佳）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 如果不想安装 delta，可以用 bat：</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> BAT_PAGER</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"less -RF\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> config</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --global</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> core.pager</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"bat --style=plain --paging=never\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># help 命令高亮</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">alias</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -g</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --help=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'--help 2>&#x26;1 | bat --language=help --style=plain'</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 或创建 bathelp 函数</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bathelp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">$@</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --help</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> 2>&#x26;1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> bat</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --plain</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --language=help</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; }</span></span></code></pre></div><h3 id=\"管道中的行为控制\">管道中的行为控制</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# bat 在管道中自动退化为 plain text&#10;bat file.py | head -5       # 等价于 cat file.py | head -5&#10;&#10;# 强制保留颜色（传给支持 ANSI 的下游）&#10;bat --color=always file.py | fzf --ansi&#10;&#10;# 强制禁用 pager（脚本中使用）&#10;bat --paging=never file.py&#10;&#10;# eza 在管道中的行为&#10;eza --color=always | fzf --ansi  # 保留颜色传给 fzf&#10;eza --color=never &gt; file.txt    # 写文件时无颜色\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># bat 在管道中自动退化为 plain text</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bat</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.py</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> head</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -5</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">       # 等价于 cat file.py | head -5</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 强制保留颜色（传给支持 ANSI 的下游）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bat</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --color=always</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.py</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fzf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --ansi</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 强制禁用 pager（脚本中使用）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">bat</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --paging=never</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.py</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># eza 在管道中的行为</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">eza</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --color=always</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fzf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --ansi</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 保留颜色传给 fzf</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">eza</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --color=never</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> file.txt</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 写文件时无颜色</span></span></code></pre></div><h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"bat-生态扩展\">bat 生态扩展</h3><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>功能</th>\n<th>安装</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>bat-extras</td>\n<td>prettybat, batdiff, batgrep 等</td>\n<td><code>brew install bat-extras</code></td>\n</tr>\n<tr>\n<td>batpipe</td>\n<td>为 bat 添加管道预处理</td>\n<td>cargo install</td>\n</tr>\n<tr>\n<td>batman</td>\n<td>bat 驱动的 man page viewer</td>\n<td>bat-extras 内含</td>\n</tr>\n</tbody></table>\n<h3 id=\"eza-与-bat-配合模式\">eza 与 bat 配合模式</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# fzf 预览使用 bat&#10;fd -t f | fzf --preview &#39;bat --color=always --line-range :100 {}&#39;&#10;&#10;# eza 树形 + bat 预览配合&#10;alias tree-preview=&#39;eza --tree --level=2 --icons&#39;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># fzf 预览使用 bat</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> f</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fzf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --preview</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'bat --color=always --line-range :100 {}'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># eza 树形 + bat 预览配合</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">alias</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tree-preview</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'eza --tree --level=2 --icons'</span></span></code></pre></div><h2 id=\"总结\">总结</h2><p>bat 和 eza 是「低投入高回报」的典型工具。它们的核心要点可以归纳为三条：</p>\n<ul>\n<li><strong>零配置即有用</strong>：通过 alias 替换 cat 和 ls 后，日常操作立即获得视觉增强，而无需改变任何习惯。</li>\n<li><strong>管道友好</strong>：上下文感知输出确保了与现有脚本的完全兼容——终端里全副武装，管道里自动退化为纯文本。</li>\n<li><strong>可深可浅</strong>：深入配置后，bat 可以成为统一的文件查看/语法高亮引擎，eza 可以成为项目结构一览工具。</li>\n</ul>\n<p>在后续章节中，它们将作为管道中的关键组件，为 fzf 预览窗口、Git diff 可视化等场景提供支持。</p>\n","headings":[{"level":1,"text":"bat 与 eza 深度实践","id":"bat-与-eza-深度实践"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"bat 的智能行为","id":"bat-的智能行为"},{"level":3,"text":"eza 的信息密度设计","id":"eza-的信息密度设计"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"bat 完整用法","id":"bat-完整用法"},{"level":3,"text":"bat 配置文件","id":"bat-配置文件"},{"level":3,"text":"eza 完整用法","id":"eza-完整用法"},{"level":3,"text":"eza 环境变量配置","id":"eza-环境变量配置"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"bat 作为通用 pager","id":"bat-作为通用-pager"},{"level":3,"text":"管道中的行为控制","id":"管道中的行为控制"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"bat 生态扩展","id":"bat-生态扩展"},{"level":3,"text":"eza 与 bat 配合模式","id":"eza-与-bat-配合模式"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"fd 与 ripgrep 深度实践","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/core-replacements/fd-ripgrep-deep-dive"},"next":{"title":"性能对比与迁移策略","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/core-replacements/performance-comparison-migration"}}