n style=\"color:#032F62;--shiki-dark:#9ECBFF\"> eza</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> zoxide</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> git-delta</span></span></code></pre></div><h3 id=\"兼容性矩阵\">兼容性矩阵</h3><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>macOS</th>\n<th>Linux</th>\n<th>Windows</th>\n<th>管道兼容</th>\n<th>.gitignore</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>fd</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>ripgrep</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>bat</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>-</td>\n</tr>\n<tr>\n<td>eza</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>zoxide</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>-</td>\n<td>-</td>\n</tr>\n<tr>\n<td>fzf</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>-</td>\n</tr>\n<tr>\n<td>delta</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>-</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>性能数据清晰地表明：在搜索场景（fd、ripgrep），现代工具提供 10-60 倍的速度提升，这是改变工作方式的级别；在显示场景（bat、eza），现代工具用毫秒级的额外开销换来显著的信息密度和视觉体验提升。迁移策略的核心是「交互式环境大胆替换，脚本环境保持兼容」。通过三阶段渐进迁移，你可以在不破坏任何现有工作流的前提下，逐步享受现代工具带来的效率提升。</p>\n","headings":[{"level":1,"text":"性能对比与迁移策略","id":"性能对比与迁移策略"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"性能差异的来源","id":"性能差异的来源"},{"level":3,"text":"基准测试方法论","id":"基准测试方法论"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"搜索性能对比","id":"搜索性能对比"},{"level":3,"text":"文件查找性能对比","id":"文件查找性能对比"},{"level":3,"text":"文件显示性能对比","id":"文件显示性能对比"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"迁移策略：渐进式替换","id":"迁移策略-渐进式替换"},{"level":4,"text":"第一阶段：别名替换（Day 1）","id":"第一阶段-别名替换-day-1"},{"level":4,"text":"第二阶段：Shell 集成（Week 1）","id":"第二阶段-shell-集成-week-1"},{"level":4,"text":"第三阶段：Git 集成（Week 2）","id":"第三阶段-git-集成-week-2"},{"level":3,"text":"脚本兼容性处理","id":"脚本兼容性处理"},{"level":3,"text":"团队协作策略","id":"团队协作策略"