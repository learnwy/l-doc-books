-dark:#B392F0\"> fzf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"Cancelled\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ${EDITOR</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">vim} </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$file</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"管道设计原则\">管道设计原则</h3><ol>\n<li><strong>单向数据流</strong>：数据从左到右流动，每步做一个明确的变换</li>\n<li><strong>尽早过滤</strong>：把过滤条件放在管道前端，减少后续处理量</li>\n<li><strong>保持文本行格式</strong>：管道中的数据应该是「一行一条记录」</li>\n<li><strong>显式分隔符</strong>：用 -0/--null 处理含空格的文件名</li>\n<li><strong>颜色在末端</strong>：只在管道最后一步或 fzf 预览中使用颜色</li>\n</ol>\n<div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 好的管道设计&#10;fd -e ts --max-depth 3 |    # 尽早限制范围&#10;  grep -v &quot;node_modules&quot; |  # 尽早过滤&#10;  fzf --preview &#39;bat --color=always {}&#39;  # 颜色只在预览中&#10;&#10;# 不好的管道设计&#10;fd -e ts |                   # 搜索所有深度&#10;  sort |                     # 不必要的排序&#10;  fzf |                      # 然后筛选&#10;  grep -v &quot;test&quot;             # 过滤放在了后面\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 好的管道设计</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ts</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --max-depth</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 尽早限制范围</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"node_modules\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 尽早过滤</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  fzf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --preview</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'bat --color=always {}'</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 颜色只在预览中</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 不好的管道设计</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                   # 搜索所有深度</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  sort</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                     # 不必要的排序</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  fzf</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                      # 然后筛选</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  grep</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -v</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"test\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">             # 过滤放在了后面</span></span></code></pre></div><h3 id=\"空字符分隔-处理含空格文件名\">空字符分隔（处理含空格文件名）</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 错误：文件名含空格时会断裂&#10;fd -e txt | xargs rm        # &quot;my file.txt&quot; 会被拆成两个参数&#10;&#10;# 正确：使用 null 分隔&#10;fd -e txt -0 | xargs -0 rm  # 安全处理任何文件名&#10;fd -e txt --print0 | xargs -0 wc -l&#10;&#10;# fzf 也支持 null 输入输出&#10;fd -0 | fzf --read0 --print0 | xargs -0 vim\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 错误：文件名含空格时会断裂</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> txt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xargs</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rm</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # \"my file.txt\" 会被拆成两个参数</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 正确：使用 null 分隔</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> txt</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xargs</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rm</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 安全处理任何文件名</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> txt</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --print0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xargs</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> wc</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -l</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># fzf 也支持 null 输入输出</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fzf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --read0</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --print0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xargs</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> vim</span></span></code></pre></div><h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"管道增强工具\">管道增强工具</h3><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>功能</th>\n<th>管道角色</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>jq</td>\n<td>JSON 处理</td>\n<td>结构化数据变换</td>\n</tr>\n<tr>\n<td>yq</td>\n<td>YAML 处理</td>\n<td>配置文件管道</td>\n</tr>\n<tr>\n<td>sd</td>\n<td>流式替换</td>\n<td>替代 sed 的现代版</td>\n</tr>\n<tr>\n<td>choose</td>\n<td>字段提取</td>\n<td>替代 awk/cut</td>\n</tr>\n<tr>\n<td>hck</td>\n<td>高性能 cut</td>\n<td>大文件字段提取</td>\n</tr>\n<tr>\n<td>procs</td>\n<td>进程列表</td>\n<td>结构化 ps 输出</td>\n</tr>\n</tbody></table>\n<h3 id=\"调试管道\">调试管道</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 使用 tee 在管道中间查看数据&#10;fd -e ts |&#10;  tee /dev/stderr |       # 打印到 stderr（不影响管道）&#10;  fzf |&#10;  tee /dev/stderr |       # 查看选择结果&#10;  xargs vim&#10;&#10;# 使用 pv 查看管道吞吐量（需安装）&#10;fd -e log -0 | pv -l | xargs -0 gzip\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 使用 tee 在管道中间查看数据</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ts</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  tee</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /dev/stderr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">       # 打印到 stderr（不影响管道）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  fzf</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  tee</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /dev/stderr</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">       # 查看选择结果</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  xargs</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> vim</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 使用 pv 查看管道吞吐量（需安装）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">fd</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -e</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> log</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pv</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -l</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> xargs</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -0</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> gzip</span></span></code></pre></div><h2 id=\"总结\">总结</h2><p>现代 CLI 工具没有抛弃 Unix 管道哲学，而是在三个维度上增强了它：结构化输出让解析更精确，交互式节点让人可以在管道中做决策，并行执行让批量操作更快。掌握这些增强模式后，你可以用管道组合表达几乎任何复杂的文件/文本处理任务——这比编写一次性脚本更快、更直观、更可组合。管道思维的本质是「把复杂任务分解为简单步骤的串联」，这不仅是一种技术技能，更是一种问题解决思维方式。</p>\n","headings":[{"level":1,"text":"Unix 管道现代实践","id":"unix-管道现代实践"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"经典管道 vs 现代管道","id":"经典管道-vs-现代管道"},{"level":3,"text":"管道中的颜色传递","id":"管道中的颜色传递"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"基础管道模式","id":"基础管道模式"},{"level":3,"text":"结构化输出管道","id":"结构化输出管道"},{"level":3,"text":"交互式管道节点","id":"交互式管道节点"},{"level":3,"text":"并行管道执行","id":"并行管道执行"},{"level":3,"text":"错误处理与健壮管道","id":"错误处理与健壮管道"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"管道设计原则","id":"管道设计原则"},{"level":3,"text":"空字符分隔（处理含空格文件名）","id":"空字符分隔-处理含空格文件名"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"管道增强工具","id":"管道增强工具"},{"level":3,"text":"调试管道","id":"调试管道"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"全局搜索工作流","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/navigation-and-search/global-search-workflows"},"next":{"title":"工具链编排","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/pipeline-composition/toolchain-orchestration"}}