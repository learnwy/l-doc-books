    --bind</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"ctrl-r:rebind(change)+disable-search+clear-query\"</span></span></code></pre></div><h3 id=\"环境变量完整配置\">环境变量完整配置</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# ~/.zshrc — FZF 全局配置&#10;export FZF_DEFAULT_COMMAND=&#39;fd --type f --hidden --follow --exclude .git&#39;&#10;&#10;export FZF_DEFAULT_OPTS=&quot;&#10;  --height 60%&#10;  --layout=reverse&#10;  --border=rounded&#10;  --info=inline-right&#10;  --preview-window &#39;right:50%:border-left&#39;&#10;  --bind &#39;ctrl-/:toggle-preview&#39;&#10;  --bind &#39;ctrl-y:execute-silent(echo {+} | pbcopy)&#39;&#10;  --color=bg+:#363a4f,bg:#24273a,spinner:#f4dbd6,hl:#ed8796&#10;  --color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6&#10;  --color=marker:#f4dbd6,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796&#10;&quot;&#10;&#10;# Ctrl+T 配置&#10;export FZF_CTRL_T_COMMAND=&quot;$FZF_DEFAULT_COMMAND&quot;&#10;export FZF_CTRL_T_OPTS=&quot;&#10;  --preview &#39;bat --color=always --line-range :100 {}&#39;&#10;  --bind &#39;ctrl-/:change-preview-window(down|hidden|)&#39;&#10;&quot;&#10;&#10;# Alt+C 配置&#10;export FZF_ALT_C_COMMAND=&#39;fd --type d --hidden --follow --exclude .git&#39;&#10;export FZF_ALT_C_OPTS=&quot;&#10;  --preview &#39;eza --tree --level=2 --icons --color=always {}&#39;&#10;&quot;&#10;&#10;# Ctrl+R 配置&#10;export FZF_CTRL_R_OPTS=&quot;&#10;  --preview &#39;echo {}&#39;&#10;  --preview-window up:3:hidden:wrap&#10;  --bind &#39;ctrl-/:toggle-preview&#39;&#10;  --bind &#39;ctrl-y:execute-silent(echo -n {2..} | pbcopy)+abort&#39;&#10;  --header &#39;Press CTRL-Y to copy command into clipboard&#39;&#10;&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># ~/.zshrc — FZF 全局配置</span></span>\n<span class=\"line\"><span style=\"color