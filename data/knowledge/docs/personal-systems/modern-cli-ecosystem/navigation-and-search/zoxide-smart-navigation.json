-shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$session_name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  else</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    tmux</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> new-session</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -d</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$session_name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$dir</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    tmux</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> switch-client</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$session_name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  fi</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># VS Code 打开 zoxide 记录的项目</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">zcode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  local</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dir</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">zoxide</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> query</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --list</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fzf</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --preview</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'eza --tree --level=1 {}'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  [ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-n</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$dir</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ] &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">code</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$dir</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>定位</th>\n<th>与 zoxide 对比</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>autojump</td>\n<td>Python 版目录跳转</td>\n<td>更老，更慢，功能较少</td>\n</tr>\n<tr>\n<td>z.sh</td>\n<td>Shell 脚本版</td>\n<td>zoxide 的灵感来源，但性能差</td>\n</tr>\n<tr>\n<td>fasd</td>\n<td>频率+时效跳转</td>\n<td>已停止维护</td>\n</tr>\n<tr>\n<td>zsh-z</td>\n<td>Zsh 原生版 z</td>\n<td>仅限 Zsh</td>\n</tr>\n<tr>\n<td>jump</td>\n<td>Go 版目录跳转</td>\n<td>功能类似但生态小</td>\n</tr>\n</tbody></table>\n<p>zoxide 的优势：Rust 性能、跨 Shell 支持、fzf 集成、活跃维护。</p>\n<h2 id=\"总结\">总结</h2><p>zoxide 解决了一个看似微小但影响巨大的问题：目录跳转的认知负担。你不再需要记忆完整路径或反复 tab 补全——只需记住目标目录名的几个字母。结合 fzf 的交互模式（zi），即使完全不记得路径也能通过视觉浏览快速定位。zoxide 的价值会随着使用时间持续增长：使用越久，数据库越精准，跳转越快。建议安装后立即用 <code>eval &quot;$(zoxide init zsh --cmd cd)&quot;</code> 直接替换 cd，一周后你将无法想象没有它的终端生活。</p>\n","headings":[{"level":1,"text":"zoxide 智能跳转","id":"zoxide-智能跳转"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"frecency 算法","id":"frecency-算法"},{"level":3,"text":"匹配策略","id":"匹配策略"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"安装与 Shell 集成","id":"安装与-shell-集成"},{"level":3,"text":"基础使用","id":"基础使用"},{"level":3,"text":"数据库管理","id":"数据库管理"},{"level":3,"text":"高级配置","id":"高级配置"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"zoxide + fzf 联动模式","id":"zoxide-fzf-联动模式"},{"level":3,"text":"项目切换工作流","id":"项目切换工作流"},{"level":3,"text":"与其他工具集成","id":"与其他工具集成"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"fzf 高级模式","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/navigation-and-search/fzf-advanced-patterns"},"next":{"title":"全局搜索工作流","url":"/l-doc-books/h/personal-systems/modern-cli-ecosystem/navigation-and-search/global-search-workflows"}}