pan><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hrv_data[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'avg_rmssd'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.35</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        normalize(stress_scores[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'avg'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.25</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        normalize(mood_entry[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'negative_affect'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.20</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        normalize(screen_time[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'total_hours'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.20</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    )</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 3. 与个人基线比较</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    baseline </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> get_30day_baseline()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    deviation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (composite_stress </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baseline) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> baseline</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 4. 生成建议</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deviation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        alert(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Stress elevated. Consider: early bedtime, meditation, nature walk\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    elif</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deviation </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        note(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"Good recovery day. Good time for challenging work or intense exercise\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> generate_report(composite_stress, deviation, top_factors)</span></span></code></pre></div><h2 id=\"总结\">总结</h2><p>压力与心理健康的量化追踪需要接受一个根本性的限制：心理状态无法像心率一样被精确测量。但这不意味着追踪无价值——恰恰相反，即使是粗粒度的趋势追踪也能提供三个关键能力：</p>\n<ol>\n<li><strong>早期预警</strong>：慢性压力积累的最大危险是其隐蔽性——HRV 基线的缓慢下降能在你「感觉到」之前发出信号</li>\n<li><strong>干预验证</strong>：正念有效吗？运动帮助了吗？新的作息安排对压力有影响吗？只有数据能给出个人化的答案</li>\n<li><strong>模式识别</strong>：通过长期追踪，识别你个人的压力周期（周内模式、月度波动、季节性变化）和核心触发因素</li>\n</ol>\n<p>最重要的心智转变：从「我应该减少压力」转向「我应该优化压力-恢复比」。适度的急性压力是成长的催化剂；问题出在恢复不足。量化追踪的终极目标是确保你的恢复系统始终能跟上压力的节奏。</p>\n","headings":[{"level":1,"text":"压力与心理健康指标","id":"压力与心理健康指标"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念：压力的生理测量","id":"核心概念-压力的生理测量"},{"level":3,"text":"HRV 应激指数的科学原理","id":"hrv-应激指数的科学原理"},{"level":3,"text":"压力响应的时间维度","id":"压力响应的时间维度"},{"level":3,"text":"皮质醇节律与昼夜模式","id":"皮质醇节律与昼夜模式"},{"level":2,"text":"实战指南：情绪与压力追踪方法","id":"实战指南-情绪与压力追踪方法"},{"level":3,"text":"结构化情绪日志设计","id":"结构化情绪日志设计"},{"level":3,"text":"数字行为作为压力代理指标","id":"数字行为作为压力代理指标"},{"level":3,"text":"正念冥想的量化追踪","id":"正念冥想的量化追踪"},{"level":2,"text":"最佳实践：压力管理的量化策略","id":"最佳实践-压力管理的量化策略"},{"level":3,"text":"压力预算系统","id":"压力预算系统"},{"level":3,"text":"压力触发因素识别","id":"压力触发因素识别"},{"level":3,"text":"恢复活动效果排名","id":"恢复活动效果排名"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"心理健康追踪应用","id":"心理健康追踪应用"},{"level":3,"text":"HRV 专业测量设备","id":"hrv-专业测量设备"},{"level":3,"text":"自动化压力监控流程","id":"自动化压力监控流程"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"运动与心率数据","url":"/l-doc-books/h/personal-systems/quantified-self/health-tracking/exercise-and-heart-rate-data"},"next":{"title":"仪表盘设计原则","url":"/l-doc-books/h/personal-systems/quantified-self/personal-dashboard/dashboard-design-principles"}}