79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">source_name</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"failed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].append((source_name, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">str</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e)))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # 发送汇总通知</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"failed\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        notify_telegram(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"ETL partial failure: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">results[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'failed'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> results</span></span></code></pre></div><h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"部署与运维方案\">部署与运维方案</h3><table>\n<thead>\n<tr>\n<th>方案</th>\n<th>适合场景</th>\n<th>月成本</th>\n<th>运维负担</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>本地 NAS (Synology/QNAP)</td>\n<td>数据隐私极度敏感</td>\n<td>¥0（硬件一次性投入）</td>\n<td>中（需维护硬件）</td>\n</tr>\n<tr>\n<td>树莓派 + Docker</td>\n<td>极客、低成本</td>\n<td>¥0（电费忽略）</td>\n<td>中-高（稳定性）</td>\n</tr>\n<tr>\n<td>Hetzner VPS</td>\n<td>性价比最优云方案</td>\n<td>€4-8/月</td>\n<td>低-中</td>\n</tr>\n<tr>\n<td>Railway / Render</td>\n<td>快速部署、免运维</td>\n<td>$5-15/月</td>\n<td>极低</td>\n</tr>\n<tr>\n<td>Vercel + Supabase</td>\n<td>前端 + 数据库分离</td>\n<td>$0-20/月</td>\n<td>极低</td>\n</tr>\n</tbody></table>\n<h3 id=\"安全与隐私考量\">安全与隐私考量</h3><p>个人健康数据是高度敏感信息，技术选型必须考虑：</p>\n<table>\n<thead>\n<tr>\n<th>风险</th>\n<th>缓解措施</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>API Token 泄露</td>\n<td>使用环境变量或密钥管理器（1Password CLI, Vault）</td>\n</tr>\n<tr>\n<td>数据传输安全</td>\n<td>全链路 HTTPS、VPN 隧道（Tailscale/WireGuard）</td>\n</tr>\n<tr>\n<td>存储加密</td>\n<td>数据库级别加密（PostgreSQL pgcrypto）、磁盘加密</td>\n</tr>\n<tr>\n<td>访问控制</td>\n<td>即使单人使用也需要认证（避免公网暴露）</td>\n</tr>\n<tr>\n<td>数据主权</td>\n<td>优先自托管或欧盟 GDPR 合规的服务商</td>\n</tr>\n<tr>\n<td>备份恢复</td>\n<td>每日自动备份至独立位置（B2, S3）</td>\n</tr>\n</tbody></table>\n<h3 id=\"未来演进路径\">未来演进路径</h3><pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[&quot;Phase 1: SaaS aggregation&quot;] --&gt; B[&quot;Phase 2: Add custom ETL&quot;]&#10;    B --&gt; C[&quot;Phase 3: Self-hosted storage&quot;]&#10;    C --&gt; D[&quot;Phase 4: Custom frontend&quot;]&#10;    A --&gt; E[&quot;Exist.io / Gyroscope&quot;]&#10;    B --&gt; F[&quot;+ Python scripts + cron&quot;]&#10;    C --&gt; G[&quot;+ InfluxDB + Grafana&quot;]&#10;    D --&gt; H[&quot;+ Next.js custom dashboard&quot;]\">graph LR\n    A[\"Phase 1: SaaS aggregation\"] --&gt; B[\"Phase 2: Add custom ETL\"]\n    B --&gt; C[\"Phase 3: Self-hosted storage\"]\n    C --&gt; D[\"Phase 4: Custom frontend\"]\n    A --&gt; E[\"Exist.io / Gyroscope\"]\n    B --&gt; F[\"+ Python scripts + cron\"]\n    C --&gt; G[\"+ InfluxDB + Grafana\"]\n    D --&gt; H[\"+ Next.js custom dashboard\"]</pre><p><strong>关键建议</strong>：从 Phase 1 开始，在确认自己会持续使用后再逐步升级。每次升级都应保留前一阶段作为备份——如果自建系统崩溃，至少还有 SaaS 作为兜底。</p>\n<h2 id=\"总结\">总结</h2><p>技术栈选型的核心原则是<strong>匹配你的维护意愿而非技术能力</strong>：</p>\n<ol>\n<li><strong>可持续性优先</strong>：能维护 3 年的简单方案 &gt; 维护 3 月的复杂方案。选型时问自己：「6 个月后我还愿意花时间维护这个吗？」</li>\n<li><strong>渐进式复杂度</strong>：从 SaaS 起步，只在碰到具体限制时才增加自建组件。过早优化是万恶之源</li>\n<li><strong>数据可迁移性</strong>：无论选择什么展示层，确保底层数据以开放格式（CSV、JSON、标准数据库）存储——你会换工具，但数据不应丢失</li>\n<li><strong>单点故障最小化</strong>：ETL 中单个数据源的故障不应影响整个系统；展示层崩溃不应丢失数据</li>\n</ol>\n<p>最后记住：仪表盘是手段而非目的。如果你发现自己花在维护系统上的时间超过了从数据中获得的价值，那就是该简化的信号。</p>\n","headings":[{"level":1,"text":"技术栈选型","id":"技术栈选型"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念：架构分层与决策维度","id":"核心概念-架构分层与决策维度"},{"level":3,"text":"个人数据栈的四层架构","id":"个人数据栈的四层架构"},{"level":3,"text":"选型决策矩阵","id":"选型决策矩阵"},{"level":2,"text":"实战指南：三条技术路径","id":"实战指南-三条技术路径"},{"level":3,"text":"路径一：SaaS 集成方案（零/低代码）","id":"路径一-saas-集成方案-零-低代码"},{"level":3,"text":"路径二：Grafana + 时序数据库（中等技术）","id":"路径二-grafana-时序数据库-中等技术"},{"level":3,"text":"路径三：自建全栈方案（高技术）","id":"路径三-自建全栈方案-高技术"},{"level":2,"text":"最佳实践：数据源接入策略","id":"最佳实践-数据源接入策略"},{"level":3,"text":"API 接入成熟度分级","id":"api-接入成熟度分级"},{"level":3,"text":"Apple Health 数据导出方案","id":"apple-health-数据导出方案"},{"level":3,"text":"数据管道可靠性设计","id":"数据管道可靠性设计"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"部署与运维方案","id":"部署与运维方案"},{"level":3,"text":"安全与隐私考量","id":"安全与隐私考量"},{"level":3,"text":"未来演进路径","id":"未来演进路径"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"仪表盘设计原则","url":"/l-doc-books/h/personal-systems/quantified-self/personal-dashboard/dashboard-design-principles"},"next":{"title":"可视化最佳实践","url":"/l-doc-books/h/personal-systems/quantified-self/personal-dashboard/visualization-best-practices"}}