ghts, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">key</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=lambda</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> k: normalize(data.get(k, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> weights[k]),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'action'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: generate_action(score, data)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span></code></pre></div><h2 id=\"最佳实践-数据源接入策略\">最佳实践：数据源接入策略</h2><h3 id=\"api-接入成熟度分级\">API 接入成熟度分级</h3><table>\n<thead>\n<tr>\n<th>等级</th>\n<th>特征</th>\n<th>代表数据源</th>\n<th>接入策略</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>A 级</td>\n<td>官方 REST API、文档完善、稳定</td>\n<td>Oura, Strava, Withings</td>\n<td>直接对接，可靠</td>\n</tr>\n<tr>\n<td>B 级</td>\n<td>API 存在但有限制（频率、范围）</td>\n<td>Garmin, Fitbit, Whoop</td>\n<td>需要缓存层、注意限流</td>\n</tr>\n<tr>\n<td>C 级</td>\n<td>无官方 API，需间接导出</td>\n<td>Apple Health, 微信读书</td>\n<td>Shortcuts/导出脚本</td>\n</tr>\n<tr>\n<td>D 级</td>\n<td>完全封闭，只能手动</td>\n<td>纸质日记、口头反馈</td>\n<td>设计低摩擦手动输入流程</td>\n</tr>\n</tbody></table>\n<h3 id=\"apple-health-数据导出方案\">Apple Health 数据导出方案</h3><p>Apple Health 是 iOS 生态的数据中枢，但没有直接 API。推荐方案：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"方案1：Health Auto Export（推荐）&#10;- iOS App，支持自动后台导出&#10;- 导出至 REST endpoint / Google Sheets / CSV&#10;- 支持选择性导出（只要需要的数据类型）&#10;- 价格：一次性 $5&#10;&#10;方案2：iOS Shortcuts 自动化&#10;- 每日定时触发 Shortcut&#10;- 读取 HealthKit 数据 → 格式化 → POST 到自建 API&#10;- 免费但需要手动维护&#10;&#10;方案3：定期手动导出&#10;- 设置 → 健康 → 导出所有健康数据&#10;- XML 格式，需要解析脚本&#10;- 适合月度批量分析\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>方案1：Health Auto Export（推荐）</span></span>\n<span class=\"line\"><span>- iOS App，支持自动后台导出</span></span>\n<span class=\"line\"><span>- 导出至 REST endpoint / Google Sheets / CSV</span></span>\n<span class=\"line\"><span>- 支持选择性导出（只要需要的数据类型）</span></span>\n<span class=\"line\"><span>- 价格：一次性 $5</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>方案2：iOS Shortcuts 自动化</span></span>\n<span class=\"line\"><span>- 每日定时触发 Shortcut</span></span>\n<span class=\"line\"><span>- 读取 HealthKit 数据 → 格式化 → POST 到自建 API</span></span>\n<span class=\"line\"><span>- 免费但需要手动维护</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>方案3：定期手动导出</span></span>\n<span class=\"line\"><span>- 设置 → 健康 → 导出所有健康数据</span></span>\n<span class=\"line\"><span>- XML 格式，需要解析脚本</span></span>\n<span class=\"line\"><span>- 适合月度批量分析</span></span></code></pre></div><h3 id=\"数据管道可靠性设计\">数据管道可靠性设计</h3><div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# ETL 脚本的最佳实践模板&#10;import logging&#10;from datetime import datetime, timedelta&#10;from tenacity import retry, stop_after_attempt, wait_exponential&#10;&#10;logger = logging.getLogger(__name__)&#10;&#10;@retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=4, max=60))&#10;def fetch_oura_sleep(date, token):&#10;    &quot;&quot;&quot;带重试的数据拉取&quot;&quot;&quot;&#10;    response = requests.get(&#10;        f&quot;https://api.ouraring.com/v2/usercollection/sleep&quot;,&#10;        params={&quot;start_date&quot;: date, &quot;end_date&quot;: date},&#10;        headers={&quot;Authorization&quot;: f&quot;Bearer {token}&quot;}&#10;    )&#10;    response.raise_for_status()&#10;    return response.json()&#10;&#10;def etl_pipeline(date=None):&#10;    &quot;&quot;&quot;每日ETL主流程&quot;&quot;&quot;&#10;    date = date or (datetime.now() - timedelta(days=1)).strftime(&quot;%Y-%m-%d&quot;)&#10;&#10;    results = {&quot;success&quot;: [], &quot;failed&quot;: []}&#10;&#10;    # 逐源拉取，单源失败不影响其他&#10;    for source_name, fetch_fn in DATA_SOURCES.items():&#10;        try:&#10;            data = fetch_fn(date)&#10;            store_to_influx(source_name, data, date)&#10;            results[&quot;success&quot;].append(source_name)&#10;        except Exception as e:&#10;            logger.error(f&quot;Failed to fetch {source_name}: {e}&quot;)&#10;            results[&quot;failed&quot;].append((source_name, str(e)))&#10;&#10;    # 发送汇总通知&#10;    if results[&quot;failed&quot;]:&#10;        notify_telegram(f&quot;ETL partial failure: {results[&#39;failed&#39;]}&quot;)&#10;&#10;    return results\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># ETL 脚本的最佳实践模板</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> logging</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datetime </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> datetime, timedelta</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tenacity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> retry, stop_after_attempt, wait_exponential</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">logger </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> logg