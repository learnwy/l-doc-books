n style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">transaction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'notes'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'readwrite'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tx.store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">put</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  id: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'note-2026-05-08'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'CRDT 学习笔记'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  content: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'今天研究了 Yjs 的 YATA 算法...'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tags: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'tech'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'crdt'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  updatedAt: Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tx.done;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 按索引查询</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> recentNotes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getAllFromIndex</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'notes'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'by-date'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, IDBKeyRange.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lowerBound</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 7</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 86400000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span></code></pre></div><p>IndexedDB 的局限：</p>\n<ul>\n<li><strong>异步 API</strong>：所有操作返回 Promise，无法在同步代码路径中使用</li>\n<li><strong>无 SQL</strong>：只有键值查询和索引范围扫描，复杂查询需要在应用层实现</li>\n<li><strong>序列化开销</strong>：结构化克隆算法对大对象有可观的序列化成本</li>\n</ul>\n<h3 id=\"opfs-高性能文件访问\">OPFS：高性能文件访问</h3><p>Origin Private File System 是 2023 年标准化的新 API，提供类似原生文件系统的同步访问能力（仅限 Web Worker）：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 在 Web Worker 中使用 OPFS 同步访问&#10;// worker.js&#10;const root = await navigator.storage.getDirectory();&#10;const fileHandle = await root.getFileHandle(&#39;app.db&#39;, { create: true });&#10;&#10;// 获取同步访问句柄（仅 Worker 可用）&#10;const syncHandle = await fileHandle.createSyncAccessHandle();&#10;&#10;// 高性能读写——无 Promise 开销&#10;const buffer = new ArrayBuffer(4096);&#10;const bytesRead = syncHandle.read(buffer, { at: 0 });&#10;syncHandle.write(new Uint8Array([1, 2, 3]), { at: 0 });&#10;syncHandle.flush(); // 确保写入持久化&#10;syncHandle.close();\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 在 Web Worker 中使用 OPFS 同步访问</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// worker.js</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> root</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> navigator.storage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getDirectory</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> fileHandle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> root.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getFileHandle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'app.db'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { create: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 获取同步访问句柄（仅 Worker 可用）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> syncHandle</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> fileHandle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createSyncAccessHandle</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 高性能读写——无 Promise 开销</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> buffer</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ArrayBuffer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4096</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bytesRead</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> syncHandle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">read</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(buffer, { at: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">syncHandle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">write</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Uint8Array</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]), { at: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">syncHandle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flush</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 确保写入持久化</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">syncHandle.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span></code></pre></div><p>OPFS 的核心价值：为 SQLite WASM 提供了接近原生性能的存储后端。wa-sqlite 和 sql.js 都利用 OPFS 作为底层 VFS（Virtual File System），实现了浏览器中的高性能数据库。</p>\n<h3 id=\"sqlite-wasm-浏览器中的完整数据库\">SQLite WASM：浏览器中的完整数据库</h3><p>2026 年，SQLite 官方提供了 WASM 构建（sqlite3.wasm），社区方案 wa-sqlite 和 sql.js 也在持续优化。SQLite WASM + OPFS 的组合，让浏览器应用拥有了真正的关系数据库：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 使用 @sqlite.org/sqlite-wasm 官方包&#10;import sqlite3InitModule from &#39;@sqlite.org/sqlite-wasm&#39;;&#10;&#10;const sqlite3 = await sqlite3InitModule();&#10;const db = new sqlite3.oo1.OpfsDb(&#39;/personal-data.db&#39;);&#10;&#10;// 完整的 SQL 能力&#10;db.exec(`&#10;  CREATE TABLE IF NOT EXISTS notes (&#10;    id TEXT PRIMARY KEY,&#10;    title TEXT NOT NULL,&#10;    content TEXT,&#10;    tags JSON,&#10;    created_at INTEGER DEFAULT (unixepoch()),&#10;    updated_at INTEGER DEFAULT (unixepoch())&#10;  );&#10;  CREATE INDEX IF NOT EXISTS idx_notes_updated ON notes(updated_at);&#10;`);&#10;&#10;// 全文搜索&#10;db.exec(`&#10;  CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts&#10;  USING fts5(title, content, content=notes, content_rowid=rowid);&#10;`);&#10;&#10;// 查询&#10;const results = db.exec({&#10;  sql: `SELECT * FROM notes WHERE updated_at &gt; ? ORDER BY updated_at DESC`,&#10;  bind: [Date.now() / 1000 - 86400],&#10;  returnValue: &#39;resultRows&#39;,&#10;  rowMode: &#39;object&#39;,&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 使用 @sqlite.org/sqlite-wasm 官方包</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sqlite3InitModule </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '@sqlite.org/sqlite-wasm'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sqlite3</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sqlite3InitModule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sqlite3.oo1.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">OpfsDb</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/personal-data.db'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 完整的 SQL 能力</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE TABLE IF NOT EXISTS notes (</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    id TEXT PRIMARY KEY,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    title TEXT NOT NULL,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    content TEXT,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    tags JSON,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    created_at INTEGER DEFAULT (unixepoch()),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    updated_at INTEGER DEFAULT (unixepoch())</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  );</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE INDEX IF NOT EXISTS idx_notes_updated ON notes(updated_at);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 全文搜索</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  USING fts5(title, content, content=notes, content_rowid=rowid);</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 查询</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> results</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sql: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`SELECT * FROM notes WHERE updated_at > ? ORDER BY updated_at DESC`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  bind: [Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 86400</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  returnValue: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'resultRows'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  rowMode: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'object'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h3 id=\"桌面应用的持久化选择\">桌面应用的持久化选择</h3><p>对 Electron 和 Tauri 应用，持久化更为直接：</p>\n<table>\n<thead>\n<tr>\n<th>框架</th>\n<th>推荐方案</th>\n<th>库</th>\n<th>备注</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Electron</td>\n<td>better-sqlite3</td>\n<td>原生 N-API 绑定</td>\n<td>同步 API，性能最优</td>\n</tr>\n<tr>\n<td>Tauri</td>\n<td>rusqlite / sqlx</td>\n<td>Rust 原生</td>\n<td>通过 IPC 暴露给前端</td>\n</tr>\n<tr>\n<td>React Native</td>\n<td>expo-sqlite</td>\n<td>C 原生绑定</td>\n<td>新同步 API（2025+）</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// Electron + better-sqlite3 示例&#10;import Database from &#39;better-sqlite3&#39;;&#10;import { app } from &#39;electron&#39;;&#10;import path from &#39;path&#39;;&#10;&#10;const dbPath = path.join(app.getPath(&#39;userData&#39;), &#39;personal.db&#39;);&#10;const db = new Database(dbPath, {&#10;  // WAL 模式：并发读写不阻塞&#10;  // 在打开后立即设置&#10;});&#10;db.pragma(&#39;journal_mode = WAL&#39;);&#10;db.pragma(&#39;synchronous = NORMAL&#39;); // 性能与安全的平衡&#10;db.pragma(&#39;foreign_keys = ON&#39;);&#10;&#10;// 批量插入用 transaction 包裹——性能提升 10-100x&#10;const insertNote = db.prepare(&#39;INSERT OR REPLACE INTO notes (id, title, content) VALUES (?, ?, ?)&#39;);&#10;const insertMany = db.transaction((notes) =&gt; {&#10;  for (const note of notes) {&#10;    insertNote.run(note.id, note.title, note.content);&#10;  }&#10;});\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Electron + better-sqlite3 示例</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Database </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'better-sqlite3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { app } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'electron'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> path </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'path'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dbPath</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> path.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(app.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getPath</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'userData'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'personal.db'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> db</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Database</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(dbPath, {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // WAL 模式：并发读写不阻塞</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 在打开后立即设置</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pragma</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'journal_mode = WAL'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pragma</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'synchronous = NORMAL'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 性能与安全的平衡</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pragma</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'foreign_keys = ON'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 批量插入用 transaction 包裹——性能提升 10-100x</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> insertNote</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">prepare</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'INSERT OR REPLACE INTO notes (id, title, content) VALUES (?, ?, ?)'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> insertMany</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">transaction</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">notes</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> note</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> notes) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    insertNote.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(note.id, note.title, note.content);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"存储方案选型矩阵\">存储方案选型矩阵</h3><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>推荐</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>CRDT 文档持久化</td>\n<td>IndexedDB (y-indexeddb)</td>\n<td>成熟，Yjs 官方支持</td>\n</tr>\n<tr>\n<td>需要复杂查询</td>\n<td>SQLite WASM + OPFS</td>\n<td>SQL 能力无可替代</td>\n</tr>\n<tr>\n<td>大文件/二进制</td>\n<td>OPFS 直接读写</td>\n<td>避免序列化开销</td>\n</tr>\n<tr>\n<td>桌面应用</td>\n<td>better-sqlite3 / rusqlite</td>\n<td>原生性能，无 WASM 开销</td>\n</tr>\n<tr>\n<td>需要 React 集成</td>\n<td>cr-sqlite + IndexedDB</td>\n<td>响应式查询</td>\n</tr>\n</tbody></table>\n<h3 id=\"数据安全策略\">数据安全策略</h3><ol>\n<li><strong>调用 <code>persist()</code></strong>：必须请求持久化存储，否则数据可能被浏览器清除</li>\n<li><strong>双写策略</strong>：关键数据同时写入 IndexedDB 和 OPFS，互为备份</li>\n<li><strong>导出功能</strong>：提供 JSON/SQLite 文件导出，让用户可以手动备份</li>\n<li><strong>版本迁移</strong>：数据库 schema 变更使用版本号管理，提供向前迁移路径</li>\n</ol>\n<h3 id=\"性能优化要点\">性能优化要点</h3><ul>\n<li><strong>批量写入</strong>：将多个小写入合并为单个事务，SQLite 中可提升 10-100 倍</li>\n<li><strong>Worker 分离</strong>：将数据库操作放入 Web Worker，避免阻塞主线程 UI</li>\n<li><strong>延迟写入</strong>：用 debounce 合并高频更新（如打字），减少磁盘 I/O</li>\n<li><strong>索引策略</strong>：只为实际查询模式创建索引，过多索引拖慢写入</li>\n</ul>\n<h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>类型</th>\n<th>平台</th>\n<th>特点</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>@sqlite.org/sqlite-wasm</td>\n<td>数据库</td>\n<td>Web</td>\n<td>SQLite 官方 WASM 构建</td>\n</tr>\n<tr>\n<td>wa-sqlite</td>\n<td>数据库</td>\n<td>Web</td>\n<td>社区维护，多 VFS 支持</td>\n</tr>\n<tr>\n<td>better-sqlite3</td>\n<td>数据库</td>\n<td>Node/Electron</td>\n<td>同步 API，性能极优</td>\n</tr>\n<tr>\n<td>idb</td>\n<td>IndexedDB 封装</td>\n<td>Web</td>\n<td>轻量 Promise 包装</td>\n</tr>\n<tr>\n<td>Dexie.js</td>\n<td>IndexedDB 封装</td>\n<td>Web</td>\n<td>功能丰富，支持实时查询</td>\n</tr>\n<tr>\n<td>y-indexeddb</td>\n<td>CRDT 持久化</td>\n<td>Web</td>\n<td>Yjs 官方 IndexedDB 适配</td>\n</tr>\n<tr>\n<td>cr-sqlite</td>\n<td>CRDT + SQLite</td>\n<td>全平台</td>\n<td>将 CRDT 能力注入 SQLite</td>\n</tr>\n<tr>\n<td>PGlite</td>\n<td>数据库</td>\n<td>Web</td>\n<td>浏览器中的 Postgres</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>本地数据持久化是 Local-first 架构的地基。浏览器环境中，IndexedDB 成熟稳定适合 CRDT 文档存储，OPFS 提供高性能文件访问，SQLite WASM 带来完整的关系查询能力——三者可以按需组合。桌面应用直接使用原生 SQLite 绑定即可获得最优性能。无论选择哪条路径，核心原则不变：请求持久化权限、事务保护写入、Worker 隔离 I/O、定期备份导出。将这些基础打牢，你的个人数据才能真正&quot;属于你&quot;——不依赖任何云服务的可用性。</p>\n","headings":[{"level":1,"text":"本地数据持久化","id":"本地数据持久化"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"浏览器存储层级","id":"浏览器存储层级"},{"level":3,"text":"持久化存储的关键指标","id":"持久化存储的关键指标"},{"level":3,"text":"Storage Persistence API","id":"storage-persistence-api"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"IndexedDB：成熟的异步存储","id":"indexeddb-成熟的异步存储"},{"level":3,"text":"OPFS：高性能文件访问","id":"opfs-高性能文件访问"},{"level":3,"text":"SQLite WASM：浏览器中的完整数据库","id":"sqlite-wasm-浏览器中的完整数据库"},{"level":3,"text":"桌面应用的持久化选择","id":"桌面应用的持久化选择"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"存储方案选型矩阵","id":"存储方案选型矩阵"},{"level":3,"text":"数据安全策略","id":"数据安全策略"},{"level":3,"text":"性能优化要点","id":"性能优化要点"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"CRDTs 与离线优先","url":"/l-doc-books/h/personal-systems/personal-data-infrastructure/local-first-architecture/crdts-offline-first"},"next":{"title":"同步协议设计","url":"/l-doc-books/h/personal-systems/personal-data-infrastructure/local-first-architecture/sync-protocol-design"}}