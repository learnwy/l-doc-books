pan>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      ALTER TABLE notes ADD COLUMN sync_version INTEGER DEFAULT 0;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      ALTER TABLE notes ADD COLUMN last_synced_at TEXT;</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    `</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pragma</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'user_version = 3'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"blob-存储策略\">BLOB 存储策略</h3><p>SQLite 对 BLOB 存储有明确的性能边界：</p>\n<table>\n<thead>\n<tr>\n<th>大小范围</th>\n<th>策略</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>&lt; 100KB</td>\n<td>直接存 BLOB</td>\n<td>比文件系统快 35%，原子性保证</td>\n</tr>\n<tr>\n<td>100KB - 1MB</td>\n<td>可选</td>\n<td>取决于访问模式</td>\n</tr>\n<tr>\n<td>&gt; 1MB</td>\n<td>外部文件 + 路径引用</td>\n<td>避免数据库膨胀影响查询性能</td>\n</tr>\n</tbody></table>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"-- 小文件存数据库内&#10;INSERT INTO attachments (id, note_id, filename, mime_type, size_bytes, data)&#10;VALUES (&#39;att-001&#39;, &#39;note-001&#39;, &#39;screenshot.png&#39;, &#39;image/png&#39;, 45000, readfile(&#39;screenshot.png&#39;));&#10;&#10;-- 大文件存外部，数据库只记录路径&#10;CREATE TABLE large_files (&#10;    id TEXT PRIMARY KEY,&#10;    note_id TEXT NOT NULL REFERENCES notes(id),&#10;    external_path TEXT NOT NULL,  -- 相对路径&#10;    sha256 TEXT NOT NULL,         -- 完整性校验&#10;    size_bytes INTEGER NOT NULL&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 小文件存数据库内</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">INSERT INTO</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> attachments (id, note_id, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">filename</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, mime_type, size_bytes, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">data</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">VALUES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'att-001'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'note-001'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'screenshot.png'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'image/png'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">45000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, readfile(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'screenshot.png'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 大文件存外部，数据库只记录路径</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> large_files</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TEXT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    note_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TEXT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> REFERENCES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> notes(id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    external_path </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TEXT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 相对路径</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sha256 </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">TEXT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 完整性校验</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    size_bytes </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INTEGER</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"初始化-pragma-配置\">初始化 Pragma 配置</h3><p>每次打开数据库时应设置的 pragma：</p>\n<div class=\"code-block-wrapper\" data-lang=\"sql\" data-code=\"PRAGMA journal_mode = WAL;         -- 并发读写&#10;PRAGMA synchronous = NORMAL;       -- 性能/安全平衡&#10;PRAGMA foreign_keys = ON;          -- 启用外键约束&#10;PRAGMA busy_timeout = 5000;        -- 锁等待 5 秒&#10;PRAGMA cache_size = -64000;        -- 64MB 页面缓存&#10;PRAGMA auto_vacuum = INCREMENTAL;  -- 增量回收空间\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA journal_mode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> WAL;         </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 并发读写</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA synchronous </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> NORMAL;       </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 性能/安全平衡</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA foreign_keys </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;          </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 启用外键约束</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA busy_timeout </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 5000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;        </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 锁等待 5 秒</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA cache_size </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">64000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;        </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 64MB 页面缓存</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">PRAGMA auto_vacuum </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INCREMENTAL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 增量回收空间</span></span></code></pre></div><h3 id=\"文件命名与关联\">文件命名与关联</h3><div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"my-notebook.notes     ← 自定义扩展名（实际是 SQLite）&#10;my-notebook.notes-wal ← WAL 文件（SQLite 自动管理）&#10;my-notebook.notes-shm ← 共享内存文件（SQLite 自动管理）\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>my-notebook.notes     ← 自定义扩展名（实际是 SQLite）</span></span>\n<span class=\"line\"><span>my-notebook.notes-wal ← WAL 文件（SQLite 自动管理）</span></span>\n<span class=\"line\"><span>my-notebook.notes-shm ← 共享内存文件（SQLite 自动管理）</span></span></code></pre></div><p>在 macOS 上注册文件类型关联（Info.plist）：</p>\n<ul>\n<li>UTI: <code>com.yourapp.notes</code></li>\n<li>Extension: <code>.notes</code></li>\n<li>MIME: <code>application/x-your-notes</code></li>\n</ul>\n<h3 id=\"备份策略\">备份策略</h3><div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 方法 1：SQLite Backup API（在线备份，不锁定）&#10;const backup = db.backup(&#39;backup-2026-05-08.db&#39;);&#10;backup.step(-1); // 一次性完整备份&#10;&#10;// 方法 2：VACUUM INTO（创建压缩副本）&#10;db.exec(`VACUUM INTO &#39;/path/to/backup.db&#39;`);&#10;&#10;// 方法 3：定时快照 + 增量&#10;// 配合 git 或 rsync 实现版本化备份\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方法 1：SQLite Backup API（在线备份，不锁定）</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> backup</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">backup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'backup-2026-05-08.db'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">backup.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">step</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 一次性完整备份</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方法 2：VACUUM INTO（创建压缩副本）</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exec</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`VACUUM INTO '/path/to/backup.db'`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 方法 3：定时快照 + 增量</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 配合 git 或 rsync 实现版本化备份</span></span></code></pre></div><h2 id=\"工具与生态\">工具与生态</h2><table>\n<thead>\n<tr>\n<th>工具</th>\n<th>用途</th>\n<th>平台</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>DB Browser for SQLite</td>\n<td>GUI 浏览/编辑</td>\n<td>全平台</td>\n</tr>\n<tr>\n<td>sqlite3 CLI</td>\n<td>命令行操作</td>\n<td>全平台</td>\n</tr>\n<tr>\n<td>Datasette</td>\n<td>Web 浏览/API</td>\n<td>Python</td>\n</tr>\n<tr>\n<td>Litestream</td>\n<td>实时复制到 S3</td>\n<td>Linux/Mac</td>\n</tr>\n<tr>\n<td>sql.js / wa-sqlite</td>\n<td>浏览器中运行</td>\n<td>Web</td>\n</tr>\n<tr>\n<td>better-sqlite3</td>\n<td>Node.js 高性能绑定</td>\n<td>Node</td>\n</tr>\n<tr>\n<td>rusqlite</td>\n<td>Rust 绑定</td>\n<td>Rust</td>\n</tr>\n<tr>\n<td>SQLite Viewer (VS Code)</td>\n<td>编辑器内查看</td>\n<td>VS Code</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>SQLite 作为应用文件格式的价值在于：它把&quot;存储&quot;从需要你操心的基础设施问题，变成了一个已解决的工程问题。你不需要设计文件格式、编写序列化代码、处理并发冲突或实现事务回滚——SQLite 在过去 20 年已经做到了极致。对个人开发者，这意味着你可以把全部精力放在应用逻辑上。用 <code>.db</code> 文件替代 JSON 文件堆，用 SQL 替代手写过滤逻辑，用 FTS5 替代自建搜索——每一个选择都是在减少你需要维护的代码量，同时增加数据的可靠性和可访问性。</p>\n","headings":[{"level":1,"text":"SQLite 作为应用格式","id":"sqlite-作为应用格式"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"应用文件格式的三种范式","id":"应用文件格式的三种范式"},{"level":3,"text":"SQLite 作为格式的 12 项优势","id":"sqlite-作为格式的-12-项优势"},{"level":3,"text":"application_id：注册你的文件类型","id":"application_id-注册你的文件类型"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"设计你的应用 Schema","id":"设计你的应用-schema"},{"level":3,"text":"Schema 版本迁移","id":"schema-版本迁移"},{"level":3,"text":"BLOB 存储策略","id":"blob-存储策略"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"初始化 Pragma 配置","id":"初始化-pragma-配置"},{"level":3,"text":"文件命名与关联","id":"文件命名与关联"},{"level":3,"text":"备份策略","id":"备份策略"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"同步协议设计","url":"/l-doc-books/h/personal-systems/personal-data-infrastructure/local-first-architecture/sync-protocol-design"},"next":{"title":"WAL 模式与并发","url":"/l-doc-books/h/personal-systems/personal-data-infrastructure/sqlite-personal-apps/wal-mode-concurrency"}}