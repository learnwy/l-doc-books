\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">du</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -sh</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /opt/homebrew</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # Homebrew 总占用</span></span></code></pre></div><h3 id=\"多版本管理\">多版本管理</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 安装特定版本&#10;brew install python@3.11&#10;brew install python@3.13&#10;&#10;# 查看已安装版本&#10;brew list --versions python&#10;&#10;# 切换默认版本（通过 link/unlink）&#10;brew unlink python@3.13&#10;brew link python@3.11&#10;&#10;# 推荐：使用 mise 管理语言版本而非 Homebrew\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 安装特定版本</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> install</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> python@3.11</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> install</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> python@3.13</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 查看已安装版本</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> list</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --versions</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> python</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 切换默认版本（通过 link/unlink）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> unlink</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> python@3.13</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> link</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> python@3.11</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 推荐：使用 mise 管理语言版本而非 Homebrew</span></span></code></pre></div><h2 id=\"最佳实践\">最佳实践</h2><h3 id=\"维护节奏\">维护节奏</h3><table>\n<thead>\n<tr>\n<th>频率</th>\n<th>操作</th>\n<th>命令</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>每周</td>\n<td>更新索引并升级</td>\n<td><code>brew update &amp;&amp; brew upgrade</code></td>\n</tr>\n<tr>\n<td>每月</td>\n<td>清理缓存和旧版本</td>\n<td><code>brew cleanup &amp;&amp; brew autoremove</code></td>\n</tr>\n<tr>\n<td>每季</td>\n<td>运行诊断</td>\n<td><code>brew doctor</code></td>\n</tr>\n<tr>\n<td>换机时</td>\n<td>导出 Brewfile</td>\n<td><code>brew bundle dump --force</code></td>\n</tr>\n</tbody></table>\n<h3 id=\"安全实践\">安全实践</h3><div class=\"code-block-wrapper\" data-lang=\"bash\" data-code=\"# 审计已安装包的安全问题&#10;brew audit --installed&#10;&#10;# 查看包的依赖树（确认安装了什么）&#10;brew deps --tree ripgrep&#10;&#10;# 锁定关键版本（防止意外升级）&#10;brew pin postgresql@15&#10;brew unpin postgresql@15  # 解锁\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 审计已安装包的安全问题</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> audit</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --installed</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 查看包的依赖树（确认安装了什么）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> deps</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --tree</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ripgrep</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 锁定关键版本（防止意外升级）</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> pin</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> postgresql@15</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">brew</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> unpin</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> postgresql@15</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  # 解锁</span></span></code></pre></div><h3 id=\"常见问题排查\">常见问题排查</h3><table>\n<thead>\n<tr>\n<th>问题</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>brew doctor</code> 报警告</td>\n<td>按提示逐条修复，大部分是 PATH 顺序问题</td>\n</tr>\n<tr>\n<td>安装卡住</td>\n<td>检查网络，设置 <code>HOMEBREW_CURL_RETRIES=5</code></td>\n</tr>\n<tr>\n<td>Permission denied</td>\n<td>修复权限：<code>sudo chown -R $(whoami) /opt/homebrew</code></td>\n</tr>\n<tr>\n<td>依赖冲突</td>\n<td><code>brew deps --tree &lt;pkg&gt;</code> 查看依赖链</td>\n</tr>\n<tr>\n<td>Cask 更新失败</td>\n<td><code>brew reinstall --cask &lt;app&gt;</code> 强制重装</td>\n</tr>\n</tbody></table>\n<h2 id=\"工具与生态\">工具与生态</h2><h3 id=\"homebrew-实用子命令\">Homebrew 实用子命令</h3><table>\n<thead>\n<tr>\n<th>命令</th>\n<th>功能</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>brew leaves</code></td>\n<td>列出没有被其他包依赖的顶层包</td>\n</tr>\n<tr>\n<td><code>brew uses --installed &lt;pkg&gt;</code></td>\n<td>查看哪些已安装包依赖了指定包</td>\n</tr>\n<tr>\n<td><code>brew log &lt;pkg&gt;</code></td>\n<td>查看包的版本变更历史</td>\n</tr>\n<tr>\n<td><code>brew edit &lt;pkg&gt;</code></td>\n<td>编辑 formula（调试或定制）</td>\n</tr>\n<tr>\n<td><code>brew cat &lt;pkg&gt;</code></td>\n<td>查看 formula 内容</td>\n</tr>\n<tr>\n<td><code>brew home &lt;pkg&gt;</code></td>\n<td>打开包的主页</td>\n</tr>\n</tbody></table>\n<h3 id=\"推荐-tap\">推荐 Tap</h3><table>\n<thead>\n<tr>\n<th>Tap</th>\n<th>内容</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><code>nikitabobko/tap</code></td>\n<td>Aerospace 窗口管理器</td>\n</tr>\n<tr>\n<td><code>koekeishiya/formulae</code></td>\n<td>yabai + skhd</td>\n</tr>\n<tr>\n<td><code>FelixKratz/formulae</code></td>\n<td>SketchyBar 状态栏</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><p>Homebrew 从&quot;安装工具的工具&quot;升级为完整的环境管理方案，关键在于两个实践：一是用 Brewfile 将安装状态声明化，使环境可复现；二是建立定期维护节奏，保持系统整洁和安全。结合 dotfiles 仓库中的 Brewfile 管理和 bootstrap 脚本中的 <code>brew bundle install</code>，你可以在任何新 Mac 上用一条命令恢复完整的工具生态。</p>\n","headings":[{"level":1,"text":"Homebrew 深度实践","id":"homebrew-深度实践"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":3,"text":"Homebrew 架构","id":"homebrew-架构"},{"level":3,"text":"Apple Silicon 路径变化","id":"apple-silicon-路径变化"},{"level":2,"text":"实战指南","id":"实战指南"},{"level":3,"text":"安装与初始配置","id":"安装与初始配置"},{"level":3,"text":"日常操作命令","id":"日常操作命令"},{"level":3,"text":"Brewfile 声明式环境管理","id":"brewfile-声明式环境管理"},{"level":3,"text":"性能优化","id":"性能优化"},{"level":3,"text":"多版本管理","id":"多版本管理"},{"level":2,"text":"最佳实践","id":"最佳实践"},{"level":3,"text":"维护节奏","id":"维护节奏"},{"level":3,"text":"安全实践","id":"安全实践"},{"level":3,"text":"常见问题排查","id":"常见问题排查"},{"level":2,"text":"工具与生态","id":"工具与生态"},{"level":3,"text":"Homebrew 实用子命令","id":"homebrew-实用子命令"},{"level":3,"text":"推荐 Tap","id":"推荐-tap"},{"level":2,"text":"总结","id":"总结"}],"prev":{"title":"自动化 Bootstrap 脚本","url":"/l-doc-books/h/personal-systems/developer-toolbox/dotfiles-management/automated-bootstrap-scripts"},"next":{"title":"开发工具链安装自动化","url":"/l-doc-books/h/personal-systems/developer-toolbox/macos-dev-environment/dev-toolchain-automation"}}