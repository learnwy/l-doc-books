or:#24292E;--shiki-dark:#E1E4E8\">)[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'visits'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].sum()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    current_4w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> daily_total.iloc[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">28</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:].mean()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    previous_4w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> daily_total.iloc[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">56</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">28</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].mean()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    yoy_same_period </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> daily_total.iloc[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">365</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">365</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].mean()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    mom_signal </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (current_4w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> previous_4w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> previous_4w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    yoy_signal </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (current_4w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> yoy_same_period </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> yoy_same_period </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> mom_signal </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0.5</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> yoy_signal</span></span></code></pre></div><h2 id=\"消费与交易数据\">消费与交易数据</h2><h3 id=\"信用卡数据\">信用卡数据</h3><p>信用卡交易数据被认为是&quot;最接近营收的另类数据&quot;——直接衡量消费者在特定商户的支出。</p>\n<p><strong>关键挑战：</strong></p>\n<ol>\n<li><strong>面板偏差</strong>：信用卡数据通常来自特定发卡行，面板可能不代表全部消费者</li>\n<li><strong>支付方式变化</strong>：现金、借记卡、移动支付的占比变化影响信号稳定性</li>\n<li><strong>季节性</strong>：消费数据有强季节性，需要年同比处理</li>\n<li><strong>数据延迟</strong>：通常 3-7 天可用</li>\n</ol>\n<h3 id=\"电商数据\">电商数据</h3><p>网络爬虫可以从电商平台获取：</p>\n<table>\n<thead>\n<tr>\n<th>数据项</th>\n<th>可推断信息</th>\n<th>适用公司</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>产品价格变化</td>\n<td>定价策略、竞争强度</td>\n<td>消费品、零售</td>\n</tr>\n<tr>\n<td>评论数量/评分</td>\n<td>产品受欢迎程度</td>\n<td>消费电子、日用品</td>\n</tr>\n<tr>\n<td>库存状态</td>\n<td>供需关系</td>\n<td>快消品</td>\n</tr>\n<tr>\n<td>新产品上架</td>\n<td>创新节奏</td>\n<td>科技、消费</td>\n</tr>\n<tr>\n<td>招聘职位数</td>\n<td>扩张/收缩信号</td>\n<td>所有行业</td>\n</tr>\n</tbody></table>\n<h2 id=\"esg-与可持续发展数据\">ESG 与可持续发展数据</h2><h3 id=\"esg-评分作为因子\">ESG 评分作为因子</h3><p>ESG（Environmental, Social, Governance）数据在过去五年中从合规工具演变为投资因子：</p>\n<table>\n<thead>\n<tr>\n<th>ESG 维度</th>\n<th>衡量指标</th>\n<th>与收益的关系</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>E（环境）</td>\n<td>碳排放、能源效率、废物处理</td>\n<td>长期正相关（尾部风险降低）</td>\n</tr>\n<tr>\n<td>S（社会）</td>\n<td>员工满意度、供应链责任、数据隐私</td>\n<td>弱正相关</td>\n</tr>\n<tr>\n<td>G（治理）</td>\n<td>董事会独立性、管理层薪酬、股东权利</td>\n<td>较强正相关</td>\n</tr>\n<tr>\n<td>综合 ESG 评分</td>\n<td>加权合成</td>\n<td>依赖加权方案</td>\n</tr>\n</tbody></table>\n<h3 id=\"esg-因子的特殊性\">ESG 因子的特殊性</h3><p>ESG 因子与传统因子的显著区别：</p>\n<ol>\n<li><strong>评分分歧</strong>：不同 ESG 评级机构对同一公司的评分相关性仅 ~0.6（远低于信用评级的 0.99）</li>\n<li><strong>动量效应</strong>：ESG 评分的变化（而非水平）可能是更好的预测因子</li>\n<li><strong>行业偏差</strong>：某些行业天然 ESG 评分低（如能源），行业中性化是必要的</li>\n<li><strong>数据可用性</strong>：中小盘公司的 ESG 数据覆盖不足</li>\n</ol>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"def esg_momentum_factor(esg_scores, lookback_months=12):&#10;    &quot;&quot;&quot;&#10;    ESG 动量因子：ESG 评分的变化而非水平&#10;&#10;    参数:&#10;        esg_scores: 包含 stock_id, date, esg_score 的面板数据&#10;        lookback_months: 变化计算的回溯期&#10;    返回:&#10;        factor: ESG 动量因子值&#10;    &quot;&quot;&quot;&#10;    esg_current = esg_scores.groupby(&#39;stock_id&#39;)[&#39;esg_score&#39;].last()&#10;&#10;    lookback_date = esg_scores[&#39;date&#39;].max() - pd.DateOffset(months=lookback_months)&#10;    esg_prior = esg_scores[esg_scores[&#39;date&#39;] &lt;= lookback_date].groupby(&#10;        &#39;stock_id&#39;)[&#39;esg_score&#39;].last()&#10;&#10;    esg_change = esg_current - esg_prior&#10;&#10;    esg_change_ranked = esg_change.rank(pct=True)&#10;    return esg_change_ranked\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> esg_momentum_factor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(esg_scores, lookback_months</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    ESG 动量因子：ESG 评分的变化而非水平</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    参数:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        esg_scores: 包含 stock_id, date, esg_score 的面板数据</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        lookback_months: 变化计算的回溯期</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    返回:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        factor: ESG 动量因子值</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    esg_current </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_scores.groupby(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'stock_id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esg_score'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].last()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    lookback_date </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_scores[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'date'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].max() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.DateOffset(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">months</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">lookback_months)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    esg_prior </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_scores[esg_scores[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'date'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lookback_date].groupby(</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'stock_id'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'esg_score'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].last()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    esg_change </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_current </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_prior</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    esg_change_ranked </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_change.rank(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pct</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> esg_change_ranked</span></span></code></pre></div><h2 id=\"另类数据的评估框架\">另类数据的评估框架</h2><h3 id=\"数据质量评估\">数据质量评估</h3><p>在投入资源处理一个新数据源之前，需要评估其质量：</p>\n<table>\n<thead>\n<tr>\n<th>维度</th>\n<th>评估问题</th>\n<th>红旗</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>覆盖度</td>\n<td>覆盖多少股票/行业？</td>\n<td>&lt; 200 只股票</td>\n</tr>\n<tr>\n<td>历史深度</td>\n<td>最早可回溯至何时？</td>\n<td>&lt; 5 年</td>\n</tr>\n<tr>\n<td>更新频率</td>\n<td>多久更新一次？</td>\n<td>更新不规律</td>\n</tr>\n<tr>\n<td>延迟</td>\n<td>从事件发生到数据可用的时间？</td>\n<td>&gt; 30 天</td>\n</tr>\n<tr>\n<td>稳定性</td>\n<td>数据定义和方法论是否稳定？</td>\n<td>频繁变更</td>\n</tr>\n<tr>\n<td>偏差</td>\n<td>是否存在系统性偏差？</td>\n<td>面板严重倾斜</td>\n</tr>\n<tr>\n<td>合规性</td>\n<td>使用是否合法合规？</td>\n<td>涉及个人隐私</td>\n</tr>\n</tbody></table>\n<h3 id=\"从数据到因子的标准流程\">从数据到因子的标准流程</h3><pre class=\"mermaid\" data-diagram-type=\"flowchart\" data-source=\"flowchart TD&#10;    A[获取原始数据] --&gt; B[数据清洗与标准化]&#10;    B --&gt; C[实体匹配&lt;br/&gt;映射到股票]&#10;    C --&gt; D[信号构建&lt;br/&gt;聚合/变换]&#10;    D --&gt; E[初步回测&lt;br/&gt;IC/分组]&#10;    E --&gt; F{信号有效?}&#10;    F --&gt;|否| G[换方向/换变换]&#10;    F --&gt;|是| H[与已知因子正交化]&#10;    H --&gt; I{独立贡献?}&#10;    I --&gt;|否| J[可能是已知因子的代理]&#10;    I --&gt;|是| K[样本外验证]&#10;    K --&gt; L[纳入 Alpha 组合]\">flowchart TD\n    A[获取原始数据] --&gt; B[数据清洗与标准化]\n    B --&gt; C[实体匹配&lt;br/&gt;映射到股票]\n    C --&gt; D[信号构建&lt;br/&gt;聚合/变换]\n    D --&gt; E[初步回测&lt;br/&gt;IC/分组]\n    E --&gt; F{信号有效?}\n    F --&gt;|否| G[换方向/换变换]\n    F --&gt;|是| H[与已知因子正交化]\n    H --&gt; I{独立贡献?}\n    I --&gt;|否| J[可能是已知因子的代理]\n    I --&gt;|是| K[样本外验证]\n    K --&gt; L[纳入 Alpha 组合]</pre><h3 id=\"另类数据因子的经济学意义\">另类数据因子的经济学意义</h3><p>另类数据因子的价值来自<strong>信息不对称</strong>——当多数投资者还未使用该数据时，早期采纳者享有信息优势。但这种优势会随着数据普及而衰减：</p>\n<table>\n<thead>\n<tr>\n<th>阶段</th>\n<th>特征</th>\n<th>Alpha 水平</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>早期采纳（0-2 年）</td>\n<td>少数机构使用</td>\n<td>高（IC ~0.05-0.10）</td>\n</tr>\n<tr>\n<td>增长期（2-5 年）</td>\n<td>被广泛关注</td>\n<td>中等（IC ~0.02-0.05）</td>\n</tr>\n<tr>\n<td>成熟期（5+ 年）</td>\n<td>成为标准数据</td>\n<td>低（IC ~0.01-0.03）</td>\n</tr>\n<tr>\n<td>商品化</td>\n<td>所有人都用</td>\n<td>接近零</td>\n</tr>\n</tbody></table>\n<h2 id=\"总结\">总结</h2><h3 id=\"核心要点\">核心要点</h3><ol>\n<li><strong>另类数据的价值在于信息时效性优势</strong>——比传统财务数据更早反映公司基本面变化</li>\n<li><strong>NLP 和 LLM 已成为文本因子的标准工具</strong>——但模型选择和提示工程仍是核心差异化来源</li>\n<li><strong>卫星和地理空间数据提供了&quot;物理世界&quot;的实时观测</strong>——特别适合消费、能源和农业领域</li>\n<li><strong>数据质量评估先于信号开发</strong>——历史深度、覆盖度和偏差是首要考量</li>\n<li><strong>另类数据因子的独特贡献才有价值</strong>——如果只是已知因子的高相关替代，则不值得付费</li>\n<li><strong>信息优势会随数据普及而衰减</strong>——持续寻找和整合新数据源是保持竞争力的关键</li>\n<li><strong>合规风险不可忽视</strong>——个人数据保护法规（GDPR、CCPA、中国个人信息保护法）对数据使用有严格限制</li>\n</ol>\n","headings":[{"level":1,"text":"另类数据与非传统因子","id":"另类数据与非传统因子"},{"level":2,"text":"概述","id":"概述"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"另类数据全景图","id":"另类数据全景图"},{"level":3,"text":"主要数据类别详解","id":"主要数据类别详解"},{"level":2,"text":"文本数据与情绪因子","id":"文本数据与情绪因子"},{"level":3,"text":"新闻情绪分析","id":"新闻情绪分析"},{"level":3,"text":"情绪因子的特征","id":"情绪因子的特征"},{"level":3,"text":"大语言模型（LLM）在情绪分析中的应用","id":"大语言模型-llm-在情绪分析中的应用"},{"level":2,"text":"卫星与地理空间数据","id":"卫星与地理空间数据"},{"level":3,"text":"卫星图像因子","id":"卫星图像因子"},{"level":3,"text":"地理位置数据","id":"地理位置数据"},{"level":2,"text":"消费与交易数据","id":"消费与交易数据"},{"level":3,"text":"信用卡数据","id":"信用卡数据"},{"level":3,"text":"电商数据","id":"电商数据"},{"level":2,"text":"ESG 与可持续发展数据","id":"esg-与可持续发展数据"},{"level":3,"text":"ESG 评分作为因子","id":"esg-评分作为因子"},{"level":3,"text":"ESG 因子的特殊性","id":"esg-因子的特殊性"},{"level":2,"text":"另类数据的评估框架","id":"另类数据的评估框架"},{"level":3,"text":"数据质量评估","id":"数据质量评估"},{"level":3,"text":"从数据到因子的标准流程","id":"从数据到因子的标准流程"},{"level":3,"text":"另类数据因子的经济学意义","id":"另类数据因子的经济学意义"},{"level":2,"text":"总结","id":"总结"},{"level":3,"text":"核心要点","id":"核心要点"}],"prev":{"title":"Alpha 信号挖掘方法","url":"/l-doc-books/h/quantitative-finance/factor-models/alpha-research/alpha-signal-mining"},"next":{"title":"机器学习因子模型","url":"/l-doc-books/h/quantitative-finance/factor-models/alpha-research/ml-factor-models"}}