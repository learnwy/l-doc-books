shiki-dark:#79B8FF\"> elements</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">domain];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> shorter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> allTuples</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(domain, arity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> shorter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flatMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> elements.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">t, e]));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> arityOf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>Tarski-Vaught 判定法</strong>为识别初等子结构提供了实用工具：M ≼ N 当且仅当 M ⊆ N 且对每个公式 ∃yφ(ā, y)，如果 N ⊨ ∃yφ(ā, y)，则存在 b ∈ |M| 使得 N ⊨ φ(ā, b)。直觉上，M 中的&quot;见证者足够多&quot;。</p>\n<h2 id=\"类型与饱和模型\">类型与饱和模型</h2><p><strong>类型</strong>是模型论的核心工具，它描述了论域中元素（或元组）的所有一阶可表达性质。</p>\n<p><strong>n 元类型</strong>：给定理论 T 和参数集 A ⊆ |M|，一个 n 元类型 p(x₁,...,xₙ) ∈ Sₙ(A) 是一个最大一致的公式集——包含所有关于 x₁,...,xₙ 的一阶公式中与 T 和 A 一致的极大子集。</p>\n<p><strong>实现与省略</strong>：元组 ā 实现类型 p 如果 M ⊨ φ(ā) 对所有 φ ∈ p。类型 p 在 M 中被省略如果 M 中没有元组实现 p。</p>\n<p><strong>孤立类型</strong>：类型 p 是孤立的如果存在公式 φ ∈ p 使得 φ 蕴含 p 中所有公式。孤立类型总是在模型中被实现。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[类型空间 S_n A] --&gt; B[孤立类型]&#10;    A --&gt; C[非孤立类型]&#10;    B --&gt; D[总被实现]&#10;    C --&gt; E[可以被省略]&#10;    A --&gt; F[饱和模型]&#10;    F --&gt; G[实现所有类型]&#10;    A --&gt; H[原子模型]&#10;    H --&gt; I[只实现孤立类型]&#10;    F --&gt; J[同构唯一性]&#10;    H --&gt; J\">graph TD\n    A[类型空间 S_n A] --&gt; B[孤立类型]\n    A --&gt; C[非孤立类型]\n    B --&gt; D[总被实现]\n    C --&gt; E[可以被省略]\n    A --&gt; F[饱和模型]\n    F --&gt; G[实现所有类型]\n    A --&gt; H[原子模型]\n    H --&gt; I[只实现孤立类型]\n    F --&gt; J[同构唯一性]\n    H --&gt; J</pre><p><strong>饱和模型</strong>：模型 M 是 κ-饱和的如果对任何 |A| &lt; κ 的参数集 A ⊆ |M|，所有 A 上的 1 元类型都在 M 中被实现。饱和模型是&quot;最大&quot;的模型——它包含了所有可能的元素类型。</p>\n<p><strong>原子模型</strong>：模型 M 是原子的如果 M 中每个元组都实现一个孤立类型。原子模型是&quot;最小&quot;的模型——它只包含&quot;必须存在&quot;的元素。</p>\n<table>\n<thead>\n<tr>\n<th>模型类型</th>\n<th>特征</th>\n<th>类型实现</th>\n<th>唯一性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>原子模型</td>\n<td>每个元组实现孤立类型</td>\n<td>最少</td>\n<td>可数理论中可数原子模型唯一</td>\n</tr>\n<tr>\n<td>饱和模型</td>\n<td>实现所有可能类型</td>\n<td>最多</td>\n<td>基数 κ 的饱和模型在 κ 上唯一</td>\n</tr>\n<tr>\n<td>素模型</td>\n<td>初等嵌入到所有模型</td>\n<td>原子</td>\n<td>等同于原子模型</td>\n</tr>\n<tr>\n<td>齐次模型</td>\n<td>自同构可传递</td>\n<td>丰富</td>\n<td>需要额外条件</td>\n</tr>\n</tbody></table>\n<h2 id=\"超积与非标准分析\">超积与非标准分析</h2><p><strong>超积（Ultraproduct）</strong> 是模型论最强大的构造方法之一。给定一族结构 {Mᵢ}ᵢ∈I 和 I 上的超滤子 U，超积 ∏ᵢMᵢ/U 的论域是函数 f: I → ∪ᵢ|Mᵢ|（其中 f(i) ∈ |Mᵢ|）的等价类，等价关系为 f ∼ g 当且仅当 {i | f(i) = g(i)} ∈ U。</p>\n<p><strong>Łoś 定理</strong>：∏ᵢMᵢ/U ⊨ φ([f₁],...,[fₙ]) 当且仅当 {i | Mᵢ ⊨ φ(f₁(i),...,fₙ(i))} ∈ U。</p>\n<p>当所有 Mᵢ = M 时，超积退化为<strong>超幂</strong> M^I/U。Łoś 定理直接给出 M ≡ M^I/U（初等等价），但当 U 是非主超滤子时，M^I/U 通常与 M 不同构——它包含&quot;非标准元素&quot;。</p>\n<p><strong>非标准分析</strong>（Robinson，1966）正是基于超幂构造：取自然数 ℕ 的超幂 <em>ℕ = ℕ^ω/U（ω 是自然数集，U 是非主超滤子），得到的</em>ℕ 包含&quot;无穷大自然数&quot;。进一步构造 *ℝ 得到包含无穷小量的超实数域，使得微积分的 ε-δ 定义可以用无穷小量直接表述。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface Ultrafilter&lt;I&gt; {&#10;  contains: (set: Set&lt;I&gt;) =&gt; boolean;&#10;}&#10;&#10;function ultraproductSatisfies&lt;I&gt;(&#10;  structures: Map&lt;I, Structure&gt;,&#10;  ultrafilter: Ultrafilter&lt;I&gt;,&#10;  formula: string,&#10;  elements: Map&lt;I, string&gt;[],&#10;): boolean {&#10;  const satisfyingIndices = new Set&lt;I&gt;();&#10;&#10;  for (const [i, structure] of structures) {&#10;    const localElements = elements.map((f) =&gt; f.get(i)!);&#10;    if (evaluateFormula(structure, formula, localElements)) {&#10;      satisfyingIndices.add(i);&#10;    }&#10;  }&#10;&#10;  return ultrafilter.contains(satisfyingIndices);&#10;}&#10;&#10;function evaluateFormula(_structure: Structure, _formula: string, _elements: string[]): boolean {&#10;  return true;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Ultrafilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  contains</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">set</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ultraproductSatisfies</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  structures</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Structure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  ultrafilter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Ultrafilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  formula</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  elements</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>[],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> satisfyingIndices</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">I</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">i</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">structure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> structures) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> localElements</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> elements.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> f.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">evaluateFormula</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(structure, formula, localElements)) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      satisfyingIndices.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(i);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ultrafilter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">contains</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(satisfyingIndices);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> evaluateFormula</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_structure</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Structure</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_formula</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">_elements</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[])</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>超积还提供了紧致性定理的语义证明：如果 Γ 的每个有限子集都有模型，取这些模型的超积，由 Łoś 定理得到 Γ 的模型。</p>\n<h2 id=\"范畴性与-morley-定理\">范畴性与 Morley 定理</h2><p><strong>范畴性</strong>是模型论分类理论的核心概念。理论 T 在基数 κ 上是范畴的（κ-categorical），如果 T 的所有基数为 κ 的模型都是同构的。</p>\n<p><strong>Morley 定理（1965）</strong>：如果可数一阶理论 T 在某个不可数基数 κ 上是范畴的，则 T 在所有不可数基数上都是范畴的。</p>\n<p>这个定理极为深刻——它说明一阶理论的&quot;确定性&quot;要么在所有不可数基数上同时成立，要么都不成立。Morley 的证明引入了超越度和 Morley 秩等工具，开创了稳定性理论。</p>\n<table>\n<thead>\n<tr>\n<th>理论</th>\n<th>ω-范畴性</th>\n<th>ω₁-范畴性</th>\n<th>模型数</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>稠密线性序 (DLO)</td>\n<td>是</td>\n<td>否</td>\n<td>ω₁ 上有 2^ω₁ 个</td>\n</tr>\n<tr>\n<td>代数闭域 ACF_p</td>\n<td>否</td>\n<td>是</td>\n<td>ω 上有 ω 个</td>\n</tr>\n<tr>\n<td>随机图</td>\n<td>是</td>\n<td>否</td>\n<td>独特性质</td>\n</tr>\n<tr>\n<td>向量空间</td>\n<td>是</td>\n<td>是</td>\n<td>所有不可数基数范畴</td>\n</tr>\n<tr>\n<td>Peano 算术</td>\n<td>否</td>\n<td>否</td>\n<td>最大模型数</td>\n</tr>\n</tbody></table>\n<p>ω-范畴性（可数范畴性）有一个优美的刻画——<strong>Ryll-Nardzewski 定理</strong>：可数完备理论 T 是 ω-范畴的当且仅当对每个 n，Sₙ(∅) 是有限的，当且仅当 T 的每个模型的自同构群在 n 元组上的轨道有限个。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((模型论基础))&#10;    基本概念&#10;      结构与解释&#10;      同态与嵌入&#10;      初等等价&#10;    类型理论&#10;      类型空间&#10;      饱和模型&#10;      原子模型&#10;    超积&#10;      Łoś 定理&#10;      非标准分析&#10;      紧致性证明&#10;    分类&#10;      范畴性&#10;      Morley 定理&#10;      稳定性\">mindmap\n  root((模型论基础))\n    基本概念\n      结构与解释\n      同态与嵌入\n      初等等价\n    类型理论\n      类型空间\n      饱和模型\n      原子模型\n    超积\n      Łoś 定理\n      非标准分析\n      紧致性证明\n    分类\n      范畴性\n      Morley 定理\n      稳定性</pre><ul>\n<li>模型论研究形式语言与数学结构之间的关系，核心问题是理论的模型有哪些、它们的结构性质如何</li>\n<li>类型刻画了论域元素的所有可表达性质，饱和模型实现所有类型，原子模型只实现必要类型</li>\n<li>超积是模型论最强大的构造工具，Łoś 定理将语义从分量转移到超积，非标准分析是其标志性应用</li>\n<li>Morley 定理表明不可数范畴性在所有不可数基数上同时成立，开创了现代分类理论</li>\n<li>模型论方法在数据库查询优化、程序语义和知识表示中有广泛的计算机科学应用</li>\n</ul>\n","headings":[{"level":1,"text":"模型论基础","id":"模型论基础"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"结构、同态与初等等价","id":"结构-同态与初等等价"},{"level":2,"text":"类型与饱和模型","id":"类型与饱和模型"},{"level":2,"text":"超积与非标准分析","id":"超积与非标准分析"},{"level":2,"text":"范畴性与 Morley 定理","id":"范畴性与-morley-定理"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"构造性逻辑","url":"/l-doc-books/h/mathematics-statistics/mathematical-logic/proof-theory/constructive-logic"},"next":{"title":"形式化规约","url":"/l-doc-books/h/mathematics-statistics/mathematical-logic/model-theory-verification/formal-specification"}}