pan><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c2</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"可判定片段-单体逻辑与-bernays-sch-nfinkel-类\">可判定片段：单体逻辑与 Bernays-Schönfinkel 类</h2><p>一阶逻辑的多个语法片段已被证明可判定，它们通过限制量词模式、变量数或谓词元数来恢复可判定性。</p>\n<p><strong>单体一阶逻辑</strong>：只允许一元谓词（无关系符号、无函数符号）。其可判定性由 Löwenheim（1915）证明。方法是将单体公式转换为命题逻辑公式——论域中的每个元素可以用其满足的一元谓词集合（类型）刻画，类型数有限（2^k 个，k 为谓词数）。</p>\n<p><strong>Bernays-Schönfinkel-Ramsey 类（∃<em>∀</em>）</strong>：量词前缀为 ∃...∃∀...∀ 的句子（无函数符号）。可判定性的直觉：存在量词的见证者数量有限，全称量词只需在有限论域上验证。复杂度为 NEXPTIME 完全。</p>\n<p><strong>二变量片段 FO²</strong>：只使用两个个体变量 x, y 的一阶公式。Scott（1962）和 Mortimer（1975）证明了 FO² 可判定。FO² 虽然只有两个变量，但通过量词嵌套可以表达丰富的性质。其可判定性对描述逻辑（OWL 的理论基础）至关重要。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[一阶逻辑片段] --&gt; B[量词前缀限制]&#10;    A --&gt; C[变量数限制]&#10;    A --&gt; D[谓词元数限制]&#10;    A --&gt; E[结构限制]&#10;    B --&gt; F[∃*∀* Bernays-Schönfinkel]&#10;    B --&gt; G[∀*∃* Ackermann 类]&#10;    C --&gt; H[FO² 二变量]&#10;    C --&gt; I[FO¹ 单变量]&#10;    D --&gt; J[单体逻辑]&#10;    E --&gt; K[守护片段 GF]&#10;    E --&gt; L[松弛守护片段]\">graph TD\n    A[一阶逻辑片段] --&gt; B[量词前缀限制]\n    A --&gt; C[变量数限制]\n    A --&gt; D[谓词元数限制]\n    A --&gt; E[结构限制]\n    B --&gt; F[∃*∀* Bernays-Schönfinkel]\n    B --&gt; G[∀*∃* Ackermann 类]\n    C --&gt; H[FO² 二变量]\n    C --&gt; I[FO¹ 单变量]\n    D --&gt; J[单体逻辑]\n    E --&gt; K[守护片段 GF]\n    E --&gt; L[松弛守护片段]</pre><table>\n<thead>\n<tr>\n<th>片段</th>\n<th>限制</th>\n<th>复杂度</th>\n<th>关键应用</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>单体</td>\n<td>一元谓词</td>\n<td>NEXPTIME</td>\n<td>集合包含推理</td>\n</tr>\n<tr>\n<td>∃<em>∀</em></td>\n<td>量词前缀</td>\n<td>NEXPTIME 完全</td>\n<td>EPR 求解</td>\n</tr>\n<tr>\n<td>FO²</td>\n<td>两个变量</td>\n<td>NEXPTIME</td>\n<td>描述逻辑 ALC</td>\n</tr>\n<tr>\n<td>守护片段</td>\n<td>原子守护量词</td>\n<td>2EXPTIME</td>\n<td>模态逻辑</td>\n</tr>\n<tr>\n<td>计数扩展 C²</td>\n<td>FO² + 计数量词</td>\n<td>NEXPTIME</td>\n<td>OWL 数量限制</td>\n</tr>\n<tr>\n<td>单体 + 计数</td>\n<td>一元 + ∃≥n</td>\n<td>NEXPTIME</td>\n<td>基数约束</td>\n</tr>\n</tbody></table>\n<h2 id=\"smt-求解器与可判定理论的组合\">SMT 求解器与可判定理论的组合</h2><p>SMT（Satisfiability Modulo Theories）求解器将 SAT 求解与可判定一阶理论的判定过程结合，是现代程序验证的核心工具。</p>\n<p>SMT 的核心思想是<strong>理论组合</strong>：一个 SMT 公式可以混合使用多个可判定理论的符号，例如同时涉及整数算术、数组和位向量。Nelson-Oppen 框架提供了组合多个可判定理论的判定过程的系统方法。</p>\n<p><strong>DPLL(T) 架构</strong>：现代 SMT 求解器采用 DPLL(T) 架构——SAT 求解器处理命题层面的搜索，理论求解器（T-solver）处理理论层面的推理。二者通过冲突子句交互。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type TheoryLiteral = {&#10;  theory: string;&#10;  content: string;&#10;  polarity: boolean;&#10;};&#10;&#10;interface TheorySolver {&#10;  name: string;&#10;  checkConsistency(literals: TheoryLiteral[]): ConsistencyResult;&#10;}&#10;&#10;type ConsistencyResult =&#10;  | { status: &#39;sat&#39; }&#10;  | { status: &#39;unsat&#39;; conflictClause: TheoryLiteral[] }&#10;  | { status: &#39;propagate&#39;; implied: TheoryLiteral[] };&#10;&#10;function dpllT(formula: TheoryLiteral[][], solvers: TheorySolver[]): boolean {&#10;  const assignment = new Map&lt;string, boolean&gt;();&#10;&#10;  function solve(): boolean {&#10;    const unitResult = unitPropagate(formula, assignment);&#10;    if (unitResult === &#39;conflict&#39;) return false;&#10;&#10;    for (const solver of solvers) {&#10;      const theoryLits = getAssignedLiterals(assignment, solver.name);&#10;      const result = solver.checkConsistency(theoryLits);&#10;      if (result.status === &#39;unsat&#39;) {&#10;        addConflictClause(formula, result.conflictClause);&#10;        return false;&#10;      }&#10;      if (result.status === &#39;propagate&#39;) {&#10;        for (const lit of result.implied) {&#10;          assignment.set(lit.content, lit.polarity);&#10;        }&#10;      }&#10;    }&#10;&#10;    if (allAssigned(formula, assignment)) return true;&#10;&#10;    const variable = pickUnassigned(formula, assignment);&#10;    assignment.set(variable, true);&#10;    if (solve()) return true;&#10;    assignment.set(variable, false);&#10;    if (solve()) return true;&#10;    assignment.delete(variable);&#10;    return false;&#10;  }&#10;&#10;  return solve();&#10;}&#10;&#10;function unitPropagate(formula: TheoryLiteral[][], assignment: Map&lt;string, boolean&gt;): string {&#10;  return &#39;ok&#39;;&#10;}&#10;&#10;function getAssignedLiterals(assignment: Map&lt;string, boolean&gt;, theory: string): TheoryLiteral[] {&#10;  return [];&#10;}&#10;&#10;function addConflictClause(formula: TheoryLiteral[][], clause: TheoryLiteral[]): void {&#10;  formula.push(clause);&#10;}&#10;&#10;function allAssigned(formula: TheoryLiteral[][], assignment: Map&lt;string, boolean&gt;): boolean {&#10;  return false;&#10;}&#10;&#10;function pickUnassigned(formula: TheoryLiteral[][], assignment: Map&lt;string, boolean&gt;): string {&#10;  return &#39;&#39;;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TheoryLiteral</span><span style=\"c