-shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vars.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> vars.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; j</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      pairs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'not'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        sub: {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'eq'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          left: { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'var'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: vars[i] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          right: { kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'var'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: vars[j] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pairs.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">reduce</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({ kind: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'and'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, left: a, right: b }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>这些局限性不是缺陷，而是一阶逻辑的&quot;黄金比例&quot;——正是紧致性和 Löwenheim-Skolem 性质使得一阶逻辑拥有完备的推理系统和丰富的模型论。</p>\n<h2 id=\"一阶逻辑在计算机科学中的应用\">一阶逻辑在计算机科学中的应用</h2><p>一阶逻辑在计算机科学中的应用极为广泛，是多个核心领域的形式基础。</p>\n<p><strong>数据库理论</strong>：关系代数和关系演算（SQL 的理论基础）本质上是一阶逻辑的变体。SQL 的 SELECT-FROM-WHERE 对应存在量词，NOT EXISTS 对应全称量词的否定，JOIN 对应合取。数据库查询优化中的等价变换直接对应一阶逻辑的等价变换。</p>\n<p><strong>程序验证</strong>：Hoare 逻辑使用一阶公式作为前置条件和后置条件。{P}S{Q} 表示：如果在满足 P 的状态下执行 S，若 S 终止则终止状态满足 Q。循环不变式的发现和验证是一阶推理的核心应用。</p>\n<p><strong>知识表示与推理</strong>：描述逻辑（OWL 本体语言的基础）是一阶逻辑的可判定子片段。Prolog 逻辑编程基于 Horn 子句——一阶逻辑的特殊形式。</p>\n<p><strong>类型系统</strong>：依赖类型理论中的类型可以依赖于值，其类型检查本质上是一阶推理。Coq、Agda 等证明助手的核心都建立在一阶逻辑（及其扩展）之上。</p>\n<table>\n<thead>\n<tr>\n<th>应用领域</th>\n<th>使用的一阶片段</th>\n<th>关键特性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>SQL</td>\n<td>关系演算（无函数符号）</td>\n<td>领域独立性，安全查询</td>\n</tr>\n<tr>\n<td>Prolog</td>\n<td>Horn 子句</td>\n<td>SLD 消解，可判定</td>\n</tr>\n<tr>\n<td>OWL</td>\n<td>描述逻辑（受限量词）</td>\n<td>可判定推理</td>\n</tr>\n<tr>\n<td>Hoare 逻辑</td>\n<td>一阶断言</td>\n<td>前后条件推理</td>\n</tr>\n<tr>\n<td>SMT 求解器</td>\n<td>多 sorted 一阶逻辑</td>\n<td>理论组合</td>\n</tr>\n<tr>\n<td>Alloy</td>\n<td>关系一阶逻辑</td>\n<td>有界模型查找</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((一阶逻辑))&#10;    语法&#10;      项与公式&#10;      自由与约束变量&#10;      签名与语言&#10;    语义&#10;      结构与论域&#10;      解释函数&#10;      满足关系&#10;    表达能力&#10;      Lindström 定理&#10;      紧致性&#10;      Löwenheim-Skolem&#10;    应用&#10;      数据库理论&#10;      程序验证&#10;      知识表示&#10;      类型系统\">mindmap\n  root((一阶逻辑))\n    语法\n      项与公式\n      自由与约束变量\n      签名与语言\n    语义\n      结构与论域\n      解释函数\n      满足关系\n    表达能力\n      Lindström 定理\n      紧致性\n      Löwenheim-Skolem\n    应用\n      数据库理论\n      程序验证\n      知识表示\n      类型系统</pre><ul>\n<li>一阶逻辑通过引入个体变量、量词和谓词，将命题逻辑的表达能力从命题间关系扩展到对象的属性和关系</li>\n<li>语法由签名确定（常量、函数、谓词），语义由结构给出（论域 + 解释函数 + 赋值）</li>\n<li>一阶逻辑是满足紧致性和 Löwenheim-Skolem 性质的最强逻辑（Lindström 定理），这些性质既是力量也是边界</li>\n<li>数据库查询、程序验证、知识表示、类型系统等计算机科学核心领域都以一阶逻辑为形式基础</li>\n<li>一阶逻辑的半可判定性（有效公式可枚举但不可判定）是其在自动推理中需要面对的根本挑战</li>\n</ul>\n","headings":[{"level":1,"text":"一阶逻辑","id":"一阶逻辑"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"一阶语言的语法构成","id":"一阶语言的语法构成"},{"level":2,"text":"一阶结构与语义解释","id":"一阶结构与语义解释"},{"level":2,"text":"一阶逻辑的表达能力与局限","id":"一阶逻辑的表达能力与局限"},{"level":2,"text":"一阶逻辑在计算机科学中的应用","id":"一阶逻辑在计算机科学中的应用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"SAT 问题","url":"/l-doc-books/h/mathematics-statistics/mathematical-logic/propositional-logic/sat-problem"},"next":{"title":"量词与推理","url":"/l-doc-books/h/mathematics-statistics/mathematical-logic/predicate-logic/quantifiers-inference"}}