:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">left</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}, ${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extractProgram</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">right</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}]`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'inl'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `Left(${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extractProgram</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">})`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'inr'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `Right(${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extractProgram</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">})`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'witness'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `{ witness: ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">value</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}, proof: ${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extractProgram</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} }`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'var'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> proof.name;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    case</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'absurd'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> `absurd(${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extractProgram</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">proof</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">contradiction</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">})`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>析取性质和存在性质使得构造性证明具有直接的计算价值——从证明中总能提取出具体的计算结果。这正是 Coq 的程序提取功能的理论保证。</p>\n<h2 id=\"kripke-语义与拓扑语义\">Kripke 语义与拓扑语义</h2><p>构造性逻辑的语义不能用经典的二值真值表刻画。Kripke 语义和拓扑语义为其提供了精确的数学模型。</p>\n<p><strong>Kripke 语义</strong>：一个 Kripke 模型 K = (W, ≤, V) 由可能世界集 W、偏序关系 ≤（时间/知识的增长）和赋值函数 V 组成。关键的单调性条件：如果 w ⊩ p 且 w ≤ w&#39;，则 w&#39; ⊩ p（一旦知道为真，永远为真）。</p>\n<ul>\n<li>w ⊩ φ ∧ ψ 当且仅当 w ⊩ φ 且 w ⊩ ψ</li>\n<li>w ⊩ φ ∨ ψ 当且仅当 w ⊩ φ 或 w ⊩ ψ</li>\n<li>w ⊩ φ → ψ 当且仅当对所有 w&#39; ≥ w，w&#39; ⊩ φ 蕴含 w&#39; ⊩ ψ</li>\n<li>w ⊩ ¬φ 当且仅当对所有 w&#39; ≥ w，w&#39; ⊮ φ</li>\n</ul>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph BT&#10;    W1[w₁: p 未知] --&gt; W2[w₂: p 为真]&#10;    W1 --&gt; W3[w₃: p 为假]&#10;    W2 --&gt; W4[w₄: p 为真]&#10;    W3 --&gt; W5[w₅: p 为假]\">graph BT\n    W1[w₁: p 未知] --&gt; W2[w₂: p 为真]\n    W1 --&gt; W3[w₃: p 为假]\n    W2 --&gt; W4[w₄: p 为真]\n    W3 --&gt; W5[w₅: p 为假]</pre><p>在上述 Kripke 模型中，w₁ ⊮ p ∨ ¬p——排中律在 w₁ 不成立，因为在 w₁ 我们既不知道 p 为真也不知道 p 为假。这直觉地解释了为什么排中律在构造性逻辑中不成立：在不完全知识的状态下，我们不能断言 p 或 ¬p。</p>\n<p><strong>拓扑语义</strong>：将命题解释为拓扑空间中的开集。∧ 对应交集，∨ 对应并集，→ 对应内部化的蕴含，¬ 对应内部化的补集。开集的关键性质——不需要&quot;边界上的信息&quot;——精确地对应了构造性逻辑的&quot;可验证性&quot;要求。</p>\n<table>\n<thead>\n<tr>\n<th>语义</th>\n<th>直觉</th>\n<th>∨ 的解释</th>\n<th>¬ 的解释</th>\n<th>完备性</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>BHK</td>\n<td>构造性见证</td>\n<td>指明哪一方</td>\n<td>φ → ⊥</td>\n<td>非形式</td>\n</tr>\n<tr>\n<td>Kripke</td>\n<td>知识增长</td>\n<td>当前已知哪一方</td>\n<td>永远不会知道</td>\n<td>完备</td>\n</tr>\n<tr>\n<td>拓扑</td>\n<td>可验证性</td>\n<td>开集并集</td>\n<td>补集的内部</td>\n<td>完备</td>\n</tr>\n<tr>\n<td>实现性</td>\n<td>程序实现</td>\n<td>标记 + 程序</td>\n<td>无法实现</td>\n<td>完备</td>\n</tr>\n<tr>\n<td>Beth</td>\n<td>强制</td>\n<td>密集覆盖</td>\n<td>密集否定</td>\n<td>完备</td>\n</tr>\n</tbody></table>\n<h2 id=\"排中律的计算含义\">排中律的计算含义</h2><p>排中律 φ ∨ ¬φ 在构造性逻辑中不成立，但理解<strong>为什么</strong>不成立以及它在计算中<strong>对应什么</strong>至关重要。</p>\n<p>排中律不是&quot;错误的&quot;——它只是&quot;非构造的&quot;。排中律断言&quot;要么 φ 要么 ¬φ&quot;，但不提供判断的方法。在可判定命题上（如&quot;n 是偶数&quot;），排中律的实例是构造性可证的。问题出在不可判定命题上（如&quot;程序 P 是否停机&quot;）。</p>\n<p><strong>Griffin 的发现（1990）</strong>：经典逻辑的排中律（更精确地说，Peirce 律 ((φ → ψ) → φ) → φ）在计算上对应于<strong>call/cc</strong>（call-with-current-continuation）操作。这意味着：</p>\n<ul>\n<li>经典证明 = 允许 call/cc 的程序</li>\n<li>构造性证明 = 纯函数式程序（无控制效果）</li>\n<li>排中律 = 类型为 <code>∀A. A + (A → Void)</code> 的程序（不存在纯实现）</li>\n</ul>\n<p><strong>双重否定翻译</strong>：经典逻辑可以通过 Gödel-Gentzen 或 Kolmogorov 翻译嵌入构造性逻辑。核心思想是在每个子公式外包裹双重否定：φ ↦ ¬¬φ。翻译后的公式在构造性逻辑中可证。</p>\n<p>计算含义：双重否定翻译对应于 CPS（Continuation-Passing Style）变换。¬¬A 在类型论中解读为 (A → ⊥) → ⊥，即&quot;给我一个 A 的消费者，我能运行它&quot;——这正是 CPS 的核心概念。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type Continuation&lt;A&gt; = (value: A) =&gt; never;&#10;&#10;type DoubleNegation&lt;A&gt; = (k: Continuation&lt;A&gt;) =&gt; never;&#10;&#10;function dnReturn&lt;A&gt;(value: A): DoubleNegation&lt;A&gt; {&#10;  return (k) =&gt; k(value);&#10;}&#10;&#10;function dnBind&lt;A, B&gt;(ma: DoubleNegation&lt;A&gt;, f: (a: A) =&gt; DoubleNegation&lt;B&gt;): DoubleNegation&lt;B&gt; {&#10;  return (k) =&gt; ma((a) =&gt; f(a)(k));&#10;}&#10;&#10;function classicalToConstructive&lt;A&gt;(classicalProof: DoubleNegation&lt;A&gt;): DoubleNegation&lt;A&gt; {&#10;  return classicalProof;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Continuation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> never</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">k</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Continuation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> never</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dnReturn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">value</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">k</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> k</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(value);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> dnBind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">B</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ma</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">f</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">B</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">B</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">k</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ma</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(a)(k));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> classicalToConstructive</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">classicalProof</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DoubleNegation</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> classicalProof;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>经典原则</th>\n<th>构造等价</th>\n<th>计算对应</th>\n<th>CPS 翻译</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>φ ∨ ¬φ</td>\n<td>¬¬(φ ∨ ¬φ)</td>\n<td>call/cc</td>\n<td>可 CPS</td>\n</tr>\n<tr>\n<td>¬¬φ → φ</td>\n<td>¬¬(¬¬φ → φ)</td>\n<td>throw/catch</td>\n<td>可 CPS</td>\n</tr>\n<tr>\n<td>Peirce 律</td>\n<td>¬¬Peirce</td>\n<td>callcc</td>\n<td>可 CPS</td>\n</tr>\n<tr>\n<td>De Morgan</td>\n<td>部分成立</td>\n<td>部分纯</td>\n<td>部分不需要</td>\n</tr>\n</tbody></table>\n<h2 id=\"构造性逻辑在软件工程中的应用\">构造性逻辑在软件工程中的应用</h2><p>构造性逻辑通过证明助手和类型系统在现代软件工程中发挥着实际作用。</p>\n<p><strong>证明助手与形式验证</strong>：Coq、Agda、Lean 基于构造性类型论（Martin-Löf 类型论或其变体），在构造性逻辑中编写证明即编写程序。CompCert（经过验证的 C 编译器）和 sel4（经过验证的微内核）都使用 Coq 进行了形式验证。</p>\n<p><strong>程序提取</strong>：从构造性证明中自动提取可执行代码。例如，证明&quot;对任何列表，存在其排序版本&quot;即定义了排序算法。Coq 的 <code>Extraction</code> 命令可以从证明生成 OCaml 或 Haskell 代码。</p>\n<p><strong>依赖类型编程</strong>：Agda 和 Idris 允许类型依赖于值，将构造性逻辑直接嵌入编程语言。例如，类型 <code>Vec n A</code>（长度恰好为 n 的列表）在类型层面保证了长度正确性。</p>\n<p><strong>Rust 的类型系统</strong>：Rust 的生命周期和所有权系统虽然不直接基于构造性逻辑，但其&quot;使用即证明&quot;的设计哲学与构造性思想一脉相承。值的移动和借用对应于线性逻辑中的资源管理。</p>\n<table>\n<thead>\n<tr>\n<th>工具</th>\n<th>基础理论</th>\n<th>构造性特性</th>\n<th>应用案例</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Coq</td>\n<td>CIC（构造归纳演算）</td>\n<td>程序提取、策略证明</td>\n<td>CompCert、sel4</td>\n</tr>\n<tr>\n<td>Agda</td>\n<td>Martin-Löf 类型论</td>\n<td>依赖类型编程</td>\n<td>标准库证明</td>\n</tr>\n<tr>\n<td>Lean 4</td>\n<td>CIC 变体</td>\n<td>证明自动化</td>\n<td>Mathlib 数学库</td>\n</tr>\n<tr>\n<td>Idris 2</td>\n<td>量化类型论</td>\n<td>依赖类型 + 资源跟踪</td>\n<td>协议验证</td>\n</tr>\n<tr>\n<td>F*</td>\n<td>依赖类型 + 效果</td>\n<td>SMT 辅助证明</td>\n<td>Project Everest</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((构造性逻辑))&#10;    BHK 解释&#10;      证明 = 构造&#10;      析取性质&#10;      存在性质&#10;    语义模型&#10;      Kripke 语义&#10;      拓扑语义&#10;      实现性&#10;    排中律&#10;      计算含义&#10;      call/cc 对应&#10;      CPS 翻译&#10;    应用&#10;      证明助手&#10;      程序提取&#10;      依赖类型&#10;      形式验证\">mindmap\n  root((构造性逻辑))\n    BHK 解释\n      证明 = 构造\n      析取性质\n      存在性质\n    语义模型\n      Kripke 语义\n      拓扑语义\n      实现性\n    排中律\n      计算含义\n      call/cc 对应\n      CPS 翻译\n    应用\n      证明助手\n      程序提取\n      依赖类型\n      形式验证</pre><ul>\n<li>构造性逻辑要求证明提供构造性见证，拒绝排中律和双重否定消去，使证明具有直接的计算内容</li>\n<li>BHK 解释将逻辑联结词赋予计算含义，析取性质和存在性质保证了从证明中可提取具体结果</li>\n<li>Kripke 语义以&quot;知识增长&quot;模型精确刻画了构造性逻辑的语义，排中律在不完全知识状态下不成立</li>\n<li>排中律在计算上对应 call/cc，经典逻辑通过双重否定翻译（CPS 变换）嵌入构造性逻辑</li>\n<li>Coq、Agda、Lean 等证明助手将构造性逻辑应用于形式验证和程序提取，在编译器验证和操作系统验证中取得了重要成果</li>\n</ul>\n","headings":[{"level":1,"text":"构造性逻辑","id":"构造性逻辑"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"BHK 解释与析取性质","id":"bhk-解释与析取性质"},{"level":2,"text":"Kripke 语义与拓扑语义","id":"kripke-语义与拓扑语义"},{"level":2,"text":"排中律的计算含义","id":"排中律的计算含义"},{"level":2,"text":"构造性逻辑在软件工程中的应用","id":"构造性逻辑在软件工程中的应用"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"不完备性定理","url":"/l-doc-books/h/mathematics-statistics/mathematical-logic/proof-theory/incompleteness-theorems"},"next":{"title":"模型论基础","url":"/l-doc-books/h/mathematics-statistics/mathematical-logic/model-theory-verification/model-theory-basics"}}