hiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">formula</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  encodeProof</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">steps</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[][]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  isProofOf</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">proofCode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">formulaCode</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> diagonalize</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">theory</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[], </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">phi</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">godelNum</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> bigint</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> template</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '∃x(x = ⌈σ⌉ ∧ φ(x))'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> encoded</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> godelEncode</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> phi</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(encoded);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>对角化引理的证明构造性地给出了 σ：取公式 φ(x) 代入自身的哥德尔数后的结果。这个&quot;自我引用&quot;的技术让我们可以构造出关于自身可证性的命题。</p>\n<h2 id=\"第一不完备性定理\">第一不完备性定理</h2><p><strong>定理（哥德尔，1931）</strong>：设 T 是包含 Robinson 算术 Q 的一致递归可枚举理论。则存在算术句子 G 使得 T ⊬ G 且 T ⊬ ¬G。</p>\n<p><strong>构造哥德尔句子 G</strong>：定义 Prov_T(x) = ∃y Proof_T(y, x)（&quot;x 可证&quot;）。由对角化引理，存在句子 G 使得 T ⊢ G ↔ ¬Prov_T(⌈G⌉)。即 G 直觉上说&quot;我不可证&quot;。</p>\n<p><strong>证明 T ⊬ G</strong>：假设 T ⊢ G。则存在 G 的证明 p，故 Proof_T(⌈p⌉, ⌈G⌉) 在标准模型中为真。由 T 的 Σ₁-完备性，T ⊢ Prov_T(⌈G⌉)。但 T ⊢ G 蕴含 T ⊢ ¬Prov_T(⌈G⌉)，矛盾。</p>\n<p><strong>证明 T ⊬ ¬G</strong>（需 ω-一致性或 Rosser 改进）：假设 T ⊢ ¬G，即 T ⊢ Prov_T(⌈G⌉)。但 G 实际上不可证（由上一步），所以对每个具体数 n，T ⊢ ¬Proof_T(n̄, ⌈G⌉)。如果 T 是 ω-一致的，则 T ⊬ ∃y Proof_T(y, ⌈G⌉)，即 T ⊬ Prov_T(⌈G⌉)，矛盾。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    A[构造 G: G ↔ ¬ProvT ⌈G⌉] --&gt; B{假设 T ⊢ G}&#10;    B --&gt;|则| C[存在证明 p]&#10;    C --&gt; D[T ⊢ ProvT ⌈G⌉]&#10;    D --&gt; E[T ⊢ G ∧ ¬G 矛盾]&#10;    A --&gt; F{假设 T ⊢ ¬G}&#10;    F --&gt;|则| G2[T ⊢ ProvT ⌈G⌉]&#10;    G2 --&gt; H[但 G 实际不可证]&#10;    H --&gt; I[ω-一致性矛盾]&#10;    E --&gt; J[T ⊬ G]&#10;    I --&gt; K[T ⊬ ¬G]&#10;    J --&gt; L[G 独立于 T]&#10;    K --&gt; L\">graph TD\n    A[构造 G: G ↔ ¬ProvT ⌈G⌉] --&gt; B{假设 T ⊢ G}\n    B --&gt;|则| C[存在证明 p]\n    C --&gt; D[T ⊢ ProvT ⌈G⌉]\n    D --&gt; E[T ⊢ G ∧ ¬G 矛盾]\n    A --&gt; F{假设 T ⊢ ¬G}\n    F --&gt;|则| G2[T ⊢ ProvT ⌈G⌉]\n    G2 --&gt; H[但 G 实际不可证]\n    H --&gt; I[ω-一致性矛盾]\n    E --&gt; J[T ⊬ G]\n    I --&gt; K[T ⊬ ¬G]\n    J --&gt; L[G 独立于 T]\n    K --&gt; L</pre><p>Rosser（1936）的改进只需一致性（不需 ω-一致性）。Rosser 句子 R 说&quot;如果我有证明，则存在更短的反证&quot;，这个更精巧的自指避免了对 ω-一致性的依赖。</p>\n<p>哥德尔句子 G 在标准自然数模型中是<strong>真</strong>的——因为 G 说&quot;我不可证&quot;，而它确实不可证。这意味着 T 遗漏了一个真命题，揭示了形式可证性与数学真理之间的永恒鸿沟。</p>\n<h2 id=\"第二不完备性定理\">第二不完备性定理</h2><p><strong>定理（哥德尔，1931）</strong>：设 T 是包含 Peano 算术 PA 的一致递归可枚举理论。则 T ⊬ Con(T)，其中 Con(T) = ¬Prov_T(⌈⊥⌉)（&quot;T 不证明矛盾&quot;）。</p>\n<p>证明思路：第一不完备性定理本质上在 T 内部证明了&quot;如果 T 一致则 G 不可证&quot;，即 T ⊢ Con(T) → G。如果 T ⊢ Con(T)，则 T ⊢ G，矛盾（因为 T ⊬ G）。</p>\n<p>这个定理的前提比第一定理更强——需要 T 包含 PA（不仅仅是 Q），因为证明需要在 T 内部推导 Prov_T 的性质（希尔伯特-贝尔纳斯-勒布条件）。</p>\n<p><strong>希尔伯特-贝尔纳斯-勒布条件</strong>（HBL 条件）：</p>\n<ol>\n<li>如果 T ⊢ φ，则 T ⊢ Prov_T(⌈φ⌉)</li>\n<li>T ⊢ Prov_T(⌈φ → ψ⌉) → (Prov_T(⌈φ⌉) → Prov_T(⌈ψ⌉))</li>\n<li>T ⊢ Prov_T(⌈φ⌉) → Prov_T(⌈Prov_T(⌈φ⌉)⌉)</li>\n</ol>\n<p>第二不完备性定理的深远影响：</p>\n<ul>\n<li><strong>希尔伯特纲领的终结</strong>：有穷方法（可形式化在 PRA 或 PA 中）无法证明 PA 的一致性，更不能证明更强系统（如 ZFC）的一致性</li>\n<li><strong>一致性强度层级</strong>：Con(PA) 需要比 PA 更强的系统证明（如 PA + Con(PA)，或 ε₀-归纳法）</li>\n<li><strong>Gentzen 的贡献</strong>：Gentzen（1936）用超穷归纳（ε₀ 上的归纳）证明了 PA 的一致性，这超出了 PA 但被认为是&quot;构造性可接受的&quot;</li>\n</ul>\n<table>\n<thead>\n<tr>\n<th>系统</th>\n<th>一致性证明</th>\n<th>使用方法</th>\n<th>序数强度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>PRA</td>\n<td>PA 中可证</td>\n<td>有穷方法</td>\n<td>ω^ω</td>\n</tr>\n<tr>\n<td>PA</td>\n<td>需要 ε₀-归纳</td>\n<td>Gentzen 方法</td>\n<td>ε₀</td>\n</tr>\n<tr>\n<td>PA + Con(PA)</td>\n<td>需要更强系统</td>\n<td>迭代反思</td>\n<td>ε₀·2</td>\n</tr>\n<tr>\n<td>ZFC</td>\n<td>大基数假设</td>\n<td>—</td>\n<td>不可达基数</td>\n</tr>\n</tbody></table>\n<h2 id=\"不完备性定理的计算意义\">不完备性定理的计算意义</h2><p>不完备性定理与计算理论有深刻的联系，通过 Church-Turing 论题，逻辑不完备性和计算不可判定性是同一现象的两面。</p>\n<p><strong>停机问题与不完备性</strong>：图灵机的停机问题不可判定——不存在程序能判断任意程序是否停机。这等价于：不存在形式系统能证明所有停机性质。对任何一致系统 T，存在程序 P 使得 P 不停机但 T ⊬ &quot;P 不停机&quot;。</p>\n<p><strong>Chaitin 不完备性</strong>：Chaitin 的 Ω 数（停机概率）提供了不完备性的信息论视角。定理：存在常数 c 使得 T 不能证明 Ω 的任何超过 c 位的小数位。这意味着形式系统的&quot;知识容量&quot;是有限的——不可能从有限的公理推导出无限多的随机比特。</p>\n<p><strong>Kolmogorov 复杂度视角</strong>：不完备性的另一个表述：形式系统 T 不能证明&quot;程序 P 的 Kolmogorov 复杂度大于 c&quot;（c 依赖于 T 的复杂度）。这说明形式系统无法识别超越自身复杂度的随机性。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface FormalSystem {&#10;  name: string;&#10;  axiomComplexity: number;&#10;  canProve: (statement: string) =&gt; boolean;&#10;}&#10;&#10;function chaitinLimit(system: FormalSystem): number {&#10;  return system.axiomComplexity + Math.ceil(Math.log2(system.axiomComplexity));&#10;}&#10;&#10;function incompletenessWitness(system: FormalSystem): string {&#10;  const limit = chaitinLimit(system);&#10;  return `K(x) &gt; ${limit}`;&#10;}&#10;&#10;function godelSentence(system: FormalSystem): string {&#10;  return `¬Prov_${system.name}(⌈G⌉)`;&#10;}&#10;&#10;function consistencyStatement(system: FormalSystem): string {&#10;  return `¬Prov_${system.name}(⌈⊥⌉)`;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FormalSystem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  axiomComplex