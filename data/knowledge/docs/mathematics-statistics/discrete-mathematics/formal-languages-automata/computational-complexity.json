n<td>寄存器分配</td>\n</tr>\n<tr>\n<td>HAMILTONIAN-PATH</td>\n<td>哈密顿路径</td>\n<td>3-SAT</td>\n<td>路径规划</td>\n</tr>\n<tr>\n<td>SUBSET-SUM</td>\n<td>子集和</td>\n<td>3-SAT</td>\n<td>密码学</td>\n</tr>\n<tr>\n<td>TSP（判定）</td>\n<td>旅行商问题</td>\n<td>HAM-PATH</td>\n<td>物流优化</td>\n</tr>\n<tr>\n<td>KNAPSACK</td>\n<td>背包问题</td>\n<td>SUBSET-SUM</td>\n<td>资源分配</td>\n</tr>\n</tbody></table>\n<h2 id=\"应对-np-困难问题\">应对 NP 困难问题</h2><p>面对 NP 困难问题，实践中有三种主要策略：</p>\n<p><strong>近似算法</strong>：在多项式时间内找到接近最优的解。近似比 ρ 衡量解的质量。</p>\n<p><strong>参数化复杂性</strong>：将问题的难度分离到一个参数 k 上。若算法时间为 f(k)·n^c，则问题对参数 k 是固定参数可处理的（FPT）。</p>\n<p><strong>启发式与随机化</strong>：不保证最优但实践中表现良好的方法。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function greedyVertexCover(adj: Map&lt;number, Set&lt;number&gt;&gt;): Set&lt;number&gt; {&#10;  const cover = new Set&lt;number&gt;();&#10;  const edges = new Set&lt;string&gt;();&#10;&#10;  for (const [u, neighbors] of adj) {&#10;    for (const v of neighbors) {&#10;      if (u &lt; v) edges.add(`${u},${v}`);&#10;    }&#10;  }&#10;&#10;  for (const edge of edges) {&#10;    const [u, v] = edge.split(&#39;,&#39;).map(Number);&#10;    if (!cover.has(u) &amp;&amp; !cover.has(v)) {&#10;      cover.add(u);&#10;      cover.add(v);&#10;    }&#10;  }&#10;  return cover;&#10;}&#10;&#10;function tspNearestNeighbor(dist: number[][], start: number = 0): { path: number[]; cost: number } {&#10;  const n = dist.length;&#10;  const visited = new Set&lt;number&gt;();&#10;  const path = [start];&#10;  visited.add(start);&#10;  let cost = 0;&#10;&#10;  while (visited.size &lt; n) {&#10;    const current = path[path.length - 1];&#10;    let nearest = -1;&#10;    let minDist = Infinity;&#10;&#10;    for (let i = 0; i &lt; n; i++) {&#10;      if (!visited.has(i) &amp;&amp; dist[current][i] &lt; minDist) {&#10;        minDist = dist[current][i];&#10;        nearest = i;&#10;      }&#10;    }&#10;&#10;    path.push(nearest);&#10;    visited.add(nearest);&#10;    cost += minDist;&#10;  }&#10;&#10;  cost += dist[path[path.length - 1]][start];&#10;  return { path, cost };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> greedyVertexCover</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">adj</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Map</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> cover</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"><span style=\"color:#D73A