:#E1E4E8\">, coRecognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { language: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'EQ_DFA（DFA 等价问题）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, decidable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, recognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, coRecognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { language: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'A_TM（TM 接受问题）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, decidable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, recognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, coRecognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { language: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'HALT_TM（停机问题）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, decidable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, recognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, coRecognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { language: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'E_TM（TM 空性问题）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, decidable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, recognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, coRecognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { language: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'EQ_TM（TM 等价问题）'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, decidable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, recognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, coRecognizable: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span></code></pre></div><p><strong>Rice 定理</strong>：图灵机的任何非平凡语义性质都是不可判定的。即如果性质 P 不是对所有 TM 都成立也不是对所有 TM 都不成立，则判定&quot;给定 TM 是否满足 P&quot;是不可判定的。</p>\n<table>\n<thead>\n<tr>\n<th>判定问题</th>\n<th>可判定性</th>\n<th>归约来源</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>TM 是否接受输入 w</td>\n<td>不可判定</td>\n<td>—</td>\n</tr>\n<tr>\n<td>TM 是否停机</td>\n<td>不可判定</td>\n<td>A_TM</td>\n</tr>\n<tr>\n<td>TM 语言是否为空</td>\n<td>不可判定</td>\n<td>A_TM</td>\n</tr>\n<tr>\n<td>两个 TM 是否等价</td>\n<td>不可判定</td>\n<td>E_TM</td>\n</tr>\n<tr>\n<td>TM 语言是否正则</td>\n<td>不可判定</td>\n<td>Rice 定理</td>\n</tr>\n</tbody></table>\n<h2 id=\"chomsky-层次\">Chomsky 层次</h2><p>Chomsky 层次将形式语言按表达能力从弱到强分为四类：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph &quot;Chomsky 层次&quot;&#10;        A[&quot;Type 0: 递归可枚举语言&quot;] --&gt; B[&quot;Type 1: 上下文敏感语言&quot;]&#10;        B --&gt; C[&quot;Type 2: 上下文无关语言&quot;]&#10;        C --&gt; D[&quot;Type 3: 正则语言&quot;]&#10;    end\">graph TD\n    subgraph \"Chomsky 层次\"\n        A[\"Type 0: 递归可枚举语言\"] --&gt; B[\"Type 1: 上下文敏感语言\"]\n        B --&gt; C[\"Type 2: 上下文无关语言\"]\n        C --&gt; D[\"Type 3: 正则语言\"]\n    end</pre><p>| 类型   | 语言类   | 文法限制      | 自动机  | 封闭性   |\n| ------ | -------- | ------------- | ------- | -------- | --- | --- | --- | -------- |\n| Type 3 | 正则语言 | A → aB, A → a | DFA/NFA | 全部封闭 |\n| Type 2 | CFL      | A → α         | PDA     | 非交补   |\n| Type 1 | CSL      |               | α       | ≤        | β   |     | LBA | 全部封闭 |\n| Type 0 | RE       | 无限制        | TM      | 非补     |</p>\n<p>每一层严格包含下一层。这个层次结构是计算理论和编译原理的理论基石。</p>\n<h2 id=\"小结\">小结</h2><pre class=\"mermaid\" data-diagram-type=\"mindmap\" data-source=\"mindmap&#10;  root((图灵机与可计算性))&#10;    图灵机&#10;      形式定义&#10;      计算过程&#10;      通用图灵机&#10;    可判定性&#10;      递归语言&#10;      递归可枚举&#10;      不可判定&#10;    停机问题&#10;      对角化论证&#10;      归约方法&#10;      Rice 定理&#10;    Chomsky 层次&#10;      Type 0-3&#10;      语言包含关系&#10;      自动机对应\">mindmap\n  root((图灵机与可计算性))\n    图灵机\n      形式定义\n      计算过程\n      通用图灵机\n    可判定性\n      递归语言\n      递归可枚举\n      不可判定\n    停机问题\n      对角化论证\n      归约方法\n      Rice 定理\n    Chomsky 层次\n      Type 0-3\n      语言包含关系\n      自动机对应</pre><ul>\n<li>图灵机定义了&quot;可计算&quot;的边界，Church-Turing 论题断言其计算能力等价于任何合理计算模型</li>\n<li>停机问题是第一个被证明不可判定的问题，对角化论证是其核心证明技术</li>\n<li>Rice 定理表明图灵机的任何非平凡语义性质都不可判定，这限制了静态分析的能力</li>\n<li>Chomsky 层次将形式语言分为四类，每一层对应不同的自动机模型和计算能力</li>\n<li>可判定性理论揭示了计算的根本限制，是理解算法可行性的理论基础</li>\n</ul>\n","headings":[{"level":1,"text":"图灵机与可计算性","id":"图灵机与可计算性"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"图灵机的形式化定义","id":"图灵机的形式化定义"},{"level":2,"text":"通用图灵机与停机问题","id":"通用图灵机与停机问题"},{"level":2,"text":"可判定性与归约","id":"可判定性与归约"},{"level":2,"text":"Chomsky 层次","id":"chomsky-层次"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"上下文无关语言","url":"/l-doc-books/h/mathematics-statistics/discrete-mathematics/formal-languages-automata/context-free-languages"},"next":{"title":"计算复杂性理论","url":"/l-doc-books/h/mathematics-statistics/discrete-mathematics/formal-languages-automata/computational-complexity"}}