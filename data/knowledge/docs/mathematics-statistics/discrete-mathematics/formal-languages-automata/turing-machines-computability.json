#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cannotDecideHalting</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(input, input);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (result </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'halts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        while</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> paradoxMachine;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h2 id=\"可判定性与归约\">可判定性与归约</h2><p><strong>语言分类</strong>：</p>\n<ul>\n<li><strong>递归语言</strong>（Decidable）：存在总是停机的图灵机判定之</li>\n<li><strong>递归可枚举语言</strong>（R.E.）：存在图灵机识别之（接受时停机，不接受时可能不停机）</li>\n<li><strong>非递归可枚举语言</strong>：不存在图灵机识别之</li>\n</ul>\n<p><strong>归约</strong>（Reduction）：问题 A 归约到问题 B（A ≤ B），意味着如果能解决 B 就能解决 A。归约用于证明不可判定性：如果 A 不可判定且 A ≤ B，则 B 也不可判定。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"type Language = (input: string) =&gt; boolean;&#10;&#10;interface DecidabilityResult {&#10;  language: string;&#10;  decidable: boolean;&#10;  recognizable: boolean;&#10;  coRecognizable: boolean;&#10;}&#10;&#10;const classicResults: DecidabilityResult[] = [&#10;  { language: &#39;A_DFA（DFA 接受问题）&#39;, decidable: true, recognizable: true, coRecognizable: true },&#10;  { language: &#39;A_CFG（CFG 成员问题）&#39;, decidable: true, recognizable: true, coRecognizable: true },&#10;  { language: &#39;E_DFA（DFA 空性问题）&#39;, decidable: true, recognizable: true, coRecognizable: true },&#10;  { language: &#39;EQ_DFA（DFA 等价问题）&#39;, decidable: true, recognizable: true, coRecognizable: true },&#10;  { language: &#39;A_TM（TM 接受问题）&#39;, decidable: false, recognizable: true, coRecognizable: false },&#10;  { language: &#39;HALT_TM（停机问题）&#39;, decidable: false, recognizable: true, coRecognizable: false },&#10;  { language: &#39;E_TM（TM 空性问题）&#39;, decidable: false, recognizable: false, coRecognizable: true },&#10;  { language: &#39;EQ_TM（TM 等价问题）&#39;, decidable: false, recognizable: false, coRecognizable: false },&#10;];\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Language</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">input</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#242