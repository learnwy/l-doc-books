  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { accepted: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, rejected: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, tape };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>图灵机的计算过程</strong>：从初始状态开始，读写头位于输入的最左端。每一步根据当前状态和读写头下的符号，执行转移：写入新符号、移动读写头、转入新状态。当进入接受状态时接受，进入拒绝状态时拒绝。</p>\n<h2 id=\"通用图灵机与停机问题\">通用图灵机与停机问题</h2><p><strong>通用图灵机</strong>（Universal Turing Machine, UTM）是一个特殊的图灵机，它将另一个图灵机的描述 ⟨M⟩ 和输入 w 作为输入，模拟 M 在 w 上的运行。UTM 的存在证明了&quot;可编程计算机&quot;的概念在理论上是可行的。</p>\n<p><strong>停机问题</strong>（Halting Problem）：给定图灵机 M 和输入 w，判定 M 在 w 上是否停机。Turing 通过对角化论证证明了停机问题不可判定。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph TD&#10;    subgraph &quot;停机问题不可判定证明(反证法)&quot;&#10;        A[&quot;假设存在判定器 H&quot;] --&gt; B[&quot;构造 D: 输入 ⟨M⟩&quot;]&#10;        B --&gt; C{&quot;H(⟨M⟩, ⟨M⟩) = ?&quot;}&#10;        C --&gt;|&quot;接受(M 停机)&quot;| D[&quot;D 进入死循环&quot;]&#10;        C --&gt;|&quot;拒绝(M 不停机)&quot;| E[&quot;D 接受&quot;]&#10;        D --&gt; F[&quot;D(⟨D⟩) 不停机&quot;]&#10;        E --&gt; G[&quot;D(⟨D⟩) 停机&quot;]&#10;        F --&gt; H[&quot;矛盾！&quot;]&#10;        G --&gt; H&#10;    end\">graph TD\n    subgraph \"停机问题不可判定证明(反证法)\"\n        A[\"假设存在判定器 H\"] --&gt; B[\"构造 D: 输入 ⟨M⟩\"]\n        B --&gt; C{\"H(⟨M⟩, ⟨M⟩) = ?\"}\n        C --&gt;|\"接受(M 停机)\"| D[\"D 进入死循环\"]\n        C --&gt;|\"拒绝(M 不停机)\"| E[\"D 接受\"]\n        D --&gt; F[\"D(⟨D⟩) 不停机\"]\n        E --&gt; G[\"D(⟨D⟩) 停机\"]\n        F --&gt; H[\"矛盾！\"]\n        G --&gt; H\n    end</pre><div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"function haltingProblemDemo(): void {&#10;  const cannotDecideHalting = (machineDescription: string, input: string): &#39;halts&#39; | &#39;loops&#39; =&gt; {&#10;    throw new Error(&#39;This function cannot exist - halting problem is undecidable&#39;);&#10;  };&#10;&#10;  const paradoxMachine = (input: string): void =&gt; {&#10;    try {&#10;      const result = cannotDecideHalting(input, input);&#10;      if (result === &#39;halts&#39;) {&#10;        while (true) {}&#10;      }&#10;    } catch {&#10;      return;&#10;    }&#10;  };&#10;&#10;  void paradoxMachine;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> haltingProblemDemo</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> cannotDecideHalting</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">machineDescription</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">input</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=