const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> covInv</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Matrix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  [</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'马氏距离:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">mahalanobisDistance</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(u, v, covInv));</span></span></code></pre></div><p>马氏距离（Mahalanobis distance）使用协方差矩阵的逆作为权重：d²(u,v) = (u-v)ᵀΣ⁻¹(u-v)。马氏距离消除了各维度的尺度差异和相关性影响，是多元统计中&quot;标准化&quot;距离。高斯判别分析中，类别判定就是比较到各类均值的马氏距离。</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[距离度量] --&gt; B[欧氏距离]&#10;    A --&gt; C[马氏距离]&#10;    A --&gt; D[余弦距离]&#10;    B --&gt; E[&quot;‖u-v‖₂&quot;]&#10;    B --&gt; F[各维等权]&#10;    C --&gt; G[&quot;(u-v)ᵀΣ⁻¹(u-v)&quot;]&#10;    C --&gt; H[考虑相关性]&#10;    D --&gt; I[&quot;1 - cos(θ)&quot;]&#10;    D --&gt; J[方向相似度]\">graph LR\n    A[距离度量] --&gt; B[欧氏距离]\n    A --&gt; C[马氏距离]\n    A --&gt; D[余弦距离]\n    B --&gt; E[\"‖u-v‖₂\"]\n    B --&gt; F[各维等权]\n    C --&gt; G[\"(u-v)ᵀΣ⁻¹(u-v)\"]\n    C --&gt; H[考虑相关性]\n    D --&gt; I[\"1 - cos(θ)\"]\n    D --&gt; J[方向相似度]</pre><h2 id=\"正交基与坐标计算\">正交基与坐标计算</h2><p>在正交基（或正交归一基）下，坐标计算极为简便：向量 v 在正交归一基 {q₁, ..., qₙ} 下的坐标 cᵢ = ⟨v, qᵢ⟩。不需要解方程组，只需计算 n 次内积。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const orthonormalCoordinates = (v: Vector, basis: Matrix): Vector =&gt; basis.map((q) =&gt; innerProduct(v, q));&#10;&#10;const reconstructFromBasis = (coords: Vector, basis: Matrix): Vector =&gt; {&#10;  const n = basis[0].length;&#10;  const result = new Array(n).fill(0);&#10;  for (let i = 0; i &lt; coords.length; i++) {&#10;    for (let j = 0; j &lt; n; j++) {&#10;      result[j] += coords[i] * basis[i][j];&#10;    }&#10;  }&#10;  return result;&#10;};&#10;&#10;const parseval = (v: Vector, orthoBasis: Matrix): boolean =&gt; {&#10;  const normV2 = innerProduct(v, v);&#10;  const sumCoords2 = orthoBasis.reduce((s, q) =&gt; s + innerProduct(v, q) ** 2, 0);&#10;  return Math.abs(normV2 - sumCoords2) &lt; 1e-10;&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> orthonormalCoordinates</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--sh