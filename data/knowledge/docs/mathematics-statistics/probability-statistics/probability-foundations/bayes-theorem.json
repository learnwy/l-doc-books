span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    logOdds </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(word.spam </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> word.ham);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> /</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">exp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">logOdds));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> words</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { spam: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, ham: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { spam: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, ham: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { spam: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, ham: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.5</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">];</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">log</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'垃圾邮件概率:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">spamFilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0.3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, words).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toFixed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span></code></pre></div><p>朴素贝叶斯分类器假设各特征在给定类别下条件独立，将联合似然分解为各特征似然的乘积。尽管独立性假设通常不成立，朴素贝叶斯在文本分类、垃圾邮件过滤等任务中表现出色。</p>\n<h2 id=\"序贯更新与信念演化\">序贯更新与信念演化</h2><p>贝叶斯更新是可迭代的：今天的后验就是明天的先验。当数据逐个到达时，可以序贯地更新信念，无需重新处理所有历史数据。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const sequentialBayesUpdate = (&#10;  prior: number,&#10;  observations: boolean[],&#10;  likelihoodTrue: number,&#10;  likelihoodFalse: number,&#10;): number[] =&gt; {&#10;  const posteriors: number[] = [];&#10;  let currentPrior = prior;&#10;&#10;  for (const obs of observations) {&#10;    const likelihood = obs ? likelihoodTrue : 1 - likelihoodTrue;&#10;    const likelihoodH0 = obs ? likelihoodFalse : 1 - likelihoodFalse;&#10;    const evidence = likelihood * currentPrior + likelihoodH0 * (1 - currentPrior);&#10;    currentPrior = (likelihood * currentPrior) / evidence;&#10;    posteriors.push(currentPrior);&#10;  }&#10;  return posteriors;&#10;};&#10;&#10;const coinBias = sequentialBayesUpdate(0.5, [true, true, false, true, true, true, false, true, true, true], 0.7, 0.5);&#10;console.log(&#10;  &#39;序贯后验:&#39;,&#10;  coinBias.map((p) =&gt; p.toFixed(3)),&#10;);\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sequentialBayesUpdate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  prior</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  observations</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  likelihoodTrue</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki