个事件的相互独立要求任意子集的交的概率等于各自概率的乘积。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"const areIndependent = (pA: number, pB: number, pAB: number, tol: number = 1e-6): boolean =&gt;&#10;  Math.abs(pAB - pA * pB) &lt; tol;&#10;&#10;const testIndependenceFromData = (&#10;  data: boolean[][],&#10;  col1: number,&#10;  col2: number,&#10;): { independent: boolean; pA: number; pB: number; pAB: number; expected: number } =&gt; {&#10;  const n = data.length;&#10;  let countA = 0,&#10;    countB = 0,&#10;    countAB = 0;&#10;  for (const row of data) {&#10;    if (row[col1]) countA++;&#10;    if (row[col2]) countB++;&#10;    if (row[col1] &amp;&amp; row[col2]) countAB++;&#10;  }&#10;  const pA = countA / n;&#10;  const pB = countB / n;&#10;  const pAB = countAB / n;&#10;  const expected = pA * pB;&#10;  return {&#10;    independent: Math.abs(pAB - expected) &lt; 3 * Math.sqrt((expected * (1 - expected)) / n),&#10;    pA,&#10;    pB,&#10;    pAB,&#10;    expected,&#10;  };&#10;};\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> areIndependent</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pB</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">pAB</s