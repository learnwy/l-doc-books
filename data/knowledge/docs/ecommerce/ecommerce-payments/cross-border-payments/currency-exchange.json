209;--shiki-dark:#FFAB70\">      expiryDate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    naturalHedge</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      localProcurement</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      localExpenses</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      netExposure</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  monitoring</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    markToMarket</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    rebalanceThreshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    reportingFrequency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'daily'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'weekly'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>对冲工具</th>\n<th>成本</th>\n<th>灵活性</th>\n<th>覆盖度</th>\n<th>适用规模</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>远期合约</td>\n<td>低（无前期成本）</td>\n<td>低（必须执行）</td>\n<td>完全锁定</td>\n<td>中大型</td>\n</tr>\n<tr>\n<td>外汇期权</td>\n<td>中（权利金）</td>\n<td>高（可放弃）</td>\n<td>单向保护</td>\n<td>大型</td>\n</tr>\n<tr>\n<td>领口策略</td>\n<td>低</td>\n<td>中</td>\n<td>区间锁定</td>\n<td>中大型</td>\n</tr>\n<tr>\n<td>自然对冲</td>\n<td>无</td>\n<td>高</td>\n<td>部分覆盖</td>\n<td>所有规模</td>\n</tr>\n</tbody></table>\n<p>自然对冲（Natural Hedging）通过在目标市场产生本币收入和支出来抵消汇率风险。例如，在欧洲市场设立本地仓库和运营团队，用欧元收入支付欧元成本，减少需要兑换的净头寸。</p>\n<h2 id=\"汇率-api-与技术集成\">汇率 API 与技术集成</h2><p>汇率数据的获取和管理是多币种系统的技术基础。生产环境通常对接多个汇率数据源实现冗余，并在本地缓存汇率数据以应对外部 API 故障。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface ExchangeRateService {&#10;  providers: {&#10;    primary: { name: string; apiUrl: string; apiKey: string };&#10;    fallback: { name: string; apiUrl: string; apiKey: string };&#10;  };&#10;  cache: {&#10;    ttlSeconds: number;&#10;    storage: &#39;redis&#39; | &#39;memory&#39;;&#10;    staleWhileRevalidate: boolean;&#10;  };&#10;  rateTypes: {&#10;    mid: number;&#10;    bid: number;&#10;    ask: number;&#10;    spread: number;&#10;  };&#10;  monitoring: {&#10;    maxSpreadThreshold: number;&#10;    rateDeviationAlert: number;&#10;    providerHealthCheck: boolean;&#10;  };&#10;}&#10;&#10;interface RateConversionResult {&#10;  fromCurrency: string;&#10;  toCurrency: string;&#10;  fromAmount: number;&#10;  toAmount: number;&#10;  rate: number;&#10;  rateType: &#39;mid&#39; | &#39;bid&#39; | &#39;ask&#39;;&#10;  markup: number;&#10;  effectiveRate: number;&#10;  provider: string;&#10;  timestamp: number;&#10;  validUntil: number;&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ExchangeRateService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  providers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    primary</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">apiUrl</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shi