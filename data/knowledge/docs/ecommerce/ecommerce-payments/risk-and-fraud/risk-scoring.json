i-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>软拒绝（Soft Decline）是平衡体验和风控的重要策略。当评分处于灰色地带时，不直接拒绝交易，而是要求额外验证（如触发 3DS 挑战、发送 OTP、要求上传证件照）。通过验证的交易正常处理，验证失败则拒绝。软拒绝可以将误拒率降低 30-50%。</p>\n<h2 id=\"动态阈值与自适应策略\">动态阈值与自适应策略</h2><p>固定阈值无法应对欺诈模式的变化和业务的季节性波动。动态阈值根据实时数据自动调整决策边界——当检测到欺诈攻击激增时自动收紧阈值，攻击消退后逐步放松。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DynamicThresholdConfig {&#10;  baselineWindow: &#39;7d&#39; | &#39;30d&#39;;&#10;  adjustmentFactors: {&#10;    fraudRateSpike: {&#10;      threshold: number;&#10;      tightenBy: number;&#10;      cooldownMinutes: number;&#10;    };&#10;    declineRateSpike: {&#10;      threshold: number;&#10;      loosenBy: number;&#10;      maxLoosen: number;&#10;    };&#10;    seasonalAdjustment: {&#10;      blackFriday: { modifier: number };&#10;      christmas: { modifier: number };&#10;      doubleEleven: { modifier: number };&#10;    };&#10;  };&#10;  monitoring: {&#10;    alertOnThresholdChange: boolean;&#10;    maxAutoAdjustment: number;&#10;    requireApprovalBeyond: number;&#10;  };&#10;}&#10;&#10;interface ThresholdAuditLog {&#10;  timestamp: number;&#10;  previousThreshold: number;&#10;  newThreshold: number;&#10;  reason: string;&#10;  triggeredBy: &#39;auto&#39; | &#39;manual&#39;;&#10;  approvedBy?: string;&#10;  metrics: {&#10;    currentFraudRate: number;&#10;    currentDeclineRate: number;&#10;    currentApprovalRate: number;&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DynamicThresholdConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  baselineWindow</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '7d'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '30d'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  adjustmentFactors</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    fraudRateSpike</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      threshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      tightenBy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      cooldownMinutes</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    declineRateSpike</span><span style=\"color:#D73A49;--shiki-dark:#F9