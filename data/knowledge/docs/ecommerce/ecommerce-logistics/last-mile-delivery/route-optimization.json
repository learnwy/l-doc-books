9;--shiki-dark:#FFAB70\">    totalDistance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    totalTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    utilizationRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>算法</th>\n<th>解质量</th>\n<th>计算时间</th>\n<th>适用规模</th>\n<th>实现复杂度</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>最近邻</td>\n<td>60-70% 最优</td>\n<td>&lt;1秒</td>\n<td>不限</td>\n<td>低</td>\n</tr>\n<tr>\n<td>2-opt</td>\n<td>85-90% 最优</td>\n<td>1-5秒</td>\n<td>&lt;200点</td>\n<td>低</td>\n</tr>\n<tr>\n<td>遗传算法</td>\n<td>90-95% 最优</td>\n<td>10-60秒</td>\n<td>&lt;500点</td>\n<td>中</td>\n</tr>\n<tr>\n<td>ALNS</td>\n<td>95-99% 最优</td>\n<td>10-120秒</td>\n<td>&lt;1000点</td>\n<td>高</td>\n</tr>\n<tr>\n<td>OR-Tools</td>\n<td>95-99% 最优</td>\n<td>5-60秒</td>\n<td>&lt;5000点</td>\n<td>中</td>\n</tr>\n</tbody></table>\n<h2 id=\"实时动态调度\">实时动态调度</h2><p>静态路线规划在执行过程中会遇到各种突发情况：新订单插入、交通拥堵、配送员异常、用户改地址。动态调度系统需要在不打断现有路线的前提下，实时调整后续配送计划。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DynamicDispatchEngine {&#10;  triggers: {&#10;    newOrder: { insertionStrategy: &#39;cheapest_insertion&#39; | &#39;regret_insertion&#39; };&#10;    trafficUpdate: { rerouteThreshold: number };&#10;    driverException: { reassignmentStrategy: &#39;nearest_available&#39; | &#39;least_disruption&#39; };&#10;    customerReschedule: { allowedWindow: number };&#10;  };&#10;  reoptimization: {&#10;    frequency: &#39;event_driven&#39; | &#39;periodic&#39;;&#10;    periodicInterval: number;&#10;    scope: &#39;single_route&#39; | &#39;all_routes&#39; | &#39;affected_routes&#39;;&#10;    maxComputeTime: number;&#10;  };&#10;  communication: {&#10;    driverNotification: &#39;real_time&#39; | &#39;batch&#39;;&#10;    customerETA: {&#10;      updateFrequency: number;&#10;      confidenceDisplay: boolean;&#10;    };&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DynamicDispatchEngine</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  triggers</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    newOrder</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">insertionStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'cheapest_insertion'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'regret_insertion'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    trafficUpdate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rerouteThreshold</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    driverException</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">reassignmentStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'nearest_available'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'least_disruption'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    customerReschedule</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">allowedWindow</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  reoptimization</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    frequency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'event_driven'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'periodic'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    periodicInterval</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    scope</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'single_route'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'all_routes'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'affected_routes'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    maxComputeTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  communication</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    driverNotification</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'real_time'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'batch'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    customerETA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      updateFrequency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      confidenceDisplay</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>实时 ETA（Estimated Time of Arrival）预测是动态调度的核心输出。ETA 不仅需要考虑道路距离，还要融合实时交通数据、历史配送时间（包含上楼时间、等电梯时间）和当前配送员的任务进度。机器学习模型（如 DeepETA）通过学习历史配送数据中的模式，可以将 ETA 预测的误差控制在 3-5 分钟以内。</p>\n<table>\n<thead>\n<tr>\n<th>动态场景</th>\n<th>响应策略</th>\n<th>影响范围</th>\n<th>响应时间</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>新订单插入</td>\n<td>最小成本插入</td>\n<td>单路线</td>\n<td>&lt;5秒</td>\n</tr>\n<tr>\n<td>交通拥堵</td>\n<td>实时改路</td>\n<td>单路线</td>\n<td>&lt;10秒</td>\n</tr>\n<tr>\n<td>配送员下线</td>\n<td>订单转移</td>\n<td>多路线</td>\n<td>&lt;30秒</td>\n</tr>\n<tr>\n<td>用户改地址</td>\n<td>路线重排</td>\n<td>单路线</td>\n<td>&lt;10秒</td>\n</tr>\n</tbody></table>\n<h2 id=\"交通数据与地图服务\">交通数据与地图服务</h2><p>路径优化的准确性依赖高质量的道路网络数据和实时交通信息。主要的地图服务商（高德、百度、Google Maps）提供路径规划 API，支持实时交通、限行规则和多交通方式。</p>\n<p>对于大规模配送场景，逐一调用地图 API 计算两两距离的成本过高（N 个点需要 N² 次调用）。常见的优化策略是：预计算距离矩阵（离线计算常用配送点之间的距离并缓存）、使用 OSRM（Open Source Routing Machine）自建路径引擎、批量请求 API（矩阵 API 一次返回多对距离）。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface MapServiceConfig {&#10;  provider: &#39;amap&#39; | &#39;baidu&#39; | &#39;google&#39; | &#39;osrm_self_hosted&#39;;&#10;  distanceMatrix: {&#10;    precomputed: boolean;&#10;    cacheStrategy: &#39;redis&#39; | &#39;file&#39; | &#39;database&#39;;&#10;    cacheTTL: number;&#10;    maxBatchSize: number;&#10;  };&#10;  trafficData: {&#10;    realTimeEnabled: boolean;&#10;    historicalPatterns: boolean;&#10;    predictionModel: boolean;&#10;    updateInterval: number;&#10;  };&#10;  restrictions: {&#10;    truckRouting: boolean;&#10;    heightLimit: number;&#10;    weightLimit: number;&#10;    timeBasedRestrictions: boolean;&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> MapServiceConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  provider</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'amap'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'baidu'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'google'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'osrm_self_hosted'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  distanceMatrix</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    precomputed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    cacheStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'redis'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'file'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'database'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    cacheTTL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    maxBatchSize</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  trafficData</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    realTimeEnabled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    historicalPatterns</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    predictionModel</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    updateInterval</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  restrictions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    truckRouting</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    heightLimit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    weightLimit</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    timeBasedRestrictions</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>地图服务</th>\n<th>优势</th>\n<th>费用</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>高德 API</td>\n<td>国内精度高</td>\n<td>按调用量</td>\n<td>国内配送</td>\n</tr>\n<tr>\n<td>OSRM 自建</td>\n<td>无调用限制</td>\n<td>服务器成本</td>\n<td>大规模场景</td>\n</tr>\n<tr>\n<td>Google Maps</td>\n<td>全球覆盖</td>\n<td>按调用量</td>\n<td>跨境配送</td>\n</tr>\n<tr>\n<td>Valhalla</td>\n<td>开源+自建</td>\n<td>服务器成本</td>\n<td>定制需求</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>配送路径优化本质是 VRP 问题，通过聚类分区 → 路线规划 → 动态调度三步解决</li>\n<li>分区应使用道路网络距离而非欧氏距离，动态分区解决订单量波动问题</li>\n<li>ALNS 和 OR-Tools 在解质量和计算速度之间取得最佳平衡，适合百到千级配送点</li>\n<li>动态调度处理新订单插入、交通变化等突发事件，ETA 预测误差需控制在 3-5 分钟</li>\n<li>大规模场景建议自建路径引擎（OSRM），避免地图 API 调用成本过高</li>\n</ul>\n","headings":[{"level":1,"text":"配送路径优化","id":"配送路径优化"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"聚类与分区","id":"聚类与分区"},{"level":2,"text":"路线规划算法","id":"路线规划算法"},{"level":2,"text":"实时动态调度","id":"实时动态调度"},{"level":2,"text":"交通数据与地图服务","id":"交通数据与地图服务"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"末端配送模式","url":"/l-doc-books/h/ecommerce/ecommerce-logistics/last-mile-delivery/delivery-models"},"next":{"title":"配送体验设计","url":"/l-doc-books/h/ecommerce/ecommerce-logistics/last-mile-delivery/delivery-experience"}}