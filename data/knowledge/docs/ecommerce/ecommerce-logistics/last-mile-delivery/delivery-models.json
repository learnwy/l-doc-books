ead>\n<tbody><tr>\n<td>菜鸟驿站</td>\n<td>高</td>\n<td>无（人工存放）</td>\n<td>中</td>\n<td>中（需排队）</td>\n</tr>\n<tr>\n<td>丰巢柜</td>\n<td>中</td>\n<td>有（格口限制）</td>\n<td>低（无人值守）</td>\n<td>高（24小时）</td>\n</tr>\n<tr>\n<td>便利店代收</td>\n<td>高</td>\n<td>有限</td>\n<td>最低（共享空间）</td>\n<td>中</td>\n</tr>\n<tr>\n<td>门店自提</td>\n<td>低</td>\n<td>大</td>\n<td>无（共享门店）</td>\n<td>高（可试穿）</td>\n</tr>\n</tbody></table>\n<h2 id=\"即时配送\">即时配送</h2><p>即时配送（Instant Delivery）承诺 30-60 分钟内送达，服务于外卖、生鲜、药品和闪送场景。即时配送的核心技术挑战是在极短的时间窗口内完成订单分配、路径规划和实时调度。</p>\n<p>美团配送和饿了么蜂鸟是国内即时配送的两大平台。其调度系统需要实时处理百万级并发订单，将订单分配给最合适的骑手——考虑骑手位置、当前任务量、商家出餐时间和配送距离。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface InstantDeliveryConfig {&#10;  promiseTime: number;&#10;  coverage: {&#10;    radiusKm: number;&#10;    operatingHours: { start: string; end: string };&#10;  };&#10;  dispatch: {&#10;    algorithm: &#39;nearest&#39; | &#39;eta_optimized&#39; | &#39;ml_prediction&#39;;&#10;    maxConcurrentOrders: number;&#10;    batchingWindow: number;&#10;    rebalancingEnabled: boolean;&#10;  };&#10;  pricing: {&#10;    baseFee: number;&#10;    distanceFee: number;&#10;    surgePricing: {&#10;      enabled: boolean;&#10;      triggers: (&#39;high_demand&#39; | &#39;low_supply&#39; | &#39;bad_weather&#39;)[];&#10;      maxMultiplier: number;&#10;    };&#10;    tipEnabled: boolean;&#10;  };&#10;  fulfillmentSources: (&#39;dark_store&#39; | &#39;retail_store&#39; | &#39;restaurant&#39; | &#39;warehouse&#39;)[];&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> InstantDeliveryConfig</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  promiseTime</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  coverage</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    radiusKm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    operatingHours</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">start</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">end</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  dispatch</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    algorithm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'nearest'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span sty