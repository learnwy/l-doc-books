-dark:#FFAB70\">    predictiveMaintenance</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    averageMTBF</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    chargingStrategy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'opportunity'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'scheduled'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'swap_battery'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>机器人类型</th>\n<th>导航方式</th>\n<th>负载能力</th>\n<th>适用作业</th>\n<th>单台成本</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>搬运AGV</td>\n<td>二维码/磁条</td>\n<td>500-1500kg</td>\n<td>整托/整架搬运</td>\n<td>$3-8万</td>\n</tr>\n<tr>\n<td>拣选AMR</td>\n<td>SLAM</td>\n<td>30-100kg</td>\n<td>货到人拣选</td>\n<td>$5-15万</td>\n</tr>\n<tr>\n<td>分拣机器人</td>\n<td>二维码</td>\n<td>5-30kg</td>\n<td>包裹分拣</td>\n<td>$2-5万</td>\n</tr>\n<tr>\n<td>协作机器人</td>\n<td>跟随/SLAM</td>\n<td>20-50kg</td>\n<td>辅助拣选</td>\n<td>$3-10万</td>\n</tr>\n</tbody></table>\n<h2 id=\"自动分拣系统\">自动分拣系统</h2><p>自动分拣系统将包裹从主输送线精确导入对应的目的格口，是出库和配送中心的核心设备。常见的分拣技术包括交叉带分拣机（Cross-Belt Sorter）、滑块分拣机（Sliding Shoe）、翻板分拣机（Tilt-Tray）和摆臂分拣机。</p>\n<div class=\"code-block-wrapper