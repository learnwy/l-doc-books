</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    autoEscalateToOps</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    customerProactiveNotification</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>SLA 指标</th>\n<th>目标</th>\n<th>红线</th>\n<th>违约影响</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>准时送达率</td>\n<td>&gt;98%</td>\n<td>&lt;95%</td>\n<td>用户流失</td>\n</tr>\n<tr>\n<td>承诺准确率</td>\n<td>&gt;95%</td>\n<td>&lt;90%</td>\n<td>信任下降</td>\n</tr>\n<tr>\n<td>平均配送天数</td>\n<td>&lt;2天</td>\n<td>&gt;3天</td>\n<td>竞争力下降</td>\n</tr>\n<tr>\n<td>异常处理时效</td>\n<td>&lt;4小时</td>\n<td>&gt;24小时</td>\n<td>投诉升级</td>\n</tr>\n</tbody></table>\n<h2 id=\"小结\">小结</h2><ul>\n<li>订单履约是将在线订单转化为实体交付的全链路过程，时效承诺直接影响转化率和用户满意度</li>\n<li>智能订单路由综合考虑库存、时效、成本和产能，多目标优化是大型平台的标配</li>\n<li>拆单vs调拨的决策取决于总成本和时效的综合评估，合单在短时间内可节省运费</li>\n<li>明确的履约承诺（&quot;X日前送达&quot;）比模糊表述转化率高 15-20%</li>\n<li>SLA 监控需要实时跟踪准时率和异常订单，主动通知消费者配送延迟是维护信任的关键</li>\n</ul>\n","headings":[{"level":1,"text":"订单履约","id":"订单履约"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"订单路由与仓库选择","id":"订单路由与仓库选择"},{"level":2,"text":"拆单与合单","id":"拆单与合单"},{"level":2,"text":"履约承诺与 SLA","id":"履约承诺与-sla"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"库存优化","url":"/l-doc-books/h/ecommerce/ecommerce-logistics/warehouse-and-fulfillment/inventory-optimization"},"next":{"title":"仓储自动化","url":"/l-doc-books/h/ecommerce/ecommerce-logistics/warehouse-and-fulfillment/fulfillment-automation"}}