n>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    perItemVariable</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    transferCost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    packagingCost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    customerImpactCost</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>场景</th>\n<th>决策</th>\n<th>原因</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>全部SKU同仓</td>\n<td>不拆单</td>\n<td>最低成本</td>\n</tr>\n<tr>\n<td>部分SKU异仓，调拨&lt;2天</td>\n<td>调拨后不拆单</td>\n<td>用户体验优先</td>\n</tr>\n<tr>\n<td>部分SKU异仓，调拨&gt;2天</td>\n<td>拆单发货</td>\n<td>时效优先</td>\n</tr>\n<tr>\n<td>同用户30分钟内多单</td>\n<td>合单</td>\n<td>节省运费</td>\n</tr>\n<tr>\n<td>不同时效要求的商品</td>\n<td>分开发货</td>\n<td>满足时效承诺</td>\n</tr>\n</tbody></table>\n<h2 id=\"履约承诺与-sla\">履约承诺与 SLA</h2><p>履约承诺（Promise）是电商平台向消费者展示的预计送达时间，直接影响购买决策和用户期望。&quot;X月X日前送达&quot;的明确承诺比&quot;预计2-3天&quot;的模糊表述转化率高 15-20%。</p>\n<p>履约承诺的计算需要实时串联多个环节的时间：订单处理时间（仓库产能决定）+ 拣配包装时间（作业效率决定）+ 承运商揽收截止时间（carrier cutoff）+ 运输时效（距离+承运商能力）。任何环节的延误都会导致履约承诺无法兑现。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface DeliveryPromise {&#10;  orderId: string;&#10;  promiseDate: string;&#10;  promiseWindow: { earliest: string; latest: string };&#10;  breakdown: {&#10;    processingTime: number;&#10;    warehouseCutoff: string;&#10;    transitTime: number;&#10;    carrierCutoff: string;&#10;    lastMileTime: number;&#10;  };&#10;  confidence: number;&#10;  fulfillmentWarehouse: string;&#10;  carrier: string;&#10;  serviceLevel: &#39;standard&#39; | &#39;express&#39; | &#39;same_day&#39;;&#10;}&#10;&#10;interface SLAMonitoring {&#10;  targets: {&#10;    onTimeDeliveryRate: number;&#10;    promiseAccuracy: number;&#10;    averageDeliveryDays: number;&#10;    slaBreachThreshold: number;&#10;  };&#10;  realTimeMetrics: {&#10;    currentOnTimeRate: number;&#10;    atRiskOrders: number;&#10;    slaBreaches: number;&#10;    averagePromiseAccuracy: number;&#10;  };&#10;  escalation: {&#10;    warningThreshold: number;&#10;    criticalThreshold: number;&#10;    autoEscalateToOps: boolean;&#10;    customerProactiveNotification: boolean;&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">interface</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DeliveryPromise</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  orderId</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  promiseDate</span><span style=\"color:#D73A49;--sh