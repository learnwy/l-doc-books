tyle=\"color:#E36209;--shiki-dark:#FFAB70\">    computerVision</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      enabled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      models</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'scratch_detection'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'stain_detection'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'completeness_check'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      accuracy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    functionalTest</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      enabled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      testSuite</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[];</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      passRate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  grading</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    algorithm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'rule_based'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'weighted_score'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ml_classification'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    thresholds</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      gradeA</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      gradeB</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      gradeC</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    overridePolicy</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      manualOverride</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">      approvalRequired</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><table>\n<thead>\n<tr>\n<th>质检方式</th>\n<th>效率(件/小时)</th>\n<th>准确率</th>\n<th>成本/件</th>\n<th>适用品类</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>纯人工</td>\n<td>20-40</td>\n<td>90-95%</td>\n<td>¥3-8</td>\n<td>复杂品类</td>\n</tr>\n<tr>\n<td>人机协同</td>\n<td>40-80</td>\n<td>95-98%</td>\n<td>¥2-5</td>\n<td>通用品类</td>\n</tr>\n<tr>\n<td>全自动</td>\n<td>100-200</td>\n<td>92-96%</td>\n<td>¥1-3</td>\n<td>标准化品类</td>\n</tr>\n</tbody></table>\n<h2 id=\"翻新与再销售\">翻新与再销售</h2><p>翻新（Refurbishment）是将退回的 B 级商品恢复到可销售状态的过程。翻新程度从简单的重新包装到深度的功能修复不等。电子产品的翻新市场尤为成熟——Amazon Renewed、Apple Certified Refurbished 都是成功的翻新再销售平台。</p>\n<p>翻新流程包括：清洁（去除使用痕迹和灰尘）、修复（更换损坏的部件）、测试（功能验证）、重新包装（使用新包装或翻新标识包装）、质量认证（提供翻新保修）。翻新商品通常以原价的 60-80% 出售，毛利率仍然可观。</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"interface RefurbishmentProcess {&#10;  eligibility: {&#10;    categories: string[];&#10;    minOriginalPrice: number;&#10;    maxAge: number;&#10;    conditionRequirement: &#39;B&#39; | &#39;B_or_C&#39;;&#10;  };&#10;  workflow: {&#10;    cleaning: { method: string; duration: number; cost: number };&#10;    repair: { commonIssues: string[]; partsCost: number; laborCost: number };&#10;    testing: { testSuite: string[]; passRate: number };&#10;    repackaging: { useOriginal: boolean; brandedRefurb: boolean; cost: number };&#10;    certification: { warrantyDays: number; gradeLabel: string };&#10;  };&#10;  pricing: {&#10;    discountFromOriginal: number;&#10;    dynamicPricing: boolean;&#10;    competitorBenchmark: boolean;&#10;  };&#10;  channels: {&#10;    primary: &#39;same_platform&#39; | &#39;outlet_store&#39; | &#39;marketplace&#39;;&#10;    secondary: &#39;bulk_buyer&#39; | &#39;employee_sale&#39;;&#10;    listing: {&#10;      separateFromNew: boolean;&#10;      refurbLabel: boolean;&#10;      warrantyDisplay: boolean;&#10;    };&#10;  };&#10;  economics: {&#10;    averageRefurbCost: number;&#10;    averageSellingPrice: number;&#10;    averageMargin: number;&#10;    volumePerMonth: number;&#10;    totalRecoveryRate: number;&#10;  };&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" ta