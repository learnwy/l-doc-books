ki-dark:#E1E4E8\">}</span></span></code></pre></div><p><strong>应用层过滤（本地缓存快速拦截）</strong>：</p>\n<p>在内存中维护「库存已售罄」标记。一旦 Redis 返回库存不足，设置本地标记（sync.Map 或 atomic bool），后续请求在到达 Redis 之前就被拦截：</p>\n<div class=\"code-block-wrapper\" data-lang=\"go\" data-code=\"var stockEmptyFlags sync.Map  // key: productID:roomID, value: bool&#10;&#10;func checkLocalStock(productID, roomID string) bool {&#10;    key := productID + &quot;:&quot; + roomID&#10;    if _, empty := stockEmptyFlags.Load(key); empty {&#10;        return false  // 本地标记库存为空，直接拒绝&#10;    }&#10;    return true&#10;}&#10;&#10;func markStockEmpty(productID, roomID string) {&#10;    key := productID + &quot;:&quot; + roomID&#10;    stockEmptyFlags.Store(key, true)&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">var</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stockEmptyFlags </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sync</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Map</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // key: productID:roomID, value: bool</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> checkLocalStock</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">productID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">roomID</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    key </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> productID </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \":\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> roomID</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> _, empty </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stockEmptyFlags.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Load</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(key); empty {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">  // 本地标记库存为空，直接拒绝</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> true</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> markStockEmpty</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">productID</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">roomID</span><span style=\"color:#D73A49;--shiki-dark:#