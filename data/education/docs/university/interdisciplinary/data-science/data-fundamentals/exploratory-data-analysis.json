ize3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">i</span><span class=\"mrel mtight\">=</span><span class=\"mord mtight\">1</span></span></span></span><span style=\"top:-3.2029em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">n</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2997em;\"><span></span></span></span></span></span></span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\">x</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.5678em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\">x</span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.2222em;\"><span class=\"mord\">ˉ</span></span></span></span></span></span></span><span class=\"mclose\">)</span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">y</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0359em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord accent\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.5678em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">y</span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.1944em;\"><span class=\"mord\">ˉ</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1944em;\"><span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.13em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span></div><p>取值范围 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">[</mo><mo>−</mo><mn>1</mn><mo separator=\"true\">,</mo><mn>1</mn><mo stretchy=\"false\">]</mo></mrow><annotation encoding=\"application/x-tex\">[-1, 1]</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord\">−</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose\">]</span></span></span></span></span>，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">r = 1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1</span></span></span></span></span> 表示完全正线性相关，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>r</mi><mo>=</mo><mo>−</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">r = -1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">−</span><span class=\"mord\">1</span></span></span></span></span> 表示完全负线性相关，<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">r = 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0278em;\">r</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span> 表示没有线性关系（但可能存在非线性关系）。</p>\n<p><strong>Spearman 秩相关系数</strong>衡量单调关系，对非线性但单调的关系更敏感。它的计算方式是对数据排秩后计算 Pearson 相关系数。当数据存在异常值或不满足正态假设时，Spearman 是更稳健的选择。</p>\n<p>在 pandas 中，<code>df.corr(method=&#39;pearson&#39;)</code> 和 <code>df.corr(method=&#39;spearman&#39;)</code> 分别计算两种相关矩阵。配合 <code>sns.heatmap()</code> 可以生成直观的相关性热力图。</p>\n<p>需要特别注意的是：<strong>相关不等于因果</strong>。即使两个变量高度相关，也不能直接得出因果结论。经典的伪相关案例包括冰淇淋销量与溺水事故数正相关——两者都与气温这个混杂变量有关。</p>\n<h3 id=\"分布检验\">分布检验</h3><p>在应用某些统计方法之前，需要验证数据是否满足分布假设。</p>\n<p><strong>Shapiro-Wilk 检验</strong>是最常用的正态性检验方法，零假设为&quot;数据服从正态分布&quot;。在 Python 中：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"from scipy.stats import shapiro&#10;stat, p_value = shapiro(data)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> scipy.stats </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> shapiro</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">stat, p_value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> shapiro(data)</span></span></code></pre></div><p>当 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0.05</mn></mrow><annotation encoding=\"application/x-tex\">p &lt; 0.05</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7335em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.05</span></span></span></span></span> 时拒绝零假设，认为数据不服从正态分布。</p>\n<p><strong>Kolmogorov-Smirnov 检验</strong>（KS 检验）可以检验数据是否服从任意指定的分布。<strong>Anderson-Darling 检验</strong>对分布尾部更敏感。</p>\n<p>Q-Q 图（Quantile-Quantile Plot）是可视化正态性的有效工具：将数据的分位数与理论正态分布的分位数对比，如果数据近似正态，点会落在对角线附近。</p>\n<h3 id=\"分组对比分析\">分组对比分析</h3><p>将数据按类别变量分组后对比，可以发现不同群体之间的差异。例如：按性别分组对比薪资分布，按地区分组对比销售额。</p>\n<p><code>pandas</code> 的 <code>groupby()</code> 是核心工具：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"df.groupby(&#39;category&#39;)[&#39;value&#39;].agg([&#39;mean&#39;, &#39;median&#39;, &#39;std&#39;, &#39;count&#39;])\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df.groupby(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'category'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'value'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].agg([</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'mean'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'median'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'std'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'count'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span></code></pre></div><p>可视化方面，<code>sns.boxplot(x=&#39;category&#39;, y=&#39;value&#39;)</code> 可以直观比较各组的分布。<code>sns.violinplot()</code> 在箱线图基础上增加了密度信息。</p>\n<p>当需要判断组间差异是否具有统计显著性时，可以使用 t 检验（两组比较）或 ANOVA（多组比较）。</p>\n<h3 id=\"自动化-eda-工具\">自动化 EDA 工具</h3><p>手动编写大量绘图和统计代码效率较低。自动化 EDA 工具可以一键生成全面的分析报告：</p>\n<ul>\n<li><strong>pandas-profiling</strong>（现更名为 ydata-profiling）：生成包含变量类型、缺失值、分布、相关性的 HTML 报告。一行代码 <code>ProfileReport(df)</code> 即可</li>\n<li><strong>sweetviz</strong>：擅长对比分析（如训练集 vs 测试集），自动高亮差异</li>\n<li><strong>dtale</strong>：提供基于 Web 的交互式数据探索界面</li>\n</ul>\n<p>这些工具适合项目早期的快速概览，但深度分析仍需手动完成。</p>\n<h2 id=\"练习与思考\">练习与思考</h2><ol>\n<li>加载 Iris 数据集，计算每个数值特征的均值、中位数、标准差、偏度和峰度。哪些特征最接近正态分布？</li>\n<li>使用 <code>seaborn.pairplot()</code> 绘制 Iris 数据集的散点图矩阵，按物种着色。从图中你能发现哪些特征对分类最有区分度？</li>\n<li>分别计算 Pearson 和 Spearman 相关系数矩阵。两者差异最大的变量对是哪一对？这说明了什么？</li>\n<li>对某个特征进行 Shapiro-Wilk 正态性检验，并绘制 Q-Q 图验证结果。如果不满足正态性，哪些统计方法应该谨慎使用？</li>\n<li>尝试使用 ydata-profiling 对一个 Kaggle 数据集生成自动化报告。报告中的哪些发现是你手动分析时可能忽略的？</li>\n</ol>\n<h2 id=\"拓展阅读\">拓展阅读</h2><ul>\n<li><strong>《Exploratory Data Analysis》</strong>（John Tukey, 1977）：EDA 的开山之作，虽然没有代码示例，但统计思想至今受用</li>\n<li><strong>Seaborn 官方教程</strong>：<a href=\"https://seaborn.pydata.org/tutorial.html\">https://seaborn.pydata.org/tutorial.html</a> ——每种图表都有详细的使用指南和最佳实践</li>\n<li><strong>ydata-profiling 文档</strong>：<a href=\"https://docs.profiling.ydata.ai\">https://docs.profiling.ydata.ai</a> ——自动化 EDA 工具的完整参考</li>\n<li><strong>《Storytelling with Data》</strong>（Cole Nussbaumer Knaflic）：不仅讲可视化技术，更讲如何用数据图表讲故事</li>\n<li><strong>Kaggle Notebooks</strong>：搜索&quot;EDA&quot;可以找到数千个真实项目的探索性分析案例，这是最好的实践学习资源</li>\n</ul>\n<h2 id=\"小结\">小结</h2><p>探索性数据分析是数据科学工作流的核心环节。描述统计用数字概括数据，可视化用图形揭示模式，相关性分析量化变量关系，分布检验验证统计假设，分组分析发现群体差异。EDA 不是走流程，而是真正理解数据的过程——你需要带着好奇心反复探索、不断提问。自动化工具可以提升效率，但真正的洞察力来自于对业务背景的理解和对统计原理的掌握。完成 EDA 后，你将带着对数据的深刻认知进入建模阶段。</p>\n","headings":[{"level":1,"text":"数据科学 — 探索性数据分析（EDA）","id":"数据科学-探索性数据分析-eda"},{"level":2,"text":"知识要点","id":"知识要点"},{"level":2,"text":"详细讲解","id":"详细讲解"},{"level":3,"text":"描述统计","id":"描述统计"},{"level":3,"text":"数据可视化","id":"数据可视化"},{"level":3,"text":"相关性分析","id":"相关性分析"},{"level":3,"text":"分布检验","id":"分布检验"},{"level":3,"text":"分组对比分析","id":"分组对比分析"},{"level":3,"text":"自动化 EDA 工具","id":"自动化-eda-工具"},{"level":2,"text":"练习与思考","id":"练习与思考"},{"level":2,"text":"拓展阅读","id":"拓展阅读"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据科学 — 数据清洗与预处理","url":"/l-doc-books/education/university/interdisciplinary/data-science/data-fundamentals/data-cleaning-preprocessing"},"next":{"title":"大学数据科学 — 回归分析","url":"/l-doc-books/education/university/interdisciplinary/data-science/statistical-modeling/regression-analysis"}}