i-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">data-theme</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dark'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] {</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-primary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#818cf8</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">  --color-bg</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">#1e1e2e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"javascript-核心机制\">JavaScript 核心机制</h3><p>闭包、原型链、事件循环是理解 JavaScript 运行行为的三把钥匙：</p>\n<div class=\"code-block-wrapper\" data-lang=\"javascript\" data-code=\"// 闭包 — 函数记住创建时的词法环境&#10;function createCounter(initial) {&#10;  let count = initial;&#10;  return {&#10;    increment: () =&gt; ++count,&#10;    getCount: () =&gt; count,&#10;  };&#10;}&#10;const counter = createCounter(0);&#10;counter.increment(); // 1&#10;&#10;// Promise 与 async/await&#10;async function fetchUserData(userId) {&#10;  try {&#10;    const response = await fetch(`/api/users/${userId}`);&#10;    if (!response.ok) throw new Error(`HTTP ${response.status}`);&#10;    return await response.json();&#10;  } catch (error) {&#10;    console.error(&#39;获取用户数据失败:&#39;, error.message);&#10;    throw error;&#10;  }&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 闭包 — 函数记住创建时的词法环境</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createCounter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">initial</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> count </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> initial;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    increment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">count,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    getCount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> count,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> counter</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> createCounter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">counter.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">increment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 1</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Promise 与 async/await</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetchUserData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">userId</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> response</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`/api/users/${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">userId</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">response.ok) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`HTTP ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">response</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">status</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> response.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">json</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (error) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'获取用户数据失败:'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, error.message);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    throw</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> error;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><p>ES Module 是现代 JavaScript 的模块化标准，Vite 利用浏览器原生 ESM 实现毫秒级热更新。</p>\n<h3 id=\"vue3-组合式-api-与组件化\">Vue3 组合式 API 与组件化</h3><p>Vue3 的组合式 API（Composition API）通过 <code>setup()</code> 函数组织逻辑，替代了 Options API 的分散式代码组织：</p>\n<div class=\"code-block-wrapper\" data-lang=\"vue\" data-code=\"&lt;script setup&gt;&#10;import { ref, computed, onMounted } from &#39;vue&#39;;&#10;&#10;const todos = ref([]);&#10;const newTodo = ref(&#39;&#39;);&#10;&#10;const activeTodos = computed(() =&gt; todos.value.filter((t) =&gt; !t.completed));&#10;&#10;function addTodo() {&#10;  if (!newTodo.value.trim()) return;&#10;  todos.value.push({&#10;    id: Date.now(),&#10;    text: newTodo.value,&#10;    completed: false,&#10;  });&#10;  newTodo.value = &#39;&#39;;&#10;}&#10;&#10;onMounted(async () =&gt; {&#10;  const res = await fetch(&#39;/api/todos&#39;);&#10;  todos.value = await res.json();&#10;});&#10;&lt;/script&gt;&#10;&#10;&lt;template&gt;&#10;  &lt;div class=&quot;todo-app&quot;&gt;&#10;    &lt;input v-model=&quot;newTodo&quot; @keyup.enter=&quot;addTodo&quot; placeholder=&quot;添加任务...&quot; /&gt;&#10;    &lt;ul&gt;&#10;      &lt;li v-for=&quot;todo in activeTodos&quot; :key=&quot;todo.id&quot;&gt;&#10;        {{ todo.text }}&#10;      &lt;/li&gt;&#10;    &lt;/ul&gt;&#10;    &lt;p&gt;剩余 {{ activeTodos.length }} 项&lt;/p&gt;&#10;  &lt;/div&gt;&#10;&lt;/template&gt;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>&#x3C;script setup></span></span>\n<span class=\"line\"><span>import { ref, computed, onMounted } from 'vue';</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>const todos = ref([]);</span></span>\n<span class=\"line\"><span>const newTodo = ref('');</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>const activeTodos = computed(() => todos.value.filter((t) => !t.completed));</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>function addTodo() {</span></span>\n<span class=\"line\"><span>  if (!newTodo.value.trim()) return;</span></span>\n<span class=\"line\"><span>  todos.value.push({</span></span>\n<span class=\"line\"><span>    id: Date.now(),</span></span>\n<span class=\"line\"><span>    text: newTodo.value,</span></span>\n<span class=\"line\"><span>    completed: false,</span></span>\n<span class=\"line\"><span>  });</span></span>\n<span class=\"line\"><span>  newTodo.value = '';</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>onMounted(async () => {</span></span>\n<span class=\"line\"><span>  const res = await fetch('/api/todos');</span></span>\n<span class=\"line\"><span>  todos.value = await res.json();</span></span>\n<span class=\"line\"><span>});</span></span>\n<span class=\"line\"><span>&#x3C;/script></span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>&#x3C;template></span></span>\n<span class=\"line\"><span>  &#x3C;div class=\"todo-app\"></span></span>\n<span class=\"line\"><span>    &#x3C;input v-model=\"newTodo\" @keyup.enter=\"addTodo\" placeholder=\"添加任务...\" /></span></span>\n<span class=\"line\"><span>    &#x3C;ul></span></span>\n<span class=\"line\"><span>      &#x3C;li v-for=\"todo in activeTodos\" :key=\"todo.id\"></span></span>\n<span class=\"line\"><span>        {{ todo.text }}</span></span>\n<span class=\"line\"><span>      &#x3C;/li></span></span>\n<span class=\"line\"><span>    &#x3C;/ul></span></span>\n<span class=\"line\"><span>    &#x3C;p>剩余 {{ activeTodos.length }} 项&#x3C;/p></span></span>\n<span class=\"line\"><span>  &#x3C;/div></span></span>\n<span class=\"line\"><span>&#x3C;/template></span></span></code></pre></div><p>组件通信方式：<code>props</code> 向下传递数据，<code>emit</code> 向上发送事件，<code>provide/inject</code> 跨层级共享状态，Pinia 管理全局状态。</p>\n<h3 id=\"前端工程化\">前端工程化</h3><p>Vite 构建工具生态：</p>\n<pre class=\"mermaid\" data-diagram-type=\"graph\" data-source=\"graph LR&#10;    A[&quot;源代码&quot;] --&gt; B[&quot;Vite Dev Server&quot;]&#10;    B --&gt; C[&quot;浏览器 ESM&quot;]&#10;    A --&gt; D[&quot;Vite Build&quot;]&#10;    D --&gt; E[&quot;Rollup 打包&quot;]&#10;    E --&gt; F[&quot;生产产物&quot;]\">graph LR\n    A[\"源代码\"] --&gt; B[\"Vite Dev Server\"]\n    B --&gt; C[\"浏览器 ESM\"]\n    A --&gt; D[\"Vite Build\"]\n    D --&gt; E[\"Rollup 打包\"]\n    E --&gt; F[\"生产产物\"]</pre><p>ESLint + Prettier 保障代码风格一致，TypeScript 在大型项目中提供类型安全。</p>\n<h2 id=\"前沿动态\">前沿动态</h2><ul>\n<li><strong>Vue 3.5+ Vapor Mode</strong>：无虚拟 DOM 的编译模式，性能提升 2-5 倍，适合高交互场景</li>\n<li><strong>Vite 6.x</strong>：Rust 化的打包引擎（Rolldown）大幅提升构建速度</li>\n<li><strong>AI 组件生成</strong>：v0.dev、Bolt 等工具可从自然语言描述直接生成 Vue/React 组件代码</li>\n<li><strong>Web Components</strong>：跨框架组件标准在设计系统中得到更广泛应用</li>\n</ul>\n<h2 id=\"练习与思考\">练习与思考</h2><ol>\n<li><p>使用 Vue3 + Vite 搭建一个待办事项应用，要求：组件拆分（TodoInput、TodoItem、TodoFilter）、状态用 Pinia 管理、数据持久化到 localStorage。</p>\n</li>\n<li><p>实现一个响应式后台管理布局：左侧固定宽度导航栏、顶部标题栏、右侧内容区自适应。移动端时导航栏收缩为汉堡菜单。</p>\n</li>\n<li><p>对比 <code>ref</code> 和 <code>reactive</code> 的使用场景，编写一个自定义 Hook（composable）<code>usePagination</code>，封装分页请求逻辑并在多个列表页复用。</p>\n</li>\n</ol>\n<h2 id=\"小结\">小结</h2><p>前端开发已从简单的页面编写发展为系统化的工程实践。HTML5 提供语义结构，CSS3 实现灵活布局与视觉表现，JavaScript 承载交互逻辑，Vue3 框架将这一切组织为可维护的组件树。掌握前端开发后，配合后端 API 即可构建完整的 Web 应用——这正是全栈工程师能力链条的前半段。</p>\n","headings":[{"level":1,"text":"前端开发","id":"前端开发"},{"level":2,"text":"知识要点","id":"知识要点"},{"level":3,"text":"HTML5 语义化与结构","id":"html5-语义化与结构"},{"level":3,"text":"CSS3 布局与响应式设计","id":"css3-布局与响应式设计"},{"level":3,"text":"JavaScript 核心机制","id":"javascript-核心机制"},{"level":3,"text":"Vue3 组合式 API 与组件化","id":"vue3-组合式-api-与组件化"},{"level":3,"text":"前端工程化","id":"前端工程化"},{"level":2,"text":"前沿动态","id":"前沿动态"},{"level":2,"text":"练习与思考","id":"练习与思考"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据库应用开发","url":"/l-doc-books/education/vocational/higher-vocational/software-technology/programming-fundamentals/database-application"},"next":{"title":"后端 API 开发","url":"/l-doc-books/education/vocational/higher-vocational/software-technology/web-fullstack/backend-api-development"}}