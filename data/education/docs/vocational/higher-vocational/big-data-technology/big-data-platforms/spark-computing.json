 style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h3 id=\"结构化流处理\">结构化流处理</h3><p>Structured Streaming 将流数据视为无限增长的 DataFrame，复用批处理 API：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"# 从 Kafka 读取实时数据&#10;stream_df = (&#10;    spark.readStream&#10;         .format(&quot;kafka&quot;)&#10;         .option(&quot;kafka.bootstrap.servers&quot;, &quot;kafka:9092&quot;)&#10;         .option(&quot;subscribe&quot;, &quot;user_events&quot;)&#10;         .load()&#10;)&#10;&#10;# 解析 JSON 并计算实时指标&#10;from pyspark.sql.types import StructType, StringType, TimestampType&#10;&#10;schema = StructType() \\&#10;    .add(&quot;user_id&quot;, StringType()) \\&#10;    .add(&quot;event&quot;, StringType()) \\&#10;    .add(&quot;timestamp&quot;, TimestampType())&#10;&#10;parsed = stream_df.select(&#10;    F.from_json(F.col(&quot;value&quot;).cast(&quot;string&quot;), schema).alias(&quot;data&quot;)&#10;).select(&quot;data.*&quot;)&#10;&#10;# 5 分钟滑动窗口统计&#10;windowed = (&#10;    parsed.groupBy(&#10;        F.window(&quot;timestamp&quot;, &quot;5 minutes&quot;, &quot;1 minute&quot;),&#10;        &quot;event&quot;&#10;    ).count()&#10;)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 从 Kafka 读取实时数据</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">stream_df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    spark.readStream</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">         .format(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kafka\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">         .option(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kafka.bootstrap.servers\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kafka:9092\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">         .option(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"subscribe\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"user_events\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">         .load()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 解析 JSON 并计算实时指标</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pyspark.sql.types </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StructType, StringType, TimestampType</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">schema </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> StructType() \\</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .add(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"user_id\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, StringType()) \\</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .add(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"event\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, StringType()) \\</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    .add(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"timestamp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, TimestampType())</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">parsed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> stream_df.select(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    F.from_json(F.col(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"value\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).cast(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"string\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), schema).alias(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"data\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).select(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"data.*\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 5 分钟滑动窗口统计</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">windowed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    parsed.groupBy(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        F.window(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"timestamp\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"5 minutes\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"1 minute\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"event\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ).count()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h3 id=\"性能调优\">性能调优</h3><p>Spark 作业性能优化的核心策略：</p>\n<table>\n<thead>\n<tr>\n<th>问题</th>\n<th>诊断方法</th>\n<th>解决方案</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>数据倾斜</td>\n<td>Spark UI 中 Task 执行时间极度不均</td>\n<td>Salting（加盐打散 key）</td>\n</tr>\n<tr>\n<td>Shuffle 过多</td>\n<td>Stage 间数据传输量大</td>\n<td>减少宽依赖，使用 broadcast join</td>\n</tr>\n<tr>\n<td>内存不足</td>\n<td>Executor OOM</td>\n<td>调整 <code>spark.executor.memory</code>，优化序列化</td>\n</tr>\n<tr>\n<td>小文件问题</td>\n<td>输入 Split 数量过多</td>\n<td><code>coalesce()</code> 或 <code>repartition()</code></td>\n</tr>\n</tbody></table>\n<p>关键配置：<code>spark.sql.shuffle.partitions</code>（默认 200，需根据数据量调整）、<code>spark.sql.adaptive.enabled=true</code>（AQE 自适应查询执行）。</p>\n<h2 id=\"前沿动态\">前沿动态</h2><ul>\n<li><strong>Spark Connect</strong>（Spark 4.x）：客户端-服务端分离架构，多语言客户端连接远程 Spark 集群</li>\n<li><strong>Photon 引擎</strong>：Databricks 的 C++ 向量化执行引擎，查询性能提升 2-8 倍</li>\n<li><strong>GPU 加速</strong>：RAPIDS Accelerator 将 Spark SQL 操作下推到 GPU 执行</li>\n<li><strong>AI 一体化</strong>：Spark 集成 MLflow + LLM 推理，成为数据 + AI 统一平台</li>\n</ul>\n<h2 id=\"练习与思考\">练习与思考</h2><ol>\n<li>在本地模式下创建一个 Spark Session，读取 CSV 文件用 DataFrame API 完成数据清洗和分组聚合</li>\n<li>使用 Spark SQL 实现一个电商用户 RFM 模型：计算最近消费时间（Recency）、消费频率（Frequency）、消费金额（Monetary）</li>\n<li>构建一个 MLlib Pipeline，对用户特征数据训练分类模型并评估 AUC</li>\n<li>思考：Spark 的 <code>cache()</code> 和 <code>persist()</code> 有什么区别？什么时候应该缓存 DataFrame？缓存的代价是什么？</li>\n</ol>\n<h2 id=\"小结\">小结</h2><p>Spark 通过统一的编程模型整合了批处理、SQL 查询、机器学习和流计算四大场景。RDD 提供灵活的底层控制，DataFrame/Spark SQL 通过优化器实现声明式高性能查询，MLlib 使大规模模型训练开箱即用，Structured Streaming 实现了批流一体。掌握 Spark 意味着拥有了处理 90% 大数据计算需求的能力。</p>\n","headings":[{"level":1,"text":"Spark 计算引擎","id":"spark-计算引擎"},{"level":2,"text":"知识要点","id":"知识要点"},{"level":3,"text":"RDD 弹性分布式数据集","id":"rdd-弹性分布式数据集"},{"level":3,"text":"DataFrame 与 Dataset API","id":"dataframe-与-dataset-api"},{"level":3,"text":"Spark SQL 查询引擎","id":"spark-sql-查询引擎"},{"level":3,"text":"MLlib 机器学习库","id":"mllib-机器学习库"},{"level":3,"text":"结构化流处理","id":"结构化流处理"},{"level":3,"text":"性能调优","id":"性能调优"},{"level":2,"text":"前沿动态","id":"前沿动态"},{"level":2,"text":"练习与思考","id":"练习与思考"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"Hadoop 生态","url":"/l-doc-books/education/vocational/higher-vocational/big-data-technology/big-data-platforms/hadoop-ecosystem"},"next":{"title":"实时流处理","url":"/l-doc-books/education/vocational/higher-vocational/big-data-technology/big-data-platforms/realtime-stream-processing"}}