 style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'count'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">                purchases</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'is_purchase'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sum'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">))</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">           .assign(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">conversion_rate</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=lambda</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x: x[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'purchases'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> x[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'uv'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">])</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><p>Pandas 2.x 引入了 Arrow 后端，在大数据量场景下内存效率提升 30%-50%，且支持更多数据类型（如嵌套结构、大整数）。</p>\n<h3 id=\"正则表达式与文本处理\">正则表达式与文本处理</h3><p>大数据场景中大量非结构化数据需要通过正则表达式提取关键信息：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import re&#10;&#10;# 从日志中提取 IP、时间戳、状态码&#10;log_pattern = r&#39;(\\d+\\.\\d+\\.\\d+\\.\\d+).*\\[(.+?)\\].*&quot;\\s(\\d{3})&#39;&#10;matches = re.findall(log_pattern, log_line)&#10;&#10;# Pandas 向量化字符串操作&#10;df[&#39;domain&#39;] = df[&#39;url&#39;].str.extract(r&#39;https?://([^/]+)&#39;)&#10;df[&#39;has_error&#39;] = df[&#39;message&#39;].str.contains(r&#39;ERROR|FATAL&#39;, regex=True)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> re</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 从日志中提取 IP、时间戳、状态码</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">log_pattern </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">).</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">(.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)</span><span style=\"color:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\]</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\s(\\d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">{3}</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">matches </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> re.findall(log_pattern, log_line)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Pandas 向量化字符串操作</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'domain'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'url'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].str.extract(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">https</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">://</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">([</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">/]</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'has_error'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'message'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">].str.contains(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">r</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">ERROR</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">FATAL</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">regex</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span></code></pre></div><h3 id=\"文件-io-与-api-调用\">文件 IO 与 API 调用</h3><p>数据工程师需要处理多种数据格式并与外部系统交互：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"import json&#10;import requests&#10;&#10;# 多格式读写&#10;df.to_parquet(&#39;output.parquet&#39;, compression=&#39;snappy&#39;)  # 列式存储，压缩率高&#10;df_json = pd.read_json(&#39;data.jsonl&#39;, lines=True)       # JSON Lines 格式&#10;&#10;# RESTful API 数据采集&#10;def fetch_paginated(base_url, params, max_pages=100):&#10;    all_data = []&#10;    for page in range(1, max_pages + 1):&#10;        resp = requests.get(base_url, params={**params, &#39;page&#39;: page}, timeout=10)&#10;        resp.raise_for_status()&#10;        batch = resp.json()[&#39;data&#39;]&#10;        if not batch:&#10;            break&#10;        all_data.extend(batch)&#10;    return pd.DataFrame(all_data)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> json</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requests</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 多格式读写</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df.to_parquet(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'output.parquet'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">compression</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'snappy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 列式存储，压缩率高</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">df_json </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.read_json(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'data.jsonl'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">lines</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)       </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># JSON Lines 格式</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># RESTful API 数据采集</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fetch_paginated</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(base_url, params, max_pages</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    all_data </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> []</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> page </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> range</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, max_pages </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">):</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        resp </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> requests.get(base_url, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">params</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">**</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">params, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'page'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: page}, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">timeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        resp.raise_for_status()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        batch </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> resp.json()[</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'data'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">]</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> not</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> batch:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            break</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        all_data.extend(batch)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pd.DataFrame(all_data)</span></span></code></pre></div><p>Parquet 格式相比 CSV 通常节省 60%-80% 存储空间，且支持列裁剪——只读取需要的列，I/O 效率大幅提升。</p>\n<h2 id=\"前沿动态\">前沿动态</h2><p>2026 年 Python 数据编程生态的关键趋势：</p>\n<ul>\n<li><strong>Polars 崛起</strong>：基于 Rust 的 DataFrame 库，在单机场景下性能超越 Pandas 5-10 倍，惰性求值模式自动优化查询计划</li>\n<li><strong>LLM 辅助编码</strong>：GitHub Copilot 和 Cursor 已能生成 80% 的数据清洗代码，工程师角色从&quot;写代码&quot;转向&quot;设计数据管道 + 审查生成代码&quot;</li>\n<li><strong>类型注解普及</strong>：<code>pandas-stubs</code> 和 <code>pandera</code> 使 DataFrame 获得编译时类型检查，减少运行时数据类型错误</li>\n<li><strong>GIL 移除进展</strong>：Python 3.13+ 的 free-threading 模式使 CPU 密集的数据预处理真正实现多线程并行</li>\n</ul>\n<h2 id=\"练习与思考\">练习与思考</h2><ol>\n<li>使用 NumPy 生成一个 <span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>10000</mn><mo>×</mo><mn>5</mn></mrow><annotation encoding=\"application/x-tex\">10000 \\times 5</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">10000</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">5</span></span></span></span></span> 的随机矩阵，对每列分别做 Z-score 标准化（<span class=\"math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>z</mi><mo>=</mo><mfrac><mrow><mi>x</mi><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mrow><annotation encoding=\"application/x-tex\">z = \\frac{x - \\mu}{\\sigma}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.044em;\">z</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.1994em;vertical-align:-0.345em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8544em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0359em;\">σ</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.4461em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">x</span><span class=\"mbin mtight\">−</span><span class=\"mord mathnormal mtight\">μ</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span>），计算标准化后每列的均值和标准差验证结果</li>\n<li>从公开 API（如 JSONPlaceholder）拉取 500 条数据，用 Pandas 完成去重、缺失值填充、分组统计，最终输出 Parquet 文件</li>\n<li>编写正则表达式从 Nginx 访问日志中提取 IP、请求路径、状态码和响应时间，统计 Top 10 慢请求</li>\n<li>思考：在什么场景下应该选择 Polars 而非 Pandas？如果数据量超过单机内存怎么办？</li>\n</ol>\n<h2 id=\"小结\">小结</h2><p>Python 数据编程是大数据技术岗位的第一把钥匙。NumPy 提供高性能数值计算基础，Pandas（以及新兴的 Polars）解决表格型数据的清洗与分析需求，正则表达式处理非结构化文本，文件 IO 和 API 调用连接各种数据源。掌握这些工具后，你将具备独立完成数据预处理全流程的能力，为后续进入分布式计算平台打下坚实基础。</p>\n","headings":[{"level":1,"text":"Python 数据编程","id":"python-数据编程"},{"level":2,"text":"知识要点","id":"知识要点"},{"level":3,"text":"NumPy 数组运算","id":"numpy-数组运算"},{"level":3,"text":"Pandas 数据处理","id":"pandas-数据处理"},{"level":3,"text":"正则表达式与文本处理","id":"正则表达式与文本处理"},{"level":3,"text":"文件 IO 与 API 调用","id":"文件-io-与-api-调用"},{"level":2,"text":"前沿动态","id":"前沿动态"},{"level":2,"text":"练习与思考","id":"练习与思考"},{"level":2,"text":"小结","id":"小结"}],"prev":null,"next":{"title":"SQL 与数据库基础","url":"/l-doc-books/education/vocational/higher-vocational/big-data-technology/data-programming-basics/sql-database-fundamentals"}}