--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">and</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">==</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 18</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'name'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">lambda</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v: v[</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '*'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">len</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'bank_card'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">lambda</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'****'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v[</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">4</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> None</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> mask_dataframe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, df, column_policies):</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        column_policies: {'phone': 'phone', 'email': 'email', 'real_name': 'name'}</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        masked_df </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> df.copy()</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> col, strategy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> column_policies.items():</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> col </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> masked_df.columns </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">and</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> strategy </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">STRATEGIES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                masked_df[col] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> masked_df[col].apply(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">STRATEGIES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[strategy])</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> masked_df</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 行级权限控制（Row-Level Security）</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 不同角色只能看到自己负责区域的数据</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">ROLE_FILTERS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'regional_manager_east'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"region IN ('华东', '华南')\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'regional_manager_west'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"region IN ('西南', '西北')\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'data_analyst'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"1=1\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,  </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># 全量访问</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></div><h3 id=\"gdpr-合规实践\">GDPR 合规实践</h3><p>GDPR（通用数据保护条例）和中国《个人信息保护法》对数据处理提出了严格要求：</p>\n<p><strong>合规要求清单</strong>：</p>\n<ul>\n<li><strong>知情同意</strong>：收集前必须告知用户数据用途</li>\n<li><strong>最小必要</strong>：只收集业务必需的数据</li>\n<li><strong>用途限制</strong>：不得超范围使用数据</li>\n<li><strong>删除权</strong>：用户有权要求删除其个人数据</li>\n<li><strong>数据可携带</strong>：用户有权导出其数据</li>\n</ul>\n<p><strong>技术实现——用户数据删除</strong>：</p>\n<div class=\"code-block-wrapper\" data-lang=\"python\" data-code=\"class GDPRDeletionService:&#10;    def process_deletion_request(self, user_id):&#10;        &quot;&quot;&quot;处理用户数据删除请求&quot;&quot;&quot;&#10;        # 1. 记录删除请求&#10;        self.log_request(user_id)&#10;&#10;        # 2. 从各系统删除/匿名化&#10;        deletion_tasks = [&#10;            (&#39;MySQL 业务库&#39;, self.delete_from_mysql, user_id),&#10;            (&#39;Hive 数据仓库&#39;, self.anonymize_in_hive, user_id),&#10;            (&#39;Kafka 消息队列&#39;, self.mark_tombstone, user_id),&#10;            (&#39;ES 搜索索引&#39;, self.delete_from_es, user_id),&#10;            (&#39;备份系统&#39;, self.schedule_backup_purge, user_id),&#10;        ]&#10;&#10;        results = {}&#10;        for system, handler, uid in deletion_tasks:&#10;            try:&#10;                handler(uid)&#10;                results[system] = &#39;SUCCESS&#39;&#10;            except Exception as e:&#10;                results[system] = f&#39;FAILED: {e}&#39;&#10;&#10;        # 3. 生成合规报告&#10;        return self.generate_compliance_report(user_id, results)\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> GDPRDeletionService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    def</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> process_deletion_request</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(self, user_id):</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        \"\"\"处理用户数据删除请求\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 1. 记录删除请求</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">        self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.log_request(user_id)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 2. 从各系统删除/匿名化</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        deletion_tasks </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'MySQL 业务库'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.delete_from_mysql, user_id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Hive 数据仓库'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.anonymize_in_hive, user_id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Kafka 消息队列'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.mark_tombstone, user_id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ES 搜索索引'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.delete_from_es, user_id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'备份系统'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.schedule_backup_purge, user_id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        results </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> system, handler, uid </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deletion_tasks:</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                handler(uid)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                results[system] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'SUCCESS'</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">            except</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Exception</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                results[system] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'FAILED: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">{</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">}</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # 3. 生成合规报告</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> self</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.generate_compliance_report(user_id, results)</span></span></code></pre></div><h3 id=\"数据资产目录\">数据资产目录</h3><p>数据资产目录让全组织的人都能&quot;找到数据、理解数据、信任数据&quot;：</p>\n<p>核心功能：</p>\n<ul>\n<li><strong>搜索发现</strong>：按关键词、标签、负责人查找数据资产</li>\n<li><strong>数据预览</strong>：查看表结构、样本数据、统计概要</li>\n<li><strong>质量评分</strong>：基于完整性、时效性、准确性的综合评分</li>\n<li><strong>使用热度</strong>：统计各表被查询的频率，发现高价值数据</li>\n</ul>\n<h2 id=\"前沿动态\">前沿动态</h2><ul>\n<li><strong>数据合约（Data Contracts）</strong>：生产者和消费者之间定义明确的数据接口契约，变更需走审批流程</li>\n<li><strong>Data Mesh</strong>：去中心化的数据架构，各业务域自治管理数据产品，平台提供基础设施</li>\n<li><strong>AI 辅助治理</strong>：LLM 自动生成字段描述、推断数据分类、检测 PII 字段</li>\n<li><strong>主动元数据</strong>：元数据不只是被动记录，而是驱动自动化决策（如自动设置保留策略、触发质量告警）</li>\n</ul>\n<h2 id=\"练习与思考\">练习与思考</h2><ol>\n<li>为一个电商数据仓库设计数据标准规范，包括命名规范、指标口径定义和数据分级分类</li>\n<li>用 Python 实现一个简易的数据血缘追踪器：解析 SQL 语句提取表级依赖关系，构建 DAG</li>\n<li>设计并实现一套数据脱敏方案，覆盖手机号、身份证号、银行卡号等 PII 字段</li>\n<li>思考：在数据治理和业务敏捷之间如何取得平衡？过度治理会带来什么问题？</li>\n</ol>\n<h2 id=\"小结\">小结</h2><p>数据治理是大数据从&quot;能用&quot;走向&quot;好用、可信、合规&quot;的关键保障。数据标准确保口径一致，元数据管理让数据可被发现和理解，血缘追踪支持影响分析和根因定位，安全策略保护敏感信息，合规体系满足法规要求。2026 年的数据工程师不能只关注技术实现，还需要具备治理意识——这也是从初级岗位晋升到高级岗位的关键素质。</p>\n","headings":[{"level":1,"text":"数据治理","id":"数据治理"},{"level":2,"text":"知识要点","id":"知识要点"},{"level":3,"text":"数据标准制定","id":"数据标准制定"},{"level":3,"text":"元数据管理","id":"元数据管理"},{"level":3,"text":"数据血缘追踪","id":"数据血缘追踪"},{"level":3,"text":"数据安全策略","id":"数据安全策略"},{"level":3,"text":"GDPR 合规实践","id":"gdpr-合规实践"},{"level":3,"text":"数据资产目录","id":"数据资产目录"},{"level":2,"text":"前沿动态","id":"前沿动态"},{"level":2,"text":"练习与思考","id":"练习与思考"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"数据采集与 ETL","url":"/l-doc-books/education/vocational/higher-vocational/big-data-technology/data-engineering-practice/data-collection-etl"},"next":{"title":"云上大数据部署","url":"/l-doc-books/education/vocational/higher-vocational/big-data-technology/data-engineering-practice/cloud-big-data-deployment"}}