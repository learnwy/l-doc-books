AB70\">event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (event.cause </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'agent_stop'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> hooks</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> loadSettings</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().hooks?.Stop </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">      for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> h</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> hooks) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> runHook</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(h, { cause: event.cause });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (r.exitCode </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">          return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { decision: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'continue'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, message: r.stderr.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">trim</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> plugin;</span></span></code></pre></div><p>这份 plugin 干了三件事：第一，启动时读 <code>~/.claude/settings.json</code> 把 hooks 数组缓存到内存；第二，三个 plugin event 触发时分别 lookup PreToolUse / PostToolUse / Stop 对应配置、调 shell 脚本；第三，转换工具名、把 shell 脚本的 exit 2 + stderr 翻译成 OpenCode plugin 的 <code>{decision: &quot;deny&quot;, reason}</code> 或 <code>session.continue</code>。</p>\n<h2 id=\"工具名转换-pascalcase-lowercase\">工具名转换：PascalCase ↔ lowercase</h2><p>Claude Code 工具名用 PascalCase（<code>Bash</code>、<code>Edit</code>、<code>Read</code>、<code>Write</code>、<code>Grep</code>、<code>Glob</code>、<code>Task</code>、<code>WebFetch</code>），早期 OpenCode 用 lowercase（<code>bash</code>、<code>edit</code>、<code>read</code>），2026 版已逐步对齐到 PascalCase 但仍有些版本走 lowercase。bridge plugin 必须维护一张双向 lookup table：</p>\n<table>\n<thead>\n<tr>\n<th>Claude</th>\n<th>OpenCode (旧)</th>\n<th>OpenCode (新)</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Bash</td>\n<td>bash</td>\n<td>Bash</td>\n</tr>\n<tr>\n<td>Edit</td>\n<td>edit</td>\n<td>Edit</td>\n</tr>\n<tr>\n<td>Read</td>\n<td>read</td>\n<td>Read</td>\n</tr>\n<tr>\n<td>Write</td>\n<td>write</td>\n<td>Write</td>\n</tr>\n<tr>\n<td>Grep</td>\n<td>grep</td>\n<td>Grep</td>\n</tr>\n<tr>\n<td>Glob</td>\n<td>glob</td>\n<td>Glob</td>\n</tr>\n<tr>\n<td>Task</td>\n<td>task</td>\n<td>Task</td>\n</tr>\n<tr>\n<td>WebFetch</td>\n<td>web_fetch</td>\n<td>WebFetch</td>\n</tr>\n</tbody></table>\n<p>实现时建议双向 normalizer：把任何输入先全转成 PascalCase 再做 matcher 匹配，避免 hook 脚本里写两套 case。</p>\n<h2 id=\"exit-code-2-re-injection-模拟-stop-hook\">exit code 2 re-injection 模拟 Stop hook</h2><p>Claude Code Stop hook 最典型用法是 SOP enforcement——agent 试图 stop 时 hook 检查&quot;checklist 是否完成&quot;，没完成就 exit 2 + stderr 写&quot;还需要做 X&quot;，agent 把 stderr 喂回 LLM 强制继续工作。这一模式在 OpenCode 里要在 plugin 内主动调用 <code>session.continue</code> API 模拟：</p>\n<div class=\"code-block-wrapper\" data-lang=\"typescript\" data-code=\"&quot;session.idle&quot;: async (event, ctx) =&gt; {&#10;  if (event.cause !== &quot;agent_stop&quot;) return;&#10;  const sopDone = await ctx.storage.get(&quot;sop_done&quot;);&#10;  if (!sopDone) {&#10;    return {&#10;      decision: &quot;continue&quot;,&#10;      message: &quot;SOP checklist 未完成，请继续执行：1. 跑 lint 2. 跑 test 3. 写 PR 描述&quot;&#10;    };&#10;  }&#10;},\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"session.idle\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">ctx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (event.cause </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"agent_stop\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> sopDone</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ctx.storage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sop_done\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">sopDone) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      decision: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"continue\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      message: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"SOP checklist 未完成，请继续执行：1. 跑 lint 2. 跑 test 3. 写 PR 描述\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">},</span></span></code></pre></div><p>返回 <code>{decision: &quot;continue&quot;, message: &quot;...&quot;}</code> 让 OpenCode 把 message 作为 system context 注入下一轮 LLM 调用，强制 agent 继续工作。bridge plugin 里这部分由 shell hook 的 exit 2 + stderr 转译——shell 脚本退出 2、stderr 写&quot;还需要做 X&quot;，plugin 把它打包成 OpenCode 的 <code>decision: &quot;continue&quot;</code>。</p>\n<h2 id=\"共享-hook-仓库-team-hooks-monorepo-template\">共享 hook 仓库：team-hooks/ monorepo template</h2><p>把所有 hook 脚本集中到一个 git 仓库，各工具引用同一份。最小 monorepo 结构：</p>\n<div class=\"code-block-wrapper\" data-lang=\"text\" data-code=\"team-hooks/&#10;├── README.md&#10;├── pretooluse/&#10;│   ├── check-bash.sh&#10;│   ├── check-edit.sh&#10;│   └── check-write.sh&#10;├── posttooluse/&#10;│   └── audit-log.sh&#10;├── stop/&#10;│   └── check-sop.sh&#10;├── sessionstart/&#10;│   └── inject-git-status.sh&#10;├── config-templates/&#10;│   ├── claude-settings.json&#10;│   ├── codex-config.toml&#10;│   └── opencode-plugins.json&#10;└── tests/&#10;    └── test-pretooluse.sh\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>team-hooks/</span></span>\n<span class=\"line\"><span>├── README.md</span></span>\n<span class=\"line\"><span>├── pretooluse/</span></span>\n<span class=\"line\"><span>│   ├── check-bash.sh</span></span>\n<span class=\"line\"><span>│   ├── check-edit.sh</span></span>\n<span class=\"line\"><span>│   └── check-write.sh</span></span>\n<span class=\"line\"><span>├── posttooluse/</span></span>\n<span class=\"line\"><span>│   └── audit-log.sh</span></span>\n<span class=\"line\"><span>├── stop/</span></span>\n<span class=\"line\"><span>│   └── check-sop.sh</span></span>\n<span class=\"line\"><span>├── sessionstart/</span></span>\n<span class=\"line\"><span>│   └── inject-git-status.sh</span></span>\n<span class=\"line\"><span>├── config-templates/</span></span>\n<span class=\"line\"><span>│   ├── claude-settings.json</span></span>\n<span class=\"line\"><span>│   ├── codex-config.toml</span></span>\n<span class=\"line\"><span>│   └── opencode-plugins.json</span></span>\n<span class=\"line\"><span>└── tests/</span></span>\n<span class=\"line\"><span>    └── test-pretooluse.sh</span></span></code></pre></div><p>每个工具的引用方式：</p>\n<div class=\"code-block-wrapper\" data-lang=\"jsonc\" data-code=\"// ~/.claude/settings.json （直接引用绝对路径）&#10;{&#10;  &quot;hooks&quot;: {&#10;    &quot;PreToolUse&quot;: [{ &quot;matcher&quot;: &quot;Bash&quot;, &quot;command&quot;: &quot;~/team-hooks/pretooluse/check-bash.sh&quot; }],&#10;    &quot;Stop&quot;: [{ &quot;command&quot;: &quot;~/team-hooks/stop/check-sop.sh&quot; }],&#10;  },&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// ~/.claude/settings.json （直接引用绝对路径）</span></span>\n<span class=\"line\"><span>{</span></span>\n<span class=\"line\"><span>  \"hooks\": {</span></span>\n<span class=\"line\"><span>    \"PreToolUse\": [{ \"matcher\": \"Bash\", \"command\": \"~/team-hooks/pretooluse/check-bash.sh\" }],</span></span>\n<span class=\"line\"><span>    \"Stop\": [{ \"command\": \"~/team-hooks/stop/check-sop.sh\" }],</span></span>\n<span class=\"line\"><span>  },</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"toml\" data-code=\"# ~/.codex/config.toml&#10;[hooks.pre_tool]&#10;command = &quot;~/team-hooks/pretooluse/check-bash.sh&quot;&#10;matcher = &quot;bash&quot;&#10;&#10;[hooks.stop]&#10;command = &quot;~/team-hooks/stop/check-sop.sh&quot;\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span># ~/.codex/config.toml</span></span>\n<span class=\"line\"><span>[hooks.pre_tool]</span></span>\n<span class=\"line\"><span>command = \"~/team-hooks/pretooluse/check-bash.sh\"</span></span>\n<span class=\"line\"><span>matcher = \"bash\"</span></span>\n<span class=\"line\"><span></span></span>\n<span class=\"line\"><span>[hooks.stop]</span></span>\n<span class=\"line\"><span>command = \"~/team-hooks/stop/check-sop.sh\"</span></span></code></pre></div><div class=\"code-block-wrapper\" data-lang=\"jsonc\" data-code=\"// ~/.config/opencode/config.json&#10;{&#10;  &quot;plugins&quot;: [&quot;opencode-plugin-claude-hooks-bridge&quot;],&#10;}\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>// ~/.config/opencode/config.json</span></span>\n<span class=\"line\"><span>{</span></span>\n<span class=\"line\"><span>  \"plugins\": [\"opencode-plugin-claude-hooks-bridge\"],</span></span>\n<span class=\"line\"><span>}</span></span></code></pre></div><p>OpenCode 端只装 bridge plugin、bridge plugin 自动读 <code>~/.claude/settings.json</code> 引用同一份 hook 脚本。新成员入职跑一遍 <code>git clone team-hooks ~ &amp;&amp; bash team-hooks/setup.sh</code> 就完成三个工具的全部配置。</p>\n<p>更新流程：仓库 push → 团队成员 pull → hook 立刻生效（脚本即文件，无需 reload）。OpenCode bridge plugin 也无须重启——每次事件触发都重新读 settings.json（生产环境可以加 30 秒缓存）。</p>\n<h2 id=\"陷阱与常见问题\">陷阱与常见问题</h2><ul>\n<li><strong>bridge plugin 不读最新 settings.json</strong>：缓存 settings 到内存后忘记 invalidate；建议每次事件都 stat 文件 mtime，变了重新加载。</li>\n<li><strong>工具名转换漏边缘 case</strong>：Claude 新增 <code>Notebook</code> / <code>BashOutput</code> 等工具时，lookup table 不更新就 silent 不生效；建议无匹配时 fallback 用原名 + 日志告警。</li>\n<li><strong>session.idle 当 Stop 用没区分 cause</strong>：用户输入回合也会触发 idle，没判定 <code>cause === &quot;agent_stop&quot;</code> 会在用户问问题时也跑 SOP 检查。</li>\n<li><strong>同一脚本在三家工具行为不同</strong>：Codex 工具名小写、Claude PascalCase——hook 脚本 matcher 写 <code>if [ &quot;$TOOL&quot; = &quot;Bash&quot; ]</code> 在 Codex 端失败；脚本里统一用 normalizer。</li>\n<li><strong>共享仓库权限混乱</strong>：脚本带 sudo 或写敏感路径，团队成员 clone 后被恶意修改可能引发安全事故；用 git tag 锁版本 + signed commit。</li>\n<li><strong>bridge plugin 性能瓶颈</strong>：每次工具调用都 <code>spawnSync</code> shell 脚本，在 OpenCode in-process 优势丧失；高频路径建议 plugin 内做轻量过滤再调脚本。</li>\n</ul>\n<h2 id=\"小结\">小结</h2><ul>\n<li>三家工具的 hook 协议（stdin JSON、exit code、stderr 反馈）在 2026 已收敛到兼容程度——同一份 shell 脚本可以同时被 Claude Code 与 Codex 直接调用、被 OpenCode 通过 bridge plugin 调用。</li>\n<li>OpenCode bridge plugin 读 <code>~/.claude/settings.json</code> 把 hooks 数组 map 到三个 plugin event，工具名 normalize + exit 2 翻译成 plugin 返回值。</li>\n<li>exit 2 re-injection 模拟 Stop hook 的 SOP enforcement：shell 脚本 exit 2 + stderr，plugin 翻译成 <code>decision: &quot;continue&quot;</code> + message 强制 agent 继续。</li>\n<li>共享 hook 仓库（team-hooks/）作为单一信源，三家工具按各自方式引用同一份脚本；新成员入职跑一次 setup 完成全部配置。</li>\n<li>整套 hub 在 <a href=\"../\"><code>../_INTRODUCTION.md</code></a> 给出全局导引；上层模块 commands / agents / skills / mcp 见 <a href=\"../../\"><code>../../</code></a>。</li>\n</ul>\n","headings":[{"level":1,"text":"跨工具 bridge 模式","id":"跨工具-bridge-模式"},{"level":2,"text":"核心概念","id":"核心概念"},{"level":2,"text":"OpenCode bridge plugin：从 settings.json 到 plugin event","id":"opencode-bridge-plugin-从-settings-json-到-plugin-event"},{"level":2,"text":"工具名转换：PascalCase ↔ lowercase","id":"工具名转换-pascalcase-lowercase"},{"level":2,"text":"exit code 2 re-injection 模拟 Stop hook","id":"exit-code-2-re-injection-模拟-stop-hook"},{"level":2,"text":"共享 hook 仓库：team-hooks/ monorepo template","id":"共享-hook-仓库-team-hooks-monorepo-template"},{"level":2,"text":"陷阱与常见问题","id":"陷阱与常见问题"},{"level":2,"text":"小结","id":"小结"}],"prev":{"title":"stdout 纪律与无限循环防护","url":"/l-doc-books/c/ai-books/coding-tools/hooks/hooks-pitfalls-and-bridges/stdout-discipline-and-loop-guards"},"next":null}